   225	        py::arg("initial_c"), py::arg("hidden_size"), py::arg("direction"),
   226	        "Acquire and peek the LSTM inputs; return (x, W, R, B|None, initial_h|None, initial_c|None capsules, Y shape, "
   227	        "Y_h/Y_c shape, scratch numel, T, N).");
   228	  m.def("lstm_run", &lstm_run, py::arg("x_capsule"), py::arg("W_capsule"), py::arg("R_capsule"), py::arg("B_capsule"),
   229	        py::arg("initial_h_capsule"), py::arg("initial_c_capsule"), py::arg("Y"), py::arg("Y_h"), py::arg("Y_c"),
   230	        py::arg("scratch"), py::arg("hidden_size"), py::arg("direction"),
   231	        "Consume every operand, validate, run the whole LSTM recurrence on the legacy stream, release.");
   232	  m.def(
   233	      "lstm_cublas_config",
   234	      [](int device) {
   235	        LstmCublasConfig c = lstm_cublas_config(device);
   236	        py::dict d;
   237	        d["math_mode"] = c.math_mode;
   238	        d["atomics_mode"] = c.atomics_mode;
   239	        d["pointer_mode"] = c.pointer_mode;
   240	        d["legacy_stream"] = c.legacy_stream;
   241	        d["default_math"] = c.default_math;
   242	        d["atomics_not_allowed"] = c.atomics_not_allowed;
   243	        return d;
   244	      },
   245	      py::arg("device") = 0, "Settings of the LSTM's cuBLAS handle on `device` (creates it if needed).");
   246	}
