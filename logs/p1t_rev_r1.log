    96	// Makes `device` current for the call and restores the caller's device afterwards. (M2's DeviceGuard in conv.cu has
    97	// internal linkage and the order forbids editing conv.cu, so this is a copy.)
    98	class DeviceGuard {
    99	 public:
   100	  explicit DeviceGuard(int device) {
   101	    check_cuda(cudaGetDevice(&prev_), "cudaGetDevice");
   102	    if (prev_ != device) {
   103	      check_cuda(cudaSetDevice(device), "cudaSetDevice");
   104	      changed_ = true;
   105	    }
   106	  }
   107	  ~DeviceGuard() {
   108	    if (changed_) cudaSetDevice(prev_);
   109	  }
   110	  DeviceGuard(const DeviceGuard&) = delete;
   111	  DeviceGuard& operator=(const DeviceGuard&) = delete;
   112	
   113	 private:
   114	  int prev_ = 0;
   115	  bool changed_ = false;
   116	};
   117	
   118	// cuBLAS handle: one per device, created lazily on first use and kept for the life of the process (destroying it at
   119	// interpreter exit can race CUDA's own teardown), with M2's exact settings: legacy stream, CUBLAS_DEFAULT_MATH (never
   120	// TF32), atomics not allowed, pointer mode host. M2's handle_for() in conv.cu has internal linkage and the order
   121	// forbids editing conv.cu, so the LSTM keeps its own handle (deviation, P1T_M3_REPORT.md). All entry points run under
   122	// the GIL, so no extra lock is needed. cuBLAS allocates its own internal workspace for this handle (cudaMalloc inside
   123	// cuBLAS); that is the only device memory the LSTM causes to be allocated outside the caller's allocator.
   124	cublasHandle_t lstm_handle_for(int device) {
   125	  static std::unordered_map<int, cublasHandle_t> handles;
   126	  auto it = handles.find(device);
   127	  if (it != handles.end()) return it->second;
   128	  cublasHandle_t h = nullptr;
   129	  check_cublas(cublasCreate(&h), "cublasCreate");
   130	  check_cublas(cublasSetStream(h, kLegacyStream), "cublasSetStream(0)");
   131	  check_cublas(cublasSetMathMode(h, CUBLAS_DEFAULT_MATH), "cublasSetMathMode(CUBLAS_DEFAULT_MATH)");
   132	  check_cublas(cublasSetAtomicsMode(h, CUBLAS_ATOMICS_NOT_ALLOWED), "cublasSetAtomicsMode(NOT_ALLOWED)");
   133	  check_cublas(cublasSetPointerMode(h, CUBLAS_POINTER_MODE_HOST), "cublasSetPointerMode(HOST)");
   134	  handles.emplace(device, h);
   135	  return h;
   136	}
   137	
   138	// ------------------------------------------------------------------------------------------------ device functions
   139	// Logistic sigmoid, stable for large |z|: exp is only ever evaluated at a non-positive argument, so it never overflows
   140	// (z >= 0: 1 / (1 + e^{-z}); z < 0: e^{z} / (1 + e^{z})). expf is the CUDA math library's accurate expf (2 ulp max),
   141	// never the fast intrinsic. Prior art: the standard sign split (see the file header).
   142	__device__ __forceinline__ float sigmoid_stable(float z) {
   143	  if (z >= 0.0f) return 1.0f / (1.0f + expf(-z));
   144	  const float e = expf(z);
   145	  return e / (1.0f + e);
   146	}
   147	
   148	// ------------------------------------------------------------------------------------------------ kernels
   149	// G_x[d, r, q] = Wb[d, q] for every projected row r in [0, T*N) and q in [0, 4H): the bias the input-projection GEMM
   150	// then accumulates onto (beta = 1). One thread per element, a plain copy.
   151	__global__ void lstm_bias_fill_kernel(float* __restrict__ gx, const float* __restrict__ B, int64_t D, int64_t rows,
   152	                                      int64_t H4, int64_t bias_row) {
   153	  const int64_t total = D * rows * H4;
   154	  for (int64_t i = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; i < total;
   155	       i += static_cast<int64_t>(gridDim.x) * blockDim.x) {
   156	    const int64_t q = i % H4;
   157	    const int64_t d = i / (rows * H4);
   158	    gx[i] = B[d * bias_row + q];
   159	  }
   160	}
   161	
   162	// One LSTM step for every direction slot at once; one thread per state element idx = (d*N + n)*H + j.
   163	//   gx: G_x [D, T, N, 4H] (x . W^T + Wb); gh: G_h [D, N, 4H] (h_{t-1} . R^T for this step); B: [D, 8H] or NULL;
   164	//   h / c: the state [D, N, H] (= Y_h / Y_c), read and written in place by the owning thread only; Y [T, D, N, H].
   165	// Fixed per-element operation order: z = (gx + gh) + Rb; c = fmaf(f, c_prev, i * c~); h = o * tanhf(c).
   166	__global__ void lstm_cell_kernel(const float* __restrict__ gx, const float* __restrict__ gh,
   167	                                 const float* __restrict__ B, float* __restrict__ h, float* __restrict__ c,
   168	                                 float* __restrict__ Y, int64_t T, int64_t s, int64_t D, int64_t N, int64_t H,
   169	                                 int64_t first_reverse) {
   170	  const int64_t H4 = kLstmGates * H;
   171	  const int64_t total = D * N * H;
   172	  for (int64_t idx = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; idx < total;
   173	       idx += static_cast<int64_t>(gridDim.x) * blockDim.x) {
   174	    const int64_t j = idx % H;
   175	    const int64_t r = idx / H;
   176	    const int64_t n = r % N;
   177	    const int64_t d = r / N;
   178	    const int64_t tt = (d >= first_reverse) ? (T - 1 - s) : s;   // the reverse slot walks time backwards
   179	    const float* gxp = gx + ((d * T + tt) * N + n) * H4;
   180	    const float* ghp = gh + (d * N + n) * H4;
   181	    float zi = gxp[kGateI * H + j] + ghp[kGateI * H + j];
   182	    float zo = gxp[kGateO * H + j] + ghp[kGateO * H + j];
   183	    float zf = gxp[kGateF * H + j] + ghp[kGateF * H + j];
   184	    float zc = gxp[kGateC * H + j] + ghp[kGateC * H + j];
   185	    if (B != nullptr) {
   186	      const float* rb = B + d * (kLstmBiasHalves * H4) + H4;     // Rb[d] = B[d, 4H:8H]
   187	      zi = zi + rb[kGateI * H + j];
   188	      zo = zo + rb[kGateO * H + j];
   189	      zf = zf + rb[kGateF * H + j];
   190	      zc = zc + rb[kGateC * H + j];
   191	    }
   192	    const float ig = sigmoid_stable(zi);
   193	    const float og = sigmoid_stable(zo);
   194	    const float fg = sigmoid_stable(zf);
   195	    const float cg = tanhf(zc);
   196	    const float cn = fmaf(fg, c[idx], ig * cg);
   197	    const float hn = og * tanhf(cn);
   198	    c[idx] = cn;
   199	    h[idx] = hn;
   200	    Y[((tt * D + d) * N + n) * H + j] = hn;
   201	  }
   202	}
   203	
   204	}  // namespace
   205	
   206	// ------------------------------------------------------------------------------------------------ LSTM forward
   207	void lstm_forward(int device, const LstmGeom& g, const float* x, const float* W, const float* R, const float* B,
   208	                  const float* h0, const float* c0, float* Y, float* Y_h, float* Y_c, float* scratch) {
   209	  DeviceGuard guard(device);
   210	  cublasHandle_t hdl = lstm_handle_for(device);
   211	  const int64_t H4 = kLstmGates * g.H;
   212	  const int64_t rows = g.T * g.N;                 // projected rows, r = t*N + n
   213	  const int64_t state = g.D * g.N * g.H;          // elements of Y_h / Y_c
   214	  const size_t state_bytes = static_cast<size_t>(state) * sizeof(float);
   215	  float* gx = scratch;                            // [D, T, N, 4H]
   216	  float* gh = scratch + lstm_gx_numel(g);         // [D, N, 4H]
   217	  const float one = 1.0f;
   218	  const float zero = 0.0f;
   219	
   220	  // 1. Initial state into the outputs that carry the recurrence.
   221	  if (h0 != nullptr)
   222	    check_cuda(cudaMemcpyAsync(Y_h, h0, state_bytes, cudaMemcpyDeviceToDevice, kLegacyStream), "initial_h copy");
   223	  else
   224	    check_cuda(cudaMemsetAsync(Y_h, 0, state_bytes, kLegacyStream), "initial_h zero");
   225	  if (c0 != nullptr)
   226	    check_cuda(cudaMemcpyAsync(Y_c, c0, state_bytes, cudaMemcpyDeviceToDevice, kLegacyStream), "initial_c copy");
   227	  else
   228	    check_cuda(cudaMemsetAsync(Y_c, 0, state_bytes, kLegacyStream), "initial_c zero");
   229	
   230	  // 2. Input projection of all steps, one SGEMM per direction (+ Wb through beta = 1 on the pre-filled buffer).
   231	  //    Row-major G_x[d][rows, 4H] = X[rows, I] . W[d][4H, I]^T, as the column-major product
   232	  //    G_x^T[4H, rows] = op_T(W_d viewed [I, 4H], ld I) . X^T[I, rows] (ld I): m = 4H, n = rows, k = I, ldc = 4H.
   233	  float beta_x = zero;
   234	  if (B != nullptr) {
   235	    const int64_t total = g.D * rows * H4;
   236	    lstm_bias_fill_kernel<<<grid_for(total, lstm_tuning::kBiasFillBlock), lstm_tuning::kBiasFillBlock, 0,
   237	                            kLegacyStream>>>(gx, B, g.D, rows, H4, kLstmBiasHalves * H4);
   238	    check_launch("lstm_bias_fill_kernel");
   239	    beta_x = one;
   240	  }
   241	  for (int64_t d = 0; d < g.D; ++d) {
   242	    check_cublas(cublasSgemm(hdl, CUBLAS_OP_T, CUBLAS_OP_N, static_cast<int>(H4), static_cast<int>(rows),
   243	                             static_cast<int>(g.I), &one, W + d * H4 * g.I, static_cast<int>(g.I), x,
   244	                             static_cast<int>(g.I), &beta_x, gx + d * rows * H4, static_cast<int>(H4)),
   245	                 "cublasSgemm (input projection)");
   246	    check_launch("cublasSgemm (input projection)");
   247	  }
   248	
   249	  // 3. The recurrence: a host loop over steps inside this one call. Per step, one strided-batched SGEMM over the D
   250	  //    slots, G_h[d][N, 4H] = h[d][N, H] . R[d][4H, H]^T (column-major: m = 4H, n = N, k = H, op_T on R viewed
   251	  //    [H, 4H] ld H, h viewed [H, N] ld H, ldc = 4H), then the fused cell kernel. Stream order makes step s+1's GEMM
   252	  //    read the h that step s's cell kernel wrote.
   253	  const unsigned int cell_grid = grid_for(state, lstm_tuning::kCellBlock);
   254	  for (int64_t s = 0; s < g.T; ++s) {
   255	    check_cublas(cublasSgemmStridedBatched(hdl, CUBLAS_OP_T, CUBLAS_OP_N, static_cast<int>(H4), static_cast<int>(g.N),
   256	                                           static_cast<int>(g.H), &one, R, static_cast<int>(g.H),
   257	                                           static_cast<long long>(H4 * g.H), Y_h, static_cast<int>(g.H),
   258	                                           static_cast<long long>(g.N * g.H), &zero, gh, static_cast<int>(H4),
   259	                                           static_cast<long long>(g.N * H4), static_cast<int>(g.D)),
   260	                 "cublasSgemmStridedBatched (recurrent)");
   261	    check_launch("cublasSgemmStridedBatched (recurrent)");
   262	    lstm_cell_kernel<<<cell_grid, lstm_tuning::kCellBlock, 0, kLegacyStream>>>(gx, gh, B, Y_h, Y_c, Y, g.T, s, g.D,
   263	                                                                                 g.N, g.H, g.first_reverse);
   264	    check_launch("lstm_cell_kernel");
   265	  }
   266	}
   267	
   268	// ------------------------------------------------------------------------------------------------ introspection
   269	LstmCublasConfig lstm_cublas_config(int device) {
   270	  DeviceGuard guard(device);
   271	  cublasHandle_t h = lstm_handle_for(device);
   272	  cublasMath_t math;
   273	  cublasAtomicsMode_t atomics;
   274	  cublasPointerMode_t pmode;
   275	  cudaStream_t s;
   276	  check_cublas(cublasGetMathMode(h, &math), "cublasGetMathMode");
   277	  check_cublas(cublasGetAtomicsMode(h, &atomics), "cublasGetAtomicsMode");
   278	  check_cublas(cublasGetPointerMode(h, &pmode), "cublasGetPointerMode");
   279	  check_cublas(cublasGetStream(h, &s), "cublasGetStream");
   280	  LstmCublasConfig c;
   281	  c.math_mode = static_cast<int>(math);
   282	  c.atomics_mode = static_cast<int>(atomics);
   283	  c.pointer_mode = static_cast<int>(pmode);
   284	  c.legacy_stream = (s == kLegacyStream);
   285	  c.default_math = (math == CUBLAS_DEFAULT_MATH);
   286	  c.atomics_not_allowed = (atomics == CUBLAS_ATOMICS_NOT_ALLOWED);
   287	  return c;
   288	}
