   179	// Fast-math canary: out[i] = x[i] / y[i] in fp32. Built with this TU's flags, so --use_fast_math (-ftz=1,
   180	// -prec_div=0) shows up as flushed subnormals or non-IEEE quotients, which the tests compare bitwise against the host's
   181	// IEEE fp32 division. Prior art: no specific source known to me (it is the usual "test the build flags by their
   182	// observable effect" idea; denormal flushing as a fast-math symptom is documented in the CUDA C Programming Guide).
   183	__global__ void fp32_divide_probe_kernel(const float* __restrict__ x, const float* __restrict__ y,
   184	                                         float* __restrict__ out, int64_t n) {
   185	  for (int64_t i = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; i < n;
   186	       i += static_cast<int64_t>(gridDim.x) * blockDim.x)
   187	    out[i] = x[i] / y[i];
   188	}
   189	
   190	}  // namespace
