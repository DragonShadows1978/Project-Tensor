     1	// DLPack consumer side of tc_signal: turn any DLPack CUDA producer (or a bare capsule) into a validated fp32 operand.
     2	//
     3	// Prior art: DLPack (dmlc/dlpack, 2017-; header v1.3 vendored in include/dlpack/dlpack.h) for the DLManagedTensor /
     4	// DLManagedTensorVersioned ABI and the capsule rules ("dltensor" / "dltensor_versioned", renamed to "used_*" on
     5	// consumption, consumer calls the deleter); the Python array API standard's data-interchange protocol
     6	// (`__dlpack__(stream=, max_version=, copy=)`, Consortium for Python Data API Standards, 2021-2023) for the stream
     7	// argument and the max_version/TypeError fallback, which NumPy's and PyTorch's `from_dlpack` also implement. Ours: the
     8	// two-phase use (peek shapes for sizing without consuming, then consume and validate everything right before the launch),
     9	// and the validation set (device, dtype, compact strides with size-1 dimensions free, byte_offset, alignment, output
    10	// overlap, read-only/copied refusal for written operands).
    11	#pragma once
    12	
    13	#include <dlpack/dlpack.h>
    14	#include <pybind11/pybind11.h>
