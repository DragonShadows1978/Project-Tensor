   256	// ------------------------------------------------------------------------------------------------ introspection
   257	CublasConfig cublas_config(int device) {
   258	  DeviceGuard guard(device);
   259	  cublasHandle_t h = handle_for(device);
   260	  cublasMath_t math;
   261	  cublasAtomicsMode_t atomics;
   262	  cublasPointerMode_t pmode;
   263	  cudaStream_t s;
   264	  check_cublas(cublasGetMathMode(h, &math), "cublasGetMathMode");
   265	  check_cublas(cublasGetAtomicsMode(h, &atomics), "cublasGetAtomicsMode");
   266	  check_cublas(cublasGetPointerMode(h, &pmode), "cublasGetPointerMode");
   267	  check_cublas(cublasGetStream(h, &s), "cublasGetStream");
   268	  CublasConfig c;
   269	  c.math_mode = static_cast<int>(math);
   270	  c.atomics_mode = static_cast<int>(atomics);
   271	  c.pointer_mode = static_cast<int>(pmode);
   272	  c.legacy_stream = (s == kLegacyStream);
   273	  c.default_math = (math == CUBLAS_DEFAULT_MATH);
   274	  c.atomics_not_allowed = (atomics == CUBLAS_ATOMICS_NOT_ALLOWED);
   275	  return c;
   276	}
