    38	constexpr cudaStream_t kLegacyStream = 0;  // the legacy default stream (TensorCUDA's only stream)
    39	
    40	void check_cuda(cudaError_t e, const char* what) {
    41	  if (e != cudaSuccess) {
    42	    std::ostringstream os;
    43	    os << "tc_signal: " << what << " failed: " << cudaGetErrorName(e) << ": " << cudaGetErrorString(e);
    44	    throw std::runtime_error(os.str());
    45	  }
    46	}
    47	
    48	unsigned int grid_for(int64_t total, int block) {
    49	  const int64_t blocks = (total + block - 1) / block;
    50	  return static_cast<unsigned int>(std::max<int64_t>(1, std::min<int64_t>(blocks, tuning::kGridCap)));
    51	}
    52	
    53	// Makes `device` current for the call and restores the caller's device afterwards.
    54	class DeviceGuard {
    55	 public:
    56	  explicit DeviceGuard(int device) {
    57	    check_cuda(cudaGetDevice(&prev_), "cudaGetDevice");
    58	    if (prev_ != device) {
    59	      check_cuda(cudaSetDevice(device), "cudaSetDevice");
    60	      changed_ = true;
    61	    }
    62	  }
    63	  ~DeviceGuard() {
    64	    if (changed_) cudaSetDevice(prev_);
    65	  }
    66	  DeviceGuard(const DeviceGuard&) = delete;
    67	  DeviceGuard& operator=(const DeviceGuard&) = delete;
    68	
    69	 private:
    70	  int prev_ = 0;
    71	  bool changed_ = false;
    72	};
    73	
    74	// y[r, i] = x[r, i / scale]: one thread per output element, a 32-bit word copy.
    75	__global__ void upsample_nearest1d_kernel(const uint32_t* __restrict__ x, uint32_t* __restrict__ y, int64_t total,
    76	                                          int64_t T, int64_t T_out, int64_t scale) {
    77	  for (int64_t i = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; i < total;
    78	       i += static_cast<int64_t>(gridDim.x) * blockDim.x) {
    79	    const int64_t t = i % T_out;
    80	    const int64_t r = i / T_out;
    81	    y[i] = x[r * T + t / scale];
    82	  }
    83	}
    84	
    85	// Reflect pad of the last axis: one thread per output element, a 32-bit word copy.
    86	__global__ void reflection_pad1d_kernel(const uint32_t* __restrict__ x, uint32_t* __restrict__ y, int64_t total,
    87	                                        int64_t T, int64_t T_out, int64_t pad_begin) {
    88	  for (int64_t i = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; i < total;
    89	       i += static_cast<int64_t>(gridDim.x) * blockDim.x) {
    90	    const int64_t t = i % T_out;
    91	    const int64_t r = i / T_out;
    92	    int64_t s = t - pad_begin;
    93	    if (s < 0)
    94	      s = -s;
    95	    else if (s >= T)
    96	      s = 2 * (T - 1) - s;
    97	    y[i] = x[r * T + s];
    98	  }
    99	}
   100	
   101	// y = rintf(x): round half to even (the default rounding mode), sign of zero kept, NaN/Inf pass through.
   102	__global__ void rint_kernel(const float* __restrict__ x, float* __restrict__ y, int64_t n) {
   103	  for (int64_t i = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; i < n;
   104	       i += static_cast<int64_t>(gridDim.x) * blockDim.x)
   105	    y[i] = rintf(x[i]);
   106	}
   107	
   108	}  // namespace
