   231	template <typename T> __device__ __forceinline__ float ld(const T* p, int64_t i);
   232	template <> __device__ __forceinline__ float ld<float>(const float* p, int64_t i) { return p[i]; }
   233	template <> __device__ __forceinline__ float ld<__half>(const __half* p, int64_t i) { return __half2float(p[i]); }
   234	template <> __device__ __forceinline__ float ld<__nv_bfloat16>(const __nv_bfloat16* p, int64_t i) { return __bfloat162float(p[i]); }
   235	template <typename T> __device__ __forceinline__ void st(T* p, int64_t i, float v);
