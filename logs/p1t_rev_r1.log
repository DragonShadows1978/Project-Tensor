    50	// rank >= 0: exactly that rank; rank < 0: any rank >= min_rank.
    51	void check_rank(const char* role, int ndim, int rank, int min_rank) {
    52	  if (rank < 0 && ndim < min_rank) {
    53	    std::ostringstream os;
    54	    os << "expected at least " << min_rank << " dimension" << (min_rank == 1 ? "" : "s") << ", got " << ndim;
    55	    bad_operand4(role, os.str());
    56	  }
    57	}
    58	
    59	Peek4 peek4(py::handle obj, const char* role, int rank, int min_rank) {
    60	  Peek4 p;
    61	  if (obj.is_none()) return p;
    62	  p.capsule = to_capsule(obj, role, false);
    63	  const DLTensor* t = peek(p.capsule, role);
    64	  validate_tensor(t, role, rank >= 0 ? rank : t->ndim);  // device, dtype, (rank), non-empty, C-contiguous, aligned
    65	  check_rank(role, t->ndim, rank, min_rank);
    66	  p.shape = shape_of(t);
    67	  p.device = t->device.device_id;
    68	  p.present = true;
    69	  return p;
    70	}
