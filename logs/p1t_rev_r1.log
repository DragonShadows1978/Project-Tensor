"""tc_signal T5 norms (P1T-M4): instance_norm1d, layer_norm, group_norm.

fp32 statistics (shifted two-pass: shift by the row's first sample, mean of the shifted row, then the centred sum of
squares; biased variance as ONNX), a fixed block-tree reduction order (deterministic, no atomics), and
y = (x - mean) * (1 / sqrtf(var + eps)) * scale + bias. Kernel and numerics notes: src/norms.cu. Operands are any fp32
CUDA DLPack producers (or capsules), C-contiguous; the output comes from the module allocator (tc_signal.set_allocator)
unless `out` is given; everything is queued on the legacy default stream.

Prior art: Ulyanov, Vedaldi & Lempitsky (2016) instance norm; Ba, Kiros & Hinton (2016) layer norm; Wu & He (2018)
group norm; ONNX InstanceNormalization / LayerNormalization / GroupNormalization-21 (semantics); Welford (1962) and
Chan, Golub & LeVeque (1983) (variance algorithms, two-pass and shifted data). Ours: the Python wrappers.
"""
from __future__ import annotations

import math
import numbers
import operator
import sys

from . import _tc_signal as _C

__all__ = ['instance_norm1d', 'layer_norm', 'group_norm']


def _alloc(shape):
    # The package's current allocator (tc_signal.set_allocator), read at call time.
    return sys.modules[__package__]._allocator(tuple(shape))


def _eps(eps):
    if isinstance(eps, bool) or not isinstance(eps, numbers.Real):
        raise TypeError(f'tc_signal: eps must be a real number, got {type(eps).__name__}')
    e = float(eps)
    if not math.isfinite(e) or e < 0.0:
        raise ValueError(f'tc_signal: eps must be a finite number >= 0, got {e!r}')
    return e


def _int(name, v):
    if isinstance(v, bool):
        raise TypeError(f'tc_signal: {name} must be an int, got bool')
    try:
        return operator.index(v)
    except TypeError:
        raise TypeError(f'tc_signal: {name} must be an int, got {type(v).__name__}') from None


def instance_norm1d(x, scale=None, bias=None, *, eps=1e-5, out=None):
    """ONNX InstanceNormalization on x [N, C, T]: per (n, c), mean and biased variance over T (fp32 statistics);
    y = (x - mean) / sqrt(var + eps) * scale[c] + bias[c]. scale, bias: [C] or None (1 and 0). Returns `out`."""
    e = _eps(eps)
    xc, sc, bc, out_shape = _C.instance_norm1d_plan(x, scale, bias, e)
    if out is None:
        out = _alloc(out_shape)
    _C.instance_norm1d_run(xc, sc, bc, out, e)
    return out


def layer_norm(x, scale=None, bias=None, *, axis=-1, eps=1e-5, out=None):
    """ONNX LayerNormalization: normalize over the axes [axis, rank) with the biased variance (fp32 statistics, whatever
    eps: 1e-5 and 1e-12 both honoured); y = xhat * scale + bias with scale, bias of shape x.shape[axis:] or None.
    Returns `out`."""
    a = _int('axis', axis)
    e = _eps(eps)
    xc, sc, bc, out_shape = _C.layer_norm_plan(x, scale, bias, a, e)
    if out is None:
        out = _alloc(out_shape)
    _C.layer_norm_run(xc, sc, bc, out, a, e)
    return out


def group_norm(x, num_groups, scale=None, bias=None, *, eps=1e-5, out=None):
    """GroupNorm (ONNX GroupNormalization-21 / torch.nn.GroupNorm) on x [N, C, T]: mean and biased variance over each
    group's (C/num_groups, T) block (fp32 statistics); per-CHANNEL affine: scale, bias [C] or None. Returns `out`."""
    g = _int('num_groups', num_groups)
    e = _eps(eps)
    xc, sc, bc, out_shape = _C.group_norm_plan(x, g, scale, bias, e)
    if out is None:
        out = _alloc(out_shape)
    _C.group_norm_run(xc, g, sc, bc, out, e)
    return out
"""tc_signal T6 small ops (P1T-M4): upsample_nearest1d, reflection_pad1d, rint. Bit-exact by construction (32-bit word
gathers; rintf). Kernel notes: src/small_ops.cu. Operands are any fp32 CUDA DLPack producers (or capsules),
C-contiguous; the time axis is the last axis; the output comes from the module allocator unless `out` is given;
everything is queued on the legacy default stream. TensorCUDA core's `round` is untouched.

Prior art: ONNX Resize (nearest, asymmetric, floor), Pad (reflect) and Round specs; IEEE 754 roundTiesToEven / C99 rint;
torch reflection_pad1d. Ours: the Python wrappers.
"""
from __future__ import annotations

import operator
import sys

from . import _tc_signal as _C

__all__ = ['upsample_nearest1d', 'reflection_pad1d', 'rint']


def _alloc(shape):
    # The package's current allocator (tc_signal.set_allocator), read at call time.
    return sys.modules[__package__]._allocator(tuple(shape))


def _int(name, v):
    if isinstance(v, bool):
        raise TypeError(f'tc_signal: {name} must be an int, got bool')
    try:
        return operator.index(v)
    except TypeError:
        raise TypeError(f'tc_signal: {name} must be an int, got {type(v).__name__}') from None


def upsample_nearest1d(x, scale, *, out=None):
    """ONNX Resize nearest (asymmetric, floor) on the last axis at an INTEGER scale >= 1:
    y[..., i] = x[..., i // scale], output length T * scale. Non-integer scales are refused (TypeError). Returns `out`."""
    s = _int('scale (upsample_nearest1d takes integer scales only)', scale)
    if s < 1:
        raise ValueError(f'tc_signal: upsample_nearest1d: scale must be an integer >= 1, got {s}')
    xc, out_shape = _C.upsample_nearest1d_plan(x, s)
    if out is None:
        out = _alloc(out_shape)
    _C.upsample_nearest1d_run(xc, out, s)
    return out


def reflection_pad1d(x, pads, *, out=None):
    """ONNX Pad mode=reflect (torch reflection_pad1d) on the last axis: pads = (begin, end), each >= 0 and < T.
    Output length T + begin + end. Returns `out`."""
    if not isinstance(pads, (tuple, list)):
        raise TypeError(f'tc_signal: reflection_pad1d: pads must be a (begin, end) tuple or list, got '
                        f'{type(pads).__name__}')
    if len(pads) != 2:
        raise ValueError(f'tc_signal: reflection_pad1d: pads must be (begin, end), got {pads!r}')
    pb, pe = _int('pads[0]', pads[0]), _int('pads[1]', pads[1])
    if pb < 0 or pe < 0:
        raise ValueError(f'tc_signal: reflection_pad1d: pads must be >= 0, got ({pb}, {pe})')
    xc, out_shape = _C.reflection_pad1d_plan(x, pb, pe)
    if out is None:
        out = _alloc(out_shape)
    _C.reflection_pad1d_run(xc, out, pb, pe)
    return out


def rint(x, *, out=None):
    """ONNX Round: round half to even (rintf), sign of zero kept (rint(-0.4) = -0.0), +-Inf and NaN pass through.
    Any rank. Returns `out`."""
    xc, out_shape = _C.rint_plan(x)
    if out is None:
        out = _alloc(out_shape)
    _C.rint_run(xc, out)
    return out
- `PYBIND11_SOURCE_DIR` is passed as `-DFETCHCONTENT_SOURCE_DIR_PYBIND11`. Without it, CMake fetches v2.12.0 from
  GitHub.

`CMakeLists.txt` refuses two kinds of flag at configure time:
- fast-math flags (`--use_fast_math`);
- `--default-stream` flags. `conv.cu` also refuses `CUDA_API_PER_THREAD_DEFAULT_STREAM`.

`build/` is git-ignored.

## Use

```python
# PYTHONPATH=<Project-Tensor>/tc_signal
import torch, tc_signal as ts
ts.set_allocator(lambda s: torch.empty(s, device="cuda"))     # until P1T-M1 gives tensor_cuda.empty
y = ts.conv1d(x, w, b, stride=1, padding=(3, 3), dilation=3)
z = ts.conv_transpose1d(y, wt, bt, stride=10, padding=(5, 5))
```

## API

```python
tc_signal.conv1d(x, w, b=None, *, stride=1, padding=0, dilation=1, groups=1, out=None)
tc_signal.conv_transpose1d(x, w, b=None, *, stride=1, padding=0, output_padding=0, dilation=1, groups=1, out=None)
tc_signal.set_allocator(fn)   # fn(shape: tuple) -> fp32 CUDA DLPack tensor; returns the previous allocator
```

The semantics are ONNX `Conv` and `ConvTranspose`, 1-D.

**Shapes**
- `x` is `[N, C_in, T]`.
- `b` is `[C_out]` or `None`.
- `padding` is an int or `(pad_begin, pad_end)`.
- `conv1d`: `w` is `[C_out, C_in/groups, K]`. The output length is
  `(T + pb + pe - dilation*(K-1) - 1)//stride + 1`.
- `conv_transpose1d`: `w` is `[C_in, C_out/groups, K]` (the ONNX layout). The output length is
  `stride*(T-1) + output_padding + dilation*(K-1) + 1 - pb - pe`. Output positions past the full transposed length
  hold only the bias.

**Attribute limits.** `stride`, `dilation` and `groups` must be >= 1; pads >= 0; `output_padding` >= 0 and
< `max(stride, dilation)`. An output length <= 0 is refused.

**Allocation**
- With `out=None`, the output comes from the module allocator. The function always returns `out`.
- The default allocator is `tensor_cuda.empty(*shape, dtype="float32")`, which P1T-M1 adds. Until then it raises a
  `RuntimeError` that names `set_allocator`.
- `set_allocator(None)` restores the default.
- The im2col scratch for `conv1d` also comes from the allocator. Its shape is `(C_in*K*T_out,)`, sized by the C++
  helper `conv1d_plan`. The scratch is skipped for the direct path (K 1, stride 1, no pads).

## Operand contract (DLPack consumer)

Every operand, the output and the scratch included, is an object with `__dlpack__` or a bare DLPack capsule.

**Acquisition**
1. If the object has `__dlpack_device__()`, it is asked first. A non-CUDA producer is refused there, before
   `__dlpack__` is called, because CPU producers such as NumPy reject a CUDA stream argument.
2. Then `obj.__dlpack__(stream=1, max_version=(1, 3))` is called. Stream 1 is the legacy default stream, the
   consumer's stream. Written operands also pass `copy=False`.
3. If the producer raises `TypeError` for the newer keywords, it is called again as `obj.__dlpack__(stream=1)`. This
   is the Python array API fallback.

**Both capsule kinds are read**
- `"dltensor"` (`DLManagedTensor`);
- `"dltensor_versioned"` (`DLManagedTensorVersioned`). For this kind, DLPack major version 1 is required.

**Consumption**
- A capsule is consumed once: it is renamed to `"used_*"`, and tc_signal owns the managed tensor from then on.
- Each producer deleter is called exactly once:
  - after the launch on success;
  - during unwinding on any error after consumption;
  - by the producer's own capsule destructor if tc_signal never consumed the capsule (a refusal in the planning phase).

**Validation**, each failure a `TypeError` or `ValueError` (see Errors):
- device `kDLCUDA`, with one ordinal for every operand;
- dtype float32 (`kDLFloat`, 32 bits, 1 lane);
- the exact number of dimensions;
- no empty dimension;
- C-contiguous: NULL strides, or the compact stride on every dimension of extent > 1 (size-1 dimensions may carry
  any stride);
- `data + byte_offset` used as the base pointer, 4-byte aligned;
- exact shapes;
- written operands must not be read-only or a producer copy (versioned flags);
- the output's byte range must not overlap any input's or the scratch's, and the scratch must not overlap the inputs.

## Streams and lifetimes

- Everything is queued on the legacy default stream: the im2col, GEMM and bias work, and the ConvTranspose gather.
  This is TensorCUDA's only stream, and torch's default stream; both share the device's primary context.
  `tests/test_contract.py` proves the ordering both ways against torch with no explicit sync.
- `cudaGetLastError` is checked after every launch, and any error raises a `RuntimeError`.
- Each capsule's deleter is called right after the launches, before the GPU has run them. This is safe when the
  producer frees on the legacy stream, or later in stream order: TensorCUDA does, and so does torch's caching
