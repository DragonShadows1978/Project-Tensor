   192	void fp32_divide_probe(int device, const float* x, const float* y, float* out, int64_t n) {
   193	  DeviceGuard guard(device);
   194	  fp32_divide_probe_kernel<<<grid_for(n, tuning::kProbeBlock), tuning::kProbeBlock, 0, kLegacyStream>>>(x, y, out, n);
   195	  check_launch("fp32_divide_probe_kernel");
   196	}
