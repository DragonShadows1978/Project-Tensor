    91	unsigned int grid_for(int64_t total, int block) {
    92	  const int64_t blocks = (total + block - 1) / block;
    93	  return static_cast<unsigned int>(std::max<int64_t>(1, std::min<int64_t>(blocks, lstm_tuning::kGridCap)));
    94	}
