   282	  check_cublas(cublasGetProperty(MINOR_VERSION, &bi.cublas_minor), "cublasGetProperty(MINOR)");
   283	  check_cublas(cublasGetProperty(PATCH_LEVEL, &bi.cublas_patch), "cublasGetProperty(PATCH)");
