   295	  Operand Y(to_capsule(y, "y", false), "y", 1, false);
   296	  Operand O(to_capsule(out, "out", true), "out", 1, true);
   297	  expect_shape(Y, {X.dim(0)});
   298	  expect_shape(O, {X.dim(0)});
   299	  const int device = common_device({&X, &Y, &O});
   300	  expect_disjoint(O, X);
   301	  expect_disjoint(O, Y);
   302	  fp32_divide_probe(device, X.data(), Y.data(), O.data(), X.dim(0));
   303	}
