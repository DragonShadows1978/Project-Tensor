   174	void ManagedOwner::reset() noexcept {
   175	  // DLPack consumer rule: when done, call the producer's deleter (it may be NULL). Called with the GIL held (every
   176	  // tc_signal entry point runs under the GIL), so a deleter that touches Python objects is safe.
   177	  if (legacy != nullptr) {
   178	    DLManagedTensor* m = legacy;
   179	    legacy = nullptr;
   180	    if (m->deleter) m->deleter(m);
   181	  }
   182	  if (versioned != nullptr) {
   183	    DLManagedTensorVersioned* m = versioned;
   184	    versioned = nullptr;
   185	    if (m->deleter) m->deleter(m);
   186	  }
