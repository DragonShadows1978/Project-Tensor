   164	py::tuple lstm_plan(py::object x, py::object W, py::object R, py::object B, py::object h0, py::object c0,
   165	                    int64_t hidden_size, int64_t direction) {
   166	  if (x.is_none()) throw py::type_error("tc_signal: operand 'x': expected a DLPack producer or capsule, got None");
   167	  if (W.is_none()) throw py::type_error("tc_signal: operand 'W': expected a DLPack producer or capsule, got None");
   168	  if (R.is_none()) throw py::type_error("tc_signal: operand 'R': expected a DLPack producer or capsule, got None");
   169	  Peeked X = peek_operand(x, "x", 3);
   170	  Peeked Wp = peek_operand(W, "W", 3);
   171	  Peeked Rp = peek_operand(R, "R", 3);
   172	  Peeked Bp = peek_operand(B, "B", 2);
   173	  Peeked H0 = peek_operand(h0, "initial_h", 3);
   174	  Peeked C0 = peek_operand(c0, "initial_c", 3);
   175	  same_device_peeked({&X, &Wp, &Rp, &Bp, &H0, &C0}, {"x", "W", "R", "B", "initial_h", "initial_c"});
   176	  LstmPlan p = plan_lstm(X.shape, Wp.shape, Rp.shape, Bp.present ? &Bp.shape : nullptr,
   177	                         H0.present ? &H0.shape : nullptr, C0.present ? &C0.shape : nullptr, hidden_size, direction);
   178	  return py::make_tuple(X.capsule, Wp.capsule, Rp.capsule, Bp.capsule, H0.capsule, C0.capsule, to_tuple(p.y_shape),
   179	                        to_tuple(p.state_shape), py::int_(p.scratch_numel), py::int_(p.g.T), py::int_(p.g.N));
   180	}
   181	
   182	void lstm_run(py::object xc, py::object Wc, py::object Rc, py::object Bc, py::object h0c, py::object c0c, py::object Y,
   183	              py::object Y_h, py::object Y_c, py::object scratch, int64_t hidden_size, int64_t direction) {
   184	  Operand X(xc, "x", 3, false);
   185	  Operand Wo(Wc, "W", 3, false);
   186	  Operand Ro(Rc, "R", 3, false);
   187	  Operand Bo;
   188	  if (!Bc.is_none()) Bo = Operand(Bc, "B", 2, false);
   189	  Operand H0;
   190	  if (!h0c.is_none()) H0 = Operand(h0c, "initial_h", 3, false);
   191	  Operand C0;
   192	  if (!c0c.is_none()) C0 = Operand(c0c, "initial_c", 3, false);
   193	  std::vector<int64_t> bshape, h0shape, c0shape;
   194	  if (Bo.present()) bshape = op_shape(Bo);
   195	  if (H0.present()) h0shape = op_shape(H0);
   196	  if (C0.present()) c0shape = op_shape(C0);
   197	  LstmPlan p = plan_lstm(op_shape(X), op_shape(Wo), op_shape(Ro), Bo.present() ? &bshape : nullptr,
   198	                         H0.present() ? &h0shape : nullptr, C0.present() ? &c0shape : nullptr, hidden_size, direction);
   199	  Operand Yo(to_capsule(Y, "Y", true), "Y", 4, true);
   200	  expect_shape(Yo, p.y_shape);
   201	  Operand Yh(to_capsule(Y_h, "Y_h", true), "Y_h", 3, true);
   202	  expect_shape(Yh, p.state_shape);
   203	  Operand Yc(to_capsule(Y_c, "Y_c", true), "Y_c", 3, true);
   204	  expect_shape(Yc, p.state_shape);
   205	  Operand S(to_capsule(scratch, "scratch", true), "scratch", 1, true);
   206	  expect_shape(S, {p.scratch_numel});
   207	  const int device = common_device({&X, &Wo, &Ro, &Bo, &H0, &C0, &Yo, &Yh, &Yc, &S});
   208	  // Every written operand must not alias any input nor any other written operand.
   209	  const std::vector<const Operand*> written = {&Yo, &Yh, &Yc, &S};
   210	  const std::vector<const Operand*> inputs = {&X, &Wo, &Ro, &Bo, &H0, &C0};
   211	  for (size_t a = 0; a < written.size(); ++a) {
   212	    for (const Operand* in : inputs) expect_disjoint(*written[a], *in);
   213	    for (size_t b = a + 1; b < written.size(); ++b) expect_disjoint(*written[a], *written[b]);
   214	  }
   215	  lstm_forward(device, p.g, X.data(), Wo.data(), Ro.data(), Bo.present() ? Bo.data() : nullptr,
   216	               H0.present() ? H0.data() : nullptr, C0.present() ? C0.data() : nullptr, Yo.data(), Yh.data(), Yc.data(),
   217	               S.data());
   218	  // Leaving scope runs each Operand's destructor: every producer deleter is called after the launches.
   219	}
