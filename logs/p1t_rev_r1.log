   115	// ------------------------------------------------------------------------------------------------ validation
   116	void validate_tensor(const DLTensor* t, const char* role, int ndim) {
   117	  if (t->device.device_type != kDLCUDA) {
   118	    std::ostringstream os;
   119	    os << "device type " << static_cast<int>(t->device.device_type)
   120	       << " is not kDLCUDA (2); tc_signal takes CUDA device memory only";
   121	    refuse_value(role, os.str());
   122	  }
   123	  if (t->dtype.code != kDLFloat || t->dtype.bits != 32 || t->dtype.lanes != 1) {
   124	    std::ostringstream os;
   125	    os << "dtype (code " << static_cast<int>(t->dtype.code) << ", bits " << static_cast<int>(t->dtype.bits)
   126	       << ", lanes " << t->dtype.lanes
   127	       << ") is not float32; tc_signal computes in fp32 only (expand fp16 weights to fp32 first)";
   128	    refuse_type(role, os.str());
   129	  }
   130	  if (t->ndim != ndim) {
   131	    std::ostringstream os;
   132	    os << "expected " << ndim << " dimensions, got " << t->ndim;
   133	    refuse_value(role, os.str());
   134	  }
   135	  for (int i = 0; i < t->ndim; ++i)
   136	    if (t->shape[i] <= 0) refuse_value(role, "empty operand (shape " + shape_str(shape_of(t)) + ")");
   137	  if (t->strides != nullptr) {
   138	    // C-contiguous: every dimension of extent > 1 has the compact stride; size-1 dimensions may carry any stride
   139	    // (they are never stepped), as the order and the DLPack/array API conventions allow.
   140	    int64_t want = 1;
   141	    for (int i = t->ndim - 1; i >= 0; --i) {
   142	      if (t->shape[i] != 1 && t->strides[i] != want) {
   143	        std::ostringstream os;
   144	        os << "not C-contiguous (shape " << shape_str(shape_of(t)) << ", strides [";
   145	        for (int j = 0; j < t->ndim; ++j) os << (j ? ", " : "") << t->strides[j];
   146	        os << "]); pass a contiguous tensor";
   147	        refuse_value(role, os.str());
   148	      }
   149	      want *= t->shape[i];
   150	    }
   151	  }
   152	  if (t->data == nullptr) refuse_value(role, "NULL data pointer");
   153	  const uintptr_t p = reinterpret_cast<uintptr_t>(t->data) + static_cast<uintptr_t>(t->byte_offset);
   154	  if (p % alignof(float) != 0) refuse_value(role, "data + byte_offset is not 4-byte aligned");
   155	}
