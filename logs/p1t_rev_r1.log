    65	    refuse_type(role, "expected a DLPack producer (an object with __dlpack__) or a DLPack capsule, got " +
    66	                          type_name(obj));
    67	  // Array API order: ask the producer's device first. A non-CUDA producer is refused here, before __dlpack__ is
    68	  // called with a CUDA stream argument (CPU producers such as NumPy reject any stream other than None).
    69	  if (py::hasattr(obj, "__dlpack_device__")) {
    70	    int device_type = -1;
    71	    try {
    72	      py::tuple dev = obj.attr("__dlpack_device__")().cast<py::tuple>();
    73	      device_type = dev[0].cast<int>();
    74	    } catch (py::cast_error&) {
    75	      refuse_type(role, "__dlpack_device__() did not return a (device_type, device_id) tuple of ints");
    76	    }
    77	    if (device_type != kDLCUDA) {
    78	      std::ostringstream os;
    79	      os << "device type " << device_type << " is not kDLCUDA (2); tc_signal takes CUDA device memory only";
    80	      refuse_value(role, os.str());
    81	    }
    82	  }
    83	  py::object fn = obj.attr("__dlpack__");
    84	  py::object cap;
    85	  const py::tuple max_version = py::make_tuple(tuning::kDlpackMaxMajor, tuning::kDlpackMaxMinor);
    86	  try {
    87	    // Consumer stream = the legacy default stream (DLPack int 1): the producer orders its pending work before it.
    88	    if (writable)
    89	      cap = fn(py::arg("stream") = tuning::kDlpackLegacyStream, py::arg("max_version") = max_version,
    90	               py::arg("copy") = false);
