   255	#define DISPATCH_FLOAT(DT, T, ...)                                       \
   256	  do {                                                                   \
   257	    if ((DT) == DType::Float32) { using T = float; __VA_ARGS__; }        \
   258	    else if ((DT) == DType::Float16) { using T = __half; __VA_ARGS__; }  \
   259	    else if ((DT) == DType::BFloat16) { using T = __nv_bfloat16; __VA_ARGS__; } \
   260	    else throw std::runtime_error("op supports float32/float16/bfloat16 only"); \
   261	  } while (0)
