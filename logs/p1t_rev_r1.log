   177	
   178	Peeked peek_operand(py::handle obj, const char* role, int ndim) {
   179	  Peeked p;
   180	  p.capsule = to_capsule(obj, role, false);
   181	  const DLTensor* t = peek(p.capsule, role);
   182	  validate_tensor(t, role, ndim);
   183	  p.shape = shape_of(t);
   184	  p.device = t->device.device_id;
   185	  return p;
   186	}
   187	
   188	void same_device_peeked(const std::vector<const Peeked*>& ps, const std::vector<const char*>& roles) {
   189	  int dev = -1;
   190	  const char* first = "";
   191	  for (size_t i = 0; i < ps.size(); ++i) {
   192	    if (ps[i] == nullptr) continue;
   193	    if (dev < 0) {
   194	      dev = ps[i]->device;
   195	      first = roles[i];
   196	    } else if (ps[i]->device != dev) {
   197	      std::ostringstream os;
   198	      os << "tc_signal: operand '" << roles[i] << "': on CUDA device " << ps[i]->device << " but operand '" << first
   199	         << "' is on CUDA device " << dev << "; every operand must be on the same device";
   200	      throw py::value_error(os.str());
   201	    }
   202	  }
   203	}
