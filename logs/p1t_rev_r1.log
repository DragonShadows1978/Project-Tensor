   112	template <int B>
   113	__global__ void __launch_bounds__(B) row_norm_kernel(const float* __restrict__ x, const float* __restrict__ scale,
   114	                                                     const float* __restrict__ bias, float* __restrict__ y,
   115	                                                     int64_t rows, int64_t L, float eps, int affine, int64_t channels,
   116	                                                     int64_t groups, int64_t ch_per_group, int64_t T) {
   117	  __shared__ float red[B];
   118	  const int64_t tid = threadIdx.x;
   119	  const int64_t chunk_span = static_cast<int64_t>(B) * m4tuning::kNormChunk;
   120	  const float Lf = static_cast<float>(L);  // exact for L < 2^24
   121	  for (int64_t row = blockIdx.x; row < rows; row += gridDim.x) {
   122	    const float* __restrict__ xr = x + row * L;
   123	    float* __restrict__ yr = y + row * L;
   124	    const float K = xr[0];
   125	
   126	    // Pass 1: the mean of the shifted row.
   127	    float acc = 0.0f;
   128	    for (int64_t base = tid; base < L; base += chunk_span) {
   129	      const int64_t end = min(L, base + chunk_span);
   130	      float part = 0.0f;
   131	      for (int64_t j = base; j < end; j += B) part = part + (xr[j] - K);
   132	      acc = acc + part;
   133	    }
   134	    const float d = block_tree_sum<B>(acc, red) / Lf;
   135	
   136	    // Pass 2: the centred sum of squares (biased variance).
   137	    acc = 0.0f;
   138	    for (int64_t base = tid; base < L; base += chunk_span) {
   139	      const int64_t end = min(L, base + chunk_span);
   140	      float part = 0.0f;
   141	      for (int64_t j = base; j < end; j += B) {
   142	        const float c = (xr[j] - K) - d;
   143	        part = fmaf(c, c, part);
   144	      }
   145	      acc = acc + part;
   146	    }
   147	    const float var = block_tree_sum<B>(acc, red) / Lf;
   148	    const float rstd = 1.0f / sqrtf(var + eps);
   149	
   150	    // Pass 3: normalize and apply the affine.
   151	    for (int64_t j = tid; j < L; j += B) {
   152	      const float c = (xr[j] - K) - d;
   153	      int64_t p;
   154	      if (affine == static_cast<int>(NormAffine::kPerRow))
   155	        p = row % channels;
   156	      else if (affine == static_cast<int>(NormAffine::kPerElem))
   157	        p = j;
   158	      else
   159	        p = (row % groups) * ch_per_group + j / T;
   160	      const float s = scale != nullptr ? scale[p] : 1.0f;
   161	      const float b = bias != nullptr ? bias[p] : 0.0f;
   162	      yr[j] = fmaf(c * rstd, s, b);
   163	    }
   164	  }
   165	}
