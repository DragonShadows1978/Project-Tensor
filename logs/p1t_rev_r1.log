   281	void expect_disjoint(const Operand& written, const Operand& other) {
   282	  if (!written.present() || !other.present()) return;
   283	  if (written.byte_begin() < other.byte_end() && other.byte_begin() < written.byte_end())
   284	    refuse_value(written.role(), std::string("its memory overlaps operand '") + other.role() +
   285	                                     "'; the written operand must not alias any other operand");
