    72	void check_cuda(cudaError_t e, const char* what) {
    73	  if (e != cudaSuccess) {
    74	    std::ostringstream os;
    75	    os << "tc_signal.lstm: " << what << " failed: " << cudaGetErrorName(e) << ": " << cudaGetErrorString(e);
