   263	int common_device(const std::vector<const Operand*>& ops) {
   264	  int dev = -1;
   265	  const char* first = "";
   266	  for (const Operand* op : ops) {
   267	    if (op == nullptr || !op->present()) continue;
   268	    if (dev < 0) {
   269	      dev = op->device();
   270	      first = op->role();
   271	    } else if (op->device() != dev) {
   272	      std::ostringstream os;
   273	      os << "on CUDA device " << op->device() << " but operand '" << first << "' is on CUDA device " << dev
   274	         << "; every operand must be on the same device";
   275	      refuse_value(op->role(), os.str());
   276	    }
   277	  }
   278	  return dev;
   279	}
