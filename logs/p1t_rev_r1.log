   152	      os << op << ": x must be [N, C, T], got " << r << " dimensions";
   153	      bad_attr4(os.str());
   154	    }
   155	    const int64_t N = xs[0], C = xs[1], T = xs[2];
   156	    p.param_shape = {C};
   157	    if (kind == NormKind::kInstance) {
   158	      g.rows = N * C;
   159	      g.L = T;
   160	      g.affine = NormAffine::kPerRow;
   161	      g.channels = C;
   162	    } else {
   163	      if (arg < 1) {
   164	        os << "group_norm: num_groups must be >= 1, got " << arg;
   165	        bad_attr4(os.str());
   166	      }
   167	      if (C % arg != 0) {
   168	        os << "group_norm: C (" << C << ") is not divisible by num_groups (" << arg << ")";
   169	        bad_attr4(os.str());
   170	      }
   171	      g.rows = N * arg;
   172	      g.L = (C / arg) * T;
   173	      g.affine = NormAffine::kPerChannel;
   174	      g.groups = arg;
   175	      g.ch_per_group = C / arg;
   176	      g.T = T;
   177	    }
   178	  } else {
   179	    if (r < 1) {
   180	      os << "layer_norm: x must have at least 1 dimension, got " << r;
   181	      bad_attr4(os.str());
   182	    }
   183	    if (arg < -r || arg >= r) {
   184	      os << "layer_norm: axis must be in [" << -r << ", " << r - 1 << "] for a " << r << "-D x, got " << arg;
   185	      bad_attr4(os.str());
   186	    }
   187	    const int64_t a = arg < 0 ? arg + r : arg;
   188	    g.rows = prod(xs, 0, static_cast<size_t>(a));
   189	    g.L = prod(xs, static_cast<size_t>(a), xs.size());
   190	    g.affine = NormAffine::kPerElem;
   191	    p.param_shape.assign(xs.begin() + a, xs.end());
   192	  }
   193	  for (const auto& pr : {std::make_pair(ss, "scale"), std::make_pair(bs, "bias")}) {
   194	    if (pr.first != nullptr && *pr.first != p.param_shape) {
   195	      std::ostringstream o2;
   196	      o2 << op << ": " << pr.second << " has shape " << shape_str(*pr.first) << ", expected "
   197	         << shape_str(p.param_shape)
   198	         << (kind == NormKind::kLayer ? " (x.shape[axis:])" : (kind == NormKind::kGroup ? " ([C], per channel)" : " ([C])"));
   199	      bad_attr4(o2.str());
   200	    }
   201	  }
   202	  p.out_shape = xs;
   203	  return p;
   204	}
