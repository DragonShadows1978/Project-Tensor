    83	void check_cublas(cublasStatus_t s, const char* what) {
    84	  if (s != CUBLAS_STATUS_SUCCESS) {
    85	    std::ostringstream os;
    86	    os << "tc_signal.lstm: " << what << " failed: cuBLAS status " << static_cast<int>(s);
    87	    throw std::runtime_error(os.str());
    88	  }
