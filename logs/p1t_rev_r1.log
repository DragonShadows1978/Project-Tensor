   158	Storage::Storage(size_t nbytes_, Device device_) : nbytes(nbytes_), device(device_) {
   159	  if (nbytes == 0) { ptr = nullptr; return; }
   160	  if (device.is_cuda()) {
   161	    init_default_pool();
   162	    pooled = g_pool_transients;
   163	    cudaError_t e = pooled ? cudaMallocAsync(&ptr, nbytes, 0)
   164	                           : cudaMalloc(&ptr, nbytes);
   165	    if (e == cudaErrorMemoryAllocation) {
   166	      // Near the wall: sync materializes every pending cudaFreeAsync, trim
   167	      // returns all idle pool reservations to the driver, then retry once.
   168	      cudaGetLastError();  // clear sticky error
   169	      cudaStreamSynchronize(0);
   170	      empty_cache();
   171	      e = pooled ? cudaMallocAsync(&ptr, nbytes, 0) : cudaMalloc(&ptr, nbytes);
   172	    }
   173	    if (e != cudaSuccess)
   174	      throw std::runtime_error(std::string(pooled ? "cudaMallocAsync failed: "
   175	                                                  : "cudaMalloc failed: ") +
   176	                               cudaGetErrorString(e));
   177	  } else {
   178	    ptr = std::malloc(nbytes);
   179	  }
   180	}
   181	// P1T-M1 (DLPack import): wrap a producer's memory. No allocation, no pool.
   182	Storage::Storage(void* external_ptr, size_t nbytes_, Device device_,
   183	                 ExternalRelease release, void* release_ctx)
   184	    : ptr(external_ptr), nbytes(nbytes_), device(device_),
   185	      external_release(release), external_ctx(release_ctx) {}
   186	Storage::~Storage() {
   187	  if (external_release) {
   188	    // Imported (DLPack) memory belongs to its producer: never cudaFree it and
   189	    // never hand it to the pool. ORDER MATTERS:
   190	    //  1. Drain the engine stream. Every engine kernel, cuBLAS call and
   191	    //     cudaMemcpy runs on stream 0 (the legacy default stream; this TU is
   192	    //     built without --default-stream per-thread), so once it is idle no
   193	    //     queued engine work can still read or write this memory. The engine
   194	    //     keeps no per-Storage "last use" event, so "everything queued so far"
   195	    //     is the only sound fence; an event recorded here and waited on would
   196	    //     cover exactly the same work at three API calls instead of one. A
   197	    //     deferred release (host callback) is not allowed to run the
   198	    //     producer's deleter, which may call CUDA (torch's caching allocator).
   199	    //  2. Then hand the memory back (the DLPack deleter, GIL held, in
   200	    //     bindings.cpp). A producer may reuse it at once on its own stream.
   201	    // Prior art: the DLPack deleter contract (dmlc/dlpack, 2017+) and the
   202	    // array API's stream rules (2021+); the drain-then-delete order is the
   203	    // standard CUDA "free only after last use" rule. Ours: its placement in
   204	    // the Storage destructor.
   205	    if (device.is_cuda()) cudaStreamSynchronize(0);
   206	    external_release(external_ctx);
   207	    return;
   208	  }
   209	  if (!ptr) return;
   210	  if (device.is_cuda()) {
   211	    if (pooled) cudaFreeAsync(ptr, 0);
   212	    else cudaFree(ptr);
   213	  } else {
   214	    std::free(ptr);
   215	  }
   216	}
