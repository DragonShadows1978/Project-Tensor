   198	// ------------------------------------------------------------------------------------------------ Conv1d
   199	void conv1d_forward(int device, const Conv1dGeom& g, const float* x, const float* w, const float* b, float* y,
   200	                    float* col) {
   201	  DeviceGuard guard(device);
   202	  cublasHandle_t h = handle_for(device);
   203	  const int64_t Cg = g.C_in / g.groups;
   204	  const int64_t Og = g.C_out / g.groups;
   205	  const int64_t CgK = Cg * g.K;
   206	  const float alpha = 1.0f;
   207	  const float beta = 0.0f;
   208	  for (int64_t n = 0; n < g.N; ++n) {
   209	    const float* xn = x + n * g.C_in * g.T;
   210	    const float* A = nullptr;   // the [Cg*K, T_out] row-major operand of group 0 for this batch element
   211	    long long strideA = 0;
   212	    if (g.direct) {
   213	      // K == 1, stride 1, no pads: x[n] itself is the col matrix (T_out == T), no scratch.
   214	      A = xn;
   215	      strideA = static_cast<long long>(Cg * g.T);
   216	    } else {
   217	      // The scratch is reused for every n: the next im2col is queued after this n's GEMM on the same stream.
   218	      const int64_t total = g.C_in * g.K * g.T_out;
   219	      im2col1d_kernel<<<grid_for(total, tuning::kIm2colBlock), tuning::kIm2colBlock, 0, kLegacyStream>>>(
   220	          xn, col, g.C_in, g.T, g.K, g.T_out, g.stride, g.pad_begin, g.dilation);
   221	      check_launch("im2col1d_kernel");
   222	      A = col;
   223	      strideA = static_cast<long long>(CgK * g.T_out);
   224	    }
   225	    float* yn = y + n * g.C_out * g.T_out;
   226	    // Row-major Y_g[Og, T_out] = W_g[Og, CgK] . Col_g[CgK, T_out], computed as the column-major product
   227	    // Y_g^T[T_out, Og] = Col_g^T[T_out, CgK] . W_g^T[CgK, Og]: m = T_out, n = Og, k = CgK, both ops N,
   228	    // lda = T_out (col), ldb = CgK (w), ldc = T_out (y); one batch entry per group.
   229	    check_cublas(cublasSgemmStridedBatched(h, CUBLAS_OP_N, CUBLAS_OP_N, static_cast<int>(g.T_out),
   230	                                           static_cast<int>(Og), static_cast<int>(CgK), &alpha, A,
   231	                                           static_cast<int>(g.T_out), strideA, w, static_cast<int>(CgK),
   232	                                           static_cast<long long>(Og * CgK), &beta, yn, static_cast<int>(g.T_out),
   233	                                           static_cast<long long>(Og * g.T_out), static_cast<int>(g.groups)),
   234	                 "cublasSgemmStridedBatched");
   235	    check_launch("cublasSgemmStridedBatched");
   236	  }
   237	  if (b != nullptr) {
   238	    const int64_t total = g.N * g.C_out * g.T_out;
   239	    bias_add_kernel<<<grid_for(total, tuning::kBiasBlock), tuning::kBiasBlock, 0, kLegacyStream>>>(y, b, g.C_out,
   240	                                                                                                   g.T_out, total);
   241	    check_launch("bias_add_kernel");
   242	  }
   243	}
   244	
   245	// ------------------------------------------------------------------------------------------------ ConvTranspose1d
   246	void conv_transpose1d_forward(int device, const ConvTranspose1dGeom& g, const float* x, const float* w,
   247	                              const float* b, float* y) {
   248	  DeviceGuard guard(device);
   249	  const int64_t total = g.N * g.C_out * g.T_out;
   250	  conv_transpose1d_gather_kernel<<<grid_for(total, tuning::kConvTransposeBlock), tuning::kConvTransposeBlock, 0,
   251	                                   kLegacyStream>>>(x, w, b, y, g.N, g.C_in, g.T, g.C_out, g.K, g.T_out, g.stride,
   252	                                                    g.pad_begin, g.dilation, g.groups);
   253	  check_launch("conv_transpose1d_gather_kernel");
   254	}
