   231	void conv1d_run(py::object xc, py::object wc, py::object bc, py::object out, py::object scratch, int64_t stride,
   232	                int64_t pb, int64_t pe, int64_t dilation, int64_t groups) {
   233	  Operand X(xc, "x", 3, false);
   234	  Operand W(wc, "w", 3, false);
   235	  Operand B;
   236	  if (!bc.is_none()) B = Operand(bc, "b", 1, false);
   237	  std::vector<int64_t> bshape;
   238	  if (B.present()) bshape = op_shape(B);
   239	  const std::vector<int64_t> xshape = op_shape(X);
   240	  const std::vector<int64_t> wshape = op_shape(W);
   241	  Conv1dPlan p = plan_conv1d(xshape, wshape, B.present() ? &bshape : nullptr, stride, pb, pe, dilation, groups);
   242	  Operand Y(to_capsule(out, "out", true), "out", 3, true);
