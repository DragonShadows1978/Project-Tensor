   114	// ------------------------------------------------------------------------------------------------ kernels
   115	// 1-D im2col for one batch element (Chellapilla et al. 2006, 1-D with dilation and asymmetric zero padding):
   116	//   col[(c*K + k), t] = x[c, t*stride - pad_begin + k*dilation]   (0 outside [0, T))
   117	// Rows (c, k) are c-major, so group g's rows [g*Cg*K, (g+1)*Cg*K) form one contiguous [Cg*K, T_out] block that
   118	// matches w[g*Og:(g+1)*Og] viewed as [Og, Cg*K].
   119	__global__ void im2col1d_kernel(const float* __restrict__ x, float* __restrict__ col, int64_t C, int64_t T, int64_t K,
   120	                                int64_t T_out, int64_t stride, int64_t pad_begin, int64_t dilation) {
   121	  const int64_t total = C * K * T_out;
   122	  for (int64_t i = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; i < total;
   123	       i += static_cast<int64_t>(gridDim.x) * blockDim.x) {
   124	    const int64_t t = i % T_out;
   125	    const int64_t r = i / T_out;
   126	    const int64_t k = r % K;
   127	    const int64_t c = r / K;
   128	    const int64_t src = t * stride - pad_begin + k * dilation;
   129	    col[i] = (src >= 0 && src < T) ? x[c * T + src] : 0.0f;
   130	  }
   131	}
   132	
   133	// y[n, o, t] += b[o], one thread per output element (fp32 add, one rounding).
   134	__global__ void bias_add_kernel(float* __restrict__ y, const float* __restrict__ b, int64_t C_out, int64_t T_out,
   135	                                int64_t total) {
   136	  for (int64_t i = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; i < total;
   137	       i += static_cast<int64_t>(gridDim.x) * blockDim.x) {
   138	    const int64_t o = (i / T_out) % C_out;
   139	    y[i] = y[i] + b[o];
   140	  }
   141	}
   142	
   143	// Gather-form ConvTranspose1d (adjoint of strided conv, Dumoulin & Visin 2016), one thread per output element:
   144	//   y[n, o, t] = b[o] + sum_{k=0..K-1} sum_{c in group(o)} w[c, o - g*Og, k] * x[n, c, (t + pb - k*dilation)/stride]
   145	// over the taps with (t + pb - k*dilation) >= 0, divisible by stride, and quotient < T. Fixed order: k ascending
   146	// (outer), c ascending within the group (inner), fp32 fmaf accumulation from 0, bias added last. No atomics.
   147	__global__ void conv_transpose1d_gather_kernel(const float* __restrict__ x, const float* __restrict__ w,
   148	                                               const float* __restrict__ b, float* __restrict__ y, int64_t N,
   149	                                               int64_t C_in, int64_t T, int64_t C_out, int64_t K, int64_t T_out,
   150	                                               int64_t stride, int64_t pad_begin, int64_t dilation, int64_t groups) {
   151	  const int64_t Cg = C_in / groups;
   152	  const int64_t Og = C_out / groups;
   153	  const int64_t total = N * C_out * T_out;
   154	  for (int64_t i = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; i < total;
   155	       i += static_cast<int64_t>(gridDim.x) * blockDim.x) {
   156	    const int64_t t = i % T_out;
   157	    const int64_t r = i / T_out;
   158	    const int64_t o = r % C_out;
   159	    const int64_t n = r / C_out;
   160	    const int64_t g = o / Og;
   161	    const int64_t ol = o - g * Og;
   162	    const float* xg = x + (n * C_in + g * Cg) * T;   // x[n, g*Cg + cl, :] = xg[cl*T + :]
   163	    const float* wg = w + (g * Cg * Og + ol) * K;    // w[g*Cg + cl, ol, k] = wg[cl*Og*K + k]
   164	    float acc = 0.0f;
   165	    for (int64_t k = 0; k < K; ++k) {
   166	      const int64_t s = t + pad_begin - k * dilation;
   167	      if (s < 0 || s % stride != 0) continue;
   168	      const int64_t q = s / stride;
   169	      if (q >= T) continue;
   170	      const float* xp = xg + q;
   171	      const float* wp = wg + k;
   172	      for (int64_t cl = 0; cl < Cg; ++cl) acc = fmaf(wp[cl * Og * K], xp[cl * T], acc);
   173	    }
   174	    if (b != nullptr) acc = acc + b[o];
   175	    y[i] = acc;
   176	  }
   177	}
