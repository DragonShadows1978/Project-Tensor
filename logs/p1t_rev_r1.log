   151	std::vector<int64_t> op_shape(const Operand& op) {
   152	  std::vector<int64_t> s(op.ndim());
   153	  for (int i = 0; i < op.ndim(); ++i) s[i] = op.dim(i);
   154	  return s;
   155	}
