   142	// this design: pooled LIVE blocks pin reserved chunks that TrimTo cannot
   143	// release, and size-capped hybrids measured either wall loss (<=16MB cap:
   144	// Mistral r0.05@16384 OOM) or no speedup (<=1MB cap: 2539ms vs 2611 raw — at
   145	// S=1024 nearly every transient exceeds 1MB). With a transients-only pool the
   146	// OOM retry's sync+trim empties the pool COMPLETELY, so the raw retry sees
   147	// exactly the pure-raw engine's free memory at the wall.
   148	namespace {
   149	bool g_pool_transients = false;
   150	}
