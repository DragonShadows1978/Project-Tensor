   206	int x_rank(NormKind kind) { return kind == NormKind::kLayer ? -1 : 3; }
   207	
   208	py::tuple norm_plan(NormKind kind, py::object x, py::object scale, py::object bias, int64_t arg, double eps) {
   209	  Peek4 X = peek4(x, "x", x_rank(kind), 1);
   210	  Peek4 S = peek4(scale, "scale", -1, 1);
   211	  Peek4 B = peek4(bias, "bias", -1, 1);
   212	  same_device4({{&X, "x"}, {&S, "scale"}, {&B, "bias"}});
   213	  NormPlan p = plan_norm(kind, X.shape, S.present ? &S.shape : nullptr, B.present ? &B.shape : nullptr, arg, eps);
   214	  return py::make_tuple(X.capsule, S.capsule, B.capsule, tuple4(p.out_shape));
   215	}
   216	
   217	void norm_run(NormKind kind, py::object xc, py::object sc, py::object bc, py::object out, int64_t arg, double eps) {
   218	  Operand X = consume4(xc, "x", x_rank(kind), 1);
   219	  Operand S = consume4(sc, "scale", -1, 1);
   220	  Operand B = consume4(bc, "bias", -1, 1);
   221	  std::vector<int64_t> sshape, bshape;
   222	  if (S.present()) sshape = shape4(S);
   223	  if (B.present()) bshape = shape4(B);
   224	  NormPlan p = plan_norm(kind, shape4(X), S.present() ? &sshape : nullptr, B.present() ? &bshape : nullptr, arg, eps);
   225	  Operand Y(to_capsule(out, "out", true), "out", X.ndim(), true);
   226	  expect_shape(Y, p.out_shape);
   227	  const int device = common_device({&X, &S, &B, &Y});
   228	  for (const Operand* in : {&X, &S, &B}) expect_disjoint(Y, *in);
   229	  row_norm_forward(device, p.g, X.data(), S.present() ? S.data() : nullptr, B.present() ? B.data() : nullptr,
   230	                   Y.data());
   231	  // Leaving scope runs each Operand's destructor: every producer deleter is called after the launch.
   232	}
