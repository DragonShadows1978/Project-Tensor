   111	// ------------------------------------------------------------------------------------------------ peek helpers
   112	struct Peeked {
   113	  py::object capsule;            // None for an absent optional operand
   114	  std::vector<int64_t> shape;
   115	  int device = -1;
   116	  bool present = false;
   117	};
   118	
   119	Peeked peek_operand(py::handle obj, const char* role, int ndim) {
   120	  Peeked p;
   121	  if (obj.is_none()) {
   122	    p.capsule = py::none();
   123	    return p;
   124	  }
   125	  p.capsule = to_capsule(obj, role, false);
   126	  const DLTensor* t = peek(p.capsule, role);
   127	  validate_tensor(t, role, ndim);
   128	  p.shape = shape_of(t);
   129	  p.device = t->device.device_id;
   130	  p.present = true;
   131	  return p;
   132	}
   133	
   134	void same_device_peeked(const std::vector<const Peeked*>& ps, const std::vector<const char*>& roles) {
   135	  int dev = -1;
   136	  const char* first = "";
   137	  for (size_t i = 0; i < ps.size(); ++i) {
   138	    if (!ps[i]->present) continue;
   139	    if (dev < 0) {
   140	      dev = ps[i]->device;
   141	      first = roles[i];
   142	    } else if (ps[i]->device != dev) {
   143	      std::ostringstream os;
   144	      os << "tc_signal: operand '" << roles[i] << "': on CUDA device " << ps[i]->device << " but operand '" << first
   145	         << "' is on CUDA device " << dev << "; every operand must be on the same device";
   146	      throw py::value_error(os.str());
   147	    }
   148	  }
   149	}
