   319	void register_m4(py::module_& m) {
   320	  m.def(
   321	      "instance_norm1d_plan",
   322	      [](py::object x, py::object s, py::object b, double eps) { return norm_plan(NormKind::kInstance, x, s, b, 0, eps); },
   323	      py::arg("x"), py::arg("scale"), py::arg("bias"), py::arg("eps"),
   324	      "Acquire and peek x/scale/bias; return (x_capsule, scale_capsule|None, bias_capsule|None, out_shape).");
   325	  m.def(
   326	      "instance_norm1d_run",
   327	      [](py::object xc, py::object sc, py::object bc, py::object out, double eps) {
   328	        norm_run(NormKind::kInstance, xc, sc, bc, out, 0, eps);
   329	      },
   330	      py::arg("x_capsule"), py::arg("scale_capsule"), py::arg("bias_capsule"), py::arg("out"), py::arg("eps"),
   331	      "Consume every operand, validate, launch on the legacy stream, release.");
   332	  m.def(
   333	      "layer_norm_plan",
   334	      [](py::object x, py::object s, py::object b, int64_t axis, double eps) {
   335	        return norm_plan(NormKind::kLayer, x, s, b, axis, eps);
   336	      },
   337	      py::arg("x"), py::arg("scale"), py::arg("bias"), py::arg("axis"), py::arg("eps"),
   338	      "Acquire and peek x/scale/bias; return (x_capsule, scale_capsule|None, bias_capsule|None, out_shape).");
   339	  m.def(
   340	      "layer_norm_run",
   341	      [](py::object xc, py::object sc, py::object bc, py::object out, int64_t axis, double eps) {
   342	        norm_run(NormKind::kLayer, xc, sc, bc, out, axis, eps);
   343	      },
   344	      py::arg("x_capsule"), py::arg("scale_capsule"), py::arg("bias_capsule"), py::arg("out"), py::arg("axis"),
   345	      py::arg("eps"), "Consume every operand, validate, launch on the legacy stream, release.");
   346	  m.def(
   347	      "group_norm_plan",
   348	      [](py::object x, int64_t groups, py::object s, py::object b, double eps) {
   349	        return norm_plan(NormKind::kGroup, x, s, b, groups, eps);
   350	      },
   351	      py::arg("x"), py::arg("num_groups"), py::arg("scale"), py::arg("bias"), py::arg("eps"),
   352	      "Acquire and peek x/scale/bias; return (x_capsule, scale_capsule|None, bias_capsule|None, out_shape).");
   353	  m.def(
   354	      "group_norm_run",
   355	      [](py::object xc, int64_t groups, py::object sc, py::object bc, py::object out, double eps) {
   356	        norm_run(NormKind::kGroup, xc, sc, bc, out, groups, eps);
   357	      },
   358	      py::arg("x_capsule"), py::arg("num_groups"), py::arg("scale_capsule"), py::arg("bias_capsule"), py::arg("out"),
   359	      py::arg("eps"), "Consume every operand, validate, launch on the legacy stream, release.");
   360	  m.def("upsample_nearest1d_plan", &upsample_plan, py::arg("x"), py::arg("scale"),
   361	        "Acquire and peek x; return (x_capsule, out_shape).");
   362	  m.def("upsample_nearest1d_run", &upsample_run, py::arg("x_capsule"), py::arg("out"), py::arg("scale"),
   363	        "Consume, validate, launch on the legacy stream, release.");
   364	  m.def("reflection_pad1d_plan", &pad_plan, py::arg("x"), py::arg("pad_begin"), py::arg("pad_end"),
   365	        "Acquire and peek x; return (x_capsule, out_shape).");
   366	  m.def("reflection_pad1d_run", &pad_run, py::arg("x_capsule"), py::arg("out"), py::arg("pad_begin"),
   367	        py::arg("pad_end"), "Consume, validate, launch on the legacy stream, release.");
   368	  m.def("rint_plan", &rint_plan, py::arg("x"), "Acquire and peek x; return (x_capsule, out_shape).");
   369	  m.def("rint_run", &rint_run, py::arg("x_capsule"), py::arg("out"),
   370	        "Consume, validate, launch on the legacy stream, release.");
   371	  m.def("m4_tuning", []() {
   372	    py::dict d;
   373	    d["norm_block"] = m4tuning::kNormBlock;
   374	    d["norm_chunk"] = m4tuning::kNormChunk;
   375	    d["copy_block"] = m4tuning::kCopyBlock;
