   240	constexpr int kT = 256;
   241	inline int nblk(int64_t n) { return static_cast<int>((n + kT - 1) / kT); }
   242	
   243	template <typename T>
   244	__global__ void fill_kernel(T* p, int64_t n, float v) {
   245	  int64_t i = (int64_t)blockIdx.x * blockDim.x + threadIdx.x;
   246	  if (i < n) st<T>(p, i, v);
   247	}
   248	template <typename SrcT, typename DstT>
   249	__global__ void cast_kernel(const SrcT* s, DstT* d, int64_t n) {
   250	  int64_t i = (int64_t)blockIdx.x * blockDim.x + threadIdx.x;
   251	  if (i < n) st<DstT>(d, i, ld<SrcT>(s, i));
   252	}
