   203	  Operand Yc(to_capsule(Y_c, "Y_c", true), "Y_c", 3, true);
   204	  expect_shape(Yc, p.state_shape);
   205	  Operand S(to_capsule(scratch, "scratch", true), "scratch", 1, true);
   206	  expect_shape(S, {p.scratch_numel});
   207	  const int device = common_device({&X, &Wo, &Ro, &Bo, &H0, &C0, &Yo, &Yh, &Yc, &S});
   208	  // Every written operand must not alias any input nor any other written operand.
   209	  const std::vector<const Operand*> written = {&Yo, &Yh, &Yc, &S};
   210	  const std::vector<const Operand*> inputs = {&X, &Wo, &Ro, &Bo, &H0, &C0};
   211	  for (size_t a = 0; a < written.size(); ++a) {
   212	    for (const Operand* in : inputs) expect_disjoint(*written[a], *in);
   213	    for (size_t b = a + 1; b < written.size(); ++b) expect_disjoint(*written[a], *written[b]);
   214	  }
   215	  lstm_forward(device, p.g, X.data(), Wo.data(), Ro.data(), Bo.present() ? Bo.data() : nullptr,
   216	               H0.present() ? H0.data() : nullptr, C0.present() ? C0.data() : nullptr, Yo.data(), Yh.data(), Yc.data(),
   217	               S.data());
   218	  // Leaving scope runs each Operand's destructor: every producer deleter is called after the launches.
   219	}
