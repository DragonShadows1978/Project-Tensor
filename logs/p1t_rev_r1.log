    59	// Checked after every kernel launch (launch-configuration and sticky errors surface here as RuntimeError).
    60	void check_launch(const char* kernel) { check_cuda(cudaGetLastError(), kernel); }
    61	
    62	void check_cublas(cublasStatus_t s, const char* what) {
    63	  if (s != CUBLAS_STATUS_SUCCESS) {
    64	    std::ostringstream os;
    65	    os << "tc_signal: " << what << " failed: cuBLAS status " << static_cast<int>(s);
    66	    throw std::runtime_error(os.str());
    67	  }
    68	}
    69	
    70	unsigned int grid_for(int64_t total, int block) {
    71	  const int64_t blocks = (total + block - 1) / block;
    72	  return static_cast<unsigned int>(std::max<int64_t>(1, std::min<int64_t>(blocks, tuning::kGridCap)));
    73	}
    74	
    75	// Makes `device` current for the call and restores the caller's device afterwards.
    76	class DeviceGuard {
    77	 public:
    78	  explicit DeviceGuard(int device) {
    79	    check_cuda(cudaGetDevice(&prev_), "cudaGetDevice");
    80	    if (prev_ != device) {
    81	      check_cuda(cudaSetDevice(device), "cudaSetDevice");
    82	      changed_ = true;
    83	    }
    84	  }
    85	  ~DeviceGuard() {
    86	    if (changed_) cudaSetDevice(prev_);
    87	  }
    88	  DeviceGuard(const DeviceGuard&) = delete;
    89	  DeviceGuard& operator=(const DeviceGuard&) = delete;
    90	
    91	 private:
    92	  int prev_ = 0;
    93	  bool changed_ = false;
    94	};
    95	
    96	// One cuBLAS handle per device, created lazily on first use and kept for the life of the process (destroying it at
    97	// interpreter exit can race CUDA's own teardown). All entry points run under the GIL, so no extra lock is needed.
    98	// cuBLAS allocates its own internal workspace for this handle on first use (cudaMalloc inside cuBLAS); that is the
    99	// only device memory tc_signal causes to be allocated outside the caller's allocator (README "cuBLAS").
   100	cublasHandle_t handle_for(int device) {
   101	  static std::unordered_map<int, cublasHandle_t> handles;
   102	  auto it = handles.find(device);
   103	  if (it != handles.end()) return it->second;
   104	  cublasHandle_t h = nullptr;
   105	  check_cublas(cublasCreate(&h), "cublasCreate");
   106	  check_cublas(cublasSetStream(h, kLegacyStream), "cublasSetStream(0)");
   107	  check_cublas(cublasSetMathMode(h, CUBLAS_DEFAULT_MATH), "cublasSetMathMode(CUBLAS_DEFAULT_MATH)");
   108	  check_cublas(cublasSetAtomicsMode(h, CUBLAS_ATOMICS_NOT_ALLOWED), "cublasSetAtomicsMode(NOT_ALLOWED)");
   109	  check_cublas(cublasSetPointerMode(h, CUBLAS_POINTER_MODE_HOST), "cublasSetPointerMode(HOST)");
   110	  handles.emplace(device, h);
   111	  return h;
   112	}
