    63	LstmPlan plan_lstm(const std::vector<int64_t>& xs, const std::vector<int64_t>& Ws, const std::vector<int64_t>& Rs,
    64	                   const std::vector<int64_t>* Bs, const std::vector<int64_t>* h0s, const std::vector<int64_t>* c0s,
    65	                   int64_t hidden_size, int64_t direction) {
    66	  std::ostringstream os;
    67	  if (direction != kDirForward && direction != kDirReverse && direction != kDirBidirectional) {
    68	    os << "direction code " << direction << " is not 0 (forward), 1 (reverse) or 2 (bidirectional)";
    69	    lstm_bad(os.str());
    70	  }
    71	  if (hidden_size < 1 || hidden_size > INT_MAX / (kLstmGates * kLstmBiasHalves)) {
    72	    os << "hidden_size must be in [1, " << INT_MAX / (kLstmGates * kLstmBiasHalves) << "], got " << hidden_size;
    73	    lstm_bad(os.str());
    74	  }
    75	  LstmPlan p{};
    76	  LstmGeom& g = p.g;
    77	  g.T = xs[0];
    78	  g.N = xs[1];
    79	  g.I = xs[2];
    80	  g.H = hidden_size;
    81	  g.D = (direction == kDirBidirectional) ? 2 : 1;
    82	  g.first_reverse = (direction == kDirForward) ? g.D : (direction == kDirReverse ? 0 : 1);
    83	  const int64_t H4 = kLstmGates * g.H;
    84	  if (Ws[0] != g.D) {
    85	    os << "W.shape[0] (" << Ws[0] << ") != num_directions (" << g.D << ") for this direction; W is [D, 4H, I]";
    86	    lstm_bad(os.str());
    87	  }
    88	  if (Ws[1] != H4) {
    89	    os << "W.shape[1] (" << Ws[1] << ") != 4*hidden_size (" << H4 << "); W is [D, 4H, I]";
    90	    lstm_bad(os.str());
    91	  }
    92	  if (Ws[2] != g.I) {
    93	    os << "W.shape[2] (" << Ws[2] << ") != input size x.shape[2] (" << g.I << "); W is [D, 4H, I]";
    94	    lstm_bad(os.str());
    95	  }
    96	  expect_dims("R", Rs, {g.D, H4, g.H}, "R is [D, 4H, H]");
    97	  if (Bs != nullptr) expect_dims("B", *Bs, {g.D, kLstmBiasHalves * H4}, "B is [D, 8H] = [Wb; Rb]");
    98	  if (h0s != nullptr) expect_dims("initial_h", *h0s, {g.D, g.N, g.H}, "initial_h is [D, N, H]");
    99	  if (c0s != nullptr) expect_dims("initial_c", *c0s, {g.D, g.N, g.H}, "initial_c is [D, N, H]");
   100	  check_int_range("4*hidden_size", H4);
   101	  check_int_range("T*N", g.T * g.N);
   102	  check_int_range("input size", g.I);
   103	  check_int_range("batch size", g.N);
   104	  check_int_range("D*N*H", g.D * g.N * g.H);
   105	  p.y_shape = {g.T, g.D, g.N, g.H};
   106	  p.state_shape = {g.D, g.N, g.H};
   107	  p.scratch_numel = lstm_scratch_numel(g);
   108	  return p;
   109	}
