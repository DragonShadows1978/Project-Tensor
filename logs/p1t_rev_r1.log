    20	namespace tcs {
    21	namespace py = pybind11;
    22	
    23	// A DLPack capsule for `obj`: `obj` itself when it is a capsule, else `obj.__dlpack__(stream=1, max_version=(1, 3)
    24	// [, copy=False])`, falling back to `obj.__dlpack__(stream=1)` when the producer rejects the newer keywords with a
    25	// TypeError (pre-2023 producers). `writable` adds copy=False: a written operand must alias the producer's memory.
    26	py::object to_capsule(py::handle obj, const char* role, bool writable);
    27	
    28	// The DLTensor inside an unconsumed capsule (the capsule keeps ownership). Raises ValueError for a consumed capsule,
    29	// TypeError for a capsule of another kind.
    30	const DLTensor* peek(py::handle capsule, const char* role);
    31	
    32	// Device / dtype / layout checks shared by peek-time and consume-time validation (raises TypeError/ValueError).
    33	void validate_tensor(const DLTensor* t, const char* role, int ndim);
    34	
    35	// Owner of one consumed managed tensor (legacy or versioned). Calls the producer's deleter exactly once, in reset() or
    36	// in the destructor. It is a separate member so that a throw from Operand's constructor (after the capsule has been
    37	// consumed) still runs it: C++ destroys fully constructed members when a constructor throws.
    38	struct ManagedOwner {
    39	  DLManagedTensor* legacy = nullptr;
    40	  DLManagedTensorVersioned* versioned = nullptr;
    41	  ManagedOwner() = default;
    42	  ~ManagedOwner() { reset(); }
    43	  ManagedOwner(ManagedOwner&& o) noexcept;
    44	  ManagedOwner& operator=(ManagedOwner&& o) noexcept;
    45	  ManagedOwner(const ManagedOwner&) = delete;
    46	  ManagedOwner& operator=(const ManagedOwner&) = delete;
    47	  void reset() noexcept;
    48	};
    49	
    50	// One consumed DLPack operand. Owns the managed tensor (through ManagedOwner) and calls the producer's deleter exactly
    51	// once: in release() or in the destructor, so every exception path after consumption still returns the tensor to its
    52	// producer.
    53	class Operand {
    54	 public:
    55	  Operand() = default;
    56	  Operand(py::handle capsule, const char* role, int ndim, bool writable);
    57	  ~Operand();
    58	  Operand(Operand&& o) noexcept;
    59	  Operand& operator=(Operand&& o) noexcept;
    60	  Operand(const Operand&) = delete;
    61	  Operand& operator=(const Operand&) = delete;
    62	
    63	  bool present() const { return t_ != nullptr; }
    64	  float* data() const { return data_; }
    65	  int64_t dim(int i) const { return t_->shape[i]; }
    66	  int ndim() const { return t_->ndim; }
    67	  int device() const { return t_->device.device_id; }
    68	  int64_t numel() const;
    69	  uintptr_t byte_begin() const { return reinterpret_cast<uintptr_t>(data_); }
    70	  uintptr_t byte_end() const { return byte_begin() + static_cast<uintptr_t>(numel()) * sizeof(float); }
    71	  const char* role() const { return role_; }
    72	  void release();
    73	
    74	 private:
    75	  ManagedOwner owner_;
    76	  const DLTensor* t_ = nullptr;
    77	  float* data_ = nullptr;
    78	  const char* role_ = "";
    79	};
