   217	// ------------------------------------------------------------------------------------------------ Conv1d entry points
   218	py::tuple conv1d_plan(py::object x, py::object w, py::object b, int64_t stride, int64_t pb, int64_t pe,
   219	                      int64_t dilation, int64_t groups) {
   220	  Peeked X = peek_operand(x, "x", 3);
   221	  Peeked W = peek_operand(w, "w", 3);
   222	  Peeked B;
   223	  const bool has_b = !b.is_none();
   224	  if (has_b) B = peek_operand(b, "b", 1);
   225	  same_device_peeked({&X, &W, has_b ? &B : nullptr}, {"x", "w", "b"});
   226	  Conv1dPlan p = plan_conv1d(X.shape, W.shape, has_b ? &B.shape : nullptr, stride, pb, pe, dilation, groups);
   227	  return py::make_tuple(X.capsule, W.capsule, has_b ? B.capsule : py::none(), to_tuple(p.out_shape),
   228	                        py::int_(p.scratch_numel));
   229	}
   230	
   231	void conv1d_run(py::object xc, py::object wc, py::object bc, py::object out, py::object scratch, int64_t stride,
   232	                int64_t pb, int64_t pe, int64_t dilation, int64_t groups) {
   233	  Operand X(xc, "x", 3, false);
   234	  Operand W(wc, "w", 3, false);
   235	  Operand B;
   236	  if (!bc.is_none()) B = Operand(bc, "b", 1, false);
   237	  std::vector<int64_t> bshape;
   238	  if (B.present()) bshape = op_shape(B);
   239	  const std::vector<int64_t> xshape = op_shape(X);
   240	  const std::vector<int64_t> wshape = op_shape(W);
   241	  Conv1dPlan p = plan_conv1d(xshape, wshape, B.present() ? &bshape : nullptr, stride, pb, pe, dilation, groups);
   242	  Operand Y(to_capsule(out, "out", true), "out", 3, true);
   243	  expect_shape(Y, p.out_shape);
   244	  Operand S;
   245	  if (p.scratch_numel > 0) {
   246	    if (scratch.is_none()) bad_attr("conv1d: this call needs an im2col scratch operand and none was passed");
   247	    S = Operand(to_capsule(scratch, "scratch", true), "scratch", 1, true);
   248	    expect_shape(S, {p.scratch_numel});
   249	  } else if (!scratch.is_none()) {
   250	    bad_attr("conv1d: this call needs no scratch (K == 1, stride 1, no pads) but one was passed");
   251	  }
   252	  const int device = common_device({&X, &W, &B, &Y, &S});
   253	  for (const Operand* in : {&X, &W, &B, &S}) expect_disjoint(Y, *in);
   254	  for (const Operand* in : {&X, &W, &B}) expect_disjoint(S, *in);
   255	  conv1d_forward(device, p.g, X.data(), W.data(), B.present() ? B.data() : nullptr, Y.data(),
   256	                 S.present() ? S.data() : nullptr);
   257	  // Leaving scope runs each Operand's destructor: every producer deleter is called after the launches.
   258	}
