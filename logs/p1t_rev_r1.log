   263	NDArray NDArray::zeros(const Shape& shape, DType dtype, Device device) {
   264	  NDArray a(shape, dtype, device);
   265	  if (a.numel() > 0) cudaMemset(a.data_ptr(), 0, a.numel() * dtype_size(dtype));
   266	  return a;
   267	}
   268	NDArray NDArray::full(const Shape& shape, double value, DType dtype, Device device) {
   269	  NDArray a(shape, dtype, device);
   270	  int64_t n = a.numel();
   271	  if (n == 0) return a;
   272	  DISPATCH_FLOAT(dtype, T, {
   273	    fill_kernel<T><<<nblk(n), kT>>>(static_cast<T*>(a.data_ptr()), n, (float)value);
   274	  });
   275	  cuda_check_last("full");
   276	  return a;
   277	}
   278	// P1T-M1: in-place fill through the EXISTING fill_kernel (no new kernel),
   279	// queued on the engine stream like NDArray::full; an in-place engine write,
   280	// so it bumps the Storage revision after enqueueing (core.h contract).
   281	// Prior art: torch.Tensor.fill_ / numpy ndarray.fill (API shape only).
   282	void fill_(NDArray& a, double value) {
   283	  if (!a.defined()) throw std::runtime_error("fill_: undefined array");
   284	  if (!a.device.is_cuda()) throw std::runtime_error("fill_: CUDA arrays only");
   285	  int64_t n = a.numel();
   286	  if (n == 0) return;
   287	  DISPATCH_FLOAT(a.dtype, T, {
   288	    fill_kernel<T><<<nblk(n), kT>>>(static_cast<T*>(a.data_ptr()), n, (float)value);
   289	  });
   290	  cuda_check_last("fill_");
   291	  a.mark_modified();
   292	}
   293	NDArray NDArray::from_host(const void* src, const Shape& shape, DType dtype, Device device) {
   294	  NDArray a(shape, dtype, device);
   295	  size_t bytes = a.numel() * dtype_size(dtype);
   296	  if (bytes == 0) return a;
   297	  if (device.is_cuda()) cudaMemcpy(a.data_ptr(), src, bytes, cudaMemcpyHostToDevice);
   298	  else std::memcpy(a.data_ptr(), src, bytes);
   299	  cuda_check_last("from_host");
   300	  return a;
   301	}
   302	void NDArray::to_host(void* dst) const {
   303	  size_t bytes = numel() * dtype_size(dtype);
   304	  if (bytes == 0) return;
   305	  if (device.is_cuda()) cudaMemcpy(dst, data_ptr(), bytes, cudaMemcpyDeviceToHost);
   306	  else std::memcpy(dst, data_ptr(), bytes);
   307	  cuda_check_last("to_host");
   308	}
   309	NDArray NDArray::clone() const {
   310	  NDArray out(shape, dtype, device);
   311	  size_t bytes = numel() * dtype_size(dtype);
   312	  if (bytes) cudaMemcpy(out.data_ptr(), data_ptr(), bytes, cudaMemcpyDeviceToDevice);
   313	  return out;
   314	}
   315	NDArray NDArray::to(Device dev) const {
   316	  if (dev.is_cuda() == device.is_cuda()) return clone();
   317	  NDArray out(shape, dtype, dev);
   318	  size_t bytes = numel() * dtype_size(dtype);
   319	  cudaMemcpyKind k = device.is_cuda() ? cudaMemcpyDeviceToHost : cudaMemcpyHostToDevice;
   320	  if (bytes) cudaMemcpy(out.data_ptr(), data_ptr(), bytes, k);

