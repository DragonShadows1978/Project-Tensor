    58	Conv1dPlan plan_conv1d(const std::vector<int64_t>& xs, const std::vector<int64_t>& ws, const std::vector<int64_t>* bs,
    59	                       int64_t stride, int64_t pb, int64_t pe, int64_t dilation, int64_t groups) {
    60	  check_attr("stride", stride, 1);
    61	  check_attr("dilation", dilation, 1);
    62	  check_attr("groups", groups, 1);
    63	  check_attr("pad_begin", pb, 0);
    64	  check_attr("pad_end", pe, 0);
    65	  Conv1dPlan p{};
    66	  Conv1dGeom& g = p.g;
    67	  g.N = xs[0];
    68	  g.C_in = xs[1];
    69	  g.T = xs[2];
    70	  g.C_out = ws[0];
    71	  g.K = ws[2];
    72	  g.stride = stride;
    73	  g.pad_begin = pb;
    74	  g.pad_end = pe;
    75	  g.dilation = dilation;
    76	  g.groups = groups;
    77	  std::ostringstream os;
    78	  if (g.C_in % groups != 0) {
    79	    os << "conv1d: C_in (" << g.C_in << ") is not divisible by groups (" << groups << ")";
    80	    bad_attr(os.str());
    81	  }
    82	  if (ws[1] != g.C_in / groups) {
    83	    os << "conv1d: w.shape[1] (" << ws[1] << ") != C_in/groups (" << g.C_in / groups << "); w is [C_out, C_in/groups, K]";
    84	    bad_attr(os.str());
    85	  }
    86	  if (g.C_out % groups != 0) {
    87	    os << "conv1d: C_out (" << g.C_out << ") is not divisible by groups (" << groups << ")";
    88	    bad_attr(os.str());
    89	  }
    90	  if (bs != nullptr && (bs->size() != 1 || (*bs)[0] != g.C_out)) {
    91	    os << "conv1d: b has shape " << shape_str(*bs) << ", expected [" << g.C_out << "]";
    92	    bad_attr(os.str());
    93	  }
    94	  // Integer arithmetic in int64 (attributes are <= INT_MAX, dimensions come from real tensors). Python's floor
    95	  // division and C++'s truncation differ for a negative numerator, so the sign is checked first.
    96	  const int64_t num = g.T + pb + pe - dilation * (g.K - 1) - 1;
    97	  if (num < 0) {
    98	    os << "conv1d: output length (T + pb + pe - dilation*(K-1) - 1)//stride + 1 = (" << g.T << " + " << pb << " + "
    99	       << pe << " - " << dilation << "*" << (g.K - 1) << " - 1)//" << stride << " + 1 is <= 0";
   100	    bad_attr(os.str());
   101	  }
   102	  g.T_out = num / stride + 1;
   103	  g.direct = (g.K == 1 && stride == 1 && pb == 0 && pe == 0);
   104	  const int64_t Og = g.C_out / groups;
   105	  const int64_t CgK = (g.C_in / groups) * g.K;
   106	  check_int_range("T_out", g.T_out);
   107	  check_int_range("C_out/groups", Og);
   108	  check_int_range("C_in/groups*K", CgK);
   109	  p.out_shape = {g.N, g.C_out, g.T_out};
   110	  p.scratch_numel = g.direct ? 0 : g.C_in * g.K * g.T_out;
   111	  return p;
   112	}
