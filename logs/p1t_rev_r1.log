    97	// Sum of every thread's `v` over the block, by a fixed tree (stride B/2, B/4, ..., 1); every thread gets the total.
    98	template <int B>
    99	__device__ __forceinline__ float block_tree_sum(float v, float* red) {
   100	  red[threadIdx.x] = v;
   101	  __syncthreads();
   102	#pragma unroll
   103	  for (int s = B / 2; s > 0; s >>= 1) {
   104	    if (static_cast<int>(threadIdx.x) < s) red[threadIdx.x] = red[threadIdx.x] + red[threadIdx.x + s];
   105	    __syncthreads();
   106	  }
   107	  const float total = red[0];
   108	  __syncthreads();  // every thread has read red[0] before the next call overwrites red
   109	  return total;
   110	}
