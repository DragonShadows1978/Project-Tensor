    72	void same_device4(const std::vector<std::pair<const Peek4*, const char*>>& ps) {
    73	  int dev = -1;
    74	  const char* first = "";
    75	  for (const auto& pr : ps) {
    76	    if (!pr.first->present) continue;
    77	    if (dev < 0) {
    78	      dev = pr.first->device;
    79	      first = pr.second;
    80	    } else if (pr.first->device != dev) {
    81	      std::ostringstream os;
    82	      os << "on CUDA device " << pr.first->device << " but operand '" << first << "' is on CUDA device " << dev
    83	         << "; every operand must be on the same device";
    84	      bad_operand4(pr.second, os.str());
