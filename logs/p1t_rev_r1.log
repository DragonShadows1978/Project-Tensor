   234	// ------------------------------------------------------------------------------------------------ small ops: plan
   235	std::vector<int64_t> upsample_shape(const std::vector<int64_t>& xs, int64_t scale) {
   236	  if (scale < 1) {
   237	    std::ostringstream os;
   238	    os << "upsample_nearest1d: scale must be an integer >= 1, got " << scale;
   239	    bad_attr4(os.str());
   240	  }
   241	  const int64_t T = xs.back();
   242	  const int64_t lim = std::numeric_limits<int64_t>::max();
   243	  if (scale > lim / T || prod(xs, 0, xs.size() - 1) > lim / (T * scale)) {
   244	    std::ostringstream os;
   245	    os << "upsample_nearest1d: output size overflows int64 (T " << T << " x scale " << scale << ")";
   246	    bad_attr4(os.str());
   247	  }
   248	  std::vector<int64_t> o = xs;
   249	  o.back() = T * scale;
   250	  return o;
   251	}
   252	
   253	std::vector<int64_t> pad_shape(const std::vector<int64_t>& xs, int64_t pb, int64_t pe) {
   254	  const int64_t T = xs.back();
   255	  std::ostringstream os;
   256	  if (pb < 0 || pe < 0) {
   257	    os << "reflection_pad1d: pads must be >= 0, got (" << pb << ", " << pe << ")";
   258	    bad_attr4(os.str());
   259	  }
   260	  if (pb >= T || pe >= T) {
   261	    os << "reflection_pad1d: each pad must be < T (" << T << ") for reflect padding (ONNX/torch), got (" << pb << ", "
   262	       << pe << ")";
   263	    bad_attr4(os.str());
   264	  }
   265	  std::vector<int64_t> o = xs;
   266	  o.back() = T + pb + pe;
   267	  return o;
   268	}
