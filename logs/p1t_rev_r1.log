    76	// Makes `device` current for the call and restores the caller's device afterwards.
    77	class DeviceGuard {
    78	 public:
    79	  explicit DeviceGuard(int device) {
    80	    check_cuda(cudaGetDevice(&prev_), "cudaGetDevice");
    81	    if (prev_ != device) {
    82	      check_cuda(cudaSetDevice(device), "cudaSetDevice");
    83	      changed_ = true;
    84	    }
    85	  }
    86	  ~DeviceGuard() {
    87	    if (changed_) cudaSetDevice(prev_);
    88	  }
    89	  DeviceGuard(const DeviceGuard&) = delete;
    90	  DeviceGuard& operator=(const DeviceGuard&) = delete;
