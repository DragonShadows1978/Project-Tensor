     1	// tc_signal 1-D convolutions (P1T-M2: T2 Conv1d, T3 ConvTranspose1d). fp32, deterministic, no atomics, no fast-math.
     2	//
     3	// Numerics contract (Project-Voice TENSOR_IMPL_PLAN_P1T.md §4; tc_signal plan §4):
     4	//  * fp32 math throughout; cuBLAS in CUBLAS_DEFAULT_MATH (never TF32) with atomics not allowed;
     5	//  * every output element is produced by exactly one thread (or one cuBLAS dot product) in a fixed order, so two calls
     6	//    on the same inputs are bitwise equal; no atomicAdd anywhere in this package;
     7	//  * no intrinsics such as __expf/__fdividef and no --use_fast_math (CMakeLists.txt refuses it). FMA contraction is
     8	//    nvcc's default (--fmad=true, not a fast-math flag); the gather kernel spells its FMA out with fmaf().
     9	//
    10	// Prior art:
    11	//  * im2col + GEMM convolution: Chellapilla, Puri & Simard, "High Performance Convolutional Neural Networks for
    12	//    Document Processing" (2006). Taken: unfold the receptive fields into a matrix and run one SGEMM. Ours: the 1-D
    13	//    unfold with dilation and separate (pad_begin, pad_end), the per-batch-element scratch reuse, and the group batch
    14	//    as a strided-batched SGEMM.
    15	//  * Row-major GEMM through column-major BLAS by computing C^T = B^T A^T: standard BLAS practice (no single source).
    16	//  * Gather-form transposed convolution: transposed convolution is the adjoint of the strided convolution
    17	//    (Dumoulin & Visin, "A guide to convolution arithmetic for deep learning", 2016); evaluating each output as a sum
    18	//    over the input taps that land on it (instead of scattering inputs) is the usual deterministic formulation.
    19	//    Taken: the tap condition (t + pb - k*dilation) % stride == 0. Ours: the fixed loop order (k outer ascending,
    20	//    c inner ascending, bias last) and the thread mapping.
    21	//  * Semantics: ONNX Conv / ConvTranspose operator specs (1-D case; pads = (begin, end), ConvTranspose weight layout
    22	//    [C_in, C_out/groups, K], output_padding appended at the end).
    23	#include "conv_ops.h"
    24	
    25	#include <cublas_v2.h>
    26	#include <cuda_runtime.h>
    27	
    28	#include <algorithm>
    29	#include <sstream>
    30	#include <stdexcept>
    31	#include <string>
    32	#include <unordered_map>
    33	
    34	#include "tuning.h"
    35	
    36	#ifdef CUDA_API_PER_THREAD_DEFAULT_STREAM
    37	#error "tc_signal queues on the legacy default stream (stream 0); do not build it with --default-stream per-thread"
    38	#endif
    39	// nvcc 12.6 defines no preprocessor macro for --use_fast_math (it only passes -ftz=1 -prec_div=0 -prec_sqrt=0 to
    40	// cicc), so fast-math cannot be refused here at compile time. CMakeLists.txt refuses the flag at configure time, and
    41	// fp32_divide_probe_kernel below is a runtime canary compiled with this TU's flags (tests/test_conv.py checks it).
    42	
    43	namespace tcs {
    44	
    45	namespace {
    46	
    47	// Stream 0 is the legacy default stream in this translation unit (per-thread default stream refused above). It is the
    48	// same stream TensorCUDA queues on, and the stream DLPack producers were asked to order against (stream=1).
    49	constexpr cudaStream_t kLegacyStream = 0;
    50	
    51	void check_cuda(cudaError_t e, const char* what) {
    52	  if (e != cudaSuccess) {
    53	    std::ostringstream os;
    54	    os << "tc_signal: " << what << " failed: " << cudaGetErrorName(e) << ": " << cudaGetErrorString(e);
    55	    throw std::runtime_error(os.str());
    56	  }
    57	}
    58	
    59	// Checked after every kernel launch (launch-configuration and sticky errors surface here as RuntimeError).
    60	void check_launch(const char* kernel) { check_cuda(cudaGetLastError(), kernel); }
    61	
    62	void check_cublas(cublasStatus_t s, const char* what) {
    63	  if (s != CUBLAS_STATUS_SUCCESS) {
    64	    std::ostringstream os;
    65	    os << "tc_signal: " << what << " failed: cuBLAS status " << static_cast<int>(s);
    66	    throw std::runtime_error(os.str());
    67	  }
    68	}
    69	
    70	unsigned int grid_for(int64_t total, int block) {
    71	  const int64_t blocks = (total + block - 1) / block;
    72	  return static_cast<unsigned int>(std::max<int64_t>(1, std::min<int64_t>(blocks, tuning::kGridCap)));
    73	}
    74	
    75	// Makes `device` current for the call and restores the caller's device afterwards.
    76	class DeviceGuard {
    77	 public:
    78	  explicit DeviceGuard(int device) {
    79	    check_cuda(cudaGetDevice(&prev_), "cudaGetDevice");
    80	    if (prev_ != device) {
    81	      check_cuda(cudaSetDevice(device), "cudaSetDevice");
    82	      changed_ = true;
    83	    }
    84	  }
    85	  ~DeviceGuard() {
    86	    if (changed_) cudaSetDevice(prev_);
    87	  }
    88	  DeviceGuard(const DeviceGuard&) = delete;
    89	  DeviceGuard& operator=(const DeviceGuard&) = delete;
    90	
    91	 private:
    92	  int prev_ = 0;
    93	  bool changed_ = false;
    94	};
    95	
    96	// One cuBLAS handle per device, created lazily on first use and kept for the life of the process (destroying it at
    97	// interpreter exit can race CUDA's own teardown). All entry points run under the GIL, so no extra lock is needed.
    98	// cuBLAS allocates its own internal workspace for this handle on first use (cudaMalloc inside cuBLAS); that is the
    99	// only device memory tc_signal causes to be allocated outside the caller's allocator (README "cuBLAS").
   100	cublasHandle_t handle_for(int device) {
   101	  static std::unordered_map<int, cublasHandle_t> handles;
   102	  auto it = handles.find(device);
   103	  if (it != handles.end()) return it->second;
   104	  cublasHandle_t h = nullptr;
   105	  check_cublas(cublasCreate(&h), "cublasCreate");
   106	  check_cublas(cublasSetStream(h, kLegacyStream), "cublasSetStream(0)");
   107	  check_cublas(cublasSetMathMode(h, CUBLAS_DEFAULT_MATH), "cublasSetMathMode(CUBLAS_DEFAULT_MATH)");
   108	  check_cublas(cublasSetAtomicsMode(h, CUBLAS_ATOMICS_NOT_ALLOWED), "cublasSetAtomicsMode(NOT_ALLOWED)");
   109	  check_cublas(cublasSetPointerMode(h, CUBLAS_POINTER_MODE_HOST), "cublasSetPointerMode(HOST)");
   110	  handles.emplace(device, h);
   111	  return h;
   112	}
   113	
   114	// ------------------------------------------------------------------------------------------------ kernels
   115	// 1-D im2col for one batch element (Chellapilla et al. 2006, 1-D with dilation and asymmetric zero padding):
   116	//   col[(c*K + k), t] = x[c, t*stride - pad_begin + k*dilation]   (0 outside [0, T))
   117	// Rows (c, k) are c-major, so group g's rows [g*Cg*K, (g+1)*Cg*K) form one contiguous [Cg*K, T_out] block that
   118	// matches w[g*Og:(g+1)*Og] viewed as [Og, Cg*K].
   119	__global__ void im2col1d_kernel(const float* __restrict__ x, float* __restrict__ col, int64_t C, int64_t T, int64_t K,
   120	                                int64_t T_out, int64_t stride, int64_t pad_begin, int64_t dilation) {
   121	  const int64_t total = C * K * T_out;
   122	  for (int64_t i = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; i < total;
   123	       i += static_cast<int64_t>(gridDim.x) * blockDim.x) {
   124	    const int64_t t = i % T_out;
   125	    const int64_t r = i / T_out;
   126	    const int64_t k = r % K;
   127	    const int64_t c = r / K;
   128	    const int64_t src = t * stride - pad_begin + k * dilation;
   129	    col[i] = (src >= 0 && src < T) ? x[c * T + src] : 0.0f;
   130	  }
   131	}
   132	
   133	// y[n, o, t] += b[o], one thread per output element (fp32 add, one rounding).
   134	__global__ void bias_add_kernel(float* __restrict__ y, const float* __restrict__ b, int64_t C_out, int64_t T_out,
   135	                                int64_t total) {
   136	  for (int64_t i = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; i < total;
   137	       i += static_cast<int64_t>(gridDim.x) * blockDim.x) {
   138	    const int64_t o = (i / T_out) % C_out;
   139	    y[i] = y[i] + b[o];
   140	  }
   141	}
   142	
   143	// Gather-form ConvTranspose1d (adjoint of strided conv, Dumoulin & Visin 2016), one thread per output element:
   144	//   y[n, o, t] = b[o] + sum_{k=0..K-1} sum_{c in group(o)} w[c, o - g*Og, k] * x[n, c, (t + pb - k*dilation)/stride]
   145	// over the taps with (t + pb - k*dilation) >= 0, divisible by stride, and quotient < T. Fixed order: k ascending
   146	// (outer), c ascending within the group (inner), fp32 fmaf accumulation from 0, bias added last. No atomics.
   147	__global__ void conv_transpose1d_gather_kernel(const float* __restrict__ x, const float* __restrict__ w,
   148	                                               const float* __restrict__ b, float* __restrict__ y, int64_t N,
   149	                                               int64_t C_in, int64_t T, int64_t C_out, int64_t K, int64_t T_out,
   150	                                               int64_t stride, int64_t pad_begin, int64_t dilation, int64_t groups) {
   151	  const int64_t Cg = C_in / groups;
   152	  const int64_t Og = C_out / groups;
   153	  const int64_t total = N * C_out * T_out;
   154	  for (int64_t i = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; i < total;
   155	       i += static_cast<int64_t>(gridDim.x) * blockDim.x) {
   156	    const int64_t t = i % T_out;
   157	    const int64_t r = i / T_out;
   158	    const int64_t o = r % C_out;
   159	    const int64_t n = r / C_out;
   160	    const int64_t g = o / Og;
   161	    const int64_t ol = o - g * Og;
   162	    const float* xg = x + (n * C_in + g * Cg) * T;   // x[n, g*Cg + cl, :] = xg[cl*T + :]
   163	    const float* wg = w + (g * Cg * Og + ol) * K;    // w[g*Cg + cl, ol, k] = wg[cl*Og*K + k]
   164	    float acc = 0.0f;
   165	    for (int64_t k = 0; k < K; ++k) {
   166	      const int64_t s = t + pad_begin - k * dilation;
   167	      if (s < 0 || s % stride != 0) continue;
   168	      const int64_t q = s / stride;
   169	      if (q >= T) continue;
   170	      const float* xp = xg + q;
   171	      const float* wp = wg + k;
   172	      for (int64_t cl = 0; cl < Cg; ++cl) acc = fmaf(wp[cl * Og * K], xp[cl * T], acc);
   173	    }
   174	    if (b != nullptr) acc = acc + b[o];
   175	    y[i] = acc;
   176	  }
   177	}
   178	
   179	// Fast-math canary: out[i] = x[i] / y[i] in fp32. Built with this TU's flags, so --use_fast_math (-ftz=1,
   180	// -prec_div=0) shows up as flushed subnormals or non-IEEE quotients, which the tests compare bitwise against the host's
   181	// IEEE fp32 division. Prior art: no specific source known to me (it is the usual "test the build flags by their
   182	// observable effect" idea; denormal flushing as a fast-math symptom is documented in the CUDA C Programming Guide).
   183	__global__ void fp32_divide_probe_kernel(const float* __restrict__ x, const float* __restrict__ y,
   184	                                         float* __restrict__ out, int64_t n) {
   185	  for (int64_t i = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; i < n;
   186	       i += static_cast<int64_t>(gridDim.x) * blockDim.x)
   187	    out[i] = x[i] / y[i];
   188	}
   189	
   190	}  // namespace
   191	
   192	void fp32_divide_probe(int device, const float* x, const float* y, float* out, int64_t n) {
   193	  DeviceGuard guard(device);
   194	  fp32_divide_probe_kernel<<<grid_for(n, tuning::kProbeBlock), tuning::kProbeBlock, 0, kLegacyStream>>>(x, y, out, n);
   195	  check_launch("fp32_divide_probe_kernel");
   196	}
   197	
   198	// ------------------------------------------------------------------------------------------------ Conv1d
   199	void conv1d_forward(int device, const Conv1dGeom& g, const float* x, const float* w, const float* b, float* y,
   200	                    float* col) {
   201	  DeviceGuard guard(device);
   202	  cublasHandle_t h = handle_for(device);
   203	  const int64_t Cg = g.C_in / g.groups;
   204	  const int64_t Og = g.C_out / g.groups;
   205	  const int64_t CgK = Cg * g.K;
   206	  const float alpha = 1.0f;
   207	  const float beta = 0.0f;
   208	  for (int64_t n = 0; n < g.N; ++n) {
   209	    const float* xn = x + n * g.C_in * g.T;
   210	    const float* A = nullptr;   // the [Cg*K, T_out] row-major operand of group 0 for this batch element
   211	    long long strideA = 0;
   212	    if (g.direct) {
   213	      // K == 1, stride 1, no pads: x[n] itself is the col matrix (T_out == T), no scratch.
   214	      A = xn;
   215	      strideA = static_cast<long long>(Cg * g.T);
   216	    } else {
   217	      // The scratch is reused for every n: the next im2col is queued after this n's GEMM on the same stream.
   218	      const int64_t total = g.C_in * g.K * g.T_out;
   219	      im2col1d_kernel<<<grid_for(total, tuning::kIm2colBlock), tuning::kIm2colBlock, 0, kLegacyStream>>>(
   220	          xn, col, g.C_in, g.T, g.K, g.T_out, g.stride, g.pad_begin, g.dilation);
   221	      check_launch("im2col1d_kernel");
   222	      A = col;
   223	      strideA = static_cast<long long>(CgK * g.T_out);
   224	    }
   225	    float* yn = y + n * g.C_out * g.T_out;
   226	    // Row-major Y_g[Og, T_out] = W_g[Og, CgK] . Col_g[CgK, T_out], computed as the column-major product
   227	    // Y_g^T[T_out, Og] = Col_g^T[T_out, CgK] . W_g^T[CgK, Og]: m = T_out, n = Og, k = CgK, both ops N,
   228	    // lda = T_out (col), ldb = CgK (w), ldc = T_out (y); one batch entry per group.
   229	    check_cublas(cublasSgemmStridedBatched(h, CUBLAS_OP_N, CUBLAS_OP_N, static_cast<int>(g.T_out),
   230	                                           static_cast<int>(Og), static_cast<int>(CgK), &alpha, A,
   231	                                           static_cast<int>(g.T_out), strideA, w, static_cast<int>(CgK),
   232	                                           static_cast<long long>(Og * CgK), &beta, yn, static_cast<int>(g.T_out),
   233	                                           static_cast<long long>(Og * g.T_out), static_cast<int>(g.groups)),
   234	                 "cublasSgemmStridedBatched");
   235	    check_launch("cublasSgemmStridedBatched");
   236	  }
   237	  if (b != nullptr) {
   238	    const int64_t total = g.N * g.C_out * g.T_out;
   239	    bias_add_kernel<<<grid_for(total, tuning::kBiasBlock), tuning::kBiasBlock, 0, kLegacyStream>>>(y, b, g.C_out,
   240	                                                                                                   g.T_out, total);
   241	    check_launch("bias_add_kernel");
   242	  }
   243	}
   244	
   245	// ------------------------------------------------------------------------------------------------ ConvTranspose1d
   246	void conv_transpose1d_forward(int device, const ConvTranspose1dGeom& g, const float* x, const float* w,
   247	                              const float* b, float* y) {
   248	  DeviceGuard guard(device);
   249	  const int64_t total = g.N * g.C_out * g.T_out;
   250	  conv_transpose1d_gather_kernel<<<grid_for(total, tuning::kConvTransposeBlock), tuning::kConvTransposeBlock, 0,
   251	                                   kLegacyStream>>>(x, w, b, y, g.N, g.C_in, g.T, g.C_out, g.K, g.T_out, g.stride,
   252	                                                    g.pad_begin, g.dilation, g.groups);
   253	  check_launch("conv_transpose1d_gather_kernel");
   254	}
