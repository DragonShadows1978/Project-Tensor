    51	void check_cuda(cudaError_t e, const char* what) {
    52	  if (e != cudaSuccess) {
    53	    std::ostringstream os;
    54	    os << "tc_signal: " << what << " failed: " << cudaGetErrorName(e) << ": " << cudaGetErrorString(e);
    55	    throw std::runtime_error(os.str());
