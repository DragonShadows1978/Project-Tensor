    93	  } catch (py::error_already_set& e) {
    94	    // A producer that predates the 2023 keywords rejects them with TypeError: retry with the stream argument only
    95	    // (the array API standard's documented fallback; NumPy and PyTorch consumers do the same).
    96	    if (!e.matches(PyExc_TypeError)) throw;
