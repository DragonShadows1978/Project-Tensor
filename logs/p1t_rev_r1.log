   275	void upsample_run(py::object xc, py::object out, int64_t scale) {
   276	  Operand X = consume4(xc, "x", -1, 1);
   277	  const std::vector<int64_t> xs = shape4(X);
   278	  const std::vector<int64_t> os = upsample_shape(xs, scale);
   279	  Operand Y(to_capsule(out, "out", true), "out", X.ndim(), true);
   280	  expect_shape(Y, os);
   281	  const int device = common_device({&X, &Y});
   282	  expect_disjoint(Y, X);
   283	  upsample_nearest1d_forward(device, prod(xs, 0, xs.size() - 1), xs.back(), scale, X.data(), Y.data());
   284	}
