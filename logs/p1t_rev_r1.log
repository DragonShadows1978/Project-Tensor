   147	  g.channels = g.groups = g.ch_per_group = g.T = 1;
   148	  const int64_t r = static_cast<int64_t>(xs.size());
   149	  std::ostringstream os;
   150	  if (kind == NormKind::kInstance || kind == NormKind::kGroup) {
