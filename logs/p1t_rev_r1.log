   110	void upsample_nearest1d_forward(int device, int64_t rows, int64_t T, int64_t scale, const float* x, float* y) {
   111	  DeviceGuard guard(device);
   112	  const int64_t T_out = T * scale;
   113	  const int64_t total = rows * T_out;
   114	  constexpr int B = m4tuning::kCopyBlock;
   115	  upsample_nearest1d_kernel<<<grid_for(total, B), B, 0, kLegacyStream>>>(
   116	      reinterpret_cast<const uint32_t*>(x), reinterpret_cast<uint32_t*>(y), total, T, T_out, scale);
   117	  check_cuda(cudaGetLastError(), "upsample_nearest1d_kernel");
   118	}
   119	
   120	void reflection_pad1d_forward(int device, int64_t rows, int64_t T, int64_t pad_begin, int64_t pad_end, const float* x,
   121	                              float* y) {
   122	  DeviceGuard guard(device);
   123	  const int64_t T_out = T + pad_begin + pad_end;
   124	  const int64_t total = rows * T_out;
   125	  constexpr int B = m4tuning::kCopyBlock;
   126	  reflection_pad1d_kernel<<<grid_for(total, B), B, 0, kLegacyStream>>>(
   127	      reinterpret_cast<const uint32_t*>(x), reinterpret_cast<uint32_t*>(y), total, T, T_out, pad_begin);
   128	  check_cuda(cudaGetLastError(), "reflection_pad1d_kernel");
   129	}
   130	
   131	void rint_forward(int device, int64_t n, const float* x, float* y) {
   132	  DeviceGuard guard(device);
   133	  constexpr int B = m4tuning::kCopyBlock;
   134	  rint_kernel<<<grid_for(n, B), B, 0, kLegacyStream>>>(x, y, n);
   135	  check_cuda(cudaGetLastError(), "rint_kernel");
   136	}
   137	
   138	}  // namespace tcs

