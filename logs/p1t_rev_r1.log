   189	// ------------------------------------------------------------------------------------------------ Operand
   190	Operand::Operand(py::handle capsule, const char* role, int ndim, bool writable) : role_(role) {
   191	  if (!PyCapsule_CheckExact(capsule.ptr())) refuse_type(role, "expected a DLPack capsule, got " + type_name(capsule));
   192	  const bool versioned = capsule_kind(capsule, role);
   193	  // Consume: take the pointer, rename the capsule to "used_*" (so its destructor no longer calls the deleter), and
   194	  // own the managed tensor from here on (owner_ calls the deleter on every path, including a throw below).
   195	  if (versioned) {
   196	    auto* m = static_cast<DLManagedTensorVersioned*>(capsule_pointer(capsule, kCapsuleVersioned));
   197	    if (PyCapsule_SetName(capsule.ptr(), kUsedCapsuleVersioned) != 0) throw py::error_already_set();
   198	    owner_.versioned = m;
   199	    check_version(m, role);
   200	    if (writable && (m->flags & DLPACK_FLAG_BITMASK_READ_ONLY))
   201	      refuse_value(role, "the producer marked this tensor read-only; tc_signal writes this operand");
   202	    if (writable && (m->flags & DLPACK_FLAG_BITMASK_IS_COPIED))
   203	      refuse_value(role, "the producer exported a copy; writes to it would not reach the caller's tensor");
   204	    t_ = &m->dl_tensor;
   205	  } else {
   206	    auto* m = static_cast<DLManagedTensor*>(capsule_pointer(capsule, kCapsule));
   207	    if (PyCapsule_SetName(capsule.ptr(), kUsedCapsule) != 0) throw py::error_already_set();
   208	    owner_.legacy = m;
   209	    t_ = &m->dl_tensor;
   210	  }
   211	  validate_tensor(t_, role, ndim);
   212	  data_ = reinterpret_cast<float*>(static_cast<char*>(t_->data) + t_->byte_offset);  // byte_offset honoured
   213	}
