   463	  // cudaStreamWaitEvent call and the runtime frees the event once it fires.
   464	  const cudaError_t de = ev ? cudaEventDestroy(ev) : cudaSuccess;  // on its own device
   465	  const cudaError_t re = switched ? cudaSetDevice(prev) : cudaSuccess;
