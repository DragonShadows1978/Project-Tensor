   468	  std::string msg = "__dlpack__: stream fence on the tensor's CUDA device " + dev + " failed:";
   469	  if (e != cudaSuccess) msg += std::string(" ") + step + " (" + name(e) + ");";
   470	  if (de != cudaSuccess) msg += " cudaEventDestroy (" + name(de) + ");";
   471	  if (re != cudaSuccess)
   472	    msg += " restoring the caller's CUDA device " + std::to_string(prev) + " also failed (cudaSetDevice: " + name(re) +
   473	           "), so the calling thread's current device is still " + dev;
   474	  else if (switched)
   475	    msg += " the caller's CUDA device " + std::to_string(prev) + " was restored";
   476	  throw std::runtime_error(msg);
   477	}
