   533	  bool query_failed = false;               // cudaGetDevice failed (N1: never a success)
   534	  cudaError_t query_error = cudaSuccess;
   535	  int n = 0;
   536	  int dev[tuning::kSyncReportMax];
   537	  cudaError_t err[tuning::kSyncReportMax];
