   689	// Phase 1: synchronize the legacy stream of the current device and of every device with pending entries (no deleter
   690	// runs, so iterating the live list is safe). Phase 2: pop entries in FIFO order and release each one whose event has
   691	// completed; leak (counted) an entry with no completion proof whose device could not be synchronized or whose event
   692	// query failed; stop at the first entry that is merely not ready on a device that DID synchronize: it was pushed after
   693	// phase 1 by a re-entrant call (a deleter that calls tc_signal) and is left pending. Every entry is popped before its
   694	// deleters run, so a re-entrant drain or bound drain pops each entry at most once. No allocation, never throws.
   695	SyncReport sync_and_release_all_impl() noexcept {
   696	  PendingState& st = pending();
   697	  SyncReport rep;
   698	  DeviceSyncSet set;
   699	  int cur = -1;
   700	  const cudaError_t qe = cudaGetDevice(&cur);
   701	  if (qe != cudaSuccess) {
   702	    cudaGetLastError();
   703	    rep.query_failed = true;  // N1: was silently skipped (synchronize() then "succeeded" with no device)
   704	    rep.query_error = qe;
   705	  } else {
   706	    set.sync(cur);
   707	  }
   708	  for (const PendingEntry& e : st.q) set.sync(e.device);
   709	  for (int i = 0; i < set.n; ++i)
   710	    if (set.err[i] != cudaSuccess) rep.add(set.dev[i], set.err[i]);
   711	  if (set.spill_failed) rep.add(-1, set.spill_error);
   712	
   713	  while (!st.q.empty()) {
   714	    const cudaError_t r = cudaEventQuery(st.q.front().event);
   715	    const int dev = st.q.front().device;
   716	    const bool complete = (r == cudaSuccess);
   717	    if (!complete) {
   718	      if (r == cudaErrorNotReady) {
   719	        if (cudaPeekAtLastError() == cudaErrorNotReady) cudaGetLastError();
   720	        if (!set.failed(dev)) break;  // pushed after phase 1 (re-entrant call): not ours to force
   721	      } else {
   722	        cudaGetLastError();           // the event itself cannot be queried: no completion proof (N1: an error)
   723	        rep.add(dev, r);
   724	      }
   725	    }
   726	    PendingEntry e = std::move(st.q.front());
   727	    st.q.pop_front();
   728	    note_pop(st, e);
   729	    if (complete)
   730	      release_entry(st, e);
   731	    else
   732	      rep.leaked_managers += leak_entry(st, e);
   733	  }
   734	  return rep;
   735	}
