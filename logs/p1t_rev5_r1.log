   632	  if (!st.bytes_saturated && __builtin_add_overflow(st.bytes, e.bytes, &sum)) {
   633	    st.bytes_saturated = true;
   634	    ++st.bytes_saturations;
   635	  }
   636	  st.bytes = st.bytes_saturated ? std::numeric_limits<int64_t>::max() : sum;
   637	  st.managers += static_cast<long long>(e.owners.size());
   638	  ++st.retained_entries;
   639	  st.high_water_entries = std::max<long long>(st.high_water_entries, static_cast<long long>(st.q.size()));
   640	  st.high_water_managers = std::max(st.high_water_managers, st.managers);
   641	  st.high_water_bytes = std::max(st.high_water_bytes, st.bytes);
   642	}
