   593	void recycle_event(PendingState& st, int device, cudaEvent_t ev) noexcept {
   594	  if (ev == nullptr) return;
   595	  DeviceEvents* de = nullptr;
   596	  try {
   597	    auto it = st.event_pool.find(device);  // find, never operator[]: no insertion on the release path
   598	    if (it != st.event_pool.end()) de = &it->second;
