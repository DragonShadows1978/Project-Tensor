   644	// Called right after the entry was taken off the list.
   645	void note_pop(PendingState& st, const PendingEntry& e) noexcept {
   646	  if (st.bytes_saturated) {
   647	    if (st.q.empty()) {  // the true total is 0 again
   648	      st.bytes = 0;
   649	      st.bytes_saturated = false;
   650	    }
   651	  } else {
   652	    int64_t rest = 0;
   653	    // Exact while not saturated (e.bytes <= st.bytes); the guard only keeps a corrupted total from wrapping.
   654	    st.bytes = (__builtin_sub_overflow(st.bytes, e.bytes, &rest) || rest < 0) ? 0 : rest;
   655	  }
   656	  st.managers -= static_cast<long long>(e.owners.size());
   657	}
