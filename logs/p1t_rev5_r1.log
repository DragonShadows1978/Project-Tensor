   676	// Returns the number of managers leaked.
   677	unsigned long long leak_entry(PendingState& st, PendingEntry& e) noexcept {
   678	  unsigned long long n = 0;
   679	  for (ManagedOwner& o : e.owners) {
   680	    if (!o.empty()) ++n;
   681	    o.leak();
   682	  }
   683	  st.leaked_managers += n;
   684	  // The event is not recycled either: it may belong to a broken context.
   685	  e.event = nullptr;
   686	  return n;
   687	}
