   774	int64_t aggregate_operand_bytes(const std::vector<Operand*>& ops) {
   775	  // V3-02 (see dlpack_operand.h): checked sum of the present operands' fp32 bytes; ValueError on overflow (ck_add).
   776	  // Prior art: the checked builtins (GCC 5 __builtin_add_overflow, 2015; C23 ckd_add), as in checked_math.h. Ours:
   777	  // checking the per-call aggregate before the first launch, where a refusal can still raise.
   778	  int64_t total = 0;
   779	  for (const Operand* op : ops) {
   780	    if (op == nullptr || !op->present()) continue;
   781	    const int64_t b = op->numel() * static_cast<int64_t>(sizeof(float));  // checked at construction (F03)
   782	    total = ck_add(total, b, "the aggregate fp32 byte count of this call's operands (their sum)");
   783	  }
   784	  return total;
   785	}
