   659	// V3-02: the bound comparison after a push. Exact below INT64_MAX (a total of exactly kPendingMaxBytes is within the
   660	// bound, one byte more is over it, as before); a saturated total is over it.
   661	bool pending_over_bound(const PendingState& st) noexcept {
   662	  return static_cast<long long>(st.q.size()) > tuning::kPendingMaxEntries || st.bytes_saturated ||
   663	         st.bytes > tuning::kPendingMaxBytes;
   664	}
