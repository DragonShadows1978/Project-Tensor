   442	    e = cudaSetDevice(device);
   443	    if (e != cudaSuccess) {
   444	      cudaGetLastError();
   445	      throw std::runtime_error("__dlpack__: stream fence: cannot make the tensor's CUDA device " + dev +
   446	                               " current (cudaSetDevice: " + name(e) + "); the caller's device " +
   447	                               std::to_string(prev) + " is unchanged and nothing was recorded");
   448	    }
