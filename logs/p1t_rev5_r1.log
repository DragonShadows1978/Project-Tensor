   135	    std::ostringstream os;
   136	    os << "dtype (code " << static_cast<int>(t->dtype.code) << ", bits " << static_cast<int>(t->dtype.bits)
   137	       << ", lanes " << t->dtype.lanes
   138	       << ") is not float32; tc_signal computes in fp32 only (expand fp16 weights to fp32 first)";
   139	    refuse_type(role, os.str());
