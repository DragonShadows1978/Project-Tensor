   151	    refuse_value(role, os.str());
   152	  }
   153	  // F03: checked element count and fp32 byte total, before the stride walk below multiplies extents and before any
   154	  // later byte range is formed.
   155	  // P1T-FIX2, review finding N2 (zero-extent rule, checked_math.h ck_extent_bound): EVERY extent is multiplied (a zero
   156	  // or negative one counted as 1) BEFORE the empty-operand refusal, so a shape such as [0, 2^62, 4] is refused as an
   157	  // overflow, never waved through because its count is 0. Prior art: NumPy's array constructor rule (see
   158	  // checked_math.h); the checked builtins (GCC 5, 2015).
   159	  int64_t numel = 1;
