   734	template <typename M>
   735	void import_release_impl(M* m) noexcept {
   736	  if (!m || !m->deleter) return;
   737	  ImportReleaseLifecycle& lc = release_lifecycle();
   738	  bool admitted = false;
   739	  try {
   740	    std::lock_guard<std::mutex> lk(lc.mu);
   741	    // Both checks leak without touching the GIL; the order only decides which counter records it (a release during
   742	    // finalization keeps FIX1's leaked_interpreter_shutdown attribution).
   743	    if (!interpreter_accepts_gil_state()) {
   744	      g_import_leaked_shutdown.fetch_add(1);         // F04: second line of defence
   745	    } else if (lc.closing) {
   746	      g_import_leaked_closing.fetch_add(1);          // N5: after the exit hook closed admission: deliberate leak
   747	    } else {
   748	      ++lc.in_flight;
   749	      admitted = true;
   750	    }
   751	  } catch (...) {
   752	    g_import_lock_failures.fetch_add(1);
   753	  }
   754	  if (!admitted) return;
   755	  ++t_admitted_depth;                                // V3-01: this thread now has an admitted release on its stack
   756	  PyGILState_STATE g = PyGILState_Ensure();
   757	  try {
   758	    m->deleter(m);
   759	    g_import_released.fetch_add(1);
   760	  } catch (...) {
   761	    g_import_deleter_exceptions.fetch_add(1);        // N4: contained (GIL still held while the exception dies)
   762	  }
   763	  PyGILState_Release(g);
   764	  // Leave only after PyGILState_Release: the exit hook must not let finalization start while this thread still
   765	  // touches the interpreter. notify_all on every leave (not only at zero): the hook may be waiting for a nonzero
   766	  // count, its own thread's admitted releases (V3-01 self-exclusion).
   767	  try {
   768	    std::lock_guard<std::mutex> lk(lc.mu);
