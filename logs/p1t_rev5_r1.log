   249	void ManagedOwner::reset() noexcept {
   250	  // DLPack consumer rule: when done, call the producer's deleter (it may be NULL). Called with the GIL held (every
   251	  // tc_signal entry point runs under the GIL), so a deleter that touches Python objects is safe.
   252	  if (legacy != nullptr) {
   253	    DLManagedTensor* m = legacy;
   254	    legacy = nullptr;  // cleared first: never called twice, even if the deleter throws or re-enters
   255	    call_deleter_contained(m);
   256	  }
   257	  if (versioned != nullptr) {
   258	    DLManagedTensorVersioned* m = versioned;
   259	    versioned = nullptr;
   260	    call_deleter_contained(m);
   261	  }
   262	}
