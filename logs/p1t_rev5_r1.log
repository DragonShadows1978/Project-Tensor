   500	// N1/N3: the devices one sync_and_release_all_impl call synchronized, with each result. Fixed capacity, no allocation.
   501	// A device beyond the capacity is still synchronized; its failure is remembered only as `spill_failed`, which makes
   502	// every unrecorded device count as failed (conservative: its not-yet-complete entries are leaked, never released).
   503	struct DeviceSyncSet {
   504	  int dev[tuning::kSyncMaxDevices];
   505	  cudaError_t err[tuning::kSyncMaxDevices];
