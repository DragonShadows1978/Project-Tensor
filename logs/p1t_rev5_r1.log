   737	cudaEvent_t acquire_event(int device) {
   738	  PendingState& st = pending();
   739	  DeviceEvents& de = st.event_pool[device];  // may allocate: constructor path, nothing has been launched yet
   740	  if (!de.free.empty()) {
   741	    cudaEvent_t ev = de.free.back();
   742	    de.free.pop_back();
   743	    return ev;
   744	  }
   745	  // N3: reserve the recycle slot of the event about to be created HERE, where an allocation failure only refuses the
   746	  // call (MemoryError, operands released at once), so returning the event to the pool later never allocates.
   747	  if (test_hooks::take(test_hooks::kAllocEventPoolReserve)) throw std::bad_alloc();
   748	  if (de.free.capacity() < de.created + 1) de.free.reserve(std::max<size_t>(2 * de.free.capacity(), de.created + 1));
   749	  QuietDeviceGuard g(device);
   750	  cudaEvent_t ev = nullptr;
   751	  cudaError_t r = g.ok() ? cudaEventCreateWithFlags(&ev, cudaEventDisableTiming) : g.error();
   752	  if (r != cudaSuccess) {
   753	    cudaGetLastError();
   754	    std::ostringstream os;
   755	    os << "tc_signal: cannot create the completion event on CUDA device " << device << ": " << cudaGetErrorName(r)
   756	       << ": " << cudaGetErrorString(r);
   757	    throw std::runtime_error(os.str());
   758	  }
   759	  ++de.created;
   760	  return ev;
   761	}
