   427	      (s == 2) ? cudaStreamPerThread
   428	               : reinterpret_cast<cudaStream_t>(static_cast<uintptr_t>(s));
   429	  const std::string dev = std::to_string(device);
   430	  auto name = [](cudaError_t err) {
   431	    return std::string(cudaGetErrorName(err)) + ": " + cudaGetErrorString(err);
   432	  };
