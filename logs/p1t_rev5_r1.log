   539	  unsigned long long leaked_managers = 0;  // managers leaked by this call (no completion proof)
   540	
   541	  void add(int d, cudaError_t e) noexcept {
   542	    if (n < tuning::kSyncReportMax) {
   543	      dev[n] = d;
   544	      err[n] = e;
   545	      ++n;
   546	    } else {
   547	      ++unnamed;
   548	    }
   549	  }
   550	  bool failed() const noexcept { return query_failed || n > 0 || unnamed > 0 || leaked_managers > 0; }
   551	  int first_device() const noexcept { return n > 0 ? dev[0] : -1; }
   552	  cudaError_t first_error() const noexcept { return query_failed ? query_error : (n > 0 ? err[0] : cudaErrorUnknown); }
