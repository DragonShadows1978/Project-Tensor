   218	      os << "tc_signal: operand '" << roles[i] << "': on CUDA device " << ps[i]->device << " but operand '" << first
   219	         << "' is on CUDA device " << dev << "; every operand must be on the same device";
   220	      throw py::value_error(os.str());
   221	    }
   222	  }
   223	}
