   666	// Runs the entry's deleters (they may run Python and re-enter tc_signal; the entry is already off the list). A throwing
   667	// deleter is contained in ManagedOwner::reset (N4) and the loop goes on with the remaining managers.
   668	void release_entry(PendingState& st, PendingEntry& e) noexcept {
