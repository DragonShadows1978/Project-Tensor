   787	RetainUntilComplete::RetainUntilComplete(int device, std::initializer_list<Operand*> ops)
   788	    : device_(device), ops_(ops) {
   789	  // V3-02: refuse a call whose operands' aggregate byte count overflows int64, FIRST: before any allocation, event or
