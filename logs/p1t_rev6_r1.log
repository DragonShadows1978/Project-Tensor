   311	void CapsuleRef::drop() noexcept {
   312	  PyObject* p = p_;
   313	  p_ = nullptr;
   314	  if (p == nullptr) return;
   315	  if (!interpreter_accepts_python()) {
   316	    // Finalizing (for example a daemon thread unwinding after CPython exited it): never touch Python. Kept.
   317	    g_capsules_kept_finalizing.fetch_add(1, std::memory_order_relaxed);
   318	    return;
   319	  }
   320	  const char* name = PyCapsule_CheckExact(p) ? PyCapsule_GetName(p) : nullptr;
   321	  const bool unconsumed = name != nullptr && (std::strcmp(name, kCapsule) == 0 || std::strcmp(name, kCapsuleVersioned) == 0);
