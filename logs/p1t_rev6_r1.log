   474	#define DISPATCH_FLOAT(DT, T, ...)                                       \
   475	  do {                                                                   \
   476	    if ((DT) == DType::Float32) { using T = float; __VA_ARGS__; }        \
   477	    else if ((DT) == DType::Float16) { using T = __half; __VA_ARGS__; }  \
   478	    else if ((DT) == DType::BFloat16) { using T = __nv_bfloat16; __VA_ARGS__; } \
