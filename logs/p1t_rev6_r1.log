   548	void fill_(NDArray& a, double value) {
   549	  if (!a.defined()) throw std::runtime_error("fill_: undefined array");
   550	  if (!a.device.is_cuda()) throw std::runtime_error("fill_: CUDA arrays only");
   551	  if (a.dtype != DType::Float32 && a.dtype != DType::Float16 && a.dtype != DType::BFloat16)
   552	    throw std::runtime_error("op supports float32/float16/bfloat16 only");
   553	  int64_t n = a.numel();
   554	  if (n == 0) return;
   555	  const int64_t blocks = fill_grid_blocks(n);  // P1T-FIX5 V5-04: int64 block count; refused here if over the limit
   556	  const std::string mismatch = cuda_storage_device_mismatch(a, "fill_");
   557	  if (!mismatch.empty()) throw std::runtime_error(mismatch);
   558	  CheckedDeviceGuard guard(a.device.index, "fill_");
   559	  const cudaError_t pending = cudaGetLastError();
   560	  if (pending != cudaSuccess)
   561	    throw std::runtime_error(std::string("fill_: a CUDA error was already pending in this thread before the launch (") +
   562	                             cudaGetErrorName(pending) + ": " + cudaGetErrorString(pending) +
   563	                             "), from earlier work outside this call; taken from the error slot and reported here, nothing was launched");
   564	  DISPATCH_FLOAT(a.dtype, T, {
   565	    // P1T-FIX5 V5-04: blocks <= 2^31-1 (checked above), so this conversion is exact and blocks * kT >= n.
   566	    fill_kernel<T><<<static_cast<unsigned int>(blocks), kT>>>(static_cast<T*>(a.data_ptr()), n, (float)value);
   567	  });
   568	  cuda_check_last("fill_");
   569	  a.mark_modified();  // the write is queued: bump the revision BEFORE a restore failure can raise
   570	  guard.restore();
   571	}
   572	NDArray NDArray::from_host(const void* src, const Shape& shape, DType dtype, Device device) {
   573	  NDArray a(shape, dtype, device);
   574	  size_t bytes = a.numel() * dtype_size(dtype);
   575	  if (bytes == 0) return a;
   576	  if (device.is_cuda()) cudaMemcpy(a.data_ptr(), src, bytes, cudaMemcpyHostToDevice);
   577	  else std::memcpy(a.data_ptr(), src, bytes);
   578	  cuda_check_last("from_host");
   579	  return a;
   580	}

