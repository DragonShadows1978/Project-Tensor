   228	    except Exception as e:  # noqa: BLE001
   229	        try:
   230	            sys.stderr.write(f"tensor_cuda: DLPack exit hook failed ({type(e).__name__}: {e})\n")
   231	            sys.stderr.flush()
   232	        except Exception:  # noqa: BLE001
   233	            pass
   234	
   235	
   236	atexit.register(_dlpack_shutdown_hook)
