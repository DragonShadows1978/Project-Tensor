  1276	// it reports (C10_CUDA_KERNEL_LAUNCH_CHECK = C10_CUDA_CHECK(cudaGetLastError()); C10_CUDA_CHECK_WARN, torch 2.11
  1277	// headers). Taken: report-and-consume. Ours: capturing at synchronize() entry and still draining before raising.
  1278	void synchronize_and_release_all() {
  1279	  // P1T-FIX5 (V5-01): first wait, GIL released, until every producer release already admitted on ANOTHER thread (a
  1280	  // deleter call, or the drop of an unconsumed capsule's last reference) has returned, so that a release a daemon thread
  1281	  // popped off the list before this call is not still running when synchronize() returns (the round-5 trace probe's
  1282	  // hook is exactly this call). No CUDA call is made by the wait, so this thread's error slot is untouched and V4-04's
  1283	  // capture below still sees the pre-existing error. Skipped when this thread is itself inside an admitted section.
  1284	  if (t_depth[kRelease] == 0 && t_depth[kCallback] == 0) {
  1285	    const WaitOutcome w = wait_for_other_threads(false, tuning::kSyncReleaseWaitFirstDiagS, "this synchronize()");
  1286	    if (w.running_at_start > 0) {
  1287	      g_sync_waits.fetch_add(1, std::memory_order_relaxed);
  1288	      g_sync_wait_us.fetch_add(static_cast<unsigned long long>(w.waited_us), std::memory_order_relaxed);
  1289	      g_sync_wait_diagnostics.fetch_add(w.diagnostics, std::memory_order_relaxed);
  1290	    }
  1291	  }
  1292	  PendingState& st = pending();
  1293	  const cudaError_t prior = cudaGetLastError();
  1294	  if (prior != cudaSuccess) {
  1295	    if (st.prior_unreported == 0) st.prior_error = prior;
  1296	    ++st.prior_unreported;
  1297	  }
  1298	  const SyncReport rep = sync_and_release_all_impl();
  1299	  if (!rep.failed() && st.unreported_count == 0 && st.unraisable_unreported == 0 && st.prior_unreported == 0) return;
  1300	  // N1: any CUDA failure is an error of synchronize(), never a success. N3: building the message may allocate; a
  1301	  // bad_alloc here propagates as MemoryError (an error, not a success, and not a terminate). The earlier release-path
  1302	  // failures are cleared only once their message exists, so they are raised exactly once.
  1303	  if (test_hooks::take(test_hooks::kAllocErrorMessage)) throw std::bad_alloc();
  1304	  std::ostringstream os;
  1305	  os << "tc_signal.synchronize: CUDA error, so the release is not reported as a success:";
  1306	  const char* sep = " ";
  1307	  if (st.prior_unreported > 0) {
  1308	    os << sep << "a CUDA error was already pending in this thread when synchronize() was called ("
  1309	       << cudaGetErrorName(st.prior_error) << ": " << cudaGetErrorString(st.prior_error)
  1310	       << "), from earlier work (for example a refused kernel launch), not from the release; taken from the error slot "
  1311	          "and reported here";
  1312	    sep = "; ";
  1313	  }
  1314	  if (rep.query_failed) {
  1315	    os << sep << "the current-device query cudaGetDevice failed (" << cudaGetErrorName(rep.query_error) << ": "
  1316	       << cudaGetErrorString(rep.query_error) << ")";
  1317	    sep = "; ";
  1318	  }
  1319	  for (int i = 0; i < rep.n; ++i) {
  1320	    os << sep << "the legacy stream of device " << rep.dev[i] << " could not be synchronized ("
  1321	       << cudaGetErrorName(rep.err[i]) << ": " << cudaGetErrorString(rep.err[i]) << ")";
  1322	    sep = "; ";
  1323	  }
  1324	  if (rep.unnamed > 0) os << sep << rep.unnamed << " more device failure(s)";
  1325	  if (rep.leaked_managers > 0)
  1326	    os << "; " << rep.leaked_managers
  1327	       << " consumed operand manager(s) still pending there were deliberately leaked, not released";
  1328	  if (st.unreported_count > 0) {
  1329	    os << sep << st.unreported_count << " earlier release-path failure(s) since the last synchronize, the first on device "
  1330	       << st.unreported_device << " (" << cudaGetErrorName(st.unreported_error) << ": "
  1331	       << cudaGetErrorString(st.unreported_error) << "), deliberately leaked " << st.unreported_leaked
  1332	       << " operand manager(s)";
  1333	    sep = "; ";
  1334	  }
  1335	  if (st.unraisable_unreported > 0) {
  1336	    os << sep << st.unraisable_unreported
  1337	       << " CUDA failure(s) since the last synchronize on paths that cannot raise and leak no operand, the first: "
  1338	       << st.unraisable_what << " on device " << st.unraisable_device << " (" << cudaGetErrorName(st.unraisable_error)
  1339	       << ": " << cudaGetErrorString(st.unraisable_error) << ")";
  1340	  }
  1341	  // std::ostream swallows a bad_alloc from its buffer and only sets badbit (a truncated message would follow): report
  1342	  // the allocation failure itself instead.
  1343	  if (!os) throw std::bad_alloc();
  1344	  std::string msg = os.str();
  1345	  st.unreported_count = 0;
  1346	  st.unreported_leaked = 0;
  1347	  st.unreported_device = -1;
  1348	  st.unreported_error = cudaSuccess;
  1349	  st.unraisable_unreported = 0;
  1350	  st.unraisable_what = "";
  1351	  st.unraisable_device = -1;
  1352	  st.unraisable_error = cudaSuccess;
  1353	  st.prior_unreported = 0;
  1354	  st.prior_error = cudaSuccess;
  1355	  throw std::runtime_error(msg);
  1356	}
