   190	// ------------------------------------------------------------------------------------------------ peek helpers
   191	struct Peeked {
   192	  CapsuleRef capsule;            // P1T-FIX5: admitted last-reference drop (dlpack_operand.h); empty when absent
   193	  std::vector<int64_t> shape;
   194	  int device = -1;
   195	};
   196	
   197	Peeked peek_operand(py::handle obj, const char* role, int ndim) {
   198	  Peeked p;
   199	  require_operand(obj, role);
   200	  p.capsule = to_capsule(obj, role, false);
   201	  const DLTensor* t = peek(p.capsule.handle(), role);
   202	  validate_tensor(t, role, ndim);
   203	  p.shape = shape_of(t);
   204	  p.device = t->device.device_id;
   205	  return p;
   206	}
   207	
   208	void same_device_peeked(const std::vector<const Peeked*>& ps, const std::vector<const char*>& roles) {
   209	  int dev = -1;
   210	  const char* first = "";
   211	  for (size_t i = 0; i < ps.size(); ++i) {
   212	    if (ps[i] == nullptr) continue;
   213	    if (dev < 0) {
   214	      dev = ps[i]->device;
   215	      first = roles[i];
   216	    } else if (ps[i]->device != dev) {
   217	      std::ostringstream os;
   218	      os << "tc_signal: operand '" << roles[i] << "': on CUDA device " << ps[i]->device << " but operand '" << first
   219	         << "' is on CUDA device " << dev << "; every operand must be on the same device";
   220	      throw py::value_error(os.str());
   221	    }
   222	  }
   223	}
   224	
   225	std::vector<int64_t> op_shape(const Operand& op) {
   226	  std::vector<int64_t> s(op.ndim());
   227	  for (int i = 0; i < op.ndim(); ++i) s[i] = op.dim(i);
   228	  return s;
   229	}
   230	
   231	py::tuple to_tuple(const std::vector<int64_t>& v) {
   232	  py::tuple t(v.size());
   233	  for (size_t i = 0; i < v.size(); ++i) t[i] = py::int_(v[i]);
   234	  return t;
   235	}
