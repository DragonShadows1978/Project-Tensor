   339	  expect_shape(Y, {X.dim(0)});
   340	  expect_shape(O, {X.dim(0)});
   341	  const int device = common_device({&X, &Y, &O});
   342	  expect_disjoint(O, X);
   343	  expect_disjoint(O, Y);
   344	  RetainUntilComplete keep(device, {&X, &Y, &O});  // F01
   345	  fp32_divide_probe(device, X.data(), Y.data(), O.data(), X.dim(0));
   346	}
