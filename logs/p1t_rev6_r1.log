   975	  const int64_t numel = checked_numel(dl->shape, nd, "from_dlpack");
   976	  // C-contiguous only; a size-1 dimension may carry any stride (it is never
   977	  // stepped). Strides == NULL means compact row-major (DLPack < 1.2).
   978	  if (nd > 0 && dl->strides && numel > 0) {
   979	    int64_t expected = 1;
   980	    for (int i = nd - 1; i >= 0; --i) {
   981	      if (shape[i] != 1 && dl->strides[i] != expected)
   982	        throw py::buffer_error(
   983	            "from_dlpack: non-contiguous strides " + shape_str(dl->strides, nd) +
   984	            " for shape " + shape_str(dl->shape, nd) +
   985	            "; TensorCUDA imports C-contiguous (row-major) tensors only "
   986	            "(size-1 dimensions may have any stride). Make the tensor "
   987	            "contiguous on the producer side first.");
   988	      expected *= shape[i];
   989	    }
   990	  }
   991	  const size_t isz = dtype_size(dt);
   992	  if (dl->byte_offset % isz != 0)
   993	    throw py::buffer_error("from_dlpack: byte_offset " +
   994	                           std::to_string(dl->byte_offset) +
   995	                           " is not a multiple of the element size " +
   996	                           std::to_string(isz));
   997	  if (numel > 0 && dl->data == nullptr)
   998	    throw py::buffer_error("from_dlpack: null data pointer for a non-empty tensor");
   999	  // F03 (P1T-FIX1): checked byte size, byte_offset + bytes (the Storage's
  1000	  // nbytes) and data + byte_offset + bytes (one past the last byte); each
  1001	  // overflow raises ValueError and leaves the capsule unconsumed.
