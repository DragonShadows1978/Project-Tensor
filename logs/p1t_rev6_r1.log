   462	template <typename T>
   463	__global__ void fill_kernel(T* p, int64_t n, float v) {
   464	  int64_t i = (int64_t)blockIdx.x * blockDim.x + threadIdx.x;
   465	  if (i < n) st<T>(p, i, v);
   466	}
   467	template <typename SrcT, typename DstT>
   468	__global__ void cast_kernel(const SrcT* s, DstT* d, int64_t n) {
   469	  int64_t i = (int64_t)blockIdx.x * blockDim.x + threadIdx.x;
   470	  if (i < n) st<DstT>(d, i, ld<SrcT>(s, i));
   471	}
