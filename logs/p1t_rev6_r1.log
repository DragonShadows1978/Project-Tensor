   177	// ------------------------------------------------------------------------------------------------ entry points
   178	py::tuple lstm_plan(py::object x, py::object W, py::object R, py::object B, py::object h0, py::object c0,
   179	                    int64_t hidden_size, int64_t direction) {
   180	  drain_completed();
   181	  require_operand(x, "x");
   182	  require_operand(W, "W");
   183	  require_operand(R, "R");
   184	  Peeked X = peek_operand(x, "x", 3);
   185	  Peeked Wp = peek_operand(W, "W", 3);
   186	  Peeked Rp = peek_operand(R, "R", 3);
   187	  Peeked Bp = peek_operand(B, "B", 2);
   188	  Peeked H0 = peek_operand(h0, "initial_h", 3);
   189	  Peeked C0 = peek_operand(c0, "initial_c", 3);
   190	  same_device_peeked({&X, &Wp, &Rp, &Bp, &H0, &C0}, {"x", "W", "R", "B", "initial_h", "initial_c"});
   191	  LstmPlan p = plan_lstm(X.shape, Wp.shape, Rp.shape, Bp.present ? &Bp.shape : nullptr,
   192	                         H0.present ? &H0.shape : nullptr, C0.present ? &C0.shape : nullptr, hidden_size, direction);
   193	  return py::make_tuple(X.capsule.object(), Wp.capsule.object(), Rp.capsule.object(), Bp.capsule.object(),
   194	                        H0.capsule.object(), C0.capsule.object(), to_tuple(p.y_shape), to_tuple(p.state_shape),
   195	                        py::int_(p.scratch_numel), py::int_(p.g.T), py::int_(p.g.N));
   196	}
   197	
   198	void lstm_run(py::object xc, py::object Wc, py::object Rc, py::object Bc, py::object h0c, py::object c0c, py::object Y,
   199	              py::object Y_h, py::object Y_c, py::object scratch, int64_t hidden_size, int64_t direction) {
   200	  drain_completed();
   201	  require_operand(xc, "x");
   202	  require_operand(Wc, "W");
   203	  require_operand(Rc, "R");
   204	  require_operand(Y, "Y");
   205	  require_operand(Y_h, "Y_h");
   206	  require_operand(Y_c, "Y_c");
   207	  require_operand(scratch, "scratch");
   208	  Operand X(xc, "x", 3, false);
   209	  Operand Wo(Wc, "W", 3, false);
   210	  Operand Ro(Rc, "R", 3, false);
   211	  Operand Bo;
   212	  if (!Bc.is_none()) Bo = Operand(Bc, "B", 2, false);
   213	  Operand H0;
   214	  if (!h0c.is_none()) H0 = Operand(h0c, "initial_h", 3, false);
   215	  Operand C0;
   216	  if (!c0c.is_none()) C0 = Operand(c0c, "initial_c", 3, false);
   217	  std::vector<int64_t> bshape, h0shape, c0shape;
   218	  if (Bo.present()) bshape = op_shape(Bo);
   219	  if (H0.present()) h0shape = op_shape(H0);
   220	  if (C0.present()) c0shape = op_shape(C0);
   221	  LstmPlan p = plan_lstm(op_shape(X), op_shape(Wo), op_shape(Ro), Bo.present() ? &bshape : nullptr,
   222	                         H0.present() ? &h0shape : nullptr, C0.present() ? &c0shape : nullptr, hidden_size, direction);
   223	  Operand Yo(to_capsule(Y, "Y", true).handle(), "Y", 4, true);
   224	  expect_shape(Yo, p.y_shape);
   225	  Operand Yh(to_capsule(Y_h, "Y_h", true).handle(), "Y_h", 3, true);
   226	  expect_shape(Yh, p.state_shape);
   227	  Operand Yc(to_capsule(Y_c, "Y_c", true).handle(), "Y_c", 3, true);
   228	  expect_shape(Yc, p.state_shape);
   229	  Operand S(to_capsule(scratch, "scratch", true).handle(), "scratch", 1, true);
   230	  expect_shape(S, {p.scratch_numel});
   231	  const int device = common_device({&X, &Wo, &Ro, &Bo, &H0, &C0, &Yo, &Yh, &Yc, &S});
   232	  // Every written operand must not alias any input nor any other written operand.
   233	  const std::vector<const Operand*> written = {&Yo, &Yh, &Yc, &S};
   234	  const std::vector<const Operand*> inputs = {&X, &Wo, &Ro, &Bo, &H0, &C0};
   235	  for (size_t a = 0; a < written.size(); ++a) {
   236	    for (const Operand* in : inputs) expect_disjoint(*written[a], *in);
   237	    for (size_t b = a + 1; b < written.size(); ++b) expect_disjoint(*written[a], *written[b]);
   238	  }
   239	  // F01: the whole per-call capsule set is one pending entry, released after the last step's launch has run.
   240	  RetainUntilComplete keep(device, {&X, &Wo, &Ro, &Bo, &H0, &C0, &Yo, &Yh, &Yc, &S});
   241	  lstm_forward(device, p.g, X.data(), Wo.data(), Ro.data(), Bo.present() ? Bo.data() : nullptr,
   242	               H0.present() ? H0.data() : nullptr, C0.present() ? C0.data() : nullptr, Yo.data(), Yh.data(), Yc.data(),
   243	               S.data());
   244	}
   245	
   246	}  // namespace
   247	
   248	void register_lstm(py::module_& m) {
   249	  m.def("lstm_plan", &lstm_plan, py::arg("x"), py::arg("W"), py::arg("R"), py::arg("B"), py::arg("initial_h"),
   250	        py::arg("initial_c"), py::arg("hidden_size"), py::arg("direction"),
   251	        "Acquire and peek the LSTM inputs; return (x, W, R, B|None, initial_h|None, initial_c|None capsules, Y shape, "
   252	        "Y_h/Y_c shape, scratch numel, T, N).");
   253	  m.def("lstm_run", &lstm_run, py::arg("x_capsule"), py::arg("W_capsule"), py::arg("R_capsule"), py::arg("B_capsule"),
   254	        py::arg("initial_h_capsule"), py::arg("initial_c_capsule"), py::arg("Y"), py::arg("Y_h"), py::arg("Y_c"),
   255	        py::arg("scratch"), py::arg("hidden_size"), py::arg("direction"),
   256	        "Consume every operand, validate, run the whole LSTM recurrence on the legacy stream, release.");
   257	  m.def(
   258	      "lstm_cublas_config",
   259	      [](int device) {
   260	        LstmCublasConfig c = lstm_cublas_config(device);
   261	        py::dict d;
   262	        d["math_mode"] = c.math_mode;
   263	        d["atomics_mode"] = c.atomics_mode;
   264	        d["pointer_mode"] = c.pointer_mode;
   265	        d["legacy_stream"] = c.legacy_stream;
   266	        d["default_math"] = c.default_math;
   267	        d["atomics_not_allowed"] = c.atomics_not_allowed;
   268	        return d;
   269	      },
   270	      py::arg("device") = 0, "Settings of the LSTM's cuBLAS handle on `device` (creates it if needed).");
   271	}
