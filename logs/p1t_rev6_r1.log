   201	def _dlpack_shutdown_hook():
   202	    """atexit hook (P1T-FIX2 N5, P1T-FIX3 V3-01): close admission of GIL-taking
   203	    DLPack import releases, then wait until every release admitted before that
   204	    has finished. Interpreter finalization never starts while one is running.
   205	
   206	    The wait has no bound. After ``_DLPACK_SHUTDOWN_WAIT_S`` seconds a line goes
   207	    to stderr (how many are still running, seconds waited), and another each
   208	    time the time waited doubles; the wait goes on. Consequence: a producer
   209	    deleter that never returns makes interpreter exit wait forever. That is the
   210	    producer's DLPack contract violation (a deleter must return), and waiting is
   211	    the honest outcome: returning early would let CPython finalize under a
   212	    running callback and abort the process (round-3 review V3-01, rc -6). Ctrl-C
   213	    does not interrupt the wait; SIGTERM / SIGKILL still end the process.
   214	    Releases that start after admission closed are deliberately leaked (no GIL
   215	    is taken), as before. Never raises (an atexit exception has no handler).
   216	    """
   217	    try:
   218	        try:
   219	            first_diag_s = float(_DLPACK_SHUTDOWN_WAIT_S)
   220	        except (TypeError, ValueError):
   221	            first_diag_s = float("nan")  # an unusable knob must not skip the wait: diagnose at once, still wait
   222	        r = _C._dlpack_begin_shutdown(first_diag_s)
   223	        if r["timed_out"]:
   224	            sys.stderr.write(
   225	                f"tensor_cuda: the DLPack release(s) admitted before exit finished after "
   226	                f"{r['waited_us'] / 1e6:.1f} s; interpreter exit continues\n")
