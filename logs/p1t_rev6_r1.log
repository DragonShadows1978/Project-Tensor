   217	void conv1d_forward(int device, const Conv1dGeom& g, const float* x, const float* w, const float* b, float* y,
   218	                    float* col) {
   219	  DeviceGuard guard(device);
   220	  cublasHandle_t h = handle_for(device);
   221	  const int64_t Cg = g.C_in / g.groups;
   222	  const int64_t Og = g.C_out / g.groups;
   223	  const int64_t CgK = Cg * g.K;
   224	  const float alpha = 1.0f;
   225	  const float beta = 0.0f;
   226	  for (int64_t n = 0; n < g.N; ++n) {
   227	    const float* xn = x + n * g.C_in * g.T;
   228	    const float* A = nullptr;   // the [Cg*K, T_out] row-major operand of group 0 for this batch element
   229	    long long strideA = 0;
   230	    if (g.direct) {
   231	      // K == 1, stride 1, no pads: x[n] itself is the col matrix (T_out == T), no scratch.
   232	      A = xn;
   233	      strideA = static_cast<long long>(Cg * g.T);
   234	    } else {
   235	      // The scratch is reused for every n: the next im2col is queued after this n's GEMM on the same stream.
   236	      const int64_t total = g.C_in * g.K * g.T_out;
   237	      im2col1d_kernel<<<grid_for(total, tuning::kIm2colBlock), tuning::kIm2colBlock, 0, kLegacyStream>>>(
   238	          xn, col, g.C_in, g.T, g.K, g.T_out, g.stride, g.pad_begin, g.dilation);
   239	      check_launch("im2col1d_kernel");
   240	      A = col;
   241	      strideA = static_cast<long long>(CgK * g.T_out);
   242	    }
   243	    float* yn = y + n * g.C_out * g.T_out;
   244	    // Row-major Y_g[Og, T_out] = W_g[Og, CgK] . Col_g[CgK, T_out], computed as the column-major product
   245	    // Y_g^T[T_out, Og] = Col_g^T[T_out, CgK] . W_g^T[CgK, Og]: m = T_out, n = Og, k = CgK, both ops N,
   246	    // lda = T_out (col), ldb = CgK (w), ldc = T_out (y); one batch entry per group.
   247	    check_cublas(cublasSgemmStridedBatched(h, CUBLAS_OP_N, CUBLAS_OP_N, static_cast<int>(g.T_out),
   248	                                           static_cast<int>(Og), static_cast<int>(CgK), &alpha, A,
   249	                                           static_cast<int>(g.T_out), strideA, w, static_cast<int>(CgK),
   250	                                           static_cast<long long>(Og * CgK), &beta, yn, static_cast<int>(g.T_out),
   251	                                           static_cast<long long>(Og * g.T_out), static_cast<int>(g.groups)),
   252	                 "cublasSgemmStridedBatched");
   253	    check_launch("cublasSgemmStridedBatched");
   254	  }
   255	  if (b != nullptr) {
   256	    const int64_t total = g.N * g.C_out * g.T_out;
   257	    bias_add_kernel<<<grid_for(total, tuning::kBiasBlock), tuning::kBiasBlock, 0, kLegacyStream>>>(y, b, g.C_out,
   258	                                                                                                   g.T_out, total);
   259	    check_launch("bias_add_kernel");
   260	  }
   261	  guard.restore();  // P1T-FIX4
   262	}
