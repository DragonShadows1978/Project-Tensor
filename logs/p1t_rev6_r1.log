    94	    os << "W.shape[1] (" << Ws[1] << ") != 4*hidden_size (" << H4 << "); W is [D, 4H, I]";
    95	    lstm_bad(os.str());
    96	  }
    97	  if (Ws[2] != g.I) {
    98	    os << "W.shape[2] (" << Ws[2] << ") != input size x.shape[2] (" << g.I << "); W is [D, 4H, I]";
    99	    lstm_bad(os.str());
   100	  }
   101	  expect_dims("R", Rs, {g.D, H4, g.H}, "R is [D, 4H, H]");
   102	  if (Bs != nullptr) expect_dims("B", *Bs, {g.D, kLstmBiasHalves * H4}, "B is [D, 8H] = [Wb; Rb]");
   103	  if (h0s != nullptr) expect_dims("initial_h", *h0s, {g.D, g.N, g.H}, "initial_h is [D, N, H]");
   104	  if (c0s != nullptr) expect_dims("initial_c", *c0s, {g.D, g.N, g.H}, "initial_c is [D, N, H]");
   105	  check_int_range("4*hidden_size", H4);
   106	  check_int_range("T*N", ck_mul(g.T, g.N, "lstm: T*N"));
   107	  check_int_range("input size", g.I);
   108	  check_int_range("batch size", g.N);
   109	  check_int_range("D*N*H", ck_mul(ck_mul(g.D, g.N, "lstm: D*N"), g.H, "lstm: D*N*H"));
   110	  p.y_shape = {g.T, g.D, g.N, g.H};
   111	  p.state_shape = {g.D, g.N, g.H};
   112	  ck_shape_numel(p.y_shape, "lstm: Y size T*D*N*H");
   113	  ck_shape_numel(p.state_shape, "lstm: Y_h/Y_c size D*N*H");
   114	  // F03: the scratch size G_x [D, T, N, 4H] + G_h [D, N, 4H] and its bytes, checked; lstm_scratch_numel (unchecked,
   115	  // used again by lstm.cu) is then known not to overflow.
   116	  const int64_t gx = ck_mul(ck_mul(ck_mul(g.D, g.T, "lstm: scratch G_x"), g.N, "lstm: scratch G_x"), H4,
   117	                            "lstm: scratch G_x");
   118	  const int64_t gh = ck_mul(ck_mul(g.D, g.N, "lstm: scratch G_h"), H4, "lstm: scratch G_h");
   119	  p.scratch_numel = ck_add(gx, gh, "lstm: scratch size");
   120	  ck_fp32_bytes(p.scratch_numel, "lstm: scratch bytes");
   121	  return p;
   122	}
   123	
   124	// ------------------------------------------------------------------------------------------------ peek helpers
   125	struct Peeked {
   126	  CapsuleRef capsule;            // None for an absent optional operand; P1T-FIX5: admitted last-reference drop
   127	  std::vector<int64_t> shape;
   128	  int device = -1;
   129	  bool present = false;
   130	};
   131	
   132	// Optional operands only (B, initial_h, initial_c); required ones go through require_operand first.
   133	Peeked peek_operand(py::handle obj, const char* role, int ndim) {
   134	  Peeked p;
   135	  if (obj.is_none()) {
   136	    p.capsule = CapsuleRef(py::none());
   137	    return p;
   138	  }
   139	  p.capsule = to_capsule(obj, role, false);
   140	  const DLTensor* t = peek(p.capsule.handle(), role);
   141	  validate_tensor(t, role, ndim);
   142	  p.shape = shape_of(t);
   143	  p.device = t->device.device_id;
   144	  p.present = true;
   145	  return p;
   146	}
   147	
   148	void same_device_peeked(const std::vector<const Peeked*>& ps, const std::vector<const char*>& roles) {
   149	  int dev = -1;
   150	  const char* first = "";
   151	  for (size_t i = 0; i < ps.size(); ++i) {
   152	    if (!ps[i]->present) continue;
   153	    if (dev < 0) {
   154	      dev = ps[i]->device;
   155	      first = roles[i];
   156	    } else if (ps[i]->device != dev) {
   157	      std::ostringstream os;
   158	      os << "tc_signal: operand '" << roles[i] << "': on CUDA device " << ps[i]->device << " but operand '" << first
   159	         << "' is on CUDA device " << dev << "; every operand must be on the same device";
   160	      throw py::value_error(os.str());
   161	    }
   162	  }
   163	}
   164	
   165	std::vector<int64_t> op_shape(const Operand& op) {
   166	  std::vector<int64_t> s(op.ndim());
   167	  for (int i = 0; i < op.ndim(); ++i) s[i] = op.dim(i);
   168	  return s;
   169	}
   170	
   171	py::tuple to_tuple(const std::vector<int64_t>& v) {
   172	  py::tuple t(v.size());
   173	  for (size_t i = 0; i < v.size(); ++i) t[i] = py::int_(v[i]);
   174	  return t;
   175	}
