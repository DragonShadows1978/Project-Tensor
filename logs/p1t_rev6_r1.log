   874	Tensor tensor_from_dlpack_capsule(py::object obj) {
   875	  PyObject* cap = obj.ptr();
   876	  bool versioned = false;
   877	  if (PyCapsule_IsValid(cap, kCapVersioned)) {
   878	    versioned = true;
   879	  } else if (!PyCapsule_IsValid(cap, kCapLegacy)) {
   880	    if (PyCapsule_CheckExact(cap)) {
   881	      const char* name = PyCapsule_GetName(cap);
   882	      PyErr_Clear();
   883	      throw py::value_error(
   884	          std::string("from_dlpack: capsule named '") + (name ? name : "NULL") +
   885	          "' is not an unconsumed DLPack capsule (a capsule can be consumed "
   886	          "only once)");
   887	    }
   888	    throw py::type_error(
   889	        "from_dlpack: expected an object with __dlpack__ or a DLPack capsule");
   890	  }
   891	  DLTensor* dl = nullptr;
   892	  void* manager = nullptr;
   893	  uint64_t flags = 0;
   894	  if (versioned) {
   895	    auto* m = static_cast<DLManagedTensorVersioned*>(
   896	        PyCapsule_GetPointer(cap, kCapVersioned));
   897	    if (!m) throw py::error_already_set();
   898	    if (m->version.major != DLPACK_MAJOR_VERSION)
   899	      throw py::buffer_error(
   900	          "from_dlpack: DLPack major version " + std::to_string(m->version.major) +
   901	          " is not supported (this build speaks DLPack " +
   902	          std::to_string(DLPACK_MAJOR_VERSION) + ".x)");
   903	    dl = &m->dl_tensor;
   904	    flags = m->flags;
   905	    manager = m;
   906	  } else {
   907	    auto* m = static_cast<DLManagedTensor*>(PyCapsule_GetPointer(cap, kCapLegacy));
   908	    if (!m) throw py::error_already_set();
   909	    dl = &m->dl_tensor;
   910	    manager = m;
   911	  }
   912	  // Every refusal below leaves the capsule unconsumed, so its destructor
   913	  // hands the memory back to the producer.
   914	  if (flags & DLPACK_FLAG_BITMASK_READ_ONLY)
   915	    throw py::buffer_error(
   916	        "from_dlpack: the producer marked this tensor read-only; TensorCUDA "
   917	        "tensors are writable, so read-only imports are refused");
   918	  if (dl->device.device_type != kDLCUDA)
   919	    throw py::buffer_error(
   920	        "from_dlpack: only CUDA device memory (kDLCUDA = 2) can be imported; "
   921	        "got device type " + std::to_string(static_cast<int>(dl->device.device_type)) +
   922	        (dl->device.device_type == kDLCPU ? " (CPU)" : ""));
   923	  // P1T-FIX4, round-4 review finding V4-03 (MINOR). 62c8d9f ignored this query's
   924	  // result: on failure (no usable device, or an initialization error) `cur`
   925	  // stayed 0, a device-0 capsule was accepted, a Storage was built on an
   926	  // unvalidated device and the capsule was renamed "used_*". Now the result is
   927	  // checked here, before the Storage exists and before the rename: a failure
   928	  // raises RuntimeError naming cudaGetDevice and the CUDA error, the capsule
   929	  // stays unconsumed (its own destructor returns the memory to the producer),
   930	  // and the failed call's slot entry is consumed (this raise reports it). This
   931	  // is the only CUDA call of the import (the sweep: no other query). A sticky
   932	  // context error does not make cudaGetDevice fail (measured, receipt
   933	  // artifacts/p1t_fix4/cuda_semantics.txt); such an import proceeds, and the
   934	  // Storage's release later finds the drain failing and leaks instead of
   935	  // releasing (P1T-FIX1 F05).
   936	  // Prior art: the CUDA 12.6 contract that cudaGetDevice returns an error code
   937	  // (cudaErrorNoDevice, cudaErrorInsufficientDriver, ...) and the DLPack rule that
   938	  // a refused capsule keeps its ownership. Nothing new.
   939	  int cur = -1;
   940	  const cudaError_t qe = cudaGetDevice(&cur);
   941	  if (qe != cudaSuccess) {
   942	    cudaGetLastError();
   943	    throw std::runtime_error(std::string("from_dlpack: the current-device query cudaGetDevice failed (") +
   944	                             cudaGetErrorName(qe) + ": " + cudaGetErrorString(qe) +
   945	                             "); refused before taking ownership (the capsule is not consumed)");
   946	  }
   947	  if (dl->device.device_id != cur)
   948	    throw py::buffer_error(
   949	        "from_dlpack: tensor is on CUDA device " + std::to_string(dl->device.device_id) +
   950	        " but TensorCUDA runs on device " + std::to_string(cur) +
   951	        " (multi-GPU import is not supported)");
   952	  DType dt;
   953	  if (!from_dl_dtype(dl->dtype, &dt))
   954	    throw py::buffer_error(
   955	        "from_dlpack: DLPack dtype (code=" + std::to_string(dl->dtype.code) +
   956	        ", bits=" + std::to_string(dl->dtype.bits) + ", lanes=" +
   957	        std::to_string(dl->dtype.lanes) +
   958	        ") has no exact TensorCUDA dtype; TensorCUDA never converts on import "
   959	        "(supported: float32, float16, bfloat16, int64, uint8, bool)");
   960	  if (dl->ndim < 0 || dl->ndim > TC_MAX_DIMS)
   961	    throw py::buffer_error("from_dlpack: ndim " + std::to_string(dl->ndim) +
   962	                           " is outside TensorCUDA's 0.." +
   963	                           std::to_string(TC_MAX_DIMS));
   964	  const int nd = dl->ndim;
   965	  if (nd > 0 && dl->shape == nullptr)
   966	    throw py::buffer_error("from_dlpack: NULL shape array for a tensor with dimensions");
   967	  Shape shape(nd);
