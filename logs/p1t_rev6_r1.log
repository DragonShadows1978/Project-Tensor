   314	  Operand W(wc, "w", 3, false);
   315	  Operand B;
   316	  if (!bc.is_none()) B = Operand(bc, "b", 1, false);
   317	  std::vector<int64_t> bshape;
   318	  if (B.present()) bshape = op_shape(B);
   319	  const std::vector<int64_t> xshape = op_shape(X);
   320	  const std::vector<int64_t> wshape = op_shape(W);
   321	  ConvTranspose1dPlan p = plan_conv_transpose1d(xshape, wshape, B.present() ? &bshape : nullptr, stride, pb, pe,
   322	                                                output_padding, dilation, groups);
   323	  Operand Y(to_capsule(out, "out", true).handle(), "out", 3, true);
