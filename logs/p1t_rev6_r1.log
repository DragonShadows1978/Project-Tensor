   323	    // The last reference to an unconsumed DLPack capsule: dropping it runs the producer's destructor, which calls the
   324	    // producer's deleter. A release: admitted, or kept (never run) once admission has closed.
   325	    const Admission a = admit(kRelease);
   326	    if (a != Admission::kAdmitted) {
   327	      (a == Admission::kClosed ? g_capsules_kept_after_close : g_capsules_kept_finalizing)
   328	          .fetch_add(1, std::memory_order_relaxed);
   329	      return;
   330	    }
   331	    Py_DECREF(p);
   332	    leave(kRelease);
   333	    return;
   334	  }
   335	  Py_DECREF(p);
   336	}
