   361	    }
   362	  }
   363	  py::object fn = obj.attr("__dlpack__");
   364	  py::object cap;
   365	  const py::tuple max_version = py::make_tuple(tuning::kDlpackMaxMajor, tuning::kDlpackMaxMinor);
