    52	void check_cuda(cudaError_t e, const char* what) {
    53	  if (e != cudaSuccess) {
    54	    std::ostringstream os;
    55	    os << "tc_signal: " << what << " failed: " << cudaGetErrorName(e) << ": " << cudaGetErrorString(e);
    56	    cudaGetLastError();  // P1T-FIX4 (cuda_guard.h rule 1): this raise reports the failed call, so it consumes its entry
    57	    throw std::runtime_error(os.str());
    58	  }
    59	}
