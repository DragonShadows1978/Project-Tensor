    61	// Checked after every kernel launch (launch-configuration and sticky errors surface here as RuntimeError).
    62	void check_launch(const char* kernel) { check_cuda(cudaGetLastError(), kernel); }
    63	
    64	void check_cublas(cublasStatus_t s, const char* what) {
    65	  if (s != CUBLAS_STATUS_SUCCESS) {
    66	    std::ostringstream os;
    67	    os << "tc_signal: " << what << " failed: cuBLAS status " << static_cast<int>(s);
    68	    throw std::runtime_error(os.str());
    69	  }
    70	}
