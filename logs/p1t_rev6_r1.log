   160	// G_x[d, r, q] = Wb[d, q] for every projected row r in [0, T*N) and q in [0, 4H): the bias the input-projection GEMM
   161	// then accumulates onto (beta = 1). One thread per element, a plain copy.
   162	__global__ void lstm_bias_fill_kernel(float* __restrict__ gx, const float* __restrict__ B, int64_t D, int64_t rows,
   163	                                      int64_t H4, int64_t bias_row) {
   164	  const int64_t total = D * rows * H4;
   165	  for (int64_t i = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; i < total;
   166	       i += static_cast<int64_t>(gridDim.x) * blockDim.x) {
   167	    const int64_t q = i % H4;
   168	    const int64_t d = i / (rows * H4);
   169	    gx[i] = B[d * bias_row + q];
   170	  }
   171	}
   172	
   173	// One LSTM step for every direction slot at once; one thread per state element idx = (d*N + n)*H + j.
   174	//   gx: G_x [D, T, N, 4H] (x . W^T + Wb); gh: G_h [D, N, 4H] (h_{t-1} . R^T for this step); B: [D, 8H] or NULL;
   175	//   h / c: the state [D, N, H] (= Y_h / Y_c), read and written in place by the owning thread only; Y [T, D, N, H].
   176	// Fixed per-element operation order: z = (gx + gh) + Rb; c = fmaf(f, c_prev, i * c~); h = o * tanhf(c).
   177	__global__ void lstm_cell_kernel(const float* __restrict__ gx, const float* __restrict__ gh,
   178	                                 const float* __restrict__ B, float* __restrict__ h, float* __restrict__ c,
   179	                                 float* __restrict__ Y, int64_t T, int64_t s, int64_t D, int64_t N, int64_t H,
   180	                                 int64_t first_reverse) {
   181	  const int64_t H4 = kLstmGates * H;
   182	  const int64_t total = D * N * H;
   183	  for (int64_t idx = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; idx < total;
   184	       idx += static_cast<int64_t>(gridDim.x) * blockDim.x) {
   185	    const int64_t j = idx % H;
   186	    const int64_t r = idx / H;
   187	    const int64_t n = r % N;
   188	    const int64_t d = r / N;
   189	    const int64_t tt = (d >= first_reverse) ? (T - 1 - s) : s;   // the reverse slot walks time backwards
   190	    const float* gxp = gx + ((d * T + tt) * N + n) * H4;
   191	    const float* ghp = gh + (d * N + n) * H4;
   192	    float zi = gxp[kGateI * H + j] + ghp[kGateI * H + j];
   193	    float zo = gxp[kGateO * H + j] + ghp[kGateO * H + j];
   194	    float zf = gxp[kGateF * H + j] + ghp[kGateF * H + j];
   195	    float zc = gxp[kGateC * H + j] + ghp[kGateC * H + j];
   196	    if (B != nullptr) {
   197	      const float* rb = B + d * (kLstmBiasHalves * H4) + H4;     // Rb[d] = B[d, 4H:8H]
   198	      zi = zi + rb[kGateI * H + j];
   199	      zo = zo + rb[kGateO * H + j];
   200	      zf = zf + rb[kGateF * H + j];
   201	      zc = zc + rb[kGateC * H + j];
   202	    }
   203	    const float ig = sigmoid_stable(zi);
   204	    const float og = sigmoid_stable(zo);
   205	    const float fg = sigmoid_stable(zf);
   206	    const float cg = tanhf(zc);
   207	    const float cn = fmaf(fg, c[idx], ig * cg);
   208	    const float hn = og * tanhf(cn);
   209	    c[idx] = cn;
   210	    h[idx] = hn;
   211	    Y[((tt * D + d) * N + n) * H + j] = hn;
   212	  }
   213	}
   214	
   215	}  // namespace
   216	
   217	// ------------------------------------------------------------------------------------------------ LSTM forward
   218	void lstm_forward(int device, const LstmGeom& g, const float* x, const float* W, const float* R, const float* B,
   219	                  const float* h0, const float* c0, float* Y, float* Y_h, float* Y_c, float* scratch) {
   220	  DeviceGuard guard(device);
   221	  cublasHandle_t hdl = lstm_handle_for(device);
   222	  const int64_t H4 = kLstmGates * g.H;
   223	  const int64_t rows = g.T * g.N;                 // projected rows, r = t*N + n
   224	  const int64_t state = g.D * g.N * g.H;          // elements of Y_h / Y_c
   225	  const size_t state_bytes = static_cast<size_t>(state) * sizeof(float);
   226	  float* gx = scratch;                            // [D, T, N, 4H]
   227	  float* gh = scratch + lstm_gx_numel(g);         // [D, N, 4H]
   228	  const float one = 1.0f;
   229	  const float zero = 0.0f;
   230	
   231	  // 1. Initial state into the outputs that carry the recurrence.
   232	  if (h0 != nullptr)
   233	    check_cuda(cudaMemcpyAsync(Y_h, h0, state_bytes, cudaMemcpyDeviceToDevice, kLegacyStream), "initial_h copy");
   234	  else
   235	    check_cuda(cudaMemsetAsync(Y_h, 0, state_bytes, kLegacyStream), "initial_h zero");
   236	  if (c0 != nullptr)
   237	    check_cuda(cudaMemcpyAsync(Y_c, c0, state_bytes, cudaMemcpyDeviceToDevice, kLegacyStream), "initial_c copy");
   238	  else
   239	    check_cuda(cudaMemsetAsync(Y_c, 0, state_bytes, kLegacyStream), "initial_c zero");
   240	
   241	  // 2. Input projection of all steps, one SGEMM per direction (+ Wb through beta = 1 on the pre-filled buffer).
   242	  //    Row-major G_x[d][rows, 4H] = X[rows, I] . W[d][4H, I]^T, as the column-major product
   243	  //    G_x^T[4H, rows] = op_T(W_d viewed [I, 4H], ld I) . X^T[I, rows] (ld I): m = 4H, n = rows, k = I, ldc = 4H.
   244	  float beta_x = zero;
   245	  if (B != nullptr) {
   246	    const int64_t total = g.D * rows * H4;
   247	    lstm_bias_fill_kernel<<<grid_for(total, lstm_tuning::kBiasFillBlock), lstm_tuning::kBiasFillBlock, 0,
   248	                            kLegacyStream>>>(gx, B, g.D, rows, H4, kLstmBiasHalves * H4);
   249	    check_launch("lstm_bias_fill_kernel");
   250	    beta_x = one;
   251	  }
   252	  for (int64_t d = 0; d < g.D; ++d) {
   253	    check_cublas(cublasSgemm(hdl, CUBLAS_OP_T, CUBLAS_OP_N, static_cast<int>(H4), static_cast<int>(rows),
   254	                             static_cast<int>(g.I), &one, W + d * H4 * g.I, static_cast<int>(g.I), x,
   255	                             static_cast<int>(g.I), &beta_x, gx + d * rows * H4, static_cast<int>(H4)),
   256	                 "cublasSgemm (input projection)");
   257	    check_launch("cublasSgemm (input projection)");
   258	  }
   259	
   260	  // 3. The recurrence: a host loop over steps inside this one call. Per step, one strided-batched SGEMM over the D
   261	  //    slots, G_h[d][N, 4H] = h[d][N, H] . R[d][4H, H]^T (column-major: m = 4H, n = N, k = H, op_T on R viewed
   262	  //    [H, 4H] ld H, h viewed [H, N] ld H, ldc = 4H), then the fused cell kernel. Stream order makes step s+1's GEMM
   263	  //    read the h that step s's cell kernel wrote.
   264	  const unsigned int cell_grid = grid_for(state, lstm_tuning::kCellBlock);
   265	  for (int64_t s = 0; s < g.T; ++s) {
   266	    check_cublas(cublasSgemmStridedBatched(hdl, CUBLAS_OP_T, CUBLAS_OP_N, static_cast<int>(H4), static_cast<int>(g.N),
   267	                                           static_cast<int>(g.H), &one, R, static_cast<int>(g.H),
   268	                                           static_cast<long long>(H4 * g.H), Y_h, static_cast<int>(g.H),
   269	                                           static_cast<long long>(g.N * g.H), &zero, gh, static_cast<int>(H4),
   270	                                           static_cast<long long>(g.N * H4), static_cast<int>(g.D)),
   271	                 "cublasSgemmStridedBatched (recurrent)");
   272	    check_launch("cublasSgemmStridedBatched (recurrent)");
   273	    lstm_cell_kernel<<<cell_grid, lstm_tuning::kCellBlock, 0, kLegacyStream>>>(gx, gh, B, Y_h, Y_c, Y, g.T, s, g.D,
   274	                                                                                 g.N, g.H, g.first_reverse);
   275	    check_launch("lstm_cell_kernel");
   276	  }
   277	  guard.restore();  // P1T-FIX4: success-path restore is checked (raises on failure)
   278	}
