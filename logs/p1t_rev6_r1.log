   390	    return std::string(who) + ": this tensor is labeled cuda:" + std::to_string(a.device.index) +
   391	           " but its memory is not a CUDA allocation the driver knows; refused";
   392	  if (attr.device != a.device.index)
   393	    return std::string(who) + ": this tensor is labeled cuda:" + std::to_string(a.device.index) +
   394	           " but its memory is on CUDA device " + std::to_string(attr.device) +
   395	           " (TensorCUDA labels its own allocations cuda:0 and allocates on the current device, so it was created "
   396	           "while that device was current); refused rather than act on the wrong device";
