   487	NDArray NDArray::full(const Shape& shape, double value, DType dtype, Device device) {
   488	  NDArray a(shape, dtype, device);
   489	  int64_t n = a.numel();
   490	  if (n == 0) return a;
   491	  DISPATCH_FLOAT(dtype, T, {
   492	    fill_kernel<T><<<nblk(n), kT>>>(static_cast<T*>(a.data_ptr()), n, (float)value);
   493	  });
   494	  cuda_check_last("full");
   495	  return a;
   496	}
