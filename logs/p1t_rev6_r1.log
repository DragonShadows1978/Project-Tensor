   630	//    _PyAtExit_Call (line 1815) runs every atexit callback BEFORE
   631	//    _PyInterpreterState_SetFinalizing / _PyRuntimeState_SetFinalizing (1832-1833)
   632	//    and before runtime->initialized = 0 (1834). So once the hook has returned
   633	//    with in_flight == 0, no thread is between admission and PyGILState_Release,
   634	//    and every later release leaks without touching the GIL; nothing can call
   635	//    PyGILState_Ensure after the finalizing flag is set.
   636	//  * Lock order: no thread ever waits for the GIL while holding the mutex (the
   637	//    hook drops the mutex before re-taking the GIL; releasers never call Python
   638	//    under it), so the protocol cannot deadlock with the GIL.
   639	//  * (FIX2 had a bound here: after tensor_cuda._DLPACK_SHUTDOWN_WAIT_S the hook
   640	//    returned with the release still running. Round-3 review V3-01 showed that a
   641	//    finite 5.5 s deleter then wakes during finalization and aborts the process.
   642	//    Replaced by P1T-FIX3 below: the wait has no bound.)
   643	//
   644	// P1T-FIX3, round-3 review finding V3-01 (MAJOR, exit quiescence). The hook never
   645	// returns to ordinary finalization while an admitted release is running:
   646	//  * dlpack_begin_shutdown waits until in_flight == 0, with NO bound. Its argument
   647	//    (tensor_cuda._DLPACK_SHUTDOWN_WAIT_S) is now only the delay of the first
   648	//    stderr diagnostic (count still running, seconds waited); later diagnostics
   649	//    follow a geometric schedule (each one when the time waited has doubled), so
   650	//    a deleter that hangs for hours logs a few dozen lines at most, and the wait
   651	//    goes on. Admission stays closed throughout (no new release is admitted).
   652	//  * GIL: the whole wait, diagnostics included, runs with the GIL released (P1T-FIX5: an
   653	//    explicit PyEval_SaveThread / PyEval_RestoreThread pair, see dlpack_begin_shutdown), so
   654	//    an admitted deleter that needs the GIL (PyGILState_Ensure, a ctypes or
   655	//    Python deleter, time.sleep re-taking it) can always finish; the condition
   656	//    variable wait drops the mutex; each diagnostic is written with the mutex
   657	//    dropped (a blocked stderr cannot stop a release from leaving); the GIL is
   658	//    re-taken only after the mutex is released. The lock order of FIX2 holds: no
   659	//    thread waits for the GIL while holding the mutex.
   660	//  * Self-exclusion: a thread that runs the hook from inside its own admitted
   661	//    release (a deleter that calls the exit hook, e.g. atexit._run_exitfuncs())
   662	//    does not wait for itself: releases on its own stack (thread-local depth)
   663	//    cannot finish while it waits, and they necessarily finish before that thread
   664	//    can go on to finalize. Without this, the unbounded wait would self-deadlock.
   665	//  * Consequence (documented in tensor_cuda._dlpack_shutdown_hook too): a producer
   666	//    deleter that never returns makes interpreter exit wait forever. That is the
   667	//    producer's contract violation (a DLPack deleter must return); waiting is the
   668	//    honest outcome, where FIX2's bound turned it into an abort (rc -6). Ctrl-C
   669	//    does not interrupt the wait (no bytecode runs on the main thread during it);
   670	//    SIGTERM / SIGKILL still end the process.
   671	// Prior art: CPython's threading._shutdown / Py_FinalizeEx wait_for_thread_shutdown,
   672	// which joins every non-daemon thread with no bound before finalizing (the same
   673	// "finalization waits for work already started" rule, one level up); RCU-style
   674	// grace periods (synchronize_rcu waits, unbounded, for every reader that entered
   675	// before the grace period began, while new readers do not delay it; McKenney &
   676	// Slingwine 1998) and the Linux kernel's percpu_ref (kill, then wait for zero);
   677	// rate-limited / backed-off diagnostics such as the kernel's hung-task and RCU
   678	// stall warnings (repeated at growing intervals while the wait goes on). Taken:
   679	// the unbounded quiescence wait with admission closed, and periodic stall
   680	// reports. Ours: its placement at the CPython atexit boundary of the DLPack
   681	// import release, the doubling report schedule and the same-thread exclusion.
   682	// Unverified here (lead to check): "synchronize_rcu grace period readers
   683	// McKenney 1998", "rcu_cpu_stall_timeout repeat interval", "hung_task_warnings".
   684	// Prior art: CPython's own atexit-before-finalizing ordering (above) and its
   685	// threading._shutdown join of non-daemon threads (pylifecycle.c
   686	// wait_for_thread_shutdown), which is the same "stop admitting, wait for the
   687	// in-flight ones" idea one level up; the admission-counter + condition-variable
   688	// drain is the classic reader-count / quiescence pattern (e.g. the Linux
   689	// kernel's percpu_ref: kill, then wait for the count to drop to zero). Taken:
   690	// the pattern. Ours: its
   691	// placement around PyGILState_Ensure in the DLPack import release. Unverified here
   692	// (lead to check): "percpu_ref_kill_and_confirm quiesce", "pybind11
   693	// gil_scoped_acquire finalization".
   694	//
   695	// P1T-FIX2, review finding N4: the producer's deleter is called inside a
   696	// catch-all (counted in deleter_exceptions); this function is reached from the
   697	// noexcept Storage destructor, so an escaping C++ exception would be
   698	// std::terminate. Called at most once per Storage (the Storage owns the manager).
   699	std::atomic<unsigned long long> g_import_released{0};
   700	std::atomic<unsigned long long> g_import_leaked_shutdown{0};
   701	std::atomic<unsigned long long> g_import_leaked_closing{0};      // N5: release after the exit hook closed
   702	std::atomic<unsigned long long> g_import_deleter_exceptions{0};  // N4
   703	std::atomic<unsigned long long> g_import_lock_failures{0};       // N5: mutex failure (never observed) -> leak
   704	std::atomic<unsigned long long> g_shutdown_calls{0};
   705	std::atomic<unsigned long long> g_shutdown_in_flight_at_close{0};
   706	std::atomic<unsigned long long> g_shutdown_timeouts{0};
   707	std::atomic<unsigned long long> g_shutdown_still_in_flight{0};
   708	std::atomic<unsigned long long> g_shutdown_wait_us{0};
   709	std::atomic<unsigned long long> g_shutdown_diagnostics{0};       // V3-01: stderr lines written while waiting
   710	
   711	// V3-01: admitted releases on the CURRENT thread's stack (incremented on admission, decremented after leaving). The
   712	// exit hook does not wait for these: they cannot finish while the hook's thread waits (self-exclusion, see above).
   713	thread_local long long t_admitted_depth = 0;
   714	
   715	struct ImportReleaseLifecycle {
   716	  std::mutex mu;
   717	  std::condition_variable cv;
   718	  bool closing = false;
   719	  long long in_flight = 0;
   720	};
   721	
   722	// Never destroyed (a foreign thread may release after static destruction began). Constructed at module import
   723	// (PYBIND11_MODULE below), so no release path is the first caller (its allocation could fail there).
   724	ImportReleaseLifecycle& release_lifecycle() {
   725	  static ImportReleaseLifecycle* s = new ImportReleaseLifecycle();
   726	  return *s;
   727	}
   728	
   729	bool interpreter_accepts_gil_state() {
   730	  if (!Py_IsInitialized()) return false;
   731	#if PY_VERSION_HEX >= 0x030D0000
   732	  if (Py_IsFinalizing()) return false;
   733	#else
   734	  if (_Py_IsFinalizing()) return false;
   735	#endif
   736	  return true;
   737	}
   738	
   739	template <typename M>
   740	void import_release_impl(M* m) noexcept {
   741	  if (!m || !m->deleter) return;
   742	  ImportReleaseLifecycle& lc = release_lifecycle();
   743	  bool admitted = false;
   744	  try {
   745	    std::lock_guard<std::mutex> lk(lc.mu);
   746	    // Both checks leak without touching the GIL; the order only decides which counter records it (a release during
   747	    // finalization keeps FIX1's leaked_interpreter_shutdown attribution).
   748	    if (!interpreter_accepts_gil_state()) {
   749	      g_import_leaked_shutdown.fetch_add(1);         // F04: second line of defence
   750	    } else if (lc.closing) {
   751	      g_import_leaked_closing.fetch_add(1);          // N5: after the exit hook closed admission: deliberate leak
   752	    } else {
   753	      ++lc.in_flight;
   754	      admitted = true;
   755	    }
   756	  } catch (...) {
   757	    g_import_lock_failures.fetch_add(1);
   758	  }
   759	  if (!admitted) return;
   760	  ++t_admitted_depth;                                // V3-01: this thread now has an admitted release on its stack
   761	  PyGILState_STATE g = PyGILState_Ensure();
   762	  try {
   763	    m->deleter(m);
   764	    g_import_released.fetch_add(1);
   765	  } catch (...) {
   766	    g_import_deleter_exceptions.fetch_add(1);        // N4: contained (GIL still held while the exception dies)
   767	  }
   768	  PyGILState_Release(g);
   769	  // Leave only after PyGILState_Release: the exit hook must not let finalization start while this thread still
   770	  // touches the interpreter. notify_all on every leave (not only at zero): the hook may be waiting for a nonzero
   771	  // count, its own thread's admitted releases (V3-01 self-exclusion).
   772	  try {
   773	    std::lock_guard<std::mutex> lk(lc.mu);
   774	    --lc.in_flight;
   775	    lc.cv.notify_all();
   776	  } catch (...) {
   777	    g_import_lock_failures.fetch_add(1);
   778	  }
   779	  --t_admitted_depth;
   780	}
   781	
   782	void import_release_legacy(void* ctx) noexcept {
   783	  import_release_impl(static_cast<DLManagedTensor*>(ctx));
   784	}
   785	void import_release_versioned(void* ctx) noexcept {
   786	  import_release_impl(static_cast<DLManagedTensorVersioned*>(ctx));
   787	}
   788	
   789	// N5 + V3-01: the atexit side (tensor_cuda/__init__.py _dlpack_shutdown_hook). Called with the GIL held by the main
   790	// thread. Closes admission, then waits until every admitted release of OTHER threads has left (in_flight minus this
   791	// thread's own depth == 0). There is NO bound: it never returns while one is still running (V3-01). `first_diag_s`
   792	// (the knob tensor_cuda._DLPACK_SHUTDOWN_WAIT_S) is the time waited before the first stderr diagnostic; each later one
   793	// is written when the time waited has doubled since the previous one (geometric schedule: k lines take 2^(k-1) times
   794	// the first delay, so the line rate is bounded and falls as the wait goes on). NaN or negative: diagnose at once.
   795	// Returns {in_flight_at_close, still_in_flight, timed_out, waited_us, diagnostics, own_thread_in_flight}; `timed_out`
   796	// now means "the wait outlasted the first-diagnostic delay" (it no longer means the hook gave up), `still_in_flight`
   797	// (other threads' admitted releases still running at return) is always 0 now, and `own_thread_in_flight` is the
   798	// calling thread's own admitted releases that it did not wait for (0 at a real interpreter exit).
   799	py::dict dlpack_begin_shutdown(double first_diag_s) {
   800	  ImportReleaseLifecycle& lc = release_lifecycle();
   801	  if (!(first_diag_s >= 0.0)) first_diag_s = 0.0;           // NaN or negative: diagnose at once (the wait is the same)
   802	  if (first_diag_s > 86400.0) first_diag_s = 86400.0;       // keep the chrono conversion finite
   803	  const auto first = std::chrono::duration_cast<std::chrono::steady_clock::duration>(
   804	      std::chrono::duration<double>(first_diag_s));
   805	  const long long own = t_admitted_depth;                   // this thread's own admitted releases: never waited for
   806	  long long at_close = 0;
   807	  long long remaining = 0;
   808	  bool overran = false;
   809	  unsigned long long diagnostics = 0;
   810	  const auto t0 = std::chrono::steady_clock::now();
   811	  // P1T-FIX5 (sweep (c), callbacks during interpreter exit): the GIL is released with PyEval_SaveThread and re-taken
   812	  // with an explicit PyEval_RestoreThread in THIS frame (not noexcept), no longer by py::gil_scoped_release's
   813	  // destructor. CPython 3.12 exits a non-main thread that re-takes the GIL during finalization (take_gil ->
   814	  // PyThread_exit_thread -> pthread_exit, a forced unwind); started inside a destructor, that unwind meets the
   815	  // destructor's implicit noexcept (std::terminate, abort). A non-main thread can be here: the hook is a plain Python
   816	  // function (tensor_cuda._dlpack_shutdown_hook), and two waiters (it and the main thread's real atexit call) wake
   817	  // together when the last admitted release leaves. Now such a thread's forced unwind travels through ordinary frames
   818	  // to pybind11's dispatcher, which rethrows abi::__forced_unwind (pybind11 v2.12 pybind11.h:1037). The mutex is still
   819	  // released before the GIL is re-taken. Same design as tc_signal's release lifecycle (dlpack_operand.cpp). Prior art:
   820	  // CPython's PyEval_SaveThread / PyEval_RestoreThread contract; glibc/libstdc++ forced unwinding (abi::__forced_unwind
   821	  // must propagate; a noexcept frame terminates); pybind11's gil_scoped_release::disarm note ("PyEval_RestoreThread()
   822	  // should not be called if runtime is finalizing"). Ours: the explicit restore placement.
   823	  PyThreadState* gil_state = PyEval_SaveThread();           // admitted releases need the GIL to finish
   824	  try {
   825	    std::unique_lock<std::mutex> lk(lc.mu);
   826	    lc.closing = true;                                      // admission closed for good: nothing new can start
   827	    at_close = lc.in_flight;
   828	    auto next = t0 + first;
   829	    while (!lc.cv.wait_until(lk, next, [&lc, own] { return lc.in_flight <= own; })) {
   830	      // Still running at the diagnostic time: report, then keep waiting (never return early: V3-01).
   831	      overran = true;
   832	      const long long running = lc.in_flight - own;
   833	      lk.unlock();                                          // a blocked stderr must not stop a release from leaving
   834	      const auto now = std::chrono::steady_clock::now();
   835	      std::fprintf(stderr,
   836	                   "tensor_cuda: %lld DLPack release(s) admitted before exit still running after %.1f s; interpreter "
   837	                   "exit waits for them (no new release is admitted)\n",
   838	                   running, std::chrono::duration<double>(now - t0).count());
   839	      std::fflush(stderr);
   840	      ++diagnostics;
   841	      // Next line when the time waited has doubled (at least one clock tick later: no busy loop at a zero delay).
   842	      const auto waited = now - t0;
   843	      const auto tick = std::chrono::steady_clock::duration(1);
   844	      next = now + (waited > tick ? waited : tick);
   845	      lk.lock();
   846	    }
   847	    remaining = lc.in_flight - own;
   848	  } catch (...) {
   849	    // A mutex / condition-variable failure (never observed): re-take the GIL, then let it propagate (as the RAII guard
   850	    // did). No Python ran in the try block, so this is never a forced unwind of the interpreter's making.
   851	    PyEval_RestoreThread(gil_state);
   852	    throw;
   853	  }  // lk is released before the GIL is re-taken
   854	  PyEval_RestoreThread(gil_state);                          // explicit, in this non-noexcept frame (see above)
   855	  const long long waited_us =
   856	      std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - t0).count();
   857	  g_shutdown_calls.fetch_add(1);
   858	  g_shutdown_in_flight_at_close.fetch_add(static_cast<unsigned long long>(at_close));
   859	  if (overran) g_shutdown_timeouts.fetch_add(1);
   860	  g_shutdown_still_in_flight.store(static_cast<unsigned long long>(remaining));
   861	  g_shutdown_wait_us.fetch_add(static_cast<unsigned long long>(waited_us));
   862	  g_shutdown_diagnostics.fetch_add(diagnostics);
   863	  py::dict d;
   864	  d["in_flight_at_close"] = at_close;
   865	  d["still_in_flight"] = remaining;
   866	  d["timed_out"] = overran;
   867	  d["waited_us"] = waited_us;
   868	  d["diagnostics"] = diagnostics;
   869	  d["own_thread_in_flight"] = own;
   870	  return d;
   871	}
   872	void import_release_noop(void*) {}
