   241	struct WaitOutcome {
   242	  long long running_at_start = 0;  // admitted sections of OTHER threads when the wait began
   243	  long long own[kKinds] = {0, 0};  // this thread's own (excluded)
   244	  long long waited_us = 0;
   245	  unsigned long long diagnostics = 0;
   246	  bool overran = false;            // outlasted the first-diagnostic delay
   247	};
   248	
   249	long long others_running(const Lifecycle& lc, bool callbacks_too, const long long own[kKinds]) noexcept {
   250	  long long r = lc.in_flight[kRelease].load(std::memory_order_seq_cst) - own[kRelease];
   251	  if (callbacks_too) r += lc.in_flight[kCallback].load(std::memory_order_seq_cst) - own[kCallback];
   252	  return r;
   253	}
   254	
   255	// The part of the wait that runs with the GIL released: the mutex and condition variable only, no Python object.
   256	void wait_without_gil(Lifecycle& lc, bool callbacks_too, double first_diag_s, const char* who,
   257	                      std::chrono::steady_clock::time_point t0, WaitOutcome& w) noexcept {
   258	  using clock = std::chrono::steady_clock;
   259	  const auto first = std::chrono::duration_cast<clock::duration>(std::chrono::duration<double>(first_diag_s));
   260	  auto quiet = [&lc, callbacks_too, &w] { return others_running(lc, callbacks_too, w.own) <= 0; };
   261	  try {
   262	    std::unique_lock<std::mutex> lk(lc.mu);
   263	    auto next = t0 + first;
   264	    while (!lc.cv.wait_until(lk, next, quiet)) {
   265	      // Still running at the diagnostic time: report, then keep waiting (never return early: V3-01, V5-01).
   266	      w.overran = true;
   267	      const long long running = others_running(lc, callbacks_too, w.own);
   268	      lk.unlock();  // a blocked stderr must not stop a callback from leaving
   269	      const auto now = clock::now();
   270	      std::fprintf(stderr,
   271	                   "tc_signal: %lld DLPack producer callback(s) (deleter, capsule destructor or __dlpack__) admitted "
   272	                   "on other threads before %s still running after %.1f s; %s waits for them%s\n",
   273	                   running, who, std::chrono::duration<double>(now - t0).count(), who,
   274	                   callbacks_too ? " (no new one is admitted)" : "");
   275	      std::fflush(stderr);
   276	      ++w.diagnostics;
   277	      const auto waited = now - t0;  // next line when the time waited has doubled (at least one tick: no busy loop)
   278	      const auto tick = clock::duration(1);
   279	      next = now + (waited > tick ? waited : tick);
   280	      lk.lock();
   281	    }
   282	  } catch (const std::system_error&) {
   283	    // A mutex / condition-variable failure (never observed): keep waiting by polling, never return early.
   284	    g_lifecycle_lock_failures.fetch_add(1, std::memory_order_relaxed);
   285	    while (!quiet()) std::this_thread::sleep_for(std::chrono::milliseconds(tuning::kLifecyclePollMs));
   286	  }
   287	}
   288	
   289	// Waits until no admitted section of another thread is running (kRelease; plus kCallback when callbacks_too). The GIL
   290	// is released for the wait and re-taken explicitly here (see the design block above for why not by a destructor).
   291	WaitOutcome wait_for_other_threads(bool callbacks_too, double first_diag_s, const char* who) {
   292	  Lifecycle& lc = lifecycle();
   293	  WaitOutcome w;
   294	  w.own[kRelease] = t_depth[kRelease];
   295	  w.own[kCallback] = t_depth[kCallback];
   296	  w.running_at_start = others_running(lc, callbacks_too, w.own);
   297	  if (w.running_at_start <= 0) return w;  // nothing to wait for: the GIL is not touched
   298	  if (!(first_diag_s >= 0.0)) first_diag_s = 0.0;   // NaN or negative: diagnose at once (the wait is the same)
   299	  if (first_diag_s > tuning::kLifecycleMaxDiagDelayS) first_diag_s = tuning::kLifecycleMaxDiagDelayS;
   300	  const auto t0 = std::chrono::steady_clock::now();
   301	  const bool held = PyGILState_Check() != 0;
   302	  PyThreadState* ts = held ? PyEval_SaveThread() : nullptr;  // GIL released: an admitted callback can finish
   303	  wait_without_gil(lc, callbacks_too, first_diag_s, who, t0, w);
   304	  if (held) PyEval_RestoreThread(ts);  // the mutex is not held here; may exit a daemon thread during finalization
   305	  w.waited_us = std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - t0).count();
   306	  return w;
   307	}
