   131	// ------------------------------------------------------------------------------------------------ kernels
   132	// 1-D im2col for one batch element (Chellapilla et al. 2006, 1-D with dilation and asymmetric zero padding):
   133	//   col[(c*K + k), t] = x[c, t*stride - pad_begin + k*dilation]   (0 outside [0, T))
   134	// Rows (c, k) are c-major, so group g's rows [g*Cg*K, (g+1)*Cg*K) form one contiguous [Cg*K, T_out] block that
   135	// matches w[g*Og:(g+1)*Og] viewed as [Og, Cg*K].
   136	__global__ void im2col1d_kernel(const float* __restrict__ x, float* __restrict__ col, int64_t C, int64_t T, int64_t K,
   137	                                int64_t T_out, int64_t stride, int64_t pad_begin, int64_t dilation) {
   138	  const int64_t total = C * K * T_out;
   139	  for (int64_t i = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; i < total;
   140	       i += static_cast<int64_t>(gridDim.x) * blockDim.x) {
   141	    const int64_t t = i % T_out;
   142	    const int64_t r = i / T_out;
   143	    const int64_t k = r % K;
   144	    const int64_t c = r / K;
   145	    const int64_t src = t * stride - pad_begin + k * dilation;
   146	    col[i] = (src >= 0 && src < T) ? x[c * T + src] : 0.0f;
   147	  }
   148	}
   149	
   150	// y[n, o, t] += b[o], one thread per output element (fp32 add, one rounding).
   151	__global__ void bias_add_kernel(float* __restrict__ y, const float* __restrict__ b, int64_t C_out, int64_t T_out,
   152	                                int64_t total) {
   153	  for (int64_t i = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; i < total;
   154	       i += static_cast<int64_t>(gridDim.x) * blockDim.x) {
   155	    const int64_t o = (i / T_out) % C_out;
   156	    y[i] = y[i] + b[o];
   157	  }
   158	}
   159	
   160	// Gather-form ConvTranspose1d (adjoint of strided conv, Dumoulin & Visin 2016), one thread per output element:
   161	//   y[n, o, t] = b[o] + sum_{k=0..K-1} sum_{c in group(o)} w[c, o - g*Og, k] * x[n, c, (t + pb - k*dilation)/stride]
   162	// over the taps with (t + pb - k*dilation) >= 0, divisible by stride, and quotient < T. Fixed order: k ascending
   163	// (outer), c ascending within the group (inner), fp32 fmaf accumulation from 0, bias added last. No atomics.
   164	__global__ void conv_transpose1d_gather_kernel(const float* __restrict__ x, const float* __restrict__ w,
   165	                                               const float* __restrict__ b, float* __restrict__ y, int64_t N,
   166	                                               int64_t C_in, int64_t T, int64_t C_out, int64_t K, int64_t T_out,
   167	                                               int64_t stride, int64_t pad_begin, int64_t dilation, int64_t groups) {
   168	  const int64_t Cg = C_in / groups;
   169	  const int64_t Og = C_out / groups;
   170	  const int64_t total = N * C_out * T_out;
   171	  for (int64_t i = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; i < total;
   172	       i += static_cast<int64_t>(gridDim.x) * blockDim.x) {
   173	    const int64_t t = i % T_out;
   174	    const int64_t r = i / T_out;
   175	    const int64_t o = r % C_out;
   176	    const int64_t n = r / C_out;
   177	    const int64_t g = o / Og;
   178	    const int64_t ol = o - g * Og;
   179	    const float* xg = x + (n * C_in + g * Cg) * T;   // x[n, g*Cg + cl, :] = xg[cl*T + :]
   180	    const float* wg = w + (g * Cg * Og + ol) * K;    // w[g*Cg + cl, ol, k] = wg[cl*Og*K + k]
   181	    float acc = 0.0f;
   182	    for (int64_t k = 0; k < K; ++k) {
   183	      const int64_t s = t + pad_begin - k * dilation;
   184	      if (s < 0 || s % stride != 0) continue;
   185	      const int64_t q = s / stride;
   186	      if (q >= T) continue;
   187	      const float* xp = xg + q;
   188	      const float* wp = wg + k;
   189	      for (int64_t cl = 0; cl < Cg; ++cl) acc = fmaf(wp[cl * Og * K], xp[cl * T], acc);
   190	    }
   191	    if (b != nullptr) acc = acc + b[o];
   192	    y[i] = acc;
   193	  }
   194	}
   195	
   196	// Fast-math canary: out[i] = x[i] / y[i] in fp32. Built with this TU's flags, so --use_fast_math (-ftz=1,
   197	// -prec_div=0) shows up as flushed subnormals or non-IEEE quotients, which the tests compare bitwise against the host's
   198	// IEEE fp32 division. Prior art: no specific source known to me (it is the usual "test the build flags by their
   199	// observable effect" idea; denormal flushing as a fast-math symptom is documented in the CUDA C Programming Guide).
   200	__global__ void fp32_divide_probe_kernel(const float* __restrict__ x, const float* __restrict__ y,
   201	                                         float* __restrict__ out, int64_t n) {
   202	  for (int64_t i = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; i < n;
   203	       i += static_cast<int64_t>(gridDim.x) * blockDim.x)
   204	    out[i] = x[i] / y[i];
   205	}
