    67	constexpr cudaStream_t kLegacyStream = 0;  // the legacy default stream (TensorCUDA's only stream)
    68	
    69	void check_cuda(cudaError_t e, const char* what) {
    70	  if (e != cudaSuccess) {
    71	    std::ostringstream os;
    72	    os << "tc_signal: " << what << " failed: " << cudaGetErrorName(e) << ": " << cudaGetErrorString(e);
    73	    cudaGetLastError();  // P1T-FIX4 (cuda_guard.h rule 1): this raise reports the failed call, so it consumes its entry
    74	    throw std::runtime_error(os.str());
    75	  }
    76	}
