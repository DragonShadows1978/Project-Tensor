  1358	py::dict pending_stats(bool reset_high_water) {
  1359	  PendingState& st = pending();
  1360	  py::dict d;
  1361	  d["entries"] = static_cast<long long>(st.q.size());
  1362	  d["managers"] = st.managers;
  1363	  d["bytes"] = st.bytes;
  1364	  d["high_water_entries"] = st.high_water_entries;
  1365	  d["high_water_managers"] = st.high_water_managers;
  1366	  d["high_water_bytes"] = st.high_water_bytes;
  1367	  d["retained_entries"] = st.retained_entries;
  1368	  d["released_entries"] = st.released_entries;
  1369	  d["released_managers"] = st.released_managers;
  1370	  d["bound_drains"] = st.bound_drains;
  1371	  d["fallback_syncs"] = st.fallback_syncs;
  1372	  d["leaked_managers"] = st.leaked_managers;
  1373	  d["max_entries"] = tuning::kPendingMaxEntries;
  1374	  d["max_bytes"] = tuning::kPendingMaxBytes;
  1375	  // P1T-FIX2 counters.
  1376	  d["deleter_exceptions"] = deleter_exceptions();           // N4
  1377	  d["push_alloc_failures"] = st.push_alloc_failures;        // N3
  1378	  d["event_recycle_failures"] = st.event_recycle_failures;  // N3
  1379	  d["bytes_saturated"] = st.bytes_saturated;                // P1T-FIX3 V3-02
  1380	  d["bytes_saturations"] = st.bytes_saturations;            // P1T-FIX3 V3-02
  1381	  d["release_errors"] = st.release_errors;                  // N1
  1382	  d["unreported_release_errors"] = st.unreported_count;     // N1
  1383	  d["device_restore_failures"] = st.device_restore_failures;  // P1T-FIX4 (sweep): caller-device restores that failed
  1384	  d["event_destroy_failures"] = st.event_destroy_failures;    // P1T-FIX4 (sweep)
  1385	  d["unreported_unraisable_errors"] = st.unraisable_unreported;  // P1T-FIX4: raised by the next synchronize()
  1386	  // P1T-FIX5 counters. V5-01 release lifecycle: admission state, sections in flight (all threads), admitted totals,
  1387	  // releases refused after admission closed (deleters not called, capsule references kept: "a late release leaks
  1388	  // without entering Python, and is counted") or while finalizing, producer callbacks refused, the exit hook's wait and
  1389	  // synchronize()'s wait for other threads, mutex failures. V5-02 / sweep (d): recorded query and record failures.
  1390	  // V5-03: cuBLAS handles whose destroy failed while an exception propagated.
  1391	  {
  1392	    const Lifecycle& lc = lifecycle();
  1393	    d["release_admission_closed"] = lc.closing.load();
  1394	    d["releases_in_flight"] = lc.in_flight[kRelease].load();
  1395	    d["callbacks_in_flight"] = lc.in_flight[kCallback].load();
  1396	  }
  1397	  d["admitted_releases"] = g_admitted[kRelease].load();
  1398	  d["admitted_callbacks"] = g_admitted[kCallback].load();
  1399	  d["deleters_leaked_after_close"] = g_deleters_leaked_after_close.load();
  1400	  d["deleters_leaked_finalizing"] = g_deleters_leaked_finalizing.load();
  1401	  d["capsules_kept_after_close"] = g_capsules_kept_after_close.load();
  1402	  d["capsules_kept_finalizing"] = g_capsules_kept_finalizing.load();
  1403	  d["callbacks_refused_after_close"] = g_callbacks_refused.load();
  1404	  d["exit_hook_calls"] = g_exit_hook_calls.load();
  1405	  d["exit_in_flight_at_close"] = g_exit_in_flight_at_close.load();
  1406	  d["exit_wait_us"] = g_exit_wait_us.load();
  1407	  d["exit_wait_diagnostics"] = g_exit_wait_diagnostics.load();
  1408	  d["exit_wait_overruns"] = g_exit_wait_overruns.load();
  1409	  d["sync_waits_for_other_threads"] = g_sync_waits.load();
  1410	  d["sync_wait_us"] = g_sync_wait_us.load();
  1411	  d["sync_wait_diagnostics"] = g_sync_wait_diagnostics.load();
  1412	  d["lifecycle_lock_failures"] = g_lifecycle_lock_failures.load();
  1413	  d["event_query_failures"] = st.event_query_failures;    // V5-02
  1414	  d["event_record_failures"] = st.event_record_failures;  // sweep (d)
  1415	  d["cublas_handle_destroy_failures"] = g_cublas_destroy_failures.load();             // V5-03
  1416	  d["cublas_handle_destroy_first_status"] = g_cublas_destroy_first_status.load();     // V5-03
  1417	  if (reset_high_water) {
  1418	    st.high_water_entries = static_cast<long long>(st.q.size());
  1419	    st.high_water_managers = st.managers;
  1420	    st.high_water_bytes = st.bytes;
  1421	  }
  1422	  return d;
  1423	}
