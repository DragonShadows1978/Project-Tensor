   237	// ------------------------------------------------------------------------------------------------ Conv1d entry points
   238	py::tuple conv1d_plan(py::object x, py::object w, py::object b, int64_t stride, int64_t pb, int64_t pe,
   239	                      int64_t dilation, int64_t groups) {
   240	  drain_completed();
   241	  require_operand(x, "x");
   242	  require_operand(w, "w");
   243	  Peeked X = peek_operand(x, "x", 3);
   244	  Peeked W = peek_operand(w, "w", 3);
   245	  Peeked B;
   246	  const bool has_b = !b.is_none();
   247	  if (has_b) B = peek_operand(b, "b", 1);
   248	  same_device_peeked({&X, &W, has_b ? &B : nullptr}, {"x", "w", "b"});
   249	  Conv1dPlan p = plan_conv1d(X.shape, W.shape, has_b ? &B.shape : nullptr, stride, pb, pe, dilation, groups);
   250	  return py::make_tuple(X.capsule.object(), W.capsule.object(), has_b ? B.capsule.object() : py::none(),
   251	                        to_tuple(p.out_shape), py::int_(p.scratch_numel));
   252	}
   253	
   254	void conv1d_run(py::object xc, py::object wc, py::object bc, py::object out, py::object scratch, int64_t stride,
   255	                int64_t pb, int64_t pe, int64_t dilation, int64_t groups) {
   256	  drain_completed();
   257	  require_operand(xc, "x");
   258	  require_operand(wc, "w");
   259	  require_operand(out, "out");
   260	  Operand X(xc, "x", 3, false);
   261	  Operand W(wc, "w", 3, false);
   262	  Operand B;
   263	  if (!bc.is_none()) B = Operand(bc, "b", 1, false);
   264	  std::vector<int64_t> bshape;
   265	  if (B.present()) bshape = op_shape(B);
   266	  const std::vector<int64_t> xshape = op_shape(X);
   267	  const std::vector<int64_t> wshape = op_shape(W);
   268	  Conv1dPlan p = plan_conv1d(xshape, wshape, B.present() ? &bshape : nullptr, stride, pb, pe, dilation, groups);
   269	  Operand Y(to_capsule(out, "out", true).handle(), "out", 3, true);
   270	  expect_shape(Y, p.out_shape);
   271	  Operand S;
   272	  if (p.scratch_numel > 0) {
   273	    if (scratch.is_none()) bad_attr("conv1d: this call needs an im2col scratch operand and none was passed");
   274	    S = Operand(to_capsule(scratch, "scratch", true).handle(), "scratch", 1, true);
   275	    expect_shape(S, {p.scratch_numel});
   276	  } else if (!scratch.is_none()) {
   277	    bad_attr("conv1d: this call needs no scratch (K == 1, stride 1, no pads) but one was passed");
   278	  }
   279	  const int device = common_device({&X, &W, &B, &Y, &S});
   280	  for (const Operand* in : {&X, &W, &B, &S}) expect_disjoint(Y, *in);
   281	  for (const Operand* in : {&X, &W, &B}) expect_disjoint(S, *in);
   282	  // F01: every consumed manager stays alive until the legacy stream has passed these launches (also when a launch
   283	  // throws part-way); the producer deleters run later, from drain_completed / synchronize / atexit.
   284	  RetainUntilComplete keep(device, {&X, &W, &B, &Y, &S});
   285	  conv1d_forward(device, p.g, X.data(), W.data(), B.present() ? B.data() : nullptr, Y.data(),
   286	                 S.present() ? S.data() : nullptr);
   287	}
