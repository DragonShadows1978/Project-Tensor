   281	LstmCublasConfig lstm_cublas_config(int device) {
   282	  DeviceGuard guard(device);
   283	  cublasHandle_t h = lstm_handle_for(device);
   284	  cublasMath_t math;
   285	  cublasAtomicsMode_t atomics;
   286	  cublasPointerMode_t pmode;
   287	  cudaStream_t s;
   288	  check_cublas(cublasGetMathMode(h, &math), "cublasGetMathMode");
   289	  check_cublas(cublasGetAtomicsMode(h, &atomics), "cublasGetAtomicsMode");
   290	  check_cublas(cublasGetPointerMode(h, &pmode), "cublasGetPointerMode");
   291	  check_cublas(cublasGetStream(h, &s), "cublasGetStream");
   292	  LstmCublasConfig c;
   293	  c.math_mode = static_cast<int>(math);
   294	  c.atomics_mode = static_cast<int>(atomics);
   295	  c.pointer_mode = static_cast<int>(pmode);
   296	  c.legacy_stream = (s == kLegacyStream);
   297	  c.default_math = (math == CUBLAS_DEFAULT_MATH);
   298	  c.atomics_not_allowed = (atomics == CUBLAS_ATOMICS_NOT_ALLOWED);
   299	  guard.restore();  // P1T-FIX4
   300	  return c;
   301	}
