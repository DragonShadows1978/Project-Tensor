   400	Storage::~Storage() {
   401	  if (external_release) {
   402	    // Imported (DLPack) memory belongs to its producer: never cudaFree it and
   403	    // never hand it to the pool. ORDER MATTERS:
   404	    //  1. Drain the engine stream. Every engine kernel, cuBLAS call and
   405	    //     cudaMemcpy runs on stream 0 (the legacy default stream; this TU is
   406	    //     built without --default-stream per-thread), so once it is idle no
   407	    //     queued engine work can still read or write this memory. The engine
   408	    //     keeps no per-Storage "last use" event, so "everything queued so far"
   409	    //     is the only sound fence; an event recorded here and waited on would
   410	    //     cover exactly the same work at three API calls instead of one. A
   411	    //     deferred release (host callback) is not allowed to run the
   412	    //     producer's deleter, which may call CUDA (torch's caching allocator).
   413	    //  2. Then hand the memory back (the DLPack deleter, GIL held, in
   414	    //     bindings.cpp). A producer may reuse it at once on its own stream.
   415	    // Prior art: the DLPack deleter contract (dmlc/dlpack, 2017+) and the
   416	    // array API's stream rules (2021+); the drain-then-delete order is the
   417	    // standard CUDA "free only after last use" rule. Ours: its placement in
   418	    // the Storage destructor.
   419	    // P1T-FIX1 F05: drain THIS Storage's device (drain_device_legacy_stream
   420	    // above); if the drain fails, deliberately leak instead of releasing.
   421	    if (device.is_cuda() && !drain_device_legacy_stream(device.index)) {
   422	      g_external_drain_leaks.fetch_add(1);
   423	      return;
   424	    }
   425	    external_release(external_ctx);
   426	    return;
   427	  }
   428	  if (!ptr) return;
   429	  if (device.is_cuda()) {
   430	    if (pooled) cudaFreeAsync(ptr, 0);
   431	    else cudaFree(ptr);
   432	  } else {
   433	    std::free(ptr);
   434	  }
   435	}
