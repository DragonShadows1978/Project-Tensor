   126	// ------------------------------------------------------------------------------------------------ ConvTranspose1d plan
   127	struct ConvTranspose1dPlan {
   128	  ConvTranspose1dGeom g;
   129	  std::vector<int64_t> out_shape;
   130	};
   131	
   132	ConvTranspose1dPlan plan_conv_transpose1d(const std::vector<int64_t>& xs, const std::vector<int64_t>& ws,
   133	                                          const std::vector<int64_t>* bs, int64_t stride, int64_t pb, int64_t pe,
   134	                                          int64_t output_padding, int64_t dilation, int64_t groups) {
   135	  check_attr("stride", stride, 1);
   136	  check_attr("dilation", dilation, 1);
   137	  check_attr("groups", groups, 1);
   138	  check_attr("pad_begin", pb, 0);
   139	  check_attr("pad_end", pe, 0);
   140	  check_attr("output_padding", output_padding, 0);
   141	  std::ostringstream os;
   142	  if (output_padding >= std::max(stride, dilation)) {
   143	    os << "conv_transpose1d: output_padding (" << output_padding << ") must be < max(stride, dilation) ("
   144	       << std::max(stride, dilation) << ")";
   145	    bad_attr(os.str());
   146	  }
   147	  ConvTranspose1dPlan p{};
   148	  ConvTranspose1dGeom& g = p.g;
   149	  g.N = xs[0];
   150	  g.C_in = xs[1];
   151	  g.T = xs[2];
   152	  g.K = ws[2];
   153	  g.stride = stride;
   154	  g.pad_begin = pb;
   155	  g.pad_end = pe;
   156	  g.output_padding = output_padding;
   157	  g.dilation = dilation;
   158	  g.groups = groups;
   159	  if (ws[0] != g.C_in) {
   160	    os << "conv_transpose1d: w.shape[0] (" << ws[0] << ") != C_in (" << g.C_in
   161	       << "); w is [C_in, C_out/groups, K] (ONNX layout)";
   162	    bad_attr(os.str());
   163	  }
   164	  if (g.C_in % groups != 0) {
   165	    os << "conv_transpose1d: C_in (" << g.C_in << ") is not divisible by groups (" << groups << ")";
   166	    bad_attr(os.str());
   167	  }
   168	  g.C_out = ck_mul(ws[1], groups, "conv_transpose1d: C_out = w.shape[1]*groups");
   169	  if (bs != nullptr && (bs->size() != 1 || (*bs)[0] != g.C_out)) {
   170	    os << "conv_transpose1d: b has shape " << shape_str(*bs) << ", expected [" << g.C_out << "]";
   171	    bad_attr(os.str());
   172	  }
   173	  // F03: every step checked.
   174	  int64_t t_out = ck_mul(stride, g.T - 1, "conv_transpose1d: stride*(T-1)");
   175	  t_out = ck_add(t_out, output_padding, "conv_transpose1d: output length");
   176	  t_out = ck_add(t_out, ck_mul(dilation, g.K - 1, "conv_transpose1d: dilation*(K-1)"), "conv_transpose1d: output length");
   177	  t_out = ck_add(t_out, 1, "conv_transpose1d: output length");
   178	  t_out = ck_sub(t_out, pb, "conv_transpose1d: output length");
   179	  g.T_out = ck_sub(t_out, pe, "conv_transpose1d: output length");
   180	  if (g.T_out <= 0) {
   181	    os << "conv_transpose1d: output length stride*(T-1) + output_padding + dilation*(K-1) + 1 - pb - pe = "
   182	       << g.T_out << " is <= 0";
   183	    bad_attr(os.str());
   184	  }
   185	  p.out_shape = {g.N, g.C_out, g.T_out};
   186	  ck_shape_numel(p.out_shape, "conv_transpose1d: output size N*C_out*T_out");
   187	  return p;
   188	}
