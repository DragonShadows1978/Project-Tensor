   153	void row_norm_forward(int device, const RowNormGeom& g, const float* x, const float* scale, const float* bias,
   154	                      float* y) {
   155	  DeviceGuard guard(device);
   156	  constexpr int B = m4tuning::kNormBlock;
   157	  const unsigned int grid = static_cast<unsigned int>(std::max<int64_t>(1, std::min<int64_t>(g.rows, tuning::kGridCap)));
   158	  row_norm_kernel<B><<<grid, B, 0, kLegacyStream>>>(x, scale, bias, y, g.rows, g.L, g.eps, static_cast<int>(g.affine),
   159	                                                    g.channels, g.groups, g.ch_per_group, g.T);
   160	  check_cuda(cudaGetLastError(), "row_norm_kernel");
   161	  guard.restore();  // P1T-FIX4: success-path restore is checked (raises on failure)
   162	}
