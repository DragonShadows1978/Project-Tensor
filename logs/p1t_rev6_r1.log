     1	// P1T-FIX4: tc_signal's one device guard and its CUDA error-slot rules (replaces the four identical DeviceGuard copies
     2	// of conv.cu / lstm.cu / norms.cu / small_ops.cu and dlpack_operand.cpp's QuietDeviceGuard).
     3	//
     4	// Why (round-4 review): each round found new members of two classes, implicit current-device assumptions (F05, V4-01)
     5	// and unchecked or ignored CUDA returns and error state (N1, V4-03, V4-04). The FIX4 sweep found these members here:
     6	//  * every guard IGNORED the result of the restoring cudaSetDevice (destructor), so a failed restore left the caller on
     7	//    the operand's device silently;
     8	//  * a raise after a failed call left that call's entry in the calling thread's last-error slot, so the next, unrelated
     9	//    launch check (any tc_signal op, or core's, which shares this libcudart.so.12 instance) reported it again as its own.
    10	// The rules, applied by everything below and by the callers:
    11	//  1. Whoever reports a CUDA error consumes it: a raise after a failed CUDA call first takes the slot entry
    12	//     (cudaGetLastError), so the error is reported exactly once. CUDA 12.6 Programming Guide 3.2.12: the runtime keeps
    13	//     one error variable per host thread, "overwritten by the error code every time an error occurs", and
    14	//     cudaGetLastError "returns this variable and resets it to cudaSuccess" (artifacts/p1t_fix4/cuda_doc_quotes.txt).
    15	//  2. A restore of the caller's device is checked. On a success path it raises (DeviceGuard::restore()); where nothing
    16	//     may raise (a destructor, or unwinding after another error) the failure is consumed, counted, and raised once by
    17	//     the next tc_signal.synchronize() (note_unraisable_device_restore_failure, dlpack_operand.cpp).
    18	// cuBLAS 12.6 does not import libcudart (nm -D libcublas.so.12: no undefined cuda* symbol), so a cuBLAS failure never
    19	// touches this slot; it is reported by its cublasStatus_t only.
    20	//
    21	// Prior art: PyTorch c10::cuda::CUDAGuard / OptionalCUDAGuard (InlineDeviceGuard: switch in the constructor, restore in
    22	// the destructor through CUDAGuardImpl::uncheckedSetDevice -> C10_CUDA_CHECK_WARN, which consumes the slot with
    23	// cudaGetLastError and warns, never throws; read in the installed torch 2.11 headers, c10/cuda/impl/CUDAGuardImpl.h and
    24	// c10/cuda/CUDAException.h); CuPy's cupy.cuda.Device context manager (__exit__ restores the previous device). Taken: the
    25	// scoped switch-and-restore and consume-on-report. Ours: the raising restore() on success paths and routing the
    26	// unraisable failures to the next synchronize().
    27	#pragma once
    28	
    29	#include <cuda_runtime.h>
    30	
    31	#include <sstream>
    32	#include <stdexcept>
    33	#include <string>
    34	
    35	namespace tcs {
    36	
    37	// Defined in dlpack_operand.cpp: a caller-device restore that failed where nothing can raise. Counted
    38	// (pending_stats()['device_restore_failures']) and raised once by the next synchronize(). Never allocates, never
    39	// throws. GIL held (every tc_signal path runs under the GIL).
    40	void note_unraisable_device_restore_failure(int device, cudaError_t err) noexcept;
    41	
    42	// P1T-FIX5 (round-5 review V5-03), defined in dlpack_operand.cpp: a cublasDestroy of a newly created handle that failed
    43	// while an exception propagated (the cache insertion threw), so it could not raise. Counted, first status kept
    44	// (pending_stats()['cublas_handle_destroy_failures' / 'cublas_handle_destroy_first_status']). Never throws, never
    45	// allocates.
    46	void note_cublas_handle_destroy_failure(int status) noexcept;
    47	
    48	// Rule 1: raise for a failed CUDA call of ours, consuming its slot entry first.
    49	[[noreturn]] inline void raise_cuda_failure(const std::string& what, cudaError_t e) {
    50	  cudaGetLastError();
    51	  std::ostringstream os;
    52	  os << what << " failed: " << cudaGetErrorName(e) << ": " << cudaGetErrorString(e);
    53	  throw std::runtime_error(os.str());
    54	}
    55	
    56	// Makes `device` current for a launch path and restores the caller's device. The constructor raises RuntimeError (slot
    57	// entry consumed) if the current device cannot be read or the switch fails; nothing is switched then. restore() is the
    58	// success-path restore and raises if it fails. The destructor restores only if restore() was not reached (an exception
    59	// is unwinding) and then routes a failure to note_unraisable_device_restore_failure (rule 2): no throw from a
    60	// destructor.
    61	class DeviceGuard {
    62	 public:
    63	  explicit DeviceGuard(int device) : device_(device) {
    64	    cudaError_t e = cudaGetDevice(&prev_);
    65	    if (e != cudaSuccess) raise_cuda_failure("tc_signal: cudaGetDevice", e);
    66	    if (prev_ != device) {
    67	      e = cudaSetDevice(device);
    68	      if (e != cudaSuccess) raise_cuda_failure("tc_signal: cudaSetDevice(" + std::to_string(device) + ")", e);
    69	      switched_ = true;
    70	    }
    71	  }
    72	  void restore() {
    73	    if (!switched_) return;
    74	    switched_ = false;
    75	    const cudaError_t e = cudaSetDevice(prev_);
    76	    if (e != cudaSuccess)
    77	      raise_cuda_failure("tc_signal: restoring the caller's CUDA device " + std::to_string(prev_) +
    78	                             " after queueing work on device " + std::to_string(device_) +
    79	                             " (cudaSetDevice; the calling thread's current device is still " +
    80	                             std::to_string(device_) + ", and the call's operands stay retained until that work is done)",
    81	                         e);
    82	  }
    83	  ~DeviceGuard() {
    84	    if (!switched_) return;
    85	    const cudaError_t e = cudaSetDevice(prev_);
    86	    if (e != cudaSuccess) {
    87	      cudaGetLastError();
    88	      note_unraisable_device_restore_failure(prev_, e);
    89	    }
    90	  }
    91	  DeviceGuard(const DeviceGuard&) = delete;
    92	  DeviceGuard& operator=(const DeviceGuard&) = delete;
    93	
    94	 private:
    95	  int device_;
    96	  int prev_ = -1;
    97	  bool switched_ = false;
    98	};
    99	
   100	// The never-throwing variant for release paths (destructors, noexcept drains). A failed query or switch is reported
   101	// through ok()/error() with its slot entry consumed; a failed restore follows rule 2.
   102	class QuietDeviceGuard {
   103	 public:
   104	  explicit QuietDeviceGuard(int device) noexcept {
   105	    cudaError_t e = cudaGetDevice(&prev_);
   106	    if (e != cudaSuccess) {
   107	      cudaGetLastError();
   108	      err_ = e;
   109	      return;
   110	    }
   111	    if (prev_ != device) {
   112	      e = cudaSetDevice(device);
   113	      if (e != cudaSuccess) {
   114	        cudaGetLastError();
   115	        err_ = e;
   116	        return;
   117	      }
   118	      switched_ = true;
   119	    }
   120	  }
   121	  ~QuietDeviceGuard() {
   122	    if (!switched_) return;
   123	    const cudaError_t e = cudaSetDevice(prev_);
   124	    if (e != cudaSuccess) {
   125	      cudaGetLastError();
   126	      note_unraisable_device_restore_failure(prev_, e);
   127	    }
   128	  }
   129	  QuietDeviceGuard(const QuietDeviceGuard&) = delete;
   130	  QuietDeviceGuard& operator=(const QuietDeviceGuard&) = delete;
   131	  bool ok() const { return err_ == cudaSuccess; }
   132	  cudaError_t error() const { return err_; }
   133	
   134	 private:
   135	  int prev_ = 0;
   136	  cudaError_t err_ = cudaSuccess;
   137	  bool switched_ = false;
   138	};
   139	
   140	}  // namespace tcs
     1	// Checked int64 shape / geometry / byte arithmetic for tc_signal (P1T-FIX1, review finding F03).
     2	//
     3	// Every plan function and every operand validation computes element counts, output lengths, scratch sizes and byte
     4	// totals through these helpers BEFORE any narrowing cast, allocation or launch. An overflow raises ValueError naming
     5	// the quantity; a wrapped value is never used (in particular it never turns into an "empty" or negative extent).
     6	// The byte ceiling is INT64_MAX (= PTRDIFF_MAX on LP64): every byte total and every pointer offset must stay a valid
     7	// signed pointer difference.
     8	//
     9	// Prior art: GCC/Clang `__builtin_mul_overflow` / `__builtin_add_overflow` / `__builtin_sub_overflow` (GCC 5, 2015),
    10	// which this file uses; C23 `ckd_mul` / `ckd_add` / `ckd_sub` (<stdckdint.h>, ISO/IEC 9899:2024), the standardized
    11	// form of the same builtins; the SEI CERT C rules INT30-C / INT32-C ("ensure that operations on (un)signed integers do
    12	// not wrap / overflow"). Taken: the checked-operation primitive. Ours: where tc_signal applies it (the list of
    13	// quantities in the plan functions) and the INT64_MAX byte ceiling. Unverified in this sandbox (lead to check):
    14	// "GCC 5 __builtin_mul_overflow release", "C23 stdckdint ckd_mul", "CERT INT32-C".
    15	#pragma once
    16	
    17	#include <pybind11/pybind11.h>
    18	
    19	#include <cstdint>
    20	#include <limits>
    21	#include <string>
    22	#include <vector>
    23	
    24	namespace tcs {
    25	
    26	[[noreturn]] inline void overflow_refusal(const char* what) {
    27	  throw pybind11::value_error(std::string("tc_signal: ") + what +
    28	                              " overflows 64-bit arithmetic; refused (no wrapped size is ever used)");
    29	}
    30	
    31	inline int64_t ck_mul(int64_t a, int64_t b, const char* what) {
    32	  int64_t r = 0;
    33	  if (__builtin_mul_overflow(a, b, &r)) overflow_refusal(what);
    34	  return r;
    35	}
    36	
    37	inline int64_t ck_add(int64_t a, int64_t b, const char* what) {
    38	  int64_t r = 0;
    39	  if (__builtin_add_overflow(a, b, &r)) overflow_refusal(what);
    40	  return r;
    41	}
    42	
    43	inline int64_t ck_sub(int64_t a, int64_t b, const char* what) {
    44	  int64_t r = 0;
    45	  if (__builtin_sub_overflow(a, b, &r)) overflow_refusal(what);
    46	  return r;
    47	}
    48	
    49	// P1T-FIX2, review finding N2 (the zero-extent rule). A zero extent makes the element count 0, but it does NOT make
    50	// the other extents harmless: strides (suffix products), partial counts (prefix products) and byte strides are formed
    51	// from them whatever the count is, and the round-2 review reproduced signed overflow in exactly those products (UBSan,
    52	// core numel_of/contiguous_strides). So every product below multiplies EVERY extent, a zero counted as 1 (the extent
    53	// bound), and refuses the shape if that bound (or its fp32 byte size) overflows int64, even when the count is 0.
    54	// Callers have refused negative extents; a negative factor is also counted as 1 here (never multiplied).
    55	// Prior art: as above (checked builtins; CERT INT32-C). The same rule (itemsize times every NONZERO extent must fit,
    56	// even when the count is 0) is NumPy's array constructor (PyArray_NewFromDescr skips zero dimensions and multiplies
    57	// the rest into the byte size with overflow checks): measured here, numpy 2.4.2 np.empty((0, 2**62, 4), float32) and
    58	// np.empty((0, 2**61), float32) raise "array is too big". PyTorch 2.11 refuses the element-level part ("Stride
    59	// calculation overflowed" for (0, 2**62, 4), "Storage size calculation overflowed" for (2**62, 4, 0)) but not the byte
    60	// part (it accepts (0, 2**61) fp32). Taken: NumPy's rule. Ours: applying it to every tc_signal plan and validation.
    61	// Source-level citation unverified here (lead to check): "numpy ctors.c PyArray_NewFromDescr_int is_zero dimensions
    62	// overflow", "c10 computeStorageNbytesContiguous safe_multiplies_u64".
    63	inline int64_t ck_extent_bound(const std::vector<int64_t>& s, size_t a, size_t b, const char* what) {
    64	  int64_t p = 1;
    65	  for (size_t i = a; i < b; ++i) p = ck_mul(p, s[i] > 1 ? s[i] : 1, what);
    66	  return p;
    67	}
    68	
    69	// Product of s[a, b), each factor >= 0. A zero factor makes the product 0, but only after the extent bound of the
    70	// same range has been checked (N2: a zero never hides an overflowing neighbour).
    71	inline int64_t ck_prod(const std::vector<int64_t>& s, size_t a, size_t b, const char* what) {
    72	  const int64_t bound = ck_extent_bound(s, a, b, what);
    73	  for (size_t i = a; i < b; ++i)
    74	    if (s[i] == 0) return 0;
    75	  return bound;
    76	}
    77	
    78	// Bytes of `numel` fp32 elements, refused above INT64_MAX.
    79	inline int64_t ck_fp32_bytes(int64_t numel, const char* what) {
    80	  return ck_mul(numel, static_cast<int64_t>(sizeof(float)), what);
    81	}
    82	
    83	// Element count of a planned output/scratch shape, plus the check that the fp32 byte size of its EXTENT BOUND fits
    84	// (N2: so every byte stride fits too, also for a count of 0); returns the count.
    85	inline int64_t ck_shape_numel(const std::vector<int64_t>& s, const char* what) {
    86	  const int64_t bound = ck_extent_bound(s, 0, s.size(), what);
