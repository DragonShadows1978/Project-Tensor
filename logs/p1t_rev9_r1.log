   154	  row_norm_kernel<B><<<grid, B, 0, kLegacyStream>>>(x, scale, bias, y, g.rows, g.L, g.eps, static_cast<int>(g.affine),
   155	                                                    g.channels, g.groups, g.ch_per_group, g.T);
   156	  check_launch_on(kPrefix, "row_norm_kernel", device);
   157	  guard.restore();  // P1T-FIX4: success-path restore is checked (raises on failure)
   158	}
