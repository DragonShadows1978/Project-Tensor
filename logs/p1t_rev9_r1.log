    77	// Sum of every thread's `v` over the block, by a fixed tree (stride B/2, B/4, ..., 1); every thread gets the total.
    78	template <int B>
    79	__device__ __forceinline__ float block_tree_sum(float v, float* red) {
    80	  red[threadIdx.x] = v;
    81	  __syncthreads();
    82	#pragma unroll
    83	  for (int s = B / 2; s > 0; s >>= 1) {
    84	    if (static_cast<int>(threadIdx.x) < s) red[threadIdx.x] = red[threadIdx.x] + red[threadIdx.x + s];
    85	    __syncthreads();
    86	  }
    87	  const float total = red[0];
    88	  __syncthreads();  // every thread has read red[0] before the next call overwrites red
    89	  return total;
    90	}
    91	
    92	template <int B>
    93	__global__ void __launch_bounds__(B) row_norm_kernel(const float* __restrict__ x, const float* __restrict__ scale,
    94	                                                     const float* __restrict__ bias, float* __restrict__ y,
    95	                                                     int64_t rows, int64_t L, float eps, int affine, int64_t channels,
    96	                                                     int64_t groups, int64_t ch_per_group, int64_t T) {
    97	  __shared__ float red[B];
    98	  const int64_t tid = threadIdx.x;
    99	  const int64_t chunk_span = static_cast<int64_t>(B) * m4tuning::kNormChunk;
   100	  const float Lf = static_cast<float>(L);  // exact for L < 2^24
   101	  for (int64_t row = blockIdx.x; row < rows; row += gridDim.x) {
   102	    const float* __restrict__ xr = x + row * L;
   103	    float* __restrict__ yr = y + row * L;
   104	    const float K = xr[0];
   105	
   106	    // Pass 1: the mean of the shifted row.
   107	    float acc = 0.0f;
   108	    for (int64_t base = tid; base < L; base += chunk_span) {
   109	      const int64_t end = min(L, base + chunk_span);
   110	      float part = 0.0f;
   111	      for (int64_t j = base; j < end; j += B) part = part + (xr[j] - K);
   112	      acc = acc + part;
   113	    }
   114	    const float d = block_tree_sum<B>(acc, red) / Lf;
   115	
   116	    // Pass 2: the centred sum of squares (biased variance).
   117	    acc = 0.0f;
   118	    for (int64_t base = tid; base < L; base += chunk_span) {
   119	      const int64_t end = min(L, base + chunk_span);
   120	      float part = 0.0f;
   121	      for (int64_t j = base; j < end; j += B) {
   122	        const float c = (xr[j] - K) - d;
   123	        part = fmaf(c, c, part);
   124	      }
   125	      acc = acc + part;
   126	    }
   127	    const float var = block_tree_sum<B>(acc, red) / Lf;
   128	    const float rstd = 1.0f / sqrtf(var + eps);
   129	
   130	    // Pass 3: normalize and apply the affine.
   131	    for (int64_t j = tid; j < L; j += B) {
   132	      const float c = (xr[j] - K) - d;
   133	      int64_t p;
   134	      if (affine == static_cast<int>(NormAffine::kPerRow))
   135	        p = row % channels;
   136	      else if (affine == static_cast<int>(NormAffine::kPerElem))
   137	        p = j;
   138	      else
   139	        p = (row % groups) * ch_per_group + j / T;
   140	      const float s = scale != nullptr ? scale[p] : 1.0f;
   141	      const float b = bias != nullptr ? bias[p] : 0.0f;
   142	      yr[j] = fmaf(c * rstd, s, b);
   143	    }
   144	  }
   145	}
