    84	unsigned int grid_for(int64_t total, int block) {
    85	  const int64_t blocks = (total + block - 1) / block;
    86	  return static_cast<unsigned int>(std::max<int64_t>(1, std::min<int64_t>(blocks, lstm_tuning::kGridCap)));
