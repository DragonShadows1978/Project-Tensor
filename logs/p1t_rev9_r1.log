  1958	// The diagnostic naming every record not raised yet (P1T-FIX7: shared by synchronize() and the exit runner's log).
     1	// _tc_signal: the C++ half of the tc_signal add-on (P1T-M2). Every operand, outputs and scratch included, is a DLPack
     2	// producer or capsule; this module allocates no device memory (the Python layer allocates outputs and the im2col
     3	// scratch through tc_signal's allocator and passes them in).
     4	//
     5	// Two calls per op, so the Python layer can size and allocate before anything is consumed:
     6	//   *_plan(x, w, b, attrs)  -> acquires the input capsules (__dlpack__(stream=1)), PEEKS their DLTensors (validates
     7	//                              device/dtype/layout/shapes/attributes without consuming), and returns
     8	//                              (x_capsule, w_capsule, b_capsule|None, out_shape[, scratch_numel]);
     9	//   *_run(capsules, out[, scratch], attrs) -> consumes every capsule, re-validates, checks devices and overlap,
    10	//                              launches on the legacy default stream, then hands every consumed manager to the
    11	//                              deferred-release list (P1T-FIX1 F01, dlpack_operand.h RetainUntilComplete): the producer
    12	//                              deleters run once the legacy stream has passed the launches, never before.
    13	// P1T-FIX1 also adds: F02 (a required operand passed as None -> TypeError before planning), F03 (every size below is
    14	// computed with checked arithmetic, checked_math.h), and drain_completed() first thing in every entry point.
    15	//
    16	// Prior art: see dlpack_operand.h (DLPack, Python array API stream protocol) and conv.cu (im2col, gather-form
    17	// ConvTranspose, ONNX semantics). The plan/run split is ours (no prior art known to me for this exact split; it is the
    18	// ordinary "query workspace size, then execute" pattern of cuDNN/cuBLASLt workspace APIs applied to DLPack operands).
    19	#include <pybind11/pybind11.h>
    20	#include <pybind11/stl.h>
    21	
    22	#include <algorithm>
    23	#include <climits>
    24	#include <cstdio>  // P1T-FIX7: the exit runner's stderr line (C stdio, no Python)
    25	#include <sstream>
    26	#include <string>
    27	#include <vector>
    28	
    29	#include "checked_math.h"
    30	#include "conv_ops.h"
    31	#include "dlpack_operand.h"
    32	#include "py_args.h"  // P1T-FIX6 sweep (g): C-level argument matching and conversion
    33	#include "tuning.h"
    34	
    35	namespace py = pybind11;
    36	
    37	namespace tcs {
    38	namespace {
    39	
    40	[[noreturn]] void bad_attr(const std::string& msg) { throw py::value_error("tc_signal: " + msg); }
    41	
    42	void check_attr(const char* name, int64_t v, int64_t lo) {
    43	  if (v < lo || v > INT_MAX) {
    44	    std::ostringstream os;
    45	    os << name << " must be in [" << lo << ", " << INT_MAX << "], got " << v;
    46	    bad_attr(os.str());
    47	  }
    48	}
    49	
    50	void check_int_range(const char* what, int64_t v) {
    51	  if (v > INT_MAX) {
    52	    std::ostringstream os;
    53	    os << what << " (" << v << ") exceeds the 32-bit range cuBLAS takes";
    54	    bad_attr(os.str());
    55	  }
    56	}
