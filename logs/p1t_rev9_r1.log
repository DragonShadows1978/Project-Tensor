   440	// ------------------------------------------------------------------------------------------------ validation
   441	int64_t validate_tensor(const DLTensor* t, const char* role, int ndim) {
   442	  if (t->device.device_type != kDLCUDA) {
   443	    std::ostringstream os;
   444	    os << "device type " << static_cast<int>(t->device.device_type)
   445	       << " is not kDLCUDA (2); tc_signal takes CUDA device memory only";
   446	    refuse_value(role, os.str());
   447	  }
   448	  if (t->dtype.code != kDLFloat || t->dtype.bits != 32 || t->dtype.lanes != 1) {
   449	    std::ostringstream os;
   450	    os << "dtype (code " << static_cast<int>(t->dtype.code) << ", bits " << static_cast<int>(t->dtype.bits)
   451	       << ", lanes " << t->dtype.lanes
   452	       << ") is not float32; tc_signal computes in fp32 only (expand fp16 weights to fp32 first)";
   453	    refuse_type(role, os.str());
   454	  }
   455	  // F03 (P1T-FIX1): a negative rank or a NULL shape array (with rank > 0) is refused before the shape is read.
   456	  if (t->ndim < 0) {
   457	    std::ostringstream os;
   458	    os << "negative number of dimensions " << t->ndim;
   459	    refuse_value(role, os.str());
   460	  }
   461	  if (t->ndim > 0 && t->shape == nullptr) refuse_value(role, "NULL shape array for a tensor with dimensions");
   462	  if (t->ndim != ndim) {
   463	    std::ostringstream os;
   464	    os << "expected " << ndim << " dimensions, got " << t->ndim;
   465	    refuse_value(role, os.str());
   466	  }
   467	  // F03: checked element count and fp32 byte total, before the stride walk below multiplies extents and before any
   468	  // later byte range is formed.
   469	  // P1T-FIX2, review finding N2 (zero-extent rule, checked_math.h ck_extent_bound): EVERY extent is multiplied (a zero
   470	  // or negative one counted as 1) BEFORE the empty-operand refusal, so a shape such as [0, 2^62, 4] is refused as an
   471	  // overflow, never waved through because its count is 0. Prior art: NumPy's array constructor rule (see
   472	  // checked_math.h); the checked builtins (GCC 5, 2015).
   473	  int64_t numel = 1;
   474	  for (int i = 0; i < t->ndim; ++i) {
   475	    if (__builtin_mul_overflow(numel, t->shape[i] > 1 ? t->shape[i] : int64_t{1}, &numel))
   476	      refuse_value(role, "element count of shape " + shape_str(shape_of(t)) +
   477	                             " overflows int64 (every nonzero extent counts, also next to a zero extent)");
   478	  }
   479	  int64_t nbytes = 0;
   480	  if (__builtin_mul_overflow(numel, static_cast<int64_t>(sizeof(float)), &nbytes))
  1030	  // N1: release-path failures not yet raised by synchronize() (the first one is named; all are counted).
  1031	  // P1T-FIX7 (V7-02 sweep (j)): the first one is a tagged record (which call failed, device, error) plus where it
  1032	  // happened (FIX6 kept a device and an error, and the bound drain could pair them wrongly: SyncReport::first).
  1033	  unsigned long long unreported_count = 0;
  1034	  unsigned long long unreported_leaked = 0;
  1035	  FailureRecord unreported_first;
  1036	  bool unreported_in_bound_drain = false;  // false: the synchronous fallback of a call that could not queue its event
  1037	  // P1T-FIX4 (sweep): CUDA failures on paths that cannot raise and leak no operand (a restore of the caller's device,
  1038	  // an event destroy). Counted; the first is named and all are raised once by the next synchronize().
  1039	  // P1T-FIX7: the first one is a tagged record (FIX6: a site string that named the guarded call even when the guard's
  1040	  // own cudaGetDevice / cudaSetDevice was what failed).
  1041	  unsigned long long device_restore_failures = 0;
  1042	  unsigned long long event_destroy_failures = 0;
  1043	  unsigned long long unraisable_unreported = 0;
  1044	  FailureRecord unraisable_first;
  1045	  // P1T-FIX4 V4-04: the calling thread's pre-existing error taken by synchronize() on entry, held until its message
  1046	  // exists (so a MemoryError while building the message does not lose it: the next synchronize() raises it).
  1047	  unsigned long long prior_unreported = 0;
  1048	  cudaError_t prior_error = cudaSuccess;
  1049	  // P1T-FIX5: CUDA failures that used to be consumed from the error slot without being recorded. Each is now counted
  1050	  // here AND recorded through note_unraisable_failure before the slot entry is consumed, so the next synchronize()
  1051	  // raises it exactly once: V5-02, a non-NotReady cudaEventQuery failure in the next-call drain (FIX4 rows 47/50);
  1052	  // sweep (d), a failed completion-event record in ~RetainUntilComplete (the call then used the synchronous fallback).
  1053	  unsigned long long event_query_failures = 0;
  1054	  unsigned long long event_record_failures = 0;
  1055	  // P1T-FIX6, round-6 review finding V6-03 (MINOR): synchronize()'s OWN drain failures (the current-device query, a
  1056	  // device's stream sync, a completion-event query, managers leaked for lack of a completion proof) lived only in a local
  1057	  // SyncReport; when building the RuntimeError's message threw bad_alloc, the caller saw MemoryError and the CUDA
  1058	  // failure was gone (a one-shot failure: the next synchronize() succeeded). They are now persisted here, with no
  1059	  // allocation, BEFORE any message is built, and cleared only once the RuntimeError carrying them exists (see
  1060	  // synchronize_and_release_all). `drain_unreported_calls` counts the synchronize() calls whose drain failed and has
  1061	  // not been raised yet (more than 1 only after a message allocation failed).
  1062	  SyncReport drain_unreported;
  1063	  unsigned long long drain_unreported_calls = 0;
  1064	  // P1T-FIX8, round-8 review finding V8-01 (MINOR): failed calls of the exit device wait's marker event (create, record,
  1065	  // query, destroy). FIX7 L1 consumed them with cudaGetLastError and recorded nothing. Each is now counted here AND
  1066	  // recorded through note_unraisable_failure (purpose kExitWaitMarker) before its slot entry is consumed.
  1067	  unsigned long long exit_marker_failures = 0;
  1068	  // P1T-FIX8 (V8-02, sweep (l)): a report synchronize() RAISED inside the exit runner (its records are cleared once the
  1069	  // RuntimeError exists) is kept here as a plain-data summary until the hook says it wrote it
  1070	  // (_exit_report_written); if the hook could not (MemoryError building the line, stderr None or raising, the hook
  1071	  // interrupted), the runner writes this summary with C stdio, allocation-free. Accumulates while unwritten.
  1072	  bool exit_report_unwritten = false;
  1073	  unsigned long long exit_report_count = 0;   // failures in the unwritten report(s), saturating
  1074	  bool exit_report_has_record = false;        // the first is a tagged record; else only the prior-slot error
  1075	  FailureRecord exit_report_first;
  1076	  cudaError_t exit_report_prior = cudaSuccess;
  1077	  unsigned long long exit_log_fallbacks = 0;  // exit log lines written by the allocation-free fallback
  1078	  std::unordered_map<int, DeviceEvents> event_pool;   // per device
  1079	};
