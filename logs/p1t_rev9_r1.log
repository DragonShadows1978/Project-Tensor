  1692	void core_exit_last_reader(bool hook_raised) noexcept {
  1693	  const char* head_tail = hook_raised ? "(logged by the exit runner: the exit hook did not finish)"
  1694	                                      : "(logged by the exit runner: the exit hook did not report it)";
