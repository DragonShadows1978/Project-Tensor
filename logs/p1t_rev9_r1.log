   149	// readers do not delay it; McKenney & Slingwine 1998) and the Linux percpu_ref "kill, then wait for zero"; the
   150	// store-buffering (Dekker, Dijkstra 1965) handshake for flag + counter admission; glibc/libstdc++ forced unwinding
   151	// (abi::__forced_unwind must be rethrown by a catch-all; a noexcept frame terminates). Ours: applying the protocol to the
   152	// add-on's deleter, capsule-drop and producer-callback sites. Unverified here (lead to check): "CPython 3.12
   153	// take_gil _PyThreadState_MustExit PyThread_exit_thread", "synchronize_rcu McKenney Slingwine 1998".
   154	namespace {
   155	
   156	enum LifecycleKind : int { kRelease = 0, kCallback = 1, kKinds = 2 };
   157	
   158	struct Lifecycle {
   159	  std::mutex mu;                           // only for the waiter's condition variable; admission never takes it
   160	  std::condition_variable cv;
   161	  std::atomic<bool> closing{false};
   162	  std::atomic<long long> in_flight[kKinds];
   163	  Lifecycle() {
   164	    for (auto& c : in_flight) c.store(0);
   165	  }
   166	};
   167	
   168	// Never destroyed (a callback may run during static destruction). Constructed at module import (init_pending_state).
   169	Lifecycle& lifecycle() {
   170	  static Lifecycle* s = new Lifecycle();
   171	  return *s;
   172	}
   173	
   174	// Admitted sections on THIS thread's stack, per kind (self-exclusion; also synchronize()'s skip rule).
   175	thread_local long long t_depth[kKinds] = {0, 0};
   176	
   177	// Static storage: counting never allocates.
   178	std::atomic<unsigned long long> g_admitted[kKinds];
   179	std::atomic<unsigned long long> g_deleters_leaked_after_close{0};   // V5-01: "a late release leaks, and is counted"
   180	std::atomic<unsigned long long> g_deleters_leaked_finalizing{0};
   181	std::atomic<unsigned long long> g_capsules_kept_after_close{0};
   182	std::atomic<unsigned long long> g_capsules_kept_finalizing{0};
   183	std::atomic<unsigned long long> g_callbacks_refused{0};
   184	std::atomic<unsigned long long> g_lifecycle_lock_failures{0};
   185	std::atomic<unsigned long long> g_exit_hook_calls{0};
   186	std::atomic<unsigned long long> g_exit_in_flight_at_close{0};
   187	std::atomic<unsigned long long> g_exit_wait_us{0};
   188	std::atomic<unsigned long long> g_exit_wait_diagnostics{0};
   189	std::atomic<unsigned long long> g_exit_wait_overruns{0};
   190	std::atomic<unsigned long long> g_exit_wait_poll_diagnostics{0};  // P1T-FIX7 L1: lines of the polling fallback
   191	// P1T-FIX6 (V6-01): FIX5's g_sync_waits / g_sync_wait_us / g_sync_wait_diagnostics counted synchronize()'s wait for
   192	// other threads; that wait is removed, and so are they (and their pending_stats keys).
   193	
   194	bool interpreter_accepts_python() noexcept {
   195	  if (!Py_IsInitialized()) return false;
   196	#if PY_VERSION_HEX >= 0x030D0000
   197	  if (Py_IsFinalizing()) return false;
   198	#else
   199	  if (_Py_IsFinalizing()) return false;
   200	#endif
   201	  return true;
   202	}
   203	
   204	enum class Admission { kAdmitted, kClosed, kFinalizing };
   205	
   206	void leave_count(Lifecycle& lc, LifecycleKind k) noexcept {
   207	  lc.in_flight[k].fetch_sub(1, std::memory_order_seq_cst);
   208	  // Take and drop the mutex before notifying: a waiter checks its predicate while holding it, so this leave either
   209	  // happened before that check (seen) or waits until the waiter blocks (then the notify wakes it). No lost wakeup.
   210	  try {
   211	    std::lock_guard<std::mutex> lk(lc.mu);
   212	  } catch (const std::system_error&) {
   213	    g_lifecycle_lock_failures.fetch_add(1, std::memory_order_relaxed);  // never observed; the waiter also polls
   214	  }
   215	  lc.cv.notify_all();
   216	}
   217	
   218	Admission admit(LifecycleKind k) noexcept {
   219	  if (!interpreter_accepts_python()) return Admission::kFinalizing;
   220	  Lifecycle& lc = lifecycle();
   221	  lc.in_flight[k].fetch_add(1, std::memory_order_seq_cst);
   222	  if (lc.closing.load(std::memory_order_seq_cst)) {
   223	    leave_count(lc, k);  // back out: admission closed
   224	    return Admission::kClosed;
   225	  }
   226	  ++t_depth[k];
   227	  g_admitted[k].fetch_add(1, std::memory_order_relaxed);
   228	  return Admission::kAdmitted;
   229	}
   230	
   231	void leave(LifecycleKind k) noexcept {
   232	  --t_depth[k];
   233	  leave_count(lifecycle(), k);
   234	}
   235	
   236	// RAII for the producer-callback section of to_capsule. Throws RuntimeError (before any callback) when refused.
   237	class CallbackSection {
   238	 public:
   239	  explicit CallbackSection(const char* role) {
   240	    const Admission a = admit(kCallback);
   241	    if (a == Admission::kAdmitted) return;
   242	    g_callbacks_refused.fetch_add(1, std::memory_order_relaxed);
   243	    throw std::runtime_error(std::string("tc_signal: operand '") + role + "': " +
   244	                             (a == Admission::kClosed
   245	                                  ? "interpreter exit has begun (tc_signal's exit hook closed admission)"
   246	                                  : "the interpreter is finalizing") +
   247	                             ", so the producer's __dlpack__ is not called; refused before acquiring anything");
   248	  }
   249	  ~CallbackSection() { leave(kCallback); }
   250	  CallbackSection(const CallbackSection&) = delete;
   251	  CallbackSection& operator=(const CallbackSection&) = delete;
   252	};
   253	
   254	struct WaitOutcome {
   255	  long long running_at_start = 0;  // admitted sections of OTHER threads when the wait began
   256	  long long own[kKinds] = {0, 0};  // this thread's own (excluded)
   257	  long long waited_us = 0;
   258	  unsigned long long diagnostics = 0;
   259	  bool overran = false;            // outlasted the first-diagnostic delay
   260	};
   261	
   262	// Admitted sections (releases and producer callbacks) of OTHER threads: the calling thread's own are excluded.
   263	long long others_running(const Lifecycle& lc, const long long own[kKinds]) noexcept {
   264	  return lc.in_flight[kRelease].load(std::memory_order_seq_cst) - own[kRelease] +
   265	         lc.in_flight[kCallback].load(std::memory_order_seq_cst) - own[kCallback];
   266	}
   267	
   268	// The part of the exit wait that runs with the GIL released: the mutex and condition variable only, no Python object.
   269	// P1T-FIX7, lead send-back L1 (sweep (i) addendum): FIX5's fallback for a failed lifecycle mutex / condition variable
   270	// (poll every kLifecyclePollMs until quiet) was a SILENT exit wait. It now keeps the same diagnostic schedule as the
   271	// condition-variable wait (FIX3 V3-01 / FIX5 V5-01: the first line after first_diag_s from the start of the wait, then
   272	// each time the time waited has doubled; C stdio, no allocation, GIL released), says that it is polling and why, and
   273	// counts each line (w.diagnostics -> pending_stats() exit_wait_diagnostics for the hook's close, and
   274	// exit_wait_poll_diagnostics for every polling line). It still never returns early. Prior art: FIX3 / FIX5's own
   275	// schedule (taken as is); ours: applying it to the fallback.
   276	void wait_without_gil(Lifecycle& lc, double first_diag_s, std::chrono::steady_clock::time_point t0,
   277	                      WaitOutcome& w) noexcept {
   278	  using clock = std::chrono::steady_clock;
   279	  const auto first = std::chrono::duration_cast<clock::duration>(std::chrono::duration<double>(first_diag_s));
   280	  const auto tick = clock::duration(1);  // next line at least one clock tick later: no busy loop at a zero delay
   281	  auto quiet = [&lc, &w] { return others_running(lc, w.own) <= 0; };
   282	  auto next = t0 + first;
   283	  try {
   284	    std::unique_lock<std::mutex> lk(lc.mu);
   285	    while (!lc.cv.wait_until(lk, next, quiet)) {
   286	      // Still running at the diagnostic time: report, then keep waiting (never return early: V3-01, V5-01).
   287	      w.overran = true;
   288	      const long long running = others_running(lc, w.own);
   289	      lk.unlock();  // a blocked stderr must not stop a callback from leaving
   290	      const auto now = clock::now();
   291	      std::fprintf(stderr,
   292	                   "tc_signal: %lld DLPack producer callback(s) (deleter, capsule destructor or __dlpack__) admitted "
   293	                   "on other threads before interpreter exit still running after %.1f s; interpreter exit waits for "
   294	                   "them (no new one is admitted)\n",
   295	                   running, std::chrono::duration<double>(now - t0).count());
   296	      std::fflush(stderr);
   297	      ++w.diagnostics;
   298	      const auto waited = now - t0;  // next line when the time waited has doubled
   299	      next = now + (waited > tick ? waited : tick);
   300	      lk.lock();
   301	    }
   302	    return;
   303	  } catch (const std::system_error&) {
   304	    // A mutex / condition-variable failure (never observed): keep waiting by polling, never return early.
   305	    g_lifecycle_lock_failures.fetch_add(1, std::memory_order_relaxed);
   306	  }
   307	  while (!quiet()) {
   308	    const auto now = clock::now();
   309	    if (now >= next) {  // the same schedule as above, continued from where it was: never a silent wait
   310	      w.overran = true;
   311	      std::fprintf(stderr,
   312	                   "tc_signal: %lld DLPack producer callback(s) (deleter, capsule destructor or __dlpack__) admitted "
   313	                   "on other threads before interpreter exit still running after %.1f s; interpreter exit waits for "
   314	                   "them (no new one is admitted; polling every %d ms because the lifecycle mutex or condition "
   315	                   "variable failed)\n",
   316	                   others_running(lc, w.own), std::chrono::duration<double>(now - t0).count(),
   317	                   tuning::kLifecyclePollMs);
   318	      std::fflush(stderr);
   319	      ++w.diagnostics;
   320	      g_exit_wait_poll_diagnostics.fetch_add(1, std::memory_order_relaxed);
   321	      const auto waited = now - t0;
   322	      next = now + (waited > tick ? waited : tick);
   323	    }
   324	    std::this_thread::sleep_for(std::chrono::milliseconds(tuning::kLifecyclePollMs));
   325	  }
   326	}
   327	
   328	// The exit hook's wait (P1T-FIX6: its only caller; ordinary calls never wait for another thread, V6-01): until no
   329	// admitted section of another thread is running. The GIL is released for the wait and re-taken explicitly here (see
   330	// the design block above for why not by a destructor).
   331	WaitOutcome wait_for_other_threads(double first_diag_s) {
   332	  Lifecycle& lc = lifecycle();
   333	  WaitOutcome w;
   334	  w.own[kRelease] = t_depth[kRelease];
   335	  w.own[kCallback] = t_depth[kCallback];
   336	  w.running_at_start = others_running(lc, w.own);
   337	  if (w.running_at_start <= 0) return w;  // nothing to wait for: the GIL is not touched
   338	  if (!(first_diag_s >= 0.0)) first_diag_s = 0.0;   // NaN or negative: diagnose at once (the wait is the same)
   339	  if (first_diag_s > tuning::kLifecycleMaxDiagDelayS) first_diag_s = tuning::kLifecycleMaxDiagDelayS;
   340	  const auto t0 = std::chrono::steady_clock::now();
   341	  const bool held = PyGILState_Check() != 0;
   342	  PyThreadState* ts = held ? PyEval_SaveThread() : nullptr;  // GIL released: an admitted callback can finish
   343	  wait_without_gil(lc, first_diag_s, t0, w);
   344	  if (held) PyEval_RestoreThread(ts);  // the mutex is not held here; may exit a daemon thread during finalization
   345	  w.waited_us = std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - t0).count();
   346	  return w;
   347	}
