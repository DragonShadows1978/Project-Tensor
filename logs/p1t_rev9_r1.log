   442	void dlpack_ack_unraisable(unsigned long long count) noexcept {
   443	  auto consume = [count] {
   444	    unsigned long long cur = g_core_unraisable_unreported.load();
   445	    while (!g_core_unraisable_unreported.compare_exchange_weak(cur, cur > count ? cur - count : 0ULL)) {
   446	    }
   447	  };
   448	  try {
   449	    CoreUnraisableRecord& r = core_unraisable_record();
   450	    std::lock_guard<std::mutex> lk(r.mu);
   451	    consume();
   452	    // The named one was just raised; a failure recorded since the snapshot stays counted, unnamed.
   453	    r.unreported_what = nullptr;
   454	    r.unreported_device = -1;
   455	    r.unreported_error = 0;
   456	  } catch (const std::exception&) {
   457	    consume();  // a mutex failure (never observed): consume the count; a stale name is only a label
   458	  }
   459	}
