  1736	// P1T-FIX4 (cuda_guard.h rule 2): a restore of the caller's device that failed where nothing can raise.
  1737	void note_unraisable_device_restore_failure(int device, cudaError_t err) noexcept {
  1738	  PendingState& st = pending();
