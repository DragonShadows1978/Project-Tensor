   689	int common_device(const std::vector<const Operand*>& ops) {
   690	  int dev = -1;
   691	  const char* first = "";
   692	  for (const Operand* op : ops) {
   693	    if (op == nullptr || !op->present()) continue;
   694	    if (dev < 0) {
   695	      dev = op->device();
   696	      first = op->role();
   697	    } else if (op->device() != dev) {
   698	      std::ostringstream os;
   699	      os << "on CUDA device " << op->device() << " but operand '" << first << "' is on CUDA device " << dev
   700	         << "; every operand must be on the same device";
   701	      refuse_value(op->role(), os.str());
   702	    }
   703	  }
   704	  return dev;
   705	}
   706	
   707	void expect_disjoint(const Operand& written, const Operand& other) {
   708	  if (!written.present() || !other.present()) return;
   709	  if (written.byte_begin() < other.byte_end() && other.byte_begin() < written.byte_end())
   710	    refuse_value(written.role(), std::string("its memory overlaps operand '") + other.role() +
   711	                                     "'; the written operand must not alias any other operand");
   712	}
   713	
   714	// ------------------------------------------------------------------------------------------------ deferred release (F01)
   715	// Design and prior art: dlpack_operand.h, RetainUntilComplete. Every function here runs on the calling host thread with
   716	// the GIL held (every _tc_signal entry point is a pybind11 function that keeps the GIL), so the pending list needs no
   717	// lock. Deleters may run Python (a ctypes producer) and may even re-enter tc_signal; therefore an entry is always taken
   718	// OFF the list before its deleters run, and nothing holds a reference into the list across a deleter call.
   719	//
   720	// P1T-FIX2 (round-2 review N1, N3) changed the release paths as follows:
   721	//  * N3, no allocation failure terminates. The noexcept functions here (drain_completed, the RetainUntilComplete
   722	//    destructor, sync_and_release_all_impl, recycle_event) no longer allocate, except the pending-list push in the
   723	//    destructor, which is caught and falls back to a synchronous release (counted). sync_and_release_all_impl works on
   724	//    the live list in place (phase 1 synchronizes the devices into a fixed-capacity set, phase 2 pops completed
   725	//    entries), instead of a take-all std::deque swap and a std::set / std::vector of devices, which allocated inside a
   726	//    noexcept function (libstdc++'s deque allocates even when default-constructed: the round-2 probe oom_sync, rc -6).
   727	//    The recycle slot of every completion event is reserved when the event is created (constructor path, before any
   728	//    launch), so recycling never allocates. The owner vector is reserved in the constructor, as before.
   729	//  * N1, no CUDA error is reported as success: a failed current-device query (cudaGetDevice) is now an error of
   730	//    synchronize() (it used to be skipped, so an empty list "synchronized" successfully on a machine with no usable
   731	//    device: probe empty_sync); a stream sync that fails is an error; and a release-path failure that happens where
   732	//    nothing can raise (the fallback sync and the bound drain inside the destructor) is recorded and raised by the next
   733	//    synchronize() (once), and logged by the atexit hook.
   734	// Prior art for the in-place two-phase drain: PyTorch's CUDA caching allocator processes its event list in place from
   735	// the host (process_events: query each recorded event, stop at the first one not ready). Taken: query-and-pop in FIFO
   736	// order. Ours: the sync-then-pop split with the per-device failure set, and leak-instead-of-release for entries whose
   737	// device could not be synchronized. Fixed-capacity, allocation-free bookkeeping on failure paths is ordinary
   738	// "no allocation on the error path" practice (e.g. the C++ Core Guidelines E.16 discussion); no specific prior art
   739	// claimed for the set itself.
   740	namespace test_hooks {
   741	namespace {
   742	std::atomic<unsigned> g_armed{0};
   743	}  // namespace
   744	void arm(unsigned bits) noexcept { g_armed.fetch_or(bits, std::memory_order_relaxed); }
   745	void clear() noexcept { g_armed.store(0, std::memory_order_relaxed); }
   746	unsigned armed() noexcept { return g_armed.load(std::memory_order_relaxed); }
   747	bool take(unsigned bit) noexcept {
   748	  if ((g_armed.load(std::memory_order_relaxed) & bit) == 0) return false;  // the production path: one relaxed load
   749	  return (g_armed.fetch_and(~bit, std::memory_order_relaxed) & bit) != 0;
   750	}
   751	}  // namespace test_hooks
   752	
   753	namespace {
   754	
   755	// TEST HOOK: the CUDA error an armed kCuda* site reports instead of calling CUDA (tests only; never in production).
   756	constexpr cudaError_t kTestInjectedCudaError = cudaErrorLaunchFailure;
   757	
   758	// Saturating counters (V6-03: recording never wraps, never allocates, never throws).
   759	void sat_inc(unsigned long long& c) noexcept {
   760	  if (c != ~0ULL) ++c;
   761	}
   762	void sat_add(unsigned long long& c, unsigned long long v) noexcept { c = (v > ~0ULL - c) ? ~0ULL : c + v; }
   763	
   764	// ------------------------------------------------------------------------------------------------ failure records (V7-02)
   765	// P1T-FIX7, round-7 review finding V7-02 (MINOR), and the sweep (j) "error attribution" of this file. FIX2-FIX6 kept a
   766	// recorded CUDA failure as (device, cudaError_t) only, so the message had to assume which call had failed: phase 2's
   767	// failed cudaEventQuery went into the same arrays as phase 1's stream syncs, and synchronize() then said "the legacy
   768	// stream of device 0 could not be synchronized" (that sync had succeeded; reviewer probe query_diagnostic_cpu.py rc 1
   769	// on 429446d). The sweep found the same assumption at four more sites: a failed switch (cudaSetDevice) or
   770	// current-device read (cudaGetDevice) inside a device guard was reported as the stream sync, event record or event
   771	// destroy it prevented; the spill path named "device -1"; and the bound drain paired the first failed device with the
   772	// current-device query's error. Now every record carries WHICH CUDA call failed and FOR WHAT, with the device that call
   773	// concerned and its error: a plain-data tag of two bytes, so recording stays a copy of a few words (allocation-free,
   774	// noexcept, saturating: V6-03) and `merge` keeps the tags. Every message is built from the tag (describe() below): it
   775	// names the failed CUDA call and its device, and never an operation that succeeded.
   776	// Prior art: std::error_code (C++11 <system_error>), which pairs an error value with its category so the same number
   777	// is never read in the wrong domain (taken: value + discriminating tag); tagged / discriminated records in general; the
   778	// distinct return contracts of cudaEventQuery and cudaStreamSynchronize (CUDA 12.6 Runtime API: why they must not share
   779	// one meaning). Ours: the (call, purpose) tag on the add-on's fixed-capacity, allocation-free failure records.
   780	enum class FailedCall : unsigned char {
   781	  kGetDevice,     // cudaGetDevice
   782	  kSetDevice,     // cudaSetDevice
   783	  kStreamSync,    // cudaStreamSynchronize(cudaStreamLegacy)
   784	  kEventQuery,    // cudaEventQuery
   785	  kEventRecord,   // cudaEventRecord(event, cudaStreamLegacy)
   786	  kEventDestroy,  // cudaEventDestroy
   787	  kEventCreate,   // cudaEventCreateWithFlags (P1T-FIX8: the exit device wait's marker event)
   788	};
   789	enum class Purpose : unsigned char {
   790	  kCurrentDevice,    // synchronize()'s current-device query (it reads which device is current: no device)
   791	  kSyncStream,       // synchronizing the legacy stream of `device` (the guard's read / switch, or the sync itself)
   792	  kSyncUntracked,    // the same, for a device beyond the kSyncMaxDevices tracked one by one (the spill path)
   793	  kQueryEvent,       // querying a pending entry's completion event (an event of `device`) in a sync drain
   794	  kDrainQueryEvent,  // the same query in the next-call drain (the entry stayed pending; synchronize() re-queries it)
   795	  kRecordEvent,      // recording a call's completion event on `device`'s legacy stream (the call then synchronized)
   796	  kDestroyEvent,     // destroying a completion event of `device` that could not be pooled
   797	  kRestoreDevice,    // restoring the caller's current device `device` after a switch
   798	  kUnnamed,          // never built from a real failure: failed() with no named record (capacity exhausted)
   799	  kExitWaitMarker,   // P1T-FIX8 (V8-01): the marker event of the diagnosed device wait at interpreter exit (L1, a3)
   800	  kCreateEvent,      // P1T-FIX8 (sweep (k)): creating a call's completion event, when its RuntimeError could not be built
   801	};
   802	struct FailureRecord {
   803	  FailedCall call = FailedCall::kStreamSync;
   804	  Purpose purpose = Purpose::kUnnamed;
   805	  int device = -1;  // the device the failed call concerned; -1 only for kCurrentDevice / kUnnamed
   806	  cudaError_t err = cudaSuccess;
   807	};
   808	
   809	const char* call_name(FailedCall c) noexcept {
   810	  switch (c) {
   811	    case FailedCall::kGetDevice: return "cudaGetDevice";
   812	    case FailedCall::kSetDevice: return "cudaSetDevice";
   813	    case FailedCall::kStreamSync: return "cudaStreamSynchronize";
   814	    case FailedCall::kEventQuery: return "cudaEventQuery";
   815	    case FailedCall::kEventRecord: return "cudaEventRecord";
   816	    case FailedCall::kEventDestroy: return "cudaEventDestroy";
   817	    case FailedCall::kEventCreate: return "cudaEventCreateWithFlags";
   818	  }
   819	  return "a CUDA call";
   820	}
   821	
   822	// P1T-FIX8 (V8-02, sweep (l)): what a record was FOR, as a static string, for the allocation-free fallback line of the
   823	// exit loggers (no std::string, no ostream: only static texts, cudaGetErrorName's static name and C stdio).
   824	const char* purpose_name(Purpose p) noexcept {
   825	  switch (p) {
   826	    case Purpose::kCurrentDevice: return "synchronize()'s current-device query";
   827	    case Purpose::kSyncStream: return "synchronizing a device's legacy stream";
   828	    case Purpose::kSyncUntracked: return "synchronizing the legacy stream of an untracked device";
   829	    case Purpose::kQueryEvent: return "querying a pending entry's completion event";
   830	    case Purpose::kDrainQueryEvent: return "querying a pending entry's completion event in the next-call drain";
   831	    case Purpose::kRecordEvent: return "recording a call's completion event";
   832	    case Purpose::kDestroyEvent: return "destroying a completion event";
   833	    case Purpose::kRestoreDevice: return "restoring the caller's CUDA device";
   834	    case Purpose::kUnnamed: return "an unnamed CUDA failure";
   835	    case Purpose::kExitWaitMarker: return "the marker event of interpreter exit's diagnosed device wait";
   836	    case Purpose::kCreateEvent: return "creating a call's completion event";
   837	  }
   838	  return "a CUDA call";
   839	}
   840	
   841	// The message text of one record (only ever called while building a diagnostic, where allocating is allowed). A device
   842	// guard's own failure (its cudaGetDevice, or its cudaSetDevice to the target) means the intended call never ran: the
   843	// text says so and names the guard's call.
   844	void describe(std::ostream& os, const FailureRecord& r) {
   845	  const auto error = [&os, &r] { os << cudaGetErrorName(r.err) << ": " << cudaGetErrorString(r.err); };
   846	  const bool guard_call = r.call == FailedCall::kGetDevice || r.call == FailedCall::kSetDevice;
   847	  switch (r.purpose) {
   848	    case Purpose::kCurrentDevice:
   849	      os << "the current-device query cudaGetDevice failed (";
   850	      error();
  1490	    st.bytes = (__builtin_sub_overflow(st.bytes, e.bytes, &rest) || rest < 0) ? 0 : rest;
  1491	  }
  1492	  st.managers -= static_cast<long long>(e.owners.size());
  1493	}
  1494	
  1495	// V3-02: the bound comparison after a push. Exact below INT64_MAX (a total of exactly kPendingMaxBytes is within the
  1496	// bound, one byte more is over it, as before); a saturated total is over it.
  1497	bool pending_over_bound(const PendingState& st) noexcept {
  1498	  return static_cast<long long>(st.q.size()) > tuning::kPendingMaxEntries || st.bytes_saturated ||
  1499	         st.bytes > tuning::kPendingMaxBytes;
  1500	}
  1501	
  1502	// Runs the entry's deleters (they may run Python and re-enter tc_signal; the entry is already off the list). A throwing
  1503	// deleter is contained in ManagedOwner::reset (N4) and the loop goes on with the remaining managers.
  1504	void release_entry(PendingState& st, PendingEntry& e) noexcept {
  1505	  recycle_event(st, e.device, e.event);
  1506	  e.event = nullptr;
  1507	  ++st.released_entries;
  1508	  st.released_managers += e.owners.size();
  1509	  for (ManagedOwner& o : e.owners) o.reset();
  1510	}
  1511	
  1512	// Returns the number of managers leaked.
  1513	unsigned long long leak_entry(PendingState& st, PendingEntry& e) noexcept {
  1514	  unsigned long long n = 0;
  1515	  for (ManagedOwner& o : e.owners) {
  1516	    if (!o.empty()) ++n;
  1517	    o.leak();
  1518	  }
  1519	  st.leaked_managers += n;
  1520	  // The event is not recycled either: it may belong to a broken context.
  1521	  e.event = nullptr;
  1522	  return n;
  1523	}
  1524	
  1525	// Phase 1: synchronize the legacy stream of the current device and of every device with pending entries (no deleter
  1526	// runs, so iterating the live list is safe). Phase 2: pop entries in FIFO order and release each one whose event has
  1527	// completed; leak (counted) an entry with no completion proof whose device could not be synchronized or whose event
  1528	// query failed; stop at the first entry that is merely not ready on a device that DID synchronize: it was pushed after
  1529	// phase 1 by a re-entrant call (a deleter that calls tc_signal) and is left pending. Every entry is popped before its
  1530	// deleters run, so a re-entrant drain or bound drain pops each entry at most once. No allocation, never throws.
  1531	SyncReport sync_and_release_all_impl() noexcept {
  1532	  PendingState& st = pending();
  1533	  SyncReport rep;
  1534	  DeviceSyncSet set;
  1535	  int cur = -1;
  1536	  // TEST HOOK kCudaCurrentDevice (P1T-FIX6 V6-03 regression): report a one-shot failure instead of calling CUDA.
  1537	  const cudaError_t qe =
  1538	      test_hooks::take(test_hooks::kCudaCurrentDevice) ? kTestInjectedCudaError : cudaGetDevice(&cur);
  1539	  if (qe != cudaSuccess) {
  1540	    rep.query_failed = true;  // N1: was silently skipped (synchronize() then "succeeded" with no device)
  1541	    rep.query_error = qe;
  1542	    cudaGetLastError();       // P1T-FIX8 (sweep (k)): consumed after it is recorded
  1543	  } else {
  1544	    set.sync(cur);
  1545	  }
  1546	  for (const PendingEntry& e : st.q) set.sync(e.device);
  1547	  // P1T-FIX7 (V7-02): each phase-1 failure is recorded with the call that failed (the guard's cudaGetDevice /
  1548	  // cudaSetDevice, or cudaStreamSynchronize) and its device; the spill keeps its own device (FIX6: "device -1").
  1549	  for (int i = 0; i < set.n; ++i)
  1550	    if (set.res[i].err != cudaSuccess)
  1551	      rep.add({set.res[i].call, Purpose::kSyncStream, set.dev[i], set.res[i].err});
  1552	  if (set.spill_failed) rep.add(set.spill);
  1553	
  1554	  while (!st.q.empty()) {
  1555	    // TEST HOOK kCudaEventQuery (P1T-FIX6 V6-03 regression): a one-shot query failure instead of calling CUDA.
  1556	    const cudaError_t r = test_hooks::take(test_hooks::kCudaEventQuery) ? kTestInjectedCudaError
  1557	                                                                          : cudaEventQuery(st.q.front().event);
  1558	    const int dev = st.q.front().device;
  1559	    const bool complete = (r == cudaSuccess);
