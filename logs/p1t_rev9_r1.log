    50	
    51	// Checks a capsule's name and returns its kind (true = versioned). Consumed and foreign capsules are refused.
    52	bool capsule_kind(py::handle cap, const char* role) {
    53	  const std::string n = capsule_name(cap);
    54	  if (n == kCapsuleVersioned) return true;
    55	  if (n == kCapsule) return false;
    56	  if (n == kUsedCapsule || n == kUsedCapsuleVersioned)
    57	    refuse_value(role, "the DLPack capsule was already consumed (name '" + n + "'); a capsule can be consumed once");
    58	  refuse_type(role, "a capsule named '" + n + "' is not a DLPack capsule ('dltensor' or 'dltensor_versioned')");
    59	}
