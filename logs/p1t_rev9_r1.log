   275	LstmCublasConfig lstm_cublas_config(int device) {
   276	  DeviceGuard guard(device);
   277	  cublasHandle_t h = lstm_handle_for(device);
   278	  cublasMath_t math;
   279	  cublasAtomicsMode_t atomics;
   280	  cublasPointerMode_t pmode;
   281	  cudaStream_t s;
   282	  check_cublas_on(cublasGetMathMode(h, &math), "cublasGetMathMode", device);
   283	  check_cublas_on(cublasGetAtomicsMode(h, &atomics), "cublasGetAtomicsMode", device);
   284	  check_cublas_on(cublasGetPointerMode(h, &pmode), "cublasGetPointerMode", device);
   285	  check_cublas_on(cublasGetStream(h, &s), "cublasGetStream", device);
   286	  LstmCublasConfig c;
   287	  c.math_mode = static_cast<int>(math);
   288	  c.atomics_mode = static_cast<int>(atomics);
   289	  c.pointer_mode = static_cast<int>(pmode);
   290	  c.legacy_stream = (s == kLegacyStream);
   291	  c.default_math = (math == CUBLAS_DEFAULT_MATH);
   292	  c.atomics_not_allowed = (atomics == CUBLAS_ATOMICS_NOT_ALLOWED);
   293	  guard.restore();  // P1T-FIX4
   294	  return c;
   295	}
