    90	// only device memory tc_signal causes to be allocated outside the caller's allocator (README "cuBLAS").
    91	cublasHandle_t handle_for(int device) {
    92	  static std::unordered_map<int, cublasHandle_t> handles;
    93	  auto it = handles.find(device);
    94	  if (it != handles.end()) return it->second;
    95	  cublasHandle_t h = nullptr;
    96	  check_cublas_on(cublasCreate(&h), "cublasCreate", device);
    97	  // P1T-FIX5, round-5 review finding V5-03 (MINOR): FIX4 destroyed the new handle when a SETTING failed, but the handle
    98	  // had no owner through the cache insertion below: when handles.emplace threw (std::bad_alloc for the map node) the
    99	  // handle leaked, with its device resources (review probe handle_insert_oom_cpu.cpp: creates 1, destroys 0). Now `owned`
   100	  // owns it from creation until the insertion commits: on ANY exception before the commit its destructor destroys the
   101	  // handle, checks the destroy's status and, never throwing while the exception propagates, counts a failure
   102	  // (note_cublas_handle_destroy_failure). A failed setting still destroys it explicitly first and names that destroy's
   103	  // status in the raise (FIX4), clearing `h` so the owner does not destroy it twice. Nothing is cached on failure, so
   104	  // the next call starts again from cublasCreate.
   105	  // Prior art: RAII (Stroustrup) and the scope guard with dismissal on commit (Alexandrescu & Marginean, "Generic: Change
   106	  // the Way You Write Exception-Safe Code - Forever", C/C++ Users Journal, 2000; std::unique_ptr with a custom deleter
   107	  // is the library form). Taken: own until commit, release on unwinding. Ours: checking and counting the cleanup status.
   108	  struct NewHandleOwner {
   109	    cublasHandle_t& h;
   110	    ~NewHandleOwner() {
   111	      if (h == nullptr) return;  // committed to the cache, or already destroyed by settle
   112	      const cublasStatus_t ds = cublasDestroy(h);
   113	      if (ds != CUBLAS_STATUS_SUCCESS) note_cublas_handle_destroy_failure(static_cast<int>(ds));
   114	    }
   115	  } owned{h};
   116	  // P1T-FIX4 (sweep): a setting that fails no longer leaks the new handle: it is destroyed (on this device, which the
   117	  // caller's DeviceGuard keeps current), the destroy's own status is checked and named, and the call raises. Nothing is
   118	  // cached, so the next call retries from cublasCreate.
   119	  auto settle = [&h, device](cublasStatus_t st, const char* what) {
   120	    if (st == CUBLAS_STATUS_SUCCESS) return;
   121	    const cublasStatus_t ds = cublasDestroy(h);
   122	    h = nullptr;  // P1T-FIX5: destroyed here; the owner must not destroy it again
   123	    std::ostringstream os;
   124	    os << "tc_signal: " << what << " failed: cuBLAS status " << static_cast<int>(st) << " (the new handle of CUDA device "
   125	       << device << ")";  // P1T-FIX7 (sweep (j)): the device named
   126	    if (ds != CUBLAS_STATUS_SUCCESS) os << "; destroying the new handle also failed: cuBLAS status " << static_cast<int>(ds);
   127	    throw std::runtime_error(os.str());
   128	  };
   129	  settle(cublasSetStream(h, kLegacyStream), "cublasSetStream(0)");
   130	  settle(cublasSetMathMode(h, CUBLAS_DEFAULT_MATH), "cublasSetMathMode(CUBLAS_DEFAULT_MATH)");
   131	  settle(cublasSetAtomicsMode(h, CUBLAS_ATOMICS_NOT_ALLOWED), "cublasSetAtomicsMode(NOT_ALLOWED)");
   132	  settle(cublasSetPointerMode(h, CUBLAS_POINTER_MODE_HOST), "cublasSetPointerMode(HOST)");
   133	  handles.emplace(device, h);  // may throw (host allocation): `owned` destroys h, nothing is cached
   134	  const cublasHandle_t cached = h;
   135	  h = nullptr;  // committed: the cache owns the handle now
   136	  return cached;
   137	}
   138	
   139	// ------------------------------------------------------------------------------------------------ kernels
   140	// 1-D im2col for one batch element (Chellapilla et al. 2006, 1-D with dilation and asymmetric zero padding):
   141	//   col[(c*K + k), t] = x[c, t*stride - pad_begin + k*dilation]   (0 outside [0, T))
   142	// Rows (c, k) are c-major, so group g's rows [g*Cg*K, (g+1)*Cg*K) form one contiguous [Cg*K, T_out] block that
   143	// matches w[g*Og:(g+1)*Og] viewed as [Og, Cg*K].
   144	__global__ void im2col1d_kernel(const float* __restrict__ x, float* __restrict__ col, int64_t C, int64_t T, int64_t K,
   145	                                int64_t T_out, int64_t stride, int64_t pad_begin, int64_t dilation) {
   146	  const int64_t total = C * K * T_out;
   147	  for (int64_t i = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; i < total;
   148	       i += static_cast<int64_t>(gridDim.x) * blockDim.x) {
   149	    const int64_t t = i % T_out;
   150	    const int64_t r = i / T_out;
   151	    const int64_t k = r % K;
   152	    const int64_t c = r / K;
   153	    const int64_t src = t * stride - pad_begin + k * dilation;
   154	    col[i] = (src >= 0 && src < T) ? x[c * T + src] : 0.0f;
   155	  }
   156	}
   157	
   158	// y[n, o, t] += b[o], one thread per output element (fp32 add, one rounding).
   159	__global__ void bias_add_kernel(float* __restrict__ y, const float* __restrict__ b, int64_t C_out, int64_t T_out,
   160	                                int64_t total) {
   161	  for (int64_t i = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; i < total;
   162	       i += static_cast<int64_t>(gridDim.x) * blockDim.x) {
   163	    const int64_t o = (i / T_out) % C_out;
   164	    y[i] = y[i] + b[o];
   165	  }
   165	  }
   166	}
   167	
   168	// Gather-form ConvTranspose1d (adjoint of strided conv, Dumoulin & Visin 2016), one thread per output element:
   169	//   y[n, o, t] = b[o] + sum_{k=0..K-1} sum_{c in group(o)} w[c, o - g*Og, k] * x[n, c, (t + pb - k*dilation)/stride]
   170	// over the taps with (t + pb - k*dilation) >= 0, divisible by stride, and quotient < T. Fixed order: k ascending
   171	// (outer), c ascending within the group (inner), fp32 fmaf accumulation from 0, bias added last. No atomics.
   172	__global__ void conv_transpose1d_gather_kernel(const float* __restrict__ x, const float* __restrict__ w,
   173	                                               const float* __restrict__ b, float* __restrict__ y, int64_t N,
   174	                                               int64_t C_in, int64_t T, int64_t C_out, int64_t K, int64_t T_out,
   175	                                               int64_t stride, int64_t pad_begin, int64_t dilation, int64_t groups) {
   176	  const int64_t Cg = C_in / groups;
   177	  const int64_t Og = C_out / groups;
   178	  const int64_t total = N * C_out * T_out;
   179	  for (int64_t i = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; i < total;
   180	       i += static_cast<int64_t>(gridDim.x) * blockDim.x) {
   181	    const int64_t t = i % T_out;
   182	    const int64_t r = i / T_out;
   183	    const int64_t o = r % C_out;
   184	    const int64_t n = r / C_out;
   185	    const int64_t g = o / Og;
   186	    const int64_t ol = o - g * Og;
   187	    const float* xg = x + (n * C_in + g * Cg) * T;   // x[n, g*Cg + cl, :] = xg[cl*T + :]
   188	    const float* wg = w + (g * Cg * Og + ol) * K;    // w[g*Cg + cl, ol, k] = wg[cl*Og*K + k]
   189	    float acc = 0.0f;
   190	    for (int64_t k = 0; k < K; ++k) {
   191	      const int64_t s = t + pad_begin - k * dilation;
   192	      if (s < 0 || s % stride != 0) continue;
   193	      const int64_t q = s / stride;
   194	      if (q >= T) continue;
   195	      const float* xp = xg + q;
   196	      const float* wp = wg + k;
   197	      for (int64_t cl = 0; cl < Cg; ++cl) acc = fmaf(wp[cl * Og * K], xp[cl * T], acc);
   198	    }
   199	    if (b != nullptr) acc = acc + b[o];
   200	    y[i] = acc;
   201	  }
   202	}
   203	
   204	// Fast-math canary: out[i] = x[i] / y[i] in fp32. Built with this TU's flags, so --use_fast_math (-ftz=1,
   205	// -prec_div=0) shows up as flushed subnormals or non-IEEE quotients, which the tests compare bitwise against the host's
   206	// IEEE fp32 division. Prior art: no specific source known to me (it is the usual "test the build flags by their
   207	// observable effect" idea; denormal flushing as a fast-math symptom is documented in the CUDA C Programming Guide).
   208	__global__ void fp32_divide_probe_kernel(const float* __restrict__ x, const float* __restrict__ y,
   209	                                         float* __restrict__ out, int64_t n) {
   210	  for (int64_t i = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; i < n;
   211	       i += static_cast<int64_t>(gridDim.x) * blockDim.x)
   212	    out[i] = x[i] / y[i];
   213	}
   214	
   215	}  // namespace
   216	
   217	void fp32_divide_probe(int device, const float* x, const float* y, float* out, int64_t n) {
   218	  DeviceGuard guard(device);
   219	  fp32_divide_probe_kernel<<<grid_for(n, tuning::kProbeBlock), tuning::kProbeBlock, 0, kLegacyStream>>>(x, y, out, n);
   220	  check_launch_on(kPrefix, "fp32_divide_probe_kernel", device);
   221	  guard.restore();  // P1T-FIX4: success-path restore is checked (raises on failure)
   222	}
   223	
   224	// ------------------------------------------------------------------------------------------------ Conv1d
   225	void conv1d_forward(int device, const Conv1dGeom& g, const float* x, const float* w, const float* b, float* y,
   226	                    float* col) {
   227	  DeviceGuard guard(device);
   228	  cublasHandle_t h = handle_for(device);
   229	  const int64_t Cg = g.C_in / g.groups;
   230	  const int64_t Og = g.C_out / g.groups;
   231	  const int64_t CgK = Cg * g.K;
   232	  const float alpha = 1.0f;
   233	  const float beta = 0.0f;
   234	  for (int64_t n = 0; n < g.N; ++n) {
   235	    const float* xn = x + n * g.C_in * g.T;
   236	    const float* A = nullptr;   // the [Cg*K, T_out] row-major operand of group 0 for this batch element
   237	    long long strideA = 0;
   238	    if (g.direct) {
   239	      // K == 1, stride 1, no pads: x[n] itself is the col matrix (T_out == T), no scratch.
   240	      A = xn;
   241	      strideA = static_cast<long long>(Cg * g.T);
   242	    } else {
   243	      // The scratch is reused for every n: the next im2col is queued after this n's GEMM on the same stream.
   244	      const int64_t total = g.C_in * g.K * g.T_out;
   245	      im2col1d_kernel<<<grid_for(total, tuning::kIm2colBlock), tuning::kIm2colBlock, 0, kLegacyStream>>>(
   246	          xn, col, g.C_in, g.T, g.K, g.T_out, g.stride, g.pad_begin, g.dilation);
   247	      check_launch_on(kPrefix, "im2col1d_kernel", device);
   248	      A = col;
   249	      strideA = static_cast<long long>(CgK * g.T_out);
   250	    }
   251	    float* yn = y + n * g.C_out * g.T_out;
   252	    // Row-major Y_g[Og, T_out] = W_g[Og, CgK] . Col_g[CgK, T_out], computed as the column-major product
   253	    // Y_g^T[T_out, Og] = Col_g^T[T_out, CgK] . W_g^T[CgK, Og]: m = T_out, n = Og, k = CgK, both ops N,
   254	    // lda = T_out (col), ldb = CgK (w), ldc = T_out (y); one batch entry per group.
   255	    check_cublas_on(cublasSgemmStridedBatched(h, CUBLAS_OP_N, CUBLAS_OP_N, static_cast<int>(g.T_out),
   256	                                           static_cast<int>(Og), static_cast<int>(CgK), &alpha, A,
   257	                                           static_cast<int>(g.T_out), strideA, w, static_cast<int>(CgK),
   258	                                           static_cast<long long>(Og * CgK), &beta, yn, static_cast<int>(g.T_out),
   259	                                           static_cast<long long>(Og * g.T_out), static_cast<int>(g.groups)),
   260	                 "cublasSgemmStridedBatched", device);
   261	    check_after_cublas_on(kPrefix, "cublasSgemmStridedBatched", device);
   262	  }
   263	  if (b != nullptr) {
   264	    const int64_t total = g.N * g.C_out * g.T_out;
   265	    bias_add_kernel<<<grid_for(total, tuning::kBiasBlock), tuning::kBiasBlock, 0, kLegacyStream>>>(y, b, g.C_out,
   266	                                                                                                   g.T_out, total);
   267	    check_launch_on(kPrefix, "bias_add_kernel", device);
   268	  }
   269	  guard.restore();  // P1T-FIX4
   270	}
   271	
   272	// ------------------------------------------------------------------------------------------------ ConvTranspose1d
   273	void conv_transpose1d_forward(int device, const ConvTranspose1dGeom& g, const float* x, const float* w,
   274	                              const float* b, float* y) {
   275	  DeviceGuard guard(device);
   276	  const int64_t total = g.N * g.C_out * g.T_out;
   277	  conv_transpose1d_gather_kernel<<<grid_for(total, tuning::kConvTransposeBlock), tuning::kConvTransposeBlock, 0,
   278	                                   kLegacyStream>>>(x, w, b, y, g.N, g.C_in, g.T, g.C_out, g.K, g.T_out, g.stride,
   279	                                                    g.pad_begin, g.dilation, g.groups);
   280	  check_launch_on(kPrefix, "conv_transpose1d_gather_kernel", device);
   281	  guard.restore();  // P1T-FIX4
   282	}
