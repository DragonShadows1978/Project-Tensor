    82	//    never sets this runtime's error state: an error here is an asynchronous error of earlier work on the device.
    83	//    FIX6 said "cublasSgemmStridedBatched failed", naming a call that had just succeeded.
    84	// Every helper consumes the slot entry it reports (rule 1). Prior art: PyTorch's C10_CUDA_KERNEL_LAUNCH_CHECK message
    85	// ("CUDA kernel errors might be asynchronously reported at some other API call, so the stacktrace below might be
    86	// incorrect", c10/cuda/CUDAException.h, torch 2.11 headers; taken: stating the asynchronous possibility instead of
    87	// blaming the last launch); the CUDA 12.6 cudaGetLastError note quoted above. Ours: the cuBLAS case and naming the
    88	// device.
    89	[[noreturn]] inline void raise_call_failure_on(const char* prefix, const char* what, const char* api, int device,
    90	                                               cudaError_t e) {
    91	  std::ostringstream os;
    92	  os << prefix << what << " failed: " << cudaGetErrorName(e) << ": " << cudaGetErrorString(e) << " (" << api
    93	     << " on CUDA device " << device << " returned it)";
    94	  throw_after_consuming(os);
    95	}
    96	inline void check_call_on(const char* prefix, const char* what, const char* api, int device, cudaError_t e) {
    97	  if (e != cudaSuccess) raise_call_failure_on(prefix, what, api, device, e);
    98	}
    99	inline void check_launch_on(const char* prefix, const char* kernel, int device) {
   100	  const cudaError_t e = cudaPeekAtLastError();  // P1T-FIX8: read, not consumed until the report exists
   101	  if (e == cudaSuccess) return;
   102	  std::ostringstream os;
   103	  os << prefix << "CUDA error at the launch check of " << kernel << " on CUDA device " << device << ": "
   104	     << cudaGetErrorName(e) << ": " << cudaGetErrorString(e)
   105	     << " (cudaGetLastError right after the launch: the launch's own error, or an asynchronous error of earlier work "
   106	        "on that device, which CUDA reports at a later call)";
   107	  throw_after_consuming(os);
   108	}
   109	inline void check_after_cublas_on(const char* prefix, const char* fn, int device) {
   110	  const cudaError_t e = cudaPeekAtLastError();  // P1T-FIX8: read, not consumed until the report exists
   111	  if (e == cudaSuccess) return;
   112	  std::ostringstream os;
   113	  os << prefix << "CUDA error found by the check after " << fn << " on CUDA device " << device
   114	     << ", which returned CUBLAS_STATUS_SUCCESS: " << cudaGetErrorName(e) << ": " << cudaGetErrorString(e)
   115	     << " (cudaGetLastError; cuBLAS does not set the CUDA runtime's error state, so this is an asynchronous error of "
   116	        "earlier work on that device)";
   117	  throw_after_consuming(os);
   118	}
   119	[[noreturn]] inline void raise_cublas_failure_on(const char* prefix, const char* fn, int device, int status) {
   120	  std::ostringstream os;
   121	  os << prefix << fn << " failed: cuBLAS status " << status << " (on CUDA device " << device << ")";
   122	  throw std::runtime_error(os.str());
   123	}
   124	
   125	// Makes `device` current for a launch path and restores the caller's device. The constructor raises RuntimeError (slot
   126	// entry consumed) if the current device cannot be read or the switch fails; nothing is switched then. restore() is the
   127	// success-path restore and raises if it fails. The destructor restores only if restore() was not reached (an exception
   128	// is unwinding) and then routes a failure to note_unraisable_device_restore_failure (rule 2): no throw from a
   129	// destructor.
   130	class DeviceGuard {
   131	 public:
   132	  explicit DeviceGuard(int device) : device_(device) {
   133	    cudaError_t e = cudaGetDevice(&prev_);
   134	    if (e != cudaSuccess) raise_cuda_failure("tc_signal: cudaGetDevice", e);
   135	    if (prev_ != device) {
   136	      e = cudaSetDevice(device);
   137	      if (e != cudaSuccess) raise_cuda_failure("tc_signal: cudaSetDevice(" + std::to_string(device) + ")", e);
   138	      switched_ = true;
   139	    }
   140	  }
   141	  void restore() {
   142	    if (!switched_) return;
   143	    switched_ = false;
   144	    const cudaError_t e = cudaSetDevice(prev_);
   145	    if (e != cudaSuccess)
   146	      raise_cuda_failure("tc_signal: restoring the caller's CUDA device " + std::to_string(prev_) +
   147	                             " after queueing work on device " + std::to_string(device_) +
   148	                             " (cudaSetDevice; the calling thread's current device is still " +
   149	                             std::to_string(device_) + ", and the call's operands stay retained until that work is done)",
   150	                         e);
   151	  }
   152	  ~DeviceGuard() {
   153	    if (!switched_) return;
   154	    const cudaError_t e = cudaSetDevice(prev_);
   155	    if (e != cudaSuccess) {
   156	      note_unraisable_device_restore_failure(prev_, e);  // P1T-FIX8 (sweep (k)): recorded before it is consumed
   157	      cudaGetLastError();
   158	    }
   159	  }
   160	  DeviceGuard(const DeviceGuard&) = delete;
   161	  DeviceGuard& operator=(const DeviceGuard&) = delete;
   162	
   163	 private:
   164	  int device_;
   165	  int prev_ = -1;
   166	  bool switched_ = false;
   167	};
   168	
   169	// The never-throwing variant for release paths (destructors, noexcept drains). A failed query or switch is reported
   170	// through ok()/error() with its slot entry consumed; a failed restore follows rule 2.
   171	// P1T-FIX7 (V7-02 sweep (j)): failed_at_switch() says WHICH of the guard's two calls failed (cudaSetDevice of the
   172	// target device, or the cudaGetDevice before it), so a release path records the call that failed, not the call the
   173	// guard prevented (FIX6 reported a failed switch as a failed stream sync / event record / event destroy).
   174	class QuietDeviceGuard {
   175	 public:
   176	  explicit QuietDeviceGuard(int device) noexcept {
   177	    cudaError_t e = cudaGetDevice(&prev_);
   178	    if (e != cudaSuccess) {
   179	      cudaGetLastError();
   180	      err_ = e;
   181	      return;
   182	    }
   183	    if (prev_ != device) {
   184	      e = cudaSetDevice(device);
   185	      if (e != cudaSuccess) {
   186	        cudaGetLastError();
   187	        err_ = e;
   188	        switch_failed_ = true;
   189	        return;
   190	      }
   191	      switched_ = true;
   192	    }
   193	  }
   194	  ~QuietDeviceGuard() {
   195	    if (!switched_) return;
   196	    const cudaError_t e = cudaSetDevice(prev_);
   197	    if (e != cudaSuccess) {
   198	      note_unraisable_device_restore_failure(prev_, e);  // P1T-FIX8 (sweep (k)): recorded before it is consumed
   199	      cudaGetLastError();
   200	    }
   201	  }
   202	  QuietDeviceGuard(const QuietDeviceGuard&) = delete;
   203	  QuietDeviceGuard& operator=(const QuietDeviceGuard&) = delete;
   204	  bool ok() const { return err_ == cudaSuccess; }
   205	  cudaError_t error() const { return err_; }
   206	  bool failed_at_switch() const { return switch_failed_; }  // P1T-FIX7: false = the cudaGetDevice before it failed
   207	
   208	 private:
   209	  int prev_ = 0;
   210	  cudaError_t err_ = cudaSuccess;
   211	  bool switched_ = false;
   212	  bool switch_failed_ = false;
   213	};
