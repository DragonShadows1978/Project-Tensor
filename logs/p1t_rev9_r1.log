   454	                          "); nothing was switched or recorded");
   455	  const bool switched = (prev != device);
   456	  if (switched) {
   457	    e = cudaSetDevice(device);
   458	    if (e != cudaSuccess)
   459	      throw_cuda_report_after_consuming("__dlpack__: stream fence: cannot make the tensor's CUDA device " + dev +
   460	                            " current (cudaSetDevice: " + name(e) + "); the caller's device " +
   461	                            std::to_string(prev) + " is unchanged and nothing was recorded");
   462	  }
   463	  // `device` is current from here until the restore below.
   464	  cudaEvent_t ev = nullptr;
   465	  const char* step = "cudaEventCreateWithFlags";
   466	  e = cudaEventCreateWithFlags(&ev, cudaEventDisableTiming);
   467	  if (e == cudaSuccess) {
   468	    step = "cudaEventRecord on the legacy stream";
   469	    e = cudaEventRecord(ev, cudaStreamLegacy);  // engine stream of `device`
   470	  }
   471	  if (e == cudaSuccess) {
   472	    step = "cudaStreamWaitEvent on the consumer's stream";
