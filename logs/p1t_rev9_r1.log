   892	  // Leave only after PyGILState_Release: the exit hook must not let finalization start while this thread still
   893	  // touches the interpreter. notify_all on every leave (not only at zero): the hook may be waiting for a nonzero
   894	  // count, its own thread's admitted releases (V3-01 self-exclusion).
   895	  try {
   896	    std::lock_guard<std::mutex> lk(lc.mu);
   897	    --lc.in_flight;
   898	    lc.cv.notify_all();
   899	  } catch (...) {
   900	    g_import_lock_failures.fetch_add(1);
   901	  }
   902	  --t_admitted_depth;
   903	}
