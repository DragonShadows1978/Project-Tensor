    67	void check_version(const DLManagedTensorVersioned* m, const char* role) {
    68	  if (m->version.major != DLPACK_MAJOR_VERSION) {
    69	    std::ostringstream os;
    70	    os << "DLPack major version " << m->version.major << " is not supported (this consumer reads major "
    71	       << DLPACK_MAJOR_VERSION << ")";
    72	    refuse_value(role, os.str());
    73	  }
    74	}
