  1702	      if (g_test_fail_exit_report.exchange(false)) throw std::bad_alloc();  // TEST HOOK (P1T-FIX8 V8-02 tests)
  1703	      const std::string msg = unraisable_message(n, what != nullptr ? std::string(what) : std::string(), dev, err);
