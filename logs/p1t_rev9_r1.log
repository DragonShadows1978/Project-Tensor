   284	// ------------------------------------------------------------------------------------------------ introspection
   285	CublasConfig cublas_config(int device) {
   286	  DeviceGuard guard(device);
   287	  cublasHandle_t h = handle_for(device);
   288	  cublasMath_t math;
   289	  cublasAtomicsMode_t atomics;
   290	  cublasPointerMode_t pmode;
   291	  cudaStream_t s;
   292	  check_cublas_on(cublasGetMathMode(h, &math), "cublasGetMathMode", device);
   293	  check_cublas_on(cublasGetAtomicsMode(h, &atomics), "cublasGetAtomicsMode", device);
   294	  check_cublas_on(cublasGetPointerMode(h, &pmode), "cublasGetPointerMode", device);
   295	  check_cublas_on(cublasGetStream(h, &s), "cublasGetStream", device);
   296	  CublasConfig c;
   297	  c.math_mode = static_cast<int>(math);
   298	  c.atomics_mode = static_cast<int>(atomics);
   299	  c.pointer_mode = static_cast<int>(pmode);
   300	  c.legacy_stream = (s == kLegacyStream);
   301	  c.default_math = (math == CUBLAS_DEFAULT_MATH);
   302	  c.atomics_not_allowed = (atomics == CUBLAS_ATOMICS_NOT_ALLOWED);
   303	  guard.restore();  // P1T-FIX4
   304	  return c;
   305	}
