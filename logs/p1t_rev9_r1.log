  1088	// QuietDeviceGuard (makes `device` current for its scope, never throws) moved to cuda_guard.h in P1T-FIX4, where its
  1089	// restore is now checked (62c8d9f ignored the restoring cudaSetDevice's result).
  1090	
  1091	// The outcome of one legacy-stream sync: its error, and WHICH call returned it (P1T-FIX7, V7-02 sweep (j): the
  1092	// guard's cudaGetDevice / cudaSetDevice, or cudaStreamSynchronize itself).
  1093	struct SyncResult {
  1094	  cudaError_t err = cudaSuccess;
  1095	  FailedCall call = FailedCall::kStreamSync;
  1096	};
  1097	
  1098	// P1T-FIX7, lead send-back L1 (sweep (i) addendum, "every exit wait that can block is diagnosed"): the device waits of
  1099	// interpreter exit. The exit hook's step 1 (synchronize()) and the exit runner's own synchronize() wait in
  1100	// cudaStreamSynchronize for the work queued on each device's legacy stream; a kernel that never finishes made exit
  1101	// wait SILENTLY. While the exit runner runs (raw_exit_hook_runner opens this window around the hook and its own steps;
  1102	// nothing else does), each such sync is preceded by a diagnosed wait: an event recorded on the legacy stream is polled
  1103	// every tuning::kExitDevicePollMs; after the first-diagnostic delay (the hook's knob, read at C level by the runner)
  1104	// a line goes to stderr naming the device and the seconds waited, then another each time the time waited has
  1105	// doubled (FIX3 V3-01's schedule), each counted (pending_stats() exit_device_wait_diagnostics), and a last line says
  1106	// when the work finished. The cudaStreamSynchronize that follows returns at once and keeps its own error and its
  1107	// attribution (V7-02: a failure is still named as cudaStreamSynchronize). Only CUDA calls this file already makes
  1108	// are used (cudaEventCreateWithFlags / Record / Query / Destroy, cudaPeekAtLastError / cudaGetLastError), so the
  1109	// reviewers' host traces that compile this file link unchanged; an error of the diagnostic event is cleared and the
  1110	// sync still runs (it then reports any sticky error itself). No allocation; never throws. Outside the window (every
  1111	// ordinary synchronize(), bound drain or fallback) nothing changes: one relaxed atomic load. Prior art: FIX3 V3-01's
  1112	// diagnostic schedule; event polling as a host-side progress check (cudaEventQuery's documented NotReady contract,
  1113	// CUDA 12.6 Runtime API; unverified here, lead to check "cudaEventQuery cudaErrorNotReady"); ours: confining it to the
  1114	// exit runner's window.
  1115	std::atomic<long long> g_exit_device_wait_diag_ns{-1};  // < 0: outside the exit runner's window
  1116	std::atomic<unsigned long long> g_exit_device_wait_diagnostics{0};
  1117	std::atomic<unsigned long long> g_exit_device_wait_watchdogs{0};  // P1T-FIX8: waits a watchdog diagnosed
  1118	std::atomic<unsigned long long> g_exit_watchdog_stop_lock_failures{0};  // P1T-FIX8 L2: stop()'s lock attempts that failed
  1119	std::atomic<unsigned long long> g_exit_watchdog_detaches{0};  // P1T-FIX8 L2: joins that failed (detached after run())
  1120	
  1121	void note_unraisable_failure(PendingState& st, const FailureRecord& r) noexcept;  // defined with the release records
  1122	
  1123	// P1T-FIX8, round-8 review finding V8-01 (MINOR): FIX7's L1 marker erased its own CUDA failures. Every failed marker
  1124	// call (cudaEventCreateWithFlags, cudaEventRecord, a non-NotReady cudaEventQuery, cudaEventDestroy) is now RECORDED as
  1125	// a tagged FailureRecord (the call, purpose kExitWaitMarker, the device, the error) through note_unraisable_failure
  1126	// BEFORE its error-slot entry is consumed, so the synchronize() that is running raises it (the existing raise-once
  1127	// path; at exit the hook writes it, and the runner is the last reader, V8-02), and it is counted in
  1128	// exit_marker_failures. A failed create, record or query no longer drops the wait to a silent cudaStreamSynchronize:
  1129	// the stream sync that follows is diagnosed by a watchdog thread on the same schedule (sync_device_legacy below), and
  1130	// "finished" is printed only when completion was proved: by cudaEventQuery returning cudaSuccess here, or by that
  1131	// stream sync returning cudaSuccess. cudaErrorNotReady from cudaEventQuery is not a failure: it is the documented
  1132	// "still running" answer (CUDA 12.6 Runtime API, cudaEventQuery: "cudaErrorNotReady if the event has not been
  1133	// completed yet"; unverified here, lead to check "cudaEventQuery cudaErrorNotReady"); it is taken out of the error
  1134	// slot only when it is what the slot holds. No allocation; never throws. Prior art: FIX5 V5-02's record-before-consume
  1135	// rule (taken as is); the CUDA 12.6 error-slot contract of cudaGetLastError / cudaPeekAtLastError. Ours: the marker's
  1136	// failure census and the watchdog fallback.
  1137	// The diagnostic schedule of ONE device wait (FIX3 V3-01: the first line after the delay, then each time the time
  1138	// waited has doubled), shared by the marker's polling and the watchdog so the lines continue one schedule.
  1139	struct DeviceWaitSchedule {
  1140	  std::chrono::steady_clock::time_point t0;
  1141	  std::chrono::steady_clock::time_point next;
  1142	  unsigned long long written = 0;
  1143	};
  1144	
  1145	void device_wait_line(int device, DeviceWaitSchedule& s, std::chrono::steady_clock::time_point now,
  1146	                      const char* how) noexcept {
  1147	  std::fprintf(stderr,
  1148	               "tc_signal: interpreter exit is waiting for the work queued on the legacy stream of CUDA device %d "
  1149	               "(synchronize() at exit, before the pending operands are released): still running after %.1f s; "
  1150	               "exit waits for it (a kernel that never finishes keeps exit waiting)%s\n",
  1151	               device, std::chrono::duration<double>(now - s.t0).count(), how);
  1152	  std::fflush(stderr);
