  1796	RetainUntilComplete::~RetainUntilComplete() {
  1797	  PendingState& st = pending();
  1798	  PendingEntry e;
  1799	  e.device = device_;
  1800	  e.bytes = bytes_;  // V3-02: summed with checked addition in the constructor; no addition here
  1801	  for (Operand* op : ops_) {
  1802	    if (op == nullptr || !op->present()) continue;
  1803	    owners_.push_back(op->take_owner());  // reserved: no allocation
  1804	  }
  1805	  e.owners = std::move(owners_);
  1806	  cudaError_t r = cudaSuccess;
  1807	  FailedCall record_call = FailedCall::kEventRecord;  // P1T-FIX7 (sweep (j)): the call that failed, if one did
  1808	  {
  1809	    QuietDeviceGuard g(device_);
  1810	    if (!g.ok()) record_call = guard_call(g);
  1811	    r = !g.ok() ? g.error()
  1812	                : (test_hooks::take(test_hooks::kCudaEventRecord) ? kTestInjectedCudaError
  1813	                                                                  : cudaEventRecord(event_, cudaStreamLegacy));
  1814	  }
  1815	  if (r == cudaSuccess) {
  1816	    e.event = event_;
  1817	    // N3: the push may allocate (a new deque node); this destructor is noexcept, so a failure must be caught here
  1818	    // and turned into the synchronous fallback below (round-2 review: bad_alloc on the release path terminated).
  1819	    try {
  1820	      if (test_hooks::take(test_hooks::kAllocPendingPush)) throw std::bad_alloc();
  1821	      st.q.push_back(std::move(e));
  1822	      note_push(st, st.q.back());
  1823	    } catch (...) {
  1824	      ++st.push_alloc_failures;
  1825	      r = cudaErrorMemoryAllocation;  // e was not moved (push_back's strong guarantee): use the fallback below
  1826	      e.event = nullptr;
  1827	    }
  1828	  } else {
  1829	    // P1T-FIX5 (sweep (d), consumed-but-unrecorded errors): the failed record (or the guard's failed switch, whose slot
  1830	    // entry the guard consumed already) is RECORDED first, then this call's slot entry is consumed. 1475fae consumed it
  1831	    // without a record, so when the fallback sync below succeeded the CUDA failure was never reported. It is a failure
  1832	    // where nothing can raise (a destructor) and no operand is leaked by it (the fallback releases or leaks on its own
  1833	    // proof), so it is an unraisable failure: raised once by the next synchronize().
  1834	    // P1T-FIX7 (sweep (j)): recorded as the call that failed: cudaEventRecord, or the guard's cudaGetDevice /
  1835	    // cudaSetDevice, in which case no record was attempted (FIX6 named cudaEventRecord for both).
  1836	    sat_inc(st.event_record_failures);
  1837	    note_unraisable_failure(st, {record_call, Purpose::kRecordEvent, device_, r});
  1838	    cudaGetLastError();
  1839	  }
  1840	  if (r != cudaSuccess) {
  1841	    // Fallback: no queued event, so synchronize this device's legacy stream; release on success, leak on failure.
  1842	    ++st.fallback_syncs;
  1843	    const SyncResult sr = sync_device_legacy(device_);
  1844	    if (sr.err == cudaSuccess) {
  1845	      recycle_event(st, device_, event_);
  1846	      ++st.released_entries;
  1847	      st.released_managers += e.owners.size();
  1848	      for (ManagedOwner& o : e.owners) o.reset();  // N4: a throwing deleter is contained per manager
  1849	    } else {
  1850	      const unsigned long long leaked = leak_entry(st, e);
  1851	      // N1: raised by the next synchronize(). P1T-FIX7: as the call that failed (guard or stream sync).
  1852	      note_release_failure(st, {sr.call, Purpose::kSyncStream, device_, sr.err}, false, leaked);
  1853	    }
  1854	    return;
  1855	  }
  1856	  if (pending_over_bound(st)) {  // V3-02: overflow-safe (saturating total), exact at the boundary
  1857	    ++st.bound_drains;
  1858	    const SyncReport rep = sync_and_release_all_impl();
  1859	    // N1. P1T-FIX7 (sweep (j)): the first failure as one consistent record (SyncReport::first).
  1860	    if (rep.failed()) note_release_failure(st, rep.first(), true, rep.leaked_managers);
  1861	  }
  1862	}
  1863	
  1864	void drain_completed() noexcept {
  1865	  PendingState& st = pending();
  1866	  while (!st.q.empty()) {
  1867	    const cudaError_t r = test_hooks::take(test_hooks::kCudaEventQuery) ? kTestInjectedCudaError
  1868	                                                                          : cudaEventQuery(st.q.front().event);
  1869	    if (r != cudaSuccess) {
  1870	      // cudaErrorNotReady: still pending (FIFO: later entries wait too). CUDA 12.6 does not leave NotReady in the
  1871	      // last-error slot (ledger receipt; Programming Guide 3.2.12: NotReady "is not considered an error"); clear it
  1872	      // defensively if a runtime ever does. Any other error (a broken context) leaves the entry for
  1873	      // synchronize_and_release_all, which re-queries it and reports and leaks it if the device cannot synchronize.
  1874	      // P1T-FIX4 (sweep): that other error's slot entry is consumed here (62c8d9f left it, so the next, unrelated
  1875	      // launch check reported it as its own); the entry itself still carries the failure to synchronize().
  1876	      // P1T-FIX5, round-5 review finding V5-02 (MINOR): FIX4's last clause was wrong for a ONE-SHOT failure. The entry
  1877	      // stays queued, but a queued entry does not remember the error: synchronize() re-queries it, and if the query now
  1878	      // succeeds the entry is released and synchronize() returns success, so the failure was consumed and never
  1879	      // reported (review probe query_error_cpu.py / query_error_single_gpu.py; FIX4 sweep rows 47 and 50). Now a
  1880	      // non-NotReady failure is RECORDED first (counted in event_query_failures and noted as a failure where nothing
  1881	      // can raise: the drain is noexcept and runs at the start of an unrelated call), and only then is the slot entry
  1882	      // consumed; the next synchronize() raises it exactly once (FIX4's deferred-error routing, cleared once its message
  1883	      // exists). Completion and release stay as before: the entry is left for synchronize(), which re-queries it and
  1884	      // releases on a successful query, or leaks it with no completion proof. NotReady is not recorded: CUDA 12.6
  1885	      // documents it as "not considered an error" (Programming Guide 3.2.12) and it is not an error of the query.
  1886	      // Prior art: NVIDIA CUDA 12.6 cudaEventQuery / cudaGetLastError contracts (a returned error vs the per-thread slot);
  1887	      // the "record before you clear" rule is ordinary error accounting, no specific prior art known to me.
  1888	      if (r == cudaErrorNotReady) {
  1889	        if (cudaPeekAtLastError() == cudaErrorNotReady) cudaGetLastError();
  1890	      } else {
  1891	        sat_inc(st.event_query_failures);
  1892	        note_unraisable_failure(st, {FailedCall::kEventQuery, Purpose::kDrainQueryEvent, st.q.front().device, r});
  1893	        cudaGetLastError();
  1894	      }
  1895	      return;
  1896	    }
  1897	    PendingEntry e = std::move(st.q.front());
  1898	    st.q.pop_front();
  1899	    note_pop(st, e);
  1900	    release_entry(st, e);
  1901	  }
  1902	}
  1903	
  1904	// P1T-FIX4, round-4 review finding V4-04 (MINOR). 62c8d9f never looked at the calling thread's CUDA last-error slot:
  1905	// after a synchronous launch refusal (cudaErrorInvalidConfiguration, a NULL kernel, ...) that queued no work, every
  1906	// stream sync succeeded and synchronize() returned success with the error still pending. Now:
  1907	//  * FIRST, before any query, sync or release can replace it, the existing error is TAKEN (cudaGetLastError) and held;
  1908	//  * the drain runs exactly as before (sync every relevant device's legacy stream, release what completed, leak what
  1909	//    has no completion proof); a pending launch refusal does not stop the drain;
  1910	//  * then RuntimeError is raised naming the pre-existing error (and any drain failure), even if every sync succeeded.
  1911	// Clear (take), not peek (decision justified against the CUDA semantics, receipts artifacts/p1t_fix4/):
  1912	//  * non-sticky errors (a refused launch, a failed API call) stay in the slot until someone takes them, survive
  1913	//    successful calls, and are OVERWRITTEN by the next failing call (measured 98 -> 101). This function reports the
  1914	//    error, so it consumes it: peeking would leave it for the next unrelated launch check of this shared
  1915	//    libcudart.so.12 instance (any tc_signal op, or core's cuda_check_last) to report a second time as its own; and a
  1916	//    failing sync here would overwrite it anyway, so a peek could not preserve it reliably.
  1917	//  * sticky errors (a device-side fault) live in the CONTEXT: taking the slot entry resets only the slot (measured:
  1918	//    710, then 0), every later call that touches the context still returns the error, so nothing is hidden; the drain's
  1919	//    syncs fail and the pending operands are leaked and reported, as before.
  1920	//  * the runtime's own no-device state (cudaErrorNoDevice) is not reset by cudaGetLastError at all (measured).
  1921	// Prior art: NVIDIA CUDA 12.6 cudaGetLastError / cudaPeekAtLastError ("returns this variable and resets it" versus
  1922	// "does not reset"; Programming Guide 3.2.12) and cudaStreamSynchronize; PyTorch's convention of consuming the slot when
  1923	// it reports (C10_CUDA_KERNEL_LAUNCH_CHECK = C10_CUDA_CHECK(cudaGetLastError()); C10_CUDA_CHECK_WARN, torch 2.11
  1924	// headers). Taken: report-and-consume. Ours: capturing at synchronize() entry and still draining before raising.
  1925	// P1T-FIX6, round-6 review finding V6-03 (MINOR): this call's own drain failures (rep) are persisted into
  1926	// PendingState::drain_unreported BEFORE anything is allocated for the message, with allocation-free bookkeeping (a
  1927	// fixed-capacity SyncReport merge), exactly like the earlier-failure records (N1, FIX4, FIX5) and the pre-existing error
  1928	// (V4-04). Every record is cleared only once the diagnostic has been raised, i.e. once the Python RuntimeError carrying
  1929	// the full message exists and is held by a captured py::error_already_set: a bad_alloc anywhere before that point (the
  1930	// message string, the Python str, pybind11's error capture) propagates as MemoryError and leaves every record in place,
  1931	// so the next synchronize() raises it, exactly once. (acd42fa cleared the records after building the message but
  1932	// before the exception object existed, and never persisted `rep` at all: reviewer probes release_trace_cpu.py
  1933	// diagnostic_oom_query / _sync / _device, rc 1.)
  1934	// Prior art: SQLite's OOM testing discipline (fail each allocation in turn; an error must survive the failure of its own
  1935	// reporting; "sqlite3 malloc failure testing", unverified here: lead to check "SQLite testing OOM anomaly"); ordinary
  1936	// "commit after the side effect" ordering. Taken: persist before allocating, clear after the raise. Ours: capturing
  1937	// the Python exception (PyErr_SetString, then py::error_already_set) before clearing, so pybind11's translation cannot
  1938	// lose a cleared record.
  1939	namespace {
  1940	void clear_reported_records(PendingState& st) noexcept {
  1941	  st.unreported_count = 0;
  1942	  st.unreported_leaked = 0;
  1943	  st.unreported_first = FailureRecord{};
  1944	  st.unreported_in_bound_drain = false;
  1945	  st.unraisable_unreported = 0;
  1946	  st.unraisable_first = FailureRecord{};
  1947	  st.prior_unreported = 0;
  1948	  st.prior_error = cudaSuccess;
  1949	  st.drain_unreported = SyncReport{};
  1950	  st.drain_unreported_calls = 0;
  1951	}
  1952	
  1953	bool has_unreported_records(const PendingState& st) noexcept {
  1954	  return st.drain_unreported_calls != 0 || st.unreported_count != 0 || st.unraisable_unreported != 0 ||
  1955	         st.prior_unreported != 0;
  1956	}
