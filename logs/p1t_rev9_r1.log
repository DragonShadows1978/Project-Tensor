   641	void fill_(NDArray& a, double value) {
   642	  if (!a.defined()) throw std::runtime_error("fill_: undefined array");
   643	  if (!a.device.is_cuda()) throw std::runtime_error("fill_: CUDA arrays only");
   644	  if (a.dtype != DType::Float32 && a.dtype != DType::Float16 && a.dtype != DType::BFloat16)
   645	    throw std::runtime_error("op supports float32/float16/bfloat16 only");
   646	  int64_t n = a.numel();
   647	  if (n == 0) return;
   648	  const int64_t blocks = fill_grid_blocks(n);  // P1T-FIX5 V5-04: int64 block count; refused here if over the limit
   649	  const std::string mismatch = cuda_storage_device_mismatch(a, "fill_");
   650	  if (!mismatch.empty()) throw std::runtime_error(mismatch);
   651	  CheckedDeviceGuard guard(a.device.index, "fill_");
   652	  const cudaError_t pending = cudaPeekAtLastError();  // P1T-FIX8 (sweep (k)): consumed once its report exists
   653	  if (pending != cudaSuccess)
   654	    throw_after_consuming(std::string("fill_: a CUDA error was already pending in this thread before the launch (") +
   655	                             cudaGetErrorName(pending) + ": " + cudaGetErrorString(pending) +
   656	                             "), from earlier work outside this call; taken from the error slot and reported here, nothing was launched "
   657	                             "(P1T-FIX7: the call that set it and its device are unknown; the slot records neither)");
   658	  DISPATCH_FLOAT(a.dtype, T, {
   659	    // P1T-FIX5 V5-04: blocks <= 2^31-1 (checked above), so this conversion is exact and blocks * kT >= n.
   660	    fill_kernel<T><<<static_cast<unsigned int>(blocks), kT>>>(static_cast<T*>(a.data_ptr()), n, (float)value);
   661	  });
   662	  // P1T-FIX7 (sweep (j), error attribution): the launch check names the kernel and the device, and does not claim the
   663	  // launch failed: cudaGetLastError right after a launch reports the launch's own error OR an asynchronous error of
   664	  // earlier work on that device (CUDA 12.6 Runtime API: it "may also return error codes from previous, asynchronous
   665	  // launches"). FIX6 called the baseline cuda_check_last("fill_"), which named neither. The message still starts
   666	  // "CUDA error at fill_" (that helper's text). Prior art: PyTorch's C10_CUDA_KERNEL_LAUNCH_CHECK note ("CUDA kernel
   667	  // errors might be asynchronously reported at some other API call").
   668	  {
   669	    const cudaError_t le = cudaPeekAtLastError();  // P1T-FIX8 (sweep (k)): consumed once its report exists
   670	    if (le != cudaSuccess)
   671	      throw_after_consuming(std::string("CUDA error at fill_: ") + cudaGetErrorName(le) + ": " +
   672	                               cudaGetErrorString(le) + " (cudaGetLastError right after launching fill_kernel on CUDA "
   673	                               "device " + std::to_string(a.device.index) +
   674	                               ": the launch's own error, or an asynchronous error of earlier work on that device)");
   675	  }
   676	  a.mark_modified();  // the write is queued: bump the revision BEFORE a restore failure can raise
   677	  guard.restore();
   678	}
   679	NDArray NDArray::from_host(const void* src, const Shape& shape, DType dtype, Device device) {
   680	  NDArray a(shape, dtype, device);
   681	  size_t bytes = a.numel() * dtype_size(dtype);
   682	  if (bytes == 0) return a;
   683	  if (device.is_cuda()) cudaMemcpy(a.data_ptr(), src, bytes, cudaMemcpyHostToDevice);
   684	  else std::memcpy(a.data_ptr(), src, bytes);
   685	  cuda_check_last("from_host");
   686	  return a;
   687	}
   688	void NDArray::to_host(void* dst) const {
   689	  size_t bytes = numel() * dtype_size(dtype);
   690	  if (bytes == 0) return;
  1590	// P1T-FIX7 (sweep (j)): the text no longer starts "tensor_cuda.synchronize:" (the exit hook logged it as
  1591	// "tensor_cuda: at exit: tensor_cuda.synchronize: ...", naming a call that did not happen at exit); it names the
  1592	// reporting paths instead, and each record's site string names the CUDA call that failed (kernels.cu), followed by
  1593	// the device it concerned.
  1594	std::string unraisable_message(unsigned long long n, const std::string& what, int dev, int err) {
  1595	  std::string msg = "tensor_cuda: " + std::to_string(n) +
  1596	                    " CUDA failure(s) on DLPack release / fill_ paths that could not raise where they happened (P1-T "
  1597	                    "core; reported once, by tensor_cuda.synchronize() or at interpreter exit), the first: ";
  1598	  if (what.empty())
  1599	    msg += "(not named: recorded while an earlier report was being raised)";
  1600	  else
  1601	    msg += what + " [CUDA device " + std::to_string(dev) + ": " + cudaGetErrorName(static_cast<cudaError_t>(err)) +
  1602	           ": " + cudaGetErrorString(static_cast<cudaError_t>(err)) + "]";
  1603	  return msg;
  1604	}
