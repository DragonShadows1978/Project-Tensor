  1081	// Never destroyed: no static destructor may call a producer deleter at process exit (Python may be gone by then).
  1082	// Constructed at module import (init_pending_state), so the first call from a noexcept release path never allocates.
  1083	PendingState& pending() {
  1084	  static PendingState* state = new PendingState();
  1085	  return *state;
  1086	}
