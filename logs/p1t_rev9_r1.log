   475	  // Safe right after the wait is enqueued: the dependency is captured at the
   476	  // cudaStreamWaitEvent call and the runtime frees the event once it fires.
   477	  const cudaError_t de = ev ? cudaEventDestroy(ev) : cudaSuccess;  // on its own device
   478	  const cudaError_t re = switched ? cudaSetDevice(prev) : cudaSuccess;
   479	  if (e == cudaSuccess && de == cudaSuccess && re == cudaSuccess) return;
   480	  // the failed calls are reported by the raise below; their slot entry is consumed once that report exists
   481	  std::string msg = "__dlpack__: stream fence on the tensor's CUDA device " + dev + " failed:";
   482	  if (e != cudaSuccess) msg += std::string(" ") + step + " (" + name(e) + ");";
   483	  if (de != cudaSuccess) msg += " cudaEventDestroy (" + name(de) + ");";
   484	  if (re != cudaSuccess)
   485	    msg += " restoring the caller's CUDA device " + std::to_string(prev) + " also failed (cudaSetDevice: " + name(re) +
   486	           "), so the calling thread's current device is still " + dev;
