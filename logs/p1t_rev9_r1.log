   141	// ------------------------------------------------------------------------------------------------ device functions
   142	// Logistic sigmoid, stable for large |z|: exp is only ever evaluated at a non-positive argument, so it never overflows
   143	// (z >= 0: 1 / (1 + e^{-z}); z < 0: e^{z} / (1 + e^{z})). expf is the CUDA math library's accurate expf (2 ulp max),
   144	// never the fast intrinsic. Prior art: the standard sign split (see the file header).
   145	__device__ __forceinline__ float sigmoid_stable(float z) {
   146	  if (z >= 0.0f) return 1.0f / (1.0f + expf(-z));
   147	  const float e = expf(z);
   148	  return e / (1.0f + e);
   149	}
   150	
   151	// ------------------------------------------------------------------------------------------------ kernels
   152	// G_x[d, r, q] = Wb[d, q] for every projected row r in [0, T*N) and q in [0, 4H): the bias the input-projection GEMM
   153	// then accumulates onto (beta = 1). One thread per element, a plain copy.
   154	__global__ void lstm_bias_fill_kernel(float* __restrict__ gx, const float* __restrict__ B, int64_t D, int64_t rows,
   155	                                      int64_t H4, int64_t bias_row) {
   156	  const int64_t total = D * rows * H4;
   157	  for (int64_t i = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; i < total;
   158	       i += static_cast<int64_t>(gridDim.x) * blockDim.x) {
   159	    const int64_t q = i % H4;
   160	    const int64_t d = i / (rows * H4);
   156	  const int64_t total = D * rows * H4;
   157	  for (int64_t i = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; i < total;
   158	       i += static_cast<int64_t>(gridDim.x) * blockDim.x) {
   159	    const int64_t q = i % H4;
   160	    const int64_t d = i / (rows * H4);
   161	    gx[i] = B[d * bias_row + q];
   162	  }
   163	}
   164	
   165	// One LSTM step for every direction slot at once; one thread per state element idx = (d*N + n)*H + j.
   166	//   gx: G_x [D, T, N, 4H] (x . W^T + Wb); gh: G_h [D, N, 4H] (h_{t-1} . R^T for this step); B: [D, 8H] or NULL;
   167	//   h / c: the state [D, N, H] (= Y_h / Y_c), read and written in place by the owning thread only; Y [T, D, N, H].
   168	// Fixed per-element operation order: z = (gx + gh) + Rb; c = fmaf(f, c_prev, i * c~); h = o * tanhf(c).
   169	__global__ void lstm_cell_kernel(const float* __restrict__ gx, const float* __restrict__ gh,
   170	                                 const float* __restrict__ B, float* __restrict__ h, float* __restrict__ c,
   171	                                 float* __restrict__ Y, int64_t T, int64_t s, int64_t D, int64_t N, int64_t H,
   172	                                 int64_t first_reverse) {
   173	  const int64_t H4 = kLstmGates * H;
   174	  const int64_t total = D * N * H;
   175	  for (int64_t idx = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; idx < total;
   176	       idx += static_cast<int64_t>(gridDim.x) * blockDim.x) {
   177	    const int64_t j = idx % H;
   178	    const int64_t r = idx / H;
   179	    const int64_t n = r % N;
   180	    const int64_t d = r / N;
   181	    const int64_t tt = (d >= first_reverse) ? (T - 1 - s) : s;   // the reverse slot walks time backwards
   182	    const float* gxp = gx + ((d * T + tt) * N + n) * H4;
   183	    const float* ghp = gh + (d * N + n) * H4;
   184	    float zi = gxp[kGateI * H + j] + ghp[kGateI * H + j];
   185	    float zo = gxp[kGateO * H + j] + ghp[kGateO * H + j];
   186	    float zf = gxp[kGateF * H + j] + ghp[kGateF * H + j];
   187	    float zc = gxp[kGateC * H + j] + ghp[kGateC * H + j];
   188	    if (B != nullptr) {
   189	      const float* rb = B + d * (kLstmBiasHalves * H4) + H4;     // Rb[d] = B[d, 4H:8H]
   190	      zi = zi + rb[kGateI * H + j];
   191	      zo = zo + rb[kGateO * H + j];
   192	      zf = zf + rb[kGateF * H + j];
   193	      zc = zc + rb[kGateC * H + j];
   194	    }
   195	    const float ig = sigmoid_stable(zi);
   196	    const float og = sigmoid_stable(zo);
   197	    const float fg = sigmoid_stable(zf);
   198	    const float cg = tanhf(zc);
   199	    const float cn = fmaf(fg, c[idx], ig * cg);
   200	    const float hn = og * tanhf(cn);
   201	    c[idx] = cn;
   202	    h[idx] = hn;
   203	    Y[((tt * D + d) * N + n) * H + j] = hn;
   204	  }
   205	}
