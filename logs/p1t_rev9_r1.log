    89	// DeviceGuard (makes `device` current for the call, restores the caller's device) is tc_signal's shared, checked guard
    90	// in cuda_guard.h since P1T-FIX4 (this copy ignored the restoring cudaSetDevice's result).
    91	
    92	// cuBLAS handle: one per device, created lazily on first use and kept for the life of the process (destroying it at
    93	// interpreter exit can race CUDA's own teardown), with M2's exact settings: legacy stream, CUBLAS_DEFAULT_MATH (never
    94	// TF32), atomics not allowed, pointer mode host. M2's handle_for() in conv.cu has internal linkage and the order
    95	// forbids editing conv.cu, so the LSTM keeps its own handle (deviation, P1T_M3_REPORT.md). All entry points run under
    96	// the GIL, so no extra lock is needed. cuBLAS allocates its own internal workspace for this handle (cudaMalloc inside
    97	// cuBLAS); that is the only device memory the LSTM causes to be allocated outside the caller's allocator.
    98	cublasHandle_t lstm_handle_for(int device) {
    99	  static std::unordered_map<int, cublasHandle_t> handles;
   100	  auto it = handles.find(device);
   101	  if (it != handles.end()) return it->second;
   102	  cublasHandle_t h = nullptr;
   103	  check_cublas_on(cublasCreate(&h), "cublasCreate", device);
   104	  // P1T-FIX5, round-5 review finding V5-03 (MINOR), same fix as conv.cu handle_for: the new handle is owned from creation
   105	  // until the cache insertion commits; on any exception before the commit (handles.emplace throwing std::bad_alloc was
   106	  // the leak: review probe handle_insert_oom_cpu.cpp, creates 1, destroys 0) the owner destroys it, checks the status
   107	  // and counts a failure without throwing during unwinding. A failed setting still destroys it explicitly and names the
   108	  // status (FIX4), clearing `h` first so it is destroyed once. Prior art: RAII and the scope guard with dismissal on
   109	  // commit (Alexandrescu & Marginean, C/C++ Users Journal, 2000); see conv.cu.
   110	  struct NewHandleOwner {
   111	    cublasHandle_t& h;
   112	    ~NewHandleOwner() {
   113	      if (h == nullptr) return;  // committed to the cache, or already destroyed by settle
   114	      const cublasStatus_t ds = cublasDestroy(h);
   115	      if (ds != CUBLAS_STATUS_SUCCESS) note_cublas_handle_destroy_failure(static_cast<int>(ds));
   116	    }
   117	  } owned{h};
   118	  // P1T-FIX4 (sweep): a setting that fails no longer leaks the new handle: it is destroyed (on this device, which the
   119	  // caller's DeviceGuard keeps current), the destroy's own status is checked and named, and the call raises. Nothing is
   120	  // cached, so the next call retries from cublasCreate.
   121	  auto settle = [&h, device](cublasStatus_t st, const char* what) {
   122	    if (st == CUBLAS_STATUS_SUCCESS) return;
   123	    const cublasStatus_t ds = cublasDestroy(h);
   124	    h = nullptr;  // P1T-FIX5: destroyed here; the owner must not destroy it again
   125	    std::ostringstream os;
   126	    os << "tc_signal.lstm: " << what << " failed: cuBLAS status " << static_cast<int>(st)
   127	       << " (the new handle of CUDA device " << device << ")";  // P1T-FIX7 (sweep (j)): the device named
   128	    if (ds != CUBLAS_STATUS_SUCCESS) os << "; destroying the new handle also failed: cuBLAS status " << static_cast<int>(ds);
   129	    throw std::runtime_error(os.str());
   130	  };
   131	  settle(cublasSetStream(h, kLegacyStream), "cublasSetStream(0)");
   132	  settle(cublasSetMathMode(h, CUBLAS_DEFAULT_MATH), "cublasSetMathMode(CUBLAS_DEFAULT_MATH)");
   133	  settle(cublasSetAtomicsMode(h, CUBLAS_ATOMICS_NOT_ALLOWED), "cublasSetAtomicsMode(NOT_ALLOWED)");
   134	  settle(cublasSetPointerMode(h, CUBLAS_POINTER_MODE_HOST), "cublasSetPointerMode(HOST)");
   135	  handles.emplace(device, h);  // may throw (host allocation): `owned` destroys h, nothing is cached
   136	  const cublasHandle_t cached = h;
   137	  h = nullptr;  // committed: the cache owns the handle now
   138	  return cached;
   139	}
