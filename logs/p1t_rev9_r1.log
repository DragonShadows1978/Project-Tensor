   461	// P1T-FIX4 (sweep, implicit current device): TensorCUDA labels its OWN allocations cuda:0 (Device::from_string, which
   462	// predates P1-T, maps every "cuda..." string to index 0) while the Storage constructor allocates on whatever device is
   463	// current; an imported Storage is labeled with the producer's device. So the label is proven here against the
   464	// allocation itself before a P1-T path acts on it (the DLPack export publishes it and fences its stream; fill_ launches
   465	// on it): cudaPointerGetAttributes of element 0 must report a CUDA allocation on a.device.index. Returns "" when it
   466	// does; otherwise a message naming both devices (the caller raises its own error type). A failed query raises
   467	// RuntimeError (its slot entry consumed). Empty arrays have no memory to act on and pass. The query does not
   468	// synchronize, and it succeeds in a context with a sticky error (receipt artifacts/p1t_fix4/cuda_semantics.txt).
   469	// Prior art: the CUDA runtime's unified-addressing pointer query (cudaPointerGetAttributes, CUDA 4.0+); PyTorch 2.11
   470	// Tensor.__dlpack__ refuses a CURRENT-device mismatch instead (BufferError "Can't export tensors on a different CUDA
   471	// device index", read in the installed torch/_tensor.py). Taken: refuse rather than publish a wrong device. Ours:
   472	// checking the label against the allocation (not the current device), at export and fill_.
   473	std::string cuda_storage_device_mismatch(const NDArray& a, const char* who) {
   474	  if (!a.defined() || !a.device.is_cuda() || a.numel() == 0 || a.storage->ptr == nullptr) return std::string();
   475	  cudaPointerAttributes attr{};
   476	  const cudaError_t e = cudaPointerGetAttributes(&attr, a.data_ptr());
   477	  // P1T-FIX7 (sweep (j)): the failed query is about this pointer; which device holds it is what it could not tell.
   478	  if (e != cudaSuccess)
   479	    raise_cuda_failure(std::string(who) + ": cudaPointerGetAttributes failed for element 0 (the tensor is labeled cuda:" +
   480	                           std::to_string(a.device.index) + "; the device of its allocation is unknown)",
   481	                       e);
   482	  if (attr.type == cudaMemoryTypeUnregistered)
   483	    return std::string(who) + ": this tensor is labeled cuda:" + std::to_string(a.device.index) +
   484	           " but its memory is not a CUDA allocation the driver knows; refused";
   485	  if (attr.device != a.device.index)
   486	    return std::string(who) + ": this tensor is labeled cuda:" + std::to_string(a.device.index) +
   487	           " but its memory is on CUDA device " + std::to_string(attr.device) +
   488	           " (TensorCUDA labels its own allocations cuda:0 and allocates on the current device, so it was created "
   489	           "while that device was current); refused rather than act on the wrong device";
   490	  return std::string();
   610	// per element, `if (i < n)`) with the baseline helper nblk(n), which narrows ceil(n / 256) to int. For an accepted
   611	// extent of 2^40 + 1 fp32 elements (4 TiB + 4 bytes of metadata; shape and byte bounds fit int64) the block count
   612	// 2^32 + 1 became 1: one block wrote 256 elements, the launch succeeded and the revision was bumped (review probes
   613	// fill_grid_cpu.cpp, fill_grid_single_gpu.py). Now, before anything else (before the label proof, the device guard, any
   614	// launch and the revision bump), fill_grid_blocks computes the block count in int64 and REFUSES (ValueError) an extent
   615	// whose block count exceeds the grid's x-dimension limit; an accepted extent's launch covers every element
   616	// (blocks * 256 >= n). Refusal, not a grid-stride fill: a grid-stride kernel would be a new core __global__, which the
   617	// P1-T plan forbids. The shared nblk helper and the other engine kernels are unchanged (baseline, outside P1-T).
   618	// The limit: CUDA C++ Programming Guide 12.6, "Compute Capabilities", Table "Technical Specifications per Compute
   619	// Capability": "Maximum x-dimension of a grid of thread blocks" = 2^31-1 for every compute capability CUDA 12.6 supports
   620	// (it is also cudaDeviceProp::maxGridSize[0] / cudaDevAttrMaxGridDimX; tests/test_dlpack.py test_fix5_v504_* reads it
   621	// on this host: 2147483647). A hardware limit, not a tunable.
   622	// Prior art: ISO C++17 integral conversions ([conv.integral]: an out-of-range signed conversion is implementation-
   623	// defined, here a wrap) and the checked-narrowing rule of the C++ Core Guidelines (ES.46, gsl::narrow); CUDA's dim3 grid
   624	// semantics. Taken: compute wide, check, then narrow. Ours: refusing at fill_'s boundary instead of capping the grid.
   625	namespace {
   626	constexpr int64_t kFillMaxGridX = 2147483647;  // 2^31-1: CUDA 12.6 grid x-dimension limit (see above)
   627	
   628	int64_t fill_grid_blocks(int64_t n) {
   629	  const int64_t blocks = n / kT + (n % kT != 0 ? 1 : 0);  // ceil(n / kT) for n >= 1, without forming n + kT - 1
   630	  if (blocks > kFillMaxGridX)
   631	    throw std::invalid_argument(
   632	        "fill_: " + std::to_string(n) + " elements need " + std::to_string(blocks) + " blocks of " +
   633	        std::to_string(kT) + " threads, more than the CUDA grid x-dimension limit of " +
   634	        std::to_string(kFillMaxGridX) + " (2^31-1) blocks; fill_ launches one thread per element (the existing "
   635	        "fill_kernel), so it covers at most " + std::to_string(kFillMaxGridX * kT) +
   636	        " elements. Refused before any launch: nothing was written and the revision is unchanged");
   637	  return blocks;
   638	}
   639	}  // namespace
