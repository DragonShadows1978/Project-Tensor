   429	const DLTensor* peek(py::handle capsule, const char* role) {
   430	  if (!PyCapsule_CheckExact(capsule.ptr())) refuse_type(role, "expected a DLPack capsule, got " + type_name(capsule));
   431	  if (capsule_kind(capsule, role)) {
   432	    auto* m = static_cast<DLManagedTensorVersioned*>(capsule_pointer(capsule, kCapsuleVersioned));
   433	    check_version(m, role);
   434	    return &m->dl_tensor;
   435	  }
   436	  auto* m = static_cast<DLManagedTensor*>(capsule_pointer(capsule, kCapsule));
   437	  return &m->dl_tensor;
   438	}
