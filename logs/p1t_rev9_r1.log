  1699	  if (w.overran) g_exit_wait_overruns.fetch_add(1, std::memory_order_relaxed);
  1700	  if (diag_default_used) g_exit_diag_default_used.fetch_add(1, std::memory_order_relaxed);
  1701	  py::dict d;  // built after the close and the wait: a MemoryError here cannot skip them
  1702	  d["in_flight_at_close"] = w.running_at_start > 0 ? w.running_at_start : 0;
  1703	  d["own_thread_in_flight"] = w.own[kRelease] + w.own[kCallback];
  1704	  d["pending_entries_at_close"] = c.pending_at_close;
  1705	  d["waited_us"] = w.waited_us;
  1706	  d["diagnostics"] = w.diagnostics;
  1707	  d["overran"] = w.overran;
  1708	  d["first_diag_s"] = first_diag_s;                    // P1T-FIX7: the delay actually used (after NaN / cap handling)
  1709	  d["first_diag_default_used"] = diag_default_used;    // P1T-FIX7: the knob could not be read; the default was used
  1710	  return d;
  1711	}
