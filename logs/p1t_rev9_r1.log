    84	    if (!pr.first->present) continue;
    85	    if (dev < 0) {
    86	      dev = pr.first->device;
    87	      first = pr.second;
    88	    } else if (pr.first->device != dev) {
    89	      std::ostringstream os;
    90	      os << "on CUDA device " << pr.first->device << " but operand '" << first << "' is on CUDA device " << dev
