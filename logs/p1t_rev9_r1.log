  1606	// P1T-FIX8, round-8 review finding V8-02 (MINOR), sweep (l) "the last reader at exit": the core exit runner is the last
  1607	// reader of the R7 record in every case. What _dlpack_raise_unraisable RAISES inside the runner (the hook's R7 logging)
  1608	// is acknowledged only when the hook says it wrote the line (_dlpack_exit_report_written); until then a plain-data copy
  1609	// (count, the static site text, device, error) is kept here, and the runner writes it with C stdio if the hook could
  1610	// not (MemoryError building the line, stderr None or raising, the hook interrupted). GIL held for every access (the
  1611	// runner, the hook and the raise all hold it). Prior art: allocation-free last-chance reporting (async-signal-safe
  1612	// logging with POSIX write(2); SQLite's OOM-testing discipline); ours: the acknowledged exit report.
  1613	struct CoreExitReport {
  1614	  bool in_runner = false;  // the exit runner is running (its window)
  1615	  bool unwritten = false;
  1616	  unsigned long long count = 0;
  1617	  const char* what = nullptr;  // a static site string, or nullptr (not named)
  1618	  int device = -1;
  1619	  int error = 0;
  1620	};
  1621	CoreExitReport g_core_exit_report;
  1622	std::atomic<unsigned long long> g_shutdown_log_fallbacks{0};   // exit log lines written by the allocation-free path
  1623	std::atomic<bool> g_test_fail_exit_report{false};              // TEST HOOK (P1T-FIX8 V8-02 tests): one-shot
  1624	
  1625	void dlpack_raise_unraisable() {
  1626	  unsigned long long n = 0;
  1627	  std::string what;
  1628	  int dev = -1, err = 0;
  1629	  const char* raw_what = nullptr;  // P1T-FIX8: the static site text, for the exit report
  1630	  unsigned long long raw_n = 0;
  1631	  int raw_dev = -1, raw_err = 0;
  1632	  dlpack_unreported_unraisable_raw(&raw_n, &raw_what, &raw_dev, &raw_err);
