   317	}  // namespace tcs
     1	// tc_signal T6 small ops (P1T-M4): nearest upsample x k (1-D), reflection pad (1-D), rint. Bit-exact by construction:
     2	// the two gathers move 32-bit words (one load and one store per output element, through unsigned-integer pointers, so
     3	// NaN payloads, signed zeros and subnormals are copied bit for bit), and rint is the math library's rintf (IEEE 754
     4	// roundTiesToEven in the default rounding mode, sign of zero kept, NaN and +-Inf pass through). No fast-math flag, no
     5	// atomic operations: each output element is written by exactly one thread. TensorCUDA core's `round` (half away from
     6	// zero, used by its quantizers) is untouched; rint is a new op here.
     7	//
     8	// Semantics (the shipped Kokoro nodes):
     9	//  * upsample_nearest1d: ONNX Resize mode=nearest, coordinate_transformation_mode=asymmetric, nearest_mode=floor,
    10	//    scales [1, ..., 1, s] with s an integer >= 1: y[..., i] = x[..., floor(i / s)], i in [0, T*s). Integer division is
    11	//    the floor for these non-negative operands, so no float coordinate is ever formed.
    12	//  * reflection_pad1d: ONNX Pad mode=reflect on the last axis (= torch reflection_pad1d): with s = i - pad_begin,
    13	//    y[..., i] = x[..., |s|] for s < 0, x[..., 2(T-1) - s] for s >= T, else x[..., s]. pad_begin, pad_end < T.
    14	//  * rint: ONNX Round (half to even).
    15	//
    16	// Prior art: ONNX operator specs (Resize, Pad, Round); IEEE 754-2008 roundTiesToEven / C99 rint; torch's
    17	// reflection_pad1d and nearest upsample for the same index maps. Ours: nothing beyond the one-thread-per-output CUDA
    18	// mapping (no prior art known to me for anything else here).
    19	#include <cuda_runtime.h>
    20	
    21	#include <algorithm>
    22	#include <cstdint>
    23	#include <sstream>
    24	#include <stdexcept>
    25	#include <string>
    26	
    27	#include "m4_ops.h"
    28	#include "cuda_guard.h"  // P1T-FIX4: shared checked DeviceGuard
    29	#include "tuning.h"
    30	
    31	#ifdef CUDA_API_PER_THREAD_DEFAULT_STREAM
    32	#error "tc_signal queues on the legacy default stream (stream 0); do not build it with --default-stream per-thread"
    33	#endif
    34	
    35	namespace tcs {
    36	
    37	namespace {
    38	
    39	constexpr cudaStream_t kLegacyStream = 0;  // the legacy default stream (TensorCUDA's only stream)
    40	
    41	// P1T-FIX7 (sweep (j), error attribution): the launch check names the device and the kernel, and never claims the
    42	// kernel failed when cudaGetLastError may be reporting an asynchronous error of earlier work (cuda_guard.h
    43	// check_launch_on; FIX6 said "<kernel> failed"). It consumes the slot entry it reports (cuda_guard.h rule 1).
    44	constexpr const char* kPrefix = "tc_signal: ";
    45	
    46	unsigned int grid_for(int64_t total, int block) {
    47	  const int64_t blocks = (total + block - 1) / block;
    48	  return static_cast<unsigned int>(std::max<int64_t>(1, std::min<int64_t>(blocks, tuning::kGridCap)));
    49	}
    50	
    51	// DeviceGuard (makes `device` current for the call, restores the caller's device) is tc_signal's shared, checked guard
    52	// in cuda_guard.h since P1T-FIX4 (this copy ignored the restoring cudaSetDevice's result).
    53	
    54	// y[r, i] = x[r, i / scale]: one thread per output element, a 32-bit word copy.
    55	__global__ void upsample_nearest1d_kernel(const uint32_t* __restrict__ x, uint32_t* __restrict__ y, int64_t total,
    56	                                          int64_t T, int64_t T_out, int64_t scale) {
    57	  for (int64_t i = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; i < total;
    58	       i += static_cast<int64_t>(gridDim.x) * blockDim.x) {
    59	    const int64_t t = i % T_out;
    60	    const int64_t r = i / T_out;
    61	    y[i] = x[r * T + t / scale];
    62	  }
    63	}
    64	
    65	// Reflect pad of the last axis: one thread per output element, a 32-bit word copy.
    66	__global__ void reflection_pad1d_kernel(const uint32_t* __restrict__ x, uint32_t* __restrict__ y, int64_t total,
    67	                                        int64_t T, int64_t T_out, int64_t pad_begin) {
    68	  for (int64_t i = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; i < total;
    69	       i += static_cast<int64_t>(gridDim.x) * blockDim.x) {
    70	    const int64_t t = i % T_out;
    71	    const int64_t r = i / T_out;
    72	    int64_t s = t - pad_begin;
    73	    if (s < 0)
    74	      s = -s;
    75	    else if (s >= T)
    76	      s = 2 * (T - 1) - s;
    77	    y[i] = x[r * T + s];
    78	  }
    79	}
    80	
    81	// y = rintf(x): round half to even (the default rounding mode), sign of zero kept, NaN/Inf pass through.
    82	__global__ void rint_kernel(const float* __restrict__ x, float* __restrict__ y, int64_t n) {
    83	  for (int64_t i = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; i < n;
    84	       i += static_cast<int64_t>(gridDim.x) * blockDim.x)
    85	    y[i] = rintf(x[i]);
    86	}
    87	
    88	}  // namespace
    89	
    90	void upsample_nearest1d_forward(int device, int64_t rows, int64_t T, int64_t scale, const float* x, float* y) {
    91	  DeviceGuard guard(device);
    92	  const int64_t T_out = T * scale;
    93	  const int64_t total = rows * T_out;
    94	  constexpr int B = m4tuning::kCopyBlock;
    95	  upsample_nearest1d_kernel<<<grid_for(total, B), B, 0, kLegacyStream>>>(
    96	      reinterpret_cast<const uint32_t*>(x), reinterpret_cast<uint32_t*>(y), total, T, T_out, scale);
    97	  check_launch_on(kPrefix, "upsample_nearest1d_kernel", device);
    98	  guard.restore();  // P1T-FIX4: success-path restore is checked (raises on failure)
    99	}
   100	
   101	void reflection_pad1d_forward(int device, int64_t rows, int64_t T, int64_t pad_begin, int64_t pad_end, const float* x,
   102	                              float* y) {
   103	  DeviceGuard guard(device);
   104	  const int64_t T_out = T + pad_begin + pad_end;
   105	  const int64_t total = rows * T_out;
   106	  constexpr int B = m4tuning::kCopyBlock;
   107	  reflection_pad1d_kernel<<<grid_for(total, B), B, 0, kLegacyStream>>>(
   108	      reinterpret_cast<const uint32_t*>(x), reinterpret_cast<uint32_t*>(y), total, T, T_out, pad_begin);
   109	  check_launch_on(kPrefix, "reflection_pad1d_kernel", device);
   110	  guard.restore();  // P1T-FIX4
   111	}
   112	
   113	void rint_forward(int device, int64_t n, const float* x, float* y) {
   114	  DeviceGuard guard(device);
   115	  constexpr int B = m4tuning::kCopyBlock;
   116	  rint_kernel<<<grid_for(n, B), B, 0, kLegacyStream>>>(x, y, n);
   117	  check_launch_on(kPrefix, "rint_kernel", device);
   118	  guard.restore();  // P1T-FIX4
