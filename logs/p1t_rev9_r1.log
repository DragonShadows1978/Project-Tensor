   341	// RuntimeError if the current device cannot be read or the switch fails (nothing switched then); restore() is the
   342	// success-path restore and raises if it fails; the destructor restores only when an exception is already unwinding
   343	// (restore() not reached) and counts a failure instead of throwing (no throw from a destructor).
   344	// Prior art: c10::cuda::CUDAGuard / OptionalCUDAGuard (PyTorch; switch, then restore in the destructor with
   345	// C10_CUDA_CHECK_WARN) and cupy.cuda.Device as a context manager (CuPy; __exit__ restores and may raise). Taken: the
   346	// scoped switch-and-restore. Ours: the explicit raising restore() on the success path plus the counting destructor.
   347	class CheckedDeviceGuard {
   348	 public:
   349	  CheckedDeviceGuard(int device, const char* who) : who_(who) {
   350	    cudaError_t e = cudaGetDevice(&prev_);
   351	    if (e != cudaSuccess) raise_cuda_failure(std::string(who_) + ": cudaGetDevice failed", e);
   352	    if (prev_ != device) {
   353	      e = cudaSetDevice(device);
   354	      if (e != cudaSuccess)
   355	        raise_cuda_failure(std::string(who_) + ": cannot make the tensor's CUDA device " + std::to_string(device) +
   356	                               " current (cudaSetDevice failed)",
   357	                           e);
   358	      switched_ = true;
   359	    }
   360	  }
   361	  void restore() {
   362	    if (!switched_) return;
   363	    switched_ = false;
   364	    const cudaError_t e = cudaSetDevice(prev_);
   365	    if (e != cudaSuccess)
   366	      raise_cuda_failure(std::string(who_) + ": restoring the caller's CUDA device " + std::to_string(prev_) +
   367	                             " failed (cudaSetDevice); the work was queued, and the calling thread's current device "
   368	                             "is still the tensor's",
   369	                         e);
   370	  }
   371	  ~CheckedDeviceGuard() {
   372	    if (!switched_) return;
   373	    const cudaError_t e = cudaSetDevice(prev_);
   374	    if (e != cudaSuccess) {
   375	      // P1T-FIX5 (sweep d): recorded before its slot entry is consumed (counted only, before).
   376	      note_core_unraisable("restoring the caller's CUDA device while fill_ unwound after another error (cudaSetDevice)",
   377	                           prev_, e);
   378	      cudaGetLastError();
   379	      g_dlpack_device_restore_failures.fetch_add(1);
   380	    }
   381	  }
   382	  CheckedDeviceGuard(const CheckedDeviceGuard&) = delete;
   383	  CheckedDeviceGuard& operator=(const CheckedDeviceGuard&) = delete;
   384	
   385	 private:
   386	  const char* who_;
   387	  int prev_ = -1;
   388	  bool switched_ = false;
   389	};
