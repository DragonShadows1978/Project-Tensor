    64	enum class Need { kRequired, kOptional };
    65	
    66	Peek4 peek4(py::handle obj, const char* role, int rank, int min_rank, Need need) {
    67	  Peek4 p;
    68	  if (need == Need::kRequired) require_operand(obj, role);  // F02: None is refused here, before any planning
    69	  if (obj.is_none()) return p;
    70	  p.capsule = to_capsule(obj, role, false);
    71	  const DLTensor* t = peek(p.capsule.handle(), role);
    72	  validate_tensor(t, role, rank >= 0 ? rank : t->ndim);  // device, dtype, (rank), non-empty, C-contiguous, aligned
    73	  check_rank(role, t->ndim, rank, min_rank);
    74	  p.shape = shape_of(t);
    75	  p.device = t->device.device_id;
    76	  p.present = true;
    77	  return p;
    78	}
