        elig = vis & np.broadcast_to(rec["statmask"] == 0, code_sel.shape)
        elig_frac = float(elig.sum()) / n_vis
        msg = (f"L={L} S={S} {dtype} rule={rule}: nontie_disagree={int(dis.sum())} ties={int(amb.sum())} "
