    73	void check_cuda(cudaError_t e, const char* what) {
    74	  if (e != cudaSuccess) {
    75	    std::ostringstream os;
    76	    os << "tc_signal.lstm: " << what << " failed: " << cudaGetErrorName(e) << ": " << cudaGetErrorString(e);
    77	    cudaGetLastError();  // P1T-FIX4 (cuda_guard.h rule 1): this raise reports the failed call, so it consumes its entry
    78	    throw std::runtime_error(os.str());
    79	  }
    80	}
    81	
    82	// Checked after every kernel launch and cuBLAS call (launch-configuration and sticky errors surface as RuntimeError).
    83	void check_launch(const char* what) { check_cuda(cudaGetLastError(), what); }
    84	
    85	void check_cublas(cublasStatus_t s, const char* what) {
    86	  if (s != CUBLAS_STATUS_SUCCESS) {
    87	    std::ostringstream os;
    88	    os << "tc_signal.lstm: " << what << " failed: cuBLAS status " << static_cast<int>(s);
    89	    throw std::runtime_error(os.str());
    90	  }
    91	}
    92	
    93	unsigned int grid_for(int64_t total, int block) {
    94	  const int64_t blocks = (total + block - 1) / block;
    95	  return static_cast<unsigned int>(std::max<int64_t>(1, std::min<int64_t>(blocks, lstm_tuning::kGridCap)));
    96	}
    97	
    98	// DeviceGuard (makes `device` current for the call, restores the caller's device) is tc_signal's shared, checked guard
    99	// in cuda_guard.h since P1T-FIX4 (this copy ignored the restoring cudaSetDevice's result).
   100	
   101	// cuBLAS handle: one per device, created lazily on first use and kept for the life of the process (destroying it at
   102	// interpreter exit can race CUDA's own teardown), with M2's exact settings: legacy stream, CUBLAS_DEFAULT_MATH (never
   103	// TF32), atomics not allowed, pointer mode host. M2's handle_for() in conv.cu has internal linkage and the order
   104	// forbids editing conv.cu, so the LSTM keeps its own handle (deviation, P1T_M3_REPORT.md). All entry points run under
   105	// the GIL, so no extra lock is needed. cuBLAS allocates its own internal workspace for this handle (cudaMalloc inside
   106	// cuBLAS); that is the only device memory the LSTM causes to be allocated outside the caller's allocator.
   107	cublasHandle_t lstm_handle_for(int device) {
   108	  static std::unordered_map<int, cublasHandle_t> handles;
   109	  auto it = handles.find(device);
   110	  if (it != handles.end()) return it->second;
   111	  cublasHandle_t h = nullptr;
   112	  check_cublas(cublasCreate(&h), "cublasCreate");
   113	  // P1T-FIX5, round-5 review finding V5-03 (MINOR), same fix as conv.cu handle_for: the new handle is owned from creation
   114	  // until the cache insertion commits; on any exception before the commit (handles.emplace throwing std::bad_alloc was
   115	  // the leak: review probe handle_insert_oom_cpu.cpp, creates 1, destroys 0) the owner destroys it, checks the status
   116	  // and counts a failure without throwing during unwinding. A failed setting still destroys it explicitly and names the
   117	  // status (FIX4), clearing `h` first so it is destroyed once. Prior art: RAII and the scope guard with dismissal on
   118	  // commit (Alexandrescu & Marginean, C/C++ Users Journal, 2000); see conv.cu.
   119	  struct NewHandleOwner {
   120	    cublasHandle_t& h;
   121	    ~NewHandleOwner() {
   122	      if (h == nullptr) return;  // committed to the cache, or already destroyed by settle
   123	      const cublasStatus_t ds = cublasDestroy(h);
   124	      if (ds != CUBLAS_STATUS_SUCCESS) note_cublas_handle_destroy_failure(static_cast<int>(ds));
   125	    }
   126	  } owned{h};
   127	  // P1T-FIX4 (sweep): a setting that fails no longer leaks the new handle: it is destroyed (on this device, which the
   128	  // caller's DeviceGuard keeps current), the destroy's own status is checked and named, and the call raises. Nothing is
   129	  // cached, so the next call retries from cublasCreate.
   130	  auto settle = [&h](cublasStatus_t st, const char* what) {
   131	    if (st == CUBLAS_STATUS_SUCCESS) return;
   132	    const cublasStatus_t ds = cublasDestroy(h);
   133	    h = nullptr;  // P1T-FIX5: destroyed here; the owner must not destroy it again
   134	    std::ostringstream os;
   135	    os << "tc_signal.lstm: " << what << " failed: cuBLAS status " << static_cast<int>(st);
   136	    if (ds != CUBLAS_STATUS_SUCCESS) os << "; destroying the new handle also failed: cuBLAS status " << static_cast<int>(ds);
   137	    throw std::runtime_error(os.str());
   138	  };
   139	  settle(cublasSetStream(h, kLegacyStream), "cublasSetStream(0)");
   140	  settle(cublasSetMathMode(h, CUBLAS_DEFAULT_MATH), "cublasSetMathMode(CUBLAS_DEFAULT_MATH)");
   141	  settle(cublasSetAtomicsMode(h, CUBLAS_ATOMICS_NOT_ALLOWED), "cublasSetAtomicsMode(NOT_ALLOWED)");
   142	  settle(cublasSetPointerMode(h, CUBLAS_POINTER_MODE_HOST), "cublasSetPointerMode(HOST)");
   143	  handles.emplace(device, h);  // may throw (host allocation): `owned` destroys h, nothing is cached
   144	  const cublasHandle_t cached = h;
   145	  h = nullptr;  // committed: the cache owns the handle now
   146	  return cached;
   147	}
   148	
   149	// ------------------------------------------------------------------------------------------------ device functions
   150	// Logistic sigmoid, stable for large |z|: exp is only ever evaluated at a non-positive argument, so it never overflows
   151	// (z >= 0: 1 / (1 + e^{-z}); z < 0: e^{z} / (1 + e^{z})). expf is the CUDA math library's accurate expf (2 ulp max),
   152	// never the fast intrinsic. Prior art: the standard sign split (see the file header).
   153	__device__ __forceinline__ float sigmoid_stable(float z) {
   154	  if (z >= 0.0f) return 1.0f / (1.0f + expf(-z));
   155	  const float e = expf(z);
   156	  return e / (1.0f + e);
   157	}
   158	
   159	// ------------------------------------------------------------------------------------------------ kernels
   160	// G_x[d, r, q] = Wb[d, q] for every projected row r in [0, T*N) and q in [0, 4H): the bias the input-projection GEMM
   161	// then accumulates onto (beta = 1). One thread per element, a plain copy.
   162	__global__ void lstm_bias_fill_kernel(float* __restrict__ gx, const float* __restrict__ B, int64_t D, int64_t rows,
   163	                                      int64_t H4, int64_t bias_row) {
   164	  const int64_t total = D * rows * H4;
   165	  for (int64_t i = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; i < total;
   166	       i += static_cast<int64_t>(gridDim.x) * blockDim.x) {
   167	    const int64_t q = i % H4;
   168	    const int64_t d = i / (rows * H4);
   169	    gx[i] = B[d * bias_row + q];
   170	  }
   171	}
   172	
   173	// One LSTM step for every direction slot at once; one thread per state element idx = (d*N + n)*H + j.
   174	//   gx: G_x [D, T, N, 4H] (x . W^T + Wb); gh: G_h [D, N, 4H] (h_{t-1} . R^T for this step); B: [D, 8H] or NULL;
   175	//   h / c: the state [D, N, H] (= Y_h / Y_c), read and written in place by the owning thread only; Y [T, D, N, H].
   176	// Fixed per-element operation order: z = (gx + gh) + Rb; c = fmaf(f, c_prev, i * c~); h = o * tanhf(c).
   177	__global__ void lstm_cell_kernel(const float* __restrict__ gx, const float* __restrict__ gh,
   178	                                 const float* __restrict__ B, float* __restrict__ h, float* __restrict__ c,
   179	                                 float* __restrict__ Y, int64_t T, int64_t s, int64_t D, int64_t N, int64_t H,
   180	                                 int64_t first_reverse) {
   181	  const int64_t H4 = kLstmGates * H;
   182	  const int64_t total = D * N * H;
   183	  for (int64_t idx = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; idx < total;
   184	       idx += static_cast<int64_t>(gridDim.x) * blockDim.x) {
   185	    const int64_t j = idx % H;
   186	    const int64_t r = idx / H;
   187	    const int64_t n = r % N;
   188	    const int64_t d = r / N;
   189	    const int64_t tt = (d >= first_reverse) ? (T - 1 - s) : s;   // the reverse slot walks time backwards
   190	    const float* gxp = gx + ((d * T + tt) * N + n) * H4;
   191	    const float* ghp = gh + (d * N + n) * H4;
   192	    float zi = gxp[kGateI * H + j] + ghp[kGateI * H + j];
   193	    float zo = gxp[kGateO * H + j] + ghp[kGateO * H + j];
   194	    float zf = gxp[kGateF * H + j] + ghp[kGateF * H + j];
   195	    float zc = gxp[kGateC * H + j] + ghp[kGateC * H + j];
   196	    if (B != nullptr) {
   197	      const float* rb = B + d * (kLstmBiasHalves * H4) + H4;     // Rb[d] = B[d, 4H:8H]
   198	      zi = zi + rb[kGateI * H + j];
   199	      zo = zo + rb[kGateO * H + j];
   200	      zf = zf + rb[kGateF * H + j];
   201	      zc = zc + rb[kGateC * H + j];
   202	    }
   203	    const float ig = sigmoid_stable(zi);
   204	    const float og = sigmoid_stable(zo);
   205	    const float fg = sigmoid_stable(zf);
   206	    const float cg = tanhf(zc);
   207	    const float cn = fmaf(fg, c[idx], ig * cg);
   208	    const float hn = og * tanhf(cn);
   209	    c[idx] = cn;
   210	    h[idx] = hn;
   211	    Y[((tt * D + d) * N + n) * H + j] = hn;
   212	  }
   213	}
   214	
   215	}  // namespace
   216	
   217	// ------------------------------------------------------------------------------------------------ LSTM forward
   218	void lstm_forward(int device, const LstmGeom& g, const float* x, const float* W, const float* R, const float* B,
   219	                  const float* h0, const float* c0, float* Y, float* Y_h, float* Y_c, float* scratch) {
   220	  DeviceGuard guard(device);
   221	  cublasHandle_t hdl = lstm_handle_for(device);
   222	  const int64_t H4 = kLstmGates * g.H;
   223	  const int64_t rows = g.T * g.N;                 // projected rows, r = t*N + n
   224	  const int64_t state = g.D * g.N * g.H;          // elements of Y_h / Y_c
   225	  const size_t state_bytes = static_cast<size_t>(state) * sizeof(float);
   226	  float* gx = scratch;                            // [D, T, N, 4H]
   227	  float* gh = scratch + lstm_gx_numel(g);         // [D, N, 4H]
   228	  const float one = 1.0f;
   229	  const float zero = 0.0f;
   230	
   231	  // 1. Initial state into the outputs that carry the recurrence.
   232	  if (h0 != nullptr)
   233	    check_cuda(cudaMemcpyAsync(Y_h, h0, state_bytes, cudaMemcpyDeviceToDevice, kLegacyStream), "initial_h copy");
   234	  else
   235	    check_cuda(cudaMemsetAsync(Y_h, 0, state_bytes, kLegacyStream), "initial_h zero");
   236	  if (c0 != nullptr)
   237	    check_cuda(cudaMemcpyAsync(Y_c, c0, state_bytes, cudaMemcpyDeviceToDevice, kLegacyStream), "initial_c copy");
   238	  else
   239	    check_cuda(cudaMemsetAsync(Y_c, 0, state_bytes, kLegacyStream), "initial_c zero");
   240	
   241	  // 2. Input projection of all steps, one SGEMM per direction (+ Wb through beta = 1 on the pre-filled buffer).
   242	  //    Row-major G_x[d][rows, 4H] = X[rows, I] . W[d][4H, I]^T, as the column-major product
   243	  //    G_x^T[4H, rows] = op_T(W_d viewed [I, 4H], ld I) . X^T[I, rows] (ld I): m = 4H, n = rows, k = I, ldc = 4H.
   244	  float beta_x = zero;
   245	  if (B != nullptr) {
   246	    const int64_t total = g.D * rows * H4;
   247	    lstm_bias_fill_kernel<<<grid_for(total, lstm_tuning::kBiasFillBlock), lstm_tuning::kBiasFillBlock, 0,
   248	                            kLegacyStream>>>(gx, B, g.D, rows, H4, kLstmBiasHalves * H4);
   249	    check_launch("lstm_bias_fill_kernel");
   250	    beta_x = one;
   251	  }
   252	  for (int64_t d = 0; d < g.D; ++d) {
   253	    check_cublas(cublasSgemm(hdl, CUBLAS_OP_T, CUBLAS_OP_N, static_cast<int>(H4), static_cast<int>(rows),
   254	                             static_cast<int>(g.I), &one, W + d * H4 * g.I, static_cast<int>(g.I), x,
   255	                             static_cast<int>(g.I), &beta_x, gx + d * rows * H4, static_cast<int>(H4)),
   256	                 "cublasSgemm (input projection)");
   257	    check_launch("cublasSgemm (input projection)");
   258	  }
   259	
   260	  // 3. The recurrence: a host loop over steps inside this one call. Per step, one strided-batched SGEMM over the D
   261	  //    slots, G_h[d][N, 4H] = h[d][N, H] . R[d][4H, H]^T (column-major: m = 4H, n = N, k = H, op_T on R viewed
   262	  //    [H, 4H] ld H, h viewed [H, N] ld H, ldc = 4H), then the fused cell kernel. Stream order makes step s+1's GEMM
   263	  //    read the h that step s's cell kernel wrote.
   264	  const unsigned int cell_grid = grid_for(state, lstm_tuning::kCellBlock);
   265	  for (int64_t s = 0; s < g.T; ++s) {
   266	    check_cublas(cublasSgemmStridedBatched(hdl, CUBLAS_OP_T, CUBLAS_OP_N, static_cast<int>(H4), static_cast<int>(g.N),
   267	                                           static_cast<int>(g.H), &one, R, static_cast<int>(g.H),
   268	                                           static_cast<long long>(H4 * g.H), Y_h, static_cast<int>(g.H),
   269	                                           static_cast<long long>(g.N * g.H), &zero, gh, static_cast<int>(H4),
   270	                                           static_cast<long long>(g.N * H4), static_cast<int>(g.D)),
   271	                 "cublasSgemmStridedBatched (recurrent)");
   272	    check_launch("cublasSgemmStridedBatched (recurrent)");
   273	    lstm_cell_kernel<<<cell_grid, lstm_tuning::kCellBlock, 0, kLegacyStream>>>(gx, gh, B, Y_h, Y_c, Y, g.T, s, g.D,
   274	                                                                                 g.N, g.H, g.first_reverse);
   275	    check_launch("lstm_cell_kernel");
   276	  }
   277	  guard.restore();  // P1T-FIX4: success-path restore is checked (raises on failure)
   278	}
   279	
   280	// ------------------------------------------------------------------------------------------------ introspection
   281	LstmCublasConfig lstm_cublas_config(int device) {
   282	  DeviceGuard guard(device);
   283	  cublasHandle_t h = lstm_handle_for(device);
   284	  cublasMath_t math;
   285	  cublasAtomicsMode_t atomics;
   286	  cublasPointerMode_t pmode;
   287	  cudaStream_t s;
   288	  check_cublas(cublasGetMathMode(h, &math), "cublasGetMathMode");
   289	  check_cublas(cublasGetAtomicsMode(h, &atomics), "cublasGetAtomicsMode");
   290	  check_cublas(cublasGetPointerMode(h, &pmode), "cublasGetPointerMode");
   291	  check_cublas(cublasGetStream(h, &s), "cublasGetStream");
   292	  LstmCublasConfig c;
   293	  c.math_mode = static_cast<int>(math);
   294	  c.atomics_mode = static_cast<int>(atomics);
   295	  c.pointer_mode = static_cast<int>(pmode);
   296	  c.legacy_stream = (s == kLegacyStream);
   297	  c.default_math = (math == CUBLAS_DEFAULT_MATH);
   298	  c.atomics_not_allowed = (atomics == CUBLAS_ATOMICS_NOT_ALLOWED);
   299	  guard.restore();  // P1T-FIX4
   300	  return c;
   301	}
