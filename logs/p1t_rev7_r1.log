   447	Storage::~Storage() {
   448	  if (external_release) {
   449	    // Imported (DLPack) memory belongs to its producer: never cudaFree it and
   450	    // never hand it to the pool. ORDER MATTERS:
   451	    //  1. Drain the engine stream. Every engine kernel, cuBLAS call and
   452	    //     cudaMemcpy runs on stream 0 (the legacy default stream; this TU is
   453	    //     built without --default-stream per-thread), so once it is idle no
   454	    //     queued engine work can still read or write this memory. The engine
   455	    //     keeps no per-Storage "last use" event, so "everything queued so far"
   456	    //     is the only sound fence; an event recorded here and waited on would
   457	    //     cover exactly the same work at three API calls instead of one. A
   458	    //     deferred release (host callback) is not allowed to run the
   459	    //     producer's deleter, which may call CUDA (torch's caching allocator).
   460	    //  2. Then hand the memory back (the DLPack deleter, GIL held, in
   461	    //     bindings.cpp). A producer may reuse it at once on its own stream.
   462	    // Prior art: the DLPack deleter contract (dmlc/dlpack, 2017+) and the
   463	    // array API's stream rules (2021+); the drain-then-delete order is the
   464	    // standard CUDA "free only after last use" rule. Ours: its placement in
   465	    // the Storage destructor.
   466	    // P1T-FIX1 F05: drain THIS Storage's device (drain_device_legacy_stream
   467	    // above); if the drain fails, deliberately leak instead of releasing.
   468	    if (device.is_cuda() && !drain_device_legacy_stream(device.index)) {
   469	      g_external_drain_leaks.fetch_add(1);
   470	      return;
   471	    }
   472	    external_release(external_ctx);
   473	    return;
   474	  }
   475	  if (!ptr) return;
   476	  if (device.is_cuda()) {
   477	    if (pooled) cudaFreeAsync(ptr, 0);
   478	    else cudaFree(ptr);
   479	  } else {
   480	    std::free(ptr);
   481	  }
   482	}
