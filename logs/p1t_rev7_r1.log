    57	// ------------------------------------------------------------------------------------------------ Conv1d plan
    58	struct Conv1dPlan {
    59	  Conv1dGeom g;
    60	  std::vector<int64_t> out_shape;
    61	  int64_t scratch_numel;
    62	};
    63	
    64	Conv1dPlan plan_conv1d(const std::vector<int64_t>& xs, const std::vector<int64_t>& ws, const std::vector<int64_t>* bs,
    65	                       int64_t stride, int64_t pb, int64_t pe, int64_t dilation, int64_t groups) {
    66	  check_attr("stride", stride, 1);
    67	  check_attr("dilation", dilation, 1);
    68	  check_attr("groups", groups, 1);
    69	  check_attr("pad_begin", pb, 0);
    70	  check_attr("pad_end", pe, 0);
    71	  Conv1dPlan p{};
    72	  Conv1dGeom& g = p.g;
    73	  g.N = xs[0];
    74	  g.C_in = xs[1];
    75	  g.T = xs[2];
    76	  g.C_out = ws[0];
    77	  g.K = ws[2];
    78	  g.stride = stride;
    79	  g.pad_begin = pb;
    80	  g.pad_end = pe;
    81	  g.dilation = dilation;
    82	  g.groups = groups;
    83	  std::ostringstream os;
    84	  if (g.C_in % groups != 0) {
    85	    os << "conv1d: C_in (" << g.C_in << ") is not divisible by groups (" << groups << ")";
    86	    bad_attr(os.str());
    87	  }
    88	  if (ws[1] != g.C_in / groups) {
    89	    os << "conv1d: w.shape[1] (" << ws[1] << ") != C_in/groups (" << g.C_in / groups << "); w is [C_out, C_in/groups, K]";
    90	    bad_attr(os.str());
    91	  }
    92	  if (g.C_out % groups != 0) {
    93	    os << "conv1d: C_out (" << g.C_out << ") is not divisible by groups (" << groups << ")";
    94	    bad_attr(os.str());
    95	  }
    96	  if (bs != nullptr && (bs->size() != 1 || (*bs)[0] != g.C_out)) {
    97	    os << "conv1d: b has shape " << shape_str(*bs) << ", expected [" << g.C_out << "]";
    98	    bad_attr(os.str());
    99	  }
   100	  // Integer arithmetic in int64, every step checked (F03: dimensions may come from synthetic descriptors). Python's
   101	  // floor division and C++'s truncation differ for a negative numerator, so the sign is checked first.
   102	  const int64_t dk = ck_mul(dilation, g.K - 1, "conv1d: dilation*(K-1)");
   103	  int64_t num = ck_add(g.T, pb, "conv1d: T + pad_begin");
   104	  num = ck_add(num, pe, "conv1d: T + pad_begin + pad_end");
   105	  num = ck_sub(num, dk, "conv1d: output length numerator");
   106	  num = ck_sub(num, 1, "conv1d: output length numerator");
   107	  if (num < 0) {
   108	    os << "conv1d: output length (T + pb + pe - dilation*(K-1) - 1)//stride + 1 = (" << g.T << " + " << pb << " + "
   109	       << pe << " - " << dilation << "*" << (g.K - 1) << " - 1)//" << stride << " + 1 is <= 0";
   110	    bad_attr(os.str());
   111	  }
   112	  g.T_out = num / stride + 1;
   113	  g.direct = (g.K == 1 && stride == 1 && pb == 0 && pe == 0);
   114	  const int64_t Og = g.C_out / groups;
   115	  const int64_t CgK = (g.C_in / groups) * g.K;
   116	  check_int_range("T_out", g.T_out);
   117	  check_int_range("C_out/groups", Og);
   118	  check_int_range("C_in/groups*K", CgK);
   119	  p.out_shape = {g.N, g.C_out, g.T_out};
   120	  ck_shape_numel(p.out_shape, "conv1d: output size N*C_out*T_out");
   121	  p.scratch_numel =
   122	      g.direct ? 0 : ck_mul(ck_mul(g.C_in, g.K, "conv1d: im2col rows C_in*K"), g.T_out, "conv1d: im2col scratch size");
   123	  ck_fp32_bytes(p.scratch_numel, "conv1d: im2col scratch bytes");
   124	  return p;
   125	}
