  1147	int64_t aggregate_operand_bytes(const std::vector<Operand*>& ops) {
  1148	  // V3-02 (see dlpack_operand.h): checked sum of the present operands' fp32 bytes; ValueError on overflow (ck_add).
  1149	  // Prior art: the checked builtins (GCC 5 __builtin_add_overflow, 2015; C23 ckd_add), as in checked_math.h. Ours:
  1150	  // checking the per-call aggregate before the first launch, where a refusal can still raise.
