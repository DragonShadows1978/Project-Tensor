   332	void divide_probe(py::object x, py::object y, py::object out) {
   333	  drain_completed();
   334	  require_operand(x, "x");
   335	  require_operand(y, "y");
   336	  require_operand(out, "out");
   337	  Operand X(to_capsule(x, "x", false).handle(), "x", 1, false);
   338	  Operand Y(to_capsule(y, "y", false).handle(), "y", 1, false);
   339	  Operand O(to_capsule(out, "out", true).handle(), "out", 1, true);
   340	  expect_shape(Y, {X.dim(0)});
   341	  expect_shape(O, {X.dim(0)});
   342	  const int device = common_device({&X, &Y, &O});
   343	  expect_disjoint(O, X);
   344	  expect_disjoint(O, Y);
   345	  RetainUntilComplete keep(device, {&X, &Y, &O});  // F01
   346	  fp32_divide_probe(device, X.data(), Y.data(), O.data(), X.dim(0));
   347	}
