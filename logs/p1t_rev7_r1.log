   595	void fill_(NDArray& a, double value) {
   596	  if (!a.defined()) throw std::runtime_error("fill_: undefined array");
   597	  if (!a.device.is_cuda()) throw std::runtime_error("fill_: CUDA arrays only");
   598	  if (a.dtype != DType::Float32 && a.dtype != DType::Float16 && a.dtype != DType::BFloat16)
   599	    throw std::runtime_error("op supports float32/float16/bfloat16 only");
   600	  int64_t n = a.numel();
   601	  if (n == 0) return;
   602	  const int64_t blocks = fill_grid_blocks(n);  // P1T-FIX5 V5-04: int64 block count; refused here if over the limit
   603	  const std::string mismatch = cuda_storage_device_mismatch(a, "fill_");
   604	  if (!mismatch.empty()) throw std::runtime_error(mismatch);
   605	  CheckedDeviceGuard guard(a.device.index, "fill_");
   606	  const cudaError_t pending = cudaGetLastError();
   607	  if (pending != cudaSuccess)
   608	    throw std::runtime_error(std::string("fill_: a CUDA error was already pending in this thread before the launch (") +
   609	                             cudaGetErrorName(pending) + ": " + cudaGetErrorString(pending) +
   610	                             "), from earlier work outside this call; taken from the error slot and reported here, nothing was launched");
   611	  DISPATCH_FLOAT(a.dtype, T, {
   612	    // P1T-FIX5 V5-04: blocks <= 2^31-1 (checked above), so this conversion is exact and blocks * kT >= n.
   613	    fill_kernel<T><<<static_cast<unsigned int>(blocks), kT>>>(static_cast<T*>(a.data_ptr()), n, (float)value);
   614	  });
   615	  cuda_check_last("fill_");
   616	  a.mark_modified();  // the write is queued: bump the revision BEFORE a restore failure can raise
   617	  guard.restore();
   618	}
