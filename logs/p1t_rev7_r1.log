   107	py::object grad_of(Tensor& t) {
   108	  if (!t.v->grad.defined()) return py::none();
   109	  return py::cast(Tensor::make(t.v->grad, false));
   110	}
   111	
   112	py::tuple tensor_args(const std::vector<Tensor>& inputs) {
   113	  py::tuple args(inputs.size());
   114	  for (size_t i = 0; i < inputs.size(); ++i) args[i] = py::cast(inputs[i]);
   115	  return args;
   116	}
   117	
   118	Tensor checkpoint_py(py::function fn, std::vector<Tensor> inputs) {
   119	  bool any_req = false;
   120	  for (auto& t : inputs) any_req = any_req || t.requires_grad();
   121	  bool req = grad_enabled() && any_req;
   122	  if (!req) {
   123	    py::object obj = fn(*tensor_args(inputs));
   124	    return obj.cast<Tensor>();
   125	  }
   126	
   127	  py::object obj;
   128	  {
   129	    NoGradGuard guard;
   130	    obj = fn(*tensor_args(inputs));
   131	  }
   132	  Tensor out0 = obj.cast<Tensor>();
   133	  NDArray out_data = out0.data();
   134	
   135	  return Tensor::from_op(out_data, inputs, "checkpoint",
   136	      [fn, inputs](const NDArray& g) {
   137	        py::gil_scoped_acquire gil;
   138	
   139	        std::vector<Tensor> replay_inputs;
   140	        replay_inputs.reserve(inputs.size());
   141	        for (auto& t : inputs) {
   142	          replay_inputs.push_back(Tensor::make(t.data(), t.requires_grad()));
   143	        }
   144	
   145	        bool prev = grad_enabled();
   146	        set_grad_enabled(true);
   147	        py::object replay_obj;
   148	        try {
   149	          // Prior art: CUDA event scopes (NVIDIA; see bp_op_timing.h).
   150	          bp::Scope replay_scope("checkpoint_replay");
   151	          replay_obj = fn(*tensor_args(replay_inputs));
   152	        } catch (...) {
   153	          set_grad_enabled(prev);
   154	          throw;
   155	        }
   156	        Tensor replay_out = replay_obj.cast<Tensor>();
   157	        try {
   158	          replay_out.backward(g);
   159	        } catch (...) {
   160	          set_grad_enabled(prev);
   161	          throw;
   162	        }
   163	        set_grad_enabled(prev);
   164	
   165	        for (size_t i = 0; i < inputs.size(); ++i) {
   166	          if (inputs[i].requires_grad() && replay_inputs[i].grad().defined()) {
   167	            inputs[i].v->accumulate_grad(replay_inputs[i].grad());
   168	          }
   169	        }
   170	      });
   171	}
   172	
   173	// __getitem__ for ints and unit-step slices (single key or per-dim tuple),
   174	// composed from the differentiable slice/squeeze ops.
   175	Tensor getitem(Tensor& t, py::object key) {
   176	  std::vector<py::object> keys;
   177	  if (py::isinstance<py::tuple>(key))
   178	    for (auto k : key.cast<py::tuple>()) keys.push_back(py::reinterpret_borrow<py::object>(k));
   179	  else
   180	    keys.push_back(key);
   181	
   182	  Tensor cur = t;
   183	  int dim = 0;
   184	  for (auto& k : keys) {
   185	    if (py::isinstance<py::int_>(k)) {
   186	      int64_t i = k.cast<int64_t>();
   187	      int64_t sz = cur.shape()[dim];
   188	      if (i < 0) i += sz;
   189	      cur = ops::squeeze(ops::slice(cur, dim, i, 1), dim);  // dim removed; keep `dim`
   190	    } else if (py::isinstance<py::slice>(k)) {
   191	      size_t start, stop, step, len;
   192	      k.cast<py::slice>().compute(cur.shape()[dim], &start, &stop, &step, &len);
   193	      if (step != 1) throw std::runtime_error("getitem: only step==1 slices supported");
   194	      cur = ops::slice(cur, dim, (int64_t)start, (int64_t)len);
   195	      ++dim;
   196	    } else {
   197	      throw std::runtime_error("getitem: unsupported index type");
   198	    }
   199	  }
   200	  return cur;
   201	}
   202	
   203	std::vector<TerrainRenderObject> terrain_objects_from_python(
   204	    const py::object& objects) {
   205	  std::vector<TerrainRenderObject> parsed;
   206	  if (objects.is_none()) return parsed;
   207	  if (!py::isinstance<py::list>(objects)) {
   208	    throw std::runtime_error("terrain_render: objects must be a list or None");
   209	  }
   210	  const py::list entries = py::reinterpret_borrow<py::list>(objects);
   211	  if (entries.size() > 16) {
   212	    throw std::runtime_error("terrain_render: objects supports at most 16 entries");
   213	  }
   214	  parsed.reserve(entries.size());
   215	  for (py::ssize_t index = 0; index < entries.size(); ++index) {
   216	    const py::handle entry = entries[index];
   217	    if ((!py::isinstance<py::tuple>(entry) &&
   218	         !py::isinstance<py::list>(entry)) ||
   219	        py::len(entry) != 3) {
   220	      throw std::runtime_error(
   221	          "terrain_render: each object must be (grid, origin, palette)");
   222	    }
   223	    const py::sequence terms = py::reinterpret_borrow<py::sequence>(entry);
   224	    Tensor grid = py::cast<Tensor>(terms[0]);
   225	    const std::vector<float> origin =
   226	        py::cast<std::vector<float>>(terms[1]);
   227	    Tensor palette = py::cast<Tensor>(terms[2]);
   228	    if (origin.size() != 3 || !std::isfinite(origin[0]) ||
   229	        !std::isfinite(origin[1]) || !std::isfinite(origin[2])) {
   230	      throw std::runtime_error(
   231	          "terrain_render: object origin must be a finite three-vector");
   232	    }
   233	    TerrainRenderObject object{};
   234	    object.grid = grid.data();
   235	    object.origin[0] = origin[0];
   236	    object.origin[1] = origin[1];
   237	    object.origin[2] = origin[2];
   238	    object.palette = palette.data();
   239	    parsed.push_back(std::move(object));
   240	  }
   241	  return parsed;
   242	}
