   582	int64_t fill_grid_blocks(int64_t n) {
   583	  const int64_t blocks = n / kT + (n % kT != 0 ? 1 : 0);  // ceil(n / kT) for n >= 1, without forming n + kT - 1
   584	  if (blocks > kFillMaxGridX)
   585	    throw std::invalid_argument(
   586	        "fill_: " + std::to_string(n) + " elements need " + std::to_string(blocks) + " blocks of " +
   587	        std::to_string(kT) + " threads, more than the CUDA grid x-dimension limit of " +
   588	        std::to_string(kFillMaxGridX) + " (2^31-1) blocks; fill_ launches one thread per element (the existing "
   589	        "fill_kernel), so it covers at most " + std::to_string(kFillMaxGridX * kT) +
   590	        " elements. Refused before any launch: nothing was written and the revision is unchanged");
   591	  return blocks;
   592	}
