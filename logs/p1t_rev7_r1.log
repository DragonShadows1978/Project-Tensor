        _C._test_inject(Recorder())                                     # acd42fa: __len__ / __getitem__ called
    with pytest.raises(TypeError):
        _C._test_inject([Recorder()])
    assert Recorder.CALLS == []
    assert _C._test_inject(RecordingTuple(('clear',))) == 0 and Recorder.CALLS == []


