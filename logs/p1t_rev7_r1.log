   238	// ------------------------------------------------------------------------------------------------ Conv1d entry points
   239	py::tuple conv1d_plan(py::object x, py::object w, py::object b, int64_t stride, int64_t pb, int64_t pe,
   240	                      int64_t dilation, int64_t groups) {
   241	  drain_completed();
   242	  require_operand(x, "x");
   243	  require_operand(w, "w");
   244	  Peeked X = peek_operand(x, "x", 3);
   245	  Peeked W = peek_operand(w, "w", 3);
   246	  Peeked B;
   247	  const bool has_b = !b.is_none();
   248	  if (has_b) B = peek_operand(b, "b", 1);
   249	  same_device_peeked({&X, &W, has_b ? &B : nullptr}, {"x", "w", "b"});
   250	  Conv1dPlan p = plan_conv1d(X.shape, W.shape, has_b ? &B.shape : nullptr, stride, pb, pe, dilation, groups);
   251	  return py::make_tuple(X.capsule.object(), W.capsule.object(), has_b ? B.capsule.object() : py::none(),
   252	                        to_tuple(p.out_shape), py::int_(p.scratch_numel));
   253	}
   254	
   255	void conv1d_run(py::object xc, py::object wc, py::object bc, py::object out, py::object scratch, int64_t stride,
   256	                int64_t pb, int64_t pe, int64_t dilation, int64_t groups) {
   257	  drain_completed();
   258	  require_operand(xc, "x");
   259	  require_operand(wc, "w");
   260	  require_operand(out, "out");
   261	  Operand X(xc, "x", 3, false);
   262	  Operand W(wc, "w", 3, false);
   263	  Operand B;
   264	  if (!bc.is_none()) B = Operand(bc, "b", 1, false);
   265	  std::vector<int64_t> bshape;
   266	  if (B.present()) bshape = op_shape(B);
   267	  const std::vector<int64_t> xshape = op_shape(X);
   268	  const std::vector<int64_t> wshape = op_shape(W);
   269	  Conv1dPlan p = plan_conv1d(xshape, wshape, B.present() ? &bshape : nullptr, stride, pb, pe, dilation, groups);
   270	  Operand Y(to_capsule(out, "out", true).handle(), "out", 3, true);
   271	  expect_shape(Y, p.out_shape);
   272	  Operand S;
   273	  if (p.scratch_numel > 0) {
   274	    if (scratch.is_none()) bad_attr("conv1d: this call needs an im2col scratch operand and none was passed");
   275	    S = Operand(to_capsule(scratch, "scratch", true).handle(), "scratch", 1, true);
   276	    expect_shape(S, {p.scratch_numel});
   277	  } else if (!scratch.is_none()) {
   278	    bad_attr("conv1d: this call needs no scratch (K == 1, stride 1, no pads) but one was passed");
   279	  }
   280	  const int device = common_device({&X, &W, &B, &Y, &S});
   281	  for (const Operand* in : {&X, &W, &B, &S}) expect_disjoint(Y, *in);
   282	  for (const Operand* in : {&X, &W, &B}) expect_disjoint(S, *in);
   283	  // F01: every consumed manager stays alive until the legacy stream has passed these launches (also when a launch
   284	  // throws part-way); the producer deleters run later, from drain_completed / synchronize / atexit.
   285	  RetainUntilComplete keep(device, {&X, &W, &B, &Y, &S});
   286	  conv1d_forward(device, p.g, X.data(), W.data(), B.present() ? B.data() : nullptr, Y.data(),
   287	                 S.present() ? S.data() : nullptr);
   288	}
