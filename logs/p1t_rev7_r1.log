   127	// ------------------------------------------------------------------------------------------------ ConvTranspose1d plan
   128	struct ConvTranspose1dPlan {
   129	  ConvTranspose1dGeom g;
   130	  std::vector<int64_t> out_shape;
   131	};
   132	
   133	ConvTranspose1dPlan plan_conv_transpose1d(const std::vector<int64_t>& xs, const std::vector<int64_t>& ws,
   134	                                          const std::vector<int64_t>* bs, int64_t stride, int64_t pb, int64_t pe,
   135	                                          int64_t output_padding, int64_t dilation, int64_t groups) {
   136	  check_attr("stride", stride, 1);
   137	  check_attr("dilation", dilation, 1);
   138	  check_attr("groups", groups, 1);
   139	  check_attr("pad_begin", pb, 0);
   140	  check_attr("pad_end", pe, 0);
   141	  check_attr("output_padding", output_padding, 0);
   142	  std::ostringstream os;
   143	  if (output_padding >= std::max(stride, dilation)) {
   144	    os << "conv_transpose1d: output_padding (" << output_padding << ") must be < max(stride, dilation) ("
   145	       << std::max(stride, dilation) << ")";
   146	    bad_attr(os.str());
   147	  }
   148	  ConvTranspose1dPlan p{};
   149	  ConvTranspose1dGeom& g = p.g;
   150	  g.N = xs[0];
   151	  g.C_in = xs[1];
   152	  g.T = xs[2];
   153	  g.K = ws[2];
   154	  g.stride = stride;
   155	  g.pad_begin = pb;
   156	  g.pad_end = pe;
   157	  g.output_padding = output_padding;
   158	  g.dilation = dilation;
   159	  g.groups = groups;
   160	  if (ws[0] != g.C_in) {
   161	    os << "conv_transpose1d: w.shape[0] (" << ws[0] << ") != C_in (" << g.C_in
   162	       << "); w is [C_in, C_out/groups, K] (ONNX layout)";
   163	    bad_attr(os.str());
   164	  }
   165	  if (g.C_in % groups != 0) {
   166	    os << "conv_transpose1d: C_in (" << g.C_in << ") is not divisible by groups (" << groups << ")";
   167	    bad_attr(os.str());
   168	  }
   169	  g.C_out = ck_mul(ws[1], groups, "conv_transpose1d: C_out = w.shape[1]*groups");
   170	  if (bs != nullptr && (bs->size() != 1 || (*bs)[0] != g.C_out)) {
   171	    os << "conv_transpose1d: b has shape " << shape_str(*bs) << ", expected [" << g.C_out << "]";
   172	    bad_attr(os.str());
   173	  }
   174	  // F03: every step checked.
   175	  int64_t t_out = ck_mul(stride, g.T - 1, "conv_transpose1d: stride*(T-1)");
   176	  t_out = ck_add(t_out, output_padding, "conv_transpose1d: output length");
   177	  t_out = ck_add(t_out, ck_mul(dilation, g.K - 1, "conv_transpose1d: dilation*(K-1)"), "conv_transpose1d: output length");
   178	  t_out = ck_add(t_out, 1, "conv_transpose1d: output length");
   179	  t_out = ck_sub(t_out, pb, "conv_transpose1d: output length");
   180	  g.T_out = ck_sub(t_out, pe, "conv_transpose1d: output length");
   181	  if (g.T_out <= 0) {
   182	    os << "conv_transpose1d: output length stride*(T-1) + output_padding + dilation*(K-1) + 1 - pb - pe = "
   183	       << g.T_out << " is <= 0";
   184	    bad_attr(os.str());
   185	  }
   186	  p.out_shape = {g.N, g.C_out, g.T_out};
   187	  ck_shape_numel(p.out_shape, "conv_transpose1d: output size N*C_out*T_out");
   188	  return p;
   189	}
