    63	// Stream 0 is the legacy default stream in this translation unit (per-thread default stream refused above): the stream
    64	// TensorCUDA queues on and the stream DLPack producers were asked to order against (stream=1).
    65	constexpr cudaStream_t kLegacyStream = 0;
    66	
    67	// ONNX LSTM gate block indices along the 4H axis (Operators.md, LSTM: "iofc").
    68	constexpr int64_t kGateI = 0;
    69	constexpr int64_t kGateO = 1;
    70	constexpr int64_t kGateF = 2;
    71	constexpr int64_t kGateC = 3;
