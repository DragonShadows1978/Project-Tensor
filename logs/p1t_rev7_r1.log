  1153	    if (op == nullptr || !op->present()) continue;
  1154	    const int64_t b = op->numel() * static_cast<int64_t>(sizeof(float));  // checked at construction (F03)
  1155	    total = ck_add(total, b, "the aggregate fp32 byte count of this call's operands (their sum)");
  1156	  }
  1157	  return total;
  1158	}
