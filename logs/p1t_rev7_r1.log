    58	// y[r, i] = x[r, i / scale]: one thread per output element, a 32-bit word copy.
    59	__global__ void upsample_nearest1d_kernel(const uint32_t* __restrict__ x, uint32_t* __restrict__ y, int64_t total,
    60	                                          int64_t T, int64_t T_out, int64_t scale) {
    61	  for (int64_t i = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; i < total;
