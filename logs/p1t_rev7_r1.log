   299	BuildInfo build_info() {
   300	  BuildInfo bi{};
   301	  check_cuda(cudaRuntimeGetVersion(&bi.cudart_version), "cudaRuntimeGetVersion");
   302	  check_cublas(cublasGetProperty(MAJOR_VERSION, &bi.cublas_major), "cublasGetProperty(MAJOR)");
   303	  check_cublas(cublasGetProperty(MINOR_VERSION, &bi.cublas_minor), "cublasGetProperty(MINOR)");
   304	  check_cublas(cublasGetProperty(PATCH_LEVEL, &bi.cublas_patch), "cublasGetProperty(PATCH)");
   305	  check_cuda(cudaGetDevice(&bi.current_device), "cudaGetDevice");
   306	  return bi;
   307	}
