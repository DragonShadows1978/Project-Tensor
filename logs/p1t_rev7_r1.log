+class RecordingTuple(tuple):
+    def __len__(self):
+        Recorder.CALLS.append('tuple.__len__'); return tuple.__len__(self)
+    def __getitem__(self, i):
+        Recorder.CALLS.append('tuple.__getitem__'); return tuple.__getitem__(self, i)
