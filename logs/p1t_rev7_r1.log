   244	// ===================================================================== DLPack
   245	// P1T-M1 (Project-Voice T1): zero-copy DLPack export/import.
   246	//
   247	// Prior art: DLPack (dmlc/dlpack, 2017-; v1.3 header vendored verbatim at
   248	// include/dlpack/dlpack.h); the Python array API standard's data-interchange
   249	// protocol (__dlpack__(stream=, max_version=, dl_device=, copy=) and
   250	// __dlpack_device__; Consortium for Python Data API Standards, 2021-2023);
   251	// PyTorch's ATen DLConvertor/torch.utils.dlpack and CuPy's from_dlpack
   252	// (owner keepalive: the manager context owns a reference to the producer's
   253	// storage, and the consumer keeps the manager until its tensor dies; capsule
   254	// renamed "used_*" on consumption). Taken: the protocol, capsule naming and
   255	// the keepalive pattern; the event-record + cudaStreamWaitEvent fence is the
   256	// standard CUDA cross-stream idiom. Ours: wiring it to tc::Storage (a
   257	// shared_ptr<Storage> owner on export; an external-release Storage that
   258	// drains the engine stream before the deleter on import, kernels.cu).
   259	constexpr const char* kCapLegacy = "dltensor";
   260	constexpr const char* kCapVersioned = "dltensor_versioned";
   261	constexpr const char* kCapUsedLegacy = "used_dltensor";
   262	constexpr const char* kCapUsedVersioned = "used_dltensor_versioned";
   263	
   264	DLDataType to_dl_dtype(DType dt) {
   265	  auto mk = [](int code, int bits) {
   266	    DLDataType d;
   267	    d.code = static_cast<uint8_t>(code);
   268	    d.bits = static_cast<uint8_t>(bits);
   269	    d.lanes = 1;
   270	    return d;
   271	  };
   272	  switch (dt) {
   273	    case DType::Float32: return mk(kDLFloat, 32);
   274	    case DType::Float16: return mk(kDLFloat, 16);
   275	    case DType::BFloat16: return mk(kDLBfloat, 16);
   276	    case DType::Int64: return mk(kDLInt, 64);
   277	    case DType::Uint8: return mk(kDLUInt, 8);
   278	    case DType::Bool: return mk(kDLBool, 8);
   279	  }
   280	  throw py::buffer_error("__dlpack__: dtype has no DLPack mapping");
   281	}
   282	
   283	// Exact matches only: TensorCUDA never converts on import.
   284	bool from_dl_dtype(const DLDataType& d, DType* out) {
   285	  if (d.lanes != 1) return false;
   286	  if (d.code == kDLFloat && d.bits == 32) { *out = DType::Float32; return true; }
   287	  if (d.code == kDLFloat && d.bits == 16) { *out = DType::Float16; return true; }
   288	  if (d.code == kDLBfloat && d.bits == 16) { *out = DType::BFloat16; return true; }
   289	  if (d.code == kDLInt && d.bits == 64) { *out = DType::Int64; return true; }
   290	  if (d.code == kDLUInt && d.bits == 8) { *out = DType::Uint8; return true; }
   291	  if (d.code == kDLBool && d.bits == 8) { *out = DType::Bool; return true; }
   292	  return false;
   293	}
   294	
   295	std::string shape_str(const int64_t* v, int n) {
   296	  std::string s = "[";
   297	  for (int i = 0; i < n; ++i) s += (i ? ", " : "") + std::to_string(v[i]);
   298	  return s + "]";
   299	}
   300	
   301	// P1T-FIX1, F03: checked element count and byte size for the two entry points that turn arbitrary caller shapes into
   302	// a Storage (empty, from_dlpack). Every extent is >= 0 here (callers refuse negatives first); a zero extent makes the
   303	// count 0 whatever the other extents are. Overflow raises ValueError and never wraps to an empty or short Storage.
   304	// The byte ceiling is INT64_MAX (every byte total, offset and pointer difference stays a valid int64/ptrdiff_t).
   305	// Prior art: GCC/Clang __builtin_mul_overflow / __builtin_add_overflow (GCC 5, 2015); C23 ckd_mul / ckd_add
   306	// (<stdckdint.h>, ISO/IEC 9899:2024); SEI CERT C INT30-C / INT32-C. Taken: the checked-operation primitive. Ours:
   307	// where it is applied. Unverified here (lead to check): "GCC 5 __builtin_mul_overflow", "C23 stdckdint".
   308	//
   309	// P1T-FIX2, review finding N2 (the zero-extent rule). FIX1 returned a count of 0 for any shape with a zero extent
   310	// WITHOUT looking at the other extents, so [0, 2^62, 4] and [2^62, 4, 0] were accepted as empty tensors; the engine
   311	// then formed their strides and partial counts (contiguous_strides, numel_of, byte strides) and overflowed (round-2
   312	// probe core_cpu prefix/suffix: UBSan signed overflow). The rule now: the EXTENT BOUND, the product of every extent
   313	// with a zero counted as 1, must fit in int64 (checked_numel), and so must the bound times the element size
   314	// (checked_nbytes), whatever the other extents are. Every quantity the engine later forms from such a shape (count,
   315	// each contiguous stride, each byte stride, the byte size) is at most that bound, so none can overflow. Zero-extent
   316	// shapes whose bound fits (e.g. [0, 2^60] float32) stay real empty tensors.
   317	// Prior art: NumPy's array constructor applies the same rule (zero dimensions skipped, the rest multiplied into the
   318	// byte size with overflow checks): numpy 2.4.2 refuses np.empty((0, 2**62, 4), float32) and (0, 2**61) float32 ("array
   319	// is too big"), measured in the P1T-FIX2 ledger. PyTorch 2.11 refuses the element-level part only. Taken: NumPy's
   320	// rule. Ours: applying it to TensorCUDA's empty / from_dlpack / __dlpack__. Source-level citation unverified here (lead
   321	// to check): "numpy ctors.c PyArray_NewFromDescr_int is_zero overflow".
   322	int64_t checked_extent_bound(const int64_t* dims, int n, const char* who) {
   323	  int64_t p = 1;
   324	  for (int i = 0; i < n; ++i)
   325	    if (__builtin_mul_overflow(p, dims[i] > 1 ? dims[i] : int64_t{1}, &p))
   326	      throw py::value_error(std::string(who) + ": the element count of shape " + shape_str(dims, n) +
   327	                            " overflows int64 (every nonzero extent counts, also next to a zero extent: strides and "
   328	                            "partial counts are formed from them); refused");
   329	  return p;
   330	}
   331	
   332	int64_t checked_numel(const int64_t* dims, int n, const char* who) {
   333	  const int64_t bound = checked_extent_bound(dims, n, who);
   334	  for (int i = 0; i < n; ++i)
   335	    if (dims[i] == 0) return 0;
   336	  return bound;
   337	}
   338	
   339	int64_t checked_nbytes(int64_t numel, size_t itemsize, const int64_t* dims, int n, const char* who) {
   340	  const int64_t bound = checked_extent_bound(dims, n, who);
   341	  int64_t b = 0;
   342	  if (__builtin_mul_overflow(bound, static_cast<int64_t>(itemsize), &b))
   343	    throw py::value_error(std::string(who) + ": the byte size of shape " + shape_str(dims, n) + " (" +
   344	                          std::to_string(itemsize) + "-byte elements) overflows int64 (every nonzero extent counts, "
   345	                          "also next to a zero extent); refused");
   346	  return numel == 0 ? 0 : b;  // numel is 0 or the bound itself (checked_numel)
   347	}
