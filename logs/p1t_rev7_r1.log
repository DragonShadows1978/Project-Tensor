   276	// ------------------------------------------------------------------------------------------------ introspection
   277	CublasConfig cublas_config(int device) {
   278	  DeviceGuard guard(device);
   279	  cublasHandle_t h = handle_for(device);
   280	  cublasMath_t math;
   281	  cublasAtomicsMode_t atomics;
   282	  cublasPointerMode_t pmode;
   283	  cudaStream_t s;
   284	  check_cublas(cublasGetMathMode(h, &math), "cublasGetMathMode");
   285	  check_cublas(cublasGetAtomicsMode(h, &atomics), "cublasGetAtomicsMode");
   286	  check_cublas(cublasGetPointerMode(h, &pmode), "cublasGetPointerMode");
   287	  check_cublas(cublasGetStream(h, &s), "cublasGetStream");
   288	  CublasConfig c;
   289	  c.math_mode = static_cast<int>(math);
   290	  c.atomics_mode = static_cast<int>(atomics);
   291	  c.pointer_mode = static_cast<int>(pmode);
   292	  c.legacy_stream = (s == kLegacyStream);
   293	  c.default_math = (math == CUBLAS_DEFAULT_MATH);
   294	  c.atomics_not_allowed = (atomics == CUBLAS_ATOMICS_NOT_ALLOWED);
   295	  guard.restore();  // P1T-FIX4
   296	  return c;
   297	}
