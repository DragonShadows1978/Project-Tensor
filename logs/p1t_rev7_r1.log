    71	DType numpy_dtype(const py::array& a) {
    72	  auto dt = a.dtype();
    73	  if (dt.kind() == 'f' && dt.itemsize() == 4) return DType::Float32;
    74	  if (dt.kind() == 'f' && dt.itemsize() == 2) return DType::Float16;
    75	  if (dt.kind() == 'i' && dt.itemsize() == 8) return DType::Int64;
    76	  if (dt.kind() == 'u' && dt.itemsize() == 1) return DType::Uint8;  // packed int4
    77	  if (dt.kind() == 'b') return DType::Bool;
    78	  return DType::Float32;  // others are force-cast to float32 by the wrapper
    79	}
    80	
    81	Tensor tensor_from_numpy(py::array arr, const std::string& device, bool requires_grad) {
    82	  DType dt = numpy_dtype(arr);
    83	  // Force a C-contiguous buffer of the matching element size.
    84	  py::array contig = py::array::ensure(arr, py::array::c_style);
    85	  auto info = contig.request();
    86	  Shape shape(info.shape.begin(), info.shape.end());
    87	  Device dev = Device::from_string(device);
    88	  NDArray nd = NDArray::from_host(info.ptr, shape, dt, dev);
    89	  return Tensor::make(nd, requires_grad);
    90	}
    91	
    92	py::array tensor_to_numpy(Tensor& t) {
    93	  NDArray a = t.data();
    94	  // numpy has no bf16 — upcast to fp32 on device so the host buffer is fp32.
    95	  if (a.dtype == DType::BFloat16) a = a.astype(DType::Float32);
    96	  std::vector<py::ssize_t> shape(a.shape.begin(), a.shape.end());
    97	  py::array out;
    98	  if (a.dtype == DType::Float16) out = py::array(py::dtype("float16"), shape);
    99	  else if (a.dtype == DType::Int64) out = py::array(py::dtype("int64"), shape);
   100	  else if (a.dtype == DType::Uint8) out = py::array(py::dtype("uint8"), shape);
   101	  else out = py::array(py::dtype("float32"), shape);
   102	  NDArray host = a.device.is_cuda() ? a : a;  // to_host handles D2H
   103	  host.to_host(out.request().ptr);
   104	  return out;
   105	}
