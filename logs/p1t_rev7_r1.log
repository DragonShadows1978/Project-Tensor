+PyObject* raw_dlpack_begin_shutdown(PyObject*, PyObject* args, PyObject* kwargs) {
+  double first_diag_s = 0.0;
+  if (!raw_one_real_arg("_dlpack_begin_shutdown", "first_diag_s", args, kwargs, &first_diag_s)) return nullptr;
