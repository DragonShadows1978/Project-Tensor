+class Index:
+    def __index__(self):
+        _slow("__index__"); return 1
+class SeqLen:
+    def __len__(self):
+        _slow("__len__"); return 2
+    def __getitem__(self, i):
+        if i < 2:
+            return (2, 0)[i]
+        raise IndexError
+class SeqItem:
+    def __len__(self):
+        return 2
+    def __getitem__(self, i):
+        _slow("__getitem__")
+        if i < 2:
+            return (2, 0)[i]
+        raise IndexError
+class Iter:
+    def __iter__(self):
+        _slow("__iter__"); return iter((2, 0))
+VALUES = {"bool": Flag, "index": Index, "len": SeqLen, "getitem": SeqItem, "iter": Iter}
+t = tc.empty(0)
