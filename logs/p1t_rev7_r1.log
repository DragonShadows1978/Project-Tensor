   191	// ------------------------------------------------------------------------------------------------ peek helpers
   192	struct Peeked {
   193	  CapsuleRef capsule;            // P1T-FIX5: admitted last-reference drop (dlpack_operand.h); empty when absent
   194	  std::vector<int64_t> shape;
   195	  int device = -1;
   196	};
   197	
   198	Peeked peek_operand(py::handle obj, const char* role, int ndim) {
   199	  Peeked p;
   200	  require_operand(obj, role);
   201	  p.capsule = to_capsule(obj, role, false);
   202	  const DLTensor* t = peek(p.capsule.handle(), role);
   203	  validate_tensor(t, role, ndim);
   204	  p.shape = shape_of(t);
   205	  p.device = t->device.device_id;
   206	  return p;
   207	}
   208	
   209	void same_device_peeked(const std::vector<const Peeked*>& ps, const std::vector<const char*>& roles) {
   210	  int dev = -1;
   211	  const char* first = "";
   212	  for (size_t i = 0; i < ps.size(); ++i) {
   213	    if (ps[i] == nullptr) continue;
   214	    if (dev < 0) {
   215	      dev = ps[i]->device;
   216	      first = roles[i];
   217	    } else if (ps[i]->device != dev) {
   218	      std::ostringstream os;
   219	      os << "tc_signal: operand '" << roles[i] << "': on CUDA device " << ps[i]->device << " but operand '" << first
   220	         << "' is on CUDA device " << dev << "; every operand must be on the same device";
   221	      throw py::value_error(os.str());
   222	    }
   223	  }
   224	}
   225	
   226	std::vector<int64_t> op_shape(const Operand& op) {
   227	  std::vector<int64_t> s(op.ndim());
   228	  for (int i = 0; i < op.ndim(); ++i) s[i] = op.dim(i);
   229	  return s;
   230	}
   231	
   232	py::tuple to_tuple(const std::vector<int64_t>& v) {
   233	  py::tuple t(v.size());
   234	  for (size_t i = 0; i < v.size(); ++i) t[i] = py::int_(v[i]);
   235	  return t;
   236	}
