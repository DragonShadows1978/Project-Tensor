   173	// __getitem__ for ints and unit-step slices (single key or per-dim tuple),
   174	// composed from the differentiable slice/squeeze ops.
   175	Tensor getitem(Tensor& t, py::object key) {
   176	  std::vector<py::object> keys;
   177	  if (py::isinstance<py::tuple>(key))
   178	    for (auto k : key.cast<py::tuple>()) keys.push_back(py::reinterpret_borrow<py::object>(k));
   179	  else
   180	    keys.push_back(key);
   181	
   182	  Tensor cur = t;
   183	  int dim = 0;
   184	  for (auto& k : keys) {
   185	    if (py::isinstance<py::int_>(k)) {
   186	      int64_t i = k.cast<int64_t>();
   187	      int64_t sz = cur.shape()[dim];
   188	      if (i < 0) i += sz;
   189	      cur = ops::squeeze(ops::slice(cur, dim, i, 1), dim);  // dim removed; keep `dim`
   190	    } else if (py::isinstance<py::slice>(k)) {
   191	      size_t start, stop, step, len;
   192	      k.cast<py::slice>().compute(cur.shape()[dim], &start, &stop, &step, &len);
   193	      if (step != 1) throw std::runtime_error("getitem: only step==1 slices supported");
   194	      cur = ops::slice(cur, dim, (int64_t)start, (int64_t)len);
   195	      ++dim;
   196	    } else {
   197	      throw std::runtime_error("getitem: unsupported index type");
   198	    }
   199	  }
   200	  return cur;
   201	}
