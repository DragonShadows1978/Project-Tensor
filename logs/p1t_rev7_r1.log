// Checked int64 shape / geometry / byte arithmetic for tc_signal (P1T-FIX1, review finding F03).
//
// Every plan function and every operand validation computes element counts, output lengths, scratch sizes and byte
// totals through these helpers BEFORE any narrowing cast, allocation or launch. An overflow raises ValueError naming
// the quantity; a wrapped value is never used (in particular it never turns into an "empty" or negative extent).
// The byte ceiling is INT64_MAX (= PTRDIFF_MAX on LP64): every byte total and every pointer offset must stay a valid
// signed pointer difference.
//
// Prior art: GCC/Clang `__builtin_mul_overflow` / `__builtin_add_overflow` / `__builtin_sub_overflow` (GCC 5, 2015),
// which this file uses; C23 `ckd_mul` / `ckd_add` / `ckd_sub` (<stdckdint.h>, ISO/IEC 9899:2024), the standardized
// form of the same builtins; the SEI CERT C rules INT30-C / INT32-C ("ensure that operations on (un)signed integers do
// not wrap / overflow"). Taken: the checked-operation primitive. Ours: where tc_signal applies it (the list of
// quantities in the plan functions) and the INT64_MAX byte ceiling. Unverified in this sandbox (lead to check):
// "GCC 5 __builtin_mul_overflow release", "C23 stdckdint ckd_mul", "CERT INT32-C".
#pragma once

#include <pybind11/pybind11.h>

#include <cstdint>
#include <limits>
#include <string>
#include <vector>

namespace tcs {

[[noreturn]] inline void overflow_refusal(const char* what) {
  throw pybind11::value_error(std::string("tc_signal: ") + what +
                              " overflows 64-bit arithmetic; refused (no wrapped size is ever used)");
}

inline int64_t ck_mul(int64_t a, int64_t b, const char* what) {
  int64_t r = 0;
  if (__builtin_mul_overflow(a, b, &r)) overflow_refusal(what);
  return r;
}

inline int64_t ck_add(int64_t a, int64_t b, const char* what) {
  int64_t r = 0;
  if (__builtin_add_overflow(a, b, &r)) overflow_refusal(what);
  return r;
}

inline int64_t ck_sub(int64_t a, int64_t b, const char* what) {
  int64_t r = 0;
  if (__builtin_sub_overflow(a, b, &r)) overflow_refusal(what);
  return r;
}

// P1T-FIX2, review finding N2 (the zero-extent rule). A zero extent makes the element count 0, but it does NOT make
// the other extents harmless: strides (suffix products), partial counts (prefix products) and byte strides are formed
// from them whatever the count is, and the round-2 review reproduced signed overflow in exactly those products (UBSan,
// core numel_of/contiguous_strides). So every product below multiplies EVERY extent, a zero counted as 1 (the extent
// bound), and refuses the shape if that bound (or its fp32 byte size) overflows int64, even when the count is 0.
// Callers have refused negative extents; a negative factor is also counted as 1 here (never multiplied).
// Prior art: as above (checked builtins; CERT INT32-C). The same rule (itemsize times every NONZERO extent must fit,
// even when the count is 0) is NumPy's array constructor (PyArray_NewFromDescr skips zero dimensions and multiplies
// the rest into the byte size with overflow checks): measured here, numpy 2.4.2 np.empty((0, 2**62, 4), float32) and
// np.empty((0, 2**61), float32) raise "array is too big". PyTorch 2.11 refuses the element-level part ("Stride
// calculation overflowed" for (0, 2**62, 4), "Storage size calculation overflowed" for (2**62, 4, 0)) but not the byte
// part (it accepts (0, 2**61) fp32). Taken: NumPy's rule. Ours: applying it to every tc_signal plan and validation.
// Source-level citation unverified here (lead to check): "numpy ctors.c PyArray_NewFromDescr_int is_zero dimensions
// overflow", "c10 computeStorageNbytesContiguous safe_multiplies_u64".
inline int64_t ck_extent_bound(const std::vector<int64_t>& s, size_t a, size_t b, const char* what) {
  int64_t p = 1;
  for (size_t i = a; i < b; ++i) p = ck_mul(p, s[i] > 1 ? s[i] : 1, what);
  return p;
}

// Product of s[a, b), each factor >= 0. A zero factor makes the product 0, but only after the extent bound of the
// same range has been checked (N2: a zero never hides an overflowing neighbour).
inline int64_t ck_prod(const std::vector<int64_t>& s, size_t a, size_t b, const char* what) {
  const int64_t bound = ck_extent_bound(s, a, b, what);
  for (size_t i = a; i < b; ++i)
    if (s[i] == 0) return 0;
  return bound;
}

// Bytes of `numel` fp32 elements, refused above INT64_MAX.
inline int64_t ck_fp32_bytes(int64_t numel, const char* what) {
  return ck_mul(numel, static_cast<int64_t>(sizeof(float)), what);
}

// Element count of a planned output/scratch shape, plus the check that the fp32 byte size of its EXTENT BOUND fits
// (N2: so every byte stride fits too, also for a count of 0); returns the count.
inline int64_t ck_shape_numel(const std::vector<int64_t>& s, const char* what) {
  const int64_t bound = ck_extent_bound(s, 0, s.size(), what);
  ck_fp32_bytes(bound, what);
  return ck_prod(s, 0, s.size(), what);
}

}  // namespace tcs
// P1T-FIX4: tc_signal's one device guard and its CUDA error-slot rules (replaces the four identical DeviceGuard copies
// of conv.cu / lstm.cu / norms.cu / small_ops.cu and dlpack_operand.cpp's QuietDeviceGuard).
//
// Why (round-4 review): each round found new members of two classes, implicit current-device assumptions (F05, V4-01)
// and unchecked or ignored CUDA returns and error state (N1, V4-03, V4-04). The FIX4 sweep found these members here:
//  * every guard IGNORED the result of the restoring cudaSetDevice (destructor), so a failed restore left the caller on
//    the operand's device silently;
//  * a raise after a failed call left that call's entry in the calling thread's last-error slot, so the next, unrelated
//    launch check (any tc_signal op, or core's, which shares this libcudart.so.12 instance) reported it again as its own.
// The rules, applied by everything below and by the callers:
//  1. Whoever reports a CUDA error consumes it: a raise after a failed CUDA call first takes the slot entry
//     (cudaGetLastError), so the error is reported exactly once. CUDA 12.6 Programming Guide 3.2.12: the runtime keeps
//     one error variable per host thread, "overwritten by the error code every time an error occurs", and
//     cudaGetLastError "returns this variable and resets it to cudaSuccess" (artifacts/p1t_fix4/cuda_doc_quotes.txt).
//  2. A restore of the caller's device is checked. On a success path it raises (DeviceGuard::restore()); where nothing
//     may raise (a destructor, or unwinding after another error) the failure is consumed, counted, and raised once by
//     the next tc_signal.synchronize() (note_unraisable_device_restore_failure, dlpack_operand.cpp).
// cuBLAS 12.6 does not import libcudart (nm -D libcublas.so.12: no undefined cuda* symbol), so a cuBLAS failure never
// touches this slot; it is reported by its cublasStatus_t only.
//
// Prior art: PyTorch c10::cuda::CUDAGuard / OptionalCUDAGuard (InlineDeviceGuard: switch in the constructor, restore in
// the destructor through CUDAGuardImpl::uncheckedSetDevice -> C10_CUDA_CHECK_WARN, which consumes the slot with
// cudaGetLastError and warns, never throws; read in the installed torch 2.11 headers, c10/cuda/impl/CUDAGuardImpl.h and
// c10/cuda/CUDAException.h); CuPy's cupy.cuda.Device context manager (__exit__ restores the previous device). Taken: the
// scoped switch-and-restore and consume-on-report. Ours: the raising restore() on success paths and routing the
// unraisable failures to the next synchronize().
#pragma once

#include <cuda_runtime.h>

#include <sstream>
#include <stdexcept>
#include <string>

namespace tcs {

// Defined in dlpack_operand.cpp: a caller-device restore that failed where nothing can raise. Counted
// (pending_stats()['device_restore_failures']) and raised once by the next synchronize(). Never allocates, never
// throws. GIL held (every tc_signal path runs under the GIL).
void note_unraisable_device_restore_failure(int device, cudaError_t err) noexcept;

// P1T-FIX5 (round-5 review V5-03), defined in dlpack_operand.cpp: a cublasDestroy of a newly created handle that failed
// while an exception propagated (the cache insertion threw), so it could not raise. Counted, first status kept
// (pending_stats()['cublas_handle_destroy_failures' / 'cublas_handle_destroy_first_status']). Never throws, never
// allocates.
void note_cublas_handle_destroy_failure(int status) noexcept;

// Rule 1: raise for a failed CUDA call of ours, consuming its slot entry first.
[[noreturn]] inline void raise_cuda_failure(const std::string& what, cudaError_t e) {
  cudaGetLastError();
  std::ostringstream os;
  os << what << " failed: " << cudaGetErrorName(e) << ": " << cudaGetErrorString(e);
  throw std::runtime_error(os.str());
}

// Makes `device` current for a launch path and restores the caller's device. The constructor raises RuntimeError (slot
// entry consumed) if the current device cannot be read or the switch fails; nothing is switched then. restore() is the
// success-path restore and raises if it fails. The destructor restores only if restore() was not reached (an exception
// is unwinding) and then routes a failure to note_unraisable_device_restore_failure (rule 2): no throw from a
// destructor.
class DeviceGuard {
 public:
  explicit DeviceGuard(int device) : device_(device) {
    cudaError_t e = cudaGetDevice(&prev_);
    if (e != cudaSuccess) raise_cuda_failure("tc_signal: cudaGetDevice", e);
    if (prev_ != device) {
      e = cudaSetDevice(device);
      if (e != cudaSuccess) raise_cuda_failure("tc_signal: cudaSetDevice(" + std::to_string(device) + ")", e);
      switched_ = true;
    }
  }
  void restore() {
    if (!switched_) return;
    switched_ = false;
    const cudaError_t e = cudaSetDevice(prev_);
    if (e != cudaSuccess)
      raise_cuda_failure("tc_signal: restoring the caller's CUDA device " + std::to_string(prev_) +
                             " after queueing work on device " + std::to_string(device_) +
                             " (cudaSetDevice; the calling thread's current device is still " +
                             std::to_string(device_) + ", and the call's operands stay retained until that work is done)",
                         e);
  }
  ~DeviceGuard() {
    if (!switched_) return;
    const cudaError_t e = cudaSetDevice(prev_);
    if (e != cudaSuccess) {
      cudaGetLastError();
      note_unraisable_device_restore_failure(prev_, e);
    }
  }
  DeviceGuard(const DeviceGuard&) = delete;
  DeviceGuard& operator=(const DeviceGuard&) = delete;

 private:
  int device_;
  int prev_ = -1;
  bool switched_ = false;
};

// The never-throwing variant for release paths (destructors, noexcept drains). A failed query or switch is reported
// through ok()/error() with its slot entry consumed; a failed restore follows rule 2.
class QuietDeviceGuard {
 public:
  explicit QuietDeviceGuard(int device) noexcept {
    cudaError_t e = cudaGetDevice(&prev_);
    if (e != cudaSuccess) {
      cudaGetLastError();
      err_ = e;
      return;
    }
    if (prev_ != device) {
      e = cudaSetDevice(device);
      if (e != cudaSuccess) {
        cudaGetLastError();
        err_ = e;
        return;
      }
      switched_ = true;
    }
  }
  ~QuietDeviceGuard() {
    if (!switched_) return;
    const cudaError_t e = cudaSetDevice(prev_);
    if (e != cudaSuccess) {
      cudaGetLastError();
      note_unraisable_device_restore_failure(prev_, e);
    }
  }
  QuietDeviceGuard(const QuietDeviceGuard&) = delete;
  QuietDeviceGuard& operator=(const QuietDeviceGuard&) = delete;
  bool ok() const { return err_ == cudaSuccess; }
  cudaError_t error() const { return err_; }

 private:
  int prev_ = 0;
  cudaError_t err_ = cudaSuccess;
  bool switched_ = false;
};

