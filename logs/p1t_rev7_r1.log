   419	// P1T-FIX4 (sweep, implicit current device): TensorCUDA labels its OWN allocations cuda:0 (Device::from_string, which
   420	// predates P1-T, maps every "cuda..." string to index 0) while the Storage constructor allocates on whatever device is
   421	// current; an imported Storage is labeled with the producer's device. So the label is proven here against the
   422	// allocation itself before a P1-T path acts on it (the DLPack export publishes it and fences its stream; fill_ launches
   423	// on it): cudaPointerGetAttributes of element 0 must report a CUDA allocation on a.device.index. Returns "" when it
   424	// does; otherwise a message naming both devices (the caller raises its own error type). A failed query raises
   425	// RuntimeError (its slot entry consumed). Empty arrays have no memory to act on and pass. The query does not
   426	// synchronize, and it succeeds in a context with a sticky error (receipt artifacts/p1t_fix4/cuda_semantics.txt).
   427	// Prior art: the CUDA runtime's unified-addressing pointer query (cudaPointerGetAttributes, CUDA 4.0+); PyTorch 2.11
   428	// Tensor.__dlpack__ refuses a CURRENT-device mismatch instead (BufferError "Can't export tensors on a different CUDA
   429	// device index", read in the installed torch/_tensor.py). Taken: refuse rather than publish a wrong device. Ours:
   430	// checking the label against the allocation (not the current device), at export and fill_.
   431	std::string cuda_storage_device_mismatch(const NDArray& a, const char* who) {
   432	  if (!a.defined() || !a.device.is_cuda() || a.numel() == 0 || a.storage->ptr == nullptr) return std::string();
   433	  cudaPointerAttributes attr{};
   434	  const cudaError_t e = cudaPointerGetAttributes(&attr, a.data_ptr());
   435	  if (e != cudaSuccess) raise_cuda_failure(std::string(who) + ": cudaPointerGetAttributes failed", e);
   436	  if (attr.type == cudaMemoryTypeUnregistered)
   437	    return std::string(who) + ": this tensor is labeled cuda:" + std::to_string(a.device.index) +
   438	           " but its memory is not a CUDA allocation the driver knows; refused";
   439	  if (attr.device != a.device.index)
   440	    return std::string(who) + ": this tensor is labeled cuda:" + std::to_string(a.device.index) +
   441	           " but its memory is on CUDA device " + std::to_string(attr.device) +
   442	           " (TensorCUDA labels its own allocations cuda:0 and allocates on the current device, so it was created "
   443	           "while that device was current); refused rather than act on the wrong device";
   444	  return std::string();
   445	}
