    96	template <int B>
    97	__global__ void __launch_bounds__(B) row_norm_kernel(const float* __restrict__ x, const float* __restrict__ scale,
    98	                                                     const float* __restrict__ bias, float* __restrict__ y,
    99	                                                     int64_t rows, int64_t L, float eps, int affine, int64_t channels,
   100	                                                     int64_t groups, int64_t ch_per_group, int64_t T) {
   101	  __shared__ float red[B];
   102	  const int64_t tid = threadIdx.x;
   103	  const int64_t chunk_span = static_cast<int64_t>(B) * m4tuning::kNormChunk;
   104	  const float Lf = static_cast<float>(L);  // exact for L < 2^24
   105	  for (int64_t row = blockIdx.x; row < rows; row += gridDim.x) {
   106	    const float* __restrict__ xr = x + row * L;
   107	    float* __restrict__ yr = y + row * L;
   108	    const float K = xr[0];
   109	
   110	    // Pass 1: the mean of the shifted row.
   111	    float acc = 0.0f;
   112	    for (int64_t base = tid; base < L; base += chunk_span) {
   113	      const int64_t end = min(L, base + chunk_span);
   114	      float part = 0.0f;
   115	      for (int64_t j = base; j < end; j += B) part = part + (xr[j] - K);
   116	      acc = acc + part;
   117	    }
   118	    const float d = block_tree_sum<B>(acc, red) / Lf;
   119	
   120	    // Pass 2: the centred sum of squares (biased variance).
   121	    acc = 0.0f;
   122	    for (int64_t base = tid; base < L; base += chunk_span) {
   123	      const int64_t end = min(L, base + chunk_span);
   124	      float part = 0.0f;
   125	      for (int64_t j = base; j < end; j += B) {
   126	        const float c = (xr[j] - K) - d;
   127	        part = fmaf(c, c, part);
   128	      }
   129	      acc = acc + part;
   130	    }
   131	    const float var = block_tree_sum<B>(acc, red) / Lf;
   132	    const float rstd = 1.0f / sqrtf(var + eps);
   133	
   134	    // Pass 3: normalize and apply the affine.
   135	    for (int64_t j = tid; j < L; j += B) {
   136	      const float c = (xr[j] - K) - d;
   137	      int64_t p;
   138	      if (affine == static_cast<int>(NormAffine::kPerRow))
   139	        p = row % channels;
   140	      else if (affine == static_cast<int>(NormAffine::kPerElem))
   141	        p = j;
   142	      else
   143	        p = (row % groups) * ch_per_group + j / T;
   144	      const float s = scale != nullptr ? scale[p] : 1.0f;
   145	      const float b = bias != nullptr ? bias[p] : 0.0f;
   146	      yr[j] = fmaf(c * rstd, s, b);
   147	    }
   148	  }
   149	}
