    78	// DeviceGuard (makes `device` current for the call, restores the caller's device) is tc_signal's shared, checked guard
    79	// in cuda_guard.h since P1T-FIX4 (this copy ignored the restoring cudaSetDevice's result).
    80	
    81	// Sum of every thread's `v` over the block, by a fixed tree (stride B/2, B/4, ..., 1); every thread gets the total.
    82	template <int B>
    83	__device__ __forceinline__ float block_tree_sum(float v, float* red) {
    84	  red[threadIdx.x] = v;
    85	  __syncthreads();
    86	#pragma unroll
    87	  for (int s = B / 2; s > 0; s >>= 1) {
    88	    if (static_cast<int>(threadIdx.x) < s) red[threadIdx.x] = red[threadIdx.x] + red[threadIdx.x + s];
    89	    __syncthreads();
    90	  }
    91	  const float total = red[0];
    92	  __syncthreads();  // every thread has read red[0] before the next call overwrites red
    93	  return total;
    94	}
