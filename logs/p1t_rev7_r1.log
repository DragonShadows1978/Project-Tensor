    78	// in cuda_guard.h since P1T-FIX4 (this copy ignored the restoring cudaSetDevice's result).
    79	
    80	// One cuBLAS handle per device, created lazily on first use and kept for the life of the process (destroying it at
    81	// interpreter exit can race CUDA's own teardown). All entry points run under the GIL, so no extra lock is needed.
    82	// cuBLAS allocates its own internal workspace for this handle on first use (cudaMalloc inside cuBLAS); that is the
    83	// only device memory tc_signal causes to be allocated outside the caller's allocator (README "cuBLAS").
    84	cublasHandle_t handle_for(int device) {
    85	  static std::unordered_map<int, cublasHandle_t> handles;
    86	  auto it = handles.find(device);
    87	  if (it != handles.end()) return it->second;
    88	  cublasHandle_t h = nullptr;
    89	  check_cublas(cublasCreate(&h), "cublasCreate");
    90	  // P1T-FIX5, round-5 review finding V5-03 (MINOR): FIX4 destroyed the new handle when a SETTING failed, but the handle
    91	  // had no owner through the cache insertion below: when handles.emplace threw (std::bad_alloc for the map node) the
    92	  // handle leaked, with its device resources (review probe handle_insert_oom_cpu.cpp: creates 1, destroys 0). Now `owned`
    93	  // owns it from creation until the insertion commits: on ANY exception before the commit its destructor destroys the
    94	  // handle, checks the destroy's status and, never throwing while the exception propagates, counts a failure
    95	  // (note_cublas_handle_destroy_failure). A failed setting still destroys it explicitly first and names that destroy's
    96	  // status in the raise (FIX4), clearing `h` so the owner does not destroy it twice. Nothing is cached on failure, so
    97	  // the next call starts again from cublasCreate.
    98	  // Prior art: RAII (Stroustrup) and the scope guard with dismissal on commit (Alexandrescu & Marginean, "Generic: Change
    99	  // the Way You Write Exception-Safe Code - Forever", C/C++ Users Journal, 2000; std::unique_ptr with a custom deleter
   100	  // is the library form). Taken: own until commit, release on unwinding. Ours: checking and counting the cleanup status.
   101	  struct NewHandleOwner {
   102	    cublasHandle_t& h;
   103	    ~NewHandleOwner() {
   104	      if (h == nullptr) return;  // committed to the cache, or already destroyed by settle
   105	      const cublasStatus_t ds = cublasDestroy(h);
   106	      if (ds != CUBLAS_STATUS_SUCCESS) note_cublas_handle_destroy_failure(static_cast<int>(ds));
   107	    }
   108	  } owned{h};
   109	  // P1T-FIX4 (sweep): a setting that fails no longer leaks the new handle: it is destroyed (on this device, which the
   110	  // caller's DeviceGuard keeps current), the destroy's own status is checked and named, and the call raises. Nothing is
   111	  // cached, so the next call retries from cublasCreate.
   112	  auto settle = [&h](cublasStatus_t st, const char* what) {
   113	    if (st == CUBLAS_STATUS_SUCCESS) return;
   114	    const cublasStatus_t ds = cublasDestroy(h);
   115	    h = nullptr;  // P1T-FIX5: destroyed here; the owner must not destroy it again
   116	    std::ostringstream os;
   117	    os << "tc_signal: " << what << " failed: cuBLAS status " << static_cast<int>(st);
   118	    if (ds != CUBLAS_STATUS_SUCCESS) os << "; destroying the new handle also failed: cuBLAS status " << static_cast<int>(ds);
   119	    throw std::runtime_error(os.str());
   120	  };
   121	  settle(cublasSetStream(h, kLegacyStream), "cublasSetStream(0)");
   122	  settle(cublasSetMathMode(h, CUBLAS_DEFAULT_MATH), "cublasSetMathMode(CUBLAS_DEFAULT_MATH)");
   123	  settle(cublasSetAtomicsMode(h, CUBLAS_ATOMICS_NOT_ALLOWED), "cublasSetAtomicsMode(NOT_ALLOWED)");
   124	  settle(cublasSetPointerMode(h, CUBLAS_POINTER_MODE_HOST), "cublasSetPointerMode(HOST)");
   125	  handles.emplace(device, h);  // may throw (host allocation): `owned` destroys h, nothing is cached
   126	  const cublasHandle_t cached = h;
   127	  h = nullptr;  // committed: the cache owns the handle now
   128	  return cached;
   129	}
   130	
   131	// ------------------------------------------------------------------------------------------------ kernels
   132	// 1-D im2col for one batch element (Chellapilla et al. 2006, 1-D with dilation and asymmetric zero padding):
   133	//   col[(c*K + k), t] = x[c, t*stride - pad_begin + k*dilation]   (0 outside [0, T))
   134	// Rows (c, k) are c-major, so group g's rows [g*Cg*K, (g+1)*Cg*K) form one contiguous [Cg*K, T_out] block that
   135	// matches w[g*Og:(g+1)*Og] viewed as [Og, Cg*K].
   136	__global__ void im2col1d_kernel(const float* __restrict__ x, float* __restrict__ col, int64_t C, int64_t T, int64_t K,
   137	                                int64_t T_out, int64_t stride, int64_t pad_begin, int64_t dilation) {
   138	  const int64_t total = C * K * T_out;
   139	  for (int64_t i = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; i < total;
   140	       i += static_cast<int64_t>(gridDim.x) * blockDim.x) {
   141	    const int64_t t = i % T_out;
   142	    const int64_t r = i / T_out;
   143	    const int64_t k = r % K;
   144	    const int64_t c = r / K;
   145	    const int64_t src = t * stride - pad_begin + k * dilation;
   146	    col[i] = (src >= 0 && src < T) ? x[c * T + src] : 0.0f;
   147	  }
   148	}
   149	
   150	// y[n, o, t] += b[o], one thread per output element (fp32 add, one rounding).
   151	__global__ void bias_add_kernel(float* __restrict__ y, const float* __restrict__ b, int64_t C_out, int64_t T_out,
   152	                                int64_t total) {
   153	  for (int64_t i = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; i < total;
   154	       i += static_cast<int64_t>(gridDim.x) * blockDim.x) {
   155	    const int64_t o = (i / T_out) % C_out;
   156	    y[i] = y[i] + b[o];
   157	  }
   158	}
   159	
   160	// Gather-form ConvTranspose1d (adjoint of strided conv, Dumoulin & Visin 2016), one thread per output element:
   161	//   y[n, o, t] = b[o] + sum_{k=0..K-1} sum_{c in group(o)} w[c, o - g*Og, k] * x[n, c, (t + pb - k*dilation)/stride]
   162	// over the taps with (t + pb - k*dilation) >= 0, divisible by stride, and quotient < T. Fixed order: k ascending
   163	// (outer), c ascending within the group (inner), fp32 fmaf accumulation from 0, bias added last. No atomics.
   164	__global__ void conv_transpose1d_gather_kernel(const float* __restrict__ x, const float* __restrict__ w,
   165	                                               const float* __restrict__ b, float* __restrict__ y, int64_t N,
   166	                                               int64_t C_in, int64_t T, int64_t C_out, int64_t K, int64_t T_out,
   167	                                               int64_t stride, int64_t pad_begin, int64_t dilation, int64_t groups) {
   168	  const int64_t Cg = C_in / groups;
   169	  const int64_t Og = C_out / groups;
   170	  const int64_t total = N * C_out * T_out;
   171	  for (int64_t i = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; i < total;
   172	       i += static_cast<int64_t>(gridDim.x) * blockDim.x) {
   173	    const int64_t t = i % T_out;
   174	    const int64_t r = i / T_out;
   175	    const int64_t o = r % C_out;
   176	    const int64_t n = r / C_out;
   177	    const int64_t g = o / Og;
   178	    const int64_t ol = o - g * Og;
   179	    const float* xg = x + (n * C_in + g * Cg) * T;   // x[n, g*Cg + cl, :] = xg[cl*T + :]
   180	    const float* wg = w + (g * Cg * Og + ol) * K;    // w[g*Cg + cl, ol, k] = wg[cl*Og*K + k]
   181	    float acc = 0.0f;
   182	    for (int64_t k = 0; k < K; ++k) {
   183	      const int64_t s = t + pad_begin - k * dilation;
   184	      if (s < 0 || s % stride != 0) continue;
   185	      const int64_t q = s / stride;
   186	      if (q >= T) continue;
   187	      const float* xp = xg + q;
   188	      const float* wp = wg + k;
   189	      for (int64_t cl = 0; cl < Cg; ++cl) acc = fmaf(wp[cl * Og * K], xp[cl * T], acc);
   190	    }
   191	    if (b != nullptr) acc = acc + b[o];
   192	    y[i] = acc;
   193	  }
   194	}
   195	
   196	// Fast-math canary: out[i] = x[i] / y[i] in fp32. Built with this TU's flags, so --use_fast_math (-ftz=1,
   197	// -prec_div=0) shows up as flushed subnormals or non-IEEE quotients, which the tests compare bitwise against the host's
   198	// IEEE fp32 division. Prior art: no specific source known to me (it is the usual "test the build flags by their
   199	// observable effect" idea; denormal flushing as a fast-math symptom is documented in the CUDA C Programming Guide).
   200	__global__ void fp32_divide_probe_kernel(const float* __restrict__ x, const float* __restrict__ y,
   201	                                         float* __restrict__ out, int64_t n) {
   202	  for (int64_t i = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; i < n;
   203	       i += static_cast<int64_t>(gridDim.x) * blockDim.x)
   204	    out[i] = x[i] / y[i];
   205	}
   206	
   207	}  // namespace
   208	
   209	void fp32_divide_probe(int device, const float* x, const float* y, float* out, int64_t n) {
   210	  DeviceGuard guard(device);
   211	  fp32_divide_probe_kernel<<<grid_for(n, tuning::kProbeBlock), tuning::kProbeBlock, 0, kLegacyStream>>>(x, y, out, n);
   212	  check_launch("fp32_divide_probe_kernel");
   213	  guard.restore();  // P1T-FIX4: success-path restore is checked (raises on failure)
   214	}
   215	
   216	// ------------------------------------------------------------------------------------------------ Conv1d
   217	void conv1d_forward(int device, const Conv1dGeom& g, const float* x, const float* w, const float* b, float* y,
   218	                    float* col) {
   219	  DeviceGuard guard(device);
   220	  cublasHandle_t h = handle_for(device);
   221	  const int64_t Cg = g.C_in / g.groups;
   222	  const int64_t Og = g.C_out / g.groups;
   223	  const int64_t CgK = Cg * g.K;
   224	  const float alpha = 1.0f;
   225	  const float beta = 0.0f;
   226	  for (int64_t n = 0; n < g.N; ++n) {
   227	    const float* xn = x + n * g.C_in * g.T;
   228	    const float* A = nullptr;   // the [Cg*K, T_out] row-major operand of group 0 for this batch element
   229	    long long strideA = 0;
   230	    if (g.direct) {
   231	      // K == 1, stride 1, no pads: x[n] itself is the col matrix (T_out == T), no scratch.
   232	      A = xn;
   233	      strideA = static_cast<long long>(Cg * g.T);
   234	    } else {
   235	      // The scratch is reused for every n: the next im2col is queued after this n's GEMM on the same stream.
   236	      const int64_t total = g.C_in * g.K * g.T_out;
   237	      im2col1d_kernel<<<grid_for(total, tuning::kIm2colBlock), tuning::kIm2colBlock, 0, kLegacyStream>>>(
   238	          xn, col, g.C_in, g.T, g.K, g.T_out, g.stride, g.pad_begin, g.dilation);
   239	      check_launch("im2col1d_kernel");
   240	      A = col;
   241	      strideA = static_cast<long long>(CgK * g.T_out);
   242	    }
   243	    float* yn = y + n * g.C_out * g.T_out;
   244	    // Row-major Y_g[Og, T_out] = W_g[Og, CgK] . Col_g[CgK, T_out], computed as the column-major product
   245	    // Y_g^T[T_out, Og] = Col_g^T[T_out, CgK] . W_g^T[CgK, Og]: m = T_out, n = Og, k = CgK, both ops N,
   246	    // lda = T_out (col), ldb = CgK (w), ldc = T_out (y); one batch entry per group.
   247	    check_cublas(cublasSgemmStridedBatched(h, CUBLAS_OP_N, CUBLAS_OP_N, static_cast<int>(g.T_out),
   248	                                           static_cast<int>(Og), static_cast<int>(CgK), &alpha, A,
   249	                                           static_cast<int>(g.T_out), strideA, w, static_cast<int>(CgK),
   250	                                           static_cast<long long>(Og * CgK), &beta, yn, static_cast<int>(g.T_out),
   251	                                           static_cast<long long>(Og * g.T_out), static_cast<int>(g.groups)),
   252	                 "cublasSgemmStridedBatched");
   253	    check_launch("cublasSgemmStridedBatched");
   254	  }
   255	  if (b != nullptr) {
   256	    const int64_t total = g.N * g.C_out * g.T_out;
   257	    bias_add_kernel<<<grid_for(total, tuning::kBiasBlock), tuning::kBiasBlock, 0, kLegacyStream>>>(y, b, g.C_out,
   258	                                                                                                   g.T_out, total);
   259	    check_launch("bias_add_kernel");
   260	  }
   261	  guard.restore();  // P1T-FIX4
   262	}
   263	
   264	// ------------------------------------------------------------------------------------------------ ConvTranspose1d
   265	void conv_transpose1d_forward(int device, const ConvTranspose1dGeom& g, const float* x, const float* w,
   266	                              const float* b, float* y) {
   267	  DeviceGuard guard(device);
   268	  const int64_t total = g.N * g.C_out * g.T_out;
   269	  conv_transpose1d_gather_kernel<<<grid_for(total, tuning::kConvTransposeBlock), tuning::kConvTransposeBlock, 0,
   270	                                   kLegacyStream>>>(x, w, b, y, g.N, g.C_in, g.T, g.C_out, g.K, g.T_out, g.stride,
   271	                                                    g.pad_begin, g.dilation, g.groups);
   272	  check_launch("conv_transpose1d_gather_kernel");
   273	  guard.restore();  // P1T-FIX4
   274	}
