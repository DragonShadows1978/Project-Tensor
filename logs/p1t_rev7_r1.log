    69	// Reflect pad of the last axis: one thread per output element, a 32-bit word copy.
    70	__global__ void reflection_pad1d_kernel(const uint32_t* __restrict__ x, uint32_t* __restrict__ y, int64_t total,
    71	                                        int64_t T, int64_t T_out, int64_t pad_begin) {
    72	  for (int64_t i = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; i < total;
    73	       i += static_cast<int64_t>(gridDim.x) * blockDim.x) {
    74	    const int64_t t = i % T_out;
    75	    const int64_t r = i / T_out;
    76	    int64_t s = t - pad_begin;
    77	    if (s < 0)
    78	      s = -s;
    79	    else if (s >= T)
