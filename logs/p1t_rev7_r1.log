   366	// PyCapsule destructors: an UNCONSUMED capsule (still named dltensor*) owns
   367	// its manager and must call the deleter; a consumed one ("used_*") does not.
   368	void capsule_destructor_legacy(PyObject* cap) {
   369	  if (!PyCapsule_IsValid(cap, kCapLegacy)) return;
   370	  PyObject *et, *ev, *etb;
   371	  PyErr_Fetch(&et, &ev, &etb);
   372	  auto* m = static_cast<DLManagedTensor*>(PyCapsule_GetPointer(cap, kCapLegacy));
   373	  if (m && m->deleter) m->deleter(m);
   374	  PyErr_Restore(et, ev, etb);
   375	}
   376	void capsule_destructor_versioned(PyObject* cap) {
   377	  if (!PyCapsule_IsValid(cap, kCapVersioned)) return;
   378	  PyObject *et, *ev, *etb;
   379	  PyErr_Fetch(&et, &ev, &etb);
   380	  auto* m = static_cast<DLManagedTensorVersioned*>(
   381	      PyCapsule_GetPointer(cap, kCapVersioned));
   382	  if (m && m->deleter) m->deleter(m);
   383	  PyErr_Restore(et, ev, etb);
   384	}
   385	
   386	// Stream contract (array API): `stream` is the CONSUMER's stream. TensorCUDA
   387	// queues all work on the legacy default stream. None/1 = the consumer is on
   388	// the legacy stream too (nothing to do); -1 = no synchronization; 2 = the
   389	// per-thread default stream; > 2 = a cudaStream_t. For 2 and handles, record
   390	// an event on the legacy stream and make the consumer wait on it.
   391	//
   392	// P1T-FIX4, round-4 review finding V4-01 (MAJOR). 62c8d9f created and recorded
   393	// the event on the CURRENT device: with device 1 current, a device-0 tensor's
   394	// consumer waited on device 1's legacy stream, and the device-0 writes were not
   395	// ordered. Now the fence runs on THE TENSOR'S DEVICE (`device`, a label that
   396	// tensor_dlpack has proven against the allocation, cuda_storage_device_mismatch):
   397	//  * the caller's device is read (checked) and, if it differs, `device` is made
   398	//    current (checked); then the event is created, recorded on the legacy
   399	//    stream (of `device` now), the consumer's stream waits on it, the event is
   400	//    destroyed on its own device, and the caller's device is restored;
   401	//  * every return is checked; on any failure the caller's device is restored
   402	//    FIRST, the failed calls' slot entry is consumed, and one RuntimeError names
   403	//    each failed step (and says whether the restore itself failed);
   404	//  * the wait is issued with `device` current, so stream=2 means the per-thread
   405	//    default stream of the tensor's device. That matches PyTorch 2.11's DLPack
   406	//    consumer, which passes the current stream OF THE TENSOR'S DEVICE
   407	//    (torch.utils.dlpack.from_dlpack: torch.cuda.current_stream(f'cuda:{ext_device[1]}'),
   408	//    read in the installed package). A handle (> 2) may belong to any device:
   409	//    CUDA 12.6 cudaStreamWaitEvent: "event may be from a different device than
   410	//    stream" (cuda_runtime_api.h); Programming Guide 3.2.9.3: "cudaStreamWaitEvent()
   411	//    will succeed even if the input stream and input event are associated to
   412	//    different devices", while "cudaEventRecord() will fail if the input event and
   413	//    input stream are associated to different devices", which is why creation and
   414	//    record need the tensor's device current (receipt artifacts/p1t_fix4/cuda_doc_quotes.txt).
   415	// No device-wide sync is added (one event, as before).
   416	// Prior art: PyTorch's scoped c10::cuda::CUDAGuard and CuPy's cupy.cuda.Device
   417	// context (switch, act, restore); PyTorch's CUDAEvent destroys an event on its
   418	// creating device ("to avoid creating a CUDA context on other devices",
   419	// c10/cuda/CUDAEvent.h, torch 2.11 headers). PyTorch 2.11's own Tensor.__dlpack__
   420	// does NOT switch: it refuses a current-device mismatch with BufferError
   421	// (torch/_tensor.py). The order chose the guard (switch, record, restore). Taken:
   422	// the scoped guard and destroy-on-own-device. Ours: placing the whole fence,
   423	// consumer wait included, inside the guard, and restore-before-raise.
   424	// P1T-FIX6 (V6-02): `stream` arrives already read by DlpackArgs (None -> has_stream false; an int's value): this
   425	// function calls no Python at all.
   426	void dlpack_fence_consumer(bool has_stream, long long s, int device) {
   427	  if (!has_stream) return;
   428	  if (s == -1 || s == 1) return;
   429	  if (s == 0)
   430	    throw py::value_error(
   431	        "__dlpack__: stream=0 is ambiguous for CUDA under the DLPack protocol; "
   432	        "use None or 1 (legacy default stream), 2 (per-thread default stream) "
   433	        "or a cudaStream_t handle");
   434	  if (s < -1) throw py::value_error("__dlpack__: invalid stream " + std::to_string(s));
