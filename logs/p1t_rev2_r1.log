   275	    expect_shape(S, {p.scratch_numel});
   276	  } else if (!scratch.is_none()) {
   277	    bad_attr("conv1d: this call needs no scratch (K == 1, stride 1, no pads) but one was passed");
   278	  }
   279	  const int device = common_device({&X, &W, &B, &Y, &S});
   280	  for (const Operand* in : {&X, &W, &B, &S}) expect_disjoint(Y, *in);
   281	  for (const Operand* in : {&X, &W, &B}) expect_disjoint(S, *in);
