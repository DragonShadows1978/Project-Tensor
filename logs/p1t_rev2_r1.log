    74	    refuse_type(role, "expected a DLPack producer (an object with __dlpack__) or a DLPack capsule, got " +
    75	                          type_name(obj));
    76	  // Array API order: ask the producer's device first. A non-CUDA producer is refused here, before __dlpack__ is
    77	  // called with a CUDA stream argument (CPU producers such as NumPy reject any stream other than None).
    78	  if (py::hasattr(obj, "__dlpack_device__")) {
    79	    int device_type = -1;
    80	    try {
    81	      py::tuple dev = obj.attr("__dlpack_device__")().cast<py::tuple>();
    82	      device_type = dev[0].cast<int>();
    83	    } catch (py::cast_error&) {
    84	      refuse_type(role, "__dlpack_device__() did not return a (device_type, device_id) tuple of ints");
    85	    }
    86	    if (device_type != kDLCUDA) {
    87	      std::ostringstream os;
    88	      os << "device type " << device_type << " is not kDLCUDA (2); tc_signal takes CUDA device memory only";
    89	      refuse_value(role, os.str());
    90	    }
    91	  }
    92	  py::object fn = obj.attr("__dlpack__");
    93	  py::object cap;
    94	  const py::tuple max_version = py::make_tuple(tuning::kDlpackMaxMajor, tuning::kDlpackMaxMinor);
    95	  try {
    96	    // Consumer stream = the legacy default stream (DLPack int 1): the producer orders its pending work before it.
    97	    if (writable)
    98	      cap = fn(py::arg("stream") = tuning::kDlpackLegacyStream, py::arg("max_version") = max_version,
    99	               py::arg("copy") = false);
   100	    else
   101	      cap = fn(py::arg("stream") = tuning::kDlpackLegacyStream, py::arg("max_version") = max_version);
   102	  } catch (py::error_already_set& e) {
   103	    // A producer that predates the 2023 keywords rejects them with TypeError: retry with the stream argument only
   104	    // (the array API standard's documented fallback; NumPy and PyTorch consumers do the same).
   105	    if (!e.matches(PyExc_TypeError)) throw;
   106	    cap = fn(py::arg("stream") = tuning::kDlpackLegacyStream);
   107	  }
   108	  if (!PyCapsule_CheckExact(cap.ptr()))
   109	    refuse_type(role, "__dlpack__ returned " + type_name(cap) + ", not a PyCapsule");
