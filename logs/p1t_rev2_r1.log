    46	// ------------------------------------------------------------------------------------------------ peek / consume
    47	struct Peek4 {
    48	  py::object capsule = py::none();  // None for an absent optional operand
    49	  std::vector<int64_t> shape;
    50	  int device = -1;
    51	  bool present = false;
