   283	  // throws part-way); the producer deleters run later, from drain_completed / synchronize / atexit.
   284	  RetainUntilComplete keep(device, {&X, &W, &B, &Y, &S});
   285	  conv1d_forward(device, p.g, X.data(), W.data(), B.present() ? B.data() : nullptr, Y.data(),
   286	                 S.present() ? S.data() : nullptr);
