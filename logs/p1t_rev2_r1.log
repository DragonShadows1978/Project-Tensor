   302	}
   303	
   304	// ------------------------------------------------------------------------------------------------ helpers
   305	std::vector<int64_t> shape_of(const DLTensor* t) { return std::vector<int64_t>(t->shape, t->shape + t->ndim); }
   306	
   307	std::string shape_str(const std::vector<int64_t>& s) {
   308	  std::ostringstream os;
   309	  os << "[";
   310	  for (size_t i = 0; i < s.size(); ++i) os << (i ? ", " : "") << s[i];
   311	  os << "]";
   312	  return os.str();
   313	}
   314	
   315	void expect_shape(const Operand& op, const std::vector<int64_t>& want) {
   316	  std::vector<int64_t> got(op.ndim());
   317	  for (int i = 0; i < op.ndim(); ++i) got[i] = op.dim(i);
   318	  if (got != want) refuse_value(op.role(), "shape " + shape_str(got) + " != expected " + shape_str(want));
   319	}
   320	
   321	int common_device(const std::vector<const Operand*>& ops) {
   322	  int dev = -1;
   323	  const char* first = "";
   324	  for (const Operand* op : ops) {
   325	    if (op == nullptr || !op->present()) continue;
   326	    if (dev < 0) {
   327	      dev = op->device();
   328	      first = op->role();
   329	    } else if (op->device() != dev) {
   330	      std::ostringstream os;
   331	      os << "on CUDA device " << op->device() << " but operand '" << first << "' is on CUDA device " << dev
   332	         << "; every operand must be on the same device";
   333	      refuse_value(op->role(), os.str());
   334	    }
   335	  }
   336	  return dev;
   337	}
   338	
   339	void expect_disjoint(const Operand& written, const Operand& other) {
   340	  if (!written.present() || !other.present()) return;
   341	  if (written.byte_begin() < other.byte_end() && other.byte_begin() < written.byte_end())
   342	    refuse_value(written.role(), std::string("its memory overlaps operand '") + other.role() +
   343	                                     "'; the written operand must not alias any other operand");
   344	}
   345	
   346	// ------------------------------------------------------------------------------------------------ deferred release (F01)
   347	// Design and prior art: dlpack_operand.h, RetainUntilComplete. Every function here runs on the calling host thread with
   348	// the GIL held (every _tc_signal entry point is a pybind11 function that keeps the GIL), so the pending list needs no
   349	// lock. Deleters may run Python (a ctypes producer) and may even re-enter tc_signal; therefore an entry is always taken
   350	// OFF the list before its deleters run, and nothing iterates the list across a deleter call.
   351	namespace {
   352	
   353	struct PendingEntry {
   354	  cudaEvent_t event = nullptr;   // recorded on `device`'s legacy stream right after the call's last launch
   355	  int device = -1;
   356	  int64_t bytes = 0;             // sum of the fp32 operand sizes this entry keeps alive
   357	  std::vector<ManagedOwner> owners;
   358	};
   359	
   360	struct PendingState {
   361	  std::deque<PendingEntry> q;
   362	  int64_t bytes = 0;
   363	  long long managers = 0;
   364	  long long high_water_entries = 0;
   365	  long long high_water_managers = 0;
   366	  int64_t high_water_bytes = 0;
   367	  unsigned long long retained_entries = 0;   // entries ever pushed
   368	  unsigned long long released_entries = 0;
   369	  unsigned long long released_managers = 0;
   370	  unsigned long long bound_drains = 0;       // a push exceeded a bound -> synchronize + release everything
   371	  unsigned long long fallback_syncs = 0;     // the event could not be recorded -> the legacy stream was synchronized
   372	  unsigned long long leaked_managers = 0;    // no completion proof (broken context): deliberately not released
   373	  std::unordered_map<int, std::vector<cudaEvent_t>> event_pool;   // completed events, reused per device
   374	};
   375	
   376	// Never destroyed: no static destructor may call a producer deleter at process exit (Python may be gone by then).
   377	PendingState& pending() {
   378	  static PendingState* state = new PendingState();
   379	  return *state;
   380	}
   381	
   382	// Makes `device` current for its scope and restores the caller's device; never throws (ok() reports failure, and a
   383	// failed switch clears the runtime's last-error slot so a later, unrelated launch check does not report it).
   384	class QuietDeviceGuard {
   385	 public:
   386	  explicit QuietDeviceGuard(int device) noexcept {
   387	    if (cudaGetDevice(&prev_) != cudaSuccess) {
   388	      cudaGetLastError();
   389	      ok_ = false;
   390	      return;
   391	    }
   392	    if (prev_ != device) {
   393	      if (cudaSetDevice(device) != cudaSuccess) {
   394	        cudaGetLastError();
   395	        ok_ = false;
   396	        return;
   397	      }
   398	      switched_ = true;
   399	    }
   400	  }
   401	  ~QuietDeviceGuard() {
   402	    if (switched_) cudaSetDevice(prev_);
   403	  }
   404	  QuietDeviceGuard(const QuietDeviceGuard&) = delete;
   405	  QuietDeviceGuard& operator=(const QuietDeviceGuard&) = delete;
   406	  bool ok() const { return ok_; }
   407	
   408	 private:
   409	  int prev_ = 0;
   410	  bool ok_ = true;
   411	  bool switched_ = false;
   412	};
   413	
   414	void recycle_event(PendingState& st, int device, cudaEvent_t ev) noexcept {
   415	  if (ev == nullptr) return;
   416	  try {
   417	    st.event_pool[device].push_back(ev);
   418	  } catch (...) {
   419	    cudaEventDestroy(ev);
   420	  }
   421	}
   422	
   423	void note_push(PendingState& st, const PendingEntry& e) {
   424	  st.bytes += e.bytes;
   425	  st.managers += static_cast<long long>(e.owners.size());
   426	  ++st.retained_entries;
   427	  st.high_water_entries = std::max<long long>(st.high_water_entries, static_cast<long long>(st.q.size()));
   428	  st.high_water_managers = std::max(st.high_water_managers, st.managers);
   429	  st.high_water_bytes = std::max(st.high_water_bytes, st.bytes);
   430	}
   431	
   432	void note_pop(PendingState& st, const PendingEntry& e) {
   433	  st.bytes -= e.bytes;
   434	  st.managers -= static_cast<long long>(e.owners.size());
   435	}
   436	
   437	// Runs the entry's deleters (they may run Python and re-enter tc_signal; the entry is already off the list).
   438	void release_entry(PendingState& st, PendingEntry& e) noexcept {
   439	  recycle_event(st, e.device, e.event);
   440	  e.event = nullptr;
   441	  ++st.released_entries;
   442	  st.released_managers += e.owners.size();
   443	  for (ManagedOwner& o : e.owners) o.reset();
   444	}
   445	
   446	void leak_entry(PendingState& st, PendingEntry& e) noexcept {
   447	  for (ManagedOwner& o : e.owners) {
   448	    if (!o.empty()) ++st.leaked_managers;
   449	    o.leak();
   450	  }
   451	  // The event is not recycled either: it may belong to a broken context.
   452	  e.event = nullptr;
   453	}
   454	
   455	// Takes the whole list off, synchronizes the legacy stream of the current device and of every device in it, then
   456	// releases each entry whose device synchronized and leaks the others. Entries pushed by deleters while this runs (a
   457	// re-entrant tc_signal call) land on the fresh list and are not touched here. Returns the failed devices' errors.
   458	std::vector<std::pair<int, cudaError_t>> sync_and_release_all_impl() noexcept {
   459	  PendingState& st = pending();
   460	  std::deque<PendingEntry> taken;
   461	  taken.swap(st.q);
   462	  st.bytes = 0;
   463	  st.managers = 0;
   464	  std::vector<std::pair<int, cudaError_t>> failed;
   465	  try {
   466	    std::set<int> devices;
   467	    int cur = -1;
   468	    if (cudaGetDevice(&cur) == cudaSuccess)
   469	      devices.insert(cur);
   470	    else
   471	      cudaGetLastError();
   472	    for (const PendingEntry& e : taken) devices.insert(e.device);
   473	    for (int d : devices) {
   474	      QuietDeviceGuard g(d);
   475	      cudaError_t r = g.ok() ? cudaStreamSynchronize(cudaStreamLegacy) : cudaErrorInvalidDevice;
   476	      if (r != cudaSuccess) {
   477	        cudaGetLastError();
   478	        failed.emplace_back(d, r);
   479	      }
   480	    }
   481	  } catch (...) {
   482	    // Only bad_alloc can land here: without a completion proof, leak everything taken.
   483	    for (PendingEntry& e : taken) leak_entry(st, e);
   484	    failed.emplace_back(-1, cudaErrorMemoryAllocation);
   485	    return failed;
   486	  }
   487	  while (!taken.empty()) {
   488	    PendingEntry e = std::move(taken.front());
   489	    taken.pop_front();
   490	    bool ok = true;
   491	    for (const auto& f : failed)
   492	      if (f.first == e.device) ok = false;
   493	    if (ok)
   494	      release_entry(st, e);
   495	    else
   496	      leak_entry(st, e);
   497	  }
   498	  return failed;
   499	}
   500	
   501	cudaEvent_t acquire_event(int device) {
   502	  PendingState& st = pending();
   503	  auto it = st.event_pool.find(device);
   504	  if (it != st.event_pool.end() && !it->second.empty()) {
   505	    cudaEvent_t ev = it->second.back();
   506	    it->second.pop_back();
   507	    return ev;
   508	  }
   509	  QuietDeviceGuard g(device);
   510	  cudaEvent_t ev = nullptr;
   511	  cudaError_t r = g.ok() ? cudaEventCreateWithFlags(&ev, cudaEventDisableTiming) : cudaErrorInvalidDevice;
   512	  if (r != cudaSuccess) {
   513	    cudaGetLastError();
   514	    std::ostringstream os;
   515	    os << "tc_signal: cannot create the completion event on CUDA device " << device << ": " << cudaGetErrorName(r)
   516	       << ": " << cudaGetErrorString(r);
   517	    throw std::runtime_error(os.str());
   518	  }
   519	  return ev;
   520	}
   521	
   522	}  // namespace
   523	
   524	RetainUntilComplete::RetainUntilComplete(int device, std::initializer_list<Operand*> ops)
   525	    : device_(device), ops_(ops) {
   526	  owners_.reserve(ops_.size());
   527	  event_ = acquire_event(device_);  // last: if it throws, nothing else is held and nothing has been launched
   528	}
   529	
   530	RetainUntilComplete::~RetainUntilComplete() {
   531	  PendingState& st = pending();
   532	  PendingEntry e;
   533	  e.device = device_;
   534	  for (Operand* op : ops_) {
   535	    if (op == nullptr || !op->present()) continue;
   536	    e.bytes += op->numel() * static_cast<int64_t>(sizeof(float));  // checked at construction (F03)
   537	    owners_.push_back(op->take_owner());                           // reserved: no allocation
   538	  }
   539	  e.owners = std::move(owners_);
   540	  cudaError_t r = cudaSuccess;
   541	  {
   542	    QuietDeviceGuard g(device_);
   543	    r = g.ok() ? cudaEventRecord(event_, cudaStreamLegacy) : cudaErrorInvalidDevice;
   544	  }
   545	  if (r == cudaSuccess) {
   546	    e.event = event_;
   547	    try {
   548	      st.q.push_back(std::move(e));
   549	      note_push(st, st.q.back());
   550	    } catch (...) {
   551	      r = cudaErrorMemoryAllocation;  // e was not moved (push_back's strong guarantee): use the fallback below
   552	      e.event = nullptr;
   553	    }
   554	  } else {
   555	    cudaGetLastError();
   556	  }
   557	  if (r != cudaSuccess) {
   558	    // Fallback: no event, so synchronize this device's legacy stream; release on success, leak on failure.
   559	    ++st.fallback_syncs;
   560	    bool synced = false;
   561	    {
   562	      QuietDeviceGuard g(device_);
   563	      synced = g.ok() && cudaStreamSynchronize(cudaStreamLegacy) == cudaSuccess;
   564	      if (!synced) cudaGetLastError();
   565	    }
   566	    if (synced) {
   567	      recycle_event(st, device_, event_);
   568	      ++st.released_entries;
   569	      st.released_managers += e.owners.size();
   570	      for (ManagedOwner& o : e.owners) o.reset();
   571	    } else {
   572	      leak_entry(st, e);
   573	    }
   574	    return;
   575	  }
   576	  if (static_cast<long long>(st.q.size()) > tuning::kPendingMaxEntries || st.bytes > tuning::kPendingMaxBytes) {
   577	    ++st.bound_drains;
   578	    sync_and_release_all_impl();
   579	  }
   580	}
   581	
   582	void drain_completed() noexcept {
   583	  PendingState& st = pending();
   584	  while (!st.q.empty()) {
   585	    const cudaError_t r = cudaEventQuery(st.q.front().event);
   586	    if (r != cudaSuccess) {
   587	      // cudaErrorNotReady: still pending (FIFO: later entries wait too). CUDA 12.6 does not leave NotReady in the
   588	      // last-error slot (ledger receipt); clear it defensively if a runtime ever does. Any other error (a broken
   589	      // context) leaves the entry for synchronize_and_release_all, which leaks it if the device cannot synchronize.
   590	      if (r == cudaErrorNotReady && cudaPeekAtLastError() == cudaErrorNotReady) cudaGetLastError();
   591	      return;
   592	    }
   593	    PendingEntry e = std::move(st.q.front());
   594	    st.q.pop_front();
   595	    note_pop(st, e);
   596	    release_entry(st, e);
   597	  }
   598	}
   599	
   600	void synchronize_and_release_all() {
   601	  const auto failed = sync_and_release_all_impl();
   602	  if (!failed.empty()) {
   603	    std::ostringstream os;
   604	    os << "tc_signal.synchronize: the legacy stream could not be synchronized on";
   605	    for (const auto& f : failed)
   606	      os << " device " << f.first << " (" << cudaGetErrorName(f.second) << ": " << cudaGetErrorString(f.second) << ")";
   607	    os << "; the operands still pending there were deliberately leaked, not released";
   608	    throw std::runtime_error(os.str());
   609	  }
   610	}
   611	
   612	py::dict pending_stats(bool reset_high_water) {
   613	  PendingState& st = pending();
   614	  py::dict d;
   615	  d["entries"] = static_cast<long long>(st.q.size());
   616	  d["managers"] = st.managers;
   617	  d["bytes"] = st.bytes;
   618	  d["high_water_entries"] = st.high_water_entries;
   619	  d["high_water_managers"] = st.high_water_managers;
   620	  d["high_water_bytes"] = st.high_water_bytes;
   621	  d["retained_entries"] = st.retained_entries;
   622	  d["released_entries"] = st.released_entries;
   623	  d["released_managers"] = st.released_managers;
   624	  d["bound_drains"] = st.bound_drains;
   625	  d["fallback_syncs"] = st.fallback_syncs;
   626	  d["leaked_managers"] = st.leaked_managers;
   627	  d["max_entries"] = tuning::kPendingMaxEntries;
   628	  d["max_bytes"] = tuning::kPendingMaxBytes;
   629	  if (reset_high_water) {
   630	    st.high_water_entries = static_cast<long long>(st.q.size());
   631	    st.high_water_managers = st.managers;
   632	    st.high_water_bytes = st.bytes;
   633	  }
   634	  return d;
   635	}
   636	
   637	}  // namespace tcs
     1	// DLPack consumer side of tc_signal: turn any DLPack CUDA producer (or a bare capsule) into a validated fp32 operand.
     2	//
     3	// Prior art: DLPack (dmlc/dlpack, 2017-; header v1.3 vendored in include/dlpack/dlpack.h) for the DLManagedTensor /
     4	// DLManagedTensorVersioned ABI and the capsule rules ("dltensor" / "dltensor_versioned", renamed to "used_*" on
     5	// consumption, consumer calls the deleter); the Python array API standard's data-interchange protocol
     6	// (`__dlpack__(stream=, max_version=, copy=)`, Consortium for Python Data API Standards, 2021-2023) for the stream
     7	// argument and the max_version/TypeError fallback, which NumPy's and PyTorch's `from_dlpack` also implement. Ours: the
     8	// two-phase use (peek shapes for sizing without consuming, then consume and validate everything right before the launch),
     9	// and the validation set (device, dtype, compact strides with size-1 dimensions free, byte_offset, alignment, output
    10	// overlap, read-only/copied refusal for written operands).
    11	#pragma once
    12	
    13	#include <dlpack/dlpack.h>
    14	#include <pybind11/pybind11.h>
    15	
    16	#include <cstdint>
    17	#include <initializer_list>
    18	#include <string>
    19	#include <vector>
    20	
    21	struct CUevent_st;  // cudaEvent_t is `CUevent_st*` (CUDA driver_types.h); kept opaque in this header
    22	
    23	namespace tcs {
    24	namespace py = pybind11;
    25	
    26	// A DLPack capsule for `obj`: `obj` itself when it is a capsule, else `obj.__dlpack__(stream=1, max_version=(1, 3)
    27	// [, copy=False])`, falling back to `obj.__dlpack__(stream=1)` when the producer rejects the newer keywords with a
    28	// TypeError (pre-2023 producers). `writable` adds copy=False: a written operand must alias the producer's memory.
    29	py::object to_capsule(py::handle obj, const char* role, bool writable);
    30	
    31	// The DLTensor inside an unconsumed capsule (the capsule keeps ownership). Raises ValueError for a consumed capsule,
    32	// TypeError for a capsule of another kind.
    33	const DLTensor* peek(py::handle capsule, const char* role);
    34	
    35	// Device / dtype / layout checks shared by peek-time and consume-time validation (raises TypeError/ValueError). Also
    36	// the F03 (P1T-FIX1) checked arithmetic: rank >= 0, a non-NULL shape array, the element count, the fp32 byte total and
    37	// data + byte_offset + bytes must not overflow (ValueError). Returns the element count.
    38	int64_t validate_tensor(const DLTensor* t, const char* role, int ndim);
    39	
    40	// F02 (P1T-FIX1): a REQUIRED operand passed as None raises TypeError, before any planning, allocation or consumption.
    41	// Optional operands (bias, scale, initial state) are the only ones a caller may pass as None.
    42	void require_operand(py::handle obj, const char* role);
    43	
    44	// Owner of one consumed managed tensor (legacy or versioned). Calls the producer's deleter exactly once, in reset() or
    45	// in the destructor. It is a separate member so that a throw from Operand's constructor (after the capsule has been
    46	// consumed) still runs it: C++ destroys fully constructed members when a constructor throws.
    47	struct ManagedOwner {
    48	  DLManagedTensor* legacy = nullptr;
    49	  DLManagedTensorVersioned* versioned = nullptr;
    50	  ManagedOwner() = default;
    51	  ~ManagedOwner() { reset(); }
    52	  ManagedOwner(ManagedOwner&& o) noexcept;
    53	  ManagedOwner& operator=(ManagedOwner&& o) noexcept;
    54	  ManagedOwner(const ManagedOwner&) = delete;
    55	  ManagedOwner& operator=(const ManagedOwner&) = delete;
    56	  void reset() noexcept;
    57	  // F01: deliberately drop ownership WITHOUT calling the deleter (used only when tc_signal cannot prove the GPU is done
    58	  // with the memory, e.g. a broken CUDA context: a leak is safe, a release could be a use-after-free).
    59	  void leak() noexcept {
    60	    legacy = nullptr;
    61	    versioned = nullptr;
    62	  }
    63	  bool empty() const { return legacy == nullptr && versioned == nullptr; }
    64	};
    65	
    66	// One consumed DLPack operand. Owns the managed tensor (through ManagedOwner) and calls the producer's deleter exactly
    67	// once: in release() or in the destructor, so every exception path after consumption still returns the tensor to its
    68	// producer.
    69	//
    70	// Absent operands (default-constructed, for an optional None) report present() == false. Reading an absent operand's
    71	// metadata (dim, ndim, device, numel) raises TypeError instead of dereferencing NULL (F02's second line of defence).
    72	class Operand {
    73	 public:
    74	  Operand() = default;
    75	  Operand(py::handle capsule, const char* role, int ndim, bool writable);
    76	  ~Operand();
    77	  Operand(Operand&& o) noexcept;
    78	  Operand& operator=(Operand&& o) noexcept;
    79	  Operand(const Operand&) = delete;
    80	  Operand& operator=(const Operand&) = delete;
    81	
    82	  bool present() const { return t_ != nullptr; }
    83	  float* data() const { return data_; }
    84	  int64_t dim(int i) const { return meta()->shape[i]; }
    85	  int ndim() const { return meta()->ndim; }
    86	  int device() const { return meta()->device.device_id; }
    87	  int64_t numel() const;
    88	  // Validated at construction: begin + numel * 4 does not overflow (F03).
    89	  uintptr_t byte_begin() const { return reinterpret_cast<uintptr_t>(data_); }
    90	  uintptr_t byte_end() const { return byte_begin() + static_cast<uintptr_t>(numel_) * sizeof(float); }
    91	  const char* role() const { return role_; }
    92	  void release();
    93	  // F01: hands the consumed manager to the deferred-release list (RetainUntilComplete); the operand becomes absent.
    94	  ManagedOwner take_owner();
    95	
    96	 private:
    97	  const DLTensor* meta() const;  // t_, or TypeError when absent
    98	  ManagedOwner owner_;
    99	  const DLTensor* t_ = nullptr;
   100	  float* data_ = nullptr;
   101	  int64_t numel_ = 0;
   102	  const char* role_ = "";
   103	};
   104	
   105	// ------------------------------------------------------------------------------------------------ deferred release (F01)
   106	// P1T-FIX1, review finding F01 (BLOCKING): a consumed DLPack manager may be the LAST owner of its memory (a bare capsule,
   107	// or a producer's temporary copy). Calling its deleter right after the launches let a producer on another stream reuse
   108	// the block before the legacy stream had read or written it (use-after-free, reproduced by addon_lifetime.py). Now
   109	// every consumed manager of a call that reached the launch stays alive until the legacy stream has passed that call:
   110	//   * RetainUntilComplete (constructed right before the launch, destroyed on scope exit, success OR exception after a
   111	//     partial launch) records one CUDA event on the operand device's legacy stream and moves every operand's manager
   112	//     into a module-level FIFO pending list together with that event;
   113	//   * completed entries (cudaEventQuery == cudaSuccess) are released in FIFO order, on the calling host thread with
   114	//     the GIL held, at the start of the next tc_signal call (drain_completed), in tc_signal.synchronize(), and from an
   115	//     atexit hook (both: synchronize_and_release_all);
   116	//   * the list is bounded (tuning.h: kPendingMaxEntries, kPendingMaxBytes); when a push exceeds a bound, the legacy
   117	//     stream of every pending device is synchronized and the whole list is released;
