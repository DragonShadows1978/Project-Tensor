    96	// Consumes a capsule returned by a *_plan call (its rank is read from the capsule, then fully re-validated).
    97	Operand consume4(py::handle cap, const char* role, int rank, int min_rank, Need need) {
    98	  if (need == Need::kRequired) require_operand(cap, role);  // F02
    99	  if (cap.is_none()) return Operand();
   100	  const DLTensor* t = peek(cap, role);
   101	  const int nd = t->ndim;
   102	  Operand op(cap, role, rank >= 0 ? rank : nd, false);
   103	  check_rank(role, op.ndim(), rank, min_rank);
   104	  return op;
   105	}
