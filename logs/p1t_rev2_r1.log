   222	  return parsed;
   223	}
   224	
   225	// ===================================================================== DLPack
   226	// P1T-M1 (Project-Voice T1): zero-copy DLPack export/import.
   227	//
   228	// Prior art: DLPack (dmlc/dlpack, 2017-; v1.3 header vendored verbatim at
   229	// include/dlpack/dlpack.h); the Python array API standard's data-interchange
   230	// protocol (__dlpack__(stream=, max_version=, dl_device=, copy=) and
   231	// __dlpack_device__; Consortium for Python Data API Standards, 2021-2023);
   232	// PyTorch's ATen DLConvertor/torch.utils.dlpack and CuPy's from_dlpack
   233	// (owner keepalive: the manager context owns a reference to the producer's
   234	// storage, and the consumer keeps the manager until its tensor dies; capsule
   235	// renamed "used_*" on consumption). Taken: the protocol, capsule naming and
   236	// the keepalive pattern; the event-record + cudaStreamWaitEvent fence is the
   237	// standard CUDA cross-stream idiom. Ours: wiring it to tc::Storage (a
   238	// shared_ptr<Storage> owner on export; an external-release Storage that
   239	// drains the engine stream before the deleter on import, kernels.cu).
   240	constexpr const char* kCapLegacy = "dltensor";
   241	constexpr const char* kCapVersioned = "dltensor_versioned";
   242	constexpr const char* kCapUsedLegacy = "used_dltensor";
   243	constexpr const char* kCapUsedVersioned = "used_dltensor_versioned";
   244	
   245	DLDataType to_dl_dtype(DType dt) {
   246	  auto mk = [](int code, int bits) {
   247	    DLDataType d;
   248	    d.code = static_cast<uint8_t>(code);
   249	    d.bits = static_cast<uint8_t>(bits);
   250	    d.lanes = 1;
   251	    return d;
   252	  };
   253	  switch (dt) {
   254	    case DType::Float32: return mk(kDLFloat, 32);
   255	    case DType::Float16: return mk(kDLFloat, 16);
   256	    case DType::BFloat16: return mk(kDLBfloat, 16);
   257	    case DType::Int64: return mk(kDLInt, 64);
   258	    case DType::Uint8: return mk(kDLUInt, 8);
   259	    case DType::Bool: return mk(kDLBool, 8);
   260	  }
   261	  throw py::buffer_error("__dlpack__: dtype has no DLPack mapping");
   262	}
   263	
   264	// Exact matches only: TensorCUDA never converts on import.
   265	bool from_dl_dtype(const DLDataType& d, DType* out) {
   266	  if (d.lanes != 1) return false;
   267	  if (d.code == kDLFloat && d.bits == 32) { *out = DType::Float32; return true; }
   268	  if (d.code == kDLFloat && d.bits == 16) { *out = DType::Float16; return true; }
   269	  if (d.code == kDLBfloat && d.bits == 16) { *out = DType::BFloat16; return true; }
   270	  if (d.code == kDLInt && d.bits == 64) { *out = DType::Int64; return true; }
   271	  if (d.code == kDLUInt && d.bits == 8) { *out = DType::Uint8; return true; }
   272	  if (d.code == kDLBool && d.bits == 8) { *out = DType::Bool; return true; }
   273	  return false;
   274	}
   275	
   276	std::string shape_str(const int64_t* v, int n) {
   277	  std::string s = "[";
   278	  for (int i = 0; i < n; ++i) s += (i ? ", " : "") + std::to_string(v[i]);
   279	  return s + "]";
   280	}
   281	
   282	// P1T-FIX1, F03: checked element count and byte size for the two entry points that turn arbitrary caller shapes into
   283	// a Storage (empty, from_dlpack). Every extent is >= 0 here (callers refuse negatives first); a zero extent makes the
   284	// count 0 whatever the other extents are. Overflow raises ValueError and never wraps to an empty or short Storage.
   285	// The byte ceiling is INT64_MAX (every byte total, offset and pointer difference stays a valid int64/ptrdiff_t).
   286	// Prior art: GCC/Clang __builtin_mul_overflow / __builtin_add_overflow (GCC 5, 2015); C23 ckd_mul / ckd_add
   287	// (<stdckdint.h>, ISO/IEC 9899:2024); SEI CERT C INT30-C / INT32-C. Taken: the checked-operation primitive. Ours:
   288	// where it is applied. Unverified here (lead to check): "GCC 5 __builtin_mul_overflow", "C23 stdckdint".
   289	int64_t checked_numel(const int64_t* dims, int n, const char* who) {
   290	  for (int i = 0; i < n; ++i)
   291	    if (dims[i] == 0) return 0;
   292	  int64_t p = 1;
   293	  for (int i = 0; i < n; ++i)
   294	    if (__builtin_mul_overflow(p, dims[i], &p))
   295	      throw py::value_error(std::string(who) + ": the element count of shape " + shape_str(dims, n) +
   296	                            " overflows int64; refused");
   297	  return p;
   298	}
   299	
   300	int64_t checked_nbytes(int64_t numel, size_t itemsize, const int64_t* dims, int n, const char* who) {
   301	  int64_t b = 0;
   302	  if (__builtin_mul_overflow(numel, static_cast<int64_t>(itemsize), &b))
   303	    throw py::value_error(std::string(who) + ": the byte size of shape " + shape_str(dims, n) + " (" +
   304	                          std::to_string(itemsize) + "-byte elements) overflows int64; refused");
   305	  return b;
   306	}
   307	
   308	// ---- export: the manager context OWNS a reference to the Storage, so the
   309	// memory outlives the producer Tensor's last Python reference.
   310	struct DLPackExportCtx {
   311	  std::shared_ptr<Storage> owner;
   312	  std::vector<int64_t> shape;
   313	  std::vector<int64_t> strides;
   314	  DLManagedTensor legacy{};
   315	  DLManagedTensorVersioned versioned{};
   316	};
   317	
   318	void export_deleter_legacy(DLManagedTensor* self) {
   319	  delete static_cast<DLPackExportCtx*>(self->manager_ctx);
   320	}
   321	void export_deleter_versioned(DLManagedTensorVersioned* self) {
   322	  delete static_cast<DLPackExportCtx*>(self->manager_ctx);
   323	}
   324	
   325	// PyCapsule destructors: an UNCONSUMED capsule (still named dltensor*) owns
   326	// its manager and must call the deleter; a consumed one ("used_*") does not.
   327	void capsule_destructor_legacy(PyObject* cap) {
   328	  if (!PyCapsule_IsValid(cap, kCapLegacy)) return;
   329	  PyObject *et, *ev, *etb;
   330	  PyErr_Fetch(&et, &ev, &etb);
   331	  auto* m = static_cast<DLManagedTensor*>(PyCapsule_GetPointer(cap, kCapLegacy));
   332	  if (m && m->deleter) m->deleter(m);
   333	  PyErr_Restore(et, ev, etb);
   334	}
   335	void capsule_destructor_versioned(PyObject* cap) {
   336	  if (!PyCapsule_IsValid(cap, kCapVersioned)) return;
   337	  PyObject *et, *ev, *etb;
   338	  PyErr_Fetch(&et, &ev, &etb);
   339	  auto* m = static_cast<DLManagedTensorVersioned*>(
   340	      PyCapsule_GetPointer(cap, kCapVersioned));
   341	  if (m && m->deleter) m->deleter(m);
   342	  PyErr_Restore(et, ev, etb);
   343	}
   344	
   345	// Stream contract (array API): `stream` is the CONSUMER's stream. TensorCUDA
   346	// queues all work on the legacy default stream. None/1 = the consumer is on
   347	// the legacy stream too (nothing to do); -1 = no synchronization; 2 = the
   348	// per-thread default stream; > 2 = a cudaStream_t. For 2 and handles, record
   349	// an event on the legacy stream and make the consumer wait on it.
   350	void dlpack_fence_consumer(const py::object& stream) {
   351	  if (stream.is_none()) return;
   352	  if (!py::isinstance<py::int_>(stream))
   353	    throw py::type_error("__dlpack__: stream must be an int or None");
   354	  const long long s = stream.cast<long long>();
   355	  if (s == -1 || s == 1) return;
   356	  if (s == 0)
   357	    throw py::value_error(
   358	        "__dlpack__: stream=0 is ambiguous for CUDA under the DLPack protocol; "
   359	        "use None or 1 (legacy default stream), 2 (per-thread default stream) "
   360	        "or a cudaStream_t handle");
   361	  if (s < -1) throw py::value_error("__dlpack__: invalid stream " + std::to_string(s));
   362	  cudaStream_t consumer =
   363	      (s == 2) ? cudaStreamPerThread
   364	               : reinterpret_cast<cudaStream_t>(static_cast<uintptr_t>(s));
   365	  cudaEvent_t ev = nullptr;
   366	  cudaError_t e = cudaEventCreateWithFlags(&ev, cudaEventDisableTiming);
   367	  if (e == cudaSuccess) e = cudaEventRecord(ev, cudaStreamLegacy);  // engine stream
   368	  if (e == cudaSuccess) e = cudaStreamWaitEvent(consumer, ev, 0);
   369	  // Safe right after the wait is enqueued: the dependency is captured at the
   370	  // cudaStreamWaitEvent call and the runtime frees the event once it fires.
   371	  if (ev) cudaEventDestroy(ev);
   372	  if (e != cudaSuccess) {
   373	    cudaGetLastError();
   374	    throw std::runtime_error(std::string("__dlpack__: stream fence failed: ") +
   375	                             cudaGetErrorString(e));
   376	  }
   377	}
   378	
   379	py::object tensor_dlpack(Tensor& t, py::object stream, py::object max_version,
   380	                         py::object dl_device, py::object copy) {
   381	  if (!t.defined() || !t.data().defined())
   382	    throw py::buffer_error("__dlpack__: undefined tensor");
   383	  const NDArray& a = t.data();
   384	  if (!a.device.is_cuda())
   385	    throw py::buffer_error(
   386	        "__dlpack__: TensorCUDA exports CUDA tensors only; this tensor is on "
   387	        "cpu (CPU DLPack export is not supported)");
   388	  if (!copy.is_none() && copy.cast<bool>())
   389	    throw py::buffer_error(
   390	        "__dlpack__: copy=True is not supported; TensorCUDA exports zero-copy "
   391	        "only (pass copy=None or copy=False)");
   392	  if (!dl_device.is_none()) {
   393	    py::sequence d = dl_device.cast<py::sequence>();
   394	    if (py::len(d) != 2)
   395	      throw py::value_error("__dlpack__: dl_device must be a (device_type, device_id) pair");
   396	    const int dt = d[0].cast<int>();
   397	    const int id = d[1].cast<int>();
   398	    if (dt != kDLCUDA || id != a.device.index)
   399	      throw py::buffer_error(
   400	          "__dlpack__: dl_device=(" + std::to_string(dt) + ", " +
   401	          std::to_string(id) + ") differs from this tensor's device (2, " +
   402	          std::to_string(a.device.index) +
   403	          "); a cross-device export needs a copy, which TensorCUDA does not make");
   404	  }
   405	  bool versioned = false;
   406	  if (!max_version.is_none()) {
   407	    py::sequence mv = max_version.cast<py::sequence>();
   408	    if (py::len(mv) < 1)
   409	      throw py::value_error("__dlpack__: max_version must be a (major, minor) pair");
   410	    versioned = mv[0].cast<int>() >= 1;
   411	  }
   412	
   413	  dlpack_fence_consumer(stream);
   414	
   415	  // P1T-FIX1, F06: the context (and its shared Storage reference) is owned by a unique_ptr until the capsule takes it,
   416	  // so a throw anywhere below (bad_alloc in the vector assignments, a failed PyCapsule_New) frees it exactly once.
   417	  // Prior art: C++ RAII (Stroustrup) and std::unique_ptr's release() hand-off (C++11); pybind11/CPython capsule
   418	  // ownership. Nothing new.
   419	  auto ctx = std::make_unique<DLPackExportCtx>();
   420	  ctx->owner = a.storage;
   421	  ctx->shape.assign(a.shape.begin(), a.shape.end());
   422	  Shape st = contiguous_strides(a.shape);
   423	  ctx->strides.assign(st.begin(), st.end());
   424	  const int nd = a.ndim();
   425	  DLTensor dl{};
   426	  dl.data = a.storage->ptr;  // allocation base; element 0 is data + byte_offset
   427	  dl.byte_offset = static_cast<uint64_t>(a.offset) * dtype_size(a.dtype);
   428	  dl.device.device_type = kDLCUDA;
   429	  dl.device.device_id = a.device.index;
   430	  dl.ndim = nd;
   431	  dl.dtype = to_dl_dtype(a.dtype);
   432	  dl.shape = nd ? ctx->shape.data() : nullptr;
   433	  dl.strides = nd ? ctx->strides.data() : nullptr;
   434	
   435	  PyObject* cap = nullptr;
   436	  if (versioned) {
   437	    DLManagedTensorVersioned& mt = ctx->versioned;
   438	    mt.version.major = DLPACK_MAJOR_VERSION;
   439	    mt.version.minor = DLPACK_MINOR_VERSION;
   440	    mt.manager_ctx = ctx.get();
   441	    mt.deleter = export_deleter_versioned;
   442	    mt.flags = 0;
   443	    mt.dl_tensor = dl;
   444	    cap = PyCapsule_New(&mt, kCapVersioned, capsule_destructor_versioned);
   445	  } else {
   446	    DLManagedTensor& mt = ctx->legacy;
   447	    mt.dl_tensor = dl;
   448	    mt.manager_ctx = ctx.get();
   449	    mt.deleter = export_deleter_legacy;
   450	    cap = PyCapsule_New(&mt, kCapLegacy, capsule_destructor_legacy);
   451	  }
   452	  if (!cap) throw py::error_already_set();  // ctx is freed by its unique_ptr
   453	  ctx.release();  // owned by the capsule from here: its destructor, or the consumer's deleter call, frees it
   454	  return py::reinterpret_steal<py::object>(cap);
   455	}
   456	
   457	py::tuple tensor_dlpack_device(Tensor& t) {
   458	  if (!t.defined() || !t.device().is_cuda())
   459	    throw py::buffer_error(
   460	        "__dlpack_device__: TensorCUDA exports CUDA tensors only; this tensor "
   461	        "is on cpu");
   462	  return py::make_tuple(static_cast<int>(kDLCUDA), t.device().index);
   463	}
   464	
   465	// ---- import: the Storage keeps the producer's manager alive; its destructor
   466	// drains the Storage device's engine stream (kernels.cu) and then calls this,
   467	// which calls the producer's deleter with the GIL held.
   468	//
   469	// P1T-FIX1, F04 (finalization-safe release). The last reference can die on any
   470	// thread, including a non-Python thread while CPython is finalizing. Once
   471	// finalization has started (or the interpreter is gone), PyGILState_Ensure is
   472	// unsafe: CPython 3.12 terminates a non-main thread that tries to take the GIL
   473	// during finalization (in the middle of this deleter), and newer runtimes may
   474	// hang it. So in that state this function does NOT call PyGILState_Ensure and
   475	// DELIBERATELY LEAKS the producer's manager (the memory is not handed back; the
   476	// process is exiting). Ordinary releases are unchanged.
   477	// Detection: Py_IsInitialized() plus Py_IsFinalizing() (3.13+) / the exported
   478	// _Py_IsFinalizing() (3.12). Measured on CPython 3.12.3 (P1T_FIX1 ledger): during
   479	// module teardown Py_IsInitialized() is already 0 and _Py_IsFinalizing() is 1,
   480	// because 3.12 clears `initialized` when it sets the finalizing thread; the
   481	// explicit finalizing test keeps this correct if a runtime orders those two
   482	// stores differently. Residual (not closed here): a thread that passed this
   483	// test an instant before finalization starts can still reach
   484	// PyGILState_Ensure; closing that needs lifecycle coordination with the
   485	// interpreter, which the order does not ask for.
   486	// Prior art: the CPython 3.12 C-API docs (Initialization, Finalization, and
   487	// Threads: PyGILState_Ensure / Py_IsFinalizing, "calling this function from a
   488	// thread when the runtime is finalizing will terminate the thread"); pybind11's
   489	// guidance not to touch the GIL during interpreter shutdown. Taken: the rule.
   490	// Ours: the deliberate-leak policy at this call site and its counters.
   491	std::atomic<unsigned long long> g_import_released{0};
   492	std::atomic<unsigned long long> g_import_leaked_shutdown{0};
   493	
   494	bool interpreter_accepts_gil_state() {
   495	  if (!Py_IsInitialized()) return false;
   496	#if PY_VERSION_HEX >= 0x030D0000
   497	  if (Py_IsFinalizing()) return false;
   498	#else
   499	  if (_Py_IsFinalizing()) return false;
   500	#endif
   501	  return true;
   502	}
   503	
   504	void import_release_legacy(void* ctx) {
   505	  auto* m = static_cast<DLManagedTensor*>(ctx);
   506	  if (!m || !m->deleter) return;
   507	  if (!interpreter_accepts_gil_state()) {  // deliberate leak (see above)
   508	    g_import_leaked_shutdown.fetch_add(1);
   509	    return;
   510	  }
   511	  PyGILState_STATE g = PyGILState_Ensure();
   512	  m->deleter(m);
   513	  PyGILState_Release(g);
   514	  g_import_released.fetch_add(1);
   515	}
   516	void import_release_versioned(void* ctx) {
   517	  auto* m = static_cast<DLManagedTensorVersioned*>(ctx);
   518	  if (!m || !m->deleter) return;
   519	  if (!interpreter_accepts_gil_state()) {  // deliberate leak (see above)
   520	    g_import_leaked_shutdown.fetch_add(1);
   521	    return;
   522	  }
   523	  PyGILState_STATE g = PyGILState_Ensure();
   524	  m->deleter(m);
   525	  PyGILState_Release(g);
   526	  g_import_released.fetch_add(1);
   527	}
   528	void import_release_noop(void*) {}
   529	
   530	Tensor tensor_from_dlpack_capsule(py::object obj) {
   531	  PyObject* cap = obj.ptr();
   532	  bool versioned = false;
   533	  if (PyCapsule_IsValid(cap, kCapVersioned)) {
   534	    versioned = true;
   535	  } else if (!PyCapsule_IsValid(cap, kCapLegacy)) {
   536	    if (PyCapsule_CheckExact(cap)) {
   537	      const char* name = PyCapsule_GetName(cap);
   538	      PyErr_Clear();
   539	      throw py::value_error(
   540	          std::string("from_dlpack: capsule named '") + (name ? name : "NULL") +
   541	          "' is not an unconsumed DLPack capsule (a capsule can be consumed "
   542	          "only once)");
   543	    }
   544	    throw py::type_error(
   545	        "from_dlpack: expected an object with __dlpack__ or a DLPack capsule");
   546	  }
   547	  DLTensor* dl = nullptr;
   548	  void* manager = nullptr;
   549	  uint64_t flags = 0;
   550	  if (versioned) {
   551	    auto* m = static_cast<DLManagedTensorVersioned*>(
   552	        PyCapsule_GetPointer(cap, kCapVersioned));
   553	    if (!m) throw py::error_already_set();
   554	    if (m->version.major != DLPACK_MAJOR_VERSION)
   555	      throw py::buffer_error(
   556	          "from_dlpack: DLPack major version " + std::to_string(m->version.major) +
   557	          " is not supported (this build speaks DLPack " +
   558	          std::to_string(DLPACK_MAJOR_VERSION) + ".x)");
   559	    dl = &m->dl_tensor;
   560	    flags = m->flags;
   561	    manager = m;
   562	  } else {
   563	    auto* m = static_cast<DLManagedTensor*>(PyCapsule_GetPointer(cap, kCapLegacy));
   564	    if (!m) throw py::error_already_set();
   565	    dl = &m->dl_tensor;
   566	    manager = m;
   567	  }
   568	  // Every refusal below leaves the capsule unconsumed, so its destructor
   569	  // hands the memory back to the producer.
   570	  if (flags & DLPACK_FLAG_BITMASK_READ_ONLY)
   571	    throw py::buffer_error(
   572	        "from_dlpack: the producer marked this tensor read-only; TensorCUDA "
   573	        "tensors are writable, so read-only imports are refused");
   574	  if (dl->device.device_type != kDLCUDA)
   575	    throw py::buffer_error(
   576	        "from_dlpack: only CUDA device memory (kDLCUDA = 2) can be imported; "
   577	        "got device type " + std::to_string(static_cast<int>(dl->device.device_type)) +
   578	        (dl->device.device_type == kDLCPU ? " (CPU)" : ""));
   579	  int cur = 0;
   580	  cudaGetDevice(&cur);
   581	  if (dl->device.device_id != cur)
   582	    throw py::buffer_error(
   583	        "from_dlpack: tensor is on CUDA device " + std::to_string(dl->device.device_id) +
   584	        " but TensorCUDA runs on device " + std::to_string(cur) +
   585	        " (multi-GPU import is not supported)");
   586	  DType dt;
   587	  if (!from_dl_dtype(dl->dtype, &dt))
   588	    throw py::buffer_error(
   589	        "from_dlpack: DLPack dtype (code=" + std::to_string(dl->dtype.code) +
   590	        ", bits=" + std::to_string(dl->dtype.bits) + ", lanes=" +
   591	        std::to_string(dl->dtype.lanes) +
   592	        ") has no exact TensorCUDA dtype; TensorCUDA never converts on import "
   593	        "(supported: float32, float16, bfloat16, int64, uint8, bool)");
   594	  if (dl->ndim < 0 || dl->ndim > TC_MAX_DIMS)
   595	    throw py::buffer_error("from_dlpack: ndim " + std::to_string(dl->ndim) +
   596	                           " is outside TensorCUDA's 0.." +
   597	                           std::to_string(TC_MAX_DIMS));
   598	  const int nd = dl->ndim;
   599	  if (nd > 0 && dl->shape == nullptr)
   600	    throw py::buffer_error("from_dlpack: NULL shape array for a tensor with dimensions");
   601	  Shape shape(nd);
   602	  for (int i = 0; i < nd; ++i) {
   603	    if (dl->shape[i] < 0)
   604	      throw py::buffer_error("from_dlpack: negative extent in shape " +
   605	                             shape_str(dl->shape, nd));
   606	    shape[i] = dl->shape[i];
   607	  }
   608	  // F03 (P1T-FIX1): checked count (ValueError on overflow, never a wrapped size).
   609	  const int64_t numel = checked_numel(dl->shape, nd, "from_dlpack");
   610	  // C-contiguous only; a size-1 dimension may carry any stride (it is never
   611	  // stepped). Strides == NULL means compact row-major (DLPack < 1.2).
   612	  if (nd > 0 && dl->strides && numel > 0) {
   613	    int64_t expected = 1;
   614	    for (int i = nd - 1; i >= 0; --i) {
   615	      if (shape[i] != 1 && dl->strides[i] != expected)
   616	        throw py::buffer_error(
   617	            "from_dlpack: non-contiguous strides " + shape_str(dl->strides, nd) +
   618	            " for shape " + shape_str(dl->shape, nd) +
   619	            "; TensorCUDA imports C-contiguous (row-major) tensors only "
   620	            "(size-1 dimensions may have any stride). Make the tensor "
   621	            "contiguous on the producer side first.");
   622	      expected *= shape[i];
   623	    }
   624	  }
   625	  const size_t isz = dtype_size(dt);
   626	  if (dl->byte_offset % isz != 0)
   627	    throw py::buffer_error("from_dlpack: byte_offset " +
   628	                           std::to_string(dl->byte_offset) +
   629	                           " is not a multiple of the element size " +
   630	                           std::to_string(isz));
   631	  if (numel > 0 && dl->data == nullptr)
   632	    throw py::buffer_error("from_dlpack: null data pointer for a non-empty tensor");
   633	  // F03 (P1T-FIX1): checked byte size, byte_offset + bytes (the Storage's
   634	  // nbytes) and data + byte_offset + bytes (one past the last byte); each
   635	  // overflow raises ValueError and leaves the capsule unconsumed.
   636	  const int64_t nbytes = checked_nbytes(numel, isz, dl->shape, nd, "from_dlpack");
   637	  int64_t storage_bytes = 0;
