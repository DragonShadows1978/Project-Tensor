   148	void same_device_peeked(const std::vector<const Peeked*>& ps, const std::vector<const char*>& roles) {
   149	  int dev = -1;
   150	  const char* first = "";
   151	  for (size_t i = 0; i < ps.size(); ++i) {
   152	    if (!ps[i]->present) continue;
   153	    if (dev < 0) {
   154	      dev = ps[i]->device;
   155	      first = roles[i];
   156	    } else if (ps[i]->device != dev) {
   157	      std::ostringstream os;
   158	      os << "tc_signal: operand '" << roles[i] << "': on CUDA device " << ps[i]->device << " but operand '" << first
   159	         << "' is on CUDA device " << dev << "; every operand must be on the same device";
   160	      throw py::value_error(os.str());
   161	    }
   162	  }
   163	}
