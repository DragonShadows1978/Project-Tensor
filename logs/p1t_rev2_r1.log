   271	    o.data_ = nullptr;
   272	    o.numel_ = 0;
   273	  }
   274	  return *this;
   275	}
   276	
   277	const DLTensor* Operand::meta() const {
   278	  // F02 second line of defence: an absent (None) operand has no metadata; never dereference NULL.
   279	  if (t_ == nullptr)
   280	    refuse_type(role_[0] ? role_ : "?", "is absent (None); its shape/device cannot be read");
   281	  return t_;
   282	}
   283	
   284	int64_t Operand::numel() const {
   285	  meta();
   286	  return numel_;  // checked at construction (validate_tensor)
   287	}
   288	
   289	void Operand::release() {
   290	  owner_.reset();
   291	  t_ = nullptr;
   292	  data_ = nullptr;
   293	  numel_ = 0;
   294	}
   295	
   296	ManagedOwner Operand::take_owner() {
   297	  ManagedOwner o(std::move(owner_));
   298	  t_ = nullptr;
   299	  data_ = nullptr;
   300	  numel_ = 0;
