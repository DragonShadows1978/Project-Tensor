   125	int64_t validate_tensor(const DLTensor* t, const char* role, int ndim) {
   126	  if (t->device.device_type != kDLCUDA) {
   127	    std::ostringstream os;
   128	    os << "device type " << static_cast<int>(t->device.device_type)
   129	       << " is not kDLCUDA (2); tc_signal takes CUDA device memory only";
   130	    refuse_value(role, os.str());
   131	  }
   132	  if (t->dtype.code != kDLFloat || t->dtype.bits != 32 || t->dtype.lanes != 1) {
   133	    std::ostringstream os;
   134	    os << "dtype (code " << static_cast<int>(t->dtype.code) << ", bits " << static_cast<int>(t->dtype.bits)
   135	       << ", lanes " << t->dtype.lanes
   136	       << ") is not float32; tc_signal computes in fp32 only (expand fp16 weights to fp32 first)";
   137	    refuse_type(role, os.str());
   138	  }
   139	  // F03 (P1T-FIX1): a negative rank or a NULL shape array (with rank > 0) is refused before the shape is read.
   140	  if (t->ndim < 0) {
   141	    std::ostringstream os;
   142	    os << "negative number of dimensions " << t->ndim;
   143	    refuse_value(role, os.str());
   144	  }
   145	  if (t->ndim > 0 && t->shape == nullptr) refuse_value(role, "NULL shape array for a tensor with dimensions");
   146	  if (t->ndim != ndim) {
   147	    std::ostringstream os;
   148	    os << "expected " << ndim << " dimensions, got " << t->ndim;
   149	    refuse_value(role, os.str());
   150	  }
   151	  for (int i = 0; i < t->ndim; ++i)
   152	    if (t->shape[i] <= 0) refuse_value(role, "empty operand (shape " + shape_str(shape_of(t)) + ")");
   153	  // F03: checked element count and fp32 byte total (every extent is >= 1 here), before the stride walk below
   154	  // multiplies extents and before any later byte range is formed.
   155	  int64_t numel = 1;
   156	  for (int i = 0; i < t->ndim; ++i) {
   157	    if (__builtin_mul_overflow(numel, t->shape[i], &numel))
   158	      refuse_value(role, "element count of shape " + shape_str(shape_of(t)) + " overflows int64");
   159	  }
   160	  int64_t nbytes = 0;
   161	  if (__builtin_mul_overflow(numel, static_cast<int64_t>(sizeof(float)), &nbytes))
   162	    refuse_value(role, "byte size of shape " + shape_str(shape_of(t)) + " (fp32) overflows int64");
   163	  if (t->strides != nullptr) {
   164	    // C-contiguous: every dimension of extent > 1 has the compact stride; size-1 dimensions may carry any stride
   165	    // (they are never stepped), as the order and the DLPack/array API conventions allow.
   166	    int64_t want = 1;
   167	    for (int i = t->ndim - 1; i >= 0; --i) {
   168	      if (t->shape[i] != 1 && t->strides[i] != want) {
   169	        std::ostringstream os;
   170	        os << "not C-contiguous (shape " << shape_str(shape_of(t)) << ", strides [";
   171	        for (int j = 0; j < t->ndim; ++j) os << (j ? ", " : "") << t->strides[j];
   172	        os << "]); pass a contiguous tensor";
   173	        refuse_value(role, os.str());
   174	      }
   175	      want *= t->shape[i];
   176	    }
   177	  }
   178	  if (t->data == nullptr) refuse_value(role, "NULL data pointer");
   179	  // F03: data + byte_offset (element 0) and element 0 + nbytes (one past the end) must not wrap the address space.
   180	  uintptr_t p = 0;
   181	  uintptr_t end = 0;
   182	  if (__builtin_add_overflow(reinterpret_cast<uintptr_t>(t->data), static_cast<uintptr_t>(t->byte_offset), &p) ||
   183	      __builtin_add_overflow(p, static_cast<uintptr_t>(nbytes), &end))
