   140	  if (t->ndim < 0) {
   141	    std::ostringstream os;
   142	    os << "negative number of dimensions " << t->ndim;
   143	    refuse_value(role, os.str());
   144	  }
   145	  if (t->ndim > 0 && t->shape == nullptr) refuse_value(role, "NULL shape array for a tensor with dimensions");
   146	  if (t->ndim != ndim) {
   147	    std::ostringstream os;
   148	    os << "expected " << ndim << " dimensions, got " << t->ndim;
   149	    refuse_value(role, os.str());
   150	  }
   151	  for (int i = 0; i < t->ndim; ++i)
   152	    if (t->shape[i] <= 0) refuse_value(role, "empty operand (shape " + shape_str(shape_of(t)) + ")");
   153	  // F03: checked element count and fp32 byte total (every extent is >= 1 here), before the stride walk below
   154	  // multiplies extents and before any later byte range is formed.
   155	  int64_t numel = 1;
   156	  for (int i = 0; i < t->ndim; ++i) {
   157	    if (__builtin_mul_overflow(numel, t->shape[i], &numel))
   158	      refuse_value(role, "element count of shape " + shape_str(shape_of(t)) + " overflows int64");
   159	  }
   160	  int64_t nbytes = 0;
   161	  if (__builtin_mul_overflow(numel, static_cast<int64_t>(sizeof(float)), &nbytes))
   162	    refuse_value(role, "byte size of shape " + shape_str(shape_of(t)) + " (fp32) overflows int64");
