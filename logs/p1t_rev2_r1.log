   263	    bad_attr4(os.str());
   264	  }
   265	  if (pb >= T || pe >= T) {
   266	    os << "reflection_pad1d: each pad must be < T (" << T << ") for reflect padding (ONNX/torch), got (" << pb << ", "
   267	       << pe << ")";
   268	    bad_attr4(os.str());
   269	  }
   270	  std::vector<int64_t> o = xs;
   271	  // F03: T + pb + pe checked (the review's CPU reproduction returned a negative extent here), then the output size.
   272	  o.back() = ck_add(ck_add(T, pb, "reflection_pad1d: output length"), pe, "reflection_pad1d: output length");
   273	  ck_shape_numel(o, "reflection_pad1d: output size");
   274	  return o;
   275	}
