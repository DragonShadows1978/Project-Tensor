   382	// Makes `device` current for its scope and restores the caller's device; never throws (ok() reports failure, and a
   383	// failed switch clears the runtime's last-error slot so a later, unrelated launch check does not report it).
   384	class QuietDeviceGuard {
   385	 public:
   386	  explicit QuietDeviceGuard(int device) noexcept {
   387	    if (cudaGetDevice(&prev_) != cudaSuccess) {
   388	      cudaGetLastError();
   389	      ok_ = false;
   390	      return;
   391	    }
   392	    if (prev_ != device) {
   393	      if (cudaSetDevice(device) != cudaSuccess) {
   394	        cudaGetLastError();
   395	        ok_ = false;
   396	        return;
   397	      }
   398	      switched_ = true;
   399	    }
   400	  }
   401	  ~QuietDeviceGuard() {
   402	    if (switched_) cudaSetDevice(prev_);
   403	  }
   404	  QuietDeviceGuard(const QuietDeviceGuard&) = delete;
   405	  QuietDeviceGuard& operator=(const QuietDeviceGuard&) = delete;
   406	  bool ok() const { return ok_; }
   407	
   408	 private:
   409	  int prev_ = 0;
   410	  bool ok_ = true;
   411	  bool switched_ = false;
   412	};
