   135	float checked_eps(const char* op, double eps) {
   136	  const float e = static_cast<float>(eps);
   137	  if (!std::isfinite(eps) || eps < 0.0 || !std::isfinite(e)) {
   138	    std::ostringstream os;
   139	    os << op << ": eps must be a finite number >= 0 that fits fp32, got " << eps;
   140	    bad_attr4(os.str());
   141	  }
   142	  return e;
   143	}
