// cuBLAS handle: one per device, created lazily on first use and kept for the life of the process (destroying it at
// interpreter exit can race CUDA's own teardown), with M2's exact settings: legacy stream, CUBLAS_DEFAULT_MATH (never
// TF32), atomics not allowed, pointer mode host. M2's handle_for() in conv.cu has internal linkage and the order
// forbids editing conv.cu, so the LSTM keeps its own handle (deviation, P1T_M3_REPORT.md). All entry points run under
// the GIL, so no extra lock is needed. cuBLAS allocates its own internal workspace for this handle (cudaMalloc inside
// cuBLAS); that is the only device memory the LSTM causes to be allocated outside the caller's allocator.
cublasHandle_t lstm_handle_for(int device) {
  static std::unordered_map<int, cublasHandle_t> handles;
  auto it = handles.find(device);
  if (it != handles.end()) return it->second;
  cublasHandle_t h = nullptr;
  check_cublas(cublasCreate(&h), "cublasCreate");
  check_cublas(cublasSetStream(h, kLegacyStream), "cublasSetStream(0)");
  check_cublas(cublasSetMathMode(h, CUBLAS_DEFAULT_MATH), "cublasSetMathMode(CUBLAS_DEFAULT_MATH)");
  check_cublas(cublasSetAtomicsMode(h, CUBLAS_ATOMICS_NOT_ALLOWED), "cublasSetAtomicsMode(NOT_ALLOWED)");
  check_cublas(cublasSetPointerMode(h, CUBLAS_POINTER_MODE_HOST), "cublasSetPointerMode(HOST)");
  handles.emplace(device, h);
  return h;
}

// ------------------------------------------------------------------------------------------------ device functions
// Logistic sigmoid, stable for large |z|: exp is only ever evaluated at a non-positive argument, so it never overflows
// (z >= 0: 1 / (1 + e^{-z}); z < 0: e^{z} / (1 + e^{z})). expf is the CUDA math library's accurate expf (2 ulp max),
// never the fast intrinsic. Prior art: the standard sign split (see the file header).
__device__ __forceinline__ float sigmoid_stable(float z) {
  if (z >= 0.0f) return 1.0f / (1.0f + expf(-z));
  const float e = expf(z);
  return e / (1.0f + e);
}

// ------------------------------------------------------------------------------------------------ kernels
// G_x[d, r, q] = Wb[d, q] for every projected row r in [0, T*N) and q in [0, 4H): the bias the input-projection GEMM
// then accumulates onto (beta = 1). One thread per element, a plain copy.
__global__ void lstm_bias_fill_kernel(float* __restrict__ gx, const float* __restrict__ B, int64_t D, int64_t rows,
                                      int64_t H4, int64_t bias_row) {
  const int64_t total = D * rows * H4;
  for (int64_t i = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; i < total;
       i += static_cast<int64_t>(gridDim.x) * blockDim.x) {
    const int64_t q = i % H4;
    const int64_t d = i / (rows * H4);
    gx[i] = B[d * bias_row + q];
  }
}

// One LSTM step for every direction slot at once; one thread per state element idx = (d*N + n)*H + j.
//   gx: G_x [D, T, N, 4H] (x . W^T + Wb); gh: G_h [D, N, 4H] (h_{t-1} . R^T for this step); B: [D, 8H] or NULL;
//   h / c: the state [D, N, H] (= Y_h / Y_c), read and written in place by the owning thread only; Y [T, D, N, H].
// Fixed per-element operation order: z = (gx + gh) + Rb; c = fmaf(f, c_prev, i * c~); h = o * tanhf(c).
__global__ void lstm_cell_kernel(const float* __restrict__ gx, const float* __restrict__ gh,
                                 const float* __restrict__ B, float* __restrict__ h, float* __restrict__ c,
                                 float* __restrict__ Y, int64_t T, int64_t s, int64_t D, int64_t N, int64_t H,
                                 int64_t first_reverse) {
  const int64_t H4 = kLstmGates * H;
  const int64_t total = D * N * H;
  for (int64_t idx = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; idx < total;
       idx += static_cast<int64_t>(gridDim.x) * blockDim.x) {
    const int64_t j = idx % H;
    const int64_t r = idx / H;
    const int64_t n = r % N;
    const int64_t d = r / N;
    const int64_t tt = (d >= first_reverse) ? (T - 1 - s) : s;   // the reverse slot walks time backwards
    const float* gxp = gx + ((d * T + tt) * N + n) * H4;
    const float* ghp = gh + (d * N + n) * H4;
    float zi = gxp[kGateI * H + j] + ghp[kGateI * H + j];
    float zo = gxp[kGateO * H + j] + ghp[kGateO * H + j];
    float zf = gxp[kGateF * H + j] + ghp[kGateF * H + j];
    float zc = gxp[kGateC * H + j] + ghp[kGateC * H + j];
    if (B != nullptr) {
      const float* rb = B + d * (kLstmBiasHalves * H4) + H4;     // Rb[d] = B[d, 4H:8H]
      zi = zi + rb[kGateI * H + j];
      zo = zo + rb[kGateO * H + j];
      zf = zf + rb[kGateF * H + j];
      zc = zc + rb[kGateC * H + j];
    }
    const float ig = sigmoid_stable(zi);
    const float og = sigmoid_stable(zo);
    const float fg = sigmoid_stable(zf);
    const float cg = tanhf(zc);
    const float cn = fmaf(fg, c[idx], ig * cg);
    const float hn = og * tanhf(cn);
    c[idx] = cn;
    h[idx] = hn;
    Y[((tt * D + d) * N + n) * H + j] = hn;
  }
}

}  // namespace

// ------------------------------------------------------------------------------------------------ LSTM forward
void lstm_forward(int device, const LstmGeom& g, const float* x, const float* W, const float* R, const float* B,
                  const float* h0, const float* c0, float* Y, float* Y_h, float* Y_c, float* scratch) {
  DeviceGuard guard(device);
  cublasHandle_t hdl = lstm_handle_for(device);
  const int64_t H4 = kLstmGates * g.H;
  const int64_t rows = g.T * g.N;                 // projected rows, r = t*N + n
  const int64_t state = g.D * g.N * g.H;          // elements of Y_h / Y_c
  const size_t state_bytes = static_cast<size_t>(state) * sizeof(float);
  float* gx = scratch;                            // [D, T, N, 4H]
  float* gh = scratch + lstm_gx_numel(g);         // [D, N, 4H]
  const float one = 1.0f;
  const float zero = 0.0f;

  // 1. Initial state into the outputs that carry the recurrence.
  if (h0 != nullptr)
    check_cuda(cudaMemcpyAsync(Y_h, h0, state_bytes, cudaMemcpyDeviceToDevice, kLegacyStream), "initial_h copy");
  else
    check_cuda(cudaMemsetAsync(Y_h, 0, state_bytes, kLegacyStream), "initial_h zero");
  if (c0 != nullptr)
    check_cuda(cudaMemcpyAsync(Y_c, c0, state_bytes, cudaMemcpyDeviceToDevice, kLegacyStream), "initial_c copy");
  else
    check_cuda(cudaMemsetAsync(Y_c, 0, state_bytes, kLegacyStream), "initial_c zero");

  // 2. Input projection of all steps, one SGEMM per direction (+ Wb through beta = 1 on the pre-filled buffer).
  //    Row-major G_x[d][rows, 4H] = X[rows, I] . W[d][4H, I]^T, as the column-major product
  //    G_x^T[4H, rows] = op_T(W_d viewed [I, 4H], ld I) . X^T[I, rows] (ld I): m = 4H, n = rows, k = I, ldc = 4H.
  float beta_x = zero;
  if (B != nullptr) {
    const int64_t total = g.D * rows * H4;
    lstm_bias_fill_kernel<<<grid_for(total, lstm_tuning::kBiasFillBlock), lstm_tuning::kBiasFillBlock, 0,
                            kLegacyStream>>>(gx, B, g.D, rows, H4, kLstmBiasHalves * H4);
    check_launch("lstm_bias_fill_kernel");
    beta_x = one;
  }
  for (int64_t d = 0; d < g.D; ++d) {
    check_cublas(cublasSgemm(hdl, CUBLAS_OP_T, CUBLAS_OP_N, static_cast<int>(H4), static_cast<int>(rows),
                             static_cast<int>(g.I), &one, W + d * H4 * g.I, static_cast<int>(g.I), x,
                             static_cast<int>(g.I), &beta_x, gx + d * rows * H4, static_cast<int>(H4)),
                 "cublasSgemm (input projection)");
    check_launch("cublasSgemm (input projection)");
  }

  // 3. The recurrence: a host loop over steps inside this one call. Per step, one strided-batched SGEMM over the D
  //    slots, G_h[d][N, 4H] = h[d][N, H] . R[d][4H, H]^T (column-major: m = 4H, n = N, k = H, op_T on R viewed
  //    [H, 4H] ld H, h viewed [H, N] ld H, ldc = 4H), then the fused cell kernel. Stream order makes step s+1's GEMM
  //    read the h that step s's cell kernel wrote.
  const unsigned int cell_grid = grid_for(state, lstm_tuning::kCellBlock);
  for (int64_t s = 0; s < g.T; ++s) {
    check_cublas(cublasSgemmStridedBatched(hdl, CUBLAS_OP_T, CUBLAS_OP_N, static_cast<int>(H4), static_cast<int>(g.N),
                                           static_cast<int>(g.H), &one, R, static_cast<int>(g.H),
                                           static_cast<long long>(H4 * g.H), Y_h, static_cast<int>(g.H),
                                           static_cast<long long>(g.N * g.H), &zero, gh, static_cast<int>(H4),
                                           static_cast<long long>(g.N * H4), static_cast<int>(g.D)),
                 "cublasSgemmStridedBatched (recurrent)");
    check_launch("cublasSgemmStridedBatched (recurrent)");
    lstm_cell_kernel<<<cell_grid, lstm_tuning::kCellBlock, 0, kLegacyStream>>>(gx, gh, B, Y_h, Y_c, Y, g.T, s, g.D,
                                                                                 g.N, g.H, g.first_reverse);
    check_launch("lstm_cell_kernel");
  }
}

// ------------------------------------------------------------------------------------------------ introspection
LstmCublasConfig lstm_cublas_config(int device) {
  DeviceGuard guard(device);
  cublasHandle_t h = lstm_handle_for(device);
  cublasMath_t math;
  cublasAtomicsMode_t atomics;
  cublasPointerMode_t pmode;
  cudaStream_t s;
  check_cublas(cublasGetMathMode(h, &math), "cublasGetMathMode");
  check_cublas(cublasGetAtomicsMode(h, &atomics), "cublasGetAtomicsMode");
  check_cublas(cublasGetPointerMode(h, &pmode), "cublasGetPointerMode");
  check_cublas(cublasGetStream(h, &s), "cublasGetStream");
  LstmCublasConfig c;
  c.math_mode = static_cast<int>(math);
  c.atomics_mode = static_cast<int>(atomics);
  c.pointer_mode = static_cast<int>(pmode);
  c.legacy_stream = (s == kLegacyStream);
  c.default_math = (math == CUBLAS_DEFAULT_MATH);
  c.atomics_not_allowed = (atomics == CUBLAS_ATOMICS_NOT_ALLOWED);
  return c;
}

}  // namespace tcs
// Host launchers for tc_signal's 1-D convolutions. Raw device pointers in, everything queued on the legacy default
// stream; no device memory is allocated here (the im2col scratch is passed in; cuBLAS's own internal workspace is the
// one exception, see README "cuBLAS").
#pragma once

#include <cstdint>

namespace tcs {

struct Conv1dGeom {
  int64_t N, C_in, T;      // x [N, C_in, T]
  int64_t C_out, K;        // w [C_out, C_in/groups, K]
  int64_t stride, pad_begin, pad_end, dilation, groups;
  int64_t T_out;           // (T + pb + pe - dilation*(K-1) - 1)//stride + 1
  bool direct;             // K == 1, stride 1, no pads: GEMM on x itself, no im2col, no scratch
};

struct ConvTranspose1dGeom {
  int64_t N, C_in, T;      // x [N, C_in, T]
  int64_t C_out, K;        // w [C_in, C_out/groups, K] (ONNX layout)
  int64_t stride, pad_begin, pad_end, output_padding, dilation, groups;
  int64_t T_out;           // stride*(T-1) + output_padding + dilation*(K-1) + 1 - pb - pe
};

// y = conv1d(x, w) + b. `col` holds C_in*K*T_out floats (one batch element at a time), or is NULL when g.direct.
void conv1d_forward(int device, const Conv1dGeom& g, const float* x, const float* w, const float* b, float* y,
                    float* col);

// y = conv_transpose1d(x, w) + b (gather form, one thread per output element).
void conv_transpose1d_forward(int device, const ConvTranspose1dGeom& g, const float* x, const float* w,
                              const float* b, float* y);

// Fast-math canary (see conv.cu): out[i] = x[i] / y[i], fp32, on the legacy stream.
void fp32_divide_probe(int device, const float* x, const float* y, float* out, int64_t n);

struct CublasConfig {
  int math_mode;           // cublasMath_t
  int atomics_mode;        // cublasAtomicsMode_t
  int pointer_mode;        // cublasPointerMode_t
  bool legacy_stream;      // the handle's stream is 0 (the legacy default stream)
  bool default_math;       // math_mode == CUBLAS_DEFAULT_MATH
  bool atomics_not_allowed;
};
// The (lazily created) handle's settings on `device`.
CublasConfig cublas_config(int device);

struct BuildInfo {
  int cudart_version;      // cudaRuntimeGetVersion
  int cublas_major, cublas_minor, cublas_patch;
  int current_device;
};
BuildInfo build_info();

}  // namespace tcs
// Host launcher for tc_signal's ONNX-semantics LSTM (P1T-M3, T4). Raw device pointers in; everything is queued on the
// legacy default stream; no device memory is allocated here (the projected-input and gate scratch is one operand the
// Python layer allocates; the recurrent state lives in the Y_h / Y_c outputs). cuBLAS's own internal workspace for the
// LSTM handle is the one exception (see lstm.cu, "cuBLAS handle").
//
// Prior art: see lstm.cu (ONNX LSTM operator spec; Hochreiter & Schmidhuber 1997; Gers, Schmidhuber & Cummins 2000;
// input projection hoisted out of the recurrence as in Appleyard, Kocisky & Blunsom 2016 / cuDNN RNN).
#pragma once

#include <cstdint>

namespace tcs {

// Gate blocks per direction along the 4H axis of W, R, Wb and Rb (ONNX LSTM: i, o, f, c).
constexpr int64_t kLstmGates = 4;
// B is [D, 2 * kLstmGates * H] = [Wb; Rb] per direction.
constexpr int64_t kLstmBiasHalves = 2;

struct LstmGeom {
  int64_t T, N, I;         // x [T, N, I] (ONNX layout 0)
  int64_t H;               // hidden_size
  int64_t D;               // direction slots: 1 (forward or reverse) or 2 (bidirectional)
  int64_t first_reverse;   // slots d >= first_reverse run backwards in time (forward: 1, reverse: 0, bidirectional: 1)
};

// Scratch layout (one fp32 operand): G_x [D, T, N, 4H] (projected inputs, Wb included), then G_h [D, N, 4H] (the
// per-step recurrent product h_{t-1} . R^T).
inline int64_t lstm_gx_numel(const LstmGeom& g) { return g.D * g.T * g.N * kLstmGates * g.H; }
inline int64_t lstm_gh_numel(const LstmGeom& g) { return g.D * g.N * kLstmGates * g.H; }
inline int64_t lstm_scratch_numel(const LstmGeom& g) { return lstm_gx_numel(g) + lstm_gh_numel(g); }

// Y [T, D, N, H], Y_h / Y_c [D, N, H]. B, h0 and c0 may be NULL (zeros). Y_h / Y_c double as the recurrent state.
void lstm_forward(int device, const LstmGeom& g, const float* x, const float* W, const float* R, const float* B,
                  const float* h0, const float* c0, float* Y, float* Y_h, float* Y_c, float* scratch);

struct LstmCublasConfig {
  int math_mode;           // cublasMath_t
  int atomics_mode;        // cublasAtomicsMode_t
  int pointer_mode;        // cublasPointerMode_t
  bool legacy_stream;      // the handle's stream is 0 (the legacy default stream)
  bool default_math;       // math_mode == CUBLAS_DEFAULT_MATH
  bool atomics_not_allowed;
};
// The (lazily created) LSTM cuBLAS handle's settings on `device`.
LstmCublasConfig lstm_cublas_config(int device);

}  // namespace tcs
// P1T-M4 host launchers (T5 norms, T6 small ops) and their tunables. Raw device pointers in, everything queued on the
// legacy default stream; nothing here allocates device memory (outputs come from the Python layer's allocator).
//
// House tunable law: every launch-shape knob of the M4 kernels lives here. None of them changes numerics except
// kNormBlock and kNormChunk, which fix the summation order of the norm statistics (see norms.cu); changing either one
// changes the last bits of the statistics (still fp32, still deterministic) and must be re-gated.
#pragma once

#include <cstdint>

namespace tcs {
namespace m4tuning {

// Threads per block of the row-norm kernel = the width of its reduction tree (one block per row). Power of two.
constexpr int kNormBlock = 256;
// Blocked summation inside a thread: a thread's strided terms are summed kNormChunk at a time into a partial sum, which
// is then added to the thread total (error bound (kNormChunk + n/kNormChunk) u instead of n u for n terms).
constexpr int kNormChunk = 32;
// Threads per block of the gather kernels (upsample, reflection pad) and of rint (one thread per output element).
constexpr int kCopyBlock = 256;

static_assert(kNormBlock > 0 && (kNormBlock & (kNormBlock - 1)) == 0, "kNormBlock must be a power of two");
static_assert(kNormChunk > 0, "kNormChunk must be positive");

}  // namespace m4tuning

// Where a row-norm output element finds its scale/bias entry.
enum class NormAffine : int {
  kPerRow = 0,      // instance norm: rows are (n, c); entry c = row % channels
  kPerElem = 1,     // layer norm: entry j (the element's index inside the normalized block)
  kPerChannel = 2,  // group norm: rows are (n, g); entry (row % groups) * ch_per_group + j / T
};

// One normalization problem: `rows` contiguous rows of length L, each normalized over itself.
struct RowNormGeom {
  int64_t rows;
  int64_t L;
  float eps;
  NormAffine affine;
  int64_t channels;      // kPerRow: C
  int64_t groups;        // kPerChannel: G
  int64_t ch_per_group;  // kPerChannel: C / G
  int64_t T;             // kPerChannel: time length (elements per channel)
};

// y = ((x - K) - d) * rstd * scale + bias per row, fp32 shifted two-pass statistics (norms.cu). scale/bias may be NULL.
void row_norm_forward(int device, const RowNormGeom& g, const float* x, const float* scale, const float* bias,
                      float* y);

// y[r, i] = x[r, i / scale] for rows r of length T, output length T * scale (bit copy).
void upsample_nearest1d_forward(int device, int64_t rows, int64_t T, int64_t scale, const float* x, float* y);

// ONNX/torch reflect pad of the last axis by (pad_begin, pad_end), each < T (bit copy).
void reflection_pad1d_forward(int device, int64_t rows, int64_t T, int64_t pad_begin, int64_t pad_end, const float* x,
                              float* y);

// y = rintf(x) elementwise (IEEE 754 roundTiesToEven, sign of zero kept, NaN and +-Inf pass through).
void rint_forward(int device, int64_t n, const float* x, float* y);

}  // namespace tcs
// tc_signal LSTM tunables (P1T-M3). House tunable law: no launch-shape literals at the use sites; every LSTM knob
// lives here (M2's tuning.h is shared and left untouched). None of these changes numerics: every output element of every
// kernel is produced by exactly one thread in a fixed order (grid-stride loops), so a knob changes speed only.
//
// Prior art: none needed for a constants module (no prior art known to me).
#pragma once

namespace tcs {
namespace lstm_tuning {

// Threads per block for the fused LSTM cell kernel (one thread per (direction, batch, hidden unit)).
constexpr int kCellBlock = 256;
// Threads per block for the kernel that pre-fills the projected-input buffer with Wb (one thread per element).
constexpr int kBiasFillBlock = 256;
// Upper bound on blocks per launch; the kernels are grid-stride loops, so larger problems loop instead.
constexpr long long kGridCap = 1LL << 20;

}  // namespace lstm_tuning
}  // namespace tcs
"""tc_signal.lstm: ONNX-semantics LSTM (P1T-M3, T4), forward only, fp32, deterministic.

    lstm(x, W, R, B=None, *, hidden_size, direction="forward", initial_h=None, initial_c=None,
         sequence_lens=None, layout=0, out=None) -> (Y, Y_h, Y_c)

Semantics: ONNX LSTM, layout 0, default activations (Sigmoid, Tanh, Tanh), no clip, no peepholes, input_forget 0.
 * x [T, N, I]; W [D, 4H, I]; R [D, 4H, H]; B [D, 8H] = [Wb; Rb] or None (zeros); initial_h / initial_c [D, N, H] or
   None (zeros). Gate blocks along 4H are in the ONNX order i, o, f, c (torch's nn.LSTM uses i, f, g, o).
 * direction "forward" or "reverse" (D = 1) or "bidirectional" (D = 2: index 0 forward, index 1 reverse).
 * Returns Y [T, D, N, H], Y_h [D, N, H], Y_c [D, N, H]: new tensors from tc_signal's allocator (set_allocator; the
   default is tensor_cuda.empty), or the caller's `out=(Y, Y_h, Y_c)`, which is returned as given.
 * Every operand is any fp32 CUDA DLPack producer (TensorCUDA or torch tensors) or a DLPack capsule.

Refused (never silently approximated):
 * layout != 0 (ValueError); sequence_lens other than None or "every entry equals T" (ValueError; a non-integer
   sequence_lens is a TypeError). sequence_lens is only validated, never read by the kernel; a device tensor is copied
   to the host for that check (TensorCUDA `.numpy()`, torch `.cpu()`);
 * clip, peepholes (ONNX input P), input_forget and non-default activations: the signature has no such parameter, so
   passing one raises TypeError;
 * every shape mismatch, non-fp32 / non-CUDA / non-contiguous / misaligned operands, mismatched devices, an `out` that
   is not a 3-sequence, and any output or scratch aliasing another operand (M2's operand contract, dlpack_operand.h).

Execution: one `_tc_signal.lstm_plan` call peeks the inputs; this layer allocates Y, Y_h, Y_c and ONE scratch operand
(projected inputs G_x [D, T, N, 4H] then the per-step gate buffer G_h [D, N, 4H]) through the allocator; one
`_tc_signal.lstm_run` call then runs the whole recurrence in C++ (src/lstm.cu): one input-projection SGEMM per
direction (+ Wb), then a host C++ loop over the T steps, each one strided-batched SGEMM over the directions
(h_{t-1} . R^T) and one fused cell kernel. No Python loop over steps, no per-step DLPack capsules. Everything is queued
on the legacy default stream; the results are ready in stream order (a later TensorCUDA op or a `.numpy()` download
on the legacy stream sees them).

Prior art: the ONNX LSTM operator spec (semantics); Hochreiter & Schmidhuber 1997 (LSTM) and Gers, Schmidhuber &
Cummins 2000 (forget gate); Appleyard, Kocisky & Blunsom 2016 / the cuDNN RNN design (the input projection hoisted out
of the recurrence); the sign-split stable sigmoid (standard practice). Details and what is ours: src/lstm.cu.
The Python plan/allocate/run flow is M2's (tc_signal/__init__.py conv1d); no new prior art here.
"""
from __future__ import annotations

import operator
import sys

from . import _tc_signal as _C

# ONNX direction attribute -> the C++ direction code (lstm_bindings.cpp).
_DIRECTIONS = {'forward': 0, 'reverse': 1, 'bidirectional': 2}
# ONNX `layout` attribute: 0 = x [T, N, I] (the only supported layout).
_LAYOUT_SEQ_FIRST = 0
# `out` is (Y, Y_h, Y_c).
_N_OUTPUTS = 3


def _package():
    """The tc_signal package module, read at call time so set_allocator's current allocator is used."""
    return sys.modules[__name__.rpartition('.')[0]]


def _int(name, v):
    if isinstance(v, bool):
        raise TypeError(f'tc_signal.lstm: {name} must be an int, got bool')
    try:
        return operator.index(v)
    except TypeError:
        raise TypeError(f'tc_signal.lstm: {name} must be an int, got {type(v).__name__}') from None


def _host_array(seq):
    """sequence_lens as a host NumPy array: lists, tuples and NumPy arrays directly; TensorCUDA tensors through
    `.numpy()`; torch tensors through `.cpu().numpy()`."""
    import numpy as np
    if isinstance(seq, (list, tuple, np.ndarray)) or np.isscalar(seq):
        return np.asarray(seq)
    cpu = getattr(seq, 'cpu', None)
    if callable(cpu):                         # torch (CPU or CUDA)
        seq = cpu()
    to_numpy = getattr(seq, 'numpy', None)
    if callable(to_numpy):                    # TensorCUDA, torch CPU
        return np.asarray(to_numpy())
    return np.asarray(seq)


def _check_sequence_lens(sequence_lens, T, N):
    import numpy as np
    arr = _host_array(sequence_lens)
    if arr.dtype == object or not np.issubdtype(arr.dtype, np.integer):
        raise TypeError(f'tc_signal.lstm: sequence_lens must hold integers, got dtype {arr.dtype}')
    if arr.shape != (N,):
        raise ValueError(f'tc_signal.lstm: sequence_lens has shape {tuple(arr.shape)}, expected ({N},) = [batch]')
    if not bool(np.all(arr == T)):
        raise ValueError(f'tc_signal.lstm: sequence_lens {arr.tolist()} is not supported (refused): only None or every '
                         f'entry equal to T = {T} is implemented')


def lstm(x, W, R, B=None, *, hidden_size, direction='forward', initial_h=None, initial_c=None, sequence_lens=None,
         layout=0, out=None):
    """ONNX LSTM (layout 0, gates i, o, f, c; Sigmoid/Tanh/Tanh; no clip, no peepholes). See the module docstring.

    x [T, N, I], W [D, 4H, I], R [D, 4H, H], B [D, 8H] = [Wb; Rb] or None, initial_h / initial_c [D, N, H] or None.
    Returns (Y [T, D, N, H], Y_h [D, N, H], Y_c [D, N, H])."""
    H = _int('hidden_size', hidden_size)
    if not isinstance(direction, str) or direction not in _DIRECTIONS:
        raise ValueError(f'tc_signal.lstm: direction must be one of {sorted(_DIRECTIONS)}, got {direction!r}')
    lay = _int('layout', layout)
    if lay != _LAYOUT_SEQ_FIRST:
        raise ValueError(f'tc_signal.lstm: layout={lay} is not supported (refused); only ONNX layout 0 '
                         f'(x [T, N, I]) is implemented')
    if out is not None:
        if not isinstance(out, (tuple, list)):
            raise TypeError(f'tc_signal.lstm: out must be None or a 3-tuple (Y, Y_h, Y_c), got {type(out).__name__}')
        if len(out) != _N_OUTPUTS:
            raise ValueError(f'tc_signal.lstm: out must be a 3-tuple (Y, Y_h, Y_c), got {len(out)} entries')
    code = _DIRECTIONS[direction]
    (xc, wc, rc, bc, hc, cc, y_shape, state_shape, scratch_numel, T, N) = _C.lstm_plan(
        x, W, R, B, initial_h, initial_c, H, code)
    if sequence_lens is not None:
        _check_sequence_lens(sequence_lens, T, N)
    alloc = _package()._allocator
    if out is None:
        Y, Y_h, Y_c = alloc(tuple(y_shape)), alloc(tuple(state_shape)), alloc(tuple(state_shape))
    else:
        Y, Y_h, Y_c = out
    scratch = alloc((scratch_numel,))
    _C.lstm_run(xc, wc, rc, bc, hc, cc, Y, Y_h, Y_c, scratch, H, code)
    return Y, Y_h, Y_c
"""tc_signal T5 norms (P1T-M4): instance_norm1d, layer_norm, group_norm.

fp32 statistics (shifted two-pass: shift by the row's first sample, mean of the shifted row, then the centred sum of
squares; biased variance as ONNX), a fixed block-tree reduction order (deterministic, no atomics), and
y = (x - mean) * (1 / sqrtf(var + eps)) * scale + bias. Kernel and numerics notes: src/norms.cu. Operands are any fp32
CUDA DLPack producers (or capsules), C-contiguous; the output comes from the module allocator (tc_signal.set_allocator)
unless `out` is given; everything is queued on the legacy default stream.

Prior art: Ulyanov, Vedaldi & Lempitsky (2016) instance norm; Ba, Kiros & Hinton (2016) layer norm; Wu & He (2018)
group norm; ONNX InstanceNormalization / LayerNormalization / GroupNormalization-21 (semantics); Welford (1962) and
Chan, Golub & LeVeque (1983) (variance algorithms, two-pass and shifted data). Ours: the Python wrappers.
"""
from __future__ import annotations

import math
import numbers
import operator
import sys

from . import _tc_signal as _C

__all__ = ['instance_norm1d', 'layer_norm', 'group_norm']


def _alloc(shape):
    # The package's current allocator (tc_signal.set_allocator), read at call time.
    return sys.modules[__package__]._allocator(tuple(shape))


def _eps(eps):
    if isinstance(eps, bool) or not isinstance(eps, numbers.Real):
        raise TypeError(f'tc_signal: eps must be a real number, got {type(eps).__name__}')
    e = float(eps)
    if not math.isfinite(e) or e < 0.0:
        raise ValueError(f'tc_signal: eps must be a finite number >= 0, got {e!r}')
    return e


def _int(name, v):
    if isinstance(v, bool):
        raise TypeError(f'tc_signal: {name} must be an int, got bool')
    try:
        return operator.index(v)
    except TypeError:
        raise TypeError(f'tc_signal: {name} must be an int, got {type(v).__name__}') from None


def instance_norm1d(x, scale=None, bias=None, *, eps=1e-5, out=None):
    """ONNX InstanceNormalization on x [N, C, T]: per (n, c), mean and biased variance over T (fp32 statistics);
    y = (x - mean) / sqrt(var + eps) * scale[c] + bias[c]. scale, bias: [C] or None (1 and 0). Returns `out`."""
    e = _eps(eps)
    xc, sc, bc, out_shape = _C.instance_norm1d_plan(x, scale, bias, e)
    if out is None:
        out = _alloc(out_shape)
    _C.instance_norm1d_run(xc, sc, bc, out, e)
    return out


def layer_norm(x, scale=None, bias=None, *, axis=-1, eps=1e-5, out=None):
    """ONNX LayerNormalization: normalize over the axes [axis, rank) with the biased variance (fp32 statistics, whatever
    eps: 1e-5 and 1e-12 both honoured); y = xhat * scale + bias with scale, bias of shape x.shape[axis:] or None.
    Returns `out`."""
    a = _int('axis', axis)
    e = _eps(eps)
    xc, sc, bc, out_shape = _C.layer_norm_plan(x, scale, bias, a, e)
    if out is None:
        out = _alloc(out_shape)
    _C.layer_norm_run(xc, sc, bc, out, a, e)
    return out


def group_norm(x, num_groups, scale=None, bias=None, *, eps=1e-5, out=None):
    """GroupNorm (ONNX GroupNormalization-21 / torch.nn.GroupNorm) on x [N, C, T]: mean and biased variance over each
    group's (C/num_groups, T) block (fp32 statistics); per-CHANNEL affine: scale, bias [C] or None. Returns `out`."""
    g = _int('num_groups', num_groups)
    e = _eps(eps)
    xc, sc, bc, out_shape = _C.group_norm_plan(x, g, scale, bias, e)
    if out is None:
        out = _alloc(out_shape)
    _C.group_norm_run(xc, g, sc, bc, out, e)
    return out
"""tc_signal T6 small ops (P1T-M4): upsample_nearest1d, reflection_pad1d, rint. Bit-exact by construction (32-bit word
gathers; rintf). Kernel notes: src/small_ops.cu. Operands are any fp32 CUDA DLPack producers (or capsules),
C-contiguous; the time axis is the last axis; the output comes from the module allocator unless `out` is given;
everything is queued on the legacy default stream. TensorCUDA core's `round` is untouched.

Prior art: ONNX Resize (nearest, asymmetric, floor), Pad (reflect) and Round specs; IEEE 754 roundTiesToEven / C99 rint;
torch reflection_pad1d. Ours: the Python wrappers.
"""
from __future__ import annotations

import operator
import sys

from . import _tc_signal as _C

__all__ = ['upsample_nearest1d', 'reflection_pad1d', 'rint']


def _alloc(shape):
    # The package's current allocator (tc_signal.set_allocator), read at call time.
    return sys.modules[__package__]._allocator(tuple(shape))


def _int(name, v):
    if isinstance(v, bool):
        raise TypeError(f'tc_signal: {name} must be an int, got bool')
    try:
        return operator.index(v)
    except TypeError:
        raise TypeError(f'tc_signal: {name} must be an int, got {type(v).__name__}') from None


def upsample_nearest1d(x, scale, *, out=None):
    """ONNX Resize nearest (asymmetric, floor) on the last axis at an INTEGER scale >= 1:
    y[..., i] = x[..., i // scale], output length T * scale. Non-integer scales are refused (TypeError). Returns `out`."""
    s = _int('scale (upsample_nearest1d takes integer scales only)', scale)
    if s < 1:
        raise ValueError(f'tc_signal: upsample_nearest1d: scale must be an integer >= 1, got {s}')
    xc, out_shape = _C.upsample_nearest1d_plan(x, s)
    if out is None:
        out = _alloc(out_shape)
    _C.upsample_nearest1d_run(xc, out, s)
    return out


def reflection_pad1d(x, pads, *, out=None):
    """ONNX Pad mode=reflect (torch reflection_pad1d) on the last axis: pads = (begin, end), each >= 0 and < T.
    Output length T + begin + end. Returns `out`."""
    if not isinstance(pads, (tuple, list)):
        raise TypeError(f'tc_signal: reflection_pad1d: pads must be a (begin, end) tuple or list, got '
                        f'{type(pads).__name__}')
    if len(pads) != 2:
        raise ValueError(f'tc_signal: reflection_pad1d: pads must be (begin, end), got {pads!r}')
    pb, pe = _int('pads[0]', pads[0]), _int('pads[1]', pads[1])
    if pb < 0 or pe < 0:
        raise ValueError(f'tc_signal: reflection_pad1d: pads must be >= 0, got ({pb}, {pe})')
    xc, out_shape = _C.reflection_pad1d_plan(x, pb, pe)
    if out is None:
        out = _alloc(out_shape)
    _C.reflection_pad1d_run(xc, out, pb, pe)
    return out


def rint(x, *, out=None):
    """ONNX Round: round half to even (rintf), sign of zero kept (rint(-0.4) = -0.0), +-Inf and NaN pass through.
    Any rank. Returns `out`."""
    xc, out_shape = _C.rint_plan(x)
    if out is None:
        out = _alloc(out_shape)
    _C.rint_run(xc, out)
    return out

