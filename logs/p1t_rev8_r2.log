   209	// ------------------------------------------------------------------------------------------------ LSTM forward
   210	void lstm_forward(int device, const LstmGeom& g, const float* x, const float* W, const float* R, const float* B,
   211	                  const float* h0, const float* c0, float* Y, float* Y_h, float* Y_c, float* scratch) {
   212	  DeviceGuard guard(device);
   213	  cublasHandle_t hdl = lstm_handle_for(device);
   214	  const int64_t H4 = kLstmGates * g.H;
   215	  const int64_t rows = g.T * g.N;                 // projected rows, r = t*N + n
   216	  const int64_t state = g.D * g.N * g.H;          // elements of Y_h / Y_c
   217	  const size_t state_bytes = static_cast<size_t>(state) * sizeof(float);
   218	  float* gx = scratch;                            // [D, T, N, 4H]
   219	  float* gh = scratch + lstm_gx_numel(g);         // [D, N, 4H]
   220	  const float one = 1.0f;
   221	  const float zero = 0.0f;
   222	
   223	  // 1. Initial state into the outputs that carry the recurrence.
   224	  if (h0 != nullptr)
   225	    check_call_on(kPrefix, "initial_h copy", "cudaMemcpyAsync", device,
   226	                  cudaMemcpyAsync(Y_h, h0, state_bytes, cudaMemcpyDeviceToDevice, kLegacyStream));
   227	  else
   228	    check_call_on(kPrefix, "initial_h zero", "cudaMemsetAsync", device, cudaMemsetAsync(Y_h, 0, state_bytes, kLegacyStream));
   229	  if (c0 != nullptr)
   230	    check_call_on(kPrefix, "initial_c copy", "cudaMemcpyAsync", device,
   231	                  cudaMemcpyAsync(Y_c, c0, state_bytes, cudaMemcpyDeviceToDevice, kLegacyStream));
   232	  else
   233	    check_call_on(kPrefix, "initial_c zero", "cudaMemsetAsync", device, cudaMemsetAsync(Y_c, 0, state_bytes, kLegacyStream));
   234	
   235	  // 2. Input projection of all steps, one SGEMM per direction (+ Wb through beta = 1 on the pre-filled buffer).
   236	  //    Row-major G_x[d][rows, 4H] = X[rows, I] . W[d][4H, I]^T, as the column-major product
   237	  //    G_x^T[4H, rows] = op_T(W_d viewed [I, 4H], ld I) . X^T[I, rows] (ld I): m = 4H, n = rows, k = I, ldc = 4H.
   238	  float beta_x = zero;
   239	  if (B != nullptr) {
   240	    const int64_t total = g.D * rows * H4;
   241	    lstm_bias_fill_kernel<<<grid_for(total, lstm_tuning::kBiasFillBlock), lstm_tuning::kBiasFillBlock, 0,
   242	                            kLegacyStream>>>(gx, B, g.D, rows, H4, kLstmBiasHalves * H4);
   243	    check_launch_on(kPrefix, "lstm_bias_fill_kernel", device);
   244	    beta_x = one;
   245	  }
   246	  for (int64_t d = 0; d < g.D; ++d) {
   247	    check_cublas_on(cublasSgemm(hdl, CUBLAS_OP_T, CUBLAS_OP_N, static_cast<int>(H4), static_cast<int>(rows),
   248	                             static_cast<int>(g.I), &one, W + d * H4 * g.I, static_cast<int>(g.I), x,
   249	                             static_cast<int>(g.I), &beta_x, gx + d * rows * H4, static_cast<int>(H4)),
   250	                    "cublasSgemm (input projection)", device);
   251	    check_after_cublas_on(kPrefix, "cublasSgemm (input projection)", device);
   252	  }
   253	
   254	  // 3. The recurrence: a host loop over steps inside this one call. Per step, one strided-batched SGEMM over the D
   255	  //    slots, G_h[d][N, 4H] = h[d][N, H] . R[d][4H, H]^T (column-major: m = 4H, n = N, k = H, op_T on R viewed
   256	  //    [H, 4H] ld H, h viewed [H, N] ld H, ldc = 4H), then the fused cell kernel. Stream order makes step s+1's GEMM
   257	  //    read the h that step s's cell kernel wrote.
   258	  const unsigned int cell_grid = grid_for(state, lstm_tuning::kCellBlock);
   259	  for (int64_t s = 0; s < g.T; ++s) {
   260	    check_cublas_on(cublasSgemmStridedBatched(hdl, CUBLAS_OP_T, CUBLAS_OP_N, static_cast<int>(H4), static_cast<int>(g.N),
   261	                                           static_cast<int>(g.H), &one, R, static_cast<int>(g.H),
   262	                                           static_cast<long long>(H4 * g.H), Y_h, static_cast<int>(g.H),
   263	                                           static_cast<long long>(g.N * g.H), &zero, gh, static_cast<int>(H4),
   264	                                           static_cast<long long>(g.N * H4), static_cast<int>(g.D)),
   265	                    "cublasSgemmStridedBatched (recurrent)", device);
   266	    check_after_cublas_on(kPrefix, "cublasSgemmStridedBatched (recurrent)", device);
   267	    lstm_cell_kernel<<<cell_grid, lstm_tuning::kCellBlock, 0, kLegacyStream>>>(gx, gh, B, Y_h, Y_c, Y, g.T, s, g.D,
   268	                                                                                 g.N, g.H, g.first_reverse);
   269	    check_launch_on(kPrefix, "lstm_cell_kernel", device);
   270	  }
   271	  guard.restore();  // P1T-FIX4: success-path restore is checked (raises on failure)
   272	}
