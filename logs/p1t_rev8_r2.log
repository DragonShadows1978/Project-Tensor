   291	// ------------------------------------------------------------------------------------------------ ConvTranspose1d entry points
   292	py::tuple conv_transpose1d_plan(py::object x, py::object w, py::object b, int64_t stride, int64_t pb, int64_t pe,
   293	                                int64_t output_padding, int64_t dilation, int64_t groups) {
   294	  drain_completed();
   295	  require_operand(x, "x");
   296	  require_operand(w, "w");
   297	  Peeked X = peek_operand(x, "x", 3);
   298	  Peeked W = peek_operand(w, "w", 3);
   299	  Peeked B;
   300	  const bool has_b = !b.is_none();
   301	  if (has_b) B = peek_operand(b, "b", 1);
   302	  same_device_peeked({&X, &W, has_b ? &B : nullptr}, {"x", "w", "b"});
   303	  ConvTranspose1dPlan p = plan_conv_transpose1d(X.shape, W.shape, has_b ? &B.shape : nullptr, stride, pb, pe,
   304	                                                output_padding, dilation, groups);
   305	  return py::make_tuple(X.capsule.object(), W.capsule.object(), has_b ? B.capsule.object() : py::none(),
   306	                        to_tuple(p.out_shape));
   307	}
   308	
   309	void conv_transpose1d_run(py::object xc, py::object wc, py::object bc, py::object out, int64_t stride, int64_t pb,
   310	                          int64_t pe, int64_t output_padding, int64_t dilation, int64_t groups) {
   311	  drain_completed();
   312	  require_operand(xc, "x");
   313	  require_operand(wc, "w");
   314	  require_operand(out, "out");
   315	  Operand X(xc, "x", 3, false);
   316	  Operand W(wc, "w", 3, false);
   317	  Operand B;
   318	  if (!bc.is_none()) B = Operand(bc, "b", 1, false);
   319	  std::vector<int64_t> bshape;
   320	  if (B.present()) bshape = op_shape(B);
   321	  const std::vector<int64_t> xshape = op_shape(X);
   322	  const std::vector<int64_t> wshape = op_shape(W);
   323	  ConvTranspose1dPlan p = plan_conv_transpose1d(xshape, wshape, B.present() ? &bshape : nullptr, stride, pb, pe,
   324	                                                output_padding, dilation, groups);
   325	  Operand Y(to_capsule(out, "out", true).handle(), "out", 3, true);
   326	  expect_shape(Y, p.out_shape);
   327	  const int device = common_device({&X, &W, &B, &Y});
   328	  for (const Operand* in : {&X, &W, &B}) expect_disjoint(Y, *in);
   329	  RetainUntilComplete keep(device, {&X, &W, &B, &Y});  // F01 (see conv1d_run)
   330	  conv_transpose1d_forward(device, p.g, X.data(), W.data(), B.present() ? B.data() : nullptr, Y.data());
   331	}
   332	
   333	void divide_probe(py::object x, py::object y, py::object out) {
   334	  drain_completed();
   335	  require_operand(x, "x");
   336	  require_operand(y, "y");
   337	  require_operand(out, "out");
   338	  Operand X(to_capsule(x, "x", false).handle(), "x", 1, false);
   339	  Operand Y(to_capsule(y, "y", false).handle(), "y", 1, false);
   340	  Operand O(to_capsule(out, "out", true).handle(), "out", 1, true);
   341	  expect_shape(Y, {X.dim(0)});
   342	  expect_shape(O, {X.dim(0)});
   343	  const int device = common_device({&X, &Y, &O});
   344	  expect_disjoint(O, X);
   345	  expect_disjoint(O, Y);
   346	  RetainUntilComplete keep(device, {&X, &Y, &O});  // F01
   347	  fp32_divide_probe(device, X.data(), Y.data(), O.data(), X.dim(0));
   348	}
   349	
   350	// P1T-FIX6: tc_signal's exit wait as a raw CPython function (see py_args.h raw_exit_diag_arg for why). No catch-all: a
   351	// forced unwind (not a std::exception) passes through the typed handlers. Prior art: CPython's METH_VARARGS |
   352	// METH_KEYWORDS convention (caller-owned argument tuple and dict); ours: choosing it for the GIL-released wait.
   353	// P1T-FIX7 (V7-01): the argument is diagnostics only. A malformed call (arity, keyword) is a TypeError that does
   354	// nothing; any VALUE closes and waits: one that cannot be read at C level selects tuning::kExitDiagDefaultS (py_args.h
   355	// raw_exit_diag_arg), never an error before the close.
   356	PyObject* raw_exit_close_admission(PyObject*, PyObject* args, PyObject* kwargs) {
   357	  double first_diag_s = tuning::kExitDiagDefaultS;
   358	  bool default_used = false;
   359	  if (!raw_exit_diag_arg("_exit_close_admission", "first_diag_s", args, kwargs, tuning::kExitDiagDefaultS,
   360	                         &first_diag_s, &default_used))
   361	    return nullptr;
   362	  try {
   363	    return exit_close_admission(first_diag_s, default_used).release().ptr();
   364	  } catch (py::error_already_set& e) {
   365	    e.restore();
   366	  } catch (const std::bad_alloc&) {
   367	    PyErr_NoMemory();
   368	  } catch (const std::exception& e) {
   369	    PyErr_SetString(PyExc_RuntimeError, e.what());
   370	  }
   371	  return nullptr;
   372	}
   373	
   374	// P1T-FIX7, round-7 review finding V7-01 and sweep (i): what atexit calls. `hook` is tc_signal._release_pending_at_exit.
   375	// The hook reaches its close on every path that runs any of its statements (try / finally, the knob passed as is).
   376	// One path it cannot cover: an exception delivered at its FIRST bytecode boundary (CPython 3.12 checks for pending
   377	// signals in the RESUME instruction that starts every Python frame, so a Ctrl-C that arrives just before the hook is
   378	// called raises KeyboardInterrupt there, before any statement of the hook has run), and generally any exception that
   379	// escapes the hook before its close. So: when the hook raises, this runner (if the hook had not closed yet: runs its
   380	// synchronize(), see below) closes admission and waits itself (default delay; it is a no-op wait when the hook had
   381	// already closed), writes the recorded CUDA failures nobody reported (exit_log_unreported), and then hands the hook's
   382	// exception to atexit unchanged (atexit prints it, as for any
   383	// callback). When the hook RETURNS, the runner does nothing: a hook that returns without closing is a defect in the
   384	// hook, which its tests and the round-7 probes must see, not one this runner hides. A raw METH_O function: no pybind11
   385	// dispatcher frame, the hook argument is owned by atexit, and no catch-all (a forced unwind is never swallowed).
   386	// Prior art: CPython's atexit (one callback's exception is printed and the remaining callbacks still run) and the
   387	// try / finally guarantee (language reference, "The try statement"), which holds inside a frame but not at its first
   388	// instruction; CPython 3.12 ceval RESUME / eval-breaker signal handling (unverified here, lead to check "CPython 3.12
   389	// RESUME eval_breaker _Py_HandlePending"). Ours: the native wrapper that keeps the close for that one boundary.
   390	// When the hook raised BEFORE its own close (no hook close was counted during the call: an exception at its first
   391	// bytecode, or before its finally reached the close), its synchronize() may not have run either: the runner then runs
   392	// it first (releasing what is pending, as the hook would have; a failure is written to stderr), before closing.
   393	// P1T-FIX7, lead send-back L1 (sweep (i) addendum): the runner also opens the window in which the device syncs of exit
   394	// (the hook's step 1, its post-close retry, the runner's own synchronize()) are diagnosed instead of silent
   395	// (dlpack_operand.cpp wait_device_work_diagnosed). Its delay is the hook's knob as the hook will pass it, read at C
   396	// level from the hook's module globals (PyDict_GetItemString: a dict lookup of a str key, errors suppressed; the value
   397	// read by raw_exit_diag_value, no Python method of it runs); absent or unreadable -> tuning::kExitDiagDefaultS. The
   398	// window closes when the runner returns (RAII), so no ordinary synchronize() is affected.
   399	double exit_diag_of_hook(PyObject* hook) {
   400	  double v = tuning::kExitDiagDefaultS;
   401	  if (!PyFunction_Check(hook)) return v;
   402	  PyObject* globals = PyFunction_GET_GLOBALS(hook);
   403	  if (globals == nullptr || !PyDict_Check(globals)) return v;
   404	  PyObject* knob = PyDict_GetItemString(globals, "_RELEASE_EXIT_DIAG_S");  // borrowed, or nullptr (deleted)
   405	  if (knob == nullptr) return v;
   406	  raw_exit_diag_value(knob, tuning::kExitDiagDefaultS, &v);
   407	  return v;
   408	}
   409	
   410	struct ExitDeviceWaitWindow {
   411	  explicit ExitDeviceWaitWindow(double first_diag_s) noexcept { exit_device_waits_diagnosed(first_diag_s); }
   412	  ~ExitDeviceWaitWindow() { exit_device_waits_undiagnosed(); }
   413	  ExitDeviceWaitWindow(const ExitDeviceWaitWindow&) = delete;
   414	  ExitDeviceWaitWindow& operator=(const ExitDeviceWaitWindow&) = delete;
   415	};
   416	
   417	PyObject* raw_exit_hook_runner(PyObject*, PyObject* hook) {
   418	  const ExitDeviceWaitWindow window(exit_diag_of_hook(hook));  // P1T-FIX7 L1: device waits of exit are diagnosed
   419	  const unsigned long long closes_before = exit_hook_closes();
   420	  PyObject* r = PyObject_CallNoArgs(hook);
   421	  if (r != nullptr) return r;
   422	  PyObject *type = nullptr, *value = nullptr, *tb = nullptr;
   423	  PyErr_Fetch(&type, &value, &tb);  // keep the hook's exception
   424	  if (exit_hook_closes() == closes_before) {
   425	    try {
