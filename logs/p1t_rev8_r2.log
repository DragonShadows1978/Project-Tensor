   447	  }
   448	  if (t->dtype.code != kDLFloat || t->dtype.bits != 32 || t->dtype.lanes != 1) {
   449	    std::ostringstream os;
   450	    os << "dtype (code " << static_cast<int>(t->dtype.code) << ", bits " << static_cast<int>(t->dtype.bits)
   451	       << ", lanes " << t->dtype.lanes
   452	       << ") is not float32; tc_signal computes in fp32 only (expand fp16 weights to fp32 first)";
