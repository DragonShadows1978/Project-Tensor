   463	Storage::~Storage() {
   464	  if (external_release) {
   465	    // Imported (DLPack) memory belongs to its producer: never cudaFree it and
   466	    // never hand it to the pool. ORDER MATTERS:
   467	    //  1. Drain the engine stream. Every engine kernel, cuBLAS call and
   468	    //     cudaMemcpy runs on stream 0 (the legacy default stream; this TU is
   469	    //     built without --default-stream per-thread), so once it is idle no
   470	    //     queued engine work can still read or write this memory. The engine
   471	    //     keeps no per-Storage "last use" event, so "everything queued so far"
   472	    //     is the only sound fence; an event recorded here and waited on would
   473	    //     cover exactly the same work at three API calls instead of one. A
   474	    //     deferred release (host callback) is not allowed to run the
   475	    //     producer's deleter, which may call CUDA (torch's caching allocator).
   476	    //  2. Then hand the memory back (the DLPack deleter, GIL held, in
   477	    //     bindings.cpp). A producer may reuse it at once on its own stream.
   478	    // Prior art: the DLPack deleter contract (dmlc/dlpack, 2017+) and the
   479	    // array API's stream rules (2021+); the drain-then-delete order is the
   480	    // standard CUDA "free only after last use" rule. Ours: its placement in
   481	    // the Storage destructor.
   482	    // P1T-FIX1 F05: drain THIS Storage's device (drain_device_legacy_stream
   483	    // above); if the drain fails, deliberately leak instead of releasing.
   484	    if (device.is_cuda() && !drain_device_legacy_stream(device.index)) {
   485	      g_external_drain_leaks.fetch_add(1);
   580	// per element, `if (i < n)`) with the baseline helper nblk(n), which narrows ceil(n / 256) to int. For an accepted
   581	// extent of 2^40 + 1 fp32 elements (4 TiB + 4 bytes of metadata; shape and byte bounds fit int64) the block count
   582	// 2^32 + 1 became 1: one block wrote 256 elements, the launch succeeded and the revision was bumped (review probes
   583	// fill_grid_cpu.cpp, fill_grid_single_gpu.py). Now, before anything else (before the label proof, the device guard, any
   584	// launch and the revision bump), fill_grid_blocks computes the block count in int64 and REFUSES (ValueError) an extent
   585	// whose block count exceeds the grid's x-dimension limit; an accepted extent's launch covers every element
   586	// (blocks * 256 >= n). Refusal, not a grid-stride fill: a grid-stride kernel would be a new core __global__, which the
   587	// P1-T plan forbids. The shared nblk helper and the other engine kernels are unchanged (baseline, outside P1-T).
   588	// The limit: CUDA C++ Programming Guide 12.6, "Compute Capabilities", Table "Technical Specifications per Compute
   589	// Capability": "Maximum x-dimension of a grid of thread blocks" = 2^31-1 for every compute capability CUDA 12.6 supports
   590	// (it is also cudaDeviceProp::maxGridSize[0] / cudaDevAttrMaxGridDimX; tests/test_dlpack.py test_fix5_v504_* reads it
   591	// on this host: 2147483647). A hardware limit, not a tunable.
   592	// Prior art: ISO C++17 integral conversions ([conv.integral]: an out-of-range signed conversion is implementation-
   593	// defined, here a wrap) and the checked-narrowing rule of the C++ Core Guidelines (ES.46, gsl::narrow); CUDA's dim3 grid
   594	// semantics. Taken: compute wide, check, then narrow. Ours: refusing at fill_'s boundary instead of capping the grid.
   595	namespace {
   596	constexpr int64_t kFillMaxGridX = 2147483647;  // 2^31-1: CUDA 12.6 grid x-dimension limit (see above)
   597	
   598	int64_t fill_grid_blocks(int64_t n) {
   599	  const int64_t blocks = n / kT + (n % kT != 0 ? 1 : 0);  // ceil(n / kT) for n >= 1, without forming n + kT - 1
   600	  if (blocks > kFillMaxGridX)
   601	    throw std::invalid_argument(
   602	        "fill_: " + std::to_string(n) + " elements need " + std::to_string(blocks) + " blocks of " +
   603	        std::to_string(kT) + " threads, more than the CUDA grid x-dimension limit of " +
   604	        std::to_string(kFillMaxGridX) + " (2^31-1) blocks; fill_ launches one thread per element (the existing "
   605	        "fill_kernel), so it covers at most " + std::to_string(kFillMaxGridX * kT) +
   606	        " elements. Refused before any launch: nothing was written and the revision is unchanged");
   607	  return blocks;
   608	}
   609	}  // namespace
