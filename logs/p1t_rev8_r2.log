   412	void dlpack_ack_unraisable(unsigned long long count) noexcept {
   413	  auto consume = [count] {
   414	    unsigned long long cur = g_core_unraisable_unreported.load();
   415	    while (!g_core_unraisable_unreported.compare_exchange_weak(cur, cur > count ? cur - count : 0ULL)) {
   416	    }
   417	  };
   418	  try {
   419	    CoreUnraisableRecord& r = core_unraisable_record();
   420	    std::lock_guard<std::mutex> lk(r.mu);
   421	    consume();
   422	    // The named one was just raised; a failure recorded since the snapshot stays counted, unnamed.
   423	    r.unreported_what = nullptr;
   424	    r.unreported_device = -1;
   425	    r.unreported_error = 0;
   426	  } catch (const std::exception&) {
   427	    consume();  // a mutex failure (never observed): consume the count; a stale name is only a label
   428	  }
   429	}
