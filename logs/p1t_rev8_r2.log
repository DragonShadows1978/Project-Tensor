   821	void describe(std::ostream& os, const FailureRecord& r) {
   822	  const auto error = [&os, &r] { os << cudaGetErrorName(r.err) << ": " << cudaGetErrorString(r.err); };
   823	  const bool guard_call = r.call == FailedCall::kGetDevice || r.call == FailedCall::kSetDevice;
   824	  switch (r.purpose) {
   825	    case Purpose::kCurrentDevice:
   826	      os << "the current-device query cudaGetDevice failed (";
   827	      error();
   828	      os << ")";
   829	      return;
   830	    case Purpose::kSyncStream:
   831	    case Purpose::kSyncUntracked:
   832	      if (guard_call) {
   833	        os << "the legacy stream of device " << r.device << " was not synchronized: ";
   834	        break;
   835	      }
   836	      os << "the legacy stream of device " << r.device << " could not be synchronized (cudaStreamSynchronize: ";
   837	      error();
   838	      os << ")";
   839	      if (r.purpose == Purpose::kSyncUntracked)
   840	        os << "; device " << r.device << " is beyond the first " << tuning::kSyncMaxDevices
   841	           << " devices whose sync results are tracked one by one, so the pending entries of every untracked device "
   842	              "that had no completion proof were treated as failed and leaked";
   843	      return;
   844	    case Purpose::kQueryEvent:
   845	      os << "the completion event of a pending entry on device " << r.device
   846	         << " could not be queried (cudaEventQuery: ";
   847	      error();
   848	      os << ")";
   849	      return;
   850	    case Purpose::kDrainQueryEvent:
   851	      os << "cudaEventQuery of a pending entry's completion event in the next-call drain (the entry stayed pending; "
   852	            "synchronize() re-queried it) on device "
   853	         << r.device << " (";
   854	      error();
   855	      os << ")";
   856	      return;
   857	    case Purpose::kRecordEvent:
   858	      if (guard_call) {
   859	        os << "a call's completion event on device " << r.device
   860	           << " was not recorded (the call's operands were synchronized instead): ";
   861	        break;
   862	      }
   863	      os << "recording a call's completion event (cudaEventRecord on the operands' device; the call's operands were "
   864	            "synchronized instead) on device "
