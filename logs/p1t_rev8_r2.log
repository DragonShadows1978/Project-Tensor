   254	struct WaitOutcome {
   255	  long long running_at_start = 0;  // admitted sections of OTHER threads when the wait began
   256	  long long own[kKinds] = {0, 0};  // this thread's own (excluded)
   257	  long long waited_us = 0;
   258	  unsigned long long diagnostics = 0;
   259	  bool overran = false;            // outlasted the first-diagnostic delay
   260	};
   261	
   262	// Admitted sections (releases and producer callbacks) of OTHER threads: the calling thread's own are excluded.
   263	long long others_running(const Lifecycle& lc, const long long own[kKinds]) noexcept {
   264	  return lc.in_flight[kRelease].load(std::memory_order_seq_cst) - own[kRelease] +
   265	         lc.in_flight[kCallback].load(std::memory_order_seq_cst) - own[kCallback];
   266	}
