   108	std::vector<int64_t> shape4(const Operand& op) {
   109	  std::vector<int64_t> s(op.ndim());
   110	  for (int i = 0; i < op.ndim(); ++i) s[i] = op.dim(i);
   111	  return s;
   112	}
