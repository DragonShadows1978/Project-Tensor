    51	  if (v > INT_MAX) {
    52	    std::ostringstream os;
    53	    os << what << " (" << v << ") exceeds the 32-bit range cuBLAS takes";
    54	    bad_attr(os.str());
    55	  }
    56	}
    57	
    58	// ------------------------------------------------------------------------------------------------ Conv1d plan
    59	struct Conv1dPlan {
    60	  Conv1dGeom g;
    61	  std::vector<int64_t> out_shape;
    62	  int64_t scratch_numel;
    63	};
    64	
    65	Conv1dPlan plan_conv1d(const std::vector<int64_t>& xs, const std::vector<int64_t>& ws, const std::vector<int64_t>* bs,
    66	                       int64_t stride, int64_t pb, int64_t pe, int64_t dilation, int64_t groups) {
    67	  check_attr("stride", stride, 1);
    68	  check_attr("dilation", dilation, 1);
    69	  check_attr("groups", groups, 1);
    70	  check_attr("pad_begin", pb, 0);
    71	  check_attr("pad_end", pe, 0);
    72	  Conv1dPlan p{};
    73	  Conv1dGeom& g = p.g;
    74	  g.N = xs[0];
    75	  g.C_in = xs[1];
    76	  g.T = xs[2];
    77	  g.C_out = ws[0];
    78	  g.K = ws[2];
    79	  g.stride = stride;
    80	  g.pad_begin = pb;
    81	  g.pad_end = pe;
    82	  g.dilation = dilation;
    83	  g.groups = groups;
    84	  std::ostringstream os;
    85	  if (g.C_in % groups != 0) {
    86	    os << "conv1d: C_in (" << g.C_in << ") is not divisible by groups (" << groups << ")";
    87	    bad_attr(os.str());
    88	  }
    89	  if (ws[1] != g.C_in / groups) {
    90	    os << "conv1d: w.shape[1] (" << ws[1] << ") != C_in/groups (" << g.C_in / groups << "); w is [C_out, C_in/groups, K]";
    91	    bad_attr(os.str());
    92	  }
    93	  if (g.C_out % groups != 0) {
    94	    os << "conv1d: C_out (" << g.C_out << ") is not divisible by groups (" << groups << ")";
    95	    bad_attr(os.str());
    96	  }
    97	  if (bs != nullptr && (bs->size() != 1 || (*bs)[0] != g.C_out)) {
    98	    os << "conv1d: b has shape " << shape_str(*bs) << ", expected [" << g.C_out << "]";
    99	    bad_attr(os.str());
   100	  }
   101	  // Integer arithmetic in int64, every step checked (F03: dimensions may come from synthetic descriptors). Python's
   102	  // floor division and C++'s truncation differ for a negative numerator, so the sign is checked first.
   103	  const int64_t dk = ck_mul(dilation, g.K - 1, "conv1d: dilation*(K-1)");
   104	  int64_t num = ck_add(g.T, pb, "conv1d: T + pad_begin");
   105	  num = ck_add(num, pe, "conv1d: T + pad_begin + pad_end");
   106	  num = ck_sub(num, dk, "conv1d: output length numerator");
   107	  num = ck_sub(num, 1, "conv1d: output length numerator");
   108	  if (num < 0) {
   109	    os << "conv1d: output length (T + pb + pe - dilation*(K-1) - 1)//stride + 1 = (" << g.T << " + " << pb << " + "
   110	       << pe << " - " << dilation << "*" << (g.K - 1) << " - 1)//" << stride << " + 1 is <= 0";
   111	    bad_attr(os.str());
   112	  }
   113	  g.T_out = num / stride + 1;
   114	  g.direct = (g.K == 1 && stride == 1 && pb == 0 && pe == 0);
   115	  const int64_t Og = g.C_out / groups;
   116	  const int64_t CgK = (g.C_in / groups) * g.K;
   117	  check_int_range("T_out", g.T_out);
   118	  check_int_range("C_out/groups", Og);
   119	  check_int_range("C_in/groups*K", CgK);
   120	  p.out_shape = {g.N, g.C_out, g.T_out};
   121	  ck_shape_numel(p.out_shape, "conv1d: output size N*C_out*T_out");
   122	  p.scratch_numel =
   123	      g.direct ? 0 : ck_mul(ck_mul(g.C_in, g.K, "conv1d: im2col rows C_in*K"), g.T_out, "conv1d: im2col scratch size");
   124	  ck_fp32_bytes(p.scratch_numel, "conv1d: im2col scratch bytes");
   125	  return p;
   126	}
   127	
   128	// ------------------------------------------------------------------------------------------------ ConvTranspose1d plan
   129	struct ConvTranspose1dPlan {
   130	  ConvTranspose1dGeom g;
   131	  std::vector<int64_t> out_shape;
   132	};
   133	
   134	ConvTranspose1dPlan plan_conv_transpose1d(const std::vector<int64_t>& xs, const std::vector<int64_t>& ws,
   135	                                          const std::vector<int64_t>* bs, int64_t stride, int64_t pb, int64_t pe,
   136	                                          int64_t output_padding, int64_t dilation, int64_t groups) {
   137	  check_attr("stride", stride, 1);
   138	  check_attr("dilation", dilation, 1);
   139	  check_attr("groups", groups, 1);
   140	  check_attr("pad_begin", pb, 0);
   141	  check_attr("pad_end", pe, 0);
   142	  check_attr("output_padding", output_padding, 0);
   143	  std::ostringstream os;
   144	  if (output_padding >= std::max(stride, dilation)) {
   145	    os << "conv_transpose1d: output_padding (" << output_padding << ") must be < max(stride, dilation) ("
   146	       << std::max(stride, dilation) << ")";
   147	    bad_attr(os.str());
   148	  }
   149	  ConvTranspose1dPlan p{};
   150	  ConvTranspose1dGeom& g = p.g;
   151	  g.N = xs[0];
   152	  g.C_in = xs[1];
   153	  g.T = xs[2];
   154	  g.K = ws[2];
   155	  g.stride = stride;
   156	  g.pad_begin = pb;
   157	  g.pad_end = pe;
   158	  g.output_padding = output_padding;
   159	  g.dilation = dilation;
   160	  g.groups = groups;
   161	  if (ws[0] != g.C_in) {
   162	    os << "conv_transpose1d: w.shape[0] (" << ws[0] << ") != C_in (" << g.C_in
   163	       << "); w is [C_in, C_out/groups, K] (ONNX layout)";
   164	    bad_attr(os.str());
   165	  }
   166	  if (g.C_in % groups != 0) {
   167	    os << "conv_transpose1d: C_in (" << g.C_in << ") is not divisible by groups (" << groups << ")";
   168	    bad_attr(os.str());
   169	  }
   170	  g.C_out = ck_mul(ws[1], groups, "conv_transpose1d: C_out = w.shape[1]*groups");
   171	  if (bs != nullptr && (bs->size() != 1 || (*bs)[0] != g.C_out)) {
   172	    os << "conv_transpose1d: b has shape " << shape_str(*bs) << ", expected [" << g.C_out << "]";
   173	    bad_attr(os.str());
   174	  }
   175	  // F03: every step checked.
   176	  int64_t t_out = ck_mul(stride, g.T - 1, "conv_transpose1d: stride*(T-1)");
   177	  t_out = ck_add(t_out, output_padding, "conv_transpose1d: output length");
   178	  t_out = ck_add(t_out, ck_mul(dilation, g.K - 1, "conv_transpose1d: dilation*(K-1)"), "conv_transpose1d: output length");
   179	  t_out = ck_add(t_out, 1, "conv_transpose1d: output length");
   180	  t_out = ck_sub(t_out, pb, "conv_transpose1d: output length");
   181	  g.T_out = ck_sub(t_out, pe, "conv_transpose1d: output length");
   182	  if (g.T_out <= 0) {
   183	    os << "conv_transpose1d: output length stride*(T-1) + output_padding + dilation*(K-1) + 1 - pb - pe = "
   184	       << g.T_out << " is <= 0";
   185	    bad_attr(os.str());
   186	  }
   187	  p.out_shape = {g.N, g.C_out, g.T_out};
   188	  ck_shape_numel(p.out_shape, "conv_transpose1d: output size N*C_out*T_out");
   189	  return p;
   190	}
   191	
   192	// ------------------------------------------------------------------------------------------------ peek helpers
   193	struct Peeked {
   194	  CapsuleRef capsule;            // P1T-FIX5: admitted last-reference drop (dlpack_operand.h); empty when absent
   195	  std::vector<int64_t> shape;
   196	  int device = -1;
   197	};
   198	
   199	Peeked peek_operand(py::handle obj, const char* role, int ndim) {
   200	  Peeked p;
   201	  require_operand(obj, role);
   202	  p.capsule = to_capsule(obj, role, false);
   203	  const DLTensor* t = peek(p.capsule.handle(), role);
   204	  validate_tensor(t, role, ndim);
   205	  p.shape = shape_of(t);
   206	  p.device = t->device.device_id;
   207	  return p;
   208	}
   209	
   210	void same_device_peeked(const std::vector<const Peeked*>& ps, const std::vector<const char*>& roles) {
   211	  int dev = -1;
   212	  const char* first = "";
   213	  for (size_t i = 0; i < ps.size(); ++i) {
   214	    if (ps[i] == nullptr) continue;
   215	    if (dev < 0) {
   216	      dev = ps[i]->device;
   217	      first = roles[i];
   218	    } else if (ps[i]->device != dev) {
   219	      std::ostringstream os;
   220	      os << "tc_signal: operand '" << roles[i] << "': on CUDA device " << ps[i]->device << " but operand '" << first
   221	         << "' is on CUDA device " << dev << "; every operand must be on the same device";
   222	      throw py::value_error(os.str());
   223	    }
   224	  }
   225	}
   226	
   227	std::vector<int64_t> op_shape(const Operand& op) {
   228	  std::vector<int64_t> s(op.ndim());
   229	  for (int i = 0; i < op.ndim(); ++i) s[i] = op.dim(i);
   230	  return s;
   231	}
   232	
   233	py::tuple to_tuple(const std::vector<int64_t>& v) {
   234	  py::tuple t(v.size());
   235	  for (size_t i = 0; i < v.size(); ++i) t[i] = py::int_(v[i]);
   236	  return t;
   237	}
   238	
   239	// ------------------------------------------------------------------------------------------------ Conv1d entry points
   240	py::tuple conv1d_plan(py::object x, py::object w, py::object b, int64_t stride, int64_t pb, int64_t pe,
   241	                      int64_t dilation, int64_t groups) {
   242	  drain_completed();
   243	  require_operand(x, "x");
   244	  require_operand(w, "w");
   245	  Peeked X = peek_operand(x, "x", 3);
   246	  Peeked W = peek_operand(w, "w", 3);
   247	  Peeked B;
   248	  const bool has_b = !b.is_none();
   249	  if (has_b) B = peek_operand(b, "b", 1);
   250	  same_device_peeked({&X, &W, has_b ? &B : nullptr}, {"x", "w", "b"});
   251	  Conv1dPlan p = plan_conv1d(X.shape, W.shape, has_b ? &B.shape : nullptr, stride, pb, pe, dilation, groups);
   252	  return py::make_tuple(X.capsule.object(), W.capsule.object(), has_b ? B.capsule.object() : py::none(),
   253	                        to_tuple(p.out_shape), py::int_(p.scratch_numel));
   254	}
   255	
   256	void conv1d_run(py::object xc, py::object wc, py::object bc, py::object out, py::object scratch, int64_t stride,
   257	                int64_t pb, int64_t pe, int64_t dilation, int64_t groups) {
   258	  drain_completed();
   259	  require_operand(xc, "x");
   260	  require_operand(wc, "w");
   261	  require_operand(out, "out");
   262	  Operand X(xc, "x", 3, false);
   263	  Operand W(wc, "w", 3, false);
   264	  Operand B;
   265	  if (!bc.is_none()) B = Operand(bc, "b", 1, false);
   266	  std::vector<int64_t> bshape;
   267	  if (B.present()) bshape = op_shape(B);
   268	  const std::vector<int64_t> xshape = op_shape(X);
   269	  const std::vector<int64_t> wshape = op_shape(W);
   270	  Conv1dPlan p = plan_conv1d(xshape, wshape, B.present() ? &bshape : nullptr, stride, pb, pe, dilation, groups);
   271	  Operand Y(to_capsule(out, "out", true).handle(), "out", 3, true);
   272	  expect_shape(Y, p.out_shape);
   273	  Operand S;
   274	  if (p.scratch_numel > 0) {
   275	    if (scratch.is_none()) bad_attr("conv1d: this call needs an im2col scratch operand and none was passed");
   276	    S = Operand(to_capsule(scratch, "scratch", true).handle(), "scratch", 1, true);
   277	    expect_shape(S, {p.scratch_numel});
   278	  } else if (!scratch.is_none()) {
   279	    bad_attr("conv1d: this call needs no scratch (K == 1, stride 1, no pads) but one was passed");
   280	  }
   281	  const int device = common_device({&X, &W, &B, &Y, &S});
   282	  for (const Operand* in : {&X, &W, &B, &S}) expect_disjoint(Y, *in);
   283	  for (const Operand* in : {&X, &W, &B}) expect_disjoint(S, *in);
   284	  // F01: every consumed manager stays alive until the legacy stream has passed these launches (also when a launch
   285	  // throws part-way); the producer deleters run later, from drain_completed / synchronize / atexit.
   286	  RetainUntilComplete keep(device, {&X, &W, &B, &Y, &S});
   287	  conv1d_forward(device, p.g, X.data(), W.data(), B.present() ? B.data() : nullptr, Y.data(),
   288	                 S.present() ? S.data() : nullptr);
   289	}
