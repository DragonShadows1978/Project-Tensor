  1359	    os << "tc_signal: cannot create the completion event on CUDA device " << device << ": " << cudaGetErrorName(r)
  1360	       << ": " << cudaGetErrorString(r) << " ("
  1361	       << (g.ok() ? "cudaEventCreateWithFlags returned it"
  1362	                  : (g.failed_at_switch()
  1363	                         ? "switching to that device failed, cudaSetDevice returned it; no event was created"
  1364	                         : "the current-device query before switching failed, cudaGetDevice returned it; no event "
  1365	                           "was created"))
  1366	       << ")";
