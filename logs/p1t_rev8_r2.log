   245	// ------------------------------------------------------------------------------------------------ small ops: plan
   246	std::vector<int64_t> upsample_shape(const std::vector<int64_t>& xs, int64_t scale) {
   247	  if (scale < 1) {
   248	    std::ostringstream os;
   249	    os << "upsample_nearest1d: scale must be an integer >= 1, got " << scale;
   250	    bad_attr4(os.str());
   251	  }
   252	  const int64_t T = xs.back();
   253	  std::vector<int64_t> o = xs;
   254	  o.back() = ck_mul(T, scale, "upsample_nearest1d: output length T*scale");  // F03
   255	  ck_shape_numel(o, "upsample_nearest1d: output size");
   256	  return o;
   257	}
   258	
   259	std::vector<int64_t> pad_shape(const std::vector<int64_t>& xs, int64_t pb, int64_t pe) {
   260	  const int64_t T = xs.back();
   261	  std::ostringstream os;
   262	  if (pb < 0 || pe < 0) {
   263	    os << "reflection_pad1d: pads must be >= 0, got (" << pb << ", " << pe << ")";
   264	    bad_attr4(os.str());
   265	  }
   266	  if (pb >= T || pe >= T) {
   267	    os << "reflection_pad1d: each pad must be < T (" << T << ") for reflect padding (ONNX/torch), got (" << pb << ", "
   268	       << pe << ")";
   269	    bad_attr4(os.str());
   270	  }
   271	  std::vector<int64_t> o = xs;
   272	  // F03: T + pb + pe checked (the review's CPU reproduction returned a negative extent here), then the output size.
   273	  o.back() = ck_add(ck_add(T, pb, "reflection_pad1d: output length"), pe, "reflection_pad1d: output length");
   274	  ck_shape_numel(o, "reflection_pad1d: output size");
   275	  return o;
   276	}
