   268	// The part of the exit wait that runs with the GIL released: the mutex and condition variable only, no Python object.
   269	// P1T-FIX7, lead send-back L1 (sweep (i) addendum): FIX5's fallback for a failed lifecycle mutex / condition variable
   270	// (poll every kLifecyclePollMs until quiet) was a SILENT exit wait. It now keeps the same diagnostic schedule as the
   271	// condition-variable wait (FIX3 V3-01 / FIX5 V5-01: the first line after first_diag_s from the start of the wait, then
   272	// each time the time waited has doubled; C stdio, no allocation, GIL released), says that it is polling and why, and
   273	// counts each line (w.diagnostics -> pending_stats() exit_wait_diagnostics for the hook's close, and
   274	// exit_wait_poll_diagnostics for every polling line). It still never returns early. Prior art: FIX3 / FIX5's own
   275	// schedule (taken as is); ours: applying it to the fallback.
   276	void wait_without_gil(Lifecycle& lc, double first_diag_s, std::chrono::steady_clock::time_point t0,
   277	                      WaitOutcome& w) noexcept {
   278	  using clock = std::chrono::steady_clock;
   279	  const auto first = std::chrono::duration_cast<clock::duration>(std::chrono::duration<double>(first_diag_s));
   280	  const auto tick = clock::duration(1);  // next line at least one clock tick later: no busy loop at a zero delay
   281	  auto quiet = [&lc, &w] { return others_running(lc, w.own) <= 0; };
   282	  auto next = t0 + first;
   283	  try {
   284	    std::unique_lock<std::mutex> lk(lc.mu);
   285	    while (!lc.cv.wait_until(lk, next, quiet)) {
   286	      // Still running at the diagnostic time: report, then keep waiting (never return early: V3-01, V5-01).
   287	      w.overran = true;
   288	      const long long running = others_running(lc, w.own);
   289	      lk.unlock();  // a blocked stderr must not stop a callback from leaving
   290	      const auto now = clock::now();
   291	      std::fprintf(stderr,
   292	                   "tc_signal: %lld DLPack producer callback(s) (deleter, capsule destructor or __dlpack__) admitted "
   293	                   "on other threads before interpreter exit still running after %.1f s; interpreter exit waits for "
   294	                   "them (no new one is admitted)\n",
   295	                   running, std::chrono::duration<double>(now - t0).count());
   296	      std::fflush(stderr);
   297	      ++w.diagnostics;
   298	      const auto waited = now - t0;  // next line when the time waited has doubled
   299	      next = now + (waited > tick ? waited : tick);
   300	      lk.lock();
   301	    }
   302	    return;
   303	  } catch (const std::system_error&) {
   304	    // A mutex / condition-variable failure (never observed): keep waiting by polling, never return early.
   305	    g_lifecycle_lock_failures.fetch_add(1, std::memory_order_relaxed);
   306	  }
   307	  while (!quiet()) {
   308	    const auto now = clock::now();
   309	    if (now >= next) {  // the same schedule as above, continued from where it was: never a silent wait
   310	      w.overran = true;
   311	      std::fprintf(stderr,
   312	                   "tc_signal: %lld DLPack producer callback(s) (deleter, capsule destructor or __dlpack__) admitted "
   313	                   "on other threads before interpreter exit still running after %.1f s; interpreter exit waits for "
   314	                   "them (no new one is admitted; polling every %d ms because the lifecycle mutex or condition "
   315	                   "variable failed)\n",
   316	                   others_running(lc, w.own), std::chrono::duration<double>(now - t0).count(),
   317	                   tuning::kLifecyclePollMs);
   318	      std::fflush(stderr);
   319	      ++w.diagnostics;
   320	      g_exit_wait_poll_diagnostics.fetch_add(1, std::memory_order_relaxed);
   321	      const auto waited = now - t0;
   322	      next = now + (waited > tick ? waited : tick);
   323	    }
   324	    std::this_thread::sleep_for(std::chrono::milliseconds(tuning::kLifecyclePollMs));
   325	  }
   326	}
