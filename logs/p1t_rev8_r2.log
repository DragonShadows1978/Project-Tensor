   709	  if (written.byte_begin() < other.byte_end() && other.byte_begin() < written.byte_end())
   710	    refuse_value(written.role(), std::string("its memory overlaps operand '") + other.role() +
   711	                                     "'; the written operand must not alias any other operand");
   712	}
