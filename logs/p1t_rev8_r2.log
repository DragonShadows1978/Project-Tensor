  1471	long long exit_runner_close_and_wait(long long* waited_us) {
  1472	  const ExitClose c = exit_close_and_wait(tuning::kExitDiagDefaultS);
  1473	  const long long running = c.w.running_at_start > 0 ? c.w.running_at_start : 0;
  1474	  g_exit_runner_closes.fetch_add(1, std::memory_order_relaxed);
  1475	  g_exit_runner_in_flight_at_close.fetch_add(static_cast<unsigned long long>(running), std::memory_order_relaxed);
  1476	  if (waited_us != nullptr) *waited_us = c.w.waited_us;
  1477	  return running;
  1478	}
