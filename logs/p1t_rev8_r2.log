   184	    float zi = gxp[kGateI * H + j] + ghp[kGateI * H + j];
   185	    float zo = gxp[kGateO * H + j] + ghp[kGateO * H + j];
   186	    float zf = gxp[kGateF * H + j] + ghp[kGateF * H + j];
   187	    float zc = gxp[kGateC * H + j] + ghp[kGateC * H + j];
   188	    if (B != nullptr) {
   189	      const float* rb = B + d * (kLstmBiasHalves * H4) + H4;     // Rb[d] = B[d, 4H:8H]
   190	      zi = zi + rb[kGateI * H + j];
   191	      zo = zo + rb[kGateO * H + j];
   192	      zf = zf + rb[kGateF * H + j];
   193	      zc = zc + rb[kGateC * H + j];
   194	    }
   195	    const float ig = sigmoid_stable(zi);
   196	    const float og = sigmoid_stable(zo);
   197	    const float fg = sigmoid_stable(zf);
   198	    const float cg = tanhf(zc);
   199	    const float cn = fmaf(fg, c[idx], ig * cg);
   200	    const float hn = og * tanhf(cn);
   201	    c[idx] = cn;
   202	    h[idx] = hn;
   203	    Y[((tt * D + d) * N + n) * H + j] = hn;
   204	  }
   205	}
