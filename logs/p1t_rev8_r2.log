   659	  size_t bytes = numel() * dtype_size(dtype);
   660	  if (bytes == 0) return;
   661	  if (device.is_cuda()) cudaMemcpy(dst, data_ptr(), bytes, cudaMemcpyDeviceToHost);
   662	  else std::memcpy(dst, data_ptr(), bytes);
   663	  cuda_check_last("to_host");
   664	}
