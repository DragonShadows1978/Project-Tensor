   194	bool interpreter_accepts_python() noexcept {
   195	  if (!Py_IsInitialized()) return false;
   196	#if PY_VERSION_HEX >= 0x030D0000
   197	  if (Py_IsFinalizing()) return false;
   198	#else
   199	  if (_Py_IsFinalizing()) return false;
   200	#endif
   201	  return true;
   202	}
