   611	void fill_(NDArray& a, double value) {
   612	  if (!a.defined()) throw std::runtime_error("fill_: undefined array");
   613	  if (!a.device.is_cuda()) throw std::runtime_error("fill_: CUDA arrays only");
   614	  if (a.dtype != DType::Float32 && a.dtype != DType::Float16 && a.dtype != DType::BFloat16)
   615	    throw std::runtime_error("op supports float32/float16/bfloat16 only");
   616	  int64_t n = a.numel();
   617	  if (n == 0) return;
   618	  const int64_t blocks = fill_grid_blocks(n);  // P1T-FIX5 V5-04: int64 block count; refused here if over the limit
   619	  const std::string mismatch = cuda_storage_device_mismatch(a, "fill_");
   620	  if (!mismatch.empty()) throw std::runtime_error(mismatch);
   621	  CheckedDeviceGuard guard(a.device.index, "fill_");
   622	  const cudaError_t pending = cudaGetLastError();
   623	  if (pending != cudaSuccess)
   624	    throw std::runtime_error(std::string("fill_: a CUDA error was already pending in this thread before the launch (") +
   625	                             cudaGetErrorName(pending) + ": " + cudaGetErrorString(pending) +
   626	                             "), from earlier work outside this call; taken from the error slot and reported here, nothing was launched "
   627	                             "(P1T-FIX7: the call that set it and its device are unknown; the slot records neither)");
   628	  DISPATCH_FLOAT(a.dtype, T, {
   629	    // P1T-FIX5 V5-04: blocks <= 2^31-1 (checked above), so this conversion is exact and blocks * kT >= n.
   630	    fill_kernel<T><<<static_cast<unsigned int>(blocks), kT>>>(static_cast<T*>(a.data_ptr()), n, (float)value);
   631	  });
   632	  // P1T-FIX7 (sweep (j), error attribution): the launch check names the kernel and the device, and does not claim the
   633	  // launch failed: cudaGetLastError right after a launch reports the launch's own error OR an asynchronous error of
   634	  // earlier work on that device (CUDA 12.6 Runtime API: it "may also return error codes from previous, asynchronous
   635	  // launches"). FIX6 called the baseline cuda_check_last("fill_"), which named neither. The message still starts
   636	  // "CUDA error at fill_" (that helper's text). Prior art: PyTorch's C10_CUDA_KERNEL_LAUNCH_CHECK note ("CUDA kernel
   637	  // errors might be asynchronously reported at some other API call").
   638	  {
   639	    const cudaError_t le = cudaGetLastError();  // consumes the entry it reports
   640	    if (le != cudaSuccess)
   641	      throw std::runtime_error(std::string("CUDA error at fill_: ") + cudaGetErrorName(le) + ": " +
   642	                               cudaGetErrorString(le) + " (cudaGetLastError right after launching fill_kernel on CUDA "
   643	                               "device " + std::to_string(a.device.index) +
   644	                               ": the launch's own error, or an asynchronous error of earlier work on that device)");
   645	  }
   646	  a.mark_modified();  // the write is queued: bump the revision BEFORE a restore failure can raise
   647	  guard.restore();
   648	}
   649	NDArray NDArray::from_host(const void* src, const Shape& shape, DType dtype, Device device) {
   650	  NDArray a(shape, dtype, device);
   651	  size_t bytes = a.numel() * dtype_size(dtype);
   652	  if (bytes == 0) return a;
   653	  if (device.is_cuda()) cudaMemcpy(a.data_ptr(), src, bytes, cudaMemcpyHostToDevice);
   654	  else std::memcpy(a.data_ptr(), src, bytes);
   655	  cuda_check_last("from_host");
   656	  return a;
   657	}
