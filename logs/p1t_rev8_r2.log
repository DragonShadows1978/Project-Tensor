   236	// RAII for the producer-callback section of to_capsule. Throws RuntimeError (before any callback) when refused.
   237	class CallbackSection {
   238	 public:
   239	  explicit CallbackSection(const char* role) {
   240	    const Admission a = admit(kCallback);
   241	    if (a == Admission::kAdmitted) return;
   242	    g_callbacks_refused.fetch_add(1, std::memory_order_relaxed);
   243	    throw std::runtime_error(std::string("tc_signal: operand '") + role + "': " +
   244	                             (a == Admission::kClosed
   245	                                  ? "interpreter exit has begun (tc_signal's exit hook closed admission)"
   246	                                  : "the interpreter is finalizing") +
   247	                             ", so the producer's __dlpack__ is not called; refused before acquiring anything");
   248	  }
   249	  ~CallbackSection() { leave(kCallback); }
   250	  CallbackSection(const CallbackSection&) = delete;
   251	  CallbackSection& operator=(const CallbackSection&) = delete;
   252	};
