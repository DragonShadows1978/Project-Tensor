  1248	  const int nd = static_cast<int>(shape.size());
  1249	  const int64_t numel = checked_numel(shape.data(), nd, "empty");
  1250	  const int64_t nbytes = checked_nbytes(numel, dtype_size(dt), shape.data(), nd, "empty");
