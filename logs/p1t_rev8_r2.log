  1506	  // are released at once by their own destructors); the destructor below allocates only for the pending-list push.
  1507	  if (test_hooks::take(test_hooks::kAllocOwnerReserve)) throw std::bad_alloc();
  1508	  owners_.reserve(ops_.size());
