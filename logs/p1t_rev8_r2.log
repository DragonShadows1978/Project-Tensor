   806	const char* call_name(FailedCall c) noexcept {
   807	  switch (c) {
   808	    case FailedCall::kGetDevice: return "cudaGetDevice";
   809	    case FailedCall::kSetDevice: return "cudaSetDevice";
   810	    case FailedCall::kStreamSync: return "cudaStreamSynchronize";
   811	    case FailedCall::kEventQuery: return "cudaEventQuery";
   812	    case FailedCall::kEventRecord: return "cudaEventRecord";
   813	    case FailedCall::kEventDestroy: return "cudaEventDestroy";
   814	  }
   815	  return "a CUDA call";
   816	}
