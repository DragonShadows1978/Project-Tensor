   123	// ------------------------------------------------------------------------------------------------ norms: plan
   124	enum class NormKind { kInstance, kLayer, kGroup };
   125	
   126	const char* norm_name(NormKind k) {
   127	  return k == NormKind::kInstance ? "instance_norm1d" : (k == NormKind::kLayer ? "layer_norm" : "group_norm");
   128	}
   129	
   130	struct NormPlan {
   131	  RowNormGeom g;
   132	  std::vector<int64_t> out_shape;
   133	  std::vector<int64_t> param_shape;
   134	};
   135	
   136	float checked_eps(const char* op, double eps) {
   137	  const float e = static_cast<float>(eps);
   138	  if (!std::isfinite(eps) || eps < 0.0 || !std::isfinite(e)) {
   139	    std::ostringstream os;
   140	    os << op << ": eps must be a finite number >= 0 that fits fp32, got " << eps;
   141	    bad_attr4(os.str());
   142	  }
   143	  return e;
   144	}
   145	
   146	// `arg` is the axis (layer_norm) or num_groups (group_norm); unused for instance_norm1d.
   147	NormPlan plan_norm(NormKind kind, const std::vector<int64_t>& xs, const std::vector<int64_t>* ss,
   148	                   const std::vector<int64_t>* bs, int64_t arg, double eps) {
   149	  const char* op = norm_name(kind);
   150	  NormPlan p{};
   151	  RowNormGeom& g = p.g;
   152	  g.eps = checked_eps(op, eps);
   153	  g.channels = g.groups = g.ch_per_group = g.T = 1;
   154	  const int64_t r = static_cast<int64_t>(xs.size());
   155	  std::ostringstream os;
   156	  if (kind == NormKind::kInstance || kind == NormKind::kGroup) {
   157	    if (r != 3) {
   158	      os << op << ": x must be [N, C, T], got " << r << " dimensions";
   159	      bad_attr4(os.str());
   160	    }
   161	    const int64_t N = xs[0], C = xs[1], T = xs[2];
   162	    p.param_shape = {C};
   163	    if (kind == NormKind::kInstance) {
   164	      g.rows = ck_mul(N, C, "instance_norm1d: rows N*C");
   165	      g.L = T;
   166	      g.affine = NormAffine::kPerRow;
   167	      g.channels = C;
   168	    } else {
   169	      if (arg < 1) {
   170	        os << "group_norm: num_groups must be >= 1, got " << arg;
   171	        bad_attr4(os.str());
   172	      }
   173	      if (C % arg != 0) {
   174	        os << "group_norm: C (" << C << ") is not divisible by num_groups (" << arg << ")";
   175	        bad_attr4(os.str());
   176	      }
   177	      g.rows = ck_mul(N, arg, "group_norm: rows N*num_groups");
   178	      g.L = ck_mul(C / arg, T, "group_norm: row length (C/num_groups)*T");
   179	      g.affine = NormAffine::kPerChannel;
   180	      g.groups = arg;
   181	      g.ch_per_group = C / arg;
   182	      g.T = T;
   183	    }
   184	  } else {
   185	    if (r < 1) {
   186	      os << "layer_norm: x must have at least 1 dimension, got " << r;
   187	      bad_attr4(os.str());
   188	    }
   189	    if (arg < -r || arg >= r) {
   190	      os << "layer_norm: axis must be in [" << -r << ", " << r - 1 << "] for a " << r << "-D x, got " << arg;
   191	      bad_attr4(os.str());
   192	    }
   193	    const int64_t a = arg < 0 ? arg + r : arg;
   194	    g.rows = prod(xs, 0, static_cast<size_t>(a), "layer_norm: rows");
   195	    g.L = prod(xs, static_cast<size_t>(a), xs.size(), "layer_norm: row length");
   196	    g.affine = NormAffine::kPerElem;
   197	    p.param_shape.assign(xs.begin() + a, xs.end());
   198	  }
   199	  for (const auto& pr : {std::make_pair(ss, "scale"), std::make_pair(bs, "bias")}) {
   200	    if (pr.first != nullptr && *pr.first != p.param_shape) {
   201	      std::ostringstream o2;
   202	      o2 << op << ": " << pr.second << " has shape " << shape_str(*pr.first) << ", expected "
   203	         << shape_str(p.param_shape)
   204	         << (kind == NormKind::kLayer ? " (x.shape[axis:])" : (kind == NormKind::kGroup ? " ([C], per channel)" : " ([C])"));
   205	      bad_attr4(o2.str());
   206	    }
   207	  }
   208	  p.out_shape = xs;
   209	  ck_shape_numel(p.out_shape, "norm: output size");
   210	  ck_mul(g.rows, g.L, "norm: rows*L");
   211	  return p;
   212	}
