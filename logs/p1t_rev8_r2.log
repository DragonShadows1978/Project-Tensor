   383	// ------------------------------------------------------------------------------------------------ capsule acquisition
   384	CapsuleRef to_capsule(py::handle obj, const char* role, bool writable) {
   385	  if (PyCapsule_CheckExact(obj.ptr())) return CapsuleRef(py::reinterpret_borrow<py::object>(obj));
   386	  // P1T-FIX5 (V5-01 sweep (c)): from here to the return, the producer's Python code may run (and release / re-take the
   387	  // GIL): an admitted section, waited for by the exit hook; refused (RuntimeError, nothing called) after it closed.
   388	  CallbackSection section(role);
   389	  if (!py::hasattr(obj, "__dlpack__"))
   390	    refuse_type(role, "expected a DLPack producer (an object with __dlpack__) or a DLPack capsule, got " +
   391	                          type_name(obj));
   392	  // Array API order: ask the producer's device first. A non-CUDA producer is refused here, before __dlpack__ is
   393	  // called with a CUDA stream argument (CPU producers such as NumPy reject any stream other than None).
   394	  if (py::hasattr(obj, "__dlpack_device__")) {
   395	    int device_type = -1;
   396	    try {
   397	      py::tuple dev = obj.attr("__dlpack_device__")().cast<py::tuple>();
   398	      device_type = dev[0].cast<int>();
   399	    } catch (py::cast_error&) {
   400	      refuse_type(role, "__dlpack_device__() did not return a (device_type, device_id) tuple of ints");
   401	    }
   402	    if (device_type != kDLCUDA) {
   403	      std::ostringstream os;
   404	      os << "device type " << device_type << " is not kDLCUDA (2); tc_signal takes CUDA device memory only";
   405	      refuse_value(role, os.str());
   406	    }
   407	  }
   408	  py::object fn = obj.attr("__dlpack__");
   409	  py::object cap;
   410	  const py::tuple max_version = py::make_tuple(tuning::kDlpackMaxMajor, tuning::kDlpackMaxMinor);
   411	  try {
   412	    // Consumer stream = the legacy default stream (DLPack int 1): the producer orders its pending work before it.
   413	    if (writable)
   414	      cap = fn(py::arg("stream") = tuning::kDlpackLegacyStream, py::arg("max_version") = max_version,
   415	               py::arg("copy") = false);
   416	    else
   417	      cap = fn(py::arg("stream") = tuning::kDlpackLegacyStream, py::arg("max_version") = max_version);
   418	  } catch (py::error_already_set& e) {
   419	    // A producer that predates the 2023 keywords rejects them with TypeError: retry with the stream argument only
   420	    // (the array API standard's documented fallback; NumPy and PyTorch consumers do the same).
   421	    if (!e.matches(PyExc_TypeError)) throw;
   422	    cap = fn(py::arg("stream") = tuning::kDlpackLegacyStream);
   423	  }
   424	  if (!PyCapsule_CheckExact(cap.ptr()))
   425	    refuse_type(role, "__dlpack__ returned " + type_name(cap) + ", not a PyCapsule");
   426	  return CapsuleRef(std::move(cap));
   427	}
