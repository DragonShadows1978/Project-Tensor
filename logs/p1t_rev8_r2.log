   780	enum class FailedCall : unsigned char {
   781	  kGetDevice,     // cudaGetDevice
   782	  kSetDevice,     // cudaSetDevice
   783	  kStreamSync,    // cudaStreamSynchronize(cudaStreamLegacy)
   784	  kEventQuery,    // cudaEventQuery
   785	  kEventRecord,   // cudaEventRecord(event, cudaStreamLegacy)
   786	  kEventDestroy,  // cudaEventDestroy
   787	};
   788	enum class Purpose : unsigned char {
   789	  kCurrentDevice,    // synchronize()'s current-device query (it reads which device is current: no device)
   790	  kSyncStream,       // synchronizing the legacy stream of `device` (the guard's read / switch, or the sync itself)
   791	  kSyncUntracked,    // the same, for a device beyond the kSyncMaxDevices tracked one by one (the spill path)
   792	  kQueryEvent,       // querying a pending entry's completion event (an event of `device`) in a sync drain
   793	  kDrainQueryEvent,  // the same query in the next-call drain (the entry stayed pending; synchronize() re-queries it)
   794	  kRecordEvent,      // recording a call's completion event on `device`'s legacy stream (the call then synchronized)
   795	  kDestroyEvent,     // destroying a completion event of `device` that could not be pooled
   796	  kRestoreDevice,    // restoring the caller's current device `device` after a switch
   797	  kUnnamed,          // never built from a real failure: failed() with no named record (capacity exhausted)
   798	};
   799	struct FailureRecord {
   800	  FailedCall call = FailedCall::kStreamSync;
   801	  Purpose purpose = Purpose::kUnnamed;
   802	  int device = -1;  // the device the failed call concerned; -1 only for kCurrentDevice / kUnnamed
   803	  cudaError_t err = cudaSuccess;
   804	};
