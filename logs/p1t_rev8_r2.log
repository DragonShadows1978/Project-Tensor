  1432	py::dict exit_close_admission(double first_diag_s, bool diag_default_used) {
  1433	  // The delay actually used (reported back): NaN or negative -> 0, diagnose at once; capped at the chrono-safe maximum.
  1434	  if (!(first_diag_s >= 0.0)) first_diag_s = 0.0;
  1435	  if (first_diag_s > tuning::kLifecycleMaxDiagDelayS) first_diag_s = tuning::kLifecycleMaxDiagDelayS;
  1436	  const ExitClose c = exit_close_and_wait(first_diag_s);
  1437	  const WaitOutcome& w = c.w;
  1438	  g_exit_hook_calls.fetch_add(1, std::memory_order_relaxed);
  1439	  if (w.running_at_start > 0)
  1440	    g_exit_in_flight_at_close.fetch_add(static_cast<unsigned long long>(w.running_at_start), std::memory_order_relaxed);
  1441	  g_exit_wait_us.fetch_add(static_cast<unsigned long long>(w.waited_us), std::memory_order_relaxed);
  1442	  g_exit_wait_diagnostics.fetch_add(w.diagnostics, std::memory_order_relaxed);
  1443	  if (w.overran) g_exit_wait_overruns.fetch_add(1, std::memory_order_relaxed);
  1444	  if (diag_default_used) g_exit_diag_default_used.fetch_add(1, std::memory_order_relaxed);
  1445	  py::dict d;  // built after the close and the wait: a MemoryError here cannot skip them
  1446	  d["in_flight_at_close"] = w.running_at_start > 0 ? w.running_at_start : 0;
  1447	  d["own_thread_in_flight"] = w.own[kRelease] + w.own[kCallback];
  1448	  d["pending_entries_at_close"] = c.pending_at_close;
  1449	  d["waited_us"] = w.waited_us;
  1450	  d["diagnostics"] = w.diagnostics;
  1451	  d["overran"] = w.overran;
  1452	  d["first_diag_s"] = first_diag_s;                    // P1T-FIX7: the delay actually used (after NaN / cap handling)
  1453	  d["first_diag_default_used"] = diag_default_used;    // P1T-FIX7: the knob could not be read; the default was used
  1454	  return d;
  1455	}
  1456	
  1457	py::dict close_admission_and_wait(double first_diag_s) { return exit_close_admission(first_diag_s, false); }
