   328	// The exit hook's wait (P1T-FIX6: its only caller; ordinary calls never wait for another thread, V6-01): until no
   329	// admitted section of another thread is running. The GIL is released for the wait and re-taken explicitly here (see
   330	// the design block above for why not by a destructor).
   331	WaitOutcome wait_for_other_threads(double first_diag_s) {
   332	  Lifecycle& lc = lifecycle();
   333	  WaitOutcome w;
   334	  w.own[kRelease] = t_depth[kRelease];
   335	  w.own[kCallback] = t_depth[kCallback];
   336	  w.running_at_start = others_running(lc, w.own);
   337	  if (w.running_at_start <= 0) return w;  // nothing to wait for: the GIL is not touched
   338	  if (!(first_diag_s >= 0.0)) first_diag_s = 0.0;   // NaN or negative: diagnose at once (the wait is the same)
   339	  if (first_diag_s > tuning::kLifecycleMaxDiagDelayS) first_diag_s = tuning::kLifecycleMaxDiagDelayS;
   340	  const auto t0 = std::chrono::steady_clock::now();
   341	  const bool held = PyGILState_Check() != 0;
   342	  PyThreadState* ts = held ? PyEval_SaveThread() : nullptr;  // GIL released: an admitted callback can finish
   343	  wait_without_gil(lc, first_diag_s, t0, w);
   344	  if (held) PyEval_RestoreThread(ts);  // the mutex is not held here; may exit a daemon thread during finalization
   345	  w.waited_us = std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - t0).count();
   346	  return w;
   347	}
