    98	Operand consume4(py::handle cap, const char* role, int rank, int min_rank, Need need) {
    99	  if (need == Need::kRequired) require_operand(cap, role);  // F02
   100	  if (cap.is_none()) return Operand();
   101	  const DLTensor* t = peek(cap, role);
   102	  const int nd = t->ndim;
   103	  Operand op(cap, role, rank >= 0 ? rank : nd, false);
   104	  check_rank(role, op.ndim(), rank, min_rank);
   105	  return op;
   106	}
