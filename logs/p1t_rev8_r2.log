  1348	  // call (MemoryError, operands released at once), so returning the event to the pool later never allocates.
  1349	  if (test_hooks::take(test_hooks::kAllocEventPoolReserve)) throw std::bad_alloc();
  1350	  if (de.free.capacity() < de.created + 1) de.free.reserve(std::max<size_t>(2 * de.free.capacity(), de.created + 1));
