   689	int common_device(const std::vector<const Operand*>& ops) {
   690	  int dev = -1;
   691	  const char* first = "";
   692	  for (const Operand* op : ops) {
   693	    if (op == nullptr || !op->present()) continue;
   694	    if (dev < 0) {
   695	      dev = op->device();
   696	      first = op->role();
   697	    } else if (op->device() != dev) {
   698	      std::ostringstream os;
   699	      os << "on CUDA device " << op->device() << " but operand '" << first << "' is on CUDA device " << dev
   700	         << "; every operand must be on the same device";
   701	      refuse_value(op->role(), os.str());
   702	    }
   703	  }
   704	  return dev;
   705	}
