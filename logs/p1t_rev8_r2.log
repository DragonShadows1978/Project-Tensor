   332	// P1T-FIX4 (sweep, implicit current device): a checked scoped device switch for fill_. The constructor raises
   333	// RuntimeError if the current device cannot be read or the switch fails (nothing switched then); restore() is the
   334	// success-path restore and raises if it fails; the destructor restores only when an exception is already unwinding
   335	// (restore() not reached) and counts a failure instead of throwing (no throw from a destructor).
   336	// Prior art: c10::cuda::CUDAGuard / OptionalCUDAGuard (PyTorch; switch, then restore in the destructor with
   337	// C10_CUDA_CHECK_WARN) and cupy.cuda.Device as a context manager (CuPy; __exit__ restores and may raise). Taken: the
   338	// scoped switch-and-restore. Ours: the explicit raising restore() on the success path plus the counting destructor.
   339	class CheckedDeviceGuard {
   340	 public:
   341	  CheckedDeviceGuard(int device, const char* who) : who_(who) {
   342	    cudaError_t e = cudaGetDevice(&prev_);
   343	    if (e != cudaSuccess) raise_cuda_failure(std::string(who_) + ": cudaGetDevice failed", e);
   344	    if (prev_ != device) {
   345	      e = cudaSetDevice(device);
   346	      if (e != cudaSuccess)
   347	        raise_cuda_failure(std::string(who_) + ": cannot make the tensor's CUDA device " + std::to_string(device) +
   348	                               " current (cudaSetDevice failed)",
   349	                           e);
   350	      switched_ = true;
   351	    }
   352	  }
   353	  void restore() {
   354	    if (!switched_) return;
   355	    switched_ = false;
   356	    const cudaError_t e = cudaSetDevice(prev_);
   357	    if (e != cudaSuccess)
   358	      raise_cuda_failure(std::string(who_) + ": restoring the caller's CUDA device " + std::to_string(prev_) +
   359	                             " failed (cudaSetDevice); the work was queued, and the calling thread's current device "
   360	                             "is still the tensor's",
   361	                         e);
   362	  }
   363	  ~CheckedDeviceGuard() {
   364	    if (!switched_) return;
   365	    const cudaError_t e = cudaSetDevice(prev_);
   366	    if (e != cudaSuccess) {
   367	      // P1T-FIX5 (sweep d): recorded before its slot entry is consumed (counted only, before).
   368	      note_core_unraisable("restoring the caller's CUDA device while fill_ unwound after another error (cudaSetDevice)",
   369	                           prev_, e);
   370	      cudaGetLastError();
   371	      g_dlpack_device_restore_failures.fetch_add(1);
   372	    }
   373	  }
   374	  CheckedDeviceGuard(const CheckedDeviceGuard&) = delete;
   375	  CheckedDeviceGuard& operator=(const CheckedDeviceGuard&) = delete;
   376	
   377	 private:
   378	  const char* who_;
   379	  int prev_ = -1;
   380	  bool switched_ = false;
   381	};
