  1352	  cudaEvent_t ev = nullptr;
  1353	  cudaError_t r = g.ok() ? cudaEventCreateWithFlags(&ev, cudaEventDisableTiming) : g.error();
  1354	  if (r != cudaSuccess) {
  1355	    cudaGetLastError();
