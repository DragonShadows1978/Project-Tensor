   204	enum class Admission { kAdmitted, kClosed, kFinalizing };
   205	
   206	void leave_count(Lifecycle& lc, LifecycleKind k) noexcept {
   207	  lc.in_flight[k].fetch_sub(1, std::memory_order_seq_cst);
   208	  // Take and drop the mutex before notifying: a waiter checks its predicate while holding it, so this leave either
   209	  // happened before that check (seen) or waits until the waiter blocks (then the notify wakes it). No lost wakeup.
   210	  try {
   211	    std::lock_guard<std::mutex> lk(lc.mu);
   212	  } catch (const std::system_error&) {
   213	    g_lifecycle_lock_failures.fetch_add(1, std::memory_order_relaxed);  // never observed; the waiter also polls
   214	  }
   215	  lc.cv.notify_all();
   216	}
   217	
   218	Admission admit(LifecycleKind k) noexcept {
   219	  if (!interpreter_accepts_python()) return Admission::kFinalizing;
   220	  Lifecycle& lc = lifecycle();
   221	  lc.in_flight[k].fetch_add(1, std::memory_order_seq_cst);
   222	  if (lc.closing.load(std::memory_order_seq_cst)) {
   223	    leave_count(lc, k);  // back out: admission closed
   224	    return Admission::kClosed;
   225	  }
   226	  ++t_depth[k];
   227	  g_admitted[k].fetch_add(1, std::memory_order_relaxed);
   228	  return Admission::kAdmitted;
   229	}
   230	
   231	void leave(LifecycleKind k) noexcept {
   232	  --t_depth[k];
   233	  leave_count(lifecycle(), k);
   234	}
