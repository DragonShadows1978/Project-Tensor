    64	
    65	// Reflect pad of the last axis: one thread per output element, a 32-bit word copy.
    66	__global__ void reflection_pad1d_kernel(const uint32_t* __restrict__ x, uint32_t* __restrict__ y, int64_t total,
    67	                                        int64_t T, int64_t T_out, int64_t pad_begin) {
    68	  for (int64_t i = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; i < total;
    69	       i += static_cast<int64_t>(gridDim.x) * blockDim.x) {
    70	    const int64_t t = i % T_out;
    71	    const int64_t r = i / T_out;
    72	    int64_t s = t - pad_begin;
    73	    if (s < 0)
    74	      s = -s;
    75	    else if (s >= T)
