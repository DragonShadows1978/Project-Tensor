   172	py::tuple to_tuple(const std::vector<int64_t>& v) {
   173	  py::tuple t(v.size());
   174	  for (size_t i = 0; i < v.size(); ++i) t[i] = py::int_(v[i]);
   175	  return t;
   176	}
   177	
   178	// ------------------------------------------------------------------------------------------------ entry points
   179	py::tuple lstm_plan(py::object x, py::object W, py::object R, py::object B, py::object h0, py::object c0,
   180	                    int64_t hidden_size, int64_t direction) {
   181	  drain_completed();
   182	  require_operand(x, "x");
   183	  require_operand(W, "W");
   184	  require_operand(R, "R");
   185	  Peeked X = peek_operand(x, "x", 3);
   186	  Peeked Wp = peek_operand(W, "W", 3);
   187	  Peeked Rp = peek_operand(R, "R", 3);
   188	  Peeked Bp = peek_operand(B, "B", 2);
   189	  Peeked H0 = peek_operand(h0, "initial_h", 3);
   190	  Peeked C0 = peek_operand(c0, "initial_c", 3);
   191	  same_device_peeked({&X, &Wp, &Rp, &Bp, &H0, &C0}, {"x", "W", "R", "B", "initial_h", "initial_c"});
   192	  LstmPlan p = plan_lstm(X.shape, Wp.shape, Rp.shape, Bp.present ? &Bp.shape : nullptr,
   193	                         H0.present ? &H0.shape : nullptr, C0.present ? &C0.shape : nullptr, hidden_size, direction);
   194	  return py::make_tuple(X.capsule.object(), Wp.capsule.object(), Rp.capsule.object(), Bp.capsule.object(),
   195	                        H0.capsule.object(), C0.capsule.object(), to_tuple(p.y_shape), to_tuple(p.state_shape),
   196	                        py::int_(p.scratch_numel), py::int_(p.g.T), py::int_(p.g.N));
   197	}
   198	
   199	void lstm_run(py::object xc, py::object Wc, py::object Rc, py::object Bc, py::object h0c, py::object c0c, py::object Y,
   200	              py::object Y_h, py::object Y_c, py::object scratch, int64_t hidden_size, int64_t direction) {
   201	  drain_completed();
   202	  require_operand(xc, "x");
   203	  require_operand(Wc, "W");
   204	  require_operand(Rc, "R");
   205	  require_operand(Y, "Y");
   206	  require_operand(Y_h, "Y_h");
   207	  require_operand(Y_c, "Y_c");
   208	  require_operand(scratch, "scratch");
   209	  Operand X(xc, "x", 3, false);
   210	  Operand Wo(Wc, "W", 3, false);
   211	  Operand Ro(Rc, "R", 3, false);
   212	  Operand Bo;
   213	  if (!Bc.is_none()) Bo = Operand(Bc, "B", 2, false);
   214	  Operand H0;
   215	  if (!h0c.is_none()) H0 = Operand(h0c, "initial_h", 3, false);
   216	  Operand C0;
   217	  if (!c0c.is_none()) C0 = Operand(c0c, "initial_c", 3, false);
   218	  std::vector<int64_t> bshape, h0shape, c0shape;
   219	  if (Bo.present()) bshape = op_shape(Bo);
   220	  if (H0.present()) h0shape = op_shape(H0);
   221	  if (C0.present()) c0shape = op_shape(C0);
   222	  LstmPlan p = plan_lstm(op_shape(X), op_shape(Wo), op_shape(Ro), Bo.present() ? &bshape : nullptr,
   223	                         H0.present() ? &h0shape : nullptr, C0.present() ? &c0shape : nullptr, hidden_size, direction);
   224	  Operand Yo(to_capsule(Y, "Y", true).handle(), "Y", 4, true);
   225	  expect_shape(Yo, p.y_shape);
   226	  Operand Yh(to_capsule(Y_h, "Y_h", true).handle(), "Y_h", 3, true);
   227	  expect_shape(Yh, p.state_shape);
   228	  Operand Yc(to_capsule(Y_c, "Y_c", true).handle(), "Y_c", 3, true);
   229	  expect_shape(Yc, p.state_shape);
   230	  Operand S(to_capsule(scratch, "scratch", true).handle(), "scratch", 1, true);
   231	  expect_shape(S, {p.scratch_numel});
   232	  const int device = common_device({&X, &Wo, &Ro, &Bo, &H0, &C0, &Yo, &Yh, &Yc, &S});
   233	  // Every written operand must not alias any input nor any other written operand.
   234	  const std::vector<const Operand*> written = {&Yo, &Yh, &Yc, &S};
   235	  const std::vector<const Operand*> inputs = {&X, &Wo, &Ro, &Bo, &H0, &C0};
   236	  for (size_t a = 0; a < written.size(); ++a) {
   237	    for (const Operand* in : inputs) expect_disjoint(*written[a], *in);
   238	    for (size_t b = a + 1; b < written.size(); ++b) expect_disjoint(*written[a], *written[b]);
   239	  }
   240	  // F01: the whole per-call capsule set is one pending entry, released after the last step's launch has run.
   241	  RetainUntilComplete keep(device, {&X, &Wo, &Ro, &Bo, &H0, &C0, &Yo, &Yh, &Yc, &S});
   242	  lstm_forward(device, p.g, X.data(), Wo.data(), Ro.data(), Bo.present() ? Bo.data() : nullptr,
   243	               H0.present() ? H0.data() : nullptr, C0.present() ? C0.data() : nullptr, Yo.data(), Yh.data(), Yc.data(),
   244	               S.data());
   245	}
