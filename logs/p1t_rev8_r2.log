   214	int x_rank(NormKind kind) { return kind == NormKind::kLayer ? -1 : 3; }
   215	
   216	py::tuple norm_plan(NormKind kind, py::object x, py::object scale, py::object bias, int64_t arg, double eps) {
   217	  drain_completed();
   218	  Peek4 X = peek4(x, "x", x_rank(kind), 1, Need::kRequired);
   219	  Peek4 S = peek4(scale, "scale", -1, 1, Need::kOptional);
   220	  Peek4 B = peek4(bias, "bias", -1, 1, Need::kOptional);
   221	  same_device4({{&X, "x"}, {&S, "scale"}, {&B, "bias"}});
   222	  NormPlan p = plan_norm(kind, X.shape, S.present ? &S.shape : nullptr, B.present ? &B.shape : nullptr, arg, eps);
   223	  return py::make_tuple(X.capsule.object(), S.capsule.object(), B.capsule.object(), tuple4(p.out_shape));
   224	}
   225	
   226	void norm_run(NormKind kind, py::object xc, py::object sc, py::object bc, py::object out, int64_t arg, double eps) {
   227	  drain_completed();
   228	  require_operand(out, "out");
   229	  Operand X = consume4(xc, "x", x_rank(kind), 1, Need::kRequired);
   230	  Operand S = consume4(sc, "scale", -1, 1, Need::kOptional);
   231	  Operand B = consume4(bc, "bias", -1, 1, Need::kOptional);
   232	  std::vector<int64_t> sshape, bshape;
   233	  if (S.present()) sshape = shape4(S);
   234	  if (B.present()) bshape = shape4(B);
   235	  NormPlan p = plan_norm(kind, shape4(X), S.present() ? &sshape : nullptr, B.present() ? &bshape : nullptr, arg, eps);
   236	  Operand Y(to_capsule(out, "out", true).handle(), "out", X.ndim(), true);
   237	  expect_shape(Y, p.out_shape);
   238	  const int device = common_device({&X, &S, &B, &Y});
   239	  for (const Operand* in : {&X, &S, &B}) expect_disjoint(Y, *in);
   240	  RetainUntilComplete keep(device, {&X, &S, &B, &Y});  // F01: deleters run after the legacy stream passes the launch
   241	  row_norm_forward(device, p.g, X.data(), S.present() ? S.data() : nullptr, B.present() ? B.data() : nullptr,
   242	                   Y.data());
   243	}
