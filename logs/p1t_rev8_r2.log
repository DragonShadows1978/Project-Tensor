    54	// y[r, i] = x[r, i / scale]: one thread per output element, a 32-bit word copy.
    55	__global__ void upsample_nearest1d_kernel(const uint32_t* __restrict__ x, uint32_t* __restrict__ y, int64_t total,
    56	                                          int64_t T, int64_t T_out, int64_t scale) {
    57	  for (int64_t i = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; i < total;
    58	       i += static_cast<int64_t>(gridDim.x) * blockDim.x) {
    59	    const int64_t t = i % T_out;
    60	    const int64_t r = i / T_out;
    61	    y[i] = x[r * T + t / scale];
    62	  }
