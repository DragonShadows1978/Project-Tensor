   390	// the legacy stream too (nothing to do); -1 = no synchronization; 2 = the
   391	// per-thread default stream; > 2 = a cudaStream_t. For 2 and handles, record
   392	// an event on the legacy stream and make the consumer wait on it.
   393	//
   394	// P1T-FIX4, round-4 review finding V4-01 (MAJOR). 62c8d9f created and recorded
   395	// the event on the CURRENT device: with device 1 current, a device-0 tensor's
   396	// consumer waited on device 1's legacy stream, and the device-0 writes were not
   397	// ordered. Now the fence runs on THE TENSOR'S DEVICE (`device`, a label that
   398	// tensor_dlpack has proven against the allocation, cuda_storage_device_mismatch):
   399	//  * the caller's device is read (checked) and, if it differs, `device` is made
   400	//    current (checked); then the event is created, recorded on the legacy
   401	//    stream (of `device` now), the consumer's stream waits on it, the event is
   402	//    destroyed on its own device, and the caller's device is restored;
   403	//  * every return is checked; on any failure the caller's device is restored
   404	//    FIRST, the failed calls' slot entry is consumed, and one RuntimeError names
   405	//    each failed step (and says whether the restore itself failed);
   406	//  * the wait is issued with `device` current, so stream=2 means the per-thread
   407	//    default stream of the tensor's device. That matches PyTorch 2.11's DLPack
   408	//    consumer, which passes the current stream OF THE TENSOR'S DEVICE
   409	//    (torch.utils.dlpack.from_dlpack: torch.cuda.current_stream(f'cuda:{ext_device[1]}'),
   410	//    read in the installed package). A handle (> 2) may belong to any device:
   411	//    CUDA 12.6 cudaStreamWaitEvent: "event may be from a different device than
   412	//    stream" (cuda_runtime_api.h); Programming Guide 3.2.9.3: "cudaStreamWaitEvent()
   413	//    will succeed even if the input stream and input event are associated to
   414	//    different devices", while "cudaEventRecord() will fail if the input event and
   415	//    input stream are associated to different devices", which is why creation and
   416	//    record need the tensor's device current (receipt artifacts/p1t_fix4/cuda_doc_quotes.txt).
   417	// No device-wide sync is added (one event, as before).
   418	// Prior art: PyTorch's scoped c10::cuda::CUDAGuard and CuPy's cupy.cuda.Device
   419	// context (switch, act, restore); PyTorch's CUDAEvent destroys an event on its
   420	// creating device ("to avoid creating a CUDA context on other devices",
   421	// c10/cuda/CUDAEvent.h, torch 2.11 headers). PyTorch 2.11's own Tensor.__dlpack__
   422	// does NOT switch: it refuses a current-device mismatch with BufferError
   423	// (torch/_tensor.py). The order chose the guard (switch, record, restore). Taken:
   424	// the scoped guard and destroy-on-own-device. Ours: placing the whole fence,
   425	// consumer wait included, inside the guard, and restore-before-raise.
   426	// P1T-FIX6 (V6-02): `stream` arrives already read by DlpackArgs (None -> has_stream false; an int's value): this
   427	// function calls no Python at all.
   428	void dlpack_fence_consumer(bool has_stream, long long s, int device) {
   429	  if (!has_stream) return;
   430	  if (s == -1 || s == 1) return;
   431	  if (s == 0)
   432	    throw py::value_error(
   433	        "__dlpack__: stream=0 is ambiguous for CUDA under the DLPack protocol; "
   434	        "use None or 1 (legacy default stream), 2 (per-thread default stream) "
   435	        "or a cudaStream_t handle");
   436	  if (s < -1) throw py::value_error("__dlpack__: invalid stream " + std::to_string(s));
   437	  cudaStream_t consumer =
   438	      (s == 2) ? cudaStreamPerThread
   439	               : reinterpret_cast<cudaStream_t>(static_cast<uintptr_t>(s));
   440	  const std::string dev = std::to_string(device);
   441	  auto name = [](cudaError_t err) {
   442	    return std::string(cudaGetErrorName(err)) + ": " + cudaGetErrorString(err);
   443	  };
   444	  int prev = -1;
   445	  cudaError_t e = cudaGetDevice(&prev);
   446	  if (e != cudaSuccess) {
   447	    cudaGetLastError();
   448	    throw std::runtime_error("__dlpack__: stream fence: cudaGetDevice failed (" + name(e) +
   449	                             "); nothing was switched or recorded");
   450	  }
   451	  const bool switched = (prev != device);
   452	  if (switched) {
   453	    e = cudaSetDevice(device);
   454	    if (e != cudaSuccess) {
   455	      cudaGetLastError();
   456	      throw std::runtime_error("__dlpack__: stream fence: cannot make the tensor's CUDA device " + dev +
   457	                               " current (cudaSetDevice: " + name(e) + "); the caller's device " +
   458	                               std::to_string(prev) + " is unchanged and nothing was recorded");
   459	    }
   460	  }
   461	  // `device` is current from here until the restore below.
   462	  cudaEvent_t ev = nullptr;
   463	  const char* step = "cudaEventCreateWithFlags";
   464	  e = cudaEventCreateWithFlags(&ev, cudaEventDisableTiming);
   465	  if (e == cudaSuccess) {
   466	    step = "cudaEventRecord on the legacy stream";
   467	    e = cudaEventRecord(ev, cudaStreamLegacy);  // engine stream of `device`
   468	  }
   469	  if (e == cudaSuccess) {
   470	    step = "cudaStreamWaitEvent on the consumer's stream";
   471	    e = cudaStreamWaitEvent(consumer, ev, 0);
   472	  }
   473	  // Safe right after the wait is enqueued: the dependency is captured at the
   474	  // cudaStreamWaitEvent call and the runtime frees the event once it fires.
   475	  const cudaError_t de = ev ? cudaEventDestroy(ev) : cudaSuccess;  // on its own device
   476	  const cudaError_t re = switched ? cudaSetDevice(prev) : cudaSuccess;
   477	  if (e == cudaSuccess && de == cudaSuccess && re == cudaSuccess) return;
   478	  cudaGetLastError();  // the failed calls are reported by the raise below
   479	  std::string msg = "__dlpack__: stream fence on the tensor's CUDA device " + dev + " failed:";
   480	  if (e != cudaSuccess) msg += std::string(" ") + step + " (" + name(e) + ");";
   481	  if (de != cudaSuccess) msg += " cudaEventDestroy (" + name(de) + ");";
   482	  if (re != cudaSuccess)
   483	    msg += " restoring the caller's CUDA device " + std::to_string(prev) + " also failed (cudaSetDevice: " + name(re) +
   484	           "), so the calling thread's current device is still " + dev;
   485	  else if (switched)
   486	    msg += " the caller's CUDA device " + std::to_string(prev) + " was restored";
   487	  throw std::runtime_error(msg);
   488	}
   489	
   490	// P1T-FIX6, round-6 review finding V6-02 (MAJOR; FIX5's residual R3). tensor_dlpack converted its arguments with
   491	// pybind11 casts that run the argument's own Python methods: copy.cast<bool>() calls __bool__, dl_device /
   492	// max_version .cast<py::sequence>() + py::len() + item .cast<int>() call __len__, __getitem__ / __iter__ and __index__,
   493	// and stream.cast<long long>() may fall back to __int__. That user Python ran on this native stack. On a daemon thread
   494	// whose method released the GIL across the start of interpreter finalization, CPython 3.12 exits the thread when it
   495	// re-takes the GIL (pthread_exit, a forced unwind); the unwind deallocated the pybind11 dispatcher's private kwargs
   496	// copy with the thread's state already freed: SIGSEGV (core_cast_exit_gpu.py bool|index rc 139 on acd42fa and
   497	// 1475fae; gdb receipt artifacts/p1t_fix6). Core's exit hook could not see it (it waits only for import releases).
   498	// Choice: option (ii) of the review, REFUSE before invoking anything, rather than (i) admit and wait at exit:
   499	//  * (ii) adds no wait and no lock (sweep (h): no new place where an exit can hang), and leaves no user Python in a
   500	//    native frame at all, so there is nothing for the exit hook to coordinate;
   501	//  * every real consumer passes plain values (torch 2.11 from_dlpack: stream an int, max_version (1, 0), dl_device a
   502	//    tuple of ints from torch._C._torchDeviceToDLDevice, copy a bool or absent -- read in the installed torch; tc_signal:
   503	//    stream=1, max_version=(1, 3), copy=False; tensor_cuda.from_dlpack: stream=1, max_version=(1, 3)), all accepted;
   504	//  * (i) would make interpreter exit wait for arbitrary user __bool__/__index__ code (sweep (h): a new exit wait that
   505	//    any user method can extend) for no consumer that needs it.
   506	// Accepted argument types, each read with C-level calls that never call a Python method of the argument:
   507	//  * stream: None, or an int (int, bool, int subclasses such as IntEnum: PyLong_AsLongLongAndOverflow reads a
   508	//    PyLong_Check object's value directly, CPython 3.12 Objects/longobject.c); out of the int64 range -> ValueError;
   509	//  * max_version: None, or a tuple or list (PyTuple_GET_SIZE / PyList_GET_ITEM, which ignore a subclass's __len__ /
   510	//    __getitem__) of length >= 1 whose first item (the major version, the only item read, as before) is an int;
   511	//  * dl_device: None, or a tuple or list of exactly 2 ints (IntEnum device types accepted: torch annotates dl_device
   512	//    as tuple[IntEnum, int]);
   513	//  * copy: None, a bool, or an int (nonzero = true, read as above). Anything else, numpy.bool_ included, is refused:
   514	//    reading it needs its type's nb_bool, and recognising numpy's bool by type name is spoofable by any class named
   515	//    "numpy.bool" (pybind11's is_numpy_bool); the array API types copy as bool | None.
   516	// Every other type raises TypeError naming the argument and the type (tp_name), before anything else happens: no repr,
   517	// no __str__. The pybind11 binding of __dlpack__ itself takes (*args, **kwargs) (PYBIND11_MODULE below), so neither
   518	// the dispatcher nor a mismatch message runs Python either.
   519	// Prior art: PyTorch 2.11 Tensor.__dlpack__ (`if stream is not None and type(stream) is not int: raise
   520	// TypeError("stream must be ``int`` or ``none``")`, read in the installed torch/_tensor.py) refuses instead of converting;
   521	// the Python array API __dlpack__ signature (Consortium for Python Data API Standards, 2021-2023); CPython 3.12's
   522	// PyLong_AsLongLongAndOverflow / PyTuple_GET_ITEM contracts. Taken: refusal of non-int / non-tuple arguments. Ours:
   523	// the int-subclass and list acceptance read at C level, the numpy.bool_ refusal argument, and refusing for every
   524	// argument of every P1-T binding (sweep (g)).
   525	namespace {
   526	[[noreturn]] void dlpack_refuse_arg(const char* arg, const char* expected, PyObject* o) {
   527	  throw py::type_error(std::string("__dlpack__: ") + arg + " must be " + expected + ", not " + Py_TYPE(o)->tp_name +
   528	                       " (P1T-FIX6: refused without calling any of its Python methods)");
   529	}
   530	// An int argument's value, read without calling Python; `overflow` is -1 / +1 beyond the int64 range.
   531	long long dlpack_int(PyObject* o, int* overflow) {
   532	  *overflow = 0;
   533	  const long long v = PyLong_AsLongLongAndOverflow(o, overflow);
   534	  if (v == -1 && *overflow == 0 && PyErr_Occurred()) throw py::error_already_set();  // not reached for a PyLong
   535	  return v;
   536	}
   537	// A tuple's or list's size and items with the C macros (a subclass's __len__ / __getitem__ is never called).
   538	Py_ssize_t dlpack_seq_size(PyObject* o) { return PyTuple_Check(o) ? PyTuple_GET_SIZE(o) : PyList_GET_SIZE(o); }
   539	PyObject* dlpack_seq_item(PyObject* o, Py_ssize_t i) {
   540	  return PyTuple_Check(o) ? PyTuple_GET_ITEM(o, i) : PyList_GET_ITEM(o, i);
   541	}
   542	}  // namespace
   543	
   544	py::object tensor_dlpack(Tensor& t, py::object stream, py::object max_version,
   545	                         py::object dl_device, py::object copy) {
   546	  // P1T-FIX6 (V6-02): read every argument first, with C-level calls only (see above).
   547	  bool has_stream = false;
   548	  long long stream_value = 0;
   549	  if (!stream.is_none()) {
   550	    if (!PyLong_Check(stream.ptr())) dlpack_refuse_arg("stream", "an int or None", stream.ptr());
   551	    int of = 0;
   552	    stream_value = dlpack_int(stream.ptr(), &of);
   553	    if (of != 0) throw py::value_error("__dlpack__: invalid stream (beyond the 64-bit range)");
   554	    has_stream = true;
   555	  }
   556	  bool versioned = false;
   557	  if (!max_version.is_none()) {
   558	    PyObject* mv = max_version.ptr();
   559	    if (!PyTuple_Check(mv) && !PyList_Check(mv))
   560	      dlpack_refuse_arg("max_version", "None or a (major, minor) tuple of ints", mv);
   561	    if (dlpack_seq_size(mv) < 1)
   562	      throw py::value_error("__dlpack__: max_version must be a (major, minor) pair");
   563	    PyObject* major = dlpack_seq_item(mv, 0);
   564	    if (!PyLong_Check(major)) dlpack_refuse_arg("max_version[0] (the major version)", "an int", major);
   565	    int of = 0;
   566	    const long long mj = dlpack_int(major, &of);
   567	    versioned = of > 0 || (of == 0 && mj >= 1);
   568	  }
   569	  bool has_dl_device = false;
   570	  long long dl_type = 0, dl_id = 0;
   571	  if (!dl_device.is_none()) {
   572	    PyObject* d = dl_device.ptr();
   573	    if (!PyTuple_Check(d) && !PyList_Check(d))
   574	      dlpack_refuse_arg("dl_device", "None or a (device_type, device_id) tuple of ints", d);
   575	    if (dlpack_seq_size(d) != 2)
   576	      throw py::value_error("__dlpack__: dl_device must be a (device_type, device_id) pair");
   577	    PyObject* d0 = dlpack_seq_item(d, 0);
   578	    PyObject* d1 = dlpack_seq_item(d, 1);
   579	    if (!PyLong_Check(d0)) dlpack_refuse_arg("dl_device[0] (the device type)", "an int", d0);
   580	    if (!PyLong_Check(d1)) dlpack_refuse_arg("dl_device[1] (the device id)", "an int", d1);
   581	    int of0 = 0, of1 = 0;
   582	    dl_type = dlpack_int(d0, &of0);
   583	    dl_id = dlpack_int(d1, &of1);
   584	    if (of0 != 0 || of1 != 0)
   585	      throw py::value_error("__dlpack__: dl_device entries must fit in 64-bit integers");
   586	    has_dl_device = true;
   587	  }
   588	  bool want_copy = false;
   589	  if (!copy.is_none()) {
   590	    PyObject* c = copy.ptr();
   591	    if (c == Py_True || c == Py_False) {
   592	      want_copy = (c == Py_True);
   593	    } else if (PyLong_Check(c)) {
   594	      int of = 0;
   595	      const long long v = dlpack_int(c, &of);
   596	      want_copy = of != 0 || v != 0;
   597	    } else {
   598	      dlpack_refuse_arg("copy", "None or a bool", c);
   599	    }
   600	  }
   601	  if (!t.defined() || !t.data().defined())
   602	    throw py::buffer_error("__dlpack__: undefined tensor");
   603	  const NDArray& a = t.data();
   604	  if (!a.device.is_cuda())
   605	    throw py::buffer_error(
   606	        "__dlpack__: TensorCUDA exports CUDA tensors only; this tensor is on "
   607	        "cpu (CPU DLPack export is not supported)");
   608	  if (want_copy)
   609	    throw py::buffer_error(
   610	        "__dlpack__: copy=True is not supported; TensorCUDA exports zero-copy "
   611	        "only (pass copy=None or copy=False)");
   612	  if (has_dl_device && (dl_type != kDLCUDA || dl_id != a.device.index))
   613	    throw py::buffer_error(
   614	        "__dlpack__: dl_device=(" + std::to_string(dl_type) + ", " +
   615	        std::to_string(dl_id) + ") differs from this tensor's device (2, " +
   616	        std::to_string(a.device.index) +
   617	        "); a cross-device export needs a copy, which TensorCUDA does not make");
   618	  // P1T-FIX2, N2: a tensor whose shape breaks the zero-extent rule (reachable through reshape of an empty tensor, e.g.
   619	  // empty((0,)).reshape([0, 2**62, 4])) cannot be described with int64 strides: refused (ValueError) before the
   620	  // consumer fence and before contiguous_strides forms them.
   621	  {
   622	    const int64_t n_ex = checked_numel(a.shape.data(), a.ndim(), "__dlpack__");
   623	    checked_nbytes(n_ex, dtype_size(a.dtype), a.shape.data(), a.ndim(), "__dlpack__");
   624	  }
   625	
   626	  // P1T-FIX4 (V4-01 and the device sweep): the device this export publishes (dl.device_id below) and fences on is the
   627	  // tensor's label, proven first against the allocation of element 0 (kernels.cu cuda_storage_device_mismatch:
   628	  // cudaPointerGetAttributes). A mismatch, which the engine's cuda:0 labeling produces for a tensor it allocated while
   629	  // another device was current, is refused (BufferError) before any fence or capsule; it would otherwise describe the
   630	  // memory with the wrong device and fence the wrong device's stream (the V4-01 race again).
   631	  {
   632	    const std::string mismatch = cuda_storage_device_mismatch(a, "__dlpack__");
   633	    if (!mismatch.empty()) throw py::buffer_error(mismatch);
   634	  }
   635	  dlpack_fence_consumer(has_stream, stream_value, a.device.index);
   636	
   637	  // P1T-FIX1, F06: the context (and its shared Storage reference) is owned by a unique_ptr until the capsule takes it,
   638	  // so a throw anywhere below (bad_alloc in the vector assignments, a failed PyCapsule_New) frees it exactly once.
   639	  // Prior art: C++ RAII (Stroustrup) and std::unique_ptr's release() hand-off (C++11); pybind11/CPython capsule
   640	  // ownership. Nothing new.
   641	  auto ctx = std::make_unique<DLPackExportCtx>();
   642	  ctx->owner = a.storage;
   643	  ctx->shape.assign(a.shape.begin(), a.shape.end());
   644	  Shape st = contiguous_strides(a.shape);
   645	  ctx->strides.assign(st.begin(), st.end());
   646	  const int nd = a.ndim();
   647	  DLTensor dl{};
   648	  dl.data = a.storage->ptr;  // allocation base; element 0 is data + byte_offset
   649	  dl.byte_offset = static_cast<uint64_t>(a.offset) * dtype_size(a.dtype);
   650	  dl.device.device_type = kDLCUDA;
   651	  dl.device.device_id = a.device.index;
   652	  dl.ndim = nd;
   653	  dl.dtype = to_dl_dtype(a.dtype);
   654	  dl.shape = nd ? ctx->shape.data() : nullptr;
   655	  dl.strides = nd ? ctx->strides.data() : nullptr;
   656	
   657	  PyObject* cap = nullptr;
   658	  if (versioned) {
   659	    DLManagedTensorVersioned& mt = ctx->versioned;
   660	    mt.version.major = DLPACK_MAJOR_VERSION;
   661	    mt.version.minor = DLPACK_MINOR_VERSION;
   662	    mt.manager_ctx = ctx.get();
   663	    mt.deleter = export_deleter_versioned;
   664	    mt.flags = 0;
   665	    mt.dl_tensor = dl;
   666	    cap = PyCapsule_New(&mt, kCapVersioned, capsule_destructor_versioned);
   667	  } else {
   668	    DLManagedTensor& mt = ctx->legacy;
   669	    mt.dl_tensor = dl;
   670	    mt.manager_ctx = ctx.get();
   671	    mt.deleter = export_deleter_legacy;
   672	    cap = PyCapsule_New(&mt, kCapLegacy, capsule_destructor_legacy);
   673	  }
   674	  if (!cap) throw py::error_already_set();  // ctx is freed by its unique_ptr
   675	  ctx.release();  // owned by the capsule from here: its destructor, or the consumer's deleter call, frees it
   676	  return py::reinterpret_steal<py::object>(cap);
   677	}
   678	
   679	py::tuple tensor_dlpack_device(Tensor& t) {
   680	  if (!t.defined() || !t.device().is_cuda())
   681	    throw py::buffer_error(
   682	        "__dlpack_device__: TensorCUDA exports CUDA tensors only; this tensor "
   683	        "is on cpu");
   684	  return py::make_tuple(static_cast<int>(kDLCUDA), t.device().index);
   685	}
   686	
   687	// ---- import: the Storage keeps the producer's manager alive; its destructor
   688	// drains the Storage device's engine stream (kernels.cu) and then calls this,
   689	// which calls the producer's deleter with the GIL held.
   690	//
   691	// P1T-FIX1, F04 (finalization-safe release). The last reference can die on any
   692	// thread, including a non-Python thread while CPython is finalizing. Once
   693	// finalization has started (or the interpreter is gone), PyGILState_Ensure is
   694	// unsafe: CPython 3.12 terminates a non-main thread that tries to take the GIL
   695	// during finalization (in the middle of this deleter), and newer runtimes may
   696	// hang it. So in that state this function does NOT call PyGILState_Ensure and
   697	// DELIBERATELY LEAKS the producer's manager (the memory is not handed back; the
   698	// process is exiting). Ordinary releases are unchanged.
   699	// Detection: Py_IsInitialized() plus Py_IsFinalizing() (3.13+) / the exported
   700	// _Py_IsFinalizing() (3.12). Measured on CPython 3.12.3 (P1T_FIX1 ledger): during
   701	// module teardown Py_IsInitialized() is already 0 and _Py_IsFinalizing() is 1,
   702	// because 3.12 clears `initialized` when it sets the finalizing thread; the
   703	// explicit finalizing test keeps this correct if a runtime orders those two
   704	// stores differently. FIX1's residual (a thread that passed this test an instant
   705	// before finalization started could still reach PyGILState_Ensure) is closed by
   706	// P1T-FIX2 N5 below.
   707	// Prior art: the CPython 3.12 C-API docs (Initialization, Finalization, and
   708	// Threads: PyGILState_Ensure / Py_IsFinalizing, "calling this function from a
   709	// thread when the runtime is finalizing will terminate the thread"); pybind11's
   710	// guidance not to touch the GIL during interpreter shutdown. Taken: the rule.
   711	// Ours: the deliberate-leak policy at this call site and its counters.
   712	//
   713	// P1T-FIX2, review finding N5 (lifecycle coordination). The check above and
   714	// PyGILState_Ensure were not atomic with respect to the start of finalization: a
   715	// foreign thread could pass the check, the main thread could then reach
   716	// Py_FinalizeEx and mark the runtime finalizing, and the foreign thread's
   717	// PyGILState_Ensure would then run PyThread_exit_thread (CPython 3.12.3
   718	// ceval_gil.c take_gil -> _PyThreadState_MustExit), whose forced unwind through
   719	// the noexcept Storage destructor is std::terminate (FIX1 mutant (e): rc -6).
   720	// Closed with an admission protocol under one mutex (ImportReleaseLifecycle):
   721	//  * a releasing thread takes the mutex, checks `closing` (and, second line of
   722	//    defence, interpreter_accepts_gil_state()), and only then increments
   723	//    `in_flight`; it calls PyGILState_Ensure WITHOUT the mutex, runs the deleter,
   724	//    calls PyGILState_Release, and only after that decrements `in_flight` under
   725	//    the mutex and notifies. A release that finds `closing` set leaks (counted).
   726	//  * tensor_cuda registers a Python atexit callback (`_dlpack_shutdown_hook` in
   727	//    tensor_cuda/__init__.py) that calls dlpack_begin_shutdown: with the GIL
   728	//    RELEASED (in-flight releases need it to finish) it sets `closing` under the
   729	//    mutex and waits on a condition variable until `in_flight` is 0 (FIX2 bounded
   730	//    this wait by a timeout; P1T-FIX3 V3-01 below removed the bound).
   731	//  * Ordering (verified in CPython v3.12.3 Python/pylifecycle.c, Py_FinalizeEx):
   732	//    _PyAtExit_Call (line 1815) runs every atexit callback BEFORE
   733	//    _PyInterpreterState_SetFinalizing / _PyRuntimeState_SetFinalizing (1832-1833)
   734	//    and before runtime->initialized = 0 (1834). So once the hook has returned
   735	//    with in_flight == 0, no thread is between admission and PyGILState_Release,
   736	//    and every later release leaks without touching the GIL; nothing can call
   737	//    PyGILState_Ensure after the finalizing flag is set.
   738	//  * Lock order: no thread ever waits for the GIL while holding the mutex (the
   739	//    hook drops the mutex before re-taking the GIL; releasers never call Python
   740	//    under it), so the protocol cannot deadlock with the GIL.
