   456	  if (t->ndim < 0) {
   457	    std::ostringstream os;
   458	    os << "negative number of dimensions " << t->ndim;
   459	    refuse_value(role, os.str());
   460	  }
   461	  if (t->ndim > 0 && t->shape == nullptr) refuse_value(role, "NULL shape array for a tensor with dimensions");
   462	  if (t->ndim != ndim) {
   463	    std::ostringstream os;
   464	    os << "expected " << ndim << " dimensions, got " << t->ndim;
   465	    refuse_value(role, os.str());
   466	  }
   467	  // F03: checked element count and fp32 byte total, before the stride walk below multiplies extents and before any
   468	  // later byte range is formed.
   469	  // P1T-FIX2, review finding N2 (zero-extent rule, checked_math.h ck_extent_bound): EVERY extent is multiplied (a zero
   470	  // or negative one counted as 1) BEFORE the empty-operand refusal, so a shape such as [0, 2^62, 4] is refused as an
   471	  // overflow, never waved through because its count is 0. Prior art: NumPy's array constructor rule (see
   472	  // checked_math.h); the checked builtins (GCC 5, 2015).
   473	  int64_t numel = 1;
   474	  for (int i = 0; i < t->ndim; ++i) {
   475	    if (__builtin_mul_overflow(numel, t->shape[i] > 1 ? t->shape[i] : int64_t{1}, &numel))
   476	      refuse_value(role, "element count of shape " + shape_str(shape_of(t)) +
   477	                             " overflows int64 (every nonzero extent counts, also next to a zero extent)");
   478	  }
   479	  int64_t nbytes = 0;
   480	  if (__builtin_mul_overflow(numel, static_cast<int64_t>(sizeof(float)), &nbytes))
   481	    refuse_value(role, "byte size of shape " + shape_str(shape_of(t)) + " (fp32) overflows int64");
   482	  for (int i = 0; i < t->ndim; ++i)
   483	    if (t->shape[i] <= 0) refuse_value(role, "empty operand (shape " + shape_str(shape_of(t)) + ")");
   484	  // Every extent is >= 1 from here: numel is the element count and nbytes its fp32 byte size.
   485	  if (t->strides != nullptr) {
   486	    // C-contiguous: every dimension of extent > 1 has the compact stride; size-1 dimensions may carry any stride
   487	    // (they are never stepped), as the order and the DLPack/array API conventions allow.
   488	    int64_t want = 1;
   489	    for (int i = t->ndim - 1; i >= 0; --i) {
   490	      if (t->shape[i] != 1 && t->strides[i] != want) {
   491	        std::ostringstream os;
   492	        os << "not C-contiguous (shape " << shape_str(shape_of(t)) << ", strides [";
   493	        for (int j = 0; j < t->ndim; ++j) os << (j ? ", " : "") << t->strides[j];
   494	        os << "]); pass a contiguous tensor";
   495	        refuse_value(role, os.str());
   496	      }
   497	      want *= t->shape[i];
   498	    }
   499	  }
   500	  if (t->data == nullptr) refuse_value(role, "NULL data pointer");
   501	  // F03: data + byte_offset (element 0) and element 0 + nbytes (one past the end) must not wrap the address space.
   502	  uintptr_t p = 0;
   503	  uintptr_t end = 0;
   504	  if (__builtin_add_overflow(reinterpret_cast<uintptr_t>(t->data), static_cast<uintptr_t>(t->byte_offset), &p) ||
   505	      __builtin_add_overflow(p, static_cast<uintptr_t>(nbytes), &end))
