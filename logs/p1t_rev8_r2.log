   866	      error();
   867	      os << ")";
   868	      return;
   869	    case Purpose::kDestroyEvent:
   870	      if (guard_call) {
   871	        os << "a completion event of device " << r.device << " was not destroyed: ";
   872	        break;
   873	      }
   874	      os << "cudaEventDestroy on device " << r.device << " (";
   875	      error();
   876	      os << ")";
   877	      return;
   878	    case Purpose::kRestoreDevice:
   879	      os << "restoring the caller's CUDA device (cudaSetDevice) on device " << r.device << " (";
   880	      error();
   881	      os << ")";
   882	      return;
   883	    case Purpose::kUnnamed:
   884	      os << "a CUDA failure whose call and device were not recorded (";
   885	      error();
