    75	# P1T-M1 (Project-Voice T1): DLPack import. Prior art: the Python array API
    76	# standard's from_dlpack (Consortium for Python Data API Standards, 2021-2023)
    77	# and the PyTorch/CuPy importers' owner keepalive (the imported tensor keeps the
    78	# producer's DLPack manager alive and calls its deleter when it dies); the
    79	# versioned-then-legacy retry mirrors torch.utils.dlpack.from_dlpack. Ours: the
    80	# TensorCUDA wiring (bindings.cpp, kernels.cu Storage).
    81	_DLPACK_MAX_VERSION = (1, 3)   # the vendored dlpack.h (include/dlpack/dlpack.h)
    82	_DLPACK_LEGACY_STREAM = 1      # DLPack int for the CUDA legacy default stream
    83	_KDL_CUDA = 2
    84	
    85	
    86	def from_dlpack(obj):
    87	    """Zero-copy import of any DLPack CUDA producer (or a bare DLPack capsule).
    88	
    89	    For an object with ``__dlpack__`` this calls
    90	    ``obj.__dlpack__(stream=1, max_version=(1, 3))`` (retrying without
    91	    ``max_version`` for a producer that predates it). ``stream=1`` names the
    92	    consumer stream, TensorCUDA's legacy default stream, so the producer orders
    93	    that stream after its own pending work before handing the capsule over.
    94	    A bare capsule carries no stream information: the caller must already have
    95	    ordered the producer's work.
    96	
    97	    The result aliases the producer's memory (``data_ptr()`` is the producer's
    98	    element 0) and keeps the producer's DLPack manager alive. When the last
    99	    TensorCUDA reference to that memory dies, TensorCUDA first drains its own
   100	    stream on the memory's device (switching to that device if another one is
   101	    current, then restoring the caller's device), so no queued TensorCUDA
   102	    kernel can still touch the memory, and then calls the producer's deleter
   103	    with the GIL held. If that drain fails (a broken CUDA context), or the
   104	    last reference dies while the interpreter is finalizing, the deleter is
   105	    deliberately NOT called: the manager is leaked rather than risk a
   106	    use-after-free or a GIL acquisition during shutdown (P1T-FIX1 F04/F05).
   107	    Interpreter exit (P1T-FIX2 N5, P1T-FIX3 V3-01): an atexit hook stops
   108	    admitting such releases and waits, GIL released and with NO time bound,
   109	    until every release already admitted has finished (a release normally
   110	    takes microseconds); ``_DLPACK_SHUTDOWN_WAIT_S`` is only the delay before
   111	    the first stderr diagnostic, and another follows each time the time waited
   112	    doubles (P1T-FIX7: whatever that knob holds, an unusable value or none at
   113	    all, the close and the wait still happen; see ``_dlpack_shutdown_hook``). So a producer deleter that never returns makes interpreter exit
   114	    wait for it (Ctrl-C does not interrupt that wait; SIGTERM / SIGKILL end the
   115	    process). Every release that starts after the hook leaks (counted) without
   116	    touching the GIL. A producer deleter that raises a C++ exception is
   117	    contained and counted (P1T-FIX2 N4).
   118	    The memory is never returned to TensorCUDA's pool and never
   119	    ``cudaFree``-d by TensorCUDA.
   120	
   121	    Refused with ``RuntimeError`` (P1T-FIX4 V4-03), before the capsule is
   122	    consumed: the current-device query ``cudaGetDevice`` fails (for example no
   123	    usable CUDA device); the producer keeps ownership.
   124	    Refused with ``BufferError``, never converted: non-CUDA devices (CPU
   125	    included), another CUDA device than TensorCUDA's, non-contiguous strides
   126	    (a size-1 dimension may carry any stride), read-only tensors, and dtypes
   127	    with no exact TensorCUDA match (supported: float32, float16, bfloat16,
   128	    int64, uint8, bool). Refused with ``ValueError``: an element count, byte
   129	    size, ``byte_offset`` + size or address range that overflows 64-bit
   130	    arithmetic (P1T-FIX1 F03), counting every nonzero extent also when another
   131	    extent is 0 (P1T-FIX2 N2: ``[0, 2**62, 4]`` is refused, not an empty
   132	    tensor); ``TypeError``: anything that is neither a DLPack
   133	    producer nor a capsule (``None`` included). The result has
   134	    ``requires_grad=False``. If anything outside TensorCUDA later writes into
   135	    it in place, call ``mark_modified()`` (see ``Tensor.__dlpack__``).
   136	    """
   137	    if not hasattr(obj, "__dlpack__"):
   138	        return _C._from_dlpack_capsule(obj)   # bare capsule (TypeError otherwise)
   139	    dev = getattr(obj, "__dlpack_device__", None)
   140	    if dev is not None:
   141	        dev_type, dev_id = dev()
   142	        if int(dev_type) != _KDL_CUDA:
   143	            raise BufferError(
   144	                f"from_dlpack: only CUDA device memory (kDLCUDA = 2) can be "
   145	                f"imported; the producer reports device ({int(dev_type)}, "
   146	                f"{int(dev_id)})" + (" (CPU)" if int(dev_type) == 1 else ""))
   147	    try:
   148	        cap = obj.__dlpack__(stream=_DLPACK_LEGACY_STREAM,
   149	                             max_version=_DLPACK_MAX_VERSION)
   150	    except TypeError:
   151	        cap = obj.__dlpack__(stream=_DLPACK_LEGACY_STREAM)
   152	    return _C._from_dlpack_capsule(cap)
   153	
