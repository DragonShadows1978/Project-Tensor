   132	
   133	// Optional operands only (B, initial_h, initial_c); required ones go through require_operand first.
   134	Peeked peek_operand(py::handle obj, const char* role, int ndim) {
   135	  Peeked p;
   136	  if (obj.is_none()) {
   137	    p.capsule = CapsuleRef(py::none());
   138	    return p;
   139	  }
   140	  p.capsule = to_capsule(obj, role, false);
   141	  const DLTensor* t = peek(p.capsule.handle(), role);
   142	  validate_tensor(t, role, ndim);
   143	  p.shape = shape_of(t);
   144	  p.device = t->device.device_id;
   145	  p.present = true;
   146	  return p;
   147	}
   148	
   149	void same_device_peeked(const std::vector<const Peeked*>& ps, const std::vector<const char*>& roles) {
   150	  int dev = -1;
   151	  const char* first = "";
   152	  for (size_t i = 0; i < ps.size(); ++i) {
   153	    if (!ps[i]->present) continue;
   154	    if (dev < 0) {
   155	      dev = ps[i]->device;
   156	      first = roles[i];
   157	    } else if (ps[i]->device != dev) {
   158	      std::ostringstream os;
   159	      os << "tc_signal: operand '" << roles[i] << "': on CUDA device " << ps[i]->device << " but operand '" << first
   160	         << "' is on CUDA device " << dev << "; every operand must be on the same device";
   161	      throw py::value_error(os.str());
   162	    }
   163	  }
   164	}
