   597	Operand::Operand(py::handle capsule, const char* role, int ndim, bool writable) : role_(role) {
   598	  if (!PyCapsule_CheckExact(capsule.ptr())) refuse_type(role, "expected a DLPack capsule, got " + type_name(capsule));
   599	  const bool versioned = capsule_kind(capsule, role);
   600	  // Consume: take the pointer, rename the capsule to "used_*" (so its destructor no longer calls the deleter), and
   601	  // own the managed tensor from here on (owner_ calls the deleter on every path, including a throw below).
   602	  if (versioned) {
   603	    auto* m = static_cast<DLManagedTensorVersioned*>(capsule_pointer(capsule, kCapsuleVersioned));
   604	    if (PyCapsule_SetName(capsule.ptr(), kUsedCapsuleVersioned) != 0) throw py::error_already_set();
   605	    owner_.versioned = m;
   606	    check_version(m, role);
   607	    if (writable && (m->flags & DLPACK_FLAG_BITMASK_READ_ONLY))
   608	      refuse_value(role, "the producer marked this tensor read-only; tc_signal writes this operand");
   609	    if (writable && (m->flags & DLPACK_FLAG_BITMASK_IS_COPIED))
   610	      refuse_value(role, "the producer exported a copy; writes to it would not reach the caller's tensor");
   611	    t_ = &m->dl_tensor;
   612	  } else {
   613	    auto* m = static_cast<DLManagedTensor*>(capsule_pointer(capsule, kCapsule));
   614	    if (PyCapsule_SetName(capsule.ptr(), kUsedCapsule) != 0) throw py::error_already_set();
   615	    owner_.legacy = m;
   616	    t_ = &m->dl_tensor;
   617	  }
   618	  numel_ = validate_tensor(t_, role, ndim);
   619	  data_ = reinterpret_cast<float*>(static_cast<char*>(t_->data) + t_->byte_offset);  // byte_offset honoured
   620	}
