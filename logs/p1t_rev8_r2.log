  1461	// P1T-FIX7 L1: the exit runner's device-wait window (see wait_device_work_diagnosed). The delay is clamped as the exit
  1462	// wait's is (NaN / negative -> 0: diagnose at once; capped at kLifecycleMaxDiagDelayS).
  1463	void exit_device_waits_diagnosed(double first_diag_s) noexcept {
  1464	  if (!(first_diag_s >= 0.0)) first_diag_s = 0.0;
  1465	  if (first_diag_s > tuning::kLifecycleMaxDiagDelayS) first_diag_s = tuning::kLifecycleMaxDiagDelayS;
  1466	  g_exit_device_wait_diag_ns.store(static_cast<long long>(first_diag_s * 1e9), std::memory_order_relaxed);
