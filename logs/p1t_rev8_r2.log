   158	struct Lifecycle {
   159	  std::mutex mu;                           // only for the waiter's condition variable; admission never takes it
   160	  std::condition_variable cv;
   161	  std::atomic<bool> closing{false};
   162	  std::atomic<long long> in_flight[kKinds];
   163	  Lifecycle() {
   164	    for (auto& c : in_flight) c.store(0);
   165	  }
   166	};
   167	
   168	// Never destroyed (a callback may run during static destruction). Constructed at module import (init_pending_state).
   169	Lifecycle& lifecycle() {
   170	  static Lifecycle* s = new Lifecycle();
   171	  return *s;
   172	}
   173	
   174	// Admitted sections on THIS thread's stack, per kind (self-exclusion; also synchronize()'s skip rule).
   175	thread_local long long t_depth[kKinds] = {0, 0};
   176	
   177	// Static storage: counting never allocates.
   178	std::atomic<unsigned long long> g_admitted[kKinds];
   179	std::atomic<unsigned long long> g_deleters_leaked_after_close{0};   // V5-01: "a late release leaks, and is counted"
   180	std::atomic<unsigned long long> g_deleters_leaked_finalizing{0};
   181	std::atomic<unsigned long long> g_capsules_kept_after_close{0};
   182	std::atomic<unsigned long long> g_capsules_kept_finalizing{0};
   183	std::atomic<unsigned long long> g_callbacks_refused{0};
   184	std::atomic<unsigned long long> g_lifecycle_lock_failures{0};
   185	std::atomic<unsigned long long> g_exit_hook_calls{0};
   186	std::atomic<unsigned long long> g_exit_in_flight_at_close{0};
   187	std::atomic<unsigned long long> g_exit_wait_us{0};
   188	std::atomic<unsigned long long> g_exit_wait_diagnostics{0};
   189	std::atomic<unsigned long long> g_exit_wait_overruns{0};
   190	std::atomic<unsigned long long> g_exit_wait_poll_diagnostics{0};  // P1T-FIX7 L1: lines of the polling fallback
