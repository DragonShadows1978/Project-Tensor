   155	def empty(*shape, dtype="float32", device="cuda"):
   156	    """Uninitialized tensor allocated on the device by the engine's allocator.
   157	
   158	    Amendment 1 (P1T-M1): binds ``NDArray::empty`` with no host round-trip and
   159	    no fill, so the CONTENTS ARE UNINITIALIZED (whatever the allocator hands
   160	    back). Shape conventions match ``zeros``: ``empty(2, 3)``,
   161	    ``empty((2, 3))`` or ``empty([2, 3])``; ``empty()`` is 0-d. Returns a
   162	    Tensor with ``requires_grad=False``. Unlike ``zeros``, an unknown dtype
   163	    string raises instead of falling back to float32. More than 8 dimensions
   164	    (TensorCUDA's maximum rank), a negative extent, or an element count or
   165	    byte size that overflows 64-bit arithmetic raises ``ValueError`` before
   166	    anything is allocated (P1T-FIX1 F03). Every nonzero extent counts, also
   167	    when another extent is 0 (P1T-FIX2 N2): the product of the extents with
   168	    zeros counted as 1, times the element size, must fit in int64, so
   169	    ``empty(0, 2**62, 4)`` raises while ``empty(0, 2**60)`` is an empty tensor
