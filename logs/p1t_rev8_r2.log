    tcs::PendingEntry e; e.event = reinterpret_cast<cudaEvent_t>(16); e.device = device; e.bytes = 4;
    tcs::ManagedOwner o; o.legacy = &h->m; e.owners.push_back(std::move(o)); held.push_back(std::move(h));
