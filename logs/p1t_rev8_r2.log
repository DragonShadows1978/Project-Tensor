   351	void CapsuleRef::drop() noexcept {
   352	  PyObject* p = p_;
   353	  p_ = nullptr;
   354	  if (p == nullptr) return;
   355	  if (!interpreter_accepts_python()) {
   356	    // Finalizing (for example a daemon thread unwinding after CPython exited it): never touch Python. Kept.
   357	    g_capsules_kept_finalizing.fetch_add(1, std::memory_order_relaxed);
   358	    return;
   359	  }
   360	  // P1T-FIX6 (sweep (g), user Python run from a native frame): FIX5 admitted only the last reference of an UNCONSUMED
   361	  // capsule. The last reference of a consumed ("used_*") capsule also runs the producer's PyCapsule destructor: per the
   362	  // DLPack Python spec that destructor only returns for a consumed capsule, but it is still producer code (a ctypes or
   363	  // Cython destructor runs Python, and may release and re-take the GIL), run from this native frame. Every
   364	  // last-reference drop of a capsule is therefore admitted (waited for by the exit hook), or kept once admission has
   365	  // closed (a consumed capsule kept at exit holds no producer memory: nothing is lost). A capsule with no destructor,
   366	  // or a drop that is not the last reference, runs no producer code either way.
   367	  if (PyCapsule_CheckExact(p) && Py_REFCNT(p) == 1) {
   368	    // The last reference to a DLPack capsule: dropping it runs the producer's destructor (which, for an unconsumed
   369	    // capsule, calls the producer's deleter). A release: admitted, or kept (never run) once admission has closed.
   370	    const Admission a = admit(kRelease);
   371	    if (a != Admission::kAdmitted) {
   372	      (a == Admission::kClosed ? g_capsules_kept_after_close : g_capsules_kept_finalizing)
   373	          .fetch_add(1, std::memory_order_relaxed);
   374	      return;
   375	    }
   376	    Py_DECREF(p);
   377	    leave(kRelease);
   378	    return;
   379	  }
   380	  Py_DECREF(p);

