        s = np.where(np.isfinite(mask), qe @ np.swapaxes(ke, -1, -2) * D ** -0.5, -np.inf)
        ref = np.zeros((1, 2, Lq, D))
        for r in (0, 2, 3):
            ref[..., r:r + 1, :] = O.softmax64(s[..., r:r + 1, :], ve)
