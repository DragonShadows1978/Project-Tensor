   249	DLDataType to_dl_dtype(DType dt) {
   250	  auto mk = [](int code, int bits) {
   251	    DLDataType d;
   252	    d.code = static_cast<uint8_t>(code);
   253	    d.bits = static_cast<uint8_t>(bits);
   254	    d.lanes = 1;
   255	    return d;
   256	  };
   257	  switch (dt) {
   258	    case DType::Float32: return mk(kDLFloat, 32);
   259	    case DType::Float16: return mk(kDLFloat, 16);
   260	    case DType::BFloat16: return mk(kDLBfloat, 16);
   261	    case DType::Int64: return mk(kDLInt, 64);
   262	    case DType::Uint8: return mk(kDLUInt, 8);
   263	    case DType::Bool: return mk(kDLBool, 8);
   264	  }
   265	  throw py::buffer_error("__dlpack__: dtype has no DLPack mapping");
   266	}
   267	
   268	// Exact matches only: TensorCUDA never converts on import.
   269	bool from_dl_dtype(const DLDataType& d, DType* out) {
   270	  if (d.lanes != 1) return false;
   271	  if (d.code == kDLFloat && d.bits == 32) { *out = DType::Float32; return true; }
   272	  if (d.code == kDLFloat && d.bits == 16) { *out = DType::Float16; return true; }
   273	  if (d.code == kDLBfloat && d.bits == 16) { *out = DType::BFloat16; return true; }
   274	  if (d.code == kDLInt && d.bits == 64) { *out = DType::Int64; return true; }
   275	  if (d.code == kDLUInt && d.bits == 8) { *out = DType::Uint8; return true; }
   276	  if (d.code == kDLBool && d.bits == 8) { *out = DType::Bool; return true; }
   277	  return false;
   278	}
