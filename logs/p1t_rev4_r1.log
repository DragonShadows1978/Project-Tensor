    70	// P1T-FIX2, review finding N2: both helpers used plain signed products, which overflowed (undefined behaviour) for
    71	// zero-extent shapes such as [2^62, 4, 0] (numel_of: the prefix product 2^64 is formed before the 0 is reached) and
    72	// [0, 2^62, 4] (contiguous_strides: the stride of axis 0 is 2^64) even though the element count is 0 (round-2 probe
    73	// core_cpu prefix/suffix, UBSan). The DLPack/empty entry points now refuse such shapes first (bindings.cpp
    74	// checked_numel/checked_nbytes, the zero-extent rule); these helpers are the second line:
    75	//  * numel_of returns 0 for any shape with a zero extent WITHOUT multiplying (that is the exact count), and otherwise
    76	//    multiplies with overflow checks;
    77	//  * contiguous_strides multiplies with overflow checks and no longer forms the unused product past axis 0.
    78	// An overflow throws std::overflow_error (Python OverflowError) instead of wrapping. Values are unchanged whenever no
    79	// overflow occurs. Prior art: GCC/Clang __builtin_mul_overflow (GCC 5, 2015), C23 ckd_mul, CERT INT32-C. Ours: where.
    80	int64_t numel_of(const Shape& shape) {
    81	  for (int64_t s : shape)
    82	    if (s == 0) return 0;
    83	  int64_t n = 1;
    84	  for (int64_t s : shape)
    85	    if (__builtin_mul_overflow(n, s, &n))
    86	      throw std::overflow_error("numel_of: the element count of a shape overflows int64");
    87	  return n;  // 1 for a 0-d shape
    88	}
    89	Shape contiguous_strides(const Shape& shape) {
    90	  Shape st(shape.size());
    91	  int64_t acc = 1;
    92	  for (int i = static_cast<int>(shape.size()) - 1; i >= 0; --i) {
    93	    st[i] = acc;
    94	    if (i > 0 && __builtin_mul_overflow(acc, shape[i], &acc))
    95	      throw std::overflow_error("contiguous_strides: a stride of a shape overflows int64");
    96	  }
    97	  return st;
    98	}
