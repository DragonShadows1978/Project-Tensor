   219	
   220	// P1T-FIX2, review finding N4: a producer deleter that throws a C++ exception must not terminate the process. Every
   221	// deleter call in tc_signal goes through reset() (the immediate release of a refused call, the deferred drain, the
   222	// bound drain, the fallback sync, synchronize() and the atexit hook all end here), and reset() is noexcept, so an
   223	// escaping exception used to reach std::terminate (round-2 probe cpu_native throw_deleter, rc -6). Now each call is
   224	// wrapped: the exception is caught (catch-all), counted (pending_stats()['deleter_exceptions']) and dropped; the owner
   225	// pointer is cleared BEFORE the call, so a deleter is never called twice, and the caller (a loop over an entry's
   226	// managers) keeps going with the remaining managers. The DLPack ABI declares the deleter as a C function, so a
   227	// throwing deleter already breaks the producer's contract; containing it is the consumer's choice, not a recovery
   228	// (the producer's memory may or may not have been freed: tc_signal does not touch it again either way).
   229	// Prior art: C++11 noexcept semantics ([except.terminate]: an exception escaping a noexcept function calls
   230	// std::terminate) and the "destructors/cleanup must not throw" guideline (C++ Core Guidelines C.36/E.16, Sutter &
   231	// Alexandrescu 2004, item 51). Taken: catch at the noexcept boundary. Ours: counting and continuing per manager.
   232	// Known gap (not closed): a deleter that calls pthread_exit or is cancelled unwinds with abi::__forced_unwind, which
   233	// may not be swallowed (glibc aborts); no C++ handler can contain that.
   234	namespace {
   235	std::atomic<unsigned long long> g_deleter_exceptions{0};  // static storage: counting never allocates
   236	
   237	template <typename M>
   238	void call_deleter_contained(M* m) noexcept {
   239	  if (m == nullptr || m->deleter == nullptr) return;
   240	  try {
   241	    m->deleter(m);
   242	  } catch (...) {
   243	    g_deleter_exceptions.fetch_add(1, std::memory_order_relaxed);
   244	  }
   245	}
   246	}  // namespace
   247	
   248	void ManagedOwner::reset() noexcept {
   249	  // DLPack consumer rule: when done, call the producer's deleter (it may be NULL). Called with the GIL held (every
   250	  // tc_signal entry point runs under the GIL), so a deleter that touches Python objects is safe.
   251	  if (legacy != nullptr) {
   252	    DLManagedTensor* m = legacy;
   253	    legacy = nullptr;  // cleared first: never called twice, even if the deleter throws or re-enters
   254	    call_deleter_contained(m);
   255	  }
   256	  if (versioned != nullptr) {
   257	    DLManagedTensorVersioned* m = versioned;
   258	    versioned = nullptr;
   259	    call_deleter_contained(m);
   260	  }
   261	}
   262	
   263	unsigned long long deleter_exceptions() noexcept { return g_deleter_exceptions.load(std::memory_order_relaxed); }
   264	
   265	// ------------------------------------------------------------------------------------------------ Operand
   266	Operand::Operand(py::handle capsule, const char* role, int ndim, bool writable) : role_(role) {
   267	  if (!PyCapsule_CheckExact(capsule.ptr())) refuse_type(role, "expected a DLPack capsule, got " + type_name(capsule));
   268	  const bool versioned = capsule_kind(capsule, role);
   269	  // Consume: take the pointer, rename the capsule to "used_*" (so its destructor no longer calls the deleter), and
   270	  // own the managed tensor from here on (owner_ calls the deleter on every path, including a throw below).
   271	  if (versioned) {
   272	    auto* m = static_cast<DLManagedTensorVersioned*>(capsule_pointer(capsule, kCapsuleVersioned));
   273	    if (PyCapsule_SetName(capsule.ptr(), kUsedCapsuleVersioned) != 0) throw py::error_already_set();
   274	    owner_.versioned = m;
   275	    check_version(m, role);
   276	    if (writable && (m->flags & DLPACK_FLAG_BITMASK_READ_ONLY))
   277	      refuse_value(role, "the producer marked this tensor read-only; tc_signal writes this operand");
   278	    if (writable && (m->flags & DLPACK_FLAG_BITMASK_IS_COPIED))
   279	      refuse_value(role, "the producer exported a copy; writes to it would not reach the caller's tensor");
   280	    t_ = &m->dl_tensor;
   281	  } else {
   282	    auto* m = static_cast<DLManagedTensor*>(capsule_pointer(capsule, kCapsule));
   283	    if (PyCapsule_SetName(capsule.ptr(), kUsedCapsule) != 0) throw py::error_already_set();
   284	    owner_.legacy = m;
   285	    t_ = &m->dl_tensor;
   286	  }
   287	  numel_ = validate_tensor(t_, role, ndim);
   288	  data_ = reinterpret_cast<float*>(static_cast<char*>(t_->data) + t_->byte_offset);  // byte_offset honoured
   289	}
