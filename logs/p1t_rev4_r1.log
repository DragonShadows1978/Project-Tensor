   900	py::dict pending_stats(bool reset_high_water) {
   901	  PendingState& st = pending();
   902	  py::dict d;
   903	  d["entries"] = static_cast<long long>(st.q.size());
   904	  d["managers"] = st.managers;
   905	  d["bytes"] = st.bytes;
   906	  d["high_water_entries"] = st.high_water_entries;
   907	  d["high_water_managers"] = st.high_water_managers;
   908	  d["high_water_bytes"] = st.high_water_bytes;
   909	  d["retained_entries"] = st.retained_entries;
   910	  d["released_entries"] = st.released_entries;
   911	  d["released_managers"] = st.released_managers;
   912	  d["bound_drains"] = st.bound_drains;
   913	  d["fallback_syncs"] = st.fallback_syncs;
   914	  d["leaked_managers"] = st.leaked_managers;
   915	  d["max_entries"] = tuning::kPendingMaxEntries;
   916	  d["max_bytes"] = tuning::kPendingMaxBytes;
   917	  // P1T-FIX2 counters.
   918	  d["deleter_exceptions"] = deleter_exceptions();           // N4
   919	  d["push_alloc_failures"] = st.push_alloc_failures;        // N3
   920	  d["event_recycle_failures"] = st.event_recycle_failures;  // N3
   921	  d["bytes_saturated"] = st.bytes_saturated;                // P1T-FIX3 V3-02
   922	  d["bytes_saturations"] = st.bytes_saturations;            // P1T-FIX3 V3-02
   923	  d["release_errors"] = st.release_errors;                  // N1
   924	  d["unreported_release_errors"] = st.unreported_count;     // N1
   925	  if (reset_high_water) {
   926	    st.high_water_entries = static_cast<long long>(st.q.size());
   927	    st.high_water_managers = st.managers;
   928	    st.high_water_bytes = st.bytes;
   929	  }
   930	  return d;
   931	}
