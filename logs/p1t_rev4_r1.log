   768	Tensor tensor_from_dlpack_capsule(py::object obj) {
   769	  PyObject* cap = obj.ptr();
   770	  bool versioned = false;
   771	  if (PyCapsule_IsValid(cap, kCapVersioned)) {
   772	    versioned = true;
   773	  } else if (!PyCapsule_IsValid(cap, kCapLegacy)) {
   774	    if (PyCapsule_CheckExact(cap)) {
   775	      const char* name = PyCapsule_GetName(cap);
   776	      PyErr_Clear();
   777	      throw py::value_error(
   778	          std::string("from_dlpack: capsule named '") + (name ? name : "NULL") +
   779	          "' is not an unconsumed DLPack capsule (a capsule can be consumed "
   780	          "only once)");
   781	    }
   782	    throw py::type_error(
   783	        "from_dlpack: expected an object with __dlpack__ or a DLPack capsule");
   784	  }
   785	  DLTensor* dl = nullptr;
   786	  void* manager = nullptr;
   787	  uint64_t flags = 0;
   788	  if (versioned) {
   789	    auto* m = static_cast<DLManagedTensorVersioned*>(
   790	        PyCapsule_GetPointer(cap, kCapVersioned));
   791	    if (!m) throw py::error_already_set();
   792	    if (m->version.major != DLPACK_MAJOR_VERSION)
   793	      throw py::buffer_error(
   794	          "from_dlpack: DLPack major version " + std::to_string(m->version.major) +
   795	          " is not supported (this build speaks DLPack " +
   796	          std::to_string(DLPACK_MAJOR_VERSION) + ".x)");
   797	    dl = &m->dl_tensor;
   798	    flags = m->flags;
   799	    manager = m;
   800	  } else {
   801	    auto* m = static_cast<DLManagedTensor*>(PyCapsule_GetPointer(cap, kCapLegacy));
   802	    if (!m) throw py::error_already_set();
   803	    dl = &m->dl_tensor;
   804	    manager = m;
   805	  }
   806	  // Every refusal below leaves the capsule unconsumed, so its destructor
   807	  // hands the memory back to the producer.
   808	  if (flags & DLPACK_FLAG_BITMASK_READ_ONLY)
   809	    throw py::buffer_error(
   810	        "from_dlpack: the producer marked this tensor read-only; TensorCUDA "
   811	        "tensors are writable, so read-only imports are refused");
   812	  if (dl->device.device_type != kDLCUDA)
   813	    throw py::buffer_error(
   814	        "from_dlpack: only CUDA device memory (kDLCUDA = 2) can be imported; "
   815	        "got device type " + std::to_string(static_cast<int>(dl->device.device_type)) +
   816	        (dl->device.device_type == kDLCPU ? " (CPU)" : ""));
   817	  int cur = 0;
   818	  cudaGetDevice(&cur);
   819	  if (dl->device.device_id != cur)
   820	    throw py::buffer_error(
   821	        "from_dlpack: tensor is on CUDA device " + std::to_string(dl->device.device_id) +
   822	        " but TensorCUDA runs on device " + std::to_string(cur) +
   823	        " (multi-GPU import is not supported)");
   824	  DType dt;
   825	  if (!from_dl_dtype(dl->dtype, &dt))
   826	    throw py::buffer_error(
   827	        "from_dlpack: DLPack dtype (code=" + std::to_string(dl->dtype.code) +
   828	        ", bits=" + std::to_string(dl->dtype.bits) + ", lanes=" +
   829	        std::to_string(dl->dtype.lanes) +
   830	        ") has no exact TensorCUDA dtype; TensorCUDA never converts on import "
   831	        "(supported: float32, float16, bfloat16, int64, uint8, bool)");
   832	  if (dl->ndim < 0 || dl->ndim > TC_MAX_DIMS)
   833	    throw py::buffer_error("from_dlpack: ndim " + std::to_string(dl->ndim) +
   834	                           " is outside TensorCUDA's 0.." +
   835	                           std::to_string(TC_MAX_DIMS));
   836	  const int nd = dl->ndim;
   837	  if (nd > 0 && dl->shape == nullptr)
   838	    throw py::buffer_error("from_dlpack: NULL shape array for a tensor with dimensions");
   839	  Shape shape(nd);
   840	  for (int i = 0; i < nd; ++i) {
   841	    if (dl->shape[i] < 0)
   842	      throw py::buffer_error("from_dlpack: negative extent in shape " +
   843	                             shape_str(dl->shape, nd));
   844	    shape[i] = dl->shape[i];
   845	  }
   846	  // F03 (P1T-FIX1): checked count (ValueError on overflow, never a wrapped size).
   847	  const int64_t numel = checked_numel(dl->shape, nd, "from_dlpack");
   848	  // C-contiguous only; a size-1 dimension may carry any stride (it is never
   849	  // stepped). Strides == NULL means compact row-major (DLPack < 1.2).
   850	  if (nd > 0 && dl->strides && numel > 0) {
   851	    int64_t expected = 1;
   852	    for (int i = nd - 1; i >= 0; --i) {
   853	      if (shape[i] != 1 && dl->strides[i] != expected)
   854	        throw py::buffer_error(
   855	            "from_dlpack: non-contiguous strides " + shape_str(dl->strides, nd) +
   856	            " for shape " + shape_str(dl->shape, nd) +
   857	            "; TensorCUDA imports C-contiguous (row-major) tensors only "
   858	            "(size-1 dimensions may have any stride). Make the tensor "
   859	            "contiguous on the producer side first.");
   860	      expected *= shape[i];
   861	    }
   862	  }
   863	  const size_t isz = dtype_size(dt);
   864	  if (dl->byte_offset % isz != 0)
   865	    throw py::buffer_error("from_dlpack: byte_offset " +
   866	                           std::to_string(dl->byte_offset) +
   867	                           " is not a multiple of the element size " +
   868	                           std::to_string(isz));
   869	  if (numel > 0 && dl->data == nullptr)
   870	    throw py::buffer_error("from_dlpack: null data pointer for a non-empty tensor");
   871	  // F03 (P1T-FIX1): checked byte size, byte_offset + bytes (the Storage's
   872	  // nbytes) and data + byte_offset + bytes (one past the last byte); each
   873	  // overflow raises ValueError and leaves the capsule unconsumed.
   874	  const int64_t nbytes = checked_nbytes(numel, isz, dl->shape, nd, "from_dlpack");
   875	  int64_t storage_bytes = 0;
   876	  if (dl->byte_offset > static_cast<uint64_t>(std::numeric_limits<int64_t>::max()) ||
   877	      __builtin_add_overflow(static_cast<int64_t>(dl->byte_offset), nbytes, &storage_bytes))
   878	    throw py::value_error("from_dlpack: byte_offset " + std::to_string(dl->byte_offset) +
   879	                          " + byte size " + std::to_string(nbytes) + " overflows int64; refused");
   880	  uintptr_t end_address = 0;
   881	  if (__builtin_add_overflow(reinterpret_cast<uintptr_t>(dl->data),
   882	                             static_cast<uintptr_t>(storage_bytes), &end_address))
   883	    throw py::value_error("from_dlpack: data + byte_offset + byte size overflows the address space; refused");
   884	
   885	  Device dev;
   886	  dev.type = DeviceType::CUDA;
   887	  dev.index = cur;
   888	  auto storage = std::make_shared<Storage>(
   889	      dl->data, static_cast<size_t>(storage_bytes),
   890	      dev, versioned ? import_release_versioned : import_release_legacy, manager);
   891	  // Consume the capsule only once the Storage owns the manager.
   892	  if (PyCapsule_SetName(cap, versioned ? kCapUsedVersioned : kCapUsedLegacy) != 0) {
   893	    storage->external_release = import_release_noop;  // the capsule still owns it
   894	    throw py::error_already_set();
   895	  }
   896	  NDArray a;
   897	  a.storage = std::move(storage);
   898	  a.shape = std::move(shape);
   899	  a.dtype = dt;
   900	  a.device = dev;
   901	  a.offset = static_cast<int64_t>(dl->byte_offset / isz);
   902	  return Tensor::make(a, false);
   903	}
   904	
   905	// Amendment 1: device-side empty (no host round-trip, no fill).
   906	// P1T-FIX1, F03: refuses rank > TC_MAX_DIMS (the engine's op metadata arrays
   907	// hold 8 axes) and any element-count or byte-size overflow, with ValueError,
   908	// before allocating; a CPU allocation failure raises MemoryError instead of
   909	// returning a nonempty tensor over a NULL buffer.
   910	Tensor tensor_empty(std::vector<int64_t> shape, const std::string& dtype,
   911	                    const std::string& device) {
   912	  if (shape.size() > static_cast<size_t>(TC_MAX_DIMS))
   913	    throw py::value_error("empty: " + std::to_string(shape.size()) +
   914	                          " dimensions exceed TensorCUDA's maximum rank " +
   915	                          std::to_string(TC_MAX_DIMS) + " (TC_MAX_DIMS)");
   916	  for (int64_t s : shape)
   917	    if (s < 0) throw py::value_error("empty: negative dimensions are not allowed");
   918	  const DType dt = dtype_from_string(dtype);
   919	  const int nd = static_cast<int>(shape.size());
   920	  const int64_t numel = checked_numel(shape.data(), nd, "empty");
   921	  const int64_t nbytes = checked_nbytes(numel, dtype_size(dt), shape.data(), nd, "empty");
   922	  NDArray a = NDArray::empty(Shape(shape.begin(), shape.end()), dt, Device::from_string(device));
   923	  if (nbytes > 0 && a.storage->ptr == nullptr) throw std::bad_alloc();  // -> MemoryError
   924	  return Tensor::make(a, false);
   925	}
   926	
   927	const char* const kDlpackDoc = R"doc(Export this tensor zero-copy as a DLPack capsule (Python array API protocol).
   928	
   929	stream: the CONSUMER's CUDA stream, as a DLPack int. TensorCUDA queues all of its
   930	  work on the legacy default stream.
   931	  * None or 1: the consumer is on the legacy default stream; nothing to do.
   932	  * -1: no synchronization.
   933	  * 2 (per-thread default stream) or any other handle (a cudaStream_t): TensorCUDA
   934	    records a CUDA event on the legacy default stream and makes the consumer's
   935	    stream wait on it before returning, so the consumer sees every TensorCUDA
   936	    write queued so far.
   937	  * 0 is ambiguous under the protocol and raises ValueError.
   938	max_version: None (or major < 1) returns a legacy "dltensor" capsule; (1, x) or
   939	  later returns "dltensor_versioned" (DLPack 1.3 header, flags 0).
   940	dl_device: None or (2, this tensor's device); anything else raises BufferError.
   941	copy: None or False. copy=True raises BufferError (TensorCUDA never copies on
   942	  export).
   943	
   944	The capsule's manager holds a reference to the tensor's Storage, so the memory
   945	outlives this Tensor's last Python reference. data + byte_offset addresses
   946	element 0; strides are C-contiguous. An unconsumed capsule releases its
   947	reference when it is garbage collected.
   948	
   949	Raises BufferError for CPU tensors.
   950	
   951	External in-place writes (mark_modified rule): TensorCUDA's derived-tensor
