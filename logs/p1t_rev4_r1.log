   112	// --------------------------------------------------------------------- Storage
   113	// Stream-ordered allocation: cudaMallocAsync/cudaFreeAsync on the legacy
   114	// default stream (ALL engine kernels + cuBLAS run on it, so stream-ordering ==
   115	// program-ordering here).
   116	//
   117	// WHY: nsys on a MiniCPM3 prefill measured cudaMalloc+cudaFree as the #1 cost
   118	// of the whole engine — ~6,700 alloc/free pairs per forward, cudaFree's
   119	// implicit device-sync serializing CPU and GPU (8.6s of blocking API time
   120	// across 3 forwards vs 0.14s of kernel launches). The async pool removes the
   121	// sync and recycles within the stream.
   122	//
   123	// NOTE: a HOMEMADE caching free-list (exact-size-keyed) was tried earlier and
   124	// REVERTED — exact-size bucketing pinned ~2GB of differently-sized transients
   125	// and cut the Mistral refine=0.05 ceiling 16384->8192 (measured). The driver's
   126	// suballocating pool is NOT that design, and the release threshold below is
   127	// deliberately small so idle memory returns to the driver at sync points. The
   128	// context-ceiling spot-check is a MANDATORY gate on any change here.
   129	namespace {
   130	constexpr uint64_t kPoolReleaseThreshold = 256ull * 1024 * 1024;  // 256MB
   131	void init_default_pool() {
   132	  static bool done = false;
   133	  if (done) return;
   134	  done = true;
   135	  int dev = 0;
   136	  cudaGetDevice(&dev);
   137	  cudaMemPool_t pool;
   138	  if (cudaDeviceGetDefaultMemPool(&pool, dev) == cudaSuccess) {
   139	    uint64_t thr = kPoolReleaseThreshold;
   140	    cudaMemPoolSetAttribute(pool, cudaMemPoolAttrReleaseThreshold, &thr);
   141	  }
   142	}
   143	}  // namespace
   144	
   145	void empty_cache() {
   146	  // Return all pooled-but-unused memory to the driver.
   147	  int dev = 0;
   148	  cudaGetDevice(&dev);
   149	  cudaMemPool_t pool;
   150	  if (cudaDeviceGetDefaultMemPool(&pool, dev) == cudaSuccess)
   151	    cudaMemPoolTrimTo(pool, 0);
   152	}
   153	
   154	// LOAD/RUNTIME SPLIT: pooling is gated on a global flag callers enable AFTER
   155	// weight loading (tc.set_alloc_pooling(True)). Persistents (weights, scales,
   156	// norm params — allocated while the flag is off) live in raw cudaMalloc
   157	// memory; ONLY forward-pass transients enter the pool. The wall bisect forced
   158	// this design: pooled LIVE blocks pin reserved chunks that TrimTo cannot
   159	// release, and size-capped hybrids measured either wall loss (<=16MB cap:
   160	// Mistral r0.05@16384 OOM) or no speedup (<=1MB cap: 2539ms vs 2611 raw — at
   161	// S=1024 nearly every transient exceeds 1MB). With a transients-only pool the
   162	// OOM retry's sync+trim empties the pool COMPLETELY, so the raw retry sees
   163	// exactly the pure-raw engine's free memory at the wall.
   164	namespace {
   165	bool g_pool_transients = false;
   166	}
   167	
   168	void set_alloc_pooling(bool enabled) {
   169	  init_default_pool();
   170	  g_pool_transients = enabled;
   171	  if (!enabled) empty_cache();
   172	}
