   549	// What one sync_and_release_all_impl call found (fixed capacity: the first kSyncReportMax failures are named, the
   550	// rest only counted).
   551	struct SyncReport {
   552	  bool query_failed = false;               // cudaGetDevice failed (N1: never a success)
   553	  cudaError_t query_error = cudaSuccess;
   554	  int n = 0;
   555	  int dev[tuning::kSyncReportMax];
   556	  cudaError_t err[tuning::kSyncReportMax];
   557	  int unnamed = 0;                         // failures beyond the named ones
   558	  unsigned long long leaked_managers = 0;  // managers leaked by this call (no completion proof)
   559	
   560	  void add(int d, cudaError_t e) noexcept {
   561	    if (n < tuning::kSyncReportMax) {
   562	      dev[n] = d;
   563	      err[n] = e;
   564	      ++n;
   565	    } else {
   566	      ++unnamed;
   567	    }
   568	  }
   569	  bool failed() const noexcept { return query_failed || n > 0 || unnamed > 0 || leaked_managers > 0; }
   570	  int first_device() const noexcept { return n > 0 ? dev[0] : -1; }
   571	  cudaError_t first_error() const noexcept { return query_failed ? query_error : (n > 0 ? err[0] : cudaErrorUnknown); }
