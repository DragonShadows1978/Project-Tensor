   652	// V3-02: the bound comparison after a push. Exact below INT64_MAX (a total of exactly kPendingMaxBytes is within the
   653	// bound, one byte more is over it, as before); a saturated total is over it.
   654	bool pending_over_bound(const PendingState& st) noexcept {
   655	  return static_cast<long long>(st.q.size()) > tuning::kPendingMaxEntries || st.bytes_saturated ||
   656	         st.bytes > tuning::kPendingMaxBytes;
   657	}
