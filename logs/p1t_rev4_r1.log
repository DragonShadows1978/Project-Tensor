   174	Storage::Storage(size_t nbytes_, Device device_) : nbytes(nbytes_), device(device_) {
   175	  if (nbytes == 0) { ptr = nullptr; return; }
   176	  if (device.is_cuda()) {
   177	    init_default_pool();
   178	    pooled = g_pool_transients;
   179	    cudaError_t e = pooled ? cudaMallocAsync(&ptr, nbytes, 0)
   180	                           : cudaMalloc(&ptr, nbytes);
   181	    if (e == cudaErrorMemoryAllocation) {
   182	      // Near the wall: sync materializes every pending cudaFreeAsync, trim
   183	      // returns all idle pool reservations to the driver, then retry once.
   184	      cudaGetLastError();  // clear sticky error
   185	      cudaStreamSynchronize(0);
   186	      empty_cache();
   187	      e = pooled ? cudaMallocAsync(&ptr, nbytes, 0) : cudaMalloc(&ptr, nbytes);
   188	    }
   189	    if (e != cudaSuccess)
   190	      throw std::runtime_error(std::string(pooled ? "cudaMallocAsync failed: "
   191	                                                  : "cudaMalloc failed: ") +
   192	                               cudaGetErrorString(e));
   193	  } else {
   194	    ptr = std::malloc(nbytes);
   195	  }
   196	}
