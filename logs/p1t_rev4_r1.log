   577	  ++st.release_errors;
   578	  if (st.unreported_count == 0) {
   579	    st.unreported_device = device;
   580	    st.unreported_error = err;
   581	  }
   582	  ++st.unreported_count;
   583	  st.unreported_leaked += leaked;
   584	}
