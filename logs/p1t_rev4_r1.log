   352	void expect_shape(const Operand& op, const std::vector<int64_t>& want) {
   353	  std::vector<int64_t> got(op.ndim());
   354	  for (int i = 0; i < op.ndim(); ++i) got[i] = op.dim(i);
   355	  if (got != want) refuse_value(op.role(), "shape " + shape_str(got) + " != expected " + shape_str(want));
