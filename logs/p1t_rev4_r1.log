    53	def _factory(np_fn):
    54	    def make(*shape, device="cuda", dtype="float32", requires_grad=False):
    55	        if len(shape) == 1 and isinstance(shape[0], (tuple, list)):
    56	            shape = tuple(shape[0])
    57	        if dtype in _DEVICE_CAST_DTYPE:
    58	            arr = np.ascontiguousarray(np_fn(shape).astype(np.float32))
    59	            return _C.tensor(arr, device, requires_grad).astype(dtype)
    60	        arr = np_fn(shape).astype(_NP_DTYPE.get(dtype, np.float32))
    61	        return _C.tensor(np.ascontiguousarray(arr), device, requires_grad)
    62	    return make
    63	
    64	
    65	zeros = _factory(np.zeros)
    66	ones = _factory(np.ones)
    67	randn = _factory(lambda s: np.random.randn(*s))
    68	rand = _factory(lambda s: np.random.rand(*s))
