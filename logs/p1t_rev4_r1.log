   197	Peeked peek_operand(py::handle obj, const char* role, int ndim) {
   198	  Peeked p;
   199	  require_operand(obj, role);
   200	  p.capsule = to_capsule(obj, role, false);
   201	  const DLTensor* t = peek(p.capsule, role);
