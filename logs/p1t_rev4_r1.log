   357	
   358	int common_device(const std::vector<const Operand*>& ops) {
   359	  int dev = -1;
   360	  const char* first = "";
   361	  for (const Operand* op : ops) {
   362	    if (op == nullptr || !op->present()) continue;
   363	    if (dev < 0) {
   364	      dev = op->device();
   365	      first = op->role();
   366	    } else if (op->device() != dev) {
   367	      std::ostringstream os;
   368	      os << "on CUDA device " << op->device() << " but operand '" << first << "' is on CUDA device " << dev
   369	         << "; every operand must be on the same device";
   370	      refuse_value(op->role(), os.str());
   371	    }
   372	  }
   373	  return dev;
   374	}
   375	
   376	void expect_disjoint(const Operand& written, const Operand& other) {
   377	  if (!written.present() || !other.present()) return;
   378	  if (written.byte_begin() < other.byte_end() && other.byte_begin() < written.byte_end())
   379	    refuse_value(written.role(), std::string("its memory overlaps operand '") + other.role() +
   380	                                     "'; the written operand must not alias any other operand");
   381	}
   382	
   383	// ------------------------------------------------------------------------------------------------ deferred release (F01)
   384	// Design and prior art: dlpack_operand.h, RetainUntilComplete. Every function here runs on the calling host thread with
   385	// the GIL held (every _tc_signal entry point is a pybind11 function that keeps the GIL), so the pending list needs no
   386	// lock. Deleters may run Python (a ctypes producer) and may even re-enter tc_signal; therefore an entry is always taken
   387	// OFF the list before its deleters run, and nothing holds a reference into the list across a deleter call.
   388	//
   389	// P1T-FIX2 (round-2 review N1, N3) changed the release paths as follows:
   390	//  * N3, no allocation failure terminates. The noexcept functions here (drain_completed, the RetainUntilComplete
   391	//    destructor, sync_and_release_all_impl, recycle_event) no longer allocate, except the pending-list push in the
   392	//    destructor, which is caught and falls back to a synchronous release (counted). sync_and_release_all_impl works on
   393	//    the live list in place (phase 1 synchronizes the devices into a fixed-capacity set, phase 2 pops completed
   394	//    entries), instead of a take-all std::deque swap and a std::set / std::vector of devices, which allocated inside a
   395	//    noexcept function (libstdc++'s deque allocates even when default-constructed: the round-2 probe oom_sync, rc -6).
   396	//    The recycle slot of every completion event is reserved when the event is created (constructor path, before any
   397	//    launch), so recycling never allocates. The owner vector is reserved in the constructor, as before.
   398	//  * N1, no CUDA error is reported as success: a failed current-device query (cudaGetDevice) is now an error of
   399	//    synchronize() (it used to be skipped, so an empty list "synchronized" successfully on a machine with no usable
   400	//    device: probe empty_sync); a stream sync that fails is an error; and a release-path failure that happens where
   401	//    nothing can raise (the fallback sync and the bound drain inside the destructor) is recorded and raised by the next
   402	//    synchronize() (once), and logged by the atexit hook.
   403	// Prior art for the in-place two-phase drain: PyTorch's CUDA caching allocator processes its event list in place from
   404	// the host (process_events: query each recorded event, stop at the first one not ready). Taken: query-and-pop in FIFO
   405	// order. Ours: the sync-then-pop split with the per-device failure set, and leak-instead-of-release for entries whose
   406	// device could not be synchronized. Fixed-capacity, allocation-free bookkeeping on failure paths is ordinary
   407	// "no allocation on the error path" practice (e.g. the C++ Core Guidelines E.16 discussion); no specific prior art
   408	// claimed for the set itself.
   409	namespace test_hooks {
   410	namespace {
   411	std::atomic<unsigned> g_armed{0};
   412	}  // namespace
   413	void arm(unsigned bits) noexcept { g_armed.fetch_or(bits, std::memory_order_relaxed); }
   414	void clear() noexcept { g_armed.store(0, std::memory_order_relaxed); }
   415	unsigned armed() noexcept { return g_armed.load(std::memory_order_relaxed); }
   416	bool take(unsigned bit) noexcept {
   417	  if ((g_armed.load(std::memory_order_relaxed) & bit) == 0) return false;  // the production path: one relaxed load
   418	  return (g_armed.fetch_and(~bit, std::memory_order_relaxed) & bit) != 0;
   419	}
   420	}  // namespace test_hooks
   421	
   422	namespace {
   423	
   424	// TEST HOOK: the CUDA error an armed kCuda* site reports instead of calling CUDA (tests only; never in production).
   425	constexpr cudaError_t kTestInjectedCudaError = cudaErrorLaunchFailure;
   426	
   427	struct PendingEntry {
   428	  cudaEvent_t event = nullptr;   // recorded on `device`'s legacy stream right after the call's last launch
   429	  int device = -1;
   430	  int64_t bytes = 0;             // sum of the fp32 operand sizes this entry keeps alive
     1	// DLPack consumer side of tc_signal: turn any DLPack CUDA producer (or a bare capsule) into a validated fp32 operand.
     2	//
     3	// Prior art: DLPack (dmlc/dlpack, 2017-; header v1.3 vendored in include/dlpack/dlpack.h) for the DLManagedTensor /
     4	// DLManagedTensorVersioned ABI and the capsule rules ("dltensor" / "dltensor_versioned", renamed to "used_*" on
     5	// consumption, consumer calls the deleter); the Python array API standard's data-interchange protocol
     6	// (`__dlpack__(stream=, max_version=, copy=)`, Consortium for Python Data API Standards, 2021-2023) for the stream
     7	// argument and the max_version/TypeError fallback, which NumPy's and PyTorch's `from_dlpack` also implement. Ours: the
     8	// two-phase use (peek shapes for sizing without consuming, then consume and validate everything right before the launch),
     9	// and the validation set (device, dtype, compact strides with size-1 dimensions free, byte_offset, alignment, output
    10	// overlap, read-only/copied refusal for written operands).
    11	#pragma once
    12	
    13	#include <dlpack/dlpack.h>
    14	#include <pybind11/pybind11.h>
    15	
    16	#include <cstdint>
    17	#include <initializer_list>
    18	#include <string>
    19	#include <vector>
    20	
    21	struct CUevent_st;  // cudaEvent_t is `CUevent_st*` (CUDA driver_types.h); kept opaque in this header
    22	
    23	namespace tcs {
    24	namespace py = pybind11;
    25	
    26	// A DLPack capsule for `obj`: `obj` itself when it is a capsule, else `obj.__dlpack__(stream=1, max_version=(1, 3)
    27	// [, copy=False])`, falling back to `obj.__dlpack__(stream=1)` when the producer rejects the newer keywords with a
    28	// TypeError (pre-2023 producers). `writable` adds copy=False: a written operand must alias the producer's memory.
    29	py::object to_capsule(py::handle obj, const char* role, bool writable);
    30	
    31	// The DLTensor inside an unconsumed capsule (the capsule keeps ownership). Raises ValueError for a consumed capsule,
    32	// TypeError for a capsule of another kind.
    33	const DLTensor* peek(py::handle capsule, const char* role);
    34	
    35	// Device / dtype / layout checks shared by peek-time and consume-time validation (raises TypeError/ValueError). Also
    36	// the F03 (P1T-FIX1) checked arithmetic: rank >= 0, a non-NULL shape array, the element count, the fp32 byte total and
    37	// data + byte_offset + bytes must not overflow (ValueError). Returns the element count.
    38	int64_t validate_tensor(const DLTensor* t, const char* role, int ndim);
    39	
    40	// F02 (P1T-FIX1): a REQUIRED operand passed as None raises TypeError, before any planning, allocation or consumption.
    41	// Optional operands (bias, scale, initial state) are the only ones a caller may pass as None.
    42	void require_operand(py::handle obj, const char* role);
    43	
    44	// Owner of one consumed managed tensor (legacy or versioned). Calls the producer's deleter exactly once, in reset() or
    45	// in the destructor. It is a separate member so that a throw from Operand's constructor (after the capsule has been
    46	// consumed) still runs it: C++ destroys fully constructed members when a constructor throws.
