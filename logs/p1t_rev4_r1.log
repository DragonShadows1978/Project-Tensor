   739	  // call (MemoryError, operands released at once), so returning the event to the pool later never allocates.
   740	  if (test_hooks::take(test_hooks::kAllocEventPoolReserve)) throw std::bad_alloc();
   741	  if (de.free.capacity() < de.created + 1) de.free.reserve(std::max<size_t>(2 * de.free.capacity(), de.created + 1));
