   168	# P1T-FIX2 (N5): interpreter-exit coordination for DLPack import releases that
   169	# need the GIL (bindings.cpp, ImportReleaseLifecycle). CPython runs atexit
   170	# callbacks before it marks the runtime finalizing (v3.12.3 pylifecycle.c,
   171	# Py_FinalizeEx: _PyAtExit_Call at line 1815, _PyRuntimeState_SetFinalizing at
   172	# 1833), so this hook closes admission while taking the GIL is still safe and
   173	# waits for the releases already admitted.
   174	# P1T-FIX3 (round-3 review V3-01): that wait has NO bound any more; FIX2's
   175	# bounded return let finalization start while an admitted deleter was still
   176	# running, and the process aborted when the deleter re-took the GIL. Knob: the
   177	# time waited, in seconds, before the first stderr diagnostic (a release
   178	# normally finishes in microseconds, so this only fires for a producer deleter
   179	# that blocks); later diagnostics are written each time the time waited has
   180	# doubled. Prior art: CPython's own threading._shutdown (joins non-daemon
   181	# threads before finalizing, with no bound), the same "stop admitting, then wait
   182	# for what already started" order; RCU-style grace periods (an unbounded wait
   183	# for pre-existing readers) and the kernel's repeated stall warnings. Ours:
   184	# applying them to the DLPack release at the atexit boundary.
   185	_DLPACK_SHUTDOWN_WAIT_S = 5.0
   186	
   187	
   188	def _dlpack_shutdown_hook():
   189	    """atexit hook (P1T-FIX2 N5, P1T-FIX3 V3-01): close admission of GIL-taking
   190	    DLPack import releases, then wait until every release admitted before that
   191	    has finished. Interpreter finalization never starts while one is running.
   192	
   193	    The wait has no bound. After ``_DLPACK_SHUTDOWN_WAIT_S`` seconds a line goes
   194	    to stderr (how many are still running, seconds waited), and another each
   195	    time the time waited doubles; the wait goes on. Consequence: a producer
   196	    deleter that never returns makes interpreter exit wait forever. That is the
   197	    producer's DLPack contract violation (a deleter must return), and waiting is
   198	    the honest outcome: returning early would let CPython finalize under a
   199	    running callback and abort the process (round-3 review V3-01, rc -6). Ctrl-C
   200	    does not interrupt the wait; SIGTERM / SIGKILL still end the process.
   201	    Releases that start after admission closed are deliberately leaked (no GIL
   202	    is taken), as before. Never raises (an atexit exception has no handler).
   203	    """
   204	    try:
   205	        try:
   206	            first_diag_s = float(_DLPACK_SHUTDOWN_WAIT_S)
   207	        except (TypeError, ValueError):
   208	            first_diag_s = float("nan")  # an unusable knob must not skip the wait: diagnose at once, still wait
   209	        r = _C._dlpack_begin_shutdown(first_diag_s)
   210	        if r["timed_out"]:
   211	            sys.stderr.write(
   212	                f"tensor_cuda: the DLPack release(s) admitted before exit finished after "
   213	                f"{r['waited_us'] / 1e6:.1f} s; interpreter exit continues\n")
   214	            sys.stderr.flush()
   215	    except Exception as e:  # noqa: BLE001
   216	        try:
   217	            sys.stderr.write(f"tensor_cuda: DLPack exit hook failed ({type(e).__name__}: {e})\n")
   218	            sys.stderr.flush()
   219	        except Exception:  # noqa: BLE001
   220	            pass
   221	
   222	
   223	atexit.register(_dlpack_shutdown_hook)
