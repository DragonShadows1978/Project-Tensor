   831	    return;
   832	  }
   833	  if (pending_over_bound(st)) {  // V3-02: overflow-safe (saturating total), exact at the boundary
   834	    ++st.bound_drains;
   835	    const SyncReport rep = sync_and_release_all_impl();
   836	    if (rep.failed()) note_release_failure(st, rep.first_device(), rep.first_error(), rep.leaked_managers);  // N1
   837	  }
   838	}
   839	
   840	void drain_completed() noexcept {
   841	  PendingState& st = pending();
   842	  while (!st.q.empty()) {
   843	    const cudaError_t r = cudaEventQuery(st.q.front().event);
   844	    if (r != cudaSuccess) {
   845	      // cudaErrorNotReady: still pending (FIFO: later entries wait too). CUDA 12.6 does not leave NotReady in the
   846	      // last-error slot (ledger receipt); clear it defensively if a runtime ever does. Any other error (a broken
   847	      // context) leaves the entry for synchronize_and_release_all, which leaks it if the device cannot synchronize.
   848	      if (r == cudaErrorNotReady && cudaPeekAtLastError() == cudaErrorNotReady) cudaGetLastError();
   849	      return;
   850	    }
   851	    PendingEntry e = std::move(st.q.front());
   852	    st.q.pop_front();
   853	    note_pop(st, e);
   854	    release_entry(st, e);
   855	  }
   856	}
   857	
   858	void synchronize_and_release_all() {
   859	  const SyncReport rep = sync_and_release_all_impl();
   860	  PendingState& st = pending();
   861	  if (!rep.failed() && st.unreported_count == 0) return;
   862	  // N1: any CUDA failure is an error of synchronize(), never a success. N3: building the message may allocate; a
   863	  // bad_alloc here propagates as MemoryError (an error, not a success, and not a terminate). The earlier release-path
   864	  // failures are cleared only once their message exists, so they are raised exactly once.
   865	  if (test_hooks::take(test_hooks::kAllocErrorMessage)) throw std::bad_alloc();
   866	  std::ostringstream os;
   867	  os << "tc_signal.synchronize: CUDA error, so the release is not reported as a success:";
   868	  const char* sep = " ";
   869	  if (rep.query_failed) {
   870	    os << sep << "the current-device query cudaGetDevice failed (" << cudaGetErrorName(rep.query_error) << ": "
   871	       << cudaGetErrorString(rep.query_error) << ")";
   872	    sep = "; ";
   873	  }
   874	  for (int i = 0; i < rep.n; ++i) {
   875	    os << sep << "the legacy stream of device " << rep.dev[i] << " could not be synchronized ("
   876	       << cudaGetErrorName(rep.err[i]) << ": " << cudaGetErrorString(rep.err[i]) << ")";
   877	    sep = "; ";
   878	  }
   879	  if (rep.unnamed > 0) os << sep << rep.unnamed << " more device failure(s)";
   880	  if (rep.leaked_managers > 0)
   881	    os << "; " << rep.leaked_managers
   882	       << " consumed operand manager(s) still pending there were deliberately leaked, not released";
   883	  if (st.unreported_count > 0) {
   884	    os << sep << st.unreported_count << " earlier release-path failure(s) since the last synchronize, the first on device "
   885	       << st.unreported_device << " (" << cudaGetErrorName(st.unreported_error) << ": "
   886	       << cudaGetErrorString(st.unreported_error) << "), deliberately leaked " << st.unreported_leaked
   887	       << " operand manager(s)";
   888	  }
   889	  // std::ostream swallows a bad_alloc from its buffer and only sets badbit (a truncated message would follow): report
   890	  // the allocation failure itself instead.
   891	  if (!os) throw std::bad_alloc();
   892	  std::string msg = os.str();
   893	  st.unreported_count = 0;
   894	  st.unreported_leaked = 0;
   895	  st.unreported_device = -1;
   896	  st.unreported_error = cudaSuccess;
   897	  throw std::runtime_error(msg);
   898	}
