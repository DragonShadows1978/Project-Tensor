   146	def empty(*shape, dtype="float32", device="cuda"):
   147	    """Uninitialized tensor allocated on the device by the engine's allocator.
   148	
   149	    Amendment 1 (P1T-M1): binds ``NDArray::empty`` with no host round-trip and
   150	    no fill, so the CONTENTS ARE UNINITIALIZED (whatever the allocator hands
   151	    back). Shape conventions match ``zeros``: ``empty(2, 3)``,
   152	    ``empty((2, 3))`` or ``empty([2, 3])``; ``empty()`` is 0-d. Returns a
   153	    Tensor with ``requires_grad=False``. Unlike ``zeros``, an unknown dtype
   154	    string raises instead of falling back to float32. More than 8 dimensions
   155	    (TensorCUDA's maximum rank), a negative extent, or an element count or
   156	    byte size that overflows 64-bit arithmetic raises ``ValueError`` before
   157	    anything is allocated (P1T-FIX1 F03). Every nonzero extent counts, also
   158	    when another extent is 0 (P1T-FIX2 N2): the product of the extents with
   159	    zeros counted as 1, times the element size, must fit in int64, so
   160	    ``empty(0, 2**62, 4)`` raises while ``empty(0, 2**60)`` is an empty tensor
   161	    (NumPy's rule).
   162	    """
   163	    if len(shape) == 1 and isinstance(shape[0], (tuple, list)):
   164	        shape = tuple(shape[0])
   165	    return _C.empty([operator.index(s) for s in shape], dtype, device)
