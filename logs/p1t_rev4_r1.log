   689	  PendingState& st = pending();
   690	  SyncReport rep;
   691	  DeviceSyncSet set;
   692	  int cur = -1;
   693	  const cudaError_t qe = cudaGetDevice(&cur);
   694	  if (qe != cudaSuccess) {
   695	    cudaGetLastError();
   696	    rep.query_failed = true;  // N1: was silently skipped (synchronize() then "succeeded" with no device)
   697	    rep.query_error = qe;
   698	  } else {
   699	    set.sync(cur);
   700	  }
   701	  for (const PendingEntry& e : st.q) set.sync(e.device);
   702	  for (int i = 0; i < set.n; ++i)
   703	    if (set.err[i] != cudaSuccess) rep.add(set.dev[i], set.err[i]);
   704	  if (set.spill_failed) rep.add(-1, set.spill_error);
   705	
   706	  while (!st.q.empty()) {
   707	    const cudaError_t r = cudaEventQuery(st.q.front().event);
   708	    const int dev = st.q.front().device;
   709	    const bool complete = (r == cudaSuccess);
   710	    if (!complete) {
   711	      if (r == cudaErrorNotReady) {
   712	        if (cudaPeekAtLastError() == cudaErrorNotReady) cudaGetLastError();
   713	        if (!set.failed(dev)) break;  // pushed after phase 1 (re-entrant call): not ours to force
   714	      } else {
   715	        cudaGetLastError();           // the event itself cannot be queried: no completion proof (N1: an error)
   716	        rep.add(dev, r);
   717	      }
   718	    }
