    74	  if (!py::hasattr(obj, "__dlpack__"))
    75	    refuse_type(role, "expected a DLPack producer (an object with __dlpack__) or a DLPack capsule, got " +
    76	                          type_name(obj));
    77	  // Array API order: ask the producer's device first. A non-CUDA producer is refused here, before __dlpack__ is
    78	  // called with a CUDA stream argument (CPU producers such as NumPy reject any stream other than None).
    79	  if (py::hasattr(obj, "__dlpack_device__")) {
    80	    int device_type = -1;
    81	    try {
    82	      py::tuple dev = obj.attr("__dlpack_device__")().cast<py::tuple>();
    83	      device_type = dev[0].cast<int>();
    84	    } catch (py::cast_error&) {
    85	      refuse_type(role, "__dlpack_device__() did not return a (device_type, device_id) tuple of ints");
    86	    }
    87	    if (device_type != kDLCUDA) {
    88	      std::ostringstream os;
    89	      os << "device type " << device_type << " is not kDLCUDA (2); tc_signal takes CUDA device memory only";
    90	      refuse_value(role, os.str());
    91	    }
    92	  }
    93	  py::object fn = obj.attr("__dlpack__");
    94	  py::object cap;
    95	  const py::tuple max_version = py::make_tuple(tuning::kDlpackMaxMajor, tuning::kDlpackMaxMinor);
    96	  try {
    97	    // Consumer stream = the legacy default stream (DLPack int 1): the producer orders its pending work before it.
    98	    if (writable)
    99	      cap = fn(py::arg("stream") = tuning::kDlpackLegacyStream, py::arg("max_version") = max_version,
   100	               py::arg("copy") = false);
   101	    else
   102	      cap = fn(py::arg("stream") = tuning::kDlpackLegacyStream, py::arg("max_version") = max_version);
   103	  } catch (py::error_already_set& e) {
   104	    // A producer that predates the 2023 keywords rejects them with TypeError: retry with the stream argument only
   105	    // (the array API standard's documented fallback; NumPy and PyTorch consumers do the same).
   106	    if (!e.matches(PyExc_TypeError)) throw;
   107	    cap = fn(py::arg("stream") = tuning::kDlpackLegacyStream);
   108	  }
   109	  if (!PyCapsule_CheckExact(cap.ptr()))
   110	    refuse_type(role, "__dlpack__ returned " + type_name(cap) + ", not a PyCapsule");
   111	  return cap;
   112	}
   113	
   114	const DLTensor* peek(py::handle capsule, const char* role) {
   115	  if (!PyCapsule_CheckExact(capsule.ptr())) refuse_type(role, "expected a DLPack capsule, got " + type_name(capsule));
   116	  if (capsule_kind(capsule, role)) {
   117	    auto* m = static_cast<DLManagedTensorVersioned*>(capsule_pointer(capsule, kCapsuleVersioned));
   118	    check_version(m, role);
   119	    return &m->dl_tensor;
   120	  }
   121	  auto* m = static_cast<DLManagedTensor*>(capsule_pointer(capsule, kCapsule));
   122	  return &m->dl_tensor;
   123	}
   124	
   125	// ------------------------------------------------------------------------------------------------ validation
   126	int64_t validate_tensor(const DLTensor* t, const char* role, int ndim) {
   127	  if (t->device.device_type != kDLCUDA) {
   128	    std::ostringstream os;
   129	    os << "device type " << static_cast<int>(t->device.device_type)
   130	       << " is not kDLCUDA (2); tc_signal takes CUDA device memory only";
   131	    refuse_value(role, os.str());
   132	  }
   133	  if (t->dtype.code != kDLFloat || t->dtype.bits != 32 || t->dtype.lanes != 1) {
   134	    std::ostringstream os;
   135	    os << "dtype (code " << static_cast<int>(t->dtype.code) << ", bits " << static_cast<int>(t->dtype.bits)
   136	       << ", lanes " << t->dtype.lanes
   137	       << ") is not float32; tc_signal computes in fp32 only (expand fp16 weights to fp32 first)";
   138	    refuse_type(role, os.str());
   139	  }
   140	  // F03 (P1T-FIX1): a negative rank or a NULL shape array (with rank > 0) is refused before the shape is read.
   141	  if (t->ndim < 0) {
   142	    std::ostringstream os;
   143	    os << "negative number of dimensions " << t->ndim;
   144	    refuse_value(role, os.str());
   145	  }
   146	  if (t->ndim > 0 && t->shape == nullptr) refuse_value(role, "NULL shape array for a tensor with dimensions");
   147	  if (t->ndim != ndim) {
   148	    std::ostringstream os;
   149	    os << "expected " << ndim << " dimensions, got " << t->ndim;
   150	    refuse_value(role, os.str());
   151	  }
   152	  // F03: checked element count and fp32 byte total, before the stride walk below multiplies extents and before any
   153	  // later byte range is formed.
   154	  // P1T-FIX2, review finding N2 (zero-extent rule, checked_math.h ck_extent_bound): EVERY extent is multiplied (a zero
   155	  // or negative one counted as 1) BEFORE the empty-operand refusal, so a shape such as [0, 2^62, 4] is refused as an
   156	  // overflow, never waved through because its count is 0. Prior art: NumPy's array constructor rule (see
   157	  // checked_math.h); the checked builtins (GCC 5, 2015).
   158	  int64_t numel = 1;
   159	  for (int i = 0; i < t->ndim; ++i) {
   160	    if (__builtin_mul_overflow(numel, t->shape[i] > 1 ? t->shape[i] : int64_t{1}, &numel))
   161	      refuse_value(role, "element count of shape " + shape_str(shape_of(t)) +
   162	                             " overflows int64 (every nonzero extent counts, also next to a zero extent)");
   163	  }
   164	  int64_t nbytes = 0;
   165	  if (__builtin_mul_overflow(numel, static_cast<int64_t>(sizeof(float)), &nbytes))
   166	    refuse_value(role, "byte size of shape " + shape_str(shape_of(t)) + " (fp32) overflows int64");
   167	  for (int i = 0; i < t->ndim; ++i)
   168	    if (t->shape[i] <= 0) refuse_value(role, "empty operand (shape " + shape_str(shape_of(t)) + ")");
   169	  // Every extent is >= 1 from here: numel is the element count and nbytes its fp32 byte size.
   170	  if (t->strides != nullptr) {
   171	    // C-contiguous: every dimension of extent > 1 has the compact stride; size-1 dimensions may carry any stride
   172	    // (they are never stepped), as the order and the DLPack/array API conventions allow.
   173	    int64_t want = 1;
   174	    for (int i = t->ndim - 1; i >= 0; --i) {
   175	      if (t->shape[i] != 1 && t->strides[i] != want) {
   176	        std::ostringstream os;
   177	        os << "not C-contiguous (shape " << shape_str(shape_of(t)) << ", strides [";
   178	        for (int j = 0; j < t->ndim; ++j) os << (j ? ", " : "") << t->strides[j];
   179	        os << "]); pass a contiguous tensor";
   180	        refuse_value(role, os.str());
   181	      }
   182	      want *= t->shape[i];
   183	    }
   184	  }
   185	  if (t->data == nullptr) refuse_value(role, "NULL data pointer");
   186	  // F03: data + byte_offset (element 0) and element 0 + nbytes (one past the end) must not wrap the address space.
   187	  uintptr_t p = 0;
   188	  uintptr_t end = 0;
   189	  if (__builtin_add_overflow(reinterpret_cast<uintptr_t>(t->data), static_cast<uintptr_t>(t->byte_offset), &p) ||
   190	      __builtin_add_overflow(p, static_cast<uintptr_t>(nbytes), &end))
   191	    refuse_value(role, "data + byte_offset + byte size overflows the address space");
   192	  if (p % alignof(float) != 0) refuse_value(role, "data + byte_offset is not 4-byte aligned");
   193	  return numel;
   194	}
   195	
   196	void require_operand(py::handle obj, const char* role) {
   197	  // F02 (P1T-FIX1): None is never a tensor. Refused with TypeError before any planning, allocation or consumption.
   198	  if (obj.is_none())
   199	    refuse_type(role, "is required: expected a DLPack producer (an object with __dlpack__) or a DLPack capsule, got "
   200	                      "None (only optional operands such as a bias may be None)");
   201	}
