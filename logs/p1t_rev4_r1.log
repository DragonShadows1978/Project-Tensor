"""tc_signal: TensorCUDA add-on for signal ops (P1T-M2: Conv1d T2, ConvTranspose1d T3).

A separate package next to `tensor_cuda/` (David, 2026-10-12: keep core free of these kernels). It consumes any DLPack
CUDA producer (TensorCUDA tensors once M1 lands, torch tensors for testing), computes in fp32 on the legacy default
stream, deterministically (no atomics, no fast-math, cuBLAS in default math mode), and allocates outputs and scratch
through the module allocator (`set_allocator`). Usage: `PYTHONPATH=<Project-Tensor>/tc_signal`, then
`import tc_signal`.

API (exact, order P1T-M2):
    conv1d(x, w, b=None, *, stride=1, padding=0, dilation=1, groups=1, out=None)
    conv_transpose1d(x, w, b=None, *, stride=1, padding=0, output_padding=0, dilation=1, groups=1, out=None)
    set_allocator(fn)   # fn(shape: tuple) -> fp32 CUDA DLPack tensor; returns the previous allocator

Semantics are ONNX Conv / ConvTranspose (1-D): x [N, C_in, T]; conv1d w [C_out, C_in/groups, K]; conv_transpose1d
w [C_in, C_out/groups, K]; b [C_out] or None; padding an int or (pad_begin, pad_end).

Prior art: ONNX Conv/ConvTranspose operator specs (semantics); DLPack (dmlc/dlpack v1.3) and the Python array API
data-interchange protocol (operand exchange); im2col (Chellapilla, Puri & Simard 2006) and gather-form transposed
convolution (Dumoulin & Visin 2016) for the kernels (see src/conv.cu). The pluggable allocator callback mirrors CuPy's
`cupy.cuda.set_allocator` (CuPy, 2017-), which also returns control of allocation to the caller; ours differs in that
the allocator returns a DLPack tensor, not a raw pointer.
"""
from __future__ import annotations

import atexit
import operator
import sys

from . import _tc_signal as _C

__all__ = ['conv1d', 'conv_transpose1d', 'set_allocator', 'synchronize']

_SET_ALLOCATOR_HINT = ('call tc_signal.set_allocator(fn), where fn(shape: tuple) returns a float32 CUDA tensor that '
                       'implements __dlpack__ (for example lambda s: torch.empty(s, device="cuda"))')


def _default_allocator(shape):
    """`tensor_cuda.empty(*shape, dtype="float32")` (added by P1T-M1). Raises RuntimeError naming set_allocator when
    tensor_cuda is not importable, lacks `empty`, or its tensors do not export DLPack yet."""
    try:
        import tensor_cuda
    except ImportError as e:
        raise RuntimeError(f'tc_signal: the default allocator needs tensor_cuda.empty, but tensor_cuda is not '
                           f'importable ({e}); {_SET_ALLOCATOR_HINT}') from e
    empty = getattr(tensor_cuda, 'empty', None)
    if empty is None:
        raise RuntimeError('tc_signal: the default allocator needs tensor_cuda.empty (P1T-M1), which this '
                           f'tensor_cuda does not have; {_SET_ALLOCATOR_HINT}')
    t = empty(*shape, dtype='float32')
    if not hasattr(t, '__dlpack__'):
        raise RuntimeError('tc_signal: tensor_cuda.empty returned a tensor without __dlpack__ (P1T-M1 DLPack export '
                           f'missing); {_SET_ALLOCATOR_HINT}')
    return t


_allocator = _default_allocator


def set_allocator(fn):
    """Set the allocator used for outputs (out=None) and im2col scratch: fn(shape: tuple) -> fp32 CUDA DLPack tensor of
    exactly that shape. Returns the previous allocator. `None` restores the default (tensor_cuda.empty)."""
    global _allocator
    if fn is not None and not callable(fn):
        raise TypeError(f'tc_signal.set_allocator: expected a callable or None, got {type(fn).__name__}')
    prev = _allocator
    _allocator = _default_allocator if fn is None else fn
    return prev


def _int(name, v):
    if isinstance(v, bool):
        raise TypeError(f'tc_signal: {name} must be an int, got bool')
    try:
        return operator.index(v)
    except TypeError:
        raise TypeError(f'tc_signal: {name} must be an int, got {type(v).__name__}') from None


def _pads(padding):
    if isinstance(padding, (tuple, list)):
        if len(padding) != 2:
            raise ValueError(f'tc_signal: padding must be an int or (pad_begin, pad_end), got {padding!r}')
        return _int('padding[0]', padding[0]), _int('padding[1]', padding[1])
    p = _int('padding', padding)
    return p, p


def conv1d(x, w, b=None, *, stride=1, padding=0, dilation=1, groups=1, out=None):
    """ONNX Conv, 1-D: y[n, o, t] = b[o] + sum_{c in group(o), k} w[o, c, k] * x_pad[n, c, t*stride + k*dilation].

    x [N, C_in, T], w [C_out, C_in/groups, K], b [C_out] or None (fp32 CUDA DLPack producers or capsules).
    Output [N, C_out, (T + pb + pe - dilation*(K-1) - 1)//stride + 1], written into `out` if given, else allocated
    through the module allocator. Returns `out`."""
    pb, pe = _pads(padding)
    s, d, g = _int('stride', stride), _int('dilation', dilation), _int('groups', groups)
    xc, wc, bc, out_shape, scratch_numel = _C.conv1d_plan(x, w, b, s, pb, pe, d, g)
    if out is None:
        out = _allocator(tuple(out_shape))
    scratch = _allocator((scratch_numel,)) if scratch_numel > 0 else None
    _C.conv1d_run(xc, wc, bc, out, scratch, s, pb, pe, d, g)
    return out


def conv_transpose1d(x, w, b=None, *, stride=1, padding=0, output_padding=0, dilation=1, groups=1, out=None):
    """ONNX ConvTranspose, 1-D (gather form, deterministic): x [N, C_in, T], w [C_in, C_out/groups, K] (ONNX layout),
    b [C_out] or None. Output [N, C_out, stride*(T-1) + output_padding + dilation*(K-1) + 1 - pb - pe], written into
    `out` if given, else allocated through the module allocator. Returns `out`."""
    pb, pe = _pads(padding)
    s, op, d, g = (_int('stride', stride), _int('output_padding', output_padding), _int('dilation', dilation),
                   _int('groups', groups))
    xc, wc, bc, out_shape = _C.conv_transpose1d_plan(x, w, b, s, pb, pe, op, d, g)
    if out is None:
        out = _allocator(tuple(out_shape))
    _C.conv_transpose1d_run(xc, wc, bc, out, s, pb, pe, op, d, g)
    return out


def synchronize():
    """Wait until the legacy default stream has passed every tc_signal launch queued so far, then release every consumed
    operand tc_signal still holds (P1T-FIX1, F01 deferred release; see README "Streams and lifetimes").

    tc_signal keeps each call's consumed DLPack managers (inputs, outputs, scratch) alive until the legacy stream has
    passed that call, and releases completed ones at the start of the next tc_signal call. Call synchronize() to release
    them now (for example before measuring memory, or before handing a producer's memory back by other means). It
    synchronizes the legacy stream of the current device and of every device with pending operands (stream syncs, not a
    device-wide sync).

    Errors (P1T-FIX2, N1): a CUDA failure is never reported as success. RuntimeError, naming the CUDA error, when
    - the current-device query (cudaGetDevice) fails, for example on a machine with no usable CUDA device, even when
      nothing is pending;
    - a device's legacy stream cannot be synchronized (its pending operands are then deliberately leaked, never
      released early);
    - an earlier release that could not raise failed (the fallback sync or the bound drain inside a tc_signal call); such
      a failure is raised once, by the next synchronize().
    MemoryError if the error message itself cannot be allocated. Prior art: torch.cuda.synchronize /
    cupy.cuda.Stream.synchronize (API shape only)."""
    _C.synchronize()


def _release_pending_at_exit():
    # atexit (runs before interpreter finalization, GIL held): release whatever is still pending. P1T-FIX2 (N1): an
    # error is never swallowed silently; it is LOGGED to stderr (one line) and not raised (an exception from an atexit
    # callback cannot be handled by anyone). The operands without a completion proof stay deliberately leaked; there is
    # nothing else safe to do at exit. Prior art: CPython's atexit, which itself prints (not raises) a callback's
    # exception; taken: log-don't-raise at exit.
    try:
        _C.synchronize()
    except Exception as e:  # noqa: BLE001
        try:
            sys.stderr.write(f'tc_signal: synchronize() at exit failed ({type(e).__name__}: {e}); operands without a '
                             f'completion proof were deliberately leaked, not released\n')
            sys.stderr.flush()
        except Exception:  # noqa: BLE001  (stderr may already be closed at exit)
            pass


atexit.register(_release_pending_at_exit)


from ._lstm import lstm  # noqa: E402,F401  (P1T-M3: tc_signal/_lstm.py)
__all__.append('lstm')


from ._norms import group_norm, instance_norm1d, layer_norm  # noqa: E402  (P1T-M4, T5)
from ._small import reflection_pad1d, rint, upsample_nearest1d  # noqa: E402  (P1T-M4, T6)
__all__ += ['instance_norm1d', 'layer_norm', 'group_norm', 'upsample_nearest1d', 'reflection_pad1d', 'rint']
"""tc_signal.lstm: ONNX-semantics LSTM (P1T-M3, T4), forward only, fp32, deterministic.

    lstm(x, W, R, B=None, *, hidden_size, direction="forward", initial_h=None, initial_c=None,
         sequence_lens=None, layout=0, out=None) -> (Y, Y_h, Y_c)

Semantics: ONNX LSTM, layout 0, default activations (Sigmoid, Tanh, Tanh), no clip, no peepholes, input_forget 0.
 * x [T, N, I]; W [D, 4H, I]; R [D, 4H, H]; B [D, 8H] = [Wb; Rb] or None (zeros); initial_h / initial_c [D, N, H] or
   None (zeros). Gate blocks along 4H are in the ONNX order i, o, f, c (torch's nn.LSTM uses i, f, g, o).
 * direction "forward" or "reverse" (D = 1) or "bidirectional" (D = 2: index 0 forward, index 1 reverse).
 * Returns Y [T, D, N, H], Y_h [D, N, H], Y_c [D, N, H]: new tensors from tc_signal's allocator (set_allocator; the
   default is tensor_cuda.empty), or the caller's `out=(Y, Y_h, Y_c)`, which is returned as given.
 * Every operand is any fp32 CUDA DLPack producer (TensorCUDA or torch tensors) or a DLPack capsule.

Refused (never silently approximated):
 * layout != 0 (ValueError); sequence_lens other than None or "every entry equals T" (ValueError; a non-integer
   sequence_lens is a TypeError). sequence_lens is only validated, never read by the kernel; a device tensor is copied
   to the host for that check (TensorCUDA `.numpy()`, torch `.cpu()`);
 * clip, peepholes (ONNX input P), input_forget and non-default activations: the signature has no such parameter, so
   passing one raises TypeError;
 * every shape mismatch, non-fp32 / non-CUDA / non-contiguous / misaligned operands, mismatched devices, an `out` that
   is not a 3-sequence, and any output or scratch aliasing another operand (M2's operand contract, dlpack_operand.h).

Execution: one `_tc_signal.lstm_plan` call peeks the inputs; this layer allocates Y, Y_h, Y_c and ONE scratch operand
(projected inputs G_x [D, T, N, 4H] then the per-step gate buffer G_h [D, N, 4H]) through the allocator; one
`_tc_signal.lstm_run` call then runs the whole recurrence in C++ (src/lstm.cu): one input-projection SGEMM per
direction (+ Wb), then a host C++ loop over the T steps, each one strided-batched SGEMM over the directions
(h_{t-1} . R^T) and one fused cell kernel. No Python loop over steps, no per-step DLPack capsules. Everything is queued
on the legacy default stream; the results are ready in stream order (a later TensorCUDA op or a `.numpy()` download
on the legacy stream sees them).

Prior art: the ONNX LSTM operator spec (semantics); Hochreiter & Schmidhuber 1997 (LSTM) and Gers, Schmidhuber &
Cummins 2000 (forget gate); Appleyard, Kocisky & Blunsom 2016 / the cuDNN RNN design (the input projection hoisted out
of the recurrence); the sign-split stable sigmoid (standard practice). Details and what is ours: src/lstm.cu.
The Python plan/allocate/run flow is M2's (tc_signal/__init__.py conv1d); no new prior art here.
"""
from __future__ import annotations

import operator
import sys

from . import _tc_signal as _C

# ONNX direction attribute -> the C++ direction code (lstm_bindings.cpp).
_DIRECTIONS = {'forward': 0, 'reverse': 1, 'bidirectional': 2}
# ONNX `layout` attribute: 0 = x [T, N, I] (the only supported layout).
_LAYOUT_SEQ_FIRST = 0
# `out` is (Y, Y_h, Y_c).
_N_OUTPUTS = 3


def _package():
    """The tc_signal package module, read at call time so set_allocator's current allocator is used."""
    return sys.modules[__name__.rpartition('.')[0]]


def _int(name, v):
    if isinstance(v, bool):
        raise TypeError(f'tc_signal.lstm: {name} must be an int, got bool')
    try:
        return operator.index(v)
    except TypeError:
        raise TypeError(f'tc_signal.lstm: {name} must be an int, got {type(v).__name__}') from None


def _host_array(seq):
    """sequence_lens as a host NumPy array: lists, tuples and NumPy arrays directly; TensorCUDA tensors through
    `.numpy()`; torch tensors through `.cpu().numpy()`."""
    import numpy as np
    if isinstance(seq, (list, tuple, np.ndarray)) or np.isscalar(seq):
        return np.asarray(seq)
    cpu = getattr(seq, 'cpu', None)
    if callable(cpu):                         # torch (CPU or CUDA)
        seq = cpu()
    to_numpy = getattr(seq, 'numpy', None)
    if callable(to_numpy):                    # TensorCUDA, torch CPU
        return np.asarray(to_numpy())
    return np.asarray(seq)


def _check_sequence_lens(sequence_lens, T, N):
    import numpy as np
    arr = _host_array(sequence_lens)
    if arr.dtype == object or not np.issubdtype(arr.dtype, np.integer):
        raise TypeError(f'tc_signal.lstm: sequence_lens must hold integers, got dtype {arr.dtype}')
    if arr.shape != (N,):
        raise ValueError(f'tc_signal.lstm: sequence_lens has shape {tuple(arr.shape)}, expected ({N},) = [batch]')
    if not bool(np.all(arr == T)):
        raise ValueError(f'tc_signal.lstm: sequence_lens {arr.tolist()} is not supported (refused): only None or every '
                         f'entry equal to T = {T} is implemented')


def lstm(x, W, R, B=None, *, hidden_size, direction='forward', initial_h=None, initial_c=None, sequence_lens=None,
         layout=0, out=None):
    """ONNX LSTM (layout 0, gates i, o, f, c; Sigmoid/Tanh/Tanh; no clip, no peepholes). See the module docstring.

    x [T, N, I], W [D, 4H, I], R [D, 4H, H], B [D, 8H] = [Wb; Rb] or None, initial_h / initial_c [D, N, H] or None.
    Returns (Y [T, D, N, H], Y_h [D, N, H], Y_c [D, N, H])."""
    H = _int('hidden_size', hidden_size)
    if not isinstance(direction, str) or direction not in _DIRECTIONS:
        raise ValueError(f'tc_signal.lstm: direction must be one of {sorted(_DIRECTIONS)}, got {direction!r}')
    lay = _int('layout', layout)
    if lay != _LAYOUT_SEQ_FIRST:
        raise ValueError(f'tc_signal.lstm: layout={lay} is not supported (refused); only ONNX layout 0 '
                         f'(x [T, N, I]) is implemented')
    if out is not None:
        if not isinstance(out, (tuple, list)):
            raise TypeError(f'tc_signal.lstm: out must be None or a 3-tuple (Y, Y_h, Y_c), got {type(out).__name__}')
        if len(out) != _N_OUTPUTS:
            raise ValueError(f'tc_signal.lstm: out must be a 3-tuple (Y, Y_h, Y_c), got {len(out)} entries')
    code = _DIRECTIONS[direction]
    (xc, wc, rc, bc, hc, cc, y_shape, state_shape, scratch_numel, T, N) = _C.lstm_plan(
        x, W, R, B, initial_h, initial_c, H, code)
    if sequence_lens is not None:
        _check_sequence_lens(sequence_lens, T, N)
    alloc = _package()._allocator
    if out is None:
        Y, Y_h, Y_c = alloc(tuple(y_shape)), alloc(tuple(state_shape)), alloc(tuple(state_shape))
    else:
        Y, Y_h, Y_c = out
    scratch = alloc((scratch_numel,))
    _C.lstm_run(xc, wc, rc, bc, hc, cc, Y, Y_h, Y_c, scratch, H, code)
    return Y, Y_h, Y_c
"""tc_signal T5 norms (P1T-M4): instance_norm1d, layer_norm, group_norm.

fp32 statistics (shifted two-pass: shift by the row's first sample, mean of the shifted row, then the centred sum of
squares; biased variance as ONNX), a fixed block-tree reduction order (deterministic, no atomics), and
y = (x - mean) * (1 / sqrtf(var + eps)) * scale + bias. Kernel and numerics notes: src/norms.cu. Operands are any fp32
CUDA DLPack producers (or capsules), C-contiguous; the output comes from the module allocator (tc_signal.set_allocator)
unless `out` is given; everything is queued on the legacy default stream.

Prior art: Ulyanov, Vedaldi & Lempitsky (2016) instance norm; Ba, Kiros & Hinton (2016) layer norm; Wu & He (2018)
group norm; ONNX InstanceNormalization / LayerNormalization / GroupNormalization-21 (semantics); Welford (1962) and
Chan, Golub & LeVeque (1983) (variance algorithms, two-pass and shifted data). Ours: the Python wrappers.
"""
from __future__ import annotations

import math
import numbers
import operator
import sys

from . import _tc_signal as _C

__all__ = ['instance_norm1d', 'layer_norm', 'group_norm']


def _alloc(shape):
    # The package's current allocator (tc_signal.set_allocator), read at call time.
    return sys.modules[__package__]._allocator(tuple(shape))


def _eps(eps):
    if isinstance(eps, bool) or not isinstance(eps, numbers.Real):
        raise TypeError(f'tc_signal: eps must be a real number, got {type(eps).__name__}')
    e = float(eps)
    if not math.isfinite(e) or e < 0.0:
        raise ValueError(f'tc_signal: eps must be a finite number >= 0, got {e!r}')
    return e


def _int(name, v):
    if isinstance(v, bool):
        raise TypeError(f'tc_signal: {name} must be an int, got bool')
    try:
        return operator.index(v)
    except TypeError:
        raise TypeError(f'tc_signal: {name} must be an int, got {type(v).__name__}') from None


def instance_norm1d(x, scale=None, bias=None, *, eps=1e-5, out=None):
    """ONNX InstanceNormalization on x [N, C, T]: per (n, c), mean and biased variance over T (fp32 statistics);
    y = (x - mean) / sqrt(var + eps) * scale[c] + bias[c]. scale, bias: [C] or None (1 and 0). Returns `out`."""
    e = _eps(eps)
    xc, sc, bc, out_shape = _C.instance_norm1d_plan(x, scale, bias, e)
    if out is None:
        out = _alloc(out_shape)
    _C.instance_norm1d_run(xc, sc, bc, out, e)
    return out


def layer_norm(x, scale=None, bias=None, *, axis=-1, eps=1e-5, out=None):
    """ONNX LayerNormalization: normalize over the axes [axis, rank) with the biased variance (fp32 statistics, whatever
    eps: 1e-5 and 1e-12 both honoured); y = xhat * scale + bias with scale, bias of shape x.shape[axis:] or None.
    Returns `out`."""
    a = _int('axis', axis)
    e = _eps(eps)
    xc, sc, bc, out_shape = _C.layer_norm_plan(x, scale, bias, a, e)
    if out is None:
        out = _alloc(out_shape)
    _C.layer_norm_run(xc, sc, bc, out, a, e)
    return out


def group_norm(x, num_groups, scale=None, bias=None, *, eps=1e-5, out=None):
    """GroupNorm (ONNX GroupNormalization-21 / torch.nn.GroupNorm) on x [N, C, T]: mean and biased variance over each
    group's (C/num_groups, T) block (fp32 statistics); per-CHANNEL affine: scale, bias [C] or None. Returns `out`."""
    g = _int('num_groups', num_groups)
    e = _eps(eps)
    xc, sc, bc, out_shape = _C.group_norm_plan(x, g, scale, bias, e)
    if out is None:
        out = _alloc(out_shape)
    _C.group_norm_run(xc, g, sc, bc, out, e)
    return out
"""tc_signal T6 small ops (P1T-M4): upsample_nearest1d, reflection_pad1d, rint. Bit-exact by construction (32-bit word
gathers; rintf). Kernel notes: src/small_ops.cu. Operands are any fp32 CUDA DLPack producers (or capsules),
C-contiguous; the time axis is the last axis; the output comes from the module allocator unless `out` is given;
everything is queued on the legacy default stream. TensorCUDA core's `round` is untouched.

Prior art: ONNX Resize (nearest, asymmetric, floor), Pad (reflect) and Round specs; IEEE 754 roundTiesToEven / C99 rint;
torch reflection_pad1d. Ours: the Python wrappers.
"""
from __future__ import annotations

import operator
import sys

from . import _tc_signal as _C

__all__ = ['upsample_nearest1d', 'reflection_pad1d', 'rint']


def _alloc(shape):
    # The package's current allocator (tc_signal.set_allocator), read at call time.
    return sys.modules[__package__]._allocator(tuple(shape))


def _int(name, v):
    if isinstance(v, bool):
        raise TypeError(f'tc_signal: {name} must be an int, got bool')
    try:
        return operator.index(v)
    except TypeError:
        raise TypeError(f'tc_signal: {name} must be an int, got {type(v).__name__}') from None


def upsample_nearest1d(x, scale, *, out=None):
    """ONNX Resize nearest (asymmetric, floor) on the last axis at an INTEGER scale >= 1:
    y[..., i] = x[..., i // scale], output length T * scale. Non-integer scales are refused (TypeError). Returns `out`."""
    s = _int('scale (upsample_nearest1d takes integer scales only)', scale)
    if s < 1:
        raise ValueError(f'tc_signal: upsample_nearest1d: scale must be an integer >= 1, got {s}')
    xc, out_shape = _C.upsample_nearest1d_plan(x, s)
    if out is None:
        out = _alloc(out_shape)
    _C.upsample_nearest1d_run(xc, out, s)
    return out


def reflection_pad1d(x, pads, *, out=None):
    """ONNX Pad mode=reflect (torch reflection_pad1d) on the last axis: pads = (begin, end), each >= 0 and < T.
    Output length T + begin + end. Returns `out`."""
    if not isinstance(pads, (tuple, list)):
        raise TypeError(f'tc_signal: reflection_pad1d: pads must be a (begin, end) tuple or list, got '
                        f'{type(pads).__name__}')
    if len(pads) != 2:
        raise ValueError(f'tc_signal: reflection_pad1d: pads must be (begin, end), got {pads!r}')
    pb, pe = _int('pads[0]', pads[0]), _int('pads[1]', pads[1])
    if pb < 0 or pe < 0:
        raise ValueError(f'tc_signal: reflection_pad1d: pads must be >= 0, got ({pb}, {pe})')
    xc, out_shape = _C.reflection_pad1d_plan(x, pb, pe)
    if out is None:
        out = _alloc(out_shape)
    _C.reflection_pad1d_run(xc, out, pb, pe)
    return out


def rint(x, *, out=None):
    """ONNX Round: round half to even (rintf), sign of zero kept (rint(-0.4) = -0.0), +-Inf and NaN pass through.
    Any rank. Returns `out`."""
    xc, out_shape = _C.rint_plan(x)
    if out is None:
        out = _alloc(out_shape)
    _C.rint_run(xc, out)
    return out
# tc_signal: TensorCUDA add-on for signal ops (P1T-M2: Conv1d, ConvTranspose1d). Separate .so (_tc_signal); it does
# not link, include or compile anything from tensor_cuda/ (core). It shares core's CUDA runtime by linking the SAME
# shared libcudart.so.12 (CUDA 12.6), so one runtime instance, one context and one default memory pool serve both.
cmake_minimum_required(VERSION 3.18)
project(tc_signal LANGUAGES CXX CUDA)

set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CUDA_STANDARD 17)
set(CMAKE_POSITION_INDEPENDENT_CODE ON)

if(NOT CMAKE_BUILD_TYPE)
  set(CMAKE_BUILD_TYPE Release)
endif()

# Disable LTO/IPO, as core does (tensor_cuda/CMakeLists.txt): pybind11 adds -flto in Release unless this is defined,
# and nvcc's device-link LTO bytecode version does not match the host gcc's.
if(NOT DEFINED CMAKE_INTERPROCEDURAL_OPTIMIZATION)
  set(CMAKE_INTERPROCEDURAL_OPTIMIZATION OFF)
endif()

# Shared CUDA runtime (never cudart_static): one cudart instance with core.
set(CMAKE_CUDA_RUNTIME_LIBRARY Shared)

if(NOT DEFINED CMAKE_CUDA_ARCHITECTURES)
  set(CMAKE_CUDA_ARCHITECTURES 89)
endif()

# Numerics contract: no fast-math anywhere in this package, no per-thread default stream.
foreach(_flags CMAKE_CUDA_FLAGS CMAKE_CUDA_FLAGS_RELEASE CMAKE_CXX_FLAGS CMAKE_CXX_FLAGS_RELEASE)
  if("${${_flags}}" MATCHES "fast[-_]math|default-stream")
    message(FATAL_ERROR "tc_signal: ${_flags} ('${${_flags}}') carries a forbidden flag (fast-math or default-stream)")
  endif()
endforeach()

find_package(Python COMPONENTS Interpreter Development.Module REQUIRED)
find_package(CUDAToolkit REQUIRED)

# pybind11 v2.12.0, the same as core. Offline builds pass -DFETCHCONTENT_SOURCE_DIR_PYBIND11=<pybind11 source>
# (build.sh does this from PYBIND11_SOURCE_DIR); FetchContent then uses that tree and never touches the network.
include(FetchContent)
FetchContent_Declare(
  pybind11
  GIT_REPOSITORY https://github.com/pybind/pybind11.git
  GIT_TAG v2.12.0
)
FetchContent_MakeAvailable(pybind11)

pybind11_add_module(_tc_signal
  src/conv.cu
  src/dlpack_operand.cpp
  src/bindings.cpp
  src/lstm.cu
  src/lstm_bindings.cpp
  src/norms.cu
  src/small_ops.cu
  src/m4_bindings.cpp
)

target_include_directories(_tc_signal PRIVATE ${CMAKE_CURRENT_SOURCE_DIR}/include ${CMAKE_CURRENT_SOURCE_DIR}/src)
target_link_libraries(_tc_signal PRIVATE CUDA::cudart CUDA::cublas)

# RUNPATH = <real toolkit root>/lib64, the same string the production core module carries
# (/usr/local/cuda-12.6/lib64, from its scripts/apa_*_build.sh link line), so `ldd` resolves libcudart.so.12 to the
# same path for both modules. CMake's automatic build RPATH would record the symlink-resolved
# <root>/targets/x86_64-linux/lib instead (the same file, a different path string), so it is skipped here.
get_filename_component(_tcs_cuda_root "${CUDAToolkit_BIN_DIR}/.." REALPATH)
set(_tcs_cuda_rpath "${_tcs_cuda_root}/lib64")
if(NOT EXISTS "${_tcs_cuda_rpath}/libcudart.so.12")
  set(_tcs_cuda_rpath "${CUDAToolkit_LIBRARY_DIR}")
endif()
message(STATUS "tc_signal: RUNPATH ${_tcs_cuda_rpath}")
target_link_options(_tc_signal PRIVATE "LINKER:-rpath,${_tcs_cuda_rpath}")

set_target_properties(_tc_signal PROPERTIES
  SKIP_BUILD_RPATH ON
  CUDA_RUNTIME_LIBRARY Shared
  # Drop the built module straight into the Python package directory.
  LIBRARY_OUTPUT_DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR}/tc_signal
)
#!/usr/bin/env bash
# Build the tc_signal add-on and drop _tc_signal.*.so into tc_signal/tc_signal/.
# Usage:  ./build.sh [sm_arch]    e.g. ./build.sh 89   (RTX 4070 SUPER, Ada; the default)
# Toolkit: the newest /usr/local/cuda-* (CUDA 12.6 here), as tensor_cuda/build.sh; override with CUDA_HOME=...
# Offline pybind11: PYBIND11_SOURCE_DIR=<pybind11 v2.12.0 source tree> is passed as
#   -DFETCHCONTENT_SOURCE_DIR_PYBIND11 (for example core's tensor_cuda/build/_deps/pybind11-src, used read-only).
set -euo pipefail
ARCH="${1:-89}"
HERE="$(cd "$(dirname "$0")" && pwd)"

if [[ -z "${CUDA_HOME:-}" ]]; then
  newest="$(ls -d /usr/local/cuda-*/ 2>/dev/null | sort -V | tail -1)"
  [[ -n "$newest" ]] && CUDA_HOME="${newest%/}"
fi
if [[ -n "${CUDA_HOME:-}" && -x "$CUDA_HOME/bin/nvcc" ]]; then
  export PATH="$CUDA_HOME/bin:$PATH"
  export CUDACXX="$CUDA_HOME/bin/nvcc"
  echo "Using CUDA toolkit: $CUDA_HOME -> $(readlink -f "$CUDA_HOME") ($($CUDACXX --version | sed -n 's/.*release //p'))"
fi

EXTRA=()
if [[ -n "${PYBIND11_SOURCE_DIR:-}" ]]; then
  echo "Using pybind11 source: $PYBIND11_SOURCE_DIR (offline)"
  EXTRA+=("-DFETCHCONTENT_SOURCE_DIR_PYBIND11=$PYBIND11_SOURCE_DIR")
fi

cmake -S "$HERE" -B "$HERE/build" -DCMAKE_BUILD_TYPE=Release -DCMAKE_CUDA_ARCHITECTURES="$ARCH" "${EXTRA[@]}"
cmake --build "$HERE/build" -j
echo "Built: $(ls "$HERE"/tc_signal/_tc_signal*.so)"
echo "Use:   PYTHONPATH=$HERE python3 -c 'import tc_signal'"
