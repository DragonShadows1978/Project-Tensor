   586	void recycle_event(PendingState& st, int device, cudaEvent_t ev) noexcept {
   587	  if (ev == nullptr) return;
   588	  DeviceEvents* de = nullptr;
   589	  try {
   590	    auto it = st.event_pool.find(device);  // find, never operator[]: no insertion on the release path
   591	    if (it != st.event_pool.end()) de = &it->second;
   592	    // N3: the slot was reserved when the event was created; refuse (never allocate) if it somehow is not there.
   593	    if (test_hooks::take(test_hooks::kAllocEventRecycle) || de == nullptr || de->free.size() >= de->free.capacity())
