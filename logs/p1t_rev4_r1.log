    assert r.returncode == 0 and summary and summary['failures'] == 0 and not bad, (r.returncode, bad, r.stdout[-3000:],
                                                                                    r.stderr[-2000:])
    assert summary['cases'] == (17 if mode == 'accounting' else 11), summary

