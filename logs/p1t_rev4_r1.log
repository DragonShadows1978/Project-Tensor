   286	// P1T-FIX1, F03: checked element count and byte size for the two entry points that turn arbitrary caller shapes into
   287	// a Storage (empty, from_dlpack). Every extent is >= 0 here (callers refuse negatives first); a zero extent makes the
   288	// count 0 whatever the other extents are. Overflow raises ValueError and never wraps to an empty or short Storage.
   289	// The byte ceiling is INT64_MAX (every byte total, offset and pointer difference stays a valid int64/ptrdiff_t).
   290	// Prior art: GCC/Clang __builtin_mul_overflow / __builtin_add_overflow (GCC 5, 2015); C23 ckd_mul / ckd_add
   291	// (<stdckdint.h>, ISO/IEC 9899:2024); SEI CERT C INT30-C / INT32-C. Taken: the checked-operation primitive. Ours:
   292	// where it is applied. Unverified here (lead to check): "GCC 5 __builtin_mul_overflow", "C23 stdckdint".
   293	//
   294	// P1T-FIX2, review finding N2 (the zero-extent rule). FIX1 returned a count of 0 for any shape with a zero extent
   295	// WITHOUT looking at the other extents, so [0, 2^62, 4] and [2^62, 4, 0] were accepted as empty tensors; the engine
   296	// then formed their strides and partial counts (contiguous_strides, numel_of, byte strides) and overflowed (round-2
   297	// probe core_cpu prefix/suffix: UBSan signed overflow). The rule now: the EXTENT BOUND, the product of every extent
   298	// with a zero counted as 1, must fit in int64 (checked_numel), and so must the bound times the element size
   299	// (checked_nbytes), whatever the other extents are. Every quantity the engine later forms from such a shape (count,
   300	// each contiguous stride, each byte stride, the byte size) is at most that bound, so none can overflow. Zero-extent
   301	// shapes whose bound fits (e.g. [0, 2^60] float32) stay real empty tensors.
   302	// Prior art: NumPy's array constructor applies the same rule (zero dimensions skipped, the rest multiplied into the
   303	// byte size with overflow checks): numpy 2.4.2 refuses np.empty((0, 2**62, 4), float32) and (0, 2**61) float32 ("array
   304	// is too big"), measured in the P1T-FIX2 ledger. PyTorch 2.11 refuses the element-level part only. Taken: NumPy's
   305	// rule. Ours: applying it to TensorCUDA's empty / from_dlpack / __dlpack__. Source-level citation unverified here (lead
   306	// to check): "numpy ctors.c PyArray_NewFromDescr_int is_zero overflow".
   307	int64_t checked_extent_bound(const int64_t* dims, int n, const char* who) {
   308	  int64_t p = 1;
   309	  for (int i = 0; i < n; ++i)
   310	    if (__builtin_mul_overflow(p, dims[i] > 1 ? dims[i] : int64_t{1}, &p))
   311	      throw py::value_error(std::string(who) + ": the element count of shape " + shape_str(dims, n) +
   312	                            " overflows int64 (every nonzero extent counts, also next to a zero extent: strides and "
   313	                            "partial counts are formed from them); refused");
   314	  return p;
   315	}
   316	
   317	int64_t checked_numel(const int64_t* dims, int n, const char* who) {
   318	  const int64_t bound = checked_extent_bound(dims, n, who);
   319	  for (int i = 0; i < n; ++i)
   320	    if (dims[i] == 0) return 0;
   321	  return bound;
   322	}
   323	
   324	int64_t checked_nbytes(int64_t numel, size_t itemsize, const int64_t* dims, int n, const char* who) {
   325	  const int64_t bound = checked_extent_bound(dims, n, who);
   326	  int64_t b = 0;
   327	  if (__builtin_mul_overflow(bound, static_cast<int64_t>(itemsize), &b))
   328	    throw py::value_error(std::string(who) + ": the byte size of shape " + shape_str(dims, n) + " (" +
   329	                          std::to_string(itemsize) + "-byte elements) overflows int64 (every nonzero extent counts, "
   330	                          "also next to a zero extent); refused");
   331	  return numel == 0 ? 0 : b;  // numel is 0 or the bound itself (checked_numel)
   332	}
