   651	template <typename M>
   652	void import_release_impl(M* m) noexcept {
   653	  if (!m || !m->deleter) return;
   654	  ImportReleaseLifecycle& lc = release_lifecycle();
   655	  bool admitted = false;
   656	  try {
   657	    std::lock_guard<std::mutex> lk(lc.mu);
   658	    // Both checks leak without touching the GIL; the order only decides which counter records it (a release during
   659	    // finalization keeps FIX1's leaked_interpreter_shutdown attribution).
   660	    if (!interpreter_accepts_gil_state()) {
   661	      g_import_leaked_shutdown.fetch_add(1);         // F04: second line of defence
   662	    } else if (lc.closing) {
   663	      g_import_leaked_closing.fetch_add(1);          // N5: after the exit hook closed admission: deliberate leak
   664	    } else {
   665	      ++lc.in_flight;
   666	      admitted = true;
   667	    }
   668	  } catch (...) {
   669	    g_import_lock_failures.fetch_add(1);
   670	  }
   671	  if (!admitted) return;
   672	  ++t_admitted_depth;                                // V3-01: this thread now has an admitted release on its stack
   673	  PyGILState_STATE g = PyGILState_Ensure();
   674	  try {
   675	    m->deleter(m);
   676	    g_import_released.fetch_add(1);
   677	  } catch (...) {
   678	    g_import_deleter_exceptions.fetch_add(1);        // N4: contained (GIL still held while the exception dies)
   679	  }
   680	  PyGILState_Release(g);
   681	  // Leave only after PyGILState_Release: the exit hook must not let finalization start while this thread still
   682	  // touches the interpreter. notify_all on every leave (not only at zero): the hook may be waiting for a nonzero
   683	  // count, its own thread's admitted releases (V3-01 self-exclusion).
   684	  try {
   685	    std::lock_guard<std::mutex> lk(lc.mu);
   686	    --lc.in_flight;
   687	    lc.cv.notify_all();
   688	  } catch (...) {
   689	    g_import_lock_failures.fetch_add(1);
   690	  }
   691	  --t_admitted_depth;
   692	}
   693	
   694	void import_release_legacy(void* ctx) noexcept {
   695	  import_release_impl(static_cast<DLManagedTensor*>(ctx));
   696	}
   697	void import_release_versioned(void* ctx) noexcept {
   698	  import_release_impl(static_cast<DLManagedTensorVersioned*>(ctx));
   699	}
   700	
   701	// N5 + V3-01: the atexit side (tensor_cuda/__init__.py _dlpack_shutdown_hook). Called with the GIL held by the main
   702	// thread. Closes admission, then waits until every admitted release of OTHER threads has left (in_flight minus this
   703	// thread's own depth == 0). There is NO bound: it never returns while one is still running (V3-01). `first_diag_s`
   704	// (the knob tensor_cuda._DLPACK_SHUTDOWN_WAIT_S) is the time waited before the first stderr diagnostic; each later one
   705	// is written when the time waited has doubled since the previous one (geometric schedule: k lines take 2^(k-1) times
   706	// the first delay, so the line rate is bounded and falls as the wait goes on). NaN or negative: diagnose at once.
   707	// Returns {in_flight_at_close, still_in_flight, timed_out, waited_us, diagnostics, own_thread_in_flight}; `timed_out`
   708	// now means "the wait outlasted the first-diagnostic delay" (it no longer means the hook gave up), `still_in_flight`
   709	// (other threads' admitted releases still running at return) is always 0 now, and `own_thread_in_flight` is the
   710	// calling thread's own admitted releases that it did not wait for (0 at a real interpreter exit).
   711	py::dict dlpack_begin_shutdown(double first_diag_s) {
   712	  ImportReleaseLifecycle& lc = release_lifecycle();
   713	  if (!(first_diag_s >= 0.0)) first_diag_s = 0.0;           // NaN or negative: diagnose at once (the wait is the same)
   714	  if (first_diag_s > 86400.0) first_diag_s = 86400.0;       // keep the chrono conversion finite
   715	  const auto first = std::chrono::duration_cast<std::chrono::steady_clock::duration>(
   716	      std::chrono::duration<double>(first_diag_s));
   717	  const long long own = t_admitted_depth;                   // this thread's own admitted releases: never waited for
   718	  long long at_close = 0;
   719	  long long remaining = 0;
   720	  bool overran = false;
   721	  unsigned long long diagnostics = 0;
   722	  const auto t0 = std::chrono::steady_clock::now();
   723	  {
   724	    py::gil_scoped_release nogil;                           // admitted releases need the GIL to finish
   725	    std::unique_lock<std::mutex> lk(lc.mu);
   726	    lc.closing = true;                                      // admission closed for good: nothing new can start
   727	    at_close = lc.in_flight;
   728	    auto next = t0 + first;
   729	    while (!lc.cv.wait_until(lk, next, [&lc, own] { return lc.in_flight <= own; })) {
   730	      // Still running at the diagnostic time: report, then keep waiting (never return early: V3-01).
   731	      overran = true;
   732	      const long long running = lc.in_flight - own;
   733	      lk.unlock();                                          // a blocked stderr must not stop a release from leaving
   734	      const auto now = std::chrono::steady_clock::now();
   735	      std::fprintf(stderr,
   736	                   "tensor_cuda: %lld DLPack release(s) admitted before exit still running after %.1f s; interpreter "
   737	                   "exit waits for them (no new release is admitted)\n",
   738	                   running, std::chrono::duration<double>(now - t0).count());
   739	      std::fflush(stderr);
   740	      ++diagnostics;
   741	      // Next line when the time waited has doubled (at least one clock tick later: no busy loop at a zero delay).
   742	      const auto waited = now - t0;
   743	      const auto tick = std::chrono::steady_clock::duration(1);
   744	      next = now + (waited > tick ? waited : tick);
   745	      lk.lock();
   746	    }
   747	    remaining = lc.in_flight - own;
   748	  }  // lk is released before nogil re-takes the GIL
   749	  const long long waited_us =
   750	      std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - t0).count();
   751	  g_shutdown_calls.fetch_add(1);
   752	  g_shutdown_in_flight_at_close.fetch_add(static_cast<unsigned long long>(at_close));
   753	  if (overran) g_shutdown_timeouts.fetch_add(1);
   754	  g_shutdown_still_in_flight.store(static_cast<unsigned long long>(remaining));
   755	  g_shutdown_wait_us.fetch_add(static_cast<unsigned long long>(waited_us));
   756	  g_shutdown_diagnostics.fetch_add(diagnostics);
   757	  py::dict d;
   758	  d["in_flight_at_close"] = at_close;
   759	  d["still_in_flight"] = remaining;
   760	  d["timed_out"] = overran;
   761	  d["waited_us"] = waited_us;
   762	  d["diagnostics"] = diagnostics;
   763	  d["own_thread_in_flight"] = own;
   764	  return d;
   765	}
   766	void import_release_noop(void*) {}
