   371	// Stream contract (array API): `stream` is the CONSUMER's stream. TensorCUDA
   372	// queues all work on the legacy default stream. None/1 = the consumer is on
   373	// the legacy stream too (nothing to do); -1 = no synchronization; 2 = the
   374	// per-thread default stream; > 2 = a cudaStream_t. For 2 and handles, record
   375	// an event on the legacy stream and make the consumer wait on it.
   376	void dlpack_fence_consumer(const py::object& stream) {
   377	  if (stream.is_none()) return;
   378	  if (!py::isinstance<py::int_>(stream))
   379	    throw py::type_error("__dlpack__: stream must be an int or None");
   380	  const long long s = stream.cast<long long>();
   381	  if (s == -1 || s == 1) return;
   382	  if (s == 0)
   383	    throw py::value_error(
   384	        "__dlpack__: stream=0 is ambiguous for CUDA under the DLPack protocol; "
   385	        "use None or 1 (legacy default stream), 2 (per-thread default stream) "
   386	        "or a cudaStream_t handle");
   387	  if (s < -1) throw py::value_error("__dlpack__: invalid stream " + std::to_string(s));
   388	  cudaStream_t consumer =
   389	      (s == 2) ? cudaStreamPerThread
   390	               : reinterpret_cast<cudaStream_t>(static_cast<uintptr_t>(s));
   391	  cudaEvent_t ev = nullptr;
   392	  cudaError_t e = cudaEventCreateWithFlags(&ev, cudaEventDisableTiming);
   393	  if (e == cudaSuccess) e = cudaEventRecord(ev, cudaStreamLegacy);  // engine stream
   394	  if (e == cudaSuccess) e = cudaStreamWaitEvent(consumer, ev, 0);
   395	  // Safe right after the wait is enqueued: the dependency is captured at the
   396	  // cudaStreamWaitEvent call and the runtime frees the event once it fires.
   397	  if (ev) cudaEventDestroy(ev);
   398	  if (e != cudaSuccess) {
   399	    cudaGetLastError();
   400	    throw std::runtime_error(std::string("__dlpack__: stream fence failed: ") +
   401	                             cudaGetErrorString(e));
   402	  }
   403	}
