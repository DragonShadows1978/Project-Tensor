   203	// P1T-FIX1, F05: device-correct drain for an external (imported) Storage.
   204	//  1. If `dev` is not the current device, switch to it (the caller may have
   205	//     switched devices since the import; draining the CURRENT device's legacy
   206	//     stream would leave this allocation's last use pending).
   207	//  2. Synchronize that device's legacy stream (stream 0 in this TU).
   208	//  3. Report failure (any step) so the caller does NOT release, and clear the
   209	//     runtime's last-error slot so an unrelated later launch check does not
   210	//     report this destructor's error.
   211	//  4. Restore the caller's device.
   212	// No device-wide sync (cudaDeviceSynchronize): one stream sync, as before.
   213	// Prior art: the CUDA runtime current-device model (cudaGetDevice/cudaSetDevice;
   214	// the legacy default stream is per device) and the scoped device guard of
   215	// PyTorch (c10::cuda::CUDAGuard) / CuPy (cupy.cuda.Device as a context manager).
   216	// Taken: switch-then-restore. Ours: its placement before the DLPack deleter and
   217	// the leak-on-failure rule.
   218	namespace {
   219	std::atomic<unsigned long long> g_external_drain_leaks{0};
   220	
   221	bool drain_device_legacy_stream(int dev) {
   222	  int prev = -1;
   223	  cudaError_t e = cudaGetDevice(&prev);
   224	  bool switched = false;
   225	  if (e == cudaSuccess && prev != dev) {
   226	    e = cudaSetDevice(dev);
   227	    switched = (e == cudaSuccess);
   228	  }
   229	  if (e == cudaSuccess) e = cudaStreamSynchronize(0);
   230	  if (switched) cudaSetDevice(prev);
   231	  if (e != cudaSuccess) cudaGetLastError();
   232	  return e == cudaSuccess;
   233	}
   234	}  // namespace
   235	
   236	unsigned long long storage_external_drain_leaks() { return g_external_drain_leaks.load(); }
   237	
   238	Storage::~Storage() {
   239	  if (external_release) {
   240	    // Imported (DLPack) memory belongs to its producer: never cudaFree it and
   241	    // never hand it to the pool. ORDER MATTERS:
   242	    //  1. Drain the engine stream. Every engine kernel, cuBLAS call and
   243	    //     cudaMemcpy runs on stream 0 (the legacy default stream; this TU is
   244	    //     built without --default-stream per-thread), so once it is idle no
   245	    //     queued engine work can still read or write this memory. The engine
   246	    //     keeps no per-Storage "last use" event, so "everything queued so far"
   247	    //     is the only sound fence; an event recorded here and waited on would
   248	    //     cover exactly the same work at three API calls instead of one. A
   249	    //     deferred release (host callback) is not allowed to run the
   250	    //     producer's deleter, which may call CUDA (torch's caching allocator).
   251	    //  2. Then hand the memory back (the DLPack deleter, GIL held, in
   252	    //     bindings.cpp). A producer may reuse it at once on its own stream.
   253	    // Prior art: the DLPack deleter contract (dmlc/dlpack, 2017+) and the
   254	    // array API's stream rules (2021+); the drain-then-delete order is the
   255	    // standard CUDA "free only after last use" rule. Ours: its placement in
   256	    // the Storage destructor.
   257	    // P1T-FIX1 F05: drain THIS Storage's device (drain_device_legacy_stream
   258	    // above); if the drain fails, deliberately leak instead of releasing.
   259	    if (device.is_cuda() && !drain_device_legacy_stream(device.index)) {
   260	      g_external_drain_leaks.fetch_add(1);
   261	      return;
   262	    }
   263	    external_release(external_ctx);
   264	    return;
   265	  }
   266	  if (!ptr) return;
   267	  if (device.is_cuda()) {
   268	    if (pooled) cudaFreeAsync(ptr, 0);
   269	    else cudaFree(ptr);
   270	  } else {
   271	    std::free(ptr);
   272	  }
   273	}
