   208	void same_device_peeked(const std::vector<const Peeked*>& ps, const std::vector<const char*>& roles) {
   209	  int dev = -1;
   210	  const char* first = "";
   211	  for (size_t i = 0; i < ps.size(); ++i) {
   212	    if (ps[i] == nullptr) continue;
   213	    if (dev < 0) {
   214	      dev = ps[i]->device;
   215	      first = roles[i];
   216	    } else if (ps[i]->device != dev) {
   217	      std::ostringstream os;
