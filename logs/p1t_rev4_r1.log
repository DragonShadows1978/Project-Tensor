"""LEAD GPU ONLY, two devices: decides whether destructor fences the allocation's device.
Prior art: CUDA runtime current-device/default-stream semantics; DLPack last-use ownership.
Run under timeout 60. A single-GPU host exits 3 (INCONCLUSIVE). No source edits.
"""
import ctypes as C, json, torch, tensor_cuda as tc
if torch.cuda.device_count()<2:
    print('INCONCLUSIVE: two CUDA devices required'); raise SystemExit(3)
# Last managed reference has a Python callback; callback samples the device-0 event.
class Dev(C.Structure): _fields_=[('type',C.c_int),('id',C.c_int)]
class DT(C.Structure): _fields_=[('code',C.c_uint8),('bits',C.c_uint8),('lanes',C.c_uint16)]
class DL(C.Structure): _fields_=[('data',C.c_void_p),('dev',Dev),('ndim',C.c_int),('dtype',DT),('shape',C.POINTER(C.c_int64)),('strides',C.POINTER(C.c_int64)),('offset',C.c_uint64)]
class M(C.Structure): pass
CB=C.CFUNCTYPE(None,C.POINTER(M)); M._fields_=[('dl',DL),('ctx',C.c_void_p),('deleter',CB)]
new=C.pythonapi.PyCapsule_New; new.restype=C.py_object; new.argtypes=[C.c_void_p,C.c_char_p,C.c_void_p]
torch.cuda.set_device(0)
p=torch.empty(1024,device='cuda:0'); dims=(C.c_int64*1)(1024); stride=(C.c_int64*1)(1)
event=torch.cuda.Event(); receipt=[]
@CB
def release(_): receipt.append({'device0_work_done':event.query()})
m=M(DL(p.data_ptr(),Dev(2,0),1,DT(2,32,1),dims,stride,0),None,release)
u=tc.from_dlpack(new(C.addressof(m),b'dltensor',None))
torch.cuda._sleep(80_000_000); u.fill_(5); event.record(torch.cuda.default_stream(0))
torch.cuda.set_device(1)
del u
assert torch.cuda.current_device()==1, "F05: caller device not restored"
# Keep real producer storage alive; this probe observes the early deleter without causing UAF.
torch.cuda.set_device(0); torch.cuda.synchronize()
print(json.dumps(receipt))
assert receipt and receipt[0]['device0_work_done'], 'F05: deleter called before device-0 last use'
"""LEAD GPU ONLY. PASS iff sync raises for pending CUDA errors and drains/restores each device once,
without early/double deleters; requires >=2 CUDA devices, otherwise INCONCLUSIVE (exit3).
Prior art: CUDA12.6 streams/events + DLPack2017 lifetime. Ours: cross-device FIFO and preexisting error census.
"""
import ctypes, gc, sys
import torch, tc_signal as ts
from pathlib import Path
sys.path.insert(0,str(Path(__file__).resolve().parents[3]/'tc_signal/tests'))
import tcs_producer as P
if torch.cuda.device_count()<2:
    print('INCONCLUSIVE: two devices required');raise SystemExit(3)
ts.set_allocator(lambda s: torch.empty(s,device=torch.cuda.current_device()))
P.reset_stats()
held=[]
for d in [0,1]:
    with torch.cuda.device(d):
        x=torch.arange(32,device=d,dtype=torch.float32)+.5
        prod=P.Producer(x,(32,))
        out=torch.empty_like(x)
        torch.cuda._sleep(400_000_000)
        ts.rint(prod,out=out)
        held.append((x,out))
torch.cuda.set_device(1)
ts.synchronize()
assert torch.cuda.current_device()==1
assert ts._C.pending_stats()['entries']==0
assert P.STATS['deleted']==2 and P.STATS['unknown_delete']==0,P.STATS
for x,y in held:
    torch.testing.assert_close(y,torch.round(x),rtol=0,atol=0)
# A synchronous launch-configuration error, deliberately left in the runtime last-error slot.
r=ctypes.CDLL('/usr/local/cuda-12.6/lib64/libcudart.so.12')
class Dim3(ctypes.Structure): _fields_=[('x',ctypes.c_uint),('y',ctypes.c_uint),('z',ctypes.c_uint)]
r.cudaLaunchKernel.argtypes=[ctypes.c_void_p,Dim3,Dim3,ctypes.c_void_p,ctypes.c_size_t,ctypes.c_void_p]
r.cudaPeekAtLastError.restype=ctypes.c_int
r.cudaGetLastError()
e=r.cudaLaunchKernel(None,Dim3(0,1,1),Dim3(0,1,1),None,0,None)
assert e and r.cudaPeekAtLastError(), 'INCONCLUSIVE: could not stage a last-error slot'
try:
    ts.synchronize()
except RuntimeError as ex:
    print('PASS: preexisting CUDA error reported',ex)
else:
    raise AssertionError('synchronize returned success with a preexisting CUDA launch error')
finally:
    r.cudaGetLastError()
print('PASS: two-device retained releases, exact output, caller device restored')
"""LEAD GPU ONLY: finite semantic parity + dual-handle interleave + nonlegacy ordering.
Prior art: ONNX operators and fp64 oracle; CUDA events; cuBLAS default-math determinism.
Reuses author-supplied fp64 oracles as a spot check, not independent review evidence. timeout 90, <32 MiB.
This is a spot probe, not the claimed 236-case Voice runner or 52-id core baseline comparison.
"""
import sys
from pathlib import Path
sys.path.insert(0,str(Path(__file__).resolve().parents[3]/'tc_signal/tests'))
import numpy as np, torch, tc_signal as ts, tensor_cuda as tc
from tc_signal import _tc_signal as C
import tcs_lstm_oracle as O
# Both cuBLAS handles must retain requested settings after interleaved use.
ts.set_allocator(None)
rng=np.random.default_rng(20261012)
def upload(shape): return tc.tensor(rng.normal(0,.1,shape).astype(np.float32))
x=upload((1,2,16)); w=upload((3,2,3))
a=ts.conv1d(x,w)
T,N,I,H,D=5,2,3,4,2
lx=upload((T,N,I)); W=upload((D,4*H,I)); R=upload((D,4*H,H)); B=upload((D,8*H))
b=ts.lstm(lx,W,R,B,hidden_size=H,direction='bidirectional')
a2=ts.conv1d(x,w); b2=ts.lstm(lx,W,R,B,hidden_size=H,direction='bidirectional')
np.testing.assert_array_equal(a.numpy(),a2.numpy())
for first,second in zip(b,b2): np.testing.assert_array_equal(first.numpy(),second.numpy())
reference=O.lstm_onnx_f64(lx.numpy(),W.numpy(),R.numpy(),B.numpy(),direction='bidirectional',hidden_size=H)
for got,ref in zip(b,reference): assert O.normwise(got.numpy(),ref)<=2e-5
for cfg in (C.cublas_config(),C.lstm_cublas_config()):
    assert cfg['default_math'] and cfg['atomics_not_allowed'] and cfg['legacy_stream'],cfg
# L=1 with positive eps is zero before affine; eps=0 has IEEE 0/0 behavior.
x1=tc.tensor(np.array([[[2.]]],np.float32))
np.testing.assert_array_equal(ts.instance_norm1d(x1).numpy(),np.zeros((1,1,1),np.float32))
assert np.isnan(ts.instance_norm1d(x1,eps=0).numpy()).all()
values=np.array([-np.inf,np.inf,np.nan,-.5,.5,1.5,2.5,-.4,-0.],np.float32)
np.testing.assert_array_equal(ts.rint(tc.tensor(values)).numpy(),np.rint(values))
np.testing.assert_array_equal(np.signbit(ts.rint(tc.tensor(values)).numpy()),np.signbit(np.rint(values)))
# Producer is live through drain: this tests forward ordering, independently of F01 reclamation.
S=torch.cuda.Stream()
with torch.cuda.stream(S):
    p=torch.empty(1024,device='cuda');torch.cuda._sleep(20_000_000);p.fill_(1.25)
y=ts.rint(p)
np.testing.assert_array_equal(y.numpy(),np.ones(1024,np.float32))
print('PASS: finite determinism, handle settings, L=1, special rint, nonlegacy producer ordering')

