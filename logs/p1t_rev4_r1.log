   121	  return p;
   122	}
   123	
   124	// ------------------------------------------------------------------------------------------------ peek helpers
   125	struct Peeked {
   126	  py::object capsule;            // None for an absent optional operand
   127	  std::vector<int64_t> shape;
   128	  int device = -1;
   129	  bool present = false;
   130	};
   131	
   132	// Optional operands only (B, initial_h, initial_c); required ones go through require_operand first.
   133	Peeked peek_operand(py::handle obj, const char* role, int ndim) {
   134	  Peeked p;
   135	  if (obj.is_none()) {
   136	    p.capsule = py::none();
   137	    return p;
   138	  }
   139	  p.capsule = to_capsule(obj, role, false);
   140	  const DLTensor* t = peek(p.capsule, role);
   141	  validate_tensor(t, role, ndim);
   142	  p.shape = shape_of(t);
   143	  p.device = t->device.device_id;
   144	  p.present = true;
   145	  return p;
   146	}
   147	
   148	void same_device_peeked(const std::vector<const Peeked*>& ps, const std::vector<const char*>& roles) {
   149	  int dev = -1;
   150	  const char* first = "";
   151	  for (size_t i = 0; i < ps.size(); ++i) {
   152	    if (!ps[i]->present) continue;
   153	    if (dev < 0) {
   154	      dev = ps[i]->device;
   155	      first = roles[i];
   156	    } else if (ps[i]->device != dev) {
   157	      std::ostringstream os;
   158	      os << "tc_signal: operand '" << roles[i] << "': on CUDA device " << ps[i]->device << " but operand '" << first
   159	         << "' is on CUDA device " << dev << "; every operand must be on the same device";
   160	      throw py::value_error(os.str());
   161	    }
   162	  }
   163	}
   164	
   165	std::vector<int64_t> op_shape(const Operand& op) {
   166	  std::vector<int64_t> s(op.ndim());
   167	  for (int i = 0; i < op.ndim(); ++i) s[i] = op.dim(i);
   168	  return s;
   169	}
   170	
   171	py::tuple to_tuple(const std::vector<int64_t>& v) {
   172	  py::tuple t(v.size());
   173	  for (size_t i = 0; i < v.size(); ++i) t[i] = py::int_(v[i]);
   174	  return t;
   175	}
   176	
   177	// ------------------------------------------------------------------------------------------------ entry points
   178	py::tuple lstm_plan(py::object x, py::object W, py::object R, py::object B, py::object h0, py::object c0,
   179	                    int64_t hidden_size, int64_t direction) {
   180	  drain_completed();
   181	  require_operand(x, "x");
   182	  require_operand(W, "W");
   183	  require_operand(R, "R");
   184	  Peeked X = peek_operand(x, "x", 3);
   185	  Peeked Wp = peek_operand(W, "W", 3);
   186	  Peeked Rp = peek_operand(R, "R", 3);
   187	  Peeked Bp = peek_operand(B, "B", 2);
   188	  Peeked H0 = peek_operand(h0, "initial_h", 3);
   189	  Peeked C0 = peek_operand(c0, "initial_c", 3);
   190	  same_device_peeked({&X, &Wp, &Rp, &Bp, &H0, &C0}, {"x", "W", "R", "B", "initial_h", "initial_c"});
   191	  LstmPlan p = plan_lstm(X.shape, Wp.shape, Rp.shape, Bp.present ? &Bp.shape : nullptr,
   192	                         H0.present ? &H0.shape : nullptr, C0.present ? &C0.shape : nullptr, hidden_size, direction);
   193	  return py::make_tuple(X.capsule, Wp.capsule, Rp.capsule, Bp.capsule, H0.capsule, C0.capsule, to_tuple(p.y_shape),
   194	                        to_tuple(p.state_shape), py::int_(p.scratch_numel), py::int_(p.g.T), py::int_(p.g.N));
   195	}
   196	
   197	void lstm_run(py::object xc, py::object Wc, py::object Rc, py::object Bc, py::object h0c, py::object c0c, py::object Y,
   198	              py::object Y_h, py::object Y_c, py::object scratch, int64_t hidden_size, int64_t direction) {
   199	  drain_completed();
   200	  require_operand(xc, "x");
   201	  require_operand(Wc, "W");
   202	  require_operand(Rc, "R");
   203	  require_operand(Y, "Y");
   204	  require_operand(Y_h, "Y_h");
   205	  require_operand(Y_c, "Y_c");
   206	  require_operand(scratch, "scratch");
   207	  Operand X(xc, "x", 3, false);
   208	  Operand Wo(Wc, "W", 3, false);
   209	  Operand Ro(Rc, "R", 3, false);
   210	  Operand Bo;
   211	  if (!Bc.is_none()) Bo = Operand(Bc, "B", 2, false);
   212	  Operand H0;
   213	  if (!h0c.is_none()) H0 = Operand(h0c, "initial_h", 3, false);
   214	  Operand C0;
   215	  if (!c0c.is_none()) C0 = Operand(c0c, "initial_c", 3, false);
   216	  std::vector<int64_t> bshape, h0shape, c0shape;
   217	  if (Bo.present()) bshape = op_shape(Bo);
   218	  if (H0.present()) h0shape = op_shape(H0);
   219	  if (C0.present()) c0shape = op_shape(C0);
   220	  LstmPlan p = plan_lstm(op_shape(X), op_shape(Wo), op_shape(Ro), Bo.present() ? &bshape : nullptr,
   221	                         H0.present() ? &h0shape : nullptr, C0.present() ? &c0shape : nullptr, hidden_size, direction);
   222	  Operand Yo(to_capsule(Y, "Y", true), "Y", 4, true);
   223	  expect_shape(Yo, p.y_shape);
   224	  Operand Yh(to_capsule(Y_h, "Y_h", true), "Y_h", 3, true);
   225	  expect_shape(Yh, p.state_shape);
   226	  Operand Yc(to_capsule(Y_c, "Y_c", true), "Y_c", 3, true);
   227	  expect_shape(Yc, p.state_shape);
   228	  Operand S(to_capsule(scratch, "scratch", true), "scratch", 1, true);
   229	  expect_shape(S, {p.scratch_numel});
   230	  const int device = common_device({&X, &Wo, &Ro, &Bo, &H0, &C0, &Yo, &Yh, &Yc, &S});
   231	  // Every written operand must not alias any input nor any other written operand.
   232	  const std::vector<const Operand*> written = {&Yo, &Yh, &Yc, &S};
   233	  const std::vector<const Operand*> inputs = {&X, &Wo, &Ro, &Bo, &H0, &C0};
   234	  for (size_t a = 0; a < written.size(); ++a) {
   235	    for (const Operand* in : inputs) expect_disjoint(*written[a], *in);
   236	    for (size_t b = a + 1; b < written.size(); ++b) expect_disjoint(*written[a], *written[b]);
   237	  }
   238	  // F01: the whole per-call capsule set is one pending entry, released after the last step's launch has run.
   239	  RetainUntilComplete keep(device, {&X, &Wo, &Ro, &Bo, &H0, &C0, &Yo, &Yh, &Yc, &S});
   240	  lstm_forward(device, p.g, X.data(), Wo.data(), Ro.data(), Bo.present() ? Bo.data() : nullptr,
   241	               H0.present() ? H0.data() : nullptr, C0.present() ? C0.data() : nullptr, Yo.data(), Yh.data(), Yc.data(),
   242	               S.data());
   243	}
   244	
   245	}  // namespace
   246	
   247	void register_lstm(py::module_& m) {
   248	  m.def("lstm_plan", &lstm_plan, py::arg("x"), py::arg("W"), py::arg("R"), py::arg("B"), py::arg("initial_h"),
   249	        py::arg("initial_c"), py::arg("hidden_size"), py::arg("direction"),
   250	        "Acquire and peek the LSTM inputs; return (x, W, R, B|None, initial_h|None, initial_c|None capsules, Y shape, "
   251	        "Y_h/Y_c shape, scratch numel, T, N).");
   252	  m.def("lstm_run", &lstm_run, py::arg("x_capsule"), py::arg("W_capsule"), py::arg("R_capsule"), py::arg("B_capsule"),
   253	        py::arg("initial_h_capsule"), py::arg("initial_c_capsule"), py::arg("Y"), py::arg("Y_h"), py::arg("Y_c"),
   254	        py::arg("scratch"), py::arg("hidden_size"), py::arg("direction"),
   255	        "Consume every operand, validate, run the whole LSTM recurrence on the legacy stream, release.");
   256	  m.def(
   257	      "lstm_cublas_config",
   258	      [](int device) {
   259	        LstmCublasConfig c = lstm_cublas_config(device);
   260	        py::dict d;
   261	        d["math_mode"] = c.math_mode;
   262	        d["atomics_mode"] = c.atomics_mode;
   263	        d["pointer_mode"] = c.pointer_mode;
   264	        d["legacy_stream"] = c.legacy_stream;
   265	        d["default_math"] = c.default_math;
   266	        d["atomics_not_allowed"] = c.atomics_not_allowed;
   267	        return d;
   268	      },
   269	      py::arg("device") = 0, "Settings of the LSTM's cuBLAS handle on `device` (creates it if needed).");
   270	}
   271	
   272	}  // namespace tcs
     1	// _tc_signal P1T-M4 entry points: T5 norms (instance_norm1d, layer_norm, group_norm) and T6 small ops
     2	// (upsample_nearest1d, reflection_pad1d, rint). Registered into M2's module by `register_m4(m)` (one call in
     3	// bindings.cpp), so the package stays one .so with one DLPack consumer contract.
     4	//
     5	// Same contract as M2 (src/bindings.cpp): every operand, the output included, is a DLPack producer or capsule; this file
     6	// allocates no device memory. Two calls per op:
     7	//   *_plan(...) -> acquires the input capsules (__dlpack__(stream=1)), PEEKS them (device/dtype/layout/rank/shape and
     8	//                  the attributes are checked without consuming), returns (capsules..., out_shape);
     9	//   *_run(...)  -> consumes every capsule, re-derives the geometry from the consumed shapes, checks the output's shape,
    10	//                  the common device and that the output overlaps no input, launches on the legacy default stream, and
    11	//                  hands every consumed manager to the deferred-release list (P1T-FIX1 F01, dlpack_operand.h).
    12	// P1T-FIX1: F02 (x is REQUIRED in all six ops: None -> TypeError before planning, in peek4 and consume4; scale and bias
    13	// are the only optional operands), F03 (rows, L, T*scale, T + pads and every output size checked, checked_math.h).
    14	//
    15	// Prior art: the DLPack consumer and the plan/run split are M2's (see dlpack_operand.h and bindings.cpp: DLPack v1.3,
    16	// the Python array API stream protocol, the cuDNN/cuBLASLt "size, then execute" pattern), reused here unchanged. The
    17	// ONNX operator specs define the attribute rules (LayerNormalization axis in [-r, r); GroupNormalization num_groups
    18	// dividing C; Pad reflect needs pads < T; Resize nearest at an integer scale). Ours: the row-norm geometry mapping
    19	// (rows x L plus an affine index rule) shared by the three norms; no prior art known to me for that mapping as such.
    20	#include <pybind11/pybind11.h>
    21	#include <pybind11/stl.h>
    22	
    23	#include <cmath>
    24	#include <cstdint>
    25	#include <limits>
    26	#include <sstream>
    27	#include <stdexcept>
    28	#include <string>
    29	#include <vector>
    30	
    31	#include "checked_math.h"
    32	#include "dlpack_operand.h"
    33	#include "m4_ops.h"
    34	
    35	namespace py = pybind11;
    36	
    37	namespace tcs {
    38	namespace {
    39	
    40	[[noreturn]] void bad_attr4(const std::string& msg) { throw py::value_error("tc_signal: " + msg); }
    41	
    42	[[noreturn]] void bad_operand4(const char* role, const std::string& msg) {
    43	  throw py::value_error(std::string("tc_signal: operand '") + role + "': " + msg);
    44	}
    45	
    46	// ------------------------------------------------------------------------------------------------ peek / consume
    47	struct Peek4 {
    48	  py::object capsule = py::none();  // None for an absent optional operand
    49	  std::vector<int64_t> shape;
    50	  int device = -1;
    51	  bool present = false;
    52	};
    53	
    54	// rank >= 0: exactly that rank; rank < 0: any rank >= min_rank.
    55	void check_rank(const char* role, int ndim, int rank, int min_rank) {
    56	  if (rank < 0 && ndim < min_rank) {
    57	    std::ostringstream os;
    58	    os << "expected at least " << min_rank << " dimension" << (min_rank == 1 ? "" : "s") << ", got " << ndim;
    59	    bad_operand4(role, os.str());
    60	  }
    61	}
    62	
    63	enum class Need { kRequired, kOptional };
    64	
    65	Peek4 peek4(py::handle obj, const char* role, int rank, int min_rank, Need need) {
    66	  Peek4 p;
    67	  if (need == Need::kRequired) require_operand(obj, role);  // F02: None is refused here, before any planning
    68	  if (obj.is_none()) return p;
    69	  p.capsule = to_capsule(obj, role, false);
    70	  const DLTensor* t = peek(p.capsule, role);
    71	  validate_tensor(t, role, rank >= 0 ? rank : t->ndim);  // device, dtype, (rank), non-empty, C-contiguous, aligned
    72	  check_rank(role, t->ndim, rank, min_rank);
    73	  p.shape = shape_of(t);
    74	  p.device = t->device.device_id;
    75	  p.present = true;
    76	  return p;
    77	}
    78	
    79	void same_device4(const std::vector<std::pair<const Peek4*, const char*>>& ps) {
    80	  int dev = -1;
    81	  const char* first = "";
    82	  for (const auto& pr : ps) {
    83	    if (!pr.first->present) continue;
    84	    if (dev < 0) {
    85	      dev = pr.first->device;
    86	      first = pr.second;
    87	    } else if (pr.first->device != dev) {
    88	      std::ostringstream os;
    89	      os << "on CUDA device " << pr.first->device << " but operand '" << first << "' is on CUDA device " << dev
    90	         << "; every operand must be on the same device";
    91	      bad_operand4(pr.second, os.str());
    92	    }
    93	  }
    94	}
    95	
    96	// Consumes a capsule returned by a *_plan call (its rank is read from the capsule, then fully re-validated).
    97	Operand consume4(py::handle cap, const char* role, int rank, int min_rank, Need need) {
    98	  if (need == Need::kRequired) require_operand(cap, role);  // F02
    99	  if (cap.is_none()) return Operand();
   100	  const DLTensor* t = peek(cap, role);
   101	  const int nd = t->ndim;
   102	  Operand op(cap, role, rank >= 0 ? rank : nd, false);
   103	  check_rank(role, op.ndim(), rank, min_rank);
   104	  return op;
   105	}
   106	
   107	std::vector<int64_t> shape4(const Operand& op) {
   108	  std::vector<int64_t> s(op.ndim());
   109	  for (int i = 0; i < op.ndim(); ++i) s[i] = op.dim(i);
   110	  return s;
   111	}
   112	
   113	py::tuple tuple4(const std::vector<int64_t>& v) {
   114	  py::tuple t(v.size());
   115	  for (size_t i = 0; i < v.size(); ++i) t[i] = py::int_(v[i]);
   116	  return t;
   117	}
   118	
   119	// F03: checked product (checked_math.h).
   120	int64_t prod(const std::vector<int64_t>& s, size_t a, size_t b, const char* what) { return ck_prod(s, a, b, what); }
   121	
   122	// ------------------------------------------------------------------------------------------------ norms: plan
   123	enum class NormKind { kInstance, kLayer, kGroup };
   124	
   125	const char* norm_name(NormKind k) {
   126	  return k == NormKind::kInstance ? "instance_norm1d" : (k == NormKind::kLayer ? "layer_norm" : "group_norm");
   127	}
   128	
   129	struct NormPlan {
   130	  RowNormGeom g;
   131	  std::vector<int64_t> out_shape;
   132	  std::vector<int64_t> param_shape;
   133	};
   134	
   135	float checked_eps(const char* op, double eps) {
   136	  const float e = static_cast<float>(eps);
   137	  if (!std::isfinite(eps) || eps < 0.0 || !std::isfinite(e)) {
   138	    std::ostringstream os;
   139	    os << op << ": eps must be a finite number >= 0 that fits fp32, got " << eps;
   140	    bad_attr4(os.str());
   141	  }
   142	  return e;
   143	}
   144	
   145	// `arg` is the axis (layer_norm) or num_groups (group_norm); unused for instance_norm1d.
   146	NormPlan plan_norm(NormKind kind, const std::vector<int64_t>& xs, const std::vector<int64_t>* ss,
   147	                   const std::vector<int64_t>* bs, int64_t arg, double eps) {
   148	  const char* op = norm_name(kind);
   149	  NormPlan p{};
   150	  RowNormGeom& g = p.g;
   151	  g.eps = checked_eps(op, eps);
   152	  g.channels = g.groups = g.ch_per_group = g.T = 1;
   153	  const int64_t r = static_cast<int64_t>(xs.size());
   154	  std::ostringstream os;
   155	  if (kind == NormKind::kInstance || kind == NormKind::kGroup) {
   156	    if (r != 3) {
   157	      os << op << ": x must be [N, C, T], got " << r << " dimensions";
   158	      bad_attr4(os.str());
   159	    }
   160	    const int64_t N = xs[0], C = xs[1], T = xs[2];
   161	    p.param_shape = {C};
   162	    if (kind == NormKind::kInstance) {
   163	      g.rows = ck_mul(N, C, "instance_norm1d: rows N*C");
   164	      g.L = T;
   165	      g.affine = NormAffine::kPerRow;
   166	      g.channels = C;
   167	    } else {
   168	      if (arg < 1) {
   169	        os << "group_norm: num_groups must be >= 1, got " << arg;
   170	        bad_attr4(os.str());
   171	      }
   172	      if (C % arg != 0) {
   173	        os << "group_norm: C (" << C << ") is not divisible by num_groups (" << arg << ")";
   174	        bad_attr4(os.str());
   175	      }
   176	      g.rows = ck_mul(N, arg, "group_norm: rows N*num_groups");
   177	      g.L = ck_mul(C / arg, T, "group_norm: row length (C/num_groups)*T");
   178	      g.affine = NormAffine::kPerChannel;
   179	      g.groups = arg;
   180	      g.ch_per_group = C / arg;
   181	      g.T = T;
   182	    }
   183	  } else {
   184	    if (r < 1) {
   185	      os << "layer_norm: x must have at least 1 dimension, got " << r;
   186	      bad_attr4(os.str());
   187	    }
   188	    if (arg < -r || arg >= r) {
   189	      os << "layer_norm: axis must be in [" << -r << ", " << r - 1 << "] for a " << r << "-D x, got " << arg;
   190	      bad_attr4(os.str());
   191	    }
   192	    const int64_t a = arg < 0 ? arg + r : arg;
   193	    g.rows = prod(xs, 0, static_cast<size_t>(a), "layer_norm: rows");
   194	    g.L = prod(xs, static_cast<size_t>(a), xs.size(), "layer_norm: row length");
   195	    g.affine = NormAffine::kPerElem;
   196	    p.param_shape.assign(xs.begin() + a, xs.end());
   197	  }
   198	  for (const auto& pr : {std::make_pair(ss, "scale"), std::make_pair(bs, "bias")}) {
   199	    if (pr.first != nullptr && *pr.first != p.param_shape) {
   200	      std::ostringstream o2;
   201	      o2 << op << ": " << pr.second << " has shape " << shape_str(*pr.first) << ", expected "
   202	         << shape_str(p.param_shape)
   203	         << (kind == NormKind::kLayer ? " (x.shape[axis:])" : (kind == NormKind::kGroup ? " ([C], per channel)" : " ([C])"));
   204	      bad_attr4(o2.str());
   205	    }
   206	  }
   207	  p.out_shape = xs;
   208	  ck_shape_numel(p.out_shape, "norm: output size");
   209	  ck_mul(g.rows, g.L, "norm: rows*L");
   210	  return p;
   211	}
   212	
   213	int x_rank(NormKind kind) { return kind == NormKind::kLayer ? -1 : 3; }
   214	
   215	py::tuple norm_plan(NormKind kind, py::object x, py::object scale, py::object bias, int64_t arg, double eps) {
   216	  drain_completed();
   217	  Peek4 X = peek4(x, "x", x_rank(kind), 1, Need::kRequired);
   218	  Peek4 S = peek4(scale, "scale", -1, 1, Need::kOptional);
   219	  Peek4 B = peek4(bias, "bias", -1, 1, Need::kOptional);
   220	  same_device4({{&X, "x"}, {&S, "scale"}, {&B, "bias"}});
   221	  NormPlan p = plan_norm(kind, X.shape, S.present ? &S.shape : nullptr, B.present ? &B.shape : nullptr, arg, eps);
   222	  return py::make_tuple(X.capsule, S.capsule, B.capsule, tuple4(p.out_shape));
   223	}
   224	
   225	void norm_run(NormKind kind, py::object xc, py::object sc, py::object bc, py::object out, int64_t arg, double eps) {
   226	  drain_completed();
   227	  require_operand(out, "out");
   228	  Operand X = consume4(xc, "x", x_rank(kind), 1, Need::kRequired);
   229	  Operand S = consume4(sc, "scale", -1, 1, Need::kOptional);
   230	  Operand B = consume4(bc, "bias", -1, 1, Need::kOptional);
   231	  std::vector<int64_t> sshape, bshape;
   232	  if (S.present()) sshape = shape4(S);
   233	  if (B.present()) bshape = shape4(B);
   234	  NormPlan p = plan_norm(kind, shape4(X), S.present() ? &sshape : nullptr, B.present() ? &bshape : nullptr, arg, eps);
   235	  Operand Y(to_capsule(out, "out", true), "out", X.ndim(), true);
   236	  expect_shape(Y, p.out_shape);
   237	  const int device = common_device({&X, &S, &B, &Y});
   238	  for (const Operand* in : {&X, &S, &B}) expect_disjoint(Y, *in);
   239	  RetainUntilComplete keep(device, {&X, &S, &B, &Y});  // F01: deleters run after the legacy stream passes the launch
   240	  row_norm_forward(device, p.g, X.data(), S.present() ? S.data() : nullptr, B.present() ? B.data() : nullptr,
   241	                   Y.data());
   242	}
   243	
   244	// ------------------------------------------------------------------------------------------------ small ops: plan
   245	std::vector<int64_t> upsample_shape(const std::vector<int64_t>& xs, int64_t scale) {
   246	  if (scale < 1) {
   247	    std::ostringstream os;
   248	    os << "upsample_nearest1d: scale must be an integer >= 1, got " << scale;
   249	    bad_attr4(os.str());
   250	  }
   251	  const int64_t T = xs.back();
   252	  std::vector<int64_t> o = xs;
