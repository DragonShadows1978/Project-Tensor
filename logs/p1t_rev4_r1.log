   669	// Returns the number of managers leaked.
   670	unsigned long long leak_entry(PendingState& st, PendingEntry& e) noexcept {
   671	  unsigned long long n = 0;
   672	  for (ManagedOwner& o : e.owners) {
   673	    if (!o.empty()) ++n;
   674	    o.leak();
   675	  }
   676	  st.leaked_managers += n;
   677	  // The event is not recycled either: it may belong to a broken context.
   678	  e.event = nullptr;
   679	  return n;
   680	}
