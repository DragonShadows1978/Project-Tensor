        cands = sorted(glob.glob('/usr/local/cuda-*/'), key=lambda p: [int(x) if x.isdigit() else x for x in
                                                                      p.rstrip('/').split('-')[-1].split('.')])
        home = cands[-1].rstrip('/') if cands else '/usr/local/cuda'
