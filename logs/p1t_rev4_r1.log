   637	// Called right after the entry was taken off the list.
   638	void note_pop(PendingState& st, const PendingEntry& e) noexcept {
   639	  if (st.bytes_saturated) {
   640	    if (st.q.empty()) {  // the true total is 0 again
   641	      st.bytes = 0;
   642	      st.bytes_saturated = false;
   643	    }
   644	  } else {
   645	    int64_t rest = 0;
