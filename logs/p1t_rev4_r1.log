   730	cudaEvent_t acquire_event(int device) {
   731	  PendingState& st = pending();
   732	  DeviceEvents& de = st.event_pool[device];  // may allocate: constructor path, nothing has been launched yet
   733	  if (!de.free.empty()) {
   734	    cudaEvent_t ev = de.free.back();
   735	    de.free.pop_back();
   736	    return ev;
   737	  }
