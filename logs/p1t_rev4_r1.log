    75	# P1T-M1 (Project-Voice T1): DLPack import. Prior art: the Python array API
    76	# standard's from_dlpack (Consortium for Python Data API Standards, 2021-2023)
    77	# and the PyTorch/CuPy importers' owner keepalive (the imported tensor keeps the
    78	# producer's DLPack manager alive and calls its deleter when it dies); the
    79	# versioned-then-legacy retry mirrors torch.utils.dlpack.from_dlpack. Ours: the
    80	# TensorCUDA wiring (bindings.cpp, kernels.cu Storage).
    81	_DLPACK_MAX_VERSION = (1, 3)   # the vendored dlpack.h (include/dlpack/dlpack.h)
    82	_DLPACK_LEGACY_STREAM = 1      # DLPack int for the CUDA legacy default stream
    83	_KDL_CUDA = 2
    84	
    85	
    86	def from_dlpack(obj):
    87	    """Zero-copy import of any DLPack CUDA producer (or a bare DLPack capsule).
    88	
    89	    For an object with ``__dlpack__`` this calls
    90	    ``obj.__dlpack__(stream=1, max_version=(1, 3))`` (retrying without
    91	    ``max_version`` for a producer that predates it). ``stream=1`` names the
    92	    consumer stream, TensorCUDA's legacy default stream, so the producer orders
    93	    that stream after its own pending work before handing the capsule over.
    94	    A bare capsule carries no stream information: the caller must already have
    95	    ordered the producer's work.
    96	
    97	    The result aliases the producer's memory (``data_ptr()`` is the producer's
    98	    element 0) and keeps the producer's DLPack manager alive. When the last
    99	    TensorCUDA reference to that memory dies, TensorCUDA first drains its own
   100	    stream on the memory's device (switching to that device if another one is
   101	    current, then restoring the caller's device), so no queued TensorCUDA
   102	    kernel can still touch the memory, and then calls the producer's deleter
   103	    with the GIL held. If that drain fails (a broken CUDA context), or the
   104	    last reference dies while the interpreter is finalizing, the deleter is
   105	    deliberately NOT called: the manager is leaked rather than risk a
   106	    use-after-free or a GIL acquisition during shutdown (P1T-FIX1 F04/F05).
   107	    Interpreter exit (P1T-FIX2 N5): an atexit hook stops admitting such
   108	    releases and waits (GIL released, at most ``_DLPACK_SHUTDOWN_WAIT_S``
   109	    seconds) for the ones already taking the GIL to finish; every release
   110	    after it leaks (counted) without touching the GIL. A producer deleter that
   111	    raises a C++ exception is contained and counted (P1T-FIX2 N4).
   112	    The memory is never returned to TensorCUDA's pool and never
   113	    ``cudaFree``-d by TensorCUDA.
   114	
   115	    Refused with ``BufferError``, never converted: non-CUDA devices (CPU
   116	    included), another CUDA device than TensorCUDA's, non-contiguous strides
   117	    (a size-1 dimension may carry any stride), read-only tensors, and dtypes
   118	    with no exact TensorCUDA match (supported: float32, float16, bfloat16,
   119	    int64, uint8, bool). Refused with ``ValueError``: an element count, byte
   120	    size, ``byte_offset`` + size or address range that overflows 64-bit
   121	    arithmetic (P1T-FIX1 F03), counting every nonzero extent also when another
   122	    extent is 0 (P1T-FIX2 N2: ``[0, 2**62, 4]`` is refused, not an empty
   123	    tensor); ``TypeError``: anything that is neither a DLPack
   124	    producer nor a capsule (``None`` included). The result has
   125	    ``requires_grad=False``. If anything outside TensorCUDA later writes into
   126	    it in place, call ``mark_modified()`` (see ``Tensor.__dlpack__``).
   127	    """
   128	    if not hasattr(obj, "__dlpack__"):
   129	        return _C._from_dlpack_capsule(obj)   # bare capsule (TypeError otherwise)
   130	    dev = getattr(obj, "__dlpack_device__", None)
   131	    if dev is not None:
   132	        dev_type, dev_id = dev()
   133	        if int(dev_type) != _KDL_CUDA:
   134	            raise BufferError(
   135	                f"from_dlpack: only CUDA device memory (kDLCUDA = 2) can be "
   136	                f"imported; the producer reports device ({int(dev_type)}, "
   137	                f"{int(dev_id)})" + (" (CPU)" if int(dev_type) == 1 else ""))
   138	    try:
   139	        cap = obj.__dlpack__(stream=_DLPACK_LEGACY_STREAM,
   140	                             max_version=_DLPACK_MAX_VERSION)
   141	    except TypeError:
   142	        cap = obj.__dlpack__(stream=_DLPACK_LEGACY_STREAM)
   143	    return _C._from_dlpack_capsule(cap)
