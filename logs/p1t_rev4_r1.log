// tc_signal T5 norms (P1T-M4): InstanceNormalization, LayerNormalization and GroupNormalization-21 as one row-norm
// kernel. fp32 statistics, biased variance (ONNX), deterministic, no atomic operations, no fast-math flag.
//
// Every norm here is "normalize each contiguous row of a C-contiguous tensor over itself, then apply an affine":
//   instance_norm1d  x [N, C, T]: rows (n, c), L = T,              scale/bias entry c            (NormAffine::kPerRow)
//   layer_norm       x [d0..dr): rows prod(d0..d_{axis-1}), L = prod(d_axis..), entry j (scale/bias are x.shape[axis:])
//   group_norm       x [N, C, T]: rows (n, g), L = (C/G) * T,       entry g*(C/G) + j/T (per channel, GroupNorm-21)
//
// Statistics, per row, fp32 (shifted two-pass):
//   K    = x[row, 0]                                   (the shift: any sample of the row)
//   d    = (sum_j (x_j - K)) / L                       (pass 1: the mean of the shifted row)
//   var  = (sum_j ((x_j - K) - d)^2) / L               (pass 2: the centred sum of squares, biased)
//   rstd = 1.0f / sqrtf(var + eps)                     (math-library sqrtf, IEEE-rounded; IEEE division)
//   y_j  = fmaf(((x_j - K) - d) * rstd, scale, bias)   (pass 3)
// Why the shift: the row mean itself is never formed in fp32. On a row with mean 1e4 and std 1e-2 (the order's
// large-offset cell) the fp32 mean is off by up to half an ulp of 1e4 = 4.9e-4 = 0.05 std, which shifts every output
// by 0.05 and fails the 1e-5 gate whatever the summation order (receipt: artifacts/p1t_m4/sim_large_offset.txt).
// With the shift, x_j - K is exact on such rows (Sterbenz lemma: x_j and K within a factor 2), d is a small number
// computed to full relative precision, and the output error scales with the row's spread, not with its offset.
//
// Reduction order (fixed, so two calls are bitwise equal): one block per row (grid-stride over rows), kNormBlock
// threads. Thread t sums its terms j = t, t + B, t + 2B, ... in ascending order, kNormChunk terms at a time into a partial
// sum that is then added to the thread total (blocked summation), and the B thread totals are combined by a fixed
// shared-memory tree (pairs at stride B/2, B/4, ..., 1). The order depends only on L, kNormBlock and kNormChunk.
//
// rstd choice: 1.0f / sqrtf(v) is two correctly rounded operations (<= ~1 ulp, ~1.2e-7 relative), 80x under the
// order's 1e-5 normwise gate. rsqrtf (<= 2 ulp per the CUDA math documentation) would also pass; the IEEE pair is used
// because the package's fast-math canary (tests/test_contract.py) already witnesses IEEE division and no flushing.
//
// Prior art:
//  * Instance normalization: Ulyanov, Vedaldi & Lempitsky, "Instance Normalization: The Missing Ingredient for Fast
//    Stylization" (2016). Layer normalization: Ba, Kiros & Hinton, "Layer Normalization" (2016). Group normalization:
//    Wu & He, "Group Normalization" (2018). Semantics: ONNX InstanceNormalization, LayerNormalization (axis, epsilon,
//    biased variance), GroupNormalization-21 (per-channel scale/bias, as torch.nn.GroupNorm). Taken: the definitions.
//  * Variance algorithms: Welford (1962) for one-pass updating; Chan, Golub & LeVeque, "Algorithms for computing the
//    sample variance: analysis and recommendations" (1983) for the two-pass algorithm, its error analysis and the
//    "shifted data" variant (shift by an estimate of the mean, e.g. the first sample); Knuth, TAOCP vol. 2 §4.2.2.
//    Taken: two-pass with a shift by the first sample. Ours: the CUDA mapping (one block per row, three passes over
//    global memory, the shift broadcast from x[row, 0]).
//  * Blocked (chunked) summation and its error bound: Higham, "Accuracy and Stability of Numerical Algorithms" (2nd ed.,
//    2002), §4 (summation); Castaldo, Whaley & Chronopoulos, "Reducing floating point error in dot product using the
//    superblock family of algorithms" (2008). Taken: the bound. Ours: the chunk size and its place inside a strided
//    thread loop ahead of a fixed tree.
//  * Deterministic shared-memory tree reduction: the standard CUDA reduction pattern (Harris, "Optimizing Parallel
//    Reduction in CUDA", NVIDIA 2007). Taken: the tree. Ours: nothing beyond fixing B.
//  Unverified in this sandbox (lead to check): exact titles/years above; search terms "Chan Golub LeVeque 1983 sample
//  variance shifted", "Welford 1962 corrected sums of squares", "Castaldo Whaley superblock 2008".
#include <cuda_runtime.h>

#include <algorithm>
#include <sstream>
#include <stdexcept>
#include <string>

#include "m4_ops.h"
#include "tuning.h"

#ifdef CUDA_API_PER_THREAD_DEFAULT_STREAM
#error "tc_signal queues on the legacy default stream (stream 0); do not build it with --default-stream per-thread"
#endif

namespace tcs {

namespace {

constexpr cudaStream_t kLegacyStream = 0;  // the legacy default stream (TensorCUDA's only stream)

void check_cuda(cudaError_t e, const char* what) {
  if (e != cudaSuccess) {
    std::ostringstream os;
    os << "tc_signal: " << what << " failed: " << cudaGetErrorName(e) << ": " << cudaGetErrorString(e);
    throw std::runtime_error(os.str());
  }
}

// Makes `device` current for the call and restores the caller's device afterwards.
class DeviceGuard {
 public:
  explicit DeviceGuard(int device) {
    check_cuda(cudaGetDevice(&prev_), "cudaGetDevice");
    if (prev_ != device) {
      check_cuda(cudaSetDevice(device), "cudaSetDevice");
      changed_ = true;
    }
  }
  ~DeviceGuard() {
    if (changed_) cudaSetDevice(prev_);
  }
  DeviceGuard(const DeviceGuard&) = delete;
  DeviceGuard& operator=(const DeviceGuard&) = delete;

 private:
  int prev_ = 0;
  bool changed_ = false;
};

// Sum of every thread's `v` over the block, by a fixed tree (stride B/2, B/4, ..., 1); every thread gets the total.
template <int B>
__device__ __forceinline__ float block_tree_sum(float v, float* red) {
  red[threadIdx.x] = v;
  __syncthreads();
#pragma unroll
  for (int s = B / 2; s > 0; s >>= 1) {
    if (static_cast<int>(threadIdx.x) < s) red[threadIdx.x] = red[threadIdx.x] + red[threadIdx.x + s];
    __syncthreads();
  }
  const float total = red[0];
  __syncthreads();  // every thread has read red[0] before the next call overwrites red
  return total;
}

template <int B>
__global__ void __launch_bounds__(B) row_norm_kernel(const float* __restrict__ x, const float* __restrict__ scale,
                                                     const float* __restrict__ bias, float* __restrict__ y,
                                                     int64_t rows, int64_t L, float eps, int affine, int64_t channels,
                                                     int64_t groups, int64_t ch_per_group, int64_t T) {
  __shared__ float red[B];
  const int64_t tid = threadIdx.x;
  const int64_t chunk_span = static_cast<int64_t>(B) * m4tuning::kNormChunk;
  const float Lf = static_cast<float>(L);  // exact for L < 2^24
  for (int64_t row = blockIdx.x; row < rows; row += gridDim.x) {
    const float* __restrict__ xr = x + row * L;
    float* __restrict__ yr = y + row * L;
    const float K = xr[0];

    // Pass 1: the mean of the shifted row.
    float acc = 0.0f;
    for (int64_t base = tid; base < L; base += chunk_span) {
      const int64_t end = min(L, base + chunk_span);
      float part = 0.0f;
      for (int64_t j = base; j < end; j += B) part = part + (xr[j] - K);
      acc = acc + part;
    }
    const float d = block_tree_sum<B>(acc, red) / Lf;

    // Pass 2: the centred sum of squares (biased variance).
    acc = 0.0f;
    for (int64_t base = tid; base < L; base += chunk_span) {
      const int64_t end = min(L, base + chunk_span);
      float part = 0.0f;
      for (int64_t j = base; j < end; j += B) {
        const float c = (xr[j] - K) - d;
        part = fmaf(c, c, part);
      }
      acc = acc + part;
    }
    const float var = block_tree_sum<B>(acc, red) / Lf;
    const float rstd = 1.0f / sqrtf(var + eps);

    // Pass 3: normalize and apply the affine.
    for (int64_t j = tid; j < L; j += B) {
      const float c = (xr[j] - K) - d;
      int64_t p;
      if (affine == static_cast<int>(NormAffine::kPerRow))
        p = row % channels;
      else if (affine == static_cast<int>(NormAffine::kPerElem))
        p = j;
      else
        p = (row % groups) * ch_per_group + j / T;
      const float s = scale != nullptr ? scale[p] : 1.0f;
      const float b = bias != nullptr ? bias[p] : 0.0f;
      yr[j] = fmaf(c * rstd, s, b);
    }
  }
}

}  // namespace

void row_norm_forward(int device, const RowNormGeom& g, const float* x, const float* scale, const float* bias,
                      float* y) {
  DeviceGuard guard(device);
  constexpr int B = m4tuning::kNormBlock;
  const unsigned int grid = static_cast<unsigned int>(std::max<int64_t>(1, std::min<int64_t>(g.rows, tuning::kGridCap)));
  row_norm_kernel<B><<<grid, B, 0, kLegacyStream>>>(x, scale, bias, y, g.rows, g.L, g.eps, static_cast<int>(g.affine),
                                                    g.channels, g.groups, g.ch_per_group, g.T);
  check_cuda(cudaGetLastError(), "row_norm_kernel");
}

}  // namespace tcs
// tc_signal T6 small ops (P1T-M4): nearest upsample x k (1-D), reflection pad (1-D), rint. Bit-exact by construction:
// the two gathers move 32-bit words (one load and one store per output element, through unsigned-integer pointers, so
// NaN payloads, signed zeros and subnormals are copied bit for bit), and rint is the math library's rintf (IEEE 754
// roundTiesToEven in the default rounding mode, sign of zero kept, NaN and +-Inf pass through). No fast-math flag, no
// atomic operations: each output element is written by exactly one thread. TensorCUDA core's `round` (half away from
// zero, used by its quantizers) is untouched; rint is a new op here.
//
// Semantics (the shipped Kokoro nodes):
//  * upsample_nearest1d: ONNX Resize mode=nearest, coordinate_transformation_mode=asymmetric, nearest_mode=floor,
//    scales [1, ..., 1, s] with s an integer >= 1: y[..., i] = x[..., floor(i / s)], i in [0, T*s). Integer division is
//    the floor for these non-negative operands, so no float coordinate is ever formed.
//  * reflection_pad1d: ONNX Pad mode=reflect on the last axis (= torch reflection_pad1d): with s = i - pad_begin,
//    y[..., i] = x[..., |s|] for s < 0, x[..., 2(T-1) - s] for s >= T, else x[..., s]. pad_begin, pad_end < T.
//  * rint: ONNX Round (half to even).
//
// Prior art: ONNX operator specs (Resize, Pad, Round); IEEE 754-2008 roundTiesToEven / C99 rint; torch's
// reflection_pad1d and nearest upsample for the same index maps. Ours: nothing beyond the one-thread-per-output CUDA
// mapping (no prior art known to me for anything else here).
#include <cuda_runtime.h>

#include <algorithm>
#include <cstdint>
#include <sstream>
#include <stdexcept>
#include <string>

#include "m4_ops.h"
#include "tuning.h"

#ifdef CUDA_API_PER_THREAD_DEFAULT_STREAM
#error "tc_signal queues on the legacy default stream (stream 0); do not build it with --default-stream per-thread"
#endif

namespace tcs {

namespace {

constexpr cudaStream_t kLegacyStream = 0;  // the legacy default stream (TensorCUDA's only stream)

void check_cuda(cudaError_t e, const char* what) {
  if (e != cudaSuccess) {
    std::ostringstream os;
    os << "tc_signal: " << what << " failed: " << cudaGetErrorName(e) << ": " << cudaGetErrorString(e);
    throw std::runtime_error(os.str());
  }
}

unsigned int grid_for(int64_t total, int block) {
  const int64_t blocks = (total + block - 1) / block;
  return static_cast<unsigned int>(std::max<int64_t>(1, std::min<int64_t>(blocks, tuning::kGridCap)));
}

// Makes `device` current for the call and restores the caller's device afterwards.
class DeviceGuard {
 public:
  explicit DeviceGuard(int device) {
    check_cuda(cudaGetDevice(&prev_), "cudaGetDevice");
    if (prev_ != device) {
      check_cuda(cudaSetDevice(device), "cudaSetDevice");
      changed_ = true;
    }
  }
  ~DeviceGuard() {
    if (changed_) cudaSetDevice(prev_);
  }
  DeviceGuard(const DeviceGuard&) = delete;
  DeviceGuard& operator=(const DeviceGuard&) = delete;

 private:
  int prev_ = 0;
  bool changed_ = false;
};

// y[r, i] = x[r, i / scale]: one thread per output element, a 32-bit word copy.
__global__ void upsample_nearest1d_kernel(const uint32_t* __restrict__ x, uint32_t* __restrict__ y, int64_t total,
                                          int64_t T, int64_t T_out, int64_t scale) {
  for (int64_t i = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; i < total;
       i += static_cast<int64_t>(gridDim.x) * blockDim.x) {
    const int64_t t = i % T_out;
    const int64_t r = i / T_out;
    y[i] = x[r * T + t / scale];
  }
}

// Reflect pad of the last axis: one thread per output element, a 32-bit word copy.
__global__ void reflection_pad1d_kernel(const uint32_t* __restrict__ x, uint32_t* __restrict__ y, int64_t total,
                                        int64_t T, int64_t T_out, int64_t pad_begin) {
  for (int64_t i = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; i < total;
       i += static_cast<int64_t>(gridDim.x) * blockDim.x) {
    const int64_t t = i % T_out;
    const int64_t r = i / T_out;
    int64_t s = t - pad_begin;
    if (s < 0)
      s = -s;
    else if (s >= T)
      s = 2 * (T - 1) - s;
    y[i] = x[r * T + s];
  }
}

// y = rintf(x): round half to even (the default rounding mode), sign of zero kept, NaN/Inf pass through.
__global__ void rint_kernel(const float* __restrict__ x, float* __restrict__ y, int64_t n) {
  for (int64_t i = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; i < n;
       i += static_cast<int64_t>(gridDim.x) * blockDim.x)
    y[i] = rintf(x[i]);
}

}  // namespace

void upsample_nearest1d_forward(int device, int64_t rows, int64_t T, int64_t scale, const float* x, float* y) {
  DeviceGuard guard(device);
  const int64_t T_out = T * scale;
  const int64_t total = rows * T_out;
  constexpr int B = m4tuning::kCopyBlock;
  upsample_nearest1d_kernel<<<grid_for(total, B), B, 0, kLegacyStream>>>(
      reinterpret_cast<const uint32_t*>(x), reinterpret_cast<uint32_t*>(y), total, T, T_out, scale);
  check_cuda(cudaGetLastError(), "upsample_nearest1d_kernel");
}

void reflection_pad1d_forward(int device, int64_t rows, int64_t T, int64_t pad_begin, int64_t pad_end, const float* x,
                              float* y) {
  DeviceGuard guard(device);
  const int64_t T_out = T + pad_begin + pad_end;
  const int64_t total = rows * T_out;
  constexpr int B = m4tuning::kCopyBlock;
  reflection_pad1d_kernel<<<grid_for(total, B), B, 0, kLegacyStream>>>(
      reinterpret_cast<const uint32_t*>(x), reinterpret_cast<uint32_t*>(y), total, T, T_out, pad_begin);
  check_cuda(cudaGetLastError(), "reflection_pad1d_kernel");
}

void rint_forward(int device, int64_t n, const float* x, float* y) {
  DeviceGuard guard(device);
  constexpr int B = m4tuning::kCopyBlock;
  rint_kernel<<<grid_for(n, B), B, 0, kLegacyStream>>>(x, y, n);
  check_cuda(cudaGetLastError(), "rint_kernel");
}

}  // namespace tcs
// Host launchers for tc_signal's 1-D convolutions. Raw device pointers in, everything queued on the legacy default
// stream; no device memory is allocated here (the im2col scratch is passed in; cuBLAS's own internal workspace is the
// one exception, see README "cuBLAS").
#pragma once

#include <cstdint>

namespace tcs {

struct Conv1dGeom {
  int64_t N, C_in, T;      // x [N, C_in, T]
  int64_t C_out, K;        // w [C_out, C_in/groups, K]
  int64_t stride, pad_begin, pad_end, dilation, groups;
  int64_t T_out;           // (T + pb + pe - dilation*(K-1) - 1)//stride + 1
  bool direct;             // K == 1, stride 1, no pads: GEMM on x itself, no im2col, no scratch
};

struct ConvTranspose1dGeom {
  int64_t N, C_in, T;      // x [N, C_in, T]
  int64_t C_out, K;        // w [C_in, C_out/groups, K] (ONNX layout)
  int64_t stride, pad_begin, pad_end, output_padding, dilation, groups;
  int64_t T_out;           // stride*(T-1) + output_padding + dilation*(K-1) + 1 - pb - pe
};

// y = conv1d(x, w) + b. `col` holds C_in*K*T_out floats (one batch element at a time), or is NULL when g.direct.
void conv1d_forward(int device, const Conv1dGeom& g, const float* x, const float* w, const float* b, float* y,
                    float* col);

// y = conv_transpose1d(x, w) + b (gather form, one thread per output element).
void conv_transpose1d_forward(int device, const ConvTranspose1dGeom& g, const float* x, const float* w,
                              const float* b, float* y);

// Fast-math canary (see conv.cu): out[i] = x[i] / y[i], fp32, on the legacy stream.
void fp32_divide_probe(int device, const float* x, const float* y, float* out, int64_t n);

struct CublasConfig {
  int math_mode;           // cublasMath_t
  int atomics_mode;        // cublasAtomicsMode_t
  int pointer_mode;        // cublasPointerMode_t
  bool legacy_stream;      // the handle's stream is 0 (the legacy default stream)
  bool default_math;       // math_mode == CUBLAS_DEFAULT_MATH
  bool atomics_not_allowed;
};
// The (lazily created) handle's settings on `device`.
CublasConfig cublas_config(int device);

struct BuildInfo {
  int cudart_version;      // cudaRuntimeGetVersion
  int cublas_major, cublas_minor, cublas_patch;
  int current_device;
};
BuildInfo build_info();

}  // namespace tcs
// Host launcher for tc_signal's ONNX-semantics LSTM (P1T-M3, T4). Raw device pointers in; everything is queued on the
// legacy default stream; no device memory is allocated here (the projected-input and gate scratch is one operand the
// Python layer allocates; the recurrent state lives in the Y_h / Y_c outputs). cuBLAS's own internal workspace for the
// LSTM handle is the one exception (see lstm.cu, "cuBLAS handle").
//
// Prior art: see lstm.cu (ONNX LSTM operator spec; Hochreiter & Schmidhuber 1997; Gers, Schmidhuber & Cummins 2000;
// input projection hoisted out of the recurrence as in Appleyard, Kocisky & Blunsom 2016 / cuDNN RNN).
#pragma once

#include <cstdint>

namespace tcs {

// Gate blocks per direction along the 4H axis of W, R, Wb and Rb (ONNX LSTM: i, o, f, c).
constexpr int64_t kLstmGates = 4;
// B is [D, 2 * kLstmGates * H] = [Wb; Rb] per direction.
constexpr int64_t kLstmBiasHalves = 2;

struct LstmGeom {
  int64_t T, N, I;         // x [T, N, I] (ONNX layout 0)
  int64_t H;               // hidden_size
  int64_t D;               // direction slots: 1 (forward or reverse) or 2 (bidirectional)
  int64_t first_reverse;   // slots d >= first_reverse run backwards in time (forward: 1, reverse: 0, bidirectional: 1)
};

// Scratch layout (one fp32 operand): G_x [D, T, N, 4H] (projected inputs, Wb included), then G_h [D, N, 4H] (the
// per-step recurrent product h_{t-1} . R^T).
inline int64_t lstm_gx_numel(const LstmGeom& g) { return g.D * g.T * g.N * kLstmGates * g.H; }
inline int64_t lstm_gh_numel(const LstmGeom& g) { return g.D * g.N * kLstmGates * g.H; }
inline int64_t lstm_scratch_numel(const LstmGeom& g) { return lstm_gx_numel(g) + lstm_gh_numel(g); }

// Y [T, D, N, H], Y_h / Y_c [D, N, H]. B, h0 and c0 may be NULL (zeros). Y_h / Y_c double as the recurrent state.
void lstm_forward(int device, const LstmGeom& g, const float* x, const float* W, const float* R, const float* B,
                  const float* h0, const float* c0, float* Y, float* Y_h, float* Y_c, float* scratch);

struct LstmCublasConfig {
  int math_mode;           // cublasMath_t
  int atomics_mode;        // cublasAtomicsMode_t
  int pointer_mode;        // cublasPointerMode_t
  bool legacy_stream;      // the handle's stream is 0 (the legacy default stream)
  bool default_math;       // math_mode == CUBLAS_DEFAULT_MATH
  bool atomics_not_allowed;
};
// The (lazily created) LSTM cuBLAS handle's settings on `device`.
LstmCublasConfig lstm_cublas_config(int device);

}  // namespace tcs
// P1T-M4 host launchers (T5 norms, T6 small ops) and their tunables. Raw device pointers in, everything queued on the
// legacy default stream; nothing here allocates device memory (outputs come from the Python layer's allocator).
//
// House tunable law: every launch-shape knob of the M4 kernels lives here. None of them changes numerics except
// kNormBlock and kNormChunk, which fix the summation order of the norm statistics (see norms.cu); changing either one
// changes the last bits of the statistics (still fp32, still deterministic) and must be re-gated.
#pragma once

#include <cstdint>

namespace tcs {
namespace m4tuning {

// Threads per block of the row-norm kernel = the width of its reduction tree (one block per row). Power of two.
constexpr int kNormBlock = 256;
// Blocked summation inside a thread: a thread's strided terms are summed kNormChunk at a time into a partial sum, which
// is then added to the thread total (error bound (kNormChunk + n/kNormChunk) u instead of n u for n terms).
constexpr int kNormChunk = 32;
// Threads per block of the gather kernels (upsample, reflection pad) and of rint (one thread per output element).
constexpr int kCopyBlock = 256;

static_assert(kNormBlock > 0 && (kNormBlock & (kNormBlock - 1)) == 0, "kNormBlock must be a power of two");
static_assert(kNormChunk > 0, "kNormChunk must be positive");

}  // namespace m4tuning

// Where a row-norm output element finds its scale/bias entry.
enum class NormAffine : int {
  kPerRow = 0,      // instance norm: rows are (n, c); entry c = row % channels
  kPerElem = 1,     // layer norm: entry j (the element's index inside the normalized block)
  kPerChannel = 2,  // group norm: rows are (n, g); entry (row % groups) * ch_per_group + j / T
};

// One normalization problem: `rows` contiguous rows of length L, each normalized over itself.
struct RowNormGeom {
  int64_t rows;
  int64_t L;
  float eps;
  NormAffine affine;
  int64_t channels;      // kPerRow: C
  int64_t groups;        // kPerChannel: G
  int64_t ch_per_group;  // kPerChannel: C / G
  int64_t T;             // kPerChannel: time length (elements per channel)
};

// y = ((x - K) - d) * rstd * scale + bias per row, fp32 shifted two-pass statistics (norms.cu). scale/bias may be NULL.
void row_norm_forward(int device, const RowNormGeom& g, const float* x, const float* scale, const float* bias,
                      float* y);

// y[r, i] = x[r, i / scale] for rows r of length T, output length T * scale (bit copy).
void upsample_nearest1d_forward(int device, int64_t rows, int64_t T, int64_t scale, const float* x, float* y);

// ONNX/torch reflect pad of the last axis by (pad_begin, pad_end), each < T (bit copy).
void reflection_pad1d_forward(int device, int64_t rows, int64_t T, int64_t pad_begin, int64_t pad_end, const float* x,
                              float* y);

// y = rintf(x) elementwise (IEEE 754 roundTiesToEven, sign of zero kept, NaN and +-Inf pass through).
void rint_forward(int device, int64_t n, const float* x, float* y);

}  // namespace tcs
// tc_signal kernel tunables. House tunable law: no launch-shape literals at the use sites; every knob lives here.
// None of these changes numerics: each output element's summation order is fixed by the kernel code, not by the
// launch shape (grid-stride loops; one thread owns one output element). Changing a knob changes speed only.
#pragma once

namespace tcs {
namespace tuning {

// Threads per block for the 1-D im2col kernel (one thread per col element).
constexpr int kIm2colBlock = 256;
// Threads per block for the bias-add kernel (one thread per output element).
constexpr int kBiasBlock = 256;
// Threads per block for the gather-form ConvTranspose1d kernel (one thread per output element).
constexpr int kConvTransposeBlock = 256;
// Threads per block for the fp32 division canary kernel (fast-math probe; tests only).
constexpr int kProbeBlock = 256;
// Upper bound on blocks per launch; the kernels are grid-stride loops, so larger problems loop instead.
constexpr long long kGridCap = 1LL << 20;

// DLPack version this consumer asks producers for (`__dlpack__(max_version=...)`); the vendored header is v1.3.
constexpr int kDlpackMaxMajor = 1;
constexpr int kDlpackMaxMinor = 3;
// DLPack stream argument for the consumer stream: 1 = the legacy default stream (Python array API convention).
constexpr int kDlpackLegacyStream = 1;

// P1T-FIX1 (F01) deferred release: bounds of the pending list of consumed DLPack managers that wait for the legacy
// stream to pass their call (dlpack_operand.h, RetainUntilComplete). When a new entry pushes the list past either
// bound, tc_signal synchronizes the legacy stream of every pending device and releases the whole list. These only
// trade memory held (by producers' blocks waiting for release) against how often a call blocks; numerics never change.
// Entries: one per tc_signal call that reached its launch.
constexpr long long kPendingMaxEntries = 1024;
// Bytes: the sum of the fp32 operand sizes held by the pending entries (inputs, outputs and scratch).
constexpr long long kPendingMaxBytes = 256LL << 20;
// P1T-FIX2 (N3): fixed capacities of the allocation-free bookkeeping in synchronize/the bound drain. Devices whose sync
// result is remembered per call (a device beyond this is still synchronized; its failure is kept as one conservative
// flag), and CUDA failures named in one synchronize() error message (the rest are counted). Neither changes numerics.
constexpr int kSyncMaxDevices = 64;
constexpr int kSyncReportMax = 8;

}  // namespace tuning
}  // namespace tcs
