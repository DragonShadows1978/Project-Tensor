    35	# bfloat16 has no NumPy equivalent: build the host array as fp32 and cast the
    36	# device tensor to bf16 afterward. Listing it here so callers passing
    37	# dtype="bfloat16" no longer fall through _NP_DTYPE.get(..., np.float32) and get
    38	# a SILENT fp32 downcast (which corrupts bf16 constants for OLMoE/Qwen-class
    39	# models). dtype_from_string in the C++ already supports "bfloat16".
    40	_DEVICE_CAST_DTYPE = {"bfloat16"}
    41	
    42	
    43	def tensor(data, *, device="cuda", dtype="float32", requires_grad=False):
    44	    """Create a Tensor from array-like data."""
    45	    if dtype in _DEVICE_CAST_DTYPE:
    46	        arr = np.ascontiguousarray(np.asarray(data, dtype=np.float32))
    47	        return _C.tensor(arr, device, requires_grad).astype(dtype)
    48	    arr = np.asarray(data, dtype=_NP_DTYPE.get(dtype, np.float32))
    49	    arr = np.ascontiguousarray(arr)
    50	    return _C.tensor(arr, device, requires_grad)
    51	
