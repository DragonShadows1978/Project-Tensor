@pytest.mark.parametrize('case', REFUSALS, ids=[r[0] for r in REFUSALS])
def test_refusal(case):
    _, call, exc, frag = case
    with pytest.raises(exc, match=re.escape(frag)):
        call()
    torch.cuda.synchronize()            # no launch error left behind


