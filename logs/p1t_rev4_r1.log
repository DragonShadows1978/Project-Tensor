   474	// Makes `device` current for its scope and restores the caller's device; never throws (ok()/error() report failure,
   475	// and a failed call clears the runtime's last-error slot so a later, unrelated launch check does not report it).
   476	class QuietDeviceGuard {
   477	 public:
   478	  explicit QuietDeviceGuard(int device) noexcept {
   479	    cudaError_t e = cudaGetDevice(&prev_);
   480	    if (e != cudaSuccess) {
   481	      cudaGetLastError();
   482	      err_ = e;
   483	      return;
   484	    }
   485	    if (prev_ != device) {
   486	      e = cudaSetDevice(device);
   487	      if (e != cudaSuccess) {
   488	        cudaGetLastError();
   489	        err_ = e;
   490	        return;
   491	      }
   492	      switched_ = true;
   493	    }
   494	  }
   495	  ~QuietDeviceGuard() {
   496	    if (switched_) cudaSetDevice(prev_);
   497	  }
   498	  QuietDeviceGuard(const QuietDeviceGuard&) = delete;
   499	  QuietDeviceGuard& operator=(const QuietDeviceGuard&) = delete;
   500	  bool ok() const { return err_ == cudaSuccess; }
   501	  cudaError_t error() const { return err_; }
   502	
   503	 private:
   504	  int prev_ = 0;
   505	  cudaError_t err_ = cudaSuccess;
   506	  bool switched_ = false;
   507	};
