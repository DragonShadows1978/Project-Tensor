   229	// ===================================================================== DLPack
   230	// P1T-M1 (Project-Voice T1): zero-copy DLPack export/import.
   231	//
   232	// Prior art: DLPack (dmlc/dlpack, 2017-; v1.3 header vendored verbatim at
   233	// include/dlpack/dlpack.h); the Python array API standard's data-interchange
   234	// protocol (__dlpack__(stream=, max_version=, dl_device=, copy=) and
   235	// __dlpack_device__; Consortium for Python Data API Standards, 2021-2023);
   236	// PyTorch's ATen DLConvertor/torch.utils.dlpack and CuPy's from_dlpack
   237	// (owner keepalive: the manager context owns a reference to the producer's
   238	// storage, and the consumer keeps the manager until its tensor dies; capsule
   239	// renamed "used_*" on consumption). Taken: the protocol, capsule naming and
   240	// the keepalive pattern; the event-record + cudaStreamWaitEvent fence is the
   241	// standard CUDA cross-stream idiom. Ours: wiring it to tc::Storage (a
   242	// shared_ptr<Storage> owner on export; an external-release Storage that
   243	// drains the engine stream before the deleter on import, kernels.cu).
   244	constexpr const char* kCapLegacy = "dltensor";
   245	constexpr const char* kCapVersioned = "dltensor_versioned";
   246	constexpr const char* kCapUsedLegacy = "used_dltensor";
   247	constexpr const char* kCapUsedVersioned = "used_dltensor_versioned";
