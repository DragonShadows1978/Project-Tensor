"""P1T-FIX2: regenerate the round-2 reviewer's core_cpu.cpp probe from another source tree, exactly as the reviewer built it.

The committed probe (artifacts/p1t_rev2/probes/core_cpu.cpp, read-only here) is the reviewer's fixed text around four
VERBATIM source slices of d116ac0 (artifacts/p1t_rev2/source_slices.json; generator in logs/p1t_rev2_r1.log ~9124):
  kernels.cu   'size_t dtype_size' .. 'namespace {\ntemplate <typename T> __device__'
  autograd.cpp 'Tensor Tensor::make' .. 'Tensor Tensor::from_op'
  bindings.cpp 'std::string shape_str(const int64_t*' .. '// ---- export:'
  bindings.cpp 'Tensor tensor_empty' .. 'const char* const kDlpackDoc'
Because the probe embeds the OLD code, compiling it unmodified can only ever test d116ac0. This script takes the
reviewer's fixed text from the committed probe (everything outside the slices), cuts the same four slices from
<root> with the reviewer's own markers, and joins them in the same order. Self-check: with <root> = the d116ac0 tree
it must reproduce the committed probe byte for byte (printed as `selfcheck identical=True`).
Usage: regen_core_cpu_probe.py <committed_probe> <d116ac0_root> <root> <out.cpp>
Prior art: the reviewer's generator (P1T-REV2, logs/p1t_rev2_r1.log); no prior art known to me for the split-and-rejoin.
"""
import sys
from pathlib import Path

MARKS = [('tensor_cuda/src/kernels.cu', 'size_t dtype_size', 'namespace {\ntemplate <typename T> __device__'),
         ('tensor_cuda/src/autograd.cpp', 'Tensor Tensor::make', 'Tensor Tensor::from_op'),
         ('tensor_cuda/src/bindings.cpp', 'std::string shape_str(const int64_t*', '// ---- export:'),
         ('tensor_cuda/src/bindings.cpp', 'Tensor tensor_empty', 'const char* const kDlpackDoc')]


def slices(root):
    out = []
    for f, a, b in MARKS:
        s = (Path(root) / f).read_text()
        lo = s.index(a)
        hi = s.index(b, lo)
        out.append(s[lo:hi])
    return out


def frame(committed, base_slices):
    """The reviewer's fixed text: the committed probe split around the d116ac0 slices (asserted to occur in order)."""
    text = Path(committed).read_text()
    pieces, pos = [], 0
    for sl in base_slices:
        i = text.index(sl, pos)
        pieces.append(text[pos:i])
        pos = i + len(sl)
    pieces.append(text[pos:])
    return text, pieces


def join(pieces, sl):
    out = pieces[0]
    for k, s in enumerate(sl):
        out += s + pieces[k + 1]
    return out


def main():
    committed, base_root, root, out = sys.argv[1:5]
    text, pieces = frame(committed, slices(base_root))
    print('selfcheck identical=%s' % (join(pieces, slices(base_root)) == text))
    new = join(pieces, slices(root))
    Path(out).write_text(new)
    print('wrote %s (%d bytes) from %s' % (out, len(new), root))


if __name__ == '__main__':
    main()
"""A hand-built DLPack producer (ctypes) for testing tc_signal as a consumer of ANY producer, not just torch.

It exports a view of a torch CUDA tensor's memory as a DLPack capsule ("dltensor" or "dltensor_versioned") whose
fields the test controls: byte_offset, device type/id, dtype, strides, DLPack version, flags. It records the keyword
arguments `__dlpack__` received (stream, max_version, copy) and counts deleter calls, so the tests can check the
consumer rules: stream=1, exactly one deleter call per exported tensor on every path (success, refusal, unconsumed
capsule garbage-collected), byte_offset honoured, versioned and legacy capsules both read.

Prior art: the DLPack C ABI (dmlc/dlpack v1.3, include/dlpack/dlpack.h) and the Python array API `__dlpack__`
protocol; building PyCapsules through ctypes.pythonapi is standard CPython practice. The test producer itself is ours
(no prior art known to me).
"""
import ctypes

KDL_CUDA = 2
KDL_CPU = 1
KDL_FLOAT = 2
FLAG_READ_ONLY = 1 << 0
FLAG_IS_COPIED = 1 << 1


class DLDevice(ctypes.Structure):
    _fields_ = [('device_type', ctypes.c_int32), ('device_id', ctypes.c_int32)]


class DLDataType(ctypes.Structure):
    _fields_ = [('code', ctypes.c_uint8), ('bits', ctypes.c_uint8), ('lanes', ctypes.c_uint16)]


class DLTensor(ctypes.Structure):
    _fields_ = [('data', ctypes.c_void_p), ('device', DLDevice), ('ndim', ctypes.c_int32), ('dtype', DLDataType),
                ('shape', ctypes.POINTER(ctypes.c_int64)), ('strides', ctypes.POINTER(ctypes.c_int64)),
                ('byte_offset', ctypes.c_uint64)]


DELETER = ctypes.CFUNCTYPE(None, ctypes.c_void_p)


class DLManagedTensor(ctypes.Structure):
    _fields_ = [('dl_tensor', DLTensor), ('manager_ctx', ctypes.c_void_p), ('deleter', DELETER)]


class DLPackVersion(ctypes.Structure):
    _fields_ = [('major', ctypes.c_uint32), ('minor', ctypes.c_uint32)]


class DLManagedTensorVersioned(ctypes.Structure):
    _fields_ = [('version', DLPackVersion), ('manager_ctx', ctypes.c_void_p), ('deleter', DELETER),
                ('flags', ctypes.c_uint64), ('dl_tensor', DLTensor)]


CAPSULE_DESTRUCTOR = ctypes.CFUNCTYPE(None, ctypes.c_void_p)
_NAME = b'dltensor'
_NAME_V = b'dltensor_versioned'

_PyCapsule_New = ctypes.pythonapi['PyCapsule_New']
_PyCapsule_New.restype = ctypes.py_object
_PyCapsule_New.argtypes = [ctypes.c_void_p, ctypes.c_char_p, CAPSULE_DESTRUCTOR]
_PyCapsule_IsValid = ctypes.pythonapi['PyCapsule_IsValid']
_PyCapsule_IsValid.restype = ctypes.c_int
_PyCapsule_IsValid.argtypes = [ctypes.c_void_p, ctypes.c_char_p]
_PyCapsule_GetPointer = ctypes.pythonapi['PyCapsule_GetPointer']
_PyCapsule_GetPointer.restype = ctypes.c_void_p
_PyCapsule_GetPointer.argtypes = [ctypes.c_void_p, ctypes.c_char_p]

LIVE = {}                                     # managed-tensor address -> kept-alive objects
STATS = {'exported': 0, 'deleted': 0, 'unknown_delete': 0}


def _delete(addr):
    if LIVE.pop(addr, None) is None:
        STATS['unknown_delete'] += 1          # double delete or a pointer we never exported
    else:
        STATS['deleted'] += 1


@DELETER
def _deleter(addr):
    _delete(addr)


@CAPSULE_DESTRUCTOR
def _capsule_destructor(cap):
    # The producer side of the protocol: an unconsumed capsule (name unchanged) deletes its tensor when collected;
    # a consumed one (renamed "used_*") belongs to the consumer, who calls the deleter.
    for name in (_NAME, _NAME_V):
        if _PyCapsule_IsValid(cap, name):
            _delete(_PyCapsule_GetPointer(cap, name))
            return


def reset_stats():
    for k in STATS:
        STATS[k] = 0


class Producer:
    """DLPack view of `base` (a torch CUDA tensor) starting `offset_elems` elements in, with logical `shape`.

    Knobs: versioned (capsule kind), byte_offset_mode ('data' = data pointer already offset, byte_offset 0;
    'field' = data = base pointer, byte_offset carries the offset), extra_byte_offset (added to byte_offset, e.g. 2
    to misalign), device_type, device_id, dtype (code, bits, lanes), strides (None or a tuple), major (DLPack major
    version), flags."""

    def __init__(self, base, shape, *, offset_elems=0, versioned=True, byte_offset_mode='field', extra_byte_offset=0,
                 device_type=KDL_CUDA, device_id=None, dtype=(KDL_FLOAT, 32, 1), strides=None, major=1, flags=0,
                 return_value=None):
        self.base, self.shape, self.offset_elems = base, tuple(shape), offset_elems
        self.versioned, self.byte_offset_mode, self.extra_byte_offset = versioned, byte_offset_mode, extra_byte_offset
        self.device_type = device_type
        self.device_id = base.device.index if device_id is None else device_id
        self.dtype, self.strides, self.major, self.flags = dtype, strides, major, flags
        self.return_value = return_value
        self.calls = []                       # kwargs of every __dlpack__ call

    def __dlpack_device__(self):
        return (self.device_type, self.device_id)

    def __dlpack__(self, *, stream=None, max_version=None, dl_device=None, copy=None):
        self.calls.append({'stream': stream, 'max_version': max_version, 'dl_device': dl_device, 'copy': copy})
        if self.return_value is not None:
            return self.return_value
        return self._export(versioned=self.versioned and max_version is not None and max_version[0] >= 1)

    def _export(self, versioned):
        nd = len(self.shape)
        shape = (ctypes.c_int64 * nd)(*self.shape)
        strides = None if self.strides is None else (ctypes.c_int64 * nd)(*self.strides)
        elem = self.base.element_size()
        if self.byte_offset_mode == 'field':
            data, boff = self.base.data_ptr(), self.offset_elems * elem
        else:
            data, boff = self.base.data_ptr() + self.offset_elems * elem, 0
        boff += self.extra_byte_offset
        m = DLManagedTensorVersioned() if versioned else DLManagedTensor()
        t = m.dl_tensor
        t.data = data
        t.device = DLDevice(self.device_type, self.device_id)
        t.ndim = nd
        t.dtype = DLDataType(*self.dtype)
        t.shape = shape
        t.strides = strides if strides is not None else ctypes.POINTER(ctypes.c_int64)()
        t.byte_offset = boff
        m.manager_ctx = None
        m.deleter = _deleter
        if versioned:
            m.version = DLPackVersion(self.major, 3)
            m.flags = self.flags
        addr = ctypes.addressof(m)
        LIVE[addr] = (m, shape, strides, self.base)
        STATS['exported'] += 1
        return _PyCapsule_New(addr, _NAME_V if versioned else _NAME, _capsule_destructor)


class LegacyOnlyProducer(Producer):
    """A pre-2023 producer: __dlpack__ accepts only `stream` (newer keywords raise TypeError)."""

    def __dlpack__(self, *, stream=None):
        self.calls.append({'stream': stream})
        return self._export(versioned=False)
"""Project Tensor — standalone CUDA tensor library (no PyTorch, no CuPy).

Phase 1 (the core engine) exposes a NumPy-friendly Tensor with reverse-mode
autograd backed entirely by hand-written CUDA kernels + cuBLAS. The C++ does the
work; this module is the thin Python ergonomics layer (factory helpers, dtype
plumbing, no_grad). See ROADMAP.md for the layers still being ported.
"""

from __future__ import annotations

import atexit
import contextlib
from collections.abc import Mapping
import operator
import sys

import numpy as np

try:
    from . import _tensor_cuda as _C
except ImportError:  # pragma: no cover
    import _tensor_cuda as _C  # fallback when the .so sits on PYTHONPATH

Tensor = _C.Tensor
ApaInt4Workspace = _C.ApaInt4Workspace

_NP_DTYPE = {
    "float32": np.float32,
    "float16": np.float16,
    "int64": np.int64,
    "bool": np.bool_,
    "uint8": np.uint8,
}

# bfloat16 has no NumPy equivalent: build the host array as fp32 and cast the
# device tensor to bf16 afterward. Listing it here so callers passing
# dtype="bfloat16" no longer fall through _NP_DTYPE.get(..., np.float32) and get
# a SILENT fp32 downcast (which corrupts bf16 constants for OLMoE/Qwen-class
# models). dtype_from_string in the C++ already supports "bfloat16".
_DEVICE_CAST_DTYPE = {"bfloat16"}


def tensor(data, *, device="cuda", dtype="float32", requires_grad=False):
    """Create a Tensor from array-like data."""
    if dtype in _DEVICE_CAST_DTYPE:
        arr = np.ascontiguousarray(np.asarray(data, dtype=np.float32))
        return _C.tensor(arr, device, requires_grad).astype(dtype)
    arr = np.asarray(data, dtype=_NP_DTYPE.get(dtype, np.float32))
    arr = np.ascontiguousarray(arr)
    return _C.tensor(arr, device, requires_grad)


def _factory(np_fn):
    def make(*shape, device="cuda", dtype="float32", requires_grad=False):
        if len(shape) == 1 and isinstance(shape[0], (tuple, list)):
            shape = tuple(shape[0])
        if dtype in _DEVICE_CAST_DTYPE:
            arr = np.ascontiguousarray(np_fn(shape).astype(np.float32))
            return _C.tensor(arr, device, requires_grad).astype(dtype)
        arr = np_fn(shape).astype(_NP_DTYPE.get(dtype, np.float32))
        return _C.tensor(np.ascontiguousarray(arr), device, requires_grad)
    return make


zeros = _factory(np.zeros)
ones = _factory(np.ones)
randn = _factory(lambda s: np.random.randn(*s))
rand = _factory(lambda s: np.random.rand(*s))


def from_numpy(arr, *, device="cuda", requires_grad=False):
    return _C.tensor(np.ascontiguousarray(arr), device, requires_grad)


