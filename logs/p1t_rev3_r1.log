   823	// Amendment 1: device-side empty (no host round-trip, no fill).
   824	// P1T-FIX1, F03: refuses rank > TC_MAX_DIMS (the engine's op metadata arrays
   825	// hold 8 axes) and any element-count or byte-size overflow, with ValueError,
   826	// before allocating; a CPU allocation failure raises MemoryError instead of
   827	// returning a nonempty tensor over a NULL buffer.
   828	Tensor tensor_empty(std::vector<int64_t> shape, const std::string& dtype,
   829	                    const std::string& device) {
   830	  if (shape.size() > static_cast<size_t>(TC_MAX_DIMS))
   831	    throw py::value_error("empty: " + std::to_string(shape.size()) +
   832	                          " dimensions exceed TensorCUDA's maximum rank " +
   833	                          std::to_string(TC_MAX_DIMS) + " (TC_MAX_DIMS)");
   834	  for (int64_t s : shape)
   835	    if (s < 0) throw py::value_error("empty: negative dimensions are not allowed");
   836	  const DType dt = dtype_from_string(dtype);
   837	  const int nd = static_cast<int>(shape.size());
   838	  const int64_t numel = checked_numel(shape.data(), nd, "empty");
   839	  const int64_t nbytes = checked_nbytes(numel, dtype_size(dt), shape.data(), nd, "empty");
   840	  NDArray a = NDArray::empty(Shape(shape.begin(), shape.end()), dt, Device::from_string(device));
   841	  if (nbytes > 0 && a.storage->ptr == nullptr) throw std::bad_alloc();  // -> MemoryError
   842	  return Tensor::make(a, false);
   843	}
