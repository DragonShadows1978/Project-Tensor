// Project Tensor — standalone CUDA tensor library (no PyTorch, no CuPy).
//
// core.h: device memory (Storage), the raw n-dimensional array (NDArray) that
// every CUDA kernel operates on, dtype/device descriptors, and the host-side
// op declarations. NDArray carries NO autograd state — it is the workhorse.
// Autograd lives one layer up (autograd.h).
//
// Phase 1 design choices (see ROADMAP.md):
//   * NDArrays are always contiguous, row-major. transpose/permute physically
//     materialize; reshape is metadata-only. This keeps kernels simple and
//     correct; strided views are a later optimization.
//   * Kernels are dtype-generic by computing in fp32 (load->float, store->T),
//     so fp32 and fp16 share one code path.
//   * Max rank is 8 (TC_MAX_DIMS), enough for NCHW + attention (B,H,L,D).

#pragma once

#include <cstdint>
#include <memory>
#include <string>
#include <tuple>
#include <utility>
#include <vector>

namespace tc {

constexpr int TC_MAX_DIMS = 8;

// ----------------------------------------------------------------------- dtype
enum class DType : int8_t { Float32 = 0, Float16 = 1, Int64 = 2, Bool = 3, Uint8 = 4, BFloat16 = 5 };

size_t dtype_size(DType dt);
const char* dtype_name(DType dt);
DType dtype_from_string(const std::string& s);

// ---------------------------------------------------------------------- device
enum class DeviceType : int8_t { CPU = 0, CUDA = 1 };

struct Device {
  DeviceType type = DeviceType::CUDA;
  int index = 0;
  bool is_cuda() const { return type == DeviceType::CUDA; }
  std::string str() const;
  static Device from_string(const std::string& s);
};

using Shape = std::vector<int64_t>;

// P1T-FIX2 (N2): numel_of returns 0 for a shape with a zero extent without multiplying the others, and both helpers
// use checked products: an overflow throws std::overflow_error instead of wrapping (kernels.cu). The DLPack/empty
// entry points refuse such shapes first (bindings.cpp, the zero-extent rule).
int64_t numel_of(const Shape& shape);
Shape contiguous_strides(const Shape& shape);

// --------------------------------------------------------------------- Storage
// Reference-counted device (or host) memory buffer.
struct Storage {
  void* ptr = nullptr;
  size_t nbytes = 0;
  Device device;
  bool pooled = false;  // allocated via cudaMallocAsync (small) vs raw cudaMalloc (large)
  // Monotonic host-side generation shared by every view of this allocation.
  // In-place engine operations bump it after enqueueing their write, allowing
  // persistent derived tensors to invalidate without hashing device bytes.
  uint64_t revision = 0;
  // P1T-M1 (DLPack import): external memory owned by another library. When
  // `external_release` is set, the engine neither pools nor frees `ptr`: the
  // destructor first drains the engine stream OF THIS STORAGE'S DEVICE (P1T-FIX1
  // F05: it switches to `device.index` if another device is current, syncs that
  // device's legacy stream, and restores the caller's device), so no queued
  // engine kernel can still touch the memory; then it calls
  // external_release(external_ctx), which hands the memory back to its producer
  // (bindings.cpp calls the DLPack deleter with the GIL held). If the drain
  // fails, the release is NOT called: the memory is deliberately leaked
  // (counted by storage_external_drain_leaks) rather than risk a use-after-free.
  // Prior art: the owner-keepalive pattern of the PyTorch/CuPy DLPack importers
  // (ATen's from_dlpack deleter-in-storage, 2017+); the drain-before-release
  // ordering is ours (see kernels.cu).
  //
  // ABI NOTE (P1T-FIX1 F07): these two members grew sizeof(Storage) from 40 to
  // 56 bytes (x86-64, CPU layout measurement in the P1T-REV review). Any native
  // client compiled against an older core.h must be rebuilt together with this
  // core; mixing layouts is undefined behaviour. None is known (tc_signal does
  // not include core headers). Rollout note: docs/P1T_FIX1_M1_ADDENDUM.md.
  using ExternalRelease = void (*)(void* ctx);
  ExternalRelease external_release = nullptr;
  void* external_ctx = nullptr;

  Storage(size_t nbytes, Device device);
  // Wrap `external_ptr` (nbytes long, on `device`) without allocating.
  Storage(void* external_ptr, size_t nbytes, Device device,
          ExternalRelease release, void* release_ctx);
  bool is_external() const { return external_release != nullptr; }
  ~Storage();
  Storage(const Storage&) = delete;
  Storage& operator=(const Storage&) = delete;
};

// P1T-FIX1 (F05): external Storages whose device drain failed in the destructor
// and whose producer memory was therefore deliberately leaked (process-wide).
unsigned long long storage_external_drain_leaks();

// --------------------------------------------------------------------- NDArray
// A view-able handle over a Storage: shape + dtype + element offset. In Phase 1
// the data is contiguous; shape/strides are kept in sync by contiguous_strides.
class NDArray {
 public:
  std::shared_ptr<Storage> storage;
  Shape shape;
  DType dtype = DType::Float32;
  Device device;
  int64_t offset = 0;  // in elements

  NDArray() = default;
  NDArray(const Shape& shape, DType dtype, Device device);

  static NDArray empty(const Shape& shape, DType dtype, Device device);
  static NDArray zeros(const Shape& shape, DType dtype, Device device);
  static NDArray full(const Shape& shape, double value, DType dtype, Device device);

  int64_t numel() const { return numel_of(shape); }
  int ndim() const { return static_cast<int>(shape.size()); }
  bool defined() const { return storage != nullptr; }
  void* data_ptr() const;
  uint64_t revision() const { return storage ? storage->revision : 0; }
  void mark_modified() const {
    if (storage) ++storage->revision;
  }

  // Host<->device transfer (host buffer is contiguous, matching `dtype`).
  static NDArray from_host(const void* src, const Shape& shape, DType dtype, Device device);
  void to_host(void* dst) const;

  NDArray to(Device device) const;
  NDArray astype(DType dtype) const;
  NDArray clone() const;
  NDArray reshape(const Shape& new_shape) const;  // metadata-only (contiguous)
  NDArray contiguous() const { return *this; }     // Phase 1: always contiguous
};

// ------------------------------------------------------------- raw CUDA ops
// All return freshly-allocated contiguous NDArrays. Declared here, launched in
// src/kernels.cu and src/matmul.cu.

// Elementwise binary with NumPy broadcasting. op: 0=add 1=sub 2=mul 3=div.
NDArray ew_binary(const NDArray& a, const NDArray& b, int op);
NDArray ew_scalar(const NDArray& a, double scalar, int op, bool scalar_lhs);

// Elementwise unary. op enum mirrors UnaryOp below.
enum UnaryOp {
// P1T-M1: in-place fill through the EXISTING fill_kernel (no new kernel),
// queued on the engine stream like NDArray::full; an in-place engine write,
// so it bumps the Storage revision after enqueueing (core.h contract).
// Prior art: torch.Tensor.fill_ / numpy ndarray.fill (API shape only).
void fill_(NDArray& a, double value) {
  if (!a.defined()) throw std::runtime_error("fill_: undefined array");
  if (!a.device.is_cuda()) throw std::runtime_error("fill_: CUDA arrays only");
  int64_t n = a.numel();
  if (n == 0) return;
  DISPATCH_FLOAT(a.dtype, T, {
    fill_kernel<T><<<nblk(n), kT>>>(static_cast<T*>(a.data_ptr()), n, (float)value);
  });
  cuda_check_last("fill_");
  a.mark_modified();
}
NDArray NDArray::from_host(const void* src, const Shape& shape, DType dtype, Device device) {
  NDArray a(shape, dtype, device);
  size_t bytes = a.numel() * dtype_size(dtype);
  if (bytes == 0) return a;
  if (device.is_cuda()) cudaMemcpy(a.data_ptr(), src, bytes, cudaMemcpyHostToDevice);
  else std::memcpy(a.data_ptr(), src, bytes);
  cuda_check_last("from_host");
  return a;
}
void NDArray::to_host(void* dst) const {
  size_t bytes = numel() * dtype_size(dtype);
  if (bytes == 0) return;
  if (device.is_cuda()) cudaMemcpy(dst, data_ptr(), bytes, cudaMemcpyDeviceToHost);
  else std::memcpy(dst, data_ptr(), bytes);
  cuda_check_last("to_host");
}
// tc_signal kernel tunables. House tunable law: no launch-shape literals at the use sites; every knob lives here.
// None of these changes numerics: each output element's summation order is fixed by the kernel code, not by the
// launch shape (grid-stride loops; one thread owns one output element). Changing a knob changes speed only.
#pragma once

namespace tcs {
namespace tuning {

// Threads per block for the 1-D im2col kernel (one thread per col element).
constexpr int kIm2colBlock = 256;
// Threads per block for the bias-add kernel (one thread per output element).
constexpr int kBiasBlock = 256;
// Threads per block for the gather-form ConvTranspose1d kernel (one thread per output element).
constexpr int kConvTransposeBlock = 256;
// Threads per block for the fp32 division canary kernel (fast-math probe; tests only).
constexpr int kProbeBlock = 256;
// Upper bound on blocks per launch; the kernels are grid-stride loops, so larger problems loop instead.
constexpr long long kGridCap = 1LL << 20;

// DLPack version this consumer asks producers for (`__dlpack__(max_version=...)`); the vendored header is v1.3.
constexpr int kDlpackMaxMajor = 1;
constexpr int kDlpackMaxMinor = 3;
// DLPack stream argument for the consumer stream: 1 = the legacy default stream (Python array API convention).
constexpr int kDlpackLegacyStream = 1;

// P1T-FIX1 (F01) deferred release: bounds of the pending list of consumed DLPack managers that wait for the legacy
// stream to pass their call (dlpack_operand.h, RetainUntilComplete). When a new entry pushes the list past either
// bound, tc_signal synchronizes the legacy stream of every pending device and releases the whole list. These only
// trade memory held (by producers' blocks waiting for release) against how often a call blocks; numerics never change.
// Entries: one per tc_signal call that reached its launch.
constexpr long long kPendingMaxEntries = 1024;
// Bytes: the sum of the fp32 operand sizes held by the pending entries (inputs, outputs and scratch).
constexpr long long kPendingMaxBytes = 256LL << 20;
// P1T-FIX2 (N3): fixed capacities of the allocation-free bookkeeping in synchronize/the bound drain. Devices whose sync
// result is remembered per call (a device beyond this is still synchronized; its failure is kept as one conservative
// flag), and CUDA failures named in one synchronize() error message (the rest are counted). Neither changes numerics.
constexpr int kSyncMaxDevices = 64;
constexpr int kSyncReportMax = 8;

}  // namespace tuning
}  // namespace tcs
// P1T-M4 host launchers (T5 norms, T6 small ops) and their tunables. Raw device pointers in, everything queued on the
// legacy default stream; nothing here allocates device memory (outputs come from the Python layer's allocator).
//
// House tunable law: every launch-shape knob of the M4 kernels lives here. None of them changes numerics except
// kNormBlock and kNormChunk, which fix the summation order of the norm statistics (see norms.cu); changing either one
// changes the last bits of the statistics (still fp32, still deterministic) and must be re-gated.
#pragma once

#include <cstdint>

namespace tcs {
namespace m4tuning {

// Threads per block of the row-norm kernel = the width of its reduction tree (one block per row). Power of two.
constexpr int kNormBlock = 256;
// Blocked summation inside a thread: a thread's strided terms are summed kNormChunk at a time into a partial sum, which
// is then added to the thread total (error bound (kNormChunk + n/kNormChunk) u instead of n u for n terms).
constexpr int kNormChunk = 32;
// Threads per block of the gather kernels (upsample, reflection pad) and of rint (one thread per output element).
constexpr int kCopyBlock = 256;

static_assert(kNormBlock > 0 && (kNormBlock & (kNormBlock - 1)) == 0, "kNormBlock must be a power of two");
static_assert(kNormChunk > 0, "kNormChunk must be positive");

}  // namespace m4tuning

// Where a row-norm output element finds its scale/bias entry.
enum class NormAffine : int {
  kPerRow = 0,      // instance norm: rows are (n, c); entry c = row % channels
  kPerElem = 1,     // layer norm: entry j (the element's index inside the normalized block)
  kPerChannel = 2,  // group norm: rows are (n, g); entry (row % groups) * ch_per_group + j / T
};

// One normalization problem: `rows` contiguous rows of length L, each normalized over itself.
struct RowNormGeom {
  int64_t rows;
  int64_t L;
  float eps;
  NormAffine affine;
  int64_t channels;      // kPerRow: C
  int64_t groups;        // kPerChannel: G
  int64_t ch_per_group;  // kPerChannel: C / G
  int64_t T;             // kPerChannel: time length (elements per channel)
};

// y = ((x - K) - d) * rstd * scale + bias per row, fp32 shifted two-pass statistics (norms.cu). scale/bias may be NULL.
void row_norm_forward(int device, const RowNormGeom& g, const float* x, const float* scale, const float* bias,
                      float* y);

// y[r, i] = x[r, i / scale] for rows r of length T, output length T * scale (bit copy).
void upsample_nearest1d_forward(int device, int64_t rows, int64_t T, int64_t scale, const float* x, float* y);

// ONNX/torch reflect pad of the last axis by (pad_begin, pad_end), each < T (bit copy).
void reflection_pad1d_forward(int device, int64_t rows, int64_t T, int64_t pad_begin, int64_t pad_end, const float* x,
                              float* y);

// y = rintf(x) elementwise (IEEE 754 roundTiesToEven, sign of zero kept, NaN and +-Inf pass through).
void rint_forward(int device, int64_t n, const float* x, float* y);

}  // namespace tcs

