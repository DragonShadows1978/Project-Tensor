+    if (__builtin_mul_overflow(n, s, &n))
+      throw std::overflow_error("numel_of: the element count of a shape overflows int64");
+  return n;  // 1 for a 0-d shape
 }
 Shape contiguous_strides(const Shape& shape) {
   Shape st(shape.size());
