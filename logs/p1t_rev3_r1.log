   596	bool interpreter_accepts_gil_state() {
   597	  if (!Py_IsInitialized()) return false;
   598	#if PY_VERSION_HEX >= 0x030D0000
   599	  if (Py_IsFinalizing()) return false;
   600	#else
   601	  if (_Py_IsFinalizing()) return false;
   602	#endif
   603	  return true;
   604	}
