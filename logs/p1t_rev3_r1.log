_THROWER_SRC = r'''
// P1T-FIX2 test producer: a DLPack deleter that throws a C++ exception (out of the DLPack C contract on purpose).
#include <atomic>
#include <stdexcept>
static std::atomic<long> g_calls{0};
extern "C" void fix2_throwing_deleter(void*) {
  g_calls.fetch_add(1);
  throw std::runtime_error("fix2 test producer deleter threw");
}
extern "C" long fix2_throwing_deleter_calls() { return g_calls.load(); }
'''


@pytest.fixture(scope='module')
def thrower(tmp_path_factory):
    d = tmp_path_factory.mktemp('fix2_thrower')
    src, so = d / 'fix2_thrower.cpp', d / 'fix2_thrower.so'
    src.write_text(_THROWER_SRC)
    r = subprocess.run(['g++', '-shared', '-fPIC', '-O1', '-std=c++17', '-o', str(so), str(src)], capture_output=True,
                       text=True, timeout=SUBPROC_TIMEOUT)
    assert r.returncode == 0, r.stderr
    return str(so)


_N4 = _PRELUDE + r'''
lib = ctypes.CDLL(sys.argv[1])
native_calls = lib.fix2_throwing_deleter_calls
native_calls.restype = ctypes.c_long
thrower = ctypes.cast(lib.fix2_throwing_deleter, ctypes.c_void_p).value
mode = sys.argv[2]
N = (40 << 20) if mode == 'bound_drain' else 4096
x = torch.full((N,), 1.25, device='cuda')
y = torch.empty(N, device='cuda')
ts.rint(torch.ones(8, device='cuda'), out=torch.empty(8, device='cuda'))
ts.synchronize()
s0 = dict(_C.pending_stats())
cx, cy = native_capsule(x, thrower), native_capsule(y, thrower)
res = {'mode': mode}
if mode == 'immediate':
    ybad = torch.empty(N + 1, device='cuda')
    cy = native_capsule(ybad, thrower)
    try:
        ts.rint(cx, out=cy)                    # refused after both are consumed, before the launch
    except ValueError as e:
        res['refusal'] = str(e)
elif mode == 'deferred':
    ts.rint(cx, out=cy)
    torch.cuda.synchronize()
    res['calls_before_next_call'] = int(native_calls())
    ts.rint(torch.ones(8, device='cuda'), out=torch.empty(8, device='cuda'))   # its drain releases the entry
elif mode == 'synchronize':
    ts.rint(cx, out=cy)
    ts.synchronize()
elif mode == 'bound_drain':
    ts.rint(cx, out=cy)                        # 320 MiB > the 256 MiB bound: drained in the call's destructor
elif mode == 'fallback_sync':
    _C._test_inject(['cuda:event_record'])
    ts.rint(cx, out=cy)                        # no event -> synchronous release in the destructor
elif mode == 'atexit':
    ts.rint(cx, out=cy)
    REPORT_AT_EXIT = True                      # released by tc_signal's own exit hook; reported after it
res['calls'] = int(native_calls())
res['delta'] = delta(s0, dict(_C.pending_stats()))
if mode != 'atexit':
    torch.cuda.synchronize()
    res['correct'] = bool(torch.all(y == 1.0).item()) if mode != 'immediate' else None
print('RESULT ' + json.dumps(res), flush=True)
'''


@pytest.mark.parametrize('mode', ['immediate', 'deferred', 'bound_drain', 'fallback_sync', 'synchronize', 'atexit'])
def test_n4_throwing_producer_deleter_is_contained_on_every_path(thrower, mode):
    r, res = _run(_N4, thrower, mode)
    _ok(r, res)                                                   # mutant (d) terminates here (rc -6)
    assert 'terminate called' not in r.stderr, r.stderr
    if mode == 'atexit':
        line = [ln for ln in r.stdout.splitlines() if ln.startswith('ATEXIT ')]
        assert line, r.stdout
        at = json.loads(line[-1][len('ATEXIT '):])
        assert res['calls'] == 0 and at['calls'] == 2, (res, at)          # both deleters ran at exit, once each
        assert at['stats']['deleter_exceptions'] == 2 and at['stats']['entries'] == 0, at
        return
    assert res['calls'] == 2, res                                 # each throwing deleter ran exactly once ...
    assert res['delta']['deleter_exceptions'] == 2, res           # ... and both exceptions were contained, counted
    if mode == 'immediate':
        assert 'shape' in res.get('refusal', ''), res
    else:
        assert res['correct'] is True, res
    if mode == 'deferred':
        assert res['calls_before_next_call'] == 0, res
    if mode == 'bound_drain':
        assert res['delta']['bound_drains'] == 1, res
    if mode == 'fallback_sync':
        assert res['delta']['fallback_syncs'] == 1, res
// ------------------------------------------------------------------------------------------------ ck_census (N2)
int ck_census() {
  const int64_t P62 = int64_t{1} << 62, P61 = int64_t{1} << 61, MAX = INT64_MAX;
  const std::vector<std::vector<int64_t>> refuse = {
      {0, P62, 4}, {P62, 0, 4}, {P62, 4, 0},          // element bound 2^64
      {0, MAX, 2}, {MAX, 2, 0}, {2, 0, MAX},          // element bound 2^64 - 2
      {0, MAX}, {MAX, 0}, {0, MAX, 1}, {1, 0, MAX},   // element bound fits, fp32 bytes overflow
      {0, P62}, {P62, 0}, {0, P61}, {P61, 0, 1},      // bytes 2^64 / 2^63
  };
  const std::vector<std::pair<std::vector<int64_t>, int64_t>> accept = {
      {{0, int64_t{1} << 20, 4}, 0}, {{2, 3, 4}, 24}, {{0, int64_t{1} << 60}, 0}, {{}, 1}};
  int failures = 0, cases = 0;
  auto refused = [](auto&& fn, std::string& msg) {
    try {
      fn();
    } catch (const py::value_error& e) {
      msg = e.what();
      return true;
    } catch (const py::error_already_set& e) {
      msg = e.what();
      return true;
    }
    return false;
  };
  for (const auto& s : refuse) {
    std::string m1, m2, m3;
    const bool r1 = refused([&] { tcs::ck_shape_numel(s, "census ck_shape_numel"); }, m1);
    const bool r2 = refused([&] { tcs::ck_prod(s, 0, s.size(), "census ck_prod"); }, m2);
    // validate_tensor on a descriptor (never dereferenced beyond its shape): must refuse, as an OVERFLOW.
    DLTensor t{};
    std::vector<int64_t> shape = s;
    t.data = reinterpret_cast<void*>(0x1000);
    t.device.device_type = kDLCUDA;
    t.device.device_id = 0;
    t.ndim = static_cast<int>(shape.size());
    t.dtype.code = kDLFloat;
    t.dtype.bits = 32;
    t.dtype.lanes = 1;
    t.shape = shape.data();
    const bool r3 = refused([&] { tcs::validate_tensor(&t, "census", t.ndim); }, m3);
    const bool r3_overflow = r3 && m3.find("overflows") != std::string::npos;
    // ck_prod checks the element bound only (byte-only cases are refused by ck_shape_numel / validate_tensor).
    bool elem_overflow = false;
    {
      int64_t p = 1;
      for (int64_t e : s) elem_overflow |= __builtin_mul_overflow(p, e > 1 ? e : 1, &p);
    }
    const bool ok = r1 && (r2 == elem_overflow) && r3_overflow;
    ++cases;
    if (!ok) ++failures;
    std::printf("{\"shape\": \"%s\", \"ck_shape_numel_refused\": %s, \"ck_prod_refused\": %s, "
                "\"ck_prod_expected_refused\": %s, \"validate_refused_as_overflow\": %s, \"validate_msg\": \"%s\", "
                "\"ok\": %s}\n",
                tcs::shape_str(s).c_str(), r1 ? "true" : "false", r2 ? "true" : "false",
                elem_overflow ? "true" : "false", r3_overflow ? "true" : "false", m3.c_str(), ok ? "true" : "false");
  }
  for (const auto& a : accept) {
    std::string m;
    int64_t n = -1;
    const bool r = refused([&] { n = tcs::ck_shape_numel(a.first, "census control"); }, m);
    const bool ok = !r && n == a.second;
    ++cases;
    if (!ok) ++failures;
    std::printf("{\"control\": \"%s\", \"count\": %lld, \"expected\": %lld, \"ok\": %s}\n",
                tcs::shape_str(a.first).c_str(), static_cast<long long>(n), static_cast<long long>(a.second),
                ok ? "true" : "false");
  }
  std::printf("{\"summary\": {\"mode\": \"ck_census\", \"cases\": %d, \"failures\": %d}}\n", cases, failures);
  return failures == 0 ? 0 : 1;
}
}  // namespace

int main(int argc, char** argv) {
  py::scoped_interpreter python{};
  if (argc != 2) return 2;
  int rc = 2;
  if (std::strcmp(argv[1], "oom_sweep") == 0) rc = oom_sweep();
  if (std::strcmp(argv[1], "ck_census") == 0) rc = ck_census();
  std::fflush(stdout);
  return rc;
}
"""float64 CPU oracles for tc_signal's own tests (torch, same process), plus the normwise metric.

conv1d: ONNX Conv 1-D = zero-pad the time axis by (pad_begin, pad_end), then torch's conv1d with padding 0.
conv_transpose1d: ONNX ConvTranspose 1-D = torch's conv_transpose1d with padding 0 and output_padding 0 (the "full"
output, length stride*(T-1) + dilation*(K-1) + 1), zero-extended at the end when output_padding reaches past it, then
the window [pad_begin, pad_begin + L) with L = stride*(T-1) + output_padding + dilation*(K-1) + 1 - pb - pe, then bias.
This construction is independent of the CUDA kernels' formulas (im2col / gather); test_oracle_matches_torch_native
checks it against torch's own symmetric-padding path where both apply.

Normwise N = ||y - o||_inf / ||o||_inf (Higham, Accuracy and Stability of Numerical Algorithms, 2nd ed. 2002; the same
metric as Voice's runner, common.normwise). Prior art for the oracles: ONNX Conv/ConvTranspose specs; torch.nn.functional.
"""
import torch
import torch.nn.functional as F

F64 = torch.float64


def _cpu64(t):
    return None if t is None else t.detach().to(device='cpu', dtype=F64)


def conv1d_f64(x, w, b, *, stride, pads, dilation, groups):
    xc, wc, bc = _cpu64(x), _cpu64(w), _cpu64(b)
    xp = F.pad(xc, (int(pads[0]), int(pads[1])))
    return F.conv1d(xp, wc, bc, stride=stride, padding=0, dilation=dilation, groups=groups)


def conv_transpose1d_f64(x, w, b, *, stride, pads, output_padding, dilation, groups):
    xc, wc, bc = _cpu64(x), _cpu64(w), _cpu64(b)
    T, K = xc.shape[-1], wc.shape[-1]
    pb, pe = int(pads[0]), int(pads[1])
    full = F.conv_transpose1d(xc, wc, None, stride=stride, padding=0, output_padding=0, dilation=dilation,
                              groups=groups)
    L = stride * (T - 1) + output_padding + dilation * (K - 1) + 1 - pb - pe
    need = pb + L
    if need > full.shape[-1]:
        full = F.pad(full, (0, need - full.shape[-1]))
    y = full[:, :, pb:pb + L].clone()
    if bc is not None:
        y += bc.view(1, -1, 1)
    return y


def normwise(y, o):
    """N over the float64 values; o == 0 everywhere passes only if y is exactly 0 (Voice common.normwise rule)."""
    y = y.detach().to(device='cpu', dtype=F64)
    den = o.abs().max().item()
    num = (y - o).abs().max().item()
    if den == 0.0:
        return 0.0 if num == 0.0 else float('inf')
    return num / den


def bits_equal(a, b):
    """Bitwise equality of two fp32 tensors (on any device)."""
    return a.shape == b.shape and torch.equal(a.contiguous().view(torch.int32), b.contiguous().view(torch.int32))


def bit_mismatches(a, b):
    return int((a.contiguous().view(torch.int32) != b.contiguous().view(torch.int32)).sum().item())


def _f64(a):
    return None if a is None else np.asarray(a, dtype=F64)


def lstm_onnx_f64(x, W, R, B=None, *, direction, hidden_size, initial_h=None, initial_c=None, return_zmax=False):
    """Returns (Y [T, D, N, H], Y_h [D, N, H], Y_c [D, N, H]) in float64 (and max |z| over every gate pre-activation
    when return_zmax)."""
    with _blas_threads():
        return _lstm_onnx_f64(x, W, R, B, direction=direction, hidden_size=hidden_size, initial_h=initial_h,
                              initial_c=initial_c, return_zmax=return_zmax)


def _lstm_onnx_f64(x, W, R, B, *, direction, hidden_size, initial_h, initial_c, return_zmax):
    x, W, R, B = _f64(x), _f64(W), _f64(R), _f64(B)
    T, N, I = x.shape
    H = int(hidden_size)
    dirs = _DIRS[direction]
    D = len(dirs)
    assert W.shape == (D, 4 * H, I) and R.shape == (D, 4 * H, H)
    if B is None:
        B = np.zeros((D, 8 * H), F64)
    h0 = np.zeros((D, N, H), F64) if initial_h is None else _f64(initial_h)
    c0 = np.zeros((D, N, H), F64) if initial_c is None else _f64(initial_c)
    blk = {g: slice(k * H, (k + 1) * H) for k, g in enumerate(GATES_ONNX)}
    Y = np.zeros((T, D, N, H), F64)
    Yh = np.zeros((D, N, H), F64)
    Yc = np.zeros((D, N, H), F64)
    zmax = 0.0
    for d, dname in enumerate(dirs):
        Wb, Rb = B[d, :4 * H], B[d, 4 * H:]
        h, c = h0[d].copy(), c0[d].copy()                      # [N, H]
        steps = range(T) if dname == 'forward' else range(T - 1, -1, -1)
        for t in steps:
            z = x[t] @ W[d].T + h @ R[d].T + Wb + Rb             # [N, 4H]
            zmax = max(zmax, float(np.abs(z).max()))
            i = sigmoid_f64(z[:, blk['i']])
            o = sigmoid_f64(z[:, blk['o']])
            f = sigmoid_f64(z[:, blk['f']])
            g = np.tanh(z[:, blk['c']])
            c = f * c + i * g
            h = o * np.tanh(c)
            Y[t, d] = h
        Yh[d], Yc[d] = h, c
    return (Y, Yh, Yc, zmax) if return_zmax else (Y, Yh, Yc)


def onnx_to_torch_gate_rows(a):
    """ONNX gate blocks (i, o, f, c) along axis 0 -> torch.nn.LSTM's (i, f, g, o)."""
    H = a.shape[0] // 4
    b = {g: a[k * H:(k + 1) * H] for k, g in enumerate(GATES_ONNX)}
    return np.concatenate([b['i'], b['f'], b['c'], b['o']], axis=0)


def lstm_torch_f64(x, W, R, B=None, *, direction, hidden_size, initial_h=None, initial_c=None):
    """The same LSTM through torch.nn.LSTM (float64, CPU) after the ONNX -> torch layout conversion."""
    import torch
    x, W, R, B = _f64(x), _f64(W), _f64(R), _f64(B)
    T, N, I = x.shape
    H = int(hidden_size)
    dirs = _DIRS[direction]
    D = len(dirs)
    if B is None:
        B = np.zeros((D, 8 * H), F64)
    h0 = np.zeros((D, N, H), F64) if initial_h is None else _f64(initial_h)
    c0 = np.zeros((D, N, H), F64) if initial_c is None else _f64(initial_c)
    if direction == 'reverse':
        # torch has no reverse-only LSTM: a forward LSTM on the time-flipped input, flipped back, is the reverse pass.
        xs = x[::-1].copy()
    else:
        xs = x
    m = torch.nn.LSTM(I, H, num_layers=1, bias=True, batch_first=False,
                      bidirectional=(direction == 'bidirectional')).to(torch.float64)
    with torch.no_grad():
        for d in range(D):
            suf = '_reverse' if d == 1 else ''
            getattr(m, 'weight_ih_l0' + suf).copy_(torch.from_numpy(onnx_to_torch_gate_rows(W[d])))
            getattr(m, 'weight_hh_l0' + suf).copy_(torch.from_numpy(onnx_to_torch_gate_rows(R[d])))
            getattr(m, 'bias_ih_l0' + suf).copy_(torch.from_numpy(onnx_to_torch_gate_rows(B[d, :4 * H])))
            getattr(m, 'bias_hh_l0' + suf).copy_(torch.from_numpy(onnx_to_torch_gate_rows(B[d, 4 * H:])))
        out, (hn, cn) = m(torch.from_numpy(np.ascontiguousarray(xs)), (torch.from_numpy(h0), torch.from_numpy(c0)))
    Y = out.numpy().reshape(T, N, D, H).transpose(0, 2, 1, 3)
    if direction == 'reverse':
        Y = Y[::-1]
    return np.ascontiguousarray(Y), hn.numpy(), cn.numpy()


def normwise(y, o):
    """N over float64 values; o == 0 everywhere passes only if y is exactly 0 (Voice common.normwise rule)."""
    y = np.asarray(y, dtype=F64)
    o = np.asarray(o, dtype=F64)
    den = float(np.abs(o).max())
    num = float(np.abs(y - o).max())
    if den == 0.0:
        return 0.0 if num == 0.0 else float('inf')
    return num / den


def ulp_error(y32, o64):
    """Elementwise |y - o| in units of the fp32 ulp of o's binade: ulp(o) = 2^(floor(log2|o|) - 23), floored at the
    fp32 subnormal spacing 2^-149 (no float32 rounding of o first, so no factor-2 slack at powers of two)."""
    y = np.asarray(y32, dtype=F64)
    o = np.asarray(o64, dtype=F64)
    with np.errstate(divide='ignore'):
        e = np.floor(np.log2(np.abs(o)))
    e = np.maximum(e, -126.0)
    spacing = np.ldexp(1.0, (e - 23.0).astype(np.int64))
    return np.abs(y - o) / spacing

