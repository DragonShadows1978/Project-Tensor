   343	void export_deleter_legacy(DLManagedTensor* self) {
   344	  delete static_cast<DLPackExportCtx*>(self->manager_ctx);
   345	}
   346	void export_deleter_versioned(DLManagedTensorVersioned* self) {
   347	  delete static_cast<DLPackExportCtx*>(self->manager_ctx);
   348	}
   349	
   350	// PyCapsule destructors: an UNCONSUMED capsule (still named dltensor*) owns
   351	// its manager and must call the deleter; a consumed one ("used_*") does not.
   352	void capsule_destructor_legacy(PyObject* cap) {
   353	  if (!PyCapsule_IsValid(cap, kCapLegacy)) return;
   354	  PyObject *et, *ev, *etb;
   355	  PyErr_Fetch(&et, &ev, &etb);
   356	  auto* m = static_cast<DLManagedTensor*>(PyCapsule_GetPointer(cap, kCapLegacy));
   357	  if (m && m->deleter) m->deleter(m);
   358	  PyErr_Restore(et, ev, etb);
   359	}
   360	void capsule_destructor_versioned(PyObject* cap) {
   361	  if (!PyCapsule_IsValid(cap, kCapVersioned)) return;
   362	  PyObject *et, *ev, *etb;
   363	  PyErr_Fetch(&et, &ev, &etb);
   364	  auto* m = static_cast<DLManagedTensorVersioned*>(
   365	      PyCapsule_GetPointer(cap, kCapVersioned));
   366	  if (m && m->deleter) m->deleter(m);
   367	  PyErr_Restore(et, ev, etb);
   368	}
   369	
   370	// Stream contract (array API): `stream` is the CONSUMER's stream. TensorCUDA
   371	// queues all work on the legacy default stream. None/1 = the consumer is on
   372	// the legacy stream too (nothing to do); -1 = no synchronization; 2 = the
   373	// per-thread default stream; > 2 = a cudaStream_t. For 2 and handles, record
   374	// an event on the legacy stream and make the consumer wait on it.
   375	void dlpack_fence_consumer(const py::object& stream) {
   376	  if (stream.is_none()) return;
   377	  if (!py::isinstance<py::int_>(stream))
   378	    throw py::type_error("__dlpack__: stream must be an int or None");
   379	  const long long s = stream.cast<long long>();
   380	  if (s == -1 || s == 1) return;
   381	  if (s == 0)
   382	    throw py::value_error(
   383	        "__dlpack__: stream=0 is ambiguous for CUDA under the DLPack protocol; "
   384	        "use None or 1 (legacy default stream), 2 (per-thread default stream) "
   385	        "or a cudaStream_t handle");
   386	  if (s < -1) throw py::value_error("__dlpack__: invalid stream " + std::to_string(s));
   387	  cudaStream_t consumer =
   388	      (s == 2) ? cudaStreamPerThread
   389	               : reinterpret_cast<cudaStream_t>(static_cast<uintptr_t>(s));
   390	  cudaEvent_t ev = nullptr;
   391	  cudaError_t e = cudaEventCreateWithFlags(&ev, cudaEventDisableTiming);
   392	  if (e == cudaSuccess) e = cudaEventRecord(ev, cudaStreamLegacy);  // engine stream
   393	  if (e == cudaSuccess) e = cudaStreamWaitEvent(consumer, ev, 0);
   394	  // Safe right after the wait is enqueued: the dependency is captured at the
   395	  // cudaStreamWaitEvent call and the runtime frees the event once it fires.
   396	  if (ev) cudaEventDestroy(ev);
   397	  if (e != cudaSuccess) {
   398	    cudaGetLastError();
   399	    throw std::runtime_error(std::string("__dlpack__: stream fence failed: ") +
   400	                             cudaGetErrorString(e));
   401	  }
   402	}
   403	
   404	py::object tensor_dlpack(Tensor& t, py::object stream, py::object max_version,
   405	                         py::object dl_device, py::object copy) {
   406	  if (!t.defined() || !t.data().defined())
   407	    throw py::buffer_error("__dlpack__: undefined tensor");
   408	  const NDArray& a = t.data();
   409	  if (!a.device.is_cuda())
   410	    throw py::buffer_error(
   411	        "__dlpack__: TensorCUDA exports CUDA tensors only; this tensor is on "
   412	        "cpu (CPU DLPack export is not supported)");
   413	  if (!copy.is_none() && copy.cast<bool>())
   414	    throw py::buffer_error(
   415	        "__dlpack__: copy=True is not supported; TensorCUDA exports zero-copy "
   416	        "only (pass copy=None or copy=False)");
   417	  if (!dl_device.is_none()) {
   418	    py::sequence d = dl_device.cast<py::sequence>();
   419	    if (py::len(d) != 2)
   420	      throw py::value_error("__dlpack__: dl_device must be a (device_type, device_id) pair");
   421	    const int dt = d[0].cast<int>();
   422	    const int id = d[1].cast<int>();
   423	    if (dt != kDLCUDA || id != a.device.index)
   424	      throw py::buffer_error(
   425	          "__dlpack__: dl_device=(" + std::to_string(dt) + ", " +
   426	          std::to_string(id) + ") differs from this tensor's device (2, " +
   427	          std::to_string(a.device.index) +
   428	          "); a cross-device export needs a copy, which TensorCUDA does not make");
   429	  }
   430	  bool versioned = false;
   431	  if (!max_version.is_none()) {
   432	    py::sequence mv = max_version.cast<py::sequence>();
   433	    if (py::len(mv) < 1)
   434	      throw py::value_error("__dlpack__: max_version must be a (major, minor) pair");
   435	    versioned = mv[0].cast<int>() >= 1;
   436	  }
   437	  // P1T-FIX2, N2: a tensor whose shape breaks the zero-extent rule (reachable through reshape of an empty tensor, e.g.
   438	  // empty((0,)).reshape([0, 2**62, 4])) cannot be described with int64 strides: refused (ValueError) before the
   439	  // consumer fence and before contiguous_strides forms them.
   440	  {
   441	    const int64_t n_ex = checked_numel(a.shape.data(), a.ndim(), "__dlpack__");
   442	    checked_nbytes(n_ex, dtype_size(a.dtype), a.shape.data(), a.ndim(), "__dlpack__");
   443	  }
   444	
   445	  dlpack_fence_consumer(stream);
   446	
   447	  // P1T-FIX1, F06: the context (and its shared Storage reference) is owned by a unique_ptr until the capsule takes it,
   448	  // so a throw anywhere below (bad_alloc in the vector assignments, a failed PyCapsule_New) frees it exactly once.
   449	  // Prior art: C++ RAII (Stroustrup) and std::unique_ptr's release() hand-off (C++11); pybind11/CPython capsule
   450	  // ownership. Nothing new.
   451	  auto ctx = std::make_unique<DLPackExportCtx>();
   452	  ctx->owner = a.storage;
   453	  ctx->shape.assign(a.shape.begin(), a.shape.end());
   454	  Shape st = contiguous_strides(a.shape);
   455	  ctx->strides.assign(st.begin(), st.end());
   456	  const int nd = a.ndim();
   457	  DLTensor dl{};
   458	  dl.data = a.storage->ptr;  // allocation base; element 0 is data + byte_offset
   459	  dl.byte_offset = static_cast<uint64_t>(a.offset) * dtype_size(a.dtype);
   460	  dl.device.device_type = kDLCUDA;
   461	  dl.device.device_id = a.device.index;
   462	  dl.ndim = nd;
   463	  dl.dtype = to_dl_dtype(a.dtype);
   464	  dl.shape = nd ? ctx->shape.data() : nullptr;
