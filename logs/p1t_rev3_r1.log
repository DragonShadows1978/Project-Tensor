+    prod_a.on_delete = _nested
+def _start_in_flight():
+    start_foreign(FP_A, M_A)
+    _wait_for(lambda: prod_a.started, "the in-flight deleter to start")
+    RESULTS["before_hook"] = {"stats": dict(tc._C._dlpack_release_stats())}
