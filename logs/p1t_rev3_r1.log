   333	// ---- export: the manager context OWNS a reference to the Storage, so the
   334	// memory outlives the producer Tensor's last Python reference.
   335	struct DLPackExportCtx {
   336	  std::shared_ptr<Storage> owner;
   337	  std::vector<int64_t> shape;
   338	  std::vector<int64_t> strides;
   339	  DLManagedTensor legacy{};
   340	  DLManagedTensorVersioned versioned{};
   341	};
