#include <pybind11/pybind11.h>
#include <pybind11/stl.h>

#include <climits>
#include <sstream>
#include <string>
#include <vector>

#include "checked_math.h"
#include "dlpack_operand.h"
#include "lstm_ops.h"

namespace py = pybind11;

namespace tcs {
namespace {

constexpr int64_t kDirForward = 0;
constexpr int64_t kDirReverse = 1;
constexpr int64_t kDirBidirectional = 2;

[[noreturn]] void lstm_bad(const std::string& msg) { throw py::value_error("tc_signal.lstm: " + msg); }

void check_int_range(const char* what, int64_t v) {
  if (v > INT_MAX) {
    std::ostringstream os;
    os << what << " (" << v << ") exceeds the 32-bit range cuBLAS takes";
    lstm_bad(os.str());
  }
}

void expect_dims(const char* role, const std::vector<int64_t>& got, const std::vector<int64_t>& want,
                 const char* layout) {
  if (got != want) {
    std::ostringstream os;
    os << role << " has shape " << shape_str(got) << ", expected " << shape_str(want) << " (" << layout << ")";
    lstm_bad(os.str());
  }
}

struct LstmPlan {
  LstmGeom g;
  std::vector<int64_t> y_shape;       // [T, D, N, H]
  std::vector<int64_t> state_shape;   // [D, N, H]
  int64_t scratch_numel;
};

LstmPlan plan_lstm(const std::vector<int64_t>& xs, const std::vector<int64_t>& Ws, const std::vector<int64_t>& Rs,
                   const std::vector<int64_t>* Bs, const std::vector<int64_t>* h0s, const std::vector<int64_t>* c0s,
                   int64_t hidden_size, int64_t direction) {
  std::ostringstream os;
  if (direction != kDirForward && direction != kDirReverse && direction != kDirBidirectional) {
    os << "direction code " << direction << " is not 0 (forward), 1 (reverse) or 2 (bidirectional)";
    lstm_bad(os.str());
  }
  if (hidden_size < 1 || hidden_size > INT_MAX / (kLstmGates * kLstmBiasHalves)) {
    os << "hidden_size must be in [1, " << INT_MAX / (kLstmGates * kLstmBiasHalves) << "], got " << hidden_size;
    lstm_bad(os.str());
  }
  LstmPlan p{};
  LstmGeom& g = p.g;
  g.T = xs[0];
  g.N = xs[1];
  g.I = xs[2];
  g.H = hidden_size;
  g.D = (direction == kDirBidirectional) ? 2 : 1;
  g.first_reverse = (direction == kDirForward) ? g.D : (direction == kDirReverse ? 0 : 1);
  const int64_t H4 = kLstmGates * g.H;
  if (Ws[0] != g.D) {
    os << "W.shape[0] (" << Ws[0] << ") != num_directions (" << g.D << ") for this direction; W is [D, 4H, I]";
    lstm_bad(os.str());
  }
  if (Ws[1] != H4) {
    os << "W.shape[1] (" << Ws[1] << ") != 4*hidden_size (" << H4 << "); W is [D, 4H, I]";
    lstm_bad(os.str());
  }
  if (Ws[2] != g.I) {
    os << "W.shape[2] (" << Ws[2] << ") != input size x.shape[2] (" << g.I << "); W is [D, 4H, I]";
    lstm_bad(os.str());
  }
  expect_dims("R", Rs, {g.D, H4, g.H}, "R is [D, 4H, H]");
  if (Bs != nullptr) expect_dims("B", *Bs, {g.D, kLstmBiasHalves * H4}, "B is [D, 8H] = [Wb; Rb]");
  if (h0s != nullptr) expect_dims("initial_h", *h0s, {g.D, g.N, g.H}, "initial_h is [D, N, H]");
  if (c0s != nullptr) expect_dims("initial_c", *c0s, {g.D, g.N, g.H}, "initial_c is [D, N, H]");
  check_int_range("4*hidden_size", H4);
  check_int_range("T*N", ck_mul(g.T, g.N, "lstm: T*N"));
  check_int_range("input size", g.I);
  check_int_range("batch size", g.N);
  check_int_range("D*N*H", ck_mul(ck_mul(g.D, g.N, "lstm: D*N"), g.H, "lstm: D*N*H"));
  p.y_shape = {g.T, g.D, g.N, g.H};
  p.state_shape = {g.D, g.N, g.H};
  ck_shape_numel(p.y_shape, "lstm: Y size T*D*N*H");
  ck_shape_numel(p.state_shape, "lstm: Y_h/Y_c size D*N*H");
  // F03: the scratch size G_x [D, T, N, 4H] + G_h [D, N, 4H] and its bytes, checked; lstm_scratch_numel (unchecked,
  // used again by lstm.cu) is then known not to overflow.
  const int64_t gx = ck_mul(ck_mul(ck_mul(g.D, g.T, "lstm: scratch G_x"), g.N, "lstm: scratch G_x"), H4,
                            "lstm: scratch G_x");
  const int64_t gh = ck_mul(ck_mul(g.D, g.N, "lstm: scratch G_h"), H4, "lstm: scratch G_h");
  p.scratch_numel = ck_add(gx, gh, "lstm: scratch size");
  ck_fp32_bytes(p.scratch_numel, "lstm: scratch bytes");
  return p;
}

// ------------------------------------------------------------------------------------------------ peek helpers
struct Peeked {
  py::object capsule;            // None for an absent optional operand
  std::vector<int64_t> shape;
  int device = -1;
  bool present = false;
};

// Optional operands only (B, initial_h, initial_c); required ones go through require_operand first.
Peeked peek_operand(py::handle obj, const char* role, int ndim) {
  Peeked p;
  if (obj.is_none()) {
    p.capsule = py::none();
    return p;
  }
  p.capsule = to_capsule(obj, role, false);
  const DLTensor* t = peek(p.capsule, role);
  validate_tensor(t, role, ndim);
  p.shape = shape_of(t);
  p.device = t->device.device_id;
  p.present = true;
  return p;
}

void same_device_peeked(const std::vector<const Peeked*>& ps, const std::vector<const char*>& roles) {
  int dev = -1;
  const char* first = "";
  for (size_t i = 0; i < ps.size(); ++i) {
    if (!ps[i]->present) continue;
    if (dev < 0) {
      dev = ps[i]->device;
      first = roles[i];
    } else if (ps[i]->device != dev) {
      std::ostringstream os;
      os << "tc_signal: operand '" << roles[i] << "': on CUDA device " << ps[i]->device << " but operand '" << first
         << "' is on CUDA device " << dev << "; every operand must be on the same device";
      throw py::value_error(os.str());
    }
  }
}

std::vector<int64_t> op_shape(const Operand& op) {
  std::vector<int64_t> s(op.ndim());
  for (int i = 0; i < op.ndim(); ++i) s[i] = op.dim(i);
  return s;
}

py::tuple to_tuple(const std::vector<int64_t>& v) {
  py::tuple t(v.size());
  for (size_t i = 0; i < v.size(); ++i) t[i] = py::int_(v[i]);
  return t;
}

// ------------------------------------------------------------------------------------------------ entry points
py::tuple lstm_plan(py::object x, py::object W, py::object R, py::object B, py::object h0, py::object c0,
                    int64_t hidden_size, int64_t direction) {
  drain_completed();
  require_operand(x, "x");
  require_operand(W, "W");
  require_operand(R, "R");
  Peeked X = peek_operand(x, "x", 3);
  Peeked Wp = peek_operand(W, "W", 3);
  Peeked Rp = peek_operand(R, "R", 3);
  Peeked Bp = peek_operand(B, "B", 2);
  Peeked H0 = peek_operand(h0, "initial_h", 3);
  Peeked C0 = peek_operand(c0, "initial_c", 3);
  same_device_peeked({&X, &Wp, &Rp, &Bp, &H0, &C0}, {"x", "W", "R", "B", "initial_h", "initial_c"});
  LstmPlan p = plan_lstm(X.shape, Wp.shape, Rp.shape, Bp.present ? &Bp.shape : nullptr,
                         H0.present ? &H0.shape : nullptr, C0.present ? &C0.shape : nullptr, hidden_size, direction);
  return py::make_tuple(X.capsule, Wp.capsule, Rp.capsule, Bp.capsule, H0.capsule, C0.capsule, to_tuple(p.y_shape),
                        to_tuple(p.state_shape), py::int_(p.scratch_numel), py::int_(p.g.T), py::int_(p.g.N));
}

void lstm_run(py::object xc, py::object Wc, py::object Rc, py::object Bc, py::object h0c, py::object c0c, py::object Y,
              py::object Y_h, py::object Y_c, py::object scratch, int64_t hidden_size, int64_t direction) {
  drain_completed();
  require_operand(xc, "x");
  require_operand(Wc, "W");
  require_operand(Rc, "R");
  require_operand(Y, "Y");
  require_operand(Y_h, "Y_h");
  require_operand(Y_c, "Y_c");
  require_operand(scratch, "scratch");
  Operand X(xc, "x", 3, false);
  Operand Wo(Wc, "W", 3, false);
  Operand Ro(Rc, "R", 3, false);
  Operand Bo;
  if (!Bc.is_none()) Bo = Operand(Bc, "B", 2, false);
  Operand H0;
  if (!h0c.is_none()) H0 = Operand(h0c, "initial_h", 3, false);
  Operand C0;
  if (!c0c.is_none()) C0 = Operand(c0c, "initial_c", 3, false);
  std::vector<int64_t> bshape, h0shape, c0shape;
  if (Bo.present()) bshape = op_shape(Bo);
  if (H0.present()) h0shape = op_shape(H0);
  if (C0.present()) c0shape = op_shape(C0);
  LstmPlan p = plan_lstm(op_shape(X), op_shape(Wo), op_shape(Ro), Bo.present() ? &bshape : nullptr,
                         H0.present() ? &h0shape : nullptr, C0.present() ? &c0shape : nullptr, hidden_size, direction);
  Operand Yo(to_capsule(Y, "Y", true), "Y", 4, true);
  expect_shape(Yo, p.y_shape);
  Operand Yh(to_capsule(Y_h, "Y_h", true), "Y_h", 3, true);
  expect_shape(Yh, p.state_shape);
  Operand Yc(to_capsule(Y_c, "Y_c", true), "Y_c", 3, true);
  expect_shape(Yc, p.state_shape);
  Operand S(to_capsule(scratch, "scratch", true), "scratch", 1, true);
  expect_shape(S, {p.scratch_numel});
  const int device = common_device({&X, &Wo, &Ro, &Bo, &H0, &C0, &Yo, &Yh, &Yc, &S});
  // Every written operand must not alias any input nor any other written operand.
  const std::vector<const Operand*> written = {&Yo, &Yh, &Yc, &S};
  const std::vector<const Operand*> inputs = {&X, &Wo, &Ro, &Bo, &H0, &C0};
  for (size_t a = 0; a < written.size(); ++a) {
    for (const Operand* in : inputs) expect_disjoint(*written[a], *in);
    for (size_t b = a + 1; b < written.size(); ++b) expect_disjoint(*written[a], *written[b]);
  }
  // F01: the whole per-call capsule set is one pending entry, released after the last step's launch has run.
  RetainUntilComplete keep(device, {&X, &Wo, &Ro, &Bo, &H0, &C0, &Yo, &Yh, &Yc, &S});
  lstm_forward(device, p.g, X.data(), Wo.data(), Ro.data(), Bo.present() ? Bo.data() : nullptr,
               H0.present() ? H0.data() : nullptr, C0.present() ? C0.data() : nullptr, Yo.data(), Yh.data(), Yc.data(),
               S.data());
}

}  // namespace

void register_lstm(py::module_& m) {
  m.def("lstm_plan", &lstm_plan, py::arg("x"), py::arg("W"), py::arg("R"), py::arg("B"), py::arg("initial_h"),
        py::arg("initial_c"), py::arg("hidden_size"), py::arg("direction"),
        "Acquire and peek the LSTM inputs; return (x, W, R, B|None, initial_h|None, initial_c|None capsules, Y shape, "
        "Y_h/Y_c shape, scratch numel, T, N).");
  m.def("lstm_run", &lstm_run, py::arg("x_capsule"), py::arg("W_capsule"), py::arg("R_capsule"), py::arg("B_capsule"),
        py::arg("initial_h_capsule"), py::arg("initial_c_capsule"), py::arg("Y"), py::arg("Y_h"), py::arg("Y_c"),
        py::arg("scratch"), py::arg("hidden_size"), py::arg("direction"),
        "Consume every operand, validate, run the whole LSTM recurrence on the legacy stream, release.");
  m.def(
      "lstm_cublas_config",
      [](int device) {
        LstmCublasConfig c = lstm_cublas_config(device);
        py::dict d;
        d["math_mode"] = c.math_mode;
        d["atomics_mode"] = c.atomics_mode;
        d["pointer_mode"] = c.pointer_mode;
        d["legacy_stream"] = c.legacy_stream;
        d["default_math"] = c.default_math;
        d["atomics_not_allowed"] = c.atomics_not_allowed;
        return d;
      },
      py::arg("device") = 0, "Settings of the LSTM's cuBLAS handle on `device` (creates it if needed).");
}

}  // namespace tcs
"""tc_signal: TensorCUDA add-on for signal ops (P1T-M2: Conv1d T2, ConvTranspose1d T3).

A separate package next to `tensor_cuda/` (David, 2026-10-12: keep core free of these kernels). It consumes any DLPack
CUDA producer (TensorCUDA tensors once M1 lands, torch tensors for testing), computes in fp32 on the legacy default
stream, deterministically (no atomics, no fast-math, cuBLAS in default math mode), and allocates outputs and scratch
through the module allocator (`set_allocator`). Usage: `PYTHONPATH=<Project-Tensor>/tc_signal`, then
`import tc_signal`.

API (exact, order P1T-M2):
    conv1d(x, w, b=None, *, stride=1, padding=0, dilation=1, groups=1, out=None)
    conv_transpose1d(x, w, b=None, *, stride=1, padding=0, output_padding=0, dilation=1, groups=1, out=None)
    set_allocator(fn)   # fn(shape: tuple) -> fp32 CUDA DLPack tensor; returns the previous allocator

Semantics are ONNX Conv / ConvTranspose (1-D): x [N, C_in, T]; conv1d w [C_out, C_in/groups, K]; conv_transpose1d
w [C_in, C_out/groups, K]; b [C_out] or None; padding an int or (pad_begin, pad_end).

Prior art: ONNX Conv/ConvTranspose operator specs (semantics); DLPack (dmlc/dlpack v1.3) and the Python array API
data-interchange protocol (operand exchange); im2col (Chellapilla, Puri & Simard 2006) and gather-form transposed
convolution (Dumoulin & Visin 2016) for the kernels (see src/conv.cu). The pluggable allocator callback mirrors CuPy's
`cupy.cuda.set_allocator` (CuPy, 2017-), which also returns control of allocation to the caller; ours differs in that
the allocator returns a DLPack tensor, not a raw pointer.
"""
from __future__ import annotations

import atexit
import operator
import sys

from . import _tc_signal as _C

__all__ = ['conv1d', 'conv_transpose1d', 'set_allocator', 'synchronize']

_SET_ALLOCATOR_HINT = ('call tc_signal.set_allocator(fn), where fn(shape: tuple) returns a float32 CUDA tensor that '
                       'implements __dlpack__ (for example lambda s: torch.empty(s, device="cuda"))')


def _default_allocator(shape):
    """`tensor_cuda.empty(*shape, dtype="float32")` (added by P1T-M1). Raises RuntimeError naming set_allocator when
    tensor_cuda is not importable, lacks `empty`, or its tensors do not export DLPack yet."""
    try:
        import tensor_cuda
    except ImportError as e:
        raise RuntimeError(f'tc_signal: the default allocator needs tensor_cuda.empty, but tensor_cuda is not '
                           f'importable ({e}); {_SET_ALLOCATOR_HINT}') from e
    empty = getattr(tensor_cuda, 'empty', None)
    if empty is None:
        raise RuntimeError('tc_signal: the default allocator needs tensor_cuda.empty (P1T-M1), which this '
                           f'tensor_cuda does not have; {_SET_ALLOCATOR_HINT}')
    t = empty(*shape, dtype='float32')
    if not hasattr(t, '__dlpack__'):
        raise RuntimeError('tc_signal: tensor_cuda.empty returned a tensor without __dlpack__ (P1T-M1 DLPack export '
                           f'missing); {_SET_ALLOCATOR_HINT}')
    return t


_allocator = _default_allocator


def set_allocator(fn):
    """Set the allocator used for outputs (out=None) and im2col scratch: fn(shape: tuple) -> fp32 CUDA DLPack tensor of
    exactly that shape. Returns the previous allocator. `None` restores the default (tensor_cuda.empty)."""
    global _allocator
    if fn is not None and not callable(fn):
        raise TypeError(f'tc_signal.set_allocator: expected a callable or None, got {type(fn).__name__}')
    prev = _allocator
    _allocator = _default_allocator if fn is None else fn
    return prev


def _int(name, v):
    if isinstance(v, bool):
        raise TypeError(f'tc_signal: {name} must be an int, got bool')
    try:
        return operator.index(v)
    except TypeError:
        raise TypeError(f'tc_signal: {name} must be an int, got {type(v).__name__}') from None


def _pads(padding):
    if isinstance(padding, (tuple, list)):
        if len(padding) != 2:
            raise ValueError(f'tc_signal: padding must be an int or (pad_begin, pad_end), got {padding!r}')
        return _int('padding[0]', padding[0]), _int('padding[1]', padding[1])
    p = _int('padding', padding)
    return p, p


def conv1d(x, w, b=None, *, stride=1, padding=0, dilation=1, groups=1, out=None):
    """ONNX Conv, 1-D: y[n, o, t] = b[o] + sum_{c in group(o), k} w[o, c, k] * x_pad[n, c, t*stride + k*dilation].

    x [N, C_in, T], w [C_out, C_in/groups, K], b [C_out] or None (fp32 CUDA DLPack producers or capsules).
    Output [N, C_out, (T + pb + pe - dilation*(K-1) - 1)//stride + 1], written into `out` if given, else allocated
    through the module allocator. Returns `out`."""
    pb, pe = _pads(padding)
    s, d, g = _int('stride', stride), _int('dilation', dilation), _int('groups', groups)
    xc, wc, bc, out_shape, scratch_numel = _C.conv1d_plan(x, w, b, s, pb, pe, d, g)
    if out is None:
        out = _allocator(tuple(out_shape))
    scratch = _allocator((scratch_numel,)) if scratch_numel > 0 else None
    _C.conv1d_run(xc, wc, bc, out, scratch, s, pb, pe, d, g)
    return out


def conv_transpose1d(x, w, b=None, *, stride=1, padding=0, output_padding=0, dilation=1, groups=1, out=None):
    """ONNX ConvTranspose, 1-D (gather form, deterministic): x [N, C_in, T], w [C_in, C_out/groups, K] (ONNX layout),
    b [C_out] or None. Output [N, C_out, stride*(T-1) + output_padding + dilation*(K-1) + 1 - pb - pe], written into
    `out` if given, else allocated through the module allocator. Returns `out`."""
    pb, pe = _pads(padding)
    s, op, d, g = (_int('stride', stride), _int('output_padding', output_padding), _int('dilation', dilation),
                   _int('groups', groups))
    xc, wc, bc, out_shape = _C.conv_transpose1d_plan(x, w, b, s, pb, pe, op, d, g)
    if out is None:
        out = _allocator(tuple(out_shape))
    _C.conv_transpose1d_run(xc, wc, bc, out, s, pb, pe, op, d, g)
    return out


def synchronize():
    """Wait until the legacy default stream has passed every tc_signal launch queued so far, then release every consumed
    operand tc_signal still holds (P1T-FIX1, F01 deferred release; see README "Streams and lifetimes").

    tc_signal keeps each call's consumed DLPack managers (inputs, outputs, scratch) alive until the legacy stream has
    passed that call, and releases completed ones at the start of the next tc_signal call. Call synchronize() to release
    them now (for example before measuring memory, or before handing a producer's memory back by other means). It
    synchronizes the legacy stream of the current device and of every device with pending operands (stream syncs, not a
    device-wide sync).

    Errors (P1T-FIX2, N1): a CUDA failure is never reported as success. RuntimeError, naming the CUDA error, when
    - the current-device query (cudaGetDevice) fails, for example on a machine with no usable CUDA device, even when
      nothing is pending;
    - a device's legacy stream cannot be synchronized (its pending operands are then deliberately leaked, never
      released early);
    - an earlier release that could not raise failed (the fallback sync or the bound drain inside a tc_signal call); such
      a failure is raised once, by the next synchronize().
    MemoryError if the error message itself cannot be allocated. Prior art: torch.cuda.synchronize /
    cupy.cuda.Stream.synchronize (API shape only)."""
    _C.synchronize()


def _release_pending_at_exit():
    # atexit (runs before interpreter finalization, GIL held): release whatever is still pending. P1T-FIX2 (N1): an
    # error is never swallowed silently; it is LOGGED to stderr (one line) and not raised (an exception from an atexit
    # callback cannot be handled by anyone). The operands without a completion proof stay deliberately leaked; there is
    # nothing else safe to do at exit. Prior art: CPython's atexit, which itself prints (not raises) a callback's
    # exception; taken: log-don't-raise at exit.
    try:
        _C.synchronize()
    except Exception as e:  # noqa: BLE001
        try:
            sys.stderr.write(f'tc_signal: synchronize() at exit failed ({type(e).__name__}: {e}); operands without a '
                             f'completion proof were deliberately leaked, not released\n')
            sys.stderr.flush()
        except Exception:  # noqa: BLE001  (stderr may already be closed at exit)
            pass


atexit.register(_release_pending_at_exit)


from ._lstm import lstm  # noqa: E402,F401  (P1T-M3: tc_signal/_lstm.py)
__all__.append('lstm')


from ._norms import group_norm, instance_norm1d, layer_norm  # noqa: E402  (P1T-M4, T5)
from ._small import reflection_pad1d, rint, upsample_nearest1d  # noqa: E402  (P1T-M4, T6)
__all__ += ['instance_norm1d', 'layer_norm', 'group_norm', 'upsample_nearest1d', 'reflection_pad1d', 'rint']
"""tc_signal.lstm: ONNX-semantics LSTM (P1T-M3, T4), forward only, fp32, deterministic.

    lstm(x, W, R, B=None, *, hidden_size, direction="forward", initial_h=None, initial_c=None,
         sequence_lens=None, layout=0, out=None) -> (Y, Y_h, Y_c)

Semantics: ONNX LSTM, layout 0, default activations (Sigmoid, Tanh, Tanh), no clip, no peepholes, input_forget 0.
 * x [T, N, I]; W [D, 4H, I]; R [D, 4H, H]; B [D, 8H] = [Wb; Rb] or None (zeros); initial_h / initial_c [D, N, H] or
   None (zeros). Gate blocks along 4H are in the ONNX order i, o, f, c (torch's nn.LSTM uses i, f, g, o).
 * direction "forward" or "reverse" (D = 1) or "bidirectional" (D = 2: index 0 forward, index 1 reverse).
 * Returns Y [T, D, N, H], Y_h [D, N, H], Y_c [D, N, H]: new tensors from tc_signal's allocator (set_allocator; the
   default is tensor_cuda.empty), or the caller's `out=(Y, Y_h, Y_c)`, which is returned as given.
 * Every operand is any fp32 CUDA DLPack producer (TensorCUDA or torch tensors) or a DLPack capsule.

Refused (never silently approximated):
 * layout != 0 (ValueError); sequence_lens other than None or "every entry equals T" (ValueError; a non-integer
   sequence_lens is a TypeError). sequence_lens is only validated, never read by the kernel; a device tensor is copied
   to the host for that check (TensorCUDA `.numpy()`, torch `.cpu()`);
 * clip, peepholes (ONNX input P), input_forget and non-default activations: the signature has no such parameter, so
   passing one raises TypeError;
 * every shape mismatch, non-fp32 / non-CUDA / non-contiguous / misaligned operands, mismatched devices, an `out` that
   is not a 3-sequence, and any output or scratch aliasing another operand (M2's operand contract, dlpack_operand.h).

Execution: one `_tc_signal.lstm_plan` call peeks the inputs; this layer allocates Y, Y_h, Y_c and ONE scratch operand
(projected inputs G_x [D, T, N, 4H] then the per-step gate buffer G_h [D, N, 4H]) through the allocator; one
`_tc_signal.lstm_run` call then runs the whole recurrence in C++ (src/lstm.cu): one input-projection SGEMM per
direction (+ Wb), then a host C++ loop over the T steps, each one strided-batched SGEMM over the directions
(h_{t-1} . R^T) and one fused cell kernel. No Python loop over steps, no per-step DLPack capsules. Everything is queued
on the legacy default stream; the results are ready in stream order (a later TensorCUDA op or a `.numpy()` download
on the legacy stream sees them).

Prior art: the ONNX LSTM operator spec (semantics); Hochreiter & Schmidhuber 1997 (LSTM) and Gers, Schmidhuber &
Cummins 2000 (forget gate); Appleyard, Kocisky & Blunsom 2016 / the cuDNN RNN design (the input projection hoisted out
of the recurrence); the sign-split stable sigmoid (standard practice). Details and what is ours: src/lstm.cu.
The Python plan/allocate/run flow is M2's (tc_signal/__init__.py conv1d); no new prior art here.
"""
from __future__ import annotations

import operator
import sys

from . import _tc_signal as _C

# ONNX direction attribute -> the C++ direction code (lstm_bindings.cpp).
_DIRECTIONS = {'forward': 0, 'reverse': 1, 'bidirectional': 2}
# ONNX `layout` attribute: 0 = x [T, N, I] (the only supported layout).
_LAYOUT_SEQ_FIRST = 0
# `out` is (Y, Y_h, Y_c).
_N_OUTPUTS = 3


def _package():
    """The tc_signal package module, read at call time so set_allocator's current allocator is used."""
    return sys.modules[__name__.rpartition('.')[0]]


def _int(name, v):
    if isinstance(v, bool):
        raise TypeError(f'tc_signal.lstm: {name} must be an int, got bool')
    try:
        return operator.index(v)
    except TypeError:
        raise TypeError(f'tc_signal.lstm: {name} must be an int, got {type(v).__name__}') from None


def _host_array(seq):
    """sequence_lens as a host NumPy array: lists, tuples and NumPy arrays directly; TensorCUDA tensors through
    `.numpy()`; torch tensors through `.cpu().numpy()`."""
    import numpy as np
    if isinstance(seq, (list, tuple, np.ndarray)) or np.isscalar(seq):
        return np.asarray(seq)
    cpu = getattr(seq, 'cpu', None)
    if callable(cpu):                         # torch (CPU or CUDA)
        seq = cpu()
    to_numpy = getattr(seq, 'numpy', None)
    if callable(to_numpy):                    # TensorCUDA, torch CPU
        return np.asarray(to_numpy())
    return np.asarray(seq)


def _check_sequence_lens(sequence_lens, T, N):
    import numpy as np
    arr = _host_array(sequence_lens)
    if arr.dtype == object or not np.issubdtype(arr.dtype, np.integer):
        raise TypeError(f'tc_signal.lstm: sequence_lens must hold integers, got dtype {arr.dtype}')
    if arr.shape != (N,):
        raise ValueError(f'tc_signal.lstm: sequence_lens has shape {tuple(arr.shape)}, expected ({N},) = [batch]')
    if not bool(np.all(arr == T)):
        raise ValueError(f'tc_signal.lstm: sequence_lens {arr.tolist()} is not supported (refused): only None or every '
                         f'entry equal to T = {T} is implemented')


def lstm(x, W, R, B=None, *, hidden_size, direction='forward', initial_h=None, initial_c=None, sequence_lens=None,
         layout=0, out=None):
    """ONNX LSTM (layout 0, gates i, o, f, c; Sigmoid/Tanh/Tanh; no clip, no peepholes). See the module docstring.

    x [T, N, I], W [D, 4H, I], R [D, 4H, H], B [D, 8H] = [Wb; Rb] or None, initial_h / initial_c [D, N, H] or None.
    Returns (Y [T, D, N, H], Y_h [D, N, H], Y_c [D, N, H])."""
    H = _int('hidden_size', hidden_size)
    if not isinstance(direction, str) or direction not in _DIRECTIONS:
        raise ValueError(f'tc_signal.lstm: direction must be one of {sorted(_DIRECTIONS)}, got {direction!r}')
    lay = _int('layout', layout)
    if lay != _LAYOUT_SEQ_FIRST:
        raise ValueError(f'tc_signal.lstm: layout={lay} is not supported (refused); only ONNX layout 0 '
                         f'(x [T, N, I]) is implemented')
    if out is not None:
        if not isinstance(out, (tuple, list)):
            raise TypeError(f'tc_signal.lstm: out must be None or a 3-tuple (Y, Y_h, Y_c), got {type(out).__name__}')
        if len(out) != _N_OUTPUTS:
            raise ValueError(f'tc_signal.lstm: out must be a 3-tuple (Y, Y_h, Y_c), got {len(out)} entries')
    code = _DIRECTIONS[direction]
    (xc, wc, rc, bc, hc, cc, y_shape, state_shape, scratch_numel, T, N) = _C.lstm_plan(
        x, W, R, B, initial_h, initial_c, H, code)
    if sequence_lens is not None:
        _check_sequence_lens(sequence_lens, T, N)
    alloc = _package()._allocator
    if out is None:
        Y, Y_h, Y_c = alloc(tuple(y_shape)), alloc(tuple(state_shape)), alloc(tuple(state_shape))
    else:
        Y, Y_h, Y_c = out
    scratch = alloc((scratch_numel,))
    _C.lstm_run(xc, wc, rc, bc, hc, cc, Y, Y_h, Y_c, scratch, H, code)
    return Y, Y_h, Y_c
"""tc_signal T5 norms (P1T-M4): instance_norm1d, layer_norm, group_norm.

fp32 statistics (shifted two-pass: shift by the row's first sample, mean of the shifted row, then the centred sum of
squares; biased variance as ONNX), a fixed block-tree reduction order (deterministic, no atomics), and
y = (x - mean) * (1 / sqrtf(var + eps)) * scale + bias. Kernel and numerics notes: src/norms.cu. Operands are any fp32
CUDA DLPack producers (or capsules), C-contiguous; the output comes from the module allocator (tc_signal.set_allocator)
unless `out` is given; everything is queued on the legacy default stream.

Prior art: Ulyanov, Vedaldi & Lempitsky (2016) instance norm; Ba, Kiros & Hinton (2016) layer norm; Wu & He (2018)
group norm; ONNX InstanceNormalization / LayerNormalization / GroupNormalization-21 (semantics); Welford (1962) and
Chan, Golub & LeVeque (1983) (variance algorithms, two-pass and shifted data). Ours: the Python wrappers.
"""
from __future__ import annotations

import math
import numbers
import operator
import sys

from . import _tc_signal as _C

__all__ = ['instance_norm1d', 'layer_norm', 'group_norm']


def _alloc(shape):
    # The package's current allocator (tc_signal.set_allocator), read at call time.
    return sys.modules[__package__]._allocator(tuple(shape))


def _eps(eps):
    if isinstance(eps, bool) or not isinstance(eps, numbers.Real):
        raise TypeError(f'tc_signal: eps must be a real number, got {type(eps).__name__}')
    e = float(eps)
    if not math.isfinite(e) or e < 0.0:
        raise ValueError(f'tc_signal: eps must be a finite number >= 0, got {e!r}')
    return e


def _int(name, v):
    if isinstance(v, bool):
        raise TypeError(f'tc_signal: {name} must be an int, got bool')
    try:
        return operator.index(v)
    except TypeError:
        raise TypeError(f'tc_signal: {name} must be an int, got {type(v).__name__}') from None


def instance_norm1d(x, scale=None, bias=None, *, eps=1e-5, out=None):
    """ONNX InstanceNormalization on x [N, C, T]: per (n, c), mean and biased variance over T (fp32 statistics);
    y = (x - mean) / sqrt(var + eps) * scale[c] + bias[c]. scale, bias: [C] or None (1 and 0). Returns `out`."""
    e = _eps(eps)
    xc, sc, bc, out_shape = _C.instance_norm1d_plan(x, scale, bias, e)
    if out is None:
        out = _alloc(out_shape)
    _C.instance_norm1d_run(xc, sc, bc, out, e)
    return out


def layer_norm(x, scale=None, bias=None, *, axis=-1, eps=1e-5, out=None):
    """ONNX LayerNormalization: normalize over the axes [axis, rank) with the biased variance (fp32 statistics, whatever
    eps: 1e-5 and 1e-12 both honoured); y = xhat * scale + bias with scale, bias of shape x.shape[axis:] or None.
    Returns `out`."""
    a = _int('axis', axis)
    e = _eps(eps)
    xc, sc, bc, out_shape = _C.layer_norm_plan(x, scale, bias, a, e)
    if out is None:
        out = _alloc(out_shape)
    _C.layer_norm_run(xc, sc, bc, out, a, e)
    return out


def group_norm(x, num_groups, scale=None, bias=None, *, eps=1e-5, out=None):
    """GroupNorm (ONNX GroupNormalization-21 / torch.nn.GroupNorm) on x [N, C, T]: mean and biased variance over each
    group's (C/num_groups, T) block (fp32 statistics); per-CHANNEL affine: scale, bias [C] or None. Returns `out`."""
    g = _int('num_groups', num_groups)
    e = _eps(eps)
    xc, sc, bc, out_shape = _C.group_norm_plan(x, g, scale, bias, e)
    if out is None:
        out = _alloc(out_shape)
    _C.group_norm_run(xc, g, sc, bc, out, e)
    return out
"""tc_signal T6 small ops (P1T-M4): upsample_nearest1d, reflection_pad1d, rint. Bit-exact by construction (32-bit word
gathers; rintf). Kernel notes: src/small_ops.cu. Operands are any fp32 CUDA DLPack producers (or capsules),
C-contiguous; the time axis is the last axis; the output comes from the module allocator unless `out` is given;
everything is queued on the legacy default stream. TensorCUDA core's `round` is untouched.

Prior art: ONNX Resize (nearest, asymmetric, floor), Pad (reflect) and Round specs; IEEE 754 roundTiesToEven / C99 rint;
torch reflection_pad1d. Ours: the Python wrappers.
"""
from __future__ import annotations

import operator
import sys

from . import _tc_signal as _C

__all__ = ['upsample_nearest1d', 'reflection_pad1d', 'rint']


def _alloc(shape):
    # The package's current allocator (tc_signal.set_allocator), read at call time.
    return sys.modules[__package__]._allocator(tuple(shape))


def _int(name, v):
    if isinstance(v, bool):
        raise TypeError(f'tc_signal: {name} must be an int, got bool')
    try:
        return operator.index(v)
    except TypeError:
        raise TypeError(f'tc_signal: {name} must be an int, got {type(v).__name__}') from None


def upsample_nearest1d(x, scale, *, out=None):
    """ONNX Resize nearest (asymmetric, floor) on the last axis at an INTEGER scale >= 1:
    y[..., i] = x[..., i // scale], output length T * scale. Non-integer scales are refused (TypeError). Returns `out`."""
    s = _int('scale (upsample_nearest1d takes integer scales only)', scale)
    if s < 1:
        raise ValueError(f'tc_signal: upsample_nearest1d: scale must be an integer >= 1, got {s}')
    xc, out_shape = _C.upsample_nearest1d_plan(x, s)
    if out is None:
        out = _alloc(out_shape)
    _C.upsample_nearest1d_run(xc, out, s)
    return out


def reflection_pad1d(x, pads, *, out=None):
    """ONNX Pad mode=reflect (torch reflection_pad1d) on the last axis: pads = (begin, end), each >= 0 and < T.
    Output length T + begin + end. Returns `out`."""
    if not isinstance(pads, (tuple, list)):
        raise TypeError(f'tc_signal: reflection_pad1d: pads must be a (begin, end) tuple or list, got '
                        f'{type(pads).__name__}')
    if len(pads) != 2:
        raise ValueError(f'tc_signal: reflection_pad1d: pads must be (begin, end), got {pads!r}')
    pb, pe = _int('pads[0]', pads[0]), _int('pads[1]', pads[1])
    if pb < 0 or pe < 0:
        raise ValueError(f'tc_signal: reflection_pad1d: pads must be >= 0, got ({pb}, {pe})')
    xc, out_shape = _C.reflection_pad1d_plan(x, pb, pe)
    if out is None:
        out = _alloc(out_shape)
    _C.reflection_pad1d_run(xc, out, pb, pe)
    return out


def rint(x, *, out=None):
    """ONNX Round: round half to even (rintf), sign of zero kept (rint(-0.4) = -0.0), +-Inf and NaN pass through.
    Any rank. Returns `out`."""
    xc, out_shape = _C.rint_plan(x)
    if out is None:
        out = _alloc(out_shape)
    _C.rint_run(xc, out)
    return out
"""Project Tensor — standalone CUDA tensor library (no PyTorch, no CuPy).

Phase 1 (the core engine) exposes a NumPy-friendly Tensor with reverse-mode
autograd backed entirely by hand-written CUDA kernels + cuBLAS. The C++ does the
work; this module is the thin Python ergonomics layer (factory helpers, dtype
plumbing, no_grad). See ROADMAP.md for the layers still being ported.
"""

from __future__ import annotations

import atexit
import contextlib
from collections.abc import Mapping
import operator
import sys

import numpy as np

try:
    from . import _tensor_cuda as _C
except ImportError:  # pragma: no cover
    import _tensor_cuda as _C  # fallback when the .so sits on PYTHONPATH

Tensor = _C.Tensor
ApaInt4Workspace = _C.ApaInt4Workspace

_NP_DTYPE = {
    "float32": np.float32,
    "float16": np.float16,
    "int64": np.int64,
    "bool": np.bool_,
    "uint8": np.uint8,
}

# bfloat16 has no NumPy equivalent: build the host array as fp32 and cast the
# device tensor to bf16 afterward. Listing it here so callers passing
# dtype="bfloat16" no longer fall through _NP_DTYPE.get(..., np.float32) and get
# a SILENT fp32 downcast (which corrupts bf16 constants for OLMoE/Qwen-class
# models). dtype_from_string in the C++ already supports "bfloat16".
_DEVICE_CAST_DTYPE = {"bfloat16"}


def tensor(data, *, device="cuda", dtype="float32", requires_grad=False):
    """Create a Tensor from array-like data."""
    if dtype in _DEVICE_CAST_DTYPE:
        arr = np.ascontiguousarray(np.asarray(data, dtype=np.float32))
        return _C.tensor(arr, device, requires_grad).astype(dtype)
    arr = np.asarray(data, dtype=_NP_DTYPE.get(dtype, np.float32))
    arr = np.ascontiguousarray(arr)
    return _C.tensor(arr, device, requires_grad)


def _factory(np_fn):
    def make(*shape, device="cuda", dtype="float32", requires_grad=False):
        if len(shape) == 1 and isinstance(shape[0], (tuple, list)):
            shape = tuple(shape[0])
        if dtype in _DEVICE_CAST_DTYPE:
            arr = np.ascontiguousarray(np_fn(shape).astype(np.float32))
            return _C.tensor(arr, device, requires_grad).astype(dtype)
        arr = np_fn(shape).astype(_NP_DTYPE.get(dtype, np.float32))
        return _C.tensor(np.ascontiguousarray(arr), device, requires_grad)
    return make


zeros = _factory(np.zeros)
ones = _factory(np.ones)
randn = _factory(lambda s: np.random.randn(*s))
rand = _factory(lambda s: np.random.rand(*s))


def from_numpy(arr, *, device="cuda", requires_grad=False):
    return _C.tensor(np.ascontiguousarray(arr), device, requires_grad)


# P1T-M1 (Project-Voice T1): DLPack import. Prior art: the Python array API
# standard's from_dlpack (Consortium for Python Data API Standards, 2021-2023)
# and the PyTorch/CuPy importers' owner keepalive (the imported tensor keeps the
# producer's DLPack manager alive and calls its deleter when it dies); the
# versioned-then-legacy retry mirrors torch.utils.dlpack.from_dlpack. Ours: the
# TensorCUDA wiring (bindings.cpp, kernels.cu Storage).
_DLPACK_MAX_VERSION = (1, 3)   # the vendored dlpack.h (include/dlpack/dlpack.h)
_DLPACK_LEGACY_STREAM = 1      # DLPack int for the CUDA legacy default stream
_KDL_CUDA = 2


def from_dlpack(obj):
    """Zero-copy import of any DLPack CUDA producer (or a bare DLPack capsule).

    For an object with ``__dlpack__`` this calls
    ``obj.__dlpack__(stream=1, max_version=(1, 3))`` (retrying without
    ``max_version`` for a producer that predates it). ``stream=1`` names the
    consumer stream, TensorCUDA's legacy default stream, so the producer orders
    that stream after its own pending work before handing the capsule over.
    A bare capsule carries no stream information: the caller must already have
    ordered the producer's work.

    The result aliases the producer's memory (``data_ptr()`` is the producer's
    element 0) and keeps the producer's DLPack manager alive. When the last
    TensorCUDA reference to that memory dies, TensorCUDA first drains its own
    stream on the memory's device (switching to that device if another one is
    current, then restoring the caller's device), so no queued TensorCUDA
    kernel can still touch the memory, and then calls the producer's deleter
    with the GIL held. If that drain fails (a broken CUDA context), or the
    last reference dies while the interpreter is finalizing, the deleter is
    deliberately NOT called: the manager is leaked rather than risk a
    use-after-free or a GIL acquisition during shutdown (P1T-FIX1 F04/F05).
    Interpreter exit (P1T-FIX2 N5): an atexit hook stops admitting such
    releases and waits (GIL released, at most ``_DLPACK_SHUTDOWN_WAIT_S``
    seconds) for the ones already taking the GIL to finish; every release
    after it leaks (counted) without touching the GIL. A producer deleter that
    raises a C++ exception is contained and counted (P1T-FIX2 N4).
    The memory is never returned to TensorCUDA's pool and never
    ``cudaFree``-d by TensorCUDA.

    Refused with ``BufferError``, never converted: non-CUDA devices (CPU
    included), another CUDA device than TensorCUDA's, non-contiguous strides
    (a size-1 dimension may carry any stride), read-only tensors, and dtypes
    with no exact TensorCUDA match (supported: float32, float16, bfloat16,
    int64, uint8, bool). Refused with ``ValueError``: an element count, byte
    size, ``byte_offset`` + size or address range that overflows 64-bit
    arithmetic (P1T-FIX1 F03), counting every nonzero extent also when another
    extent is 0 (P1T-FIX2 N2: ``[0, 2**62, 4]`` is refused, not an empty
    tensor); ``TypeError``: anything that is neither a DLPack
    producer nor a capsule (``None`` included). The result has
    ``requires_grad=False``. If anything outside TensorCUDA later writes into
    it in place, call ``mark_modified()`` (see ``Tensor.__dlpack__``).
    """
    if not hasattr(obj, "__dlpack__"):
        return _C._from_dlpack_capsule(obj)   # bare capsule (TypeError otherwise)
    dev = getattr(obj, "__dlpack_device__", None)
    if dev is not None:
        dev_type, dev_id = dev()
        if int(dev_type) != _KDL_CUDA:
            raise BufferError(
                f"from_dlpack: only CUDA device memory (kDLCUDA = 2) can be "
                f"imported; the producer reports device ({int(dev_type)}, "
                f"{int(dev_id)})" + (" (CPU)" if int(dev_type) == 1 else ""))
    try:
        cap = obj.__dlpack__(stream=_DLPACK_LEGACY_STREAM,
                             max_version=_DLPACK_MAX_VERSION)
    except TypeError:
        cap = obj.__dlpack__(stream=_DLPACK_LEGACY_STREAM)
    return _C._from_dlpack_capsule(cap)


def empty(*shape, dtype="float32", device="cuda"):
    """Uninitialized tensor allocated on the device by the engine's allocator.

    Amendment 1 (P1T-M1): binds ``NDArray::empty`` with no host round-trip and
    no fill, so the CONTENTS ARE UNINITIALIZED (whatever the allocator hands
    back). Shape conventions match ``zeros``: ``empty(2, 3)``,
    ``empty((2, 3))`` or ``empty([2, 3])``; ``empty()`` is 0-d. Returns a
    Tensor with ``requires_grad=False``. Unlike ``zeros``, an unknown dtype
    string raises instead of falling back to float32. More than 8 dimensions
    (TensorCUDA's maximum rank), a negative extent, or an element count or
    byte size that overflows 64-bit arithmetic raises ``ValueError`` before
    anything is allocated (P1T-FIX1 F03). Every nonzero extent counts, also
    when another extent is 0 (P1T-FIX2 N2): the product of the extents with
    zeros counted as 1, times the element size, must fit in int64, so
    ``empty(0, 2**62, 4)`` raises while ``empty(0, 2**60)`` is an empty tensor
    (NumPy's rule).
    """
    if len(shape) == 1 and isinstance(shape[0], (tuple, list)):
        shape = tuple(shape[0])
    return _C.empty([operator.index(s) for s in shape], dtype, device)


# P1T-FIX2 (N5): interpreter-exit coordination for DLPack import releases that
# need the GIL (bindings.cpp, ImportReleaseLifecycle). CPython runs atexit
# callbacks before it marks the runtime finalizing (v3.12.3 pylifecycle.c,
# Py_FinalizeEx: _PyAtExit_Call at line 1815, _PyRuntimeState_SetFinalizing at
# 1833), so this hook closes admission while taking the GIL is still safe and
# waits for the releases already admitted. Knob: the bound on that wait, in
# seconds (a release normally finishes in microseconds; the bound only matters
# for a producer deleter that blocks). Prior art: CPython's own
# threading._shutdown (join non-daemon threads before finalizing), the same
# "stop admitting, then wait" order; ours: applying it to the DLPack release.
_DLPACK_SHUTDOWN_WAIT_S = 5.0


def _dlpack_shutdown_hook():
    # An exception from an atexit callback cannot be handled by anyone: log, never raise.
    try:
        r = _C._dlpack_begin_shutdown(float(_DLPACK_SHUTDOWN_WAIT_S))
        if r["timed_out"]:
            sys.stderr.write(
                f"tensor_cuda: {r['still_in_flight']} DLPack release(s) still running after "
                f"{_DLPACK_SHUTDOWN_WAIT_S} s at exit; the interpreter may terminate "
                f"that thread during finalization\n")
            sys.stderr.flush()
    except Exception as e:  # noqa: BLE001
        try:
            sys.stderr.write(f"tensor_cuda: DLPack exit hook failed ({type(e).__name__}: {e})\n")
            sys.stderr.flush()
        except Exception:  # noqa: BLE001
            pass


atexit.register(_dlpack_shutdown_hook)


def matmul(a, b, alpha=1.0, trans_b=False):
    # trans_b reads b as (..., N, K) row-major via cuBLAS OP_T — no transpose
    # copy. alpha is applied in the fp32 accumulator before the 16-bit store.
    return _C.matmul(a, b, alpha, trans_b)


