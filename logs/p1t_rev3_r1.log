   803	  // bad_alloc here propagates as MemoryError (an error, not a success, and not a terminate). The earlier release-path
   804	  // failures are cleared only once their message exists, so they are raised exactly once.
   805	  if (test_hooks::take(test_hooks::kAllocErrorMessage)) throw std::bad_alloc();
