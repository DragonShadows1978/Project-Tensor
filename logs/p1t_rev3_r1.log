   589	// Never destroyed (a foreign thread may release after static destruction began). Constructed at module import
   590	// (PYBIND11_MODULE below), so no release path is the first caller (its allocation could fail there).
   591	ImportReleaseLifecycle& release_lifecycle() {
   592	  static ImportReleaseLifecycle* s = new ImportReleaseLifecycle();
   593	  return *s;
   594	}
