   652	// N5: the atexit side (tensor_cuda/__init__.py _dlpack_shutdown_hook). Called with the GIL held by the main thread.
   653	py::dict dlpack_begin_shutdown(double timeout_s) {
   654	  ImportReleaseLifecycle& lc = release_lifecycle();
   655	  if (!(timeout_s >= 0.0)) timeout_s = 0.0;                 // NaN or negative: do not wait
   656	  if (timeout_s > 86400.0) timeout_s = 86400.0;             // keep the chrono conversion finite
   657	  const auto bound = std::chrono::microseconds(static_cast<long long>(timeout_s * 1e6));
   658	  long long at_close = 0;
   659	  long long remaining = 0;
   660	  bool timed_out = false;
   661	  const auto t0 = std::chrono::steady_clock::now();
   662	  {
   663	    py::gil_scoped_release nogil;                           // in-flight releases need the GIL to finish
   664	    std::unique_lock<std::mutex> lk(lc.mu);
   665	    lc.closing = true;
   666	    at_close = lc.in_flight;
   667	    if (at_close > 0) timed_out = !lc.cv.wait_for(lk, bound, [&lc] { return lc.in_flight == 0; });
   668	    remaining = lc.in_flight;
   669	  }  // lk is released before nogil re-takes the GIL
   670	  const long long waited_us =
   671	      std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - t0).count();
   672	  g_shutdown_calls.fetch_add(1);
   673	  g_shutdown_in_flight_at_close.fetch_add(static_cast<unsigned long long>(at_close));
   674	  if (timed_out) g_shutdown_timeouts.fetch_add(1);
   675	  g_shutdown_still_in_flight.store(static_cast<unsigned long long>(remaining));
   676	  g_shutdown_wait_us.fetch_add(static_cast<unsigned long long>(waited_us));
   677	  py::dict d;
   678	  d["in_flight_at_close"] = at_close;
   679	  d["still_in_flight"] = remaining;
   680	  d["timed_out"] = timed_out;
   681	  d["waited_us"] = waited_us;
   682	  return d;
   683	}
