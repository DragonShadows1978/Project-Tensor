   606	template <typename M>
   607	void import_release_impl(M* m) noexcept {
   608	  if (!m || !m->deleter) return;
   609	  ImportReleaseLifecycle& lc = release_lifecycle();
   610	  bool admitted = false;
   611	  try {
   612	    std::lock_guard<std::mutex> lk(lc.mu);
   613	    // Both checks leak without touching the GIL; the order only decides which counter records it (a release during
   614	    // finalization keeps FIX1's leaked_interpreter_shutdown attribution).
   615	    if (!interpreter_accepts_gil_state()) {
   616	      g_import_leaked_shutdown.fetch_add(1);         // F04: second line of defence
   617	    } else if (lc.closing) {
   618	      g_import_leaked_closing.fetch_add(1);          // N5: after the exit hook closed admission: deliberate leak
   619	    } else {
   620	      ++lc.in_flight;
   621	      admitted = true;
   622	    }
   623	  } catch (...) {
   624	    g_import_lock_failures.fetch_add(1);
   625	  }
   626	  if (!admitted) return;
   627	  PyGILState_STATE g = PyGILState_Ensure();
   628	  try {
   629	    m->deleter(m);
   630	    g_import_released.fetch_add(1);
   631	  } catch (...) {
   632	    g_import_deleter_exceptions.fetch_add(1);        // N4: contained (GIL still held while the exception dies)
   633	  }
   634	  PyGILState_Release(g);
   635	  // Leave only after PyGILState_Release: the exit hook must not let finalization start while this thread still
   636	  // touches the interpreter.
   637	  try {
   638	    std::lock_guard<std::mutex> lk(lc.mu);
   639	    if (--lc.in_flight == 0) lc.cv.notify_all();
   640	  } catch (...) {
   641	    g_import_lock_failures.fetch_add(1);
   642	  }
   643	}
   644	
   645	void import_release_legacy(void* ctx) noexcept {
   646	  import_release_impl(static_cast<DLManagedTensor*>(ctx));
   647	}
   648	void import_release_versioned(void* ctx) noexcept {
   649	  import_release_impl(static_cast<DLManagedTensorVersioned*>(ctx));
   650	}
