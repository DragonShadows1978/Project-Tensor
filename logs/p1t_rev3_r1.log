                ok ? "true" : "false");
  }
  std::printf("{\"summary\": {\"mode\": \"ck_census\", \"cases\": %d, \"failures\": %d}}\n", cases, failures);
  return failures == 0 ? 0 : 1;
}
}  // namespace

