+'''
+Y2_NEW = '''    ''' + mark("m10_f2_empty_batch_raise") + '''
+    if (false && a.ndim() != b.ndim() &&
+        std::any_of(a_shape.begin(), a_shape.end() - 2, [](int64_t dim) { return dim == 0; })) {
+'''
