+    def verdict_of(tag, rows_, mode):
+        d = os.path.join(TMP, "bwd0", tag)
+        os.makedirs(d, exist_ok=True)
+        json.dump({"module_sha256": "constructed", "rows": rows_}, open(os.path.join(d, "bwd0.json"), "w"))
+        bwd0.verdict(d, mode)
