+        shutil.copytree(os.path.join(TC, "tensor_cuda"), os.path.join(dst, "tensor_cuda"),
+                        ignore=shutil.ignore_patterns("*.so", "__pycache__", "*.eng4tmp"))
+        path = os.path.join(dst, m["file"])
+        s = open(path).read()
