+started = threading.Event()
+KEEP = []
+def slow_body():
+    DEL['calls'] += 1
+    print('DELETER started', flush=True)
+    started.set()
+    time.sleep(SLEEP)                                   # releases the GIL; re-taken to return
+    DEL['done'] += 1
+    print('DELETER finished', flush=True)
