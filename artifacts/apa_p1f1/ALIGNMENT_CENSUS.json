{
  "rule": "R2 (P1R-F02): every launcher that reads a caller operand with a vector type refuses, before any launch, a base pointer not aligned to that width (16 B for uint4/float4, 8 B for uint2), with a ValueError naming the entry, the operand and the alignment. Line numbers are this round's sources (APA-P1-F1 tree).",
  "method": "Read from the code: every reinterpret_cast to uint2/uint4/float4 in tensor_cuda/src/apa_spo (rg -n 'uint4|uint2|float4'), followed to the launcher that dispatches the kernel and to the caller operand the pointer is derived from. Row offsets inside each kernel are multiples of the vector width (row strides D*2 = 128/256 B, D/2 = 32/64 B, VD*2, tig*DPL), so the base pointer's alignment decides. Loads from this launcher's own buffers (arena views, the rotated query from apa_spq1_rotate, shared memory) are not caller operands; they are listed under internal.",
  "rows": [
    {"id": "d1_kq", "launcher": "apa_spq1_core (apa_spo2_run, _spo2.run / _C.apa_spo2_dump)", "operand": "kq", "width": 16, "vector": "uint4", "load_site": "d1.cuh:26 spo2::stage, called from spo2::bulk_kernel d1.cuh:61", "condition": "not baseline, dots ordered, H/KVH == 1, (cap > 64 or S <= 2048), D % (16/sizeof(T)) == 0; unpacked only", "check_site": "launcher.cuh apa_spq1_core_check"},
    {"id": "d1_k", "launcher": "apa_spq1_core (d1)", "operand": "k", "width": 16, "vector": "uint4", "load_site": "d1.cuh:26 via spo2::select_kernel d1.cuh:145", "condition": "same staged condition, D % V == 0", "check_site": "launcher.cuh apa_spq1_core_check"},
    {"id": "d1_v", "launcher": "apa_spq1_core (d1)", "operand": "v", "width": 16, "vector": "uint4", "load_site": "d1.cuh:26 via spo2::select_kernel d1.cuh:179", "condition": "same staged condition, VD % V == 0", "check_site": "launcher.cuh apa_spq1_core_check"},
    {"id": "d1_k_fp32", "launcher": "apa_spq1_core (d1, float32)", "operand": "k", "width": 16, "vector": "uint4", "load_site": "d1.cuh:26 via d1.cuh:145", "condition": "staged, fp32 (V = 4)", "check_site": "launcher.cuh apa_spq1_core_check"},
    {"id": "r2_G1_k", "launcher": "apa_spq1_run -> apa_spq1_core (packed r2, _spo2.packed_run gqa_path r2)", "operand": "k", "width": 16, "vector": "uint4", "load_site": "d1.cuh:26 via d1.cuh:145 (exact-K refine)", "condition": "staged path: H/KVH == 1 (packed bulk replaces the kq stage)", "check_site": "launcher.cuh apa_spq1_core_check, called from apa_spq1_run before the query rotation"},
    {"id": "r2_G1_v", "launcher": "apa_spq1_run (packed r2)", "operand": "v", "width": 16, "vector": "uint4", "load_site": "d1.cuh:26 via d1.cuh:179", "condition": "staged path, VD % V == 0", "check_site": "launcher.cuh apa_spq1_core_check"},
    {"id": "spq4_q", "launcher": "apa_spq4_tc (packed_run gqa_path tc, fmt int4)", "operand": "q", "width": 8, "vector": "uint2", "load_site": "spq4.cuh:86 bulk_mma, spq4.cuh:220 select_pv", "check_site": "spq4.cuh apa_spq4_tc"},
    {"id": "spq4_codes", "launcher": "apa_spq4_tc", "operand": "codes", "width": 16, "vector": "uint4 (D128; uint2 = 8 B at D64)", "load_site": "spq4.cuh:99 (D128), spq4.cuh:100 (D64)", "check_site": "spq4.cuh apa_spq4_tc"},
    {"id": "spq4_k", "launcher": "apa_spq4_tc", "operand": "k", "width": 16, "vector": "uint4", "load_site": "spq4.cuh:232", "check_site": "spq4.cuh apa_spq4_tc"},
    {"id": "spq4_v", "launcher": "apa_spq4_tc", "operand": "v", "width": 16, "vector": "uint4", "load_site": "spq4.cuh:168 (vbase, read at :296)", "check_site": "spq4.cuh apa_spq4_tc"},
    {"id": "spq6_q", "launcher": "apa_spq6_tq4_tc (packed_run gqa_path tc, fmt tq4)", "operand": "q", "width": 8, "vector": "uint2", "load_site": "spq4.cuh:220 (spq4::select_pv)", "check_site": "spq6.cuh apa_spq6_tq4_tc"},
    {"id": "spq6_codes", "launcher": "apa_spq6_tq4_tc", "operand": "codes", "width": 16, "vector": "uint4 (D128; uint2 = 8 B at D64)", "load_site": "spq6.cuh:130 (D128), spq6.cuh:131 (D64)", "check_site": "spq6.cuh apa_spq6_tq4_tc"},
