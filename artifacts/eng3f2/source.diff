+    """Execute the allocating constructor's byte-bound throw, before allocation.
+    Both CPU and bare CUDA descriptors reach the same check without CUDA calls.
+    """
+    shape = [2, 2**62] if itemsize == 1 else [(2**63 - 1) // itemsize + 1]
+    if empty:
