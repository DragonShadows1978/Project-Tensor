+// BP-KERNEL-1 opt-in variants; original kernel and launcher above are untouched.
+// Prior art: NVIDIA CUDA atomicAdd / mixed-precision FP32 accumulation (system,
+// publication year unverified — lead to check: CUDA BF16 FP32 atomic accumulation).
+// Taken: wider scratch reduction then one cast; ours: native APA b/c/d isolation.
+// c is a deletion ablation only: it is NOT an atomics-free gradient algorithm.
+// Related valid atomics-free dK/dV: key-parallel attention backward passes,
+// Dao et al., FlashAttention (2022), unverified — lead to check that paper's
+// backward work partitioning. Not implemented in this order.
+template <typename T, int DMAX, bool WRITE_KV, bool OUTPUT_DOT>
+__global__ void apa_selective_bwd_bk1_kernel(
+    const T* q, const T* k, const T* kq, const T* v, const T* dO,
+    const float* lse, const float* thr_in,
+    T* dq, float* dk, float* dv, const T* out,
+    int B, int H, int L, int S, int D, int VD, float scale,
+    int is_causal, int KVH, int group) {
+  int row = blockIdx.x;
+  int i = row % L;
+  int bh = row / L;
+  int b = bh / H;
+  int h = bh % H;
+  int kv_h = h / group;
+  int tid = threadIdx.x, nt = blockDim.x;
+
+  const T* qrow = q + (int64_t)row * D;
+  const T* dOrow = dO + (int64_t)row * VD;
+  int64_t kvbh = (int64_t)b * KVH + kv_h;
+  const T* kbase = k + kvbh * S * D;
+  const T* kqbase = kq + kvbh * S * D;
+  const T* vbase = v + kvbh * S * VD;
+  float* dkbase = WRITE_KV ? dk + kvbh * S * D : nullptr;
+  float* dvbase = WRITE_KV ? dv + kvbh * S * VD : nullptr;
+
+  __shared__ float qsh[DMAX];
+  __shared__ float dOsh[DMAX];
+  for (int d = tid; d < D; d += nt) qsh[d] = ld<T>(qrow, d);
+  for (int d = tid; d < VD; d += nt) dOsh[d] = ld<T>(dOrow, d);
+  __syncthreads();
+
+  int s_max = is_causal ? ((S - L) + i + 1) : S;
+  float L_se = lse[row];
+  float thr = thr_in[row];
+  __shared__ float red[256];
+
+  // Pass A: rowdot = sum_j p_j * (dO . v_j)
+  float partial = 0.f;
+  if constexpr (OUTPUT_DOT) {
+    // Prior art: Dao et al., FlashAttention (2022), D_i = dO_i dot O_i.
+    // Taken: identity; ours: saved BF16 native mixed-score output adaptation.
+    // Unverified — lead to check: FlashAttention backward Di sum dO O 2022.
+    for (int d = tid; d < VD; d += nt)
