+  // dV_j += p_j * dO ; dQ += dScore_j*scale * (k_j or kq_j) ; dK_j += dScore_j*scale*q (selected).
+  float dq_acc[DMAX];
+  for (int d = 0; d < D; ++d) dq_acc[d] = 0.f;
+  for (int j = tid; j < s_max; j += nt) {
+    const T* kqj = kqbase + (int64_t)j * D;
+    float bulk = 0.f;
+    for (int d = 0; d < D; ++d) bulk += qsh[d] * ld<T>(kqj, d);
