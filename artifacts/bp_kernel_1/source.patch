+  if (variant=="a") return apa_selective_bwd(q,k,kq,v,dO,lse,thr,scale,is_causal);
+  return apa_selective_bwd_bk1_cuda(q,k,kq,v,dO,lse,thr,out,scale,is_causal,variant);
