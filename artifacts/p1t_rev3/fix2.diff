+res['calls'] = int(native_calls())
+res['delta'] = delta(s0, dict(_C.pending_stats()))
+if mode != 'atexit':
+    torch.cuda.synchronize()
+    res['correct'] = bool(torch.all(y == 1.0).item()) if mode != 'immediate' else None
+print('RESULT ' + json.dumps(res), flush=True)
+'''
