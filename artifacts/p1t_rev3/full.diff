--- /dev/null
+++ b/tc_signal/src/lstm_bindings.cpp
@@ -0,0 +1,272 @@
+// _tc_signal LSTM entry points (P1T-M3, T4). Registered into M2's module by one `register_lstm(m);` line in
+// bindings.cpp. Same operand contract and plan/run split as M2's convolutions (src/bindings.cpp, dlpack_operand.h):
+//   lstm_plan(x, W, R, B, initial_h, initial_c, hidden_size, direction)
+//       -> acquires the input capsules (__dlpack__(stream=1)), PEEKS them (device, dtype, layout, shapes) without
+//          consuming, and returns (x, W, R, B|None, initial_h|None, initial_c|None capsules, Y shape, Y_h/Y_c shape,
+//          scratch numel, T, N) so the Python layer can size and allocate the outputs and the one scratch operand;
+//   lstm_run(capsules, Y, Y_h, Y_c, scratch, hidden_size, direction)
+//       -> consumes every capsule, re-validates, checks devices and that no written operand aliases any other operand,
+//          runs the whole recurrence (lstm.cu: all T steps, every direction) on the legacy default stream inside this
+//          one call, then hands the call's whole capsule set (up to 10 managers: x, W, R, B, initial_h, initial_c,
+//          Y, Y_h, Y_c, scratch) to the deferred-release list as ONE entry (P1T-FIX1 F01, dlpack_operand.h): the
+//          deleters run once the legacy stream has passed the last step's cell kernel.
+// P1T-FIX1: F02 (required x/W/R and every run operand: None -> TypeError), F03 (T*N, D*N*H, the Y size and the
+// scratch size and bytes all checked before the int32 range checks and before any launch).
+// direction codes: 0 forward, 1 reverse, 2 bidirectional (the Python layer maps the ONNX strings).
+//
+// Prior art: the operand contract and the plan/run split are M2's (see dlpack_operand.h and bindings.cpp for their
+// prior art: DLPack, the Python array API stream protocol, cuDNN/cuBLASLt workspace-query APIs). M2's peek helpers in
+// bindings.cpp have internal linkage, so the two small ones used here (peek + same-device check) are restated, not
+// shared. The LSTM shape rules are the ONNX LSTM operator's (layout 0). Nothing here is new.
+#include <pybind11/pybind11.h>
+#include <pybind11/stl.h>
+
+#include <climits>
+#include <sstream>
+#include <string>
+#include <vector>
+
+#include "checked_math.h"
+#include "dlpack_operand.h"
+#include "lstm_ops.h"
+
+namespace py = pybind11;
+
+namespace tcs {
+namespace {
+
+constexpr int64_t kDirForward = 0;
+constexpr int64_t kDirReverse = 1;
+constexpr int64_t kDirBidirectional = 2;
+
+[[noreturn]] void lstm_bad(const std::string& msg) { throw py::value_error("tc_signal.lstm: " + msg); }
+
+void check_int_range(const char* what, int64_t v) {
+  if (v > INT_MAX) {
+    std::ostringstream os;
+    os << what << " (" << v << ") exceeds the 32-bit range cuBLAS takes";
+    lstm_bad(os.str());
+  }
+}
+
+void expect_dims(const char* role, const std::vector<int64_t>& got, const std::vector<int64_t>& want,
+                 const char* layout) {
+  if (got != want) {
+    std::ostringstream os;
+    os << role << " has shape " << shape_str(got) << ", expected " << shape_str(want) << " (" << layout << ")";
+    lstm_bad(os.str());
+  }
+}
+
+struct LstmPlan {
+  LstmGeom g;
+  std::vector<int64_t> y_shape;       // [T, D, N, H]
+  std::vector<int64_t> state_shape;   // [D, N, H]
+  int64_t scratch_numel;
+};
+
+LstmPlan plan_lstm(const std::vector<int64_t>& xs, const std::vector<int64_t>& Ws, const std::vector<int64_t>& Rs,
+                   const std::vector<int64_t>* Bs, const std::vector<int64_t>* h0s, const std::vector<int64_t>* c0s,
+                   int64_t hidden_size, int64_t direction) {
+  std::ostringstream os;
+  if (direction != kDirForward && direction != kDirReverse && direction != kDirBidirectional) {
+    os << "direction code " << direction << " is not 0 (forward), 1 (reverse) or 2 (bidirectional)";
+    lstm_bad(os.str());
+  }
+  if (hidden_size < 1 || hidden_size > INT_MAX / (kLstmGates * kLstmBiasHalves)) {
+    os << "hidden_size must be in [1, " << INT_MAX / (kLstmGates * kLstmBiasHalves) << "], got " << hidden_size;
+    lstm_bad(os.str());
+  }
+  LstmPlan p{};
+  LstmGeom& g = p.g;
+  g.T = xs[0];
+  g.N = xs[1];
+  g.I = xs[2];
+  g.H = hidden_size;
+  g.D = (direction == kDirBidirectional) ? 2 : 1;
+  g.first_reverse = (direction == kDirForward) ? g.D : (direction == kDirReverse ? 0 : 1);
+  const int64_t H4 = kLstmGates * g.H;
+  if (Ws[0] != g.D) {
+    os << "W.shape[0] (" << Ws[0] << ") != num_directions (" << g.D << ") for this direction; W is [D, 4H, I]";
+    lstm_bad(os.str());
+  }
+  if (Ws[1] != H4) {
+    os << "W.shape[1] (" << Ws[1] << ") != 4*hidden_size (" << H4 << "); W is [D, 4H, I]";
+    lstm_bad(os.str());
+  }
+  if (Ws[2] != g.I) {
+    os << "W.shape[2] (" << Ws[2] << ") != input size x.shape[2] (" << g.I << "); W is [D, 4H, I]";
+    lstm_bad(os.str());
+  }
+  expect_dims("R", Rs, {g.D, H4, g.H}, "R is [D, 4H, H]");
+  if (Bs != nullptr) expect_dims("B", *Bs, {g.D, kLstmBiasHalves * H4}, "B is [D, 8H] = [Wb; Rb]");
+  if (h0s != nullptr) expect_dims("initial_h", *h0s, {g.D, g.N, g.H}, "initial_h is [D, N, H]");
+  if (c0s != nullptr) expect_dims("initial_c", *c0s, {g.D, g.N, g.H}, "initial_c is [D, N, H]");
+  check_int_range("4*hidden_size", H4);
+  check_int_range("T*N", ck_mul(g.T, g.N, "lstm: T*N"));
+  check_int_range("input size", g.I);
+  check_int_range("batch size", g.N);
+  check_int_range("D*N*H", ck_mul(ck_mul(g.D, g.N, "lstm: D*N"), g.H, "lstm: D*N*H"));
+  p.y_shape = {g.T, g.D, g.N, g.H};
+  p.state_shape = {g.D, g.N, g.H};
+  ck_shape_numel(p.y_shape, "lstm: Y size T*D*N*H");
+  ck_shape_numel(p.state_shape, "lstm: Y_h/Y_c size D*N*H");
+  // F03: the scratch size G_x [D, T, N, 4H] + G_h [D, N, 4H] and its bytes, checked; lstm_scratch_numel (unchecked,
+  // used again by lstm.cu) is then known not to overflow.
+  const int64_t gx = ck_mul(ck_mul(ck_mul(g.D, g.T, "lstm: scratch G_x"), g.N, "lstm: scratch G_x"), H4,
+                            "lstm: scratch G_x");
+  const int64_t gh = ck_mul(ck_mul(g.D, g.N, "lstm: scratch G_h"), H4, "lstm: scratch G_h");
+  p.scratch_numel = ck_add(gx, gh, "lstm: scratch size");
+  ck_fp32_bytes(p.scratch_numel, "lstm: scratch bytes");
+  return p;
+}
+
+// ------------------------------------------------------------------------------------------------ peek helpers
+struct Peeked {
+  py::object capsule;            // None for an absent optional operand
+  std::vector<int64_t> shape;
+  int device = -1;
+  bool present = false;
+};
+
+// Optional operands only (B, initial_h, initial_c); required ones go through require_operand first.
+Peeked peek_operand(py::handle obj, const char* role, int ndim) {
+  Peeked p;
+  if (obj.is_none()) {
+    p.capsule = py::none();
+    return p;
+  }
+  p.capsule = to_capsule(obj, role, false);
+  const DLTensor* t = peek(p.capsule, role);
+  validate_tensor(t, role, ndim);
+  p.shape = shape_of(t);
+  p.device = t->device.device_id;
+  p.present = true;
+  return p;
+}
+
+void same_device_peeked(const std::vector<const Peeked*>& ps, const std::vector<const char*>& roles) {
+  int dev = -1;
+  const char* first = "";
+  for (size_t i = 0; i < ps.size(); ++i) {
+    if (!ps[i]->present) continue;
+    if (dev < 0) {
+      dev = ps[i]->device;
+      first = roles[i];
+    } else if (ps[i]->device != dev) {
+      std::ostringstream os;
+      os << "tc_signal: operand '" << roles[i] << "': on CUDA device " << ps[i]->device << " but operand '" << first
+         << "' is on CUDA device " << dev << "; every operand must be on the same device";
+      throw py::value_error(os.str());
+    }
+  }
+}
+
+std::vector<int64_t> op_shape(const Operand& op) {
+  std::vector<int64_t> s(op.ndim());
+  for (int i = 0; i < op.ndim(); ++i) s[i] = op.dim(i);
+  return s;
+}
+
+py::tuple to_tuple(const std::vector<int64_t>& v) {
+  py::tuple t(v.size());
+  for (size_t i = 0; i < v.size(); ++i) t[i] = py::int_(v[i]);
+  return t;
+}
+
+// ------------------------------------------------------------------------------------------------ entry points
+py::tuple lstm_plan(py::object x, py::object W, py::object R, py::object B, py::object h0, py::object c0,
+                    int64_t hidden_size, int64_t direction) {
+  drain_completed();
+  require_operand(x, "x");
+  require_operand(W, "W");
+  require_operand(R, "R");
+  Peeked X = peek_operand(x, "x", 3);
+  Peeked Wp = peek_operand(W, "W", 3);
+  Peeked Rp = peek_operand(R, "R", 3);
+  Peeked Bp = peek_operand(B, "B", 2);
+  Peeked H0 = peek_operand(h0, "initial_h", 3);
+  Peeked C0 = peek_operand(c0, "initial_c", 3);
+  same_device_peeked({&X, &Wp, &Rp, &Bp, &H0, &C0}, {"x", "W", "R", "B", "initial_h", "initial_c"});
+  LstmPlan p = plan_lstm(X.shape, Wp.shape, Rp.shape, Bp.present ? &Bp.shape : nullptr,
+                         H0.present ? &H0.shape : nullptr, C0.present ? &C0.shape : nullptr, hidden_size, direction);
+  return py::make_tuple(X.capsule, Wp.capsule, Rp.capsule, Bp.capsule, H0.capsule, C0.capsule, to_tuple(p.y_shape),
+                        to_tuple(p.state_shape), py::int_(p.scratch_numel), py::int_(p.g.T), py::int_(p.g.N));
+}
+
+void lstm_run(py::object xc, py::object Wc, py::object Rc, py::object Bc, py::object h0c, py::object c0c, py::object Y,
+              py::object Y_h, py::object Y_c, py::object scratch, int64_t hidden_size, int64_t direction) {
+  drain_completed();
+  require_operand(xc, "x");
+  require_operand(Wc, "W");
+  require_operand(Rc, "R");
+  require_operand(Y, "Y");
+  require_operand(Y_h, "Y_h");
+  require_operand(Y_c, "Y_c");
+  require_operand(scratch, "scratch");
+  Operand X(xc, "x", 3, false);
+  Operand Wo(Wc, "W", 3, false);
+  Operand Ro(Rc, "R", 3, false);
+  Operand Bo;
+  if (!Bc.is_none()) Bo = Operand(Bc, "B", 2, false);
+  Operand H0;
+  if (!h0c.is_none()) H0 = Operand(h0c, "initial_h", 3, false);
+  Operand C0;
+  if (!c0c.is_none()) C0 = Operand(c0c, "initial_c", 3, false);
+  std::vector<int64_t> bshape, h0shape, c0shape;
+  if (Bo.present()) bshape = op_shape(Bo);
+  if (H0.present()) h0shape = op_shape(H0);
+  if (C0.present()) c0shape = op_shape(C0);
+  LstmPlan p = plan_lstm(op_shape(X), op_shape(Wo), op_shape(Ro), Bo.present() ? &bshape : nullptr,
+                         H0.present() ? &h0shape : nullptr, C0.present() ? &c0shape : nullptr, hidden_size, direction);
+  Operand Yo(to_capsule(Y, "Y", true), "Y", 4, true);
+  expect_shape(Yo, p.y_shape);
+  Operand Yh(to_capsule(Y_h, "Y_h", true), "Y_h", 3, true);
+  expect_shape(Yh, p.state_shape);
+  Operand Yc(to_capsule(Y_c, "Y_c", true), "Y_c", 3, true);
+  expect_shape(Yc, p.state_shape);
+  Operand S(to_capsule(scratch, "scratch", true), "scratch", 1, true);
+  expect_shape(S, {p.scratch_numel});
+  const int device = common_device({&X, &Wo, &Ro, &Bo, &H0, &C0, &Yo, &Yh, &Yc, &S});
+  // Every written operand must not alias any input nor any other written operand.
+  const std::vector<const Operand*> written = {&Yo, &Yh, &Yc, &S};
+  const std::vector<const Operand*> inputs = {&X, &Wo, &Ro, &Bo, &H0, &C0};
+  for (size_t a = 0; a < written.size(); ++a) {
+    for (const Operand* in : inputs) expect_disjoint(*written[a], *in);
+    for (size_t b = a + 1; b < written.size(); ++b) expect_disjoint(*written[a], *written[b]);
+  }
+  // F01: the whole per-call capsule set is one pending entry, released after the last step's launch has run.
+  RetainUntilComplete keep(device, {&X, &Wo, &Ro, &Bo, &H0, &C0, &Yo, &Yh, &Yc, &S});
+  lstm_forward(device, p.g, X.data(), Wo.data(), Ro.data(), Bo.present() ? Bo.data() : nullptr,
+               H0.present() ? H0.data() : nullptr, C0.present() ? C0.data() : nullptr, Yo.data(), Yh.data(), Yc.data(),
+               S.data());
+}
+
+}  // namespace
+
+void register_lstm(py::module_& m) {
+  m.def("lstm_plan", &lstm_plan, py::arg("x"), py::arg("W"), py::arg("R"), py::arg("B"), py::arg("initial_h"),
+        py::arg("initial_c"), py::arg("hidden_size"), py::arg("direction"),
+        "Acquire and peek the LSTM inputs; return (x, W, R, B|None, initial_h|None, initial_c|None capsules, Y shape, "
+        "Y_h/Y_c shape, scratch numel, T, N).");
+  m.def("lstm_run", &lstm_run, py::arg("x_capsule"), py::arg("W_capsule"), py::arg("R_capsule"), py::arg("B_capsule"),
+        py::arg("initial_h_capsule"), py::arg("initial_c_capsule"), py::arg("Y"), py::arg("Y_h"), py::arg("Y_c"),
+        py::arg("scratch"), py::arg("hidden_size"), py::arg("direction"),
+        "Consume every operand, validate, run the whole LSTM recurrence on the legacy stream, release.");
+  m.def(
+      "lstm_cublas_config",
+      [](int device) {
+        LstmCublasConfig c = lstm_cublas_config(device);
+        py::dict d;
+        d["math_mode"] = c.math_mode;
+        d["atomics_mode"] = c.atomics_mode;
+        d["pointer_mode"] = c.pointer_mode;
+        d["legacy_stream"] = c.legacy_stream;
+        d["default_math"] = c.default_math;
+        d["atomics_not_allowed"] = c.atomics_not_allowed;
+        return d;
+      },
+      py::arg("device") = 0, "Settings of the LSTM's cuBLAS handle on `device` (creates it if needed).");
+}
+
+}  // namespace tcs
diff --git a/tc_signal/src/lstm_ops.h b/tc_signal/src/lstm_ops.h
new file mode 100644
index 0000000..6055695
--- /dev/null
+++ b/tc_signal/src/lstm_ops.h
@@ -0,0 +1,47 @@
+// Host launcher for tc_signal's ONNX-semantics LSTM (P1T-M3, T4). Raw device pointers in; everything is queued on the
+// legacy default stream; no device memory is allocated here (the projected-input and gate scratch is one operand the
+// Python layer allocates; the recurrent state lives in the Y_h / Y_c outputs). cuBLAS's own internal workspace for the
+// LSTM handle is the one exception (see lstm.cu, "cuBLAS handle").
+//
+// Prior art: see lstm.cu (ONNX LSTM operator spec; Hochreiter & Schmidhuber 1997; Gers, Schmidhuber & Cummins 2000;
+// input projection hoisted out of the recurrence as in Appleyard, Kocisky & Blunsom 2016 / cuDNN RNN).
+#pragma once
+
+#include <cstdint>
+
+namespace tcs {
+
+// Gate blocks per direction along the 4H axis of W, R, Wb and Rb (ONNX LSTM: i, o, f, c).
+constexpr int64_t kLstmGates = 4;
+// B is [D, 2 * kLstmGates * H] = [Wb; Rb] per direction.
+constexpr int64_t kLstmBiasHalves = 2;
+
+struct LstmGeom {
+  int64_t T, N, I;         // x [T, N, I] (ONNX layout 0)
+  int64_t H;               // hidden_size
+  int64_t D;               // direction slots: 1 (forward or reverse) or 2 (bidirectional)
+  int64_t first_reverse;   // slots d >= first_reverse run backwards in time (forward: 1, reverse: 0, bidirectional: 1)
+};
+
+// Scratch layout (one fp32 operand): G_x [D, T, N, 4H] (projected inputs, Wb included), then G_h [D, N, 4H] (the
+// per-step recurrent product h_{t-1} . R^T).
+inline int64_t lstm_gx_numel(const LstmGeom& g) { return g.D * g.T * g.N * kLstmGates * g.H; }
+inline int64_t lstm_gh_numel(const LstmGeom& g) { return g.D * g.N * kLstmGates * g.H; }
+inline int64_t lstm_scratch_numel(const LstmGeom& g) { return lstm_gx_numel(g) + lstm_gh_numel(g); }
+
+// Y [T, D, N, H], Y_h / Y_c [D, N, H]. B, h0 and c0 may be NULL (zeros). Y_h / Y_c double as the recurrent state.
+void lstm_forward(int device, const LstmGeom& g, const float* x, const float* W, const float* R, const float* B,
+                  const float* h0, const float* c0, float* Y, float* Y_h, float* Y_c, float* scratch);
+
+struct LstmCublasConfig {
+  int math_mode;           // cublasMath_t
+  int atomics_mode;        // cublasAtomicsMode_t
+  int pointer_mode;        // cublasPointerMode_t
+  bool legacy_stream;      // the handle's stream is 0 (the legacy default stream)
+  bool default_math;       // math_mode == CUBLAS_DEFAULT_MATH
+  bool atomics_not_allowed;
+};
+// The (lazily created) LSTM cuBLAS handle's settings on `device`.
+LstmCublasConfig lstm_cublas_config(int device);
+
+}  // namespace tcs
diff --git a/tc_signal/src/lstm_tuning.h b/tc_signal/src/lstm_tuning.h
new file mode 100644
index 0000000..380c3cf
--- /dev/null
+++ b/tc_signal/src/lstm_tuning.h
@@ -0,0 +1,19 @@
+// tc_signal LSTM tunables (P1T-M3). House tunable law: no launch-shape literals at the use sites; every LSTM knob
+// lives here (M2's tuning.h is shared and left untouched). None of these changes numerics: every output element of every
+// kernel is produced by exactly one thread in a fixed order (grid-stride loops), so a knob changes speed only.
+//
+// Prior art: none needed for a constants module (no prior art known to me).
+#pragma once
+
+namespace tcs {
+namespace lstm_tuning {
+
+// Threads per block for the fused LSTM cell kernel (one thread per (direction, batch, hidden unit)).
+constexpr int kCellBlock = 256;
+// Threads per block for the kernel that pre-fills the projected-input buffer with Wb (one thread per element).
+constexpr int kBiasFillBlock = 256;
+// Upper bound on blocks per launch; the kernels are grid-stride loops, so larger problems loop instead.
+constexpr long long kGridCap = 1LL << 20;
+
+}  // namespace lstm_tuning
+}  // namespace tcs
diff --git a/tc_signal/src/m4_bindings.cpp b/tc_signal/src/m4_bindings.cpp
new file mode 100644
index 0000000..4c7144c
--- /dev/null
+++ b/tc_signal/src/m4_bindings.cpp
@@ -0,0 +1,420 @@
+// _tc_signal P1T-M4 entry points: T5 norms (instance_norm1d, layer_norm, group_norm) and T6 small ops
+// (upsample_nearest1d, reflection_pad1d, rint). Registered into M2's module by `register_m4(m)` (one call in
+// bindings.cpp), so the package stays one .so with one DLPack consumer contract.
+//
+// Same contract as M2 (src/bindings.cpp): every operand, the output included, is a DLPack producer or capsule; this file
+// allocates no device memory. Two calls per op:
+//   *_plan(...) -> acquires the input capsules (__dlpack__(stream=1)), PEEKS them (device/dtype/layout/rank/shape and
+//                  the attributes are checked without consuming), returns (capsules..., out_shape);
+//   *_run(...)  -> consumes every capsule, re-derives the geometry from the consumed shapes, checks the output's shape,
+//                  the common device and that the output overlaps no input, launches on the legacy default stream, and
+//                  hands every consumed manager to the deferred-release list (P1T-FIX1 F01, dlpack_operand.h).
+// P1T-FIX1: F02 (x is REQUIRED in all six ops: None -> TypeError before planning, in peek4 and consume4; scale and bias
+// are the only optional operands), F03 (rows, L, T*scale, T + pads and every output size checked, checked_math.h).
+//
+// Prior art: the DLPack consumer and the plan/run split are M2's (see dlpack_operand.h and bindings.cpp: DLPack v1.3,
+// the Python array API stream protocol, the cuDNN/cuBLASLt "size, then execute" pattern), reused here unchanged. The
+// ONNX operator specs define the attribute rules (LayerNormalization axis in [-r, r); GroupNormalization num_groups
+// dividing C; Pad reflect needs pads < T; Resize nearest at an integer scale). Ours: the row-norm geometry mapping
+// (rows x L plus an affine index rule) shared by the three norms; no prior art known to me for that mapping as such.
+#include <pybind11/pybind11.h>
+#include <pybind11/stl.h>
+
+#include <cmath>
+#include <cstdint>
+#include <limits>
+#include <sstream>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+#include "checked_math.h"
+#include "dlpack_operand.h"
+#include "m4_ops.h"
+
+namespace py = pybind11;
+
+namespace tcs {
+namespace {
+
+[[noreturn]] void bad_attr4(const std::string& msg) { throw py::value_error("tc_signal: " + msg); }
+
+[[noreturn]] void bad_operand4(const char* role, const std::string& msg) {
+  throw py::value_error(std::string("tc_signal: operand '") + role + "': " + msg);
+}
+
+// ------------------------------------------------------------------------------------------------ peek / consume
+struct Peek4 {
+  py::object capsule = py::none();  // None for an absent optional operand
+  std::vector<int64_t> shape;
+  int device = -1;
+  bool present = false;
+};
+
+// rank >= 0: exactly that rank; rank < 0: any rank >= min_rank.
+void check_rank(const char* role, int ndim, int rank, int min_rank) {
+  if (rank < 0 && ndim < min_rank) {
+    std::ostringstream os;
+    os << "expected at least " << min_rank << " dimension" << (min_rank == 1 ? "" : "s") << ", got " << ndim;
+    bad_operand4(role, os.str());
+  }
+}
+
+enum class Need { kRequired, kOptional };
+
+Peek4 peek4(py::handle obj, const char* role, int rank, int min_rank, Need need) {
+  Peek4 p;
+  if (need == Need::kRequired) require_operand(obj, role);  // F02: None is refused here, before any planning
+  if (obj.is_none()) return p;
+  p.capsule = to_capsule(obj, role, false);
+  const DLTensor* t = peek(p.capsule, role);
+  validate_tensor(t, role, rank >= 0 ? rank : t->ndim);  // device, dtype, (rank), non-empty, C-contiguous, aligned
+  check_rank(role, t->ndim, rank, min_rank);
+  p.shape = shape_of(t);
+  p.device = t->device.device_id;
+  p.present = true;
+  return p;
+}
+
+void same_device4(const std::vector<std::pair<const Peek4*, const char*>>& ps) {
+  int dev = -1;
+  const char* first = "";
+  for (const auto& pr : ps) {
+    if (!pr.first->present) continue;
+    if (dev < 0) {
+      dev = pr.first->device;
+      first = pr.second;
+    } else if (pr.first->device != dev) {
+      std::ostringstream os;
+      os << "on CUDA device " << pr.first->device << " but operand '" << first << "' is on CUDA device " << dev
+         << "; every operand must be on the same device";
+      bad_operand4(pr.second, os.str());
+    }
+  }
+}
+
+// Consumes a capsule returned by a *_plan call (its rank is read from the capsule, then fully re-validated).
+Operand consume4(py::handle cap, const char* role, int rank, int min_rank, Need need) {
+  if (need == Need::kRequired) require_operand(cap, role);  // F02
+  if (cap.is_none()) return Operand();
+  const DLTensor* t = peek(cap, role);
+  const int nd = t->ndim;
+  Operand op(cap, role, rank >= 0 ? rank : nd, false);
+  check_rank(role, op.ndim(), rank, min_rank);
+  return op;
+}
+
+std::vector<int64_t> shape4(const Operand& op) {
+  std::vector<int64_t> s(op.ndim());
+  for (int i = 0; i < op.ndim(); ++i) s[i] = op.dim(i);
+  return s;
+}
+
+py::tuple tuple4(const std::vector<int64_t>& v) {
+  py::tuple t(v.size());
+  for (size_t i = 0; i < v.size(); ++i) t[i] = py::int_(v[i]);
+  return t;
+}
+
+// F03: checked product (checked_math.h).
+int64_t prod(const std::vector<int64_t>& s, size_t a, size_t b, const char* what) { return ck_prod(s, a, b, what); }
+
+// ------------------------------------------------------------------------------------------------ norms: plan
+enum class NormKind { kInstance, kLayer, kGroup };
+
+const char* norm_name(NormKind k) {
+  return k == NormKind::kInstance ? "instance_norm1d" : (k == NormKind::kLayer ? "layer_norm" : "group_norm");
+}
+
+struct NormPlan {
+  RowNormGeom g;
+  std::vector<int64_t> out_shape;
+  std::vector<int64_t> param_shape;
+};
+
+float checked_eps(const char* op, double eps) {
+  const float e = static_cast<float>(eps);
+  if (!std::isfinite(eps) || eps < 0.0 || !std::isfinite(e)) {
+    std::ostringstream os;
+    os << op << ": eps must be a finite number >= 0 that fits fp32, got " << eps;
+    bad_attr4(os.str());
+  }
+  return e;
+}
+
+// `arg` is the axis (layer_norm) or num_groups (group_norm); unused for instance_norm1d.
+NormPlan plan_norm(NormKind kind, const std::vector<int64_t>& xs, const std::vector<int64_t>* ss,
+                   const std::vector<int64_t>* bs, int64_t arg, double eps) {
+  const char* op = norm_name(kind);
+  NormPlan p{};
+  RowNormGeom& g = p.g;
+  g.eps = checked_eps(op, eps);
+  g.channels = g.groups = g.ch_per_group = g.T = 1;
+  const int64_t r = static_cast<int64_t>(xs.size());
+  std::ostringstream os;
+  if (kind == NormKind::kInstance || kind == NormKind::kGroup) {
+    if (r != 3) {
+      os << op << ": x must be [N, C, T], got " << r << " dimensions";
+      bad_attr4(os.str());
+    }
+    const int64_t N = xs[0], C = xs[1], T = xs[2];
+    p.param_shape = {C};
+    if (kind == NormKind::kInstance) {
+      g.rows = ck_mul(N, C, "instance_norm1d: rows N*C");
+      g.L = T;
+      g.affine = NormAffine::kPerRow;
+      g.channels = C;
+    } else {
+      if (arg < 1) {
+        os << "group_norm: num_groups must be >= 1, got " << arg;
+        bad_attr4(os.str());
+      }
+      if (C % arg != 0) {
+        os << "group_norm: C (" << C << ") is not divisible by num_groups (" << arg << ")";
+        bad_attr4(os.str());
+      }
+      g.rows = ck_mul(N, arg, "group_norm: rows N*num_groups");
+      g.L = ck_mul(C / arg, T, "group_norm: row length (C/num_groups)*T");
+      g.affine = NormAffine::kPerChannel;
+      g.groups = arg;
+      g.ch_per_group = C / arg;
+      g.T = T;
+    }
+  } else {
+    if (r < 1) {
+      os << "layer_norm: x must have at least 1 dimension, got " << r;
+      bad_attr4(os.str());
+    }
+    if (arg < -r || arg >= r) {
+      os << "layer_norm: axis must be in [" << -r << ", " << r - 1 << "] for a " << r << "-D x, got " << arg;
+      bad_attr4(os.str());
+    }
+    const int64_t a = arg < 0 ? arg + r : arg;
+    g.rows = prod(xs, 0, static_cast<size_t>(a), "layer_norm: rows");
+    g.L = prod(xs, static_cast<size_t>(a), xs.size(), "layer_norm: row length");
+    g.affine = NormAffine::kPerElem;
+    p.param_shape.assign(xs.begin() + a, xs.end());
+  }
+  for (const auto& pr : {std::make_pair(ss, "scale"), std::make_pair(bs, "bias")}) {
+    if (pr.first != nullptr && *pr.first != p.param_shape) {
+      std::ostringstream o2;
+      o2 << op << ": " << pr.second << " has shape " << shape_str(*pr.first) << ", expected "
+         << shape_str(p.param_shape)
+         << (kind == NormKind::kLayer ? " (x.shape[axis:])" : (kind == NormKind::kGroup ? " ([C], per channel)" : " ([C])"));
+      bad_attr4(o2.str());
+    }
+  }
+  p.out_shape = xs;
+  ck_shape_numel(p.out_shape, "norm: output size");
+  ck_mul(g.rows, g.L, "norm: rows*L");
+  return p;
+}
+
+int x_rank(NormKind kind) { return kind == NormKind::kLayer ? -1 : 3; }
+
+py::tuple norm_plan(NormKind kind, py::object x, py::object scale, py::object bias, int64_t arg, double eps) {
+  drain_completed();
+  Peek4 X = peek4(x, "x", x_rank(kind), 1, Need::kRequired);
+  Peek4 S = peek4(scale, "scale", -1, 1, Need::kOptional);
+  Peek4 B = peek4(bias, "bias", -1, 1, Need::kOptional);
+  same_device4({{&X, "x"}, {&S, "scale"}, {&B, "bias"}});
+  NormPlan p = plan_norm(kind, X.shape, S.present ? &S.shape : nullptr, B.present ? &B.shape : nullptr, arg, eps);
+  return py::make_tuple(X.capsule, S.capsule, B.capsule, tuple4(p.out_shape));
+}
+
+void norm_run(NormKind kind, py::object xc, py::object sc, py::object bc, py::object out, int64_t arg, double eps) {
+  drain_completed();
+  require_operand(out, "out");
+  Operand X = consume4(xc, "x", x_rank(kind), 1, Need::kRequired);
+  Operand S = consume4(sc, "scale", -1, 1, Need::kOptional);
+  Operand B = consume4(bc, "bias", -1, 1, Need::kOptional);
+  std::vector<int64_t> sshape, bshape;
+  if (S.present()) sshape = shape4(S);
+  if (B.present()) bshape = shape4(B);
+  NormPlan p = plan_norm(kind, shape4(X), S.present() ? &sshape : nullptr, B.present() ? &bshape : nullptr, arg, eps);
+  Operand Y(to_capsule(out, "out", true), "out", X.ndim(), true);
+  expect_shape(Y, p.out_shape);
+  const int device = common_device({&X, &S, &B, &Y});
+  for (const Operand* in : {&X, &S, &B}) expect_disjoint(Y, *in);
+  RetainUntilComplete keep(device, {&X, &S, &B, &Y});  // F01: deleters run after the legacy stream passes the launch
+  row_norm_forward(device, p.g, X.data(), S.present() ? S.data() : nullptr, B.present() ? B.data() : nullptr,
+                   Y.data());
+}
+
+// ------------------------------------------------------------------------------------------------ small ops: plan
+std::vector<int64_t> upsample_shape(const std::vector<int64_t>& xs, int64_t scale) {
+  if (scale < 1) {
+    std::ostringstream os;
+    os << "upsample_nearest1d: scale must be an integer >= 1, got " << scale;
+    bad_attr4(os.str());
+  }
+  const int64_t T = xs.back();
+  std::vector<int64_t> o = xs;
+  o.back() = ck_mul(T, scale, "upsample_nearest1d: output length T*scale");  // F03
+  ck_shape_numel(o, "upsample_nearest1d: output size");
+  return o;
+}
+
+std::vector<int64_t> pad_shape(const std::vector<int64_t>& xs, int64_t pb, int64_t pe) {
+  const int64_t T = xs.back();
+  std::ostringstream os;
+  if (pb < 0 || pe < 0) {
+    os << "reflection_pad1d: pads must be >= 0, got (" << pb << ", " << pe << ")";
+    bad_attr4(os.str());
+  }
+  if (pb >= T || pe >= T) {
+    os << "reflection_pad1d: each pad must be < T (" << T << ") for reflect padding (ONNX/torch), got (" << pb << ", "
+       << pe << ")";
+    bad_attr4(os.str());
+  }
+  std::vector<int64_t> o = xs;
+  // F03: T + pb + pe checked (the review's CPU reproduction returned a negative extent here), then the output size.
+  o.back() = ck_add(ck_add(T, pb, "reflection_pad1d: output length"), pe, "reflection_pad1d: output length");
+  ck_shape_numel(o, "reflection_pad1d: output size");
+  return o;
+}
+
+py::tuple upsample_plan(py::object x, int64_t scale) {
+  drain_completed();
+  Peek4 X = peek4(x, "x", -1, 1, Need::kRequired);
+  return py::make_tuple(X.capsule, tuple4(upsample_shape(X.shape, scale)));
+}
+
+void upsample_run(py::object xc, py::object out, int64_t scale) {
+  drain_completed();
+  require_operand(out, "out");
+  Operand X = consume4(xc, "x", -1, 1, Need::kRequired);
+  const std::vector<int64_t> xs = shape4(X);
+  const std::vector<int64_t> os = upsample_shape(xs, scale);
+  Operand Y(to_capsule(out, "out", true), "out", X.ndim(), true);
+  expect_shape(Y, os);
+  const int device = common_device({&X, &Y});
+  expect_disjoint(Y, X);
+  const int64_t rows = prod(xs, 0, xs.size() - 1, "upsample_nearest1d: rows");
+  RetainUntilComplete keep(device, {&X, &Y});  // F01
+  upsample_nearest1d_forward(device, rows, xs.back(), scale, X.data(), Y.data());
+}
+
+py::tuple pad_plan(py::object x, int64_t pb, int64_t pe) {
+  drain_completed();
+  Peek4 X = peek4(x, "x", -1, 1, Need::kRequired);
+  return py::make_tuple(X.capsule, tuple4(pad_shape(X.shape, pb, pe)));
+}
+
+void pad_run(py::object xc, py::object out, int64_t pb, int64_t pe) {
+  drain_completed();
+  require_operand(out, "out");
+  Operand X = consume4(xc, "x", -1, 1, Need::kRequired);
+  const std::vector<int64_t> xs = shape4(X);
+  const std::vector<int64_t> os = pad_shape(xs, pb, pe);
+  Operand Y(to_capsule(out, "out", true), "out", X.ndim(), true);
+  expect_shape(Y, os);
+  const int device = common_device({&X, &Y});
+  expect_disjoint(Y, X);
+  const int64_t rows = prod(xs, 0, xs.size() - 1, "reflection_pad1d: rows");
+  RetainUntilComplete keep(device, {&X, &Y});  // F01
+  reflection_pad1d_forward(device, rows, xs.back(), pb, pe, X.data(), Y.data());
+}
+
+py::tuple rint_plan(py::object x) {
+  drain_completed();
+  Peek4 X = peek4(x, "x", -1, 0, Need::kRequired);
+  return py::make_tuple(X.capsule, tuple4(X.shape));
+}
+
+void rint_run(py::object xc, py::object out) {
+  drain_completed();
+  require_operand(out, "out");
+  Operand X = consume4(xc, "x", -1, 0, Need::kRequired);
+  const std::vector<int64_t> xs = shape4(X);
+  Operand Y(to_capsule(out, "out", true), "out", X.ndim(), true);
+  expect_shape(Y, xs);
+  const int device = common_device({&X, &Y});
+  expect_disjoint(Y, X);
+  RetainUntilComplete keep(device, {&X, &Y});  // F01
+  rint_forward(device, X.numel(), X.data(), Y.data());
+}
+
+// TEST HOOK (P1T-FIX1, F01 regression test only; not part of the API): rint_run whose call then throws AFTER its
+// launch, so the test can witness that a partial-launch exception path keeps the consumed managers alive until the
+// legacy stream has passed the launch (RetainUntilComplete's destructor runs during unwinding). No prior art claimed.
+void test_rint_then_raise(py::object xc, py::object out) {
+  drain_completed();
+  require_operand(out, "out");
+  Operand X = consume4(xc, "x", -1, 0, Need::kRequired);
+  const std::vector<int64_t> xs = shape4(X);
+  Operand Y(to_capsule(out, "out", true), "out", X.ndim(), true);
+  expect_shape(Y, xs);
+  const int device = common_device({&X, &Y});
+  expect_disjoint(Y, X);
+  RetainUntilComplete keep(device, {&X, &Y});
+  rint_forward(device, X.numel(), X.data(), Y.data());
+  throw std::runtime_error("tc_signal._test_rint_then_raise: injected failure after the launch (test hook)");
+}
+
+}  // namespace
+
+void register_m4(py::module_& m) {
+  m.def(
+      "instance_norm1d_plan",
+      [](py::object x, py::object s, py::object b, double eps) { return norm_plan(NormKind::kInstance, x, s, b, 0, eps); },
+      py::arg("x"), py::arg("scale"), py::arg("bias"), py::arg("eps"),
+      "Acquire and peek x/scale/bias; return (x_capsule, scale_capsule|None, bias_capsule|None, out_shape).");
+  m.def(
+      "instance_norm1d_run",
+      [](py::object xc, py::object sc, py::object bc, py::object out, double eps) {
+        norm_run(NormKind::kInstance, xc, sc, bc, out, 0, eps);
+      },
+      py::arg("x_capsule"), py::arg("scale_capsule"), py::arg("bias_capsule"), py::arg("out"), py::arg("eps"),
+      "Consume every operand, validate, launch on the legacy stream, release.");
+  m.def(
+      "layer_norm_plan",
+      [](py::object x, py::object s, py::object b, int64_t axis, double eps) {
+        return norm_plan(NormKind::kLayer, x, s, b, axis, eps);
+      },
+      py::arg("x"), py::arg("scale"), py::arg("bias"), py::arg("axis"), py::arg("eps"),
+      "Acquire and peek x/scale/bias; return (x_capsule, scale_capsule|None, bias_capsule|None, out_shape).");
+  m.def(
+      "layer_norm_run",
+      [](py::object xc, py::object sc, py::object bc, py::object out, int64_t axis, double eps) {
+        norm_run(NormKind::kLayer, xc, sc, bc, out, axis, eps);
+      },
+      py::arg("x_capsule"), py::arg("scale_capsule"), py::arg("bias_capsule"), py::arg("out"), py::arg("axis"),
+      py::arg("eps"), "Consume every operand, validate, launch on the legacy stream, release.");
+  m.def(
+      "group_norm_plan",
+      [](py::object x, int64_t groups, py::object s, py::object b, double eps) {
+        return norm_plan(NormKind::kGroup, x, s, b, groups, eps);
+      },
+      py::arg("x"), py::arg("num_groups"), py::arg("scale"), py::arg("bias"), py::arg("eps"),
+      "Acquire and peek x/scale/bias; return (x_capsule, scale_capsule|None, bias_capsule|None, out_shape).");
+  m.def(
+      "group_norm_run",
+      [](py::object xc, int64_t groups, py::object sc, py::object bc, py::object out, double eps) {
+        norm_run(NormKind::kGroup, xc, sc, bc, out, groups, eps);
+      },
+      py::arg("x_capsule"), py::arg("num_groups"), py::arg("scale_capsule"), py::arg("bias_capsule"), py::arg("out"),
+      py::arg("eps"), "Consume every operand, validate, launch on the legacy stream, release.");
+  m.def("upsample_nearest1d_plan", &upsample_plan, py::arg("x"), py::arg("scale"),
+        "Acquire and peek x; return (x_capsule, out_shape).");
+  m.def("upsample_nearest1d_run", &upsample_run, py::arg("x_capsule"), py::arg("out"), py::arg("scale"),
+        "Consume, validate, launch on the legacy stream, release.");
+  m.def("reflection_pad1d_plan", &pad_plan, py::arg("x"), py::arg("pad_begin"), py::arg("pad_end"),
+        "Acquire and peek x; return (x_capsule, out_shape).");
+  m.def("reflection_pad1d_run", &pad_run, py::arg("x_capsule"), py::arg("out"), py::arg("pad_begin"),
+        py::arg("pad_end"), "Consume, validate, launch on the legacy stream, release.");
+  m.def("rint_plan", &rint_plan, py::arg("x"), "Acquire and peek x; return (x_capsule, out_shape).");
+  m.def("rint_run", &rint_run, py::arg("x_capsule"), py::arg("out"),
+        "Consume, validate, launch on the legacy stream, release.");
+  m.def("_test_rint_then_raise", &test_rint_then_raise, py::arg("x_capsule"), py::arg("out"),
+        "TEST HOOK (P1T-FIX1 F01): rint_run, then raise RuntimeError after the launch.");
+  m.def("m4_tuning", []() {
+    py::dict d;
+    d["norm_block"] = m4tuning::kNormBlock;
+    d["norm_chunk"] = m4tuning::kNormChunk;
+    d["copy_block"] = m4tuning::kCopyBlock;
+    return d;
+  }, "The M4 kernels' tunables (the norm statistics' summation order depends on norm_block and norm_chunk).");
+}
+
+}  // namespace tcs
diff --git a/tc_signal/src/m4_ops.h b/tc_signal/src/m4_ops.h
new file mode 100644
index 0000000..a121c9f
--- /dev/null
+++ b/tc_signal/src/m4_ops.h
@@ -0,0 +1,60 @@
+// P1T-M4 host launchers (T5 norms, T6 small ops) and their tunables. Raw device pointers in, everything queued on the
+// legacy default stream; nothing here allocates device memory (outputs come from the Python layer's allocator).
+//
+// House tunable law: every launch-shape knob of the M4 kernels lives here. None of them changes numerics except
+// kNormBlock and kNormChunk, which fix the summation order of the norm statistics (see norms.cu); changing either one
+// changes the last bits of the statistics (still fp32, still deterministic) and must be re-gated.
+#pragma once
+
+#include <cstdint>
+
+namespace tcs {
+namespace m4tuning {
+
+// Threads per block of the row-norm kernel = the width of its reduction tree (one block per row). Power of two.
+constexpr int kNormBlock = 256;
+// Blocked summation inside a thread: a thread's strided terms are summed kNormChunk at a time into a partial sum, which
+// is then added to the thread total (error bound (kNormChunk + n/kNormChunk) u instead of n u for n terms).
+constexpr int kNormChunk = 32;
+// Threads per block of the gather kernels (upsample, reflection pad) and of rint (one thread per output element).
+constexpr int kCopyBlock = 256;
+
+static_assert(kNormBlock > 0 && (kNormBlock & (kNormBlock - 1)) == 0, "kNormBlock must be a power of two");
+static_assert(kNormChunk > 0, "kNormChunk must be positive");
+
+}  // namespace m4tuning
+
+// Where a row-norm output element finds its scale/bias entry.
+enum class NormAffine : int {
+  kPerRow = 0,      // instance norm: rows are (n, c); entry c = row % channels
+  kPerElem = 1,     // layer norm: entry j (the element's index inside the normalized block)
+  kPerChannel = 2,  // group norm: rows are (n, g); entry (row % groups) * ch_per_group + j / T
+};
+
+// One normalization problem: `rows` contiguous rows of length L, each normalized over itself.
+struct RowNormGeom {
+  int64_t rows;
+  int64_t L;
+  float eps;
+  NormAffine affine;
+  int64_t channels;      // kPerRow: C
+  int64_t groups;        // kPerChannel: G
+  int64_t ch_per_group;  // kPerChannel: C / G
+  int64_t T;             // kPerChannel: time length (elements per channel)
+};
+
+// y = ((x - K) - d) * rstd * scale + bias per row, fp32 shifted two-pass statistics (norms.cu). scale/bias may be NULL.
+void row_norm_forward(int device, const RowNormGeom& g, const float* x, const float* scale, const float* bias,
+                      float* y);
+
+// y[r, i] = x[r, i / scale] for rows r of length T, output length T * scale (bit copy).
+void upsample_nearest1d_forward(int device, int64_t rows, int64_t T, int64_t scale, const float* x, float* y);
+
+// ONNX/torch reflect pad of the last axis by (pad_begin, pad_end), each < T (bit copy).
+void reflection_pad1d_forward(int device, int64_t rows, int64_t T, int64_t pad_begin, int64_t pad_end, const float* x,
+                              float* y);
+
+// y = rintf(x) elementwise (IEEE 754 roundTiesToEven, sign of zero kept, NaN and +-Inf pass through).
+void rint_forward(int device, int64_t n, const float* x, float* y);
+
+}  // namespace tcs
diff --git a/tc_signal/src/norms.cu b/tc_signal/src/norms.cu
new file mode 100644
index 0000000..319badb
--- /dev/null
+++ b/tc_signal/src/norms.cu
@@ -0,0 +1,179 @@
+// tc_signal T5 norms (P1T-M4): InstanceNormalization, LayerNormalization and GroupNormalization-21 as one row-norm
+// kernel. fp32 statistics, biased variance (ONNX), deterministic, no atomic operations, no fast-math flag.
+//
+// Every norm here is "normalize each contiguous row of a C-contiguous tensor over itself, then apply an affine":
+//   instance_norm1d  x [N, C, T]: rows (n, c), L = T,              scale/bias entry c            (NormAffine::kPerRow)
+//   layer_norm       x [d0..dr): rows prod(d0..d_{axis-1}), L = prod(d_axis..), entry j (scale/bias are x.shape[axis:])
+//   group_norm       x [N, C, T]: rows (n, g), L = (C/G) * T,       entry g*(C/G) + j/T (per channel, GroupNorm-21)
+//
+// Statistics, per row, fp32 (shifted two-pass):
+//   K    = x[row, 0]                                   (the shift: any sample of the row)
+//   d    = (sum_j (x_j - K)) / L                       (pass 1: the mean of the shifted row)
+//   var  = (sum_j ((x_j - K) - d)^2) / L               (pass 2: the centred sum of squares, biased)
+//   rstd = 1.0f / sqrtf(var + eps)                     (math-library sqrtf, IEEE-rounded; IEEE division)
+//   y_j  = fmaf(((x_j - K) - d) * rstd, scale, bias)   (pass 3)
+// Why the shift: the row mean itself is never formed in fp32. On a row with mean 1e4 and std 1e-2 (the order's
+// large-offset cell) the fp32 mean is off by up to half an ulp of 1e4 = 4.9e-4 = 0.05 std, which shifts every output
+// by 0.05 and fails the 1e-5 gate whatever the summation order (receipt: artifacts/p1t_m4/sim_large_offset.txt).
+// With the shift, x_j - K is exact on such rows (Sterbenz lemma: x_j and K within a factor 2), d is a small number
+// computed to full relative precision, and the output error scales with the row's spread, not with its offset.
+//
+// Reduction order (fixed, so two calls are bitwise equal): one block per row (grid-stride over rows), kNormBlock
+// threads. Thread t sums its terms j = t, t + B, t + 2B, ... in ascending order, kNormChunk terms at a time into a partial
+// sum that is then added to the thread total (blocked summation), and the B thread totals are combined by a fixed
+// shared-memory tree (pairs at stride B/2, B/4, ..., 1). The order depends only on L, kNormBlock and kNormChunk.
+//
+// rstd choice: 1.0f / sqrtf(v) is two correctly rounded operations (<= ~1 ulp, ~1.2e-7 relative), 80x under the
+// order's 1e-5 normwise gate. rsqrtf (<= 2 ulp per the CUDA math documentation) would also pass; the IEEE pair is used
+// because the package's fast-math canary (tests/test_contract.py) already witnesses IEEE division and no flushing.
+//
+// Prior art:
+//  * Instance normalization: Ulyanov, Vedaldi & Lempitsky, "Instance Normalization: The Missing Ingredient for Fast
+//    Stylization" (2016). Layer normalization: Ba, Kiros & Hinton, "Layer Normalization" (2016). Group normalization:
+//    Wu & He, "Group Normalization" (2018). Semantics: ONNX InstanceNormalization, LayerNormalization (axis, epsilon,
+//    biased variance), GroupNormalization-21 (per-channel scale/bias, as torch.nn.GroupNorm). Taken: the definitions.
+//  * Variance algorithms: Welford (1962) for one-pass updating; Chan, Golub & LeVeque, "Algorithms for computing the
+//    sample variance: analysis and recommendations" (1983) for the two-pass algorithm, its error analysis and the
+//    "shifted data" variant (shift by an estimate of the mean, e.g. the first sample); Knuth, TAOCP vol. 2 §4.2.2.
+//    Taken: two-pass with a shift by the first sample. Ours: the CUDA mapping (one block per row, three passes over
+//    global memory, the shift broadcast from x[row, 0]).
+//  * Blocked (chunked) summation and its error bound: Higham, "Accuracy and Stability of Numerical Algorithms" (2nd ed.,
+//    2002), §4 (summation); Castaldo, Whaley & Chronopoulos, "Reducing floating point error in dot product using the
+//    superblock family of algorithms" (2008). Taken: the bound. Ours: the chunk size and its place inside a strided
+//    thread loop ahead of a fixed tree.
+//  * Deterministic shared-memory tree reduction: the standard CUDA reduction pattern (Harris, "Optimizing Parallel
+//    Reduction in CUDA", NVIDIA 2007). Taken: the tree. Ours: nothing beyond fixing B.
+//  Unverified in this sandbox (lead to check): exact titles/years above; search terms "Chan Golub LeVeque 1983 sample
+//  variance shifted", "Welford 1962 corrected sums of squares", "Castaldo Whaley superblock 2008".
+#include <cuda_runtime.h>
+
+#include <algorithm>
+#include <sstream>
+#include <stdexcept>
+#include <string>
+
+#include "m4_ops.h"
+#include "tuning.h"
+
+#ifdef CUDA_API_PER_THREAD_DEFAULT_STREAM
+#error "tc_signal queues on the legacy default stream (stream 0); do not build it with --default-stream per-thread"
+#endif
+
+namespace tcs {
+
+namespace {
+
+constexpr cudaStream_t kLegacyStream = 0;  // the legacy default stream (TensorCUDA's only stream)
+
+void check_cuda(cudaError_t e, const char* what) {
+  if (e != cudaSuccess) {
+    std::ostringstream os;
+    os << "tc_signal: " << what << " failed: " << cudaGetErrorName(e) << ": " << cudaGetErrorString(e);
+    throw std::runtime_error(os.str());
+  }
+}
+
+// Makes `device` current for the call and restores the caller's device afterwards.
+class DeviceGuard {
+ public:
+  explicit DeviceGuard(int device) {
+    check_cuda(cudaGetDevice(&prev_), "cudaGetDevice");
+    if (prev_ != device) {
+      check_cuda(cudaSetDevice(device), "cudaSetDevice");
+      changed_ = true;
+    }
+  }
+  ~DeviceGuard() {
+    if (changed_) cudaSetDevice(prev_);
+  }
+  DeviceGuard(const DeviceGuard&) = delete;
+  DeviceGuard& operator=(const DeviceGuard&) = delete;
+
+ private:
+  int prev_ = 0;
+  bool changed_ = false;
+};
+
+// Sum of every thread's `v` over the block, by a fixed tree (stride B/2, B/4, ..., 1); every thread gets the total.
+template <int B>
+__device__ __forceinline__ float block_tree_sum(float v, float* red) {
+  red[threadIdx.x] = v;
+  __syncthreads();
+#pragma unroll
+  for (int s = B / 2; s > 0; s >>= 1) {
+    if (static_cast<int>(threadIdx.x) < s) red[threadIdx.x] = red[threadIdx.x] + red[threadIdx.x + s];
+    __syncthreads();
+  }
+  const float total = red[0];
+  __syncthreads();  // every thread has read red[0] before the next call overwrites red
+  return total;
+}
+
+template <int B>
+__global__ void __launch_bounds__(B) row_norm_kernel(const float* __restrict__ x, const float* __restrict__ scale,
+                                                     const float* __restrict__ bias, float* __restrict__ y,
+                                                     int64_t rows, int64_t L, float eps, int affine, int64_t channels,
+                                                     int64_t groups, int64_t ch_per_group, int64_t T) {
+  __shared__ float red[B];
+  const int64_t tid = threadIdx.x;
+  const int64_t chunk_span = static_cast<int64_t>(B) * m4tuning::kNormChunk;
+  const float Lf = static_cast<float>(L);  // exact for L < 2^24
+  for (int64_t row = blockIdx.x; row < rows; row += gridDim.x) {
+    const float* __restrict__ xr = x + row * L;
+    float* __restrict__ yr = y + row * L;
+    const float K = xr[0];
+
+    // Pass 1: the mean of the shifted row.
+    float acc = 0.0f;
+    for (int64_t base = tid; base < L; base += chunk_span) {
+      const int64_t end = min(L, base + chunk_span);
+      float part = 0.0f;
+      for (int64_t j = base; j < end; j += B) part = part + (xr[j] - K);
+      acc = acc + part;
+    }
+    const float d = block_tree_sum<B>(acc, red) / Lf;
+
+    // Pass 2: the centred sum of squares (biased variance).
+    acc = 0.0f;
+    for (int64_t base = tid; base < L; base += chunk_span) {
+      const int64_t end = min(L, base + chunk_span);
+      float part = 0.0f;
+      for (int64_t j = base; j < end; j += B) {
+        const float c = (xr[j] - K) - d;
+        part = fmaf(c, c, part);
+      }
+      acc = acc + part;
+    }
+    const float var = block_tree_sum<B>(acc, red) / Lf;
+    const float rstd = 1.0f / sqrtf(var + eps);
+
+    // Pass 3: normalize and apply the affine.
+    for (int64_t j = tid; j < L; j += B) {
+      const float c = (xr[j] - K) - d;
+      int64_t p;
+      if (affine == static_cast<int>(NormAffine::kPerRow))
+        p = row % channels;
+      else if (affine == static_cast<int>(NormAffine::kPerElem))
+        p = j;
+      else
+        p = (row % groups) * ch_per_group + j / T;
+      const float s = scale != nullptr ? scale[p] : 1.0f;
+      const float b = bias != nullptr ? bias[p] : 0.0f;
+      yr[j] = fmaf(c * rstd, s, b);
+    }
+  }
+}
+
+}  // namespace
+
+void row_norm_forward(int device, const RowNormGeom& g, const float* x, const float* scale, const float* bias,
+                      float* y) {
+  DeviceGuard guard(device);
+  constexpr int B = m4tuning::kNormBlock;
+  const unsigned int grid = static_cast<unsigned int>(std::max<int64_t>(1, std::min<int64_t>(g.rows, tuning::kGridCap)));
+  row_norm_kernel<B><<<grid, B, 0, kLegacyStream>>>(x, scale, bias, y, g.rows, g.L, g.eps, static_cast<int>(g.affine),
+                                                    g.channels, g.groups, g.ch_per_group, g.T);
+  check_cuda(cudaGetLastError(), "row_norm_kernel");
+}
+
+}  // namespace tcs
diff --git a/tc_signal/src/small_ops.cu b/tc_signal/src/small_ops.cu
new file mode 100644
index 0000000..8b2ae18
--- /dev/null
+++ b/tc_signal/src/small_ops.cu
@@ -0,0 +1,138 @@
+// tc_signal T6 small ops (P1T-M4): nearest upsample x k (1-D), reflection pad (1-D), rint. Bit-exact by construction:
+// the two gathers move 32-bit words (one load and one store per output element, through unsigned-integer pointers, so
+// NaN payloads, signed zeros and subnormals are copied bit for bit), and rint is the math library's rintf (IEEE 754
+// roundTiesToEven in the default rounding mode, sign of zero kept, NaN and +-Inf pass through). No fast-math flag, no
+// atomic operations: each output element is written by exactly one thread. TensorCUDA core's `round` (half away from
+// zero, used by its quantizers) is untouched; rint is a new op here.
+//
+// Semantics (the shipped Kokoro nodes):
+//  * upsample_nearest1d: ONNX Resize mode=nearest, coordinate_transformation_mode=asymmetric, nearest_mode=floor,
+//    scales [1, ..., 1, s] with s an integer >= 1: y[..., i] = x[..., floor(i / s)], i in [0, T*s). Integer division is
+//    the floor for these non-negative operands, so no float coordinate is ever formed.
+//  * reflection_pad1d: ONNX Pad mode=reflect on the last axis (= torch reflection_pad1d): with s = i - pad_begin,
+//    y[..., i] = x[..., |s|] for s < 0, x[..., 2(T-1) - s] for s >= T, else x[..., s]. pad_begin, pad_end < T.
+//  * rint: ONNX Round (half to even).
+//
+// Prior art: ONNX operator specs (Resize, Pad, Round); IEEE 754-2008 roundTiesToEven / C99 rint; torch's
+// reflection_pad1d and nearest upsample for the same index maps. Ours: nothing beyond the one-thread-per-output CUDA
+// mapping (no prior art known to me for anything else here).
+#include <cuda_runtime.h>
+
+#include <algorithm>
+#include <cstdint>
+#include <sstream>
+#include <stdexcept>
+#include <string>
+
+#include "m4_ops.h"
+#include "tuning.h"
+
+#ifdef CUDA_API_PER_THREAD_DEFAULT_STREAM
+#error "tc_signal queues on the legacy default stream (stream 0); do not build it with --default-stream per-thread"
+#endif
+
+namespace tcs {
+
+namespace {
+
+constexpr cudaStream_t kLegacyStream = 0;  // the legacy default stream (TensorCUDA's only stream)
+
+void check_cuda(cudaError_t e, const char* what) {
+  if (e != cudaSuccess) {
+    std::ostringstream os;
+    os << "tc_signal: " << what << " failed: " << cudaGetErrorName(e) << ": " << cudaGetErrorString(e);
+    throw std::runtime_error(os.str());
+  }
+}
+
+unsigned int grid_for(int64_t total, int block) {
+  const int64_t blocks = (total + block - 1) / block;
+  return static_cast<unsigned int>(std::max<int64_t>(1, std::min<int64_t>(blocks, tuning::kGridCap)));
+}
+
+// Makes `device` current for the call and restores the caller's device afterwards.
+class DeviceGuard {
+ public:
+  explicit DeviceGuard(int device) {
+    check_cuda(cudaGetDevice(&prev_), "cudaGetDevice");
+    if (prev_ != device) {
+      check_cuda(cudaSetDevice(device), "cudaSetDevice");
+      changed_ = true;
+    }
+  }
+  ~DeviceGuard() {
+    if (changed_) cudaSetDevice(prev_);
+  }
+  DeviceGuard(const DeviceGuard&) = delete;
+  DeviceGuard& operator=(const DeviceGuard&) = delete;
+
+ private:
+  int prev_ = 0;
+  bool changed_ = false;
+};
+
+// y[r, i] = x[r, i / scale]: one thread per output element, a 32-bit word copy.
+__global__ void upsample_nearest1d_kernel(const uint32_t* __restrict__ x, uint32_t* __restrict__ y, int64_t total,
+                                          int64_t T, int64_t T_out, int64_t scale) {
+  for (int64_t i = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; i < total;
+       i += static_cast<int64_t>(gridDim.x) * blockDim.x) {
+    const int64_t t = i % T_out;
+    const int64_t r = i / T_out;
+    y[i] = x[r * T + t / scale];
+  }
+}
+
+// Reflect pad of the last axis: one thread per output element, a 32-bit word copy.
+__global__ void reflection_pad1d_kernel(const uint32_t* __restrict__ x, uint32_t* __restrict__ y, int64_t total,
+                                        int64_t T, int64_t T_out, int64_t pad_begin) {
+  for (int64_t i = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; i < total;
+       i += static_cast<int64_t>(gridDim.x) * blockDim.x) {
+    const int64_t t = i % T_out;
+    const int64_t r = i / T_out;
+    int64_t s = t - pad_begin;
+    if (s < 0)
+      s = -s;
+    else if (s >= T)
+      s = 2 * (T - 1) - s;
+    y[i] = x[r * T + s];
+  }
+}
+
+// y = rintf(x): round half to even (the default rounding mode), sign of zero kept, NaN/Inf pass through.
+__global__ void rint_kernel(const float* __restrict__ x, float* __restrict__ y, int64_t n) {
+  for (int64_t i = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; i < n;
+       i += static_cast<int64_t>(gridDim.x) * blockDim.x)
+    y[i] = rintf(x[i]);
+}
+
+}  // namespace
+
+void upsample_nearest1d_forward(int device, int64_t rows, int64_t T, int64_t scale, const float* x, float* y) {
+  DeviceGuard guard(device);
+  const int64_t T_out = T * scale;
+  const int64_t total = rows * T_out;
+  constexpr int B = m4tuning::kCopyBlock;
+  upsample_nearest1d_kernel<<<grid_for(total, B), B, 0, kLegacyStream>>>(
+      reinterpret_cast<const uint32_t*>(x), reinterpret_cast<uint32_t*>(y), total, T, T_out, scale);
+  check_cuda(cudaGetLastError(), "upsample_nearest1d_kernel");
+}
+
+void reflection_pad1d_forward(int device, int64_t rows, int64_t T, int64_t pad_begin, int64_t pad_end, const float* x,
+                              float* y) {
+  DeviceGuard guard(device);
+  const int64_t T_out = T + pad_begin + pad_end;
+  const int64_t total = rows * T_out;
+  constexpr int B = m4tuning::kCopyBlock;
+  reflection_pad1d_kernel<<<grid_for(total, B), B, 0, kLegacyStream>>>(
+      reinterpret_cast<const uint32_t*>(x), reinterpret_cast<uint32_t*>(y), total, T, T_out, pad_begin);
+  check_cuda(cudaGetLastError(), "reflection_pad1d_kernel");
+}
+
+void rint_forward(int device, int64_t n, const float* x, float* y) {
+  DeviceGuard guard(device);
+  constexpr int B = m4tuning::kCopyBlock;
+  rint_kernel<<<grid_for(n, B), B, 0, kLegacyStream>>>(x, y, n);
+  check_cuda(cudaGetLastError(), "rint_kernel");
+}
+
+}  // namespace tcs
diff --git a/tc_signal/src/tuning.h b/tc_signal/src/tuning.h
new file mode 100644
index 0000000..29bce66
--- /dev/null
+++ b/tc_signal/src/tuning.h
@@ -0,0 +1,41 @@
+// tc_signal kernel tunables. House tunable law: no launch-shape literals at the use sites; every knob lives here.
+// None of these changes numerics: each output element's summation order is fixed by the kernel code, not by the
+// launch shape (grid-stride loops; one thread owns one output element). Changing a knob changes speed only.
+#pragma once
+
+namespace tcs {
+namespace tuning {
+
+// Threads per block for the 1-D im2col kernel (one thread per col element).
+constexpr int kIm2colBlock = 256;
+// Threads per block for the bias-add kernel (one thread per output element).
+constexpr int kBiasBlock = 256;
+// Threads per block for the gather-form ConvTranspose1d kernel (one thread per output element).
+constexpr int kConvTransposeBlock = 256;
+// Threads per block for the fp32 division canary kernel (fast-math probe; tests only).
+constexpr int kProbeBlock = 256;
+// Upper bound on blocks per launch; the kernels are grid-stride loops, so larger problems loop instead.
+constexpr long long kGridCap = 1LL << 20;
+
+// DLPack version this consumer asks producers for (`__dlpack__(max_version=...)`); the vendored header is v1.3.
+constexpr int kDlpackMaxMajor = 1;
+constexpr int kDlpackMaxMinor = 3;
+// DLPack stream argument for the consumer stream: 1 = the legacy default stream (Python array API convention).
+constexpr int kDlpackLegacyStream = 1;
+
+// P1T-FIX1 (F01) deferred release: bounds of the pending list of consumed DLPack managers that wait for the legacy
+// stream to pass their call (dlpack_operand.h, RetainUntilComplete). When a new entry pushes the list past either
+// bound, tc_signal synchronizes the legacy stream of every pending device and releases the whole list. These only
+// trade memory held (by producers' blocks waiting for release) against how often a call blocks; numerics never change.
+// Entries: one per tc_signal call that reached its launch.
+constexpr long long kPendingMaxEntries = 1024;
+// Bytes: the sum of the fp32 operand sizes held by the pending entries (inputs, outputs and scratch).
+constexpr long long kPendingMaxBytes = 256LL << 20;
+// P1T-FIX2 (N3): fixed capacities of the allocation-free bookkeeping in synchronize/the bound drain. Devices whose sync
+// result is remembered per call (a device beyond this is still synchronized; its failure is kept as one conservative
+// flag), and CUDA failures named in one synchronize() error message (the rest are counted). Neither changes numerics.
+constexpr int kSyncMaxDevices = 64;
+constexpr int kSyncReportMax = 8;
+
+}  // namespace tuning
+}  // namespace tcs
diff --git a/tc_signal/tc_signal/__init__.py b/tc_signal/tc_signal/__init__.py
