+res['delta'] = delta(s0, dict(_C.pending_stats()))
+res['unknown_delete'] = P.STATS['unknown_delete']
+res['deleted'] = P.STATS['deleted']
+print('RESULT ' + json.dumps(res), flush=True)
+'''.replace('LONG', str(LONG_SLEEP_CYCLES))
