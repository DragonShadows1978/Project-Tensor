+    res['unreported_after_call'] = _C.pending_stats()['unreported_release_errors']
+    res['deleted_after_call'] = P.STATS['deleted']
+    try:
+        ts.synchronize()
+        res['raised'] = False
+    except RuntimeError as e:
+        res['raised'], res['msg'] = True, str(e)
