+# ------------------------------------------------------------------------------------------------ refusals
+def _t(*shape):
+    return torch.randn(*shape, device='cuda')
+
+
+def _overlap(fn, out_len):
+    def call():
+        st = torch.zeros(4000, device='cuda')
+        x = st[:2 * 4 * 10].view(2, 4, 10)
+        out = st[10:10 + 2 * 4 * out_len].view(2, 4, out_len)
+        return fn(x, out)
+    return call
+
