+def test_zero_size_tensors(torch):
+    x = torch.from_dlpack(tc.empty(0))
+    assert tuple(x.shape) == (0,)
+    u = tc.from_dlpack(torch.zeros(0, 3, device="cuda"))
+    assert tuple(u.shape) == (0, 3) and u.numpy().shape == (0, 3)
