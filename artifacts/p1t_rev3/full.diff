+// _tc_signal: the C++ half of the tc_signal add-on (P1T-M2). Every operand, outputs and scratch included, is a DLPack
+// producer or capsule; this module allocates no device memory (the Python layer allocates outputs and the im2col
+// scratch through tc_signal's allocator and passes them in).
+//
+// Two calls per op, so the Python layer can size and allocate before anything is consumed:
+//   *_plan(x, w, b, attrs)  -> acquires the input capsules (__dlpack__(stream=1)), PEEKS their DLTensors (validates
+//                              device/dtype/layout/shapes/attributes without consuming), and returns
+//                              (x_capsule, w_capsule, b_capsule|None, out_shape[, scratch_numel]);
+//   *_run(capsules, out[, scratch], attrs) -> consumes every capsule, re-validates, checks devices and overlap,
+//                              launches on the legacy default stream, then hands every consumed manager to the
+//                              deferred-release list (P1T-FIX1 F01, dlpack_operand.h RetainUntilComplete): the producer
+//                              deleters run once the legacy stream has passed the launches, never before.
+// P1T-FIX1 also adds: F02 (a required operand passed as None -> TypeError before planning), F03 (every size below is
+// computed with checked arithmetic, checked_math.h), and drain_completed() first thing in every entry point.
+//
+// Prior art: see dlpack_operand.h (DLPack, Python array API stream protocol) and conv.cu (im2col, gather-form
+// ConvTranspose, ONNX semantics). The plan/run split is ours (no prior art known to me for this exact split; it is the
+// ordinary "query workspace size, then execute" pattern of cuDNN/cuBLASLt workspace APIs applied to DLPack operands).
+#include <pybind11/pybind11.h>
+#include <pybind11/stl.h>
+
+#include <algorithm>
+#include <climits>
+#include <sstream>
+#include <string>
+#include <vector>
+
+#include "checked_math.h"
+#include "conv_ops.h"
+#include "dlpack_operand.h"
+#include "tuning.h"
+
+namespace py = pybind11;
+
+namespace tcs {
+namespace {
+
+[[noreturn]] void bad_attr(const std::string& msg) { throw py::value_error("tc_signal: " + msg); }
+
+void check_attr(const char* name, int64_t v, int64_t lo) {
+  if (v < lo || v > INT_MAX) {
+    std::ostringstream os;
+    os << name << " must be in [" << lo << ", " << INT_MAX << "], got " << v;
+    bad_attr(os.str());
+  }
+}
+
+void check_int_range(const char* what, int64_t v) {
+  if (v > INT_MAX) {
+    std::ostringstream os;
+    os << what << " (" << v << ") exceeds the 32-bit range cuBLAS takes";
+    bad_attr(os.str());
+  }
+}
+
+// ------------------------------------------------------------------------------------------------ Conv1d plan
+struct Conv1dPlan {
+  Conv1dGeom g;
+  std::vector<int64_t> out_shape;
+  int64_t scratch_numel;
+};
+
+Conv1dPlan plan_conv1d(const std::vector<int64_t>& xs, const std::vector<int64_t>& ws, const std::vector<int64_t>* bs,
+                       int64_t stride, int64_t pb, int64_t pe, int64_t dilation, int64_t groups) {
+  check_attr("stride", stride, 1);
+  check_attr("dilation", dilation, 1);
+  check_attr("groups", groups, 1);
+  check_attr("pad_begin", pb, 0);
+  check_attr("pad_end", pe, 0);
+  Conv1dPlan p{};
+  Conv1dGeom& g = p.g;
+  g.N = xs[0];
+  g.C_in = xs[1];
+  g.T = xs[2];
+  g.C_out = ws[0];
+  g.K = ws[2];
+  g.stride = stride;
+  g.pad_begin = pb;
+  g.pad_end = pe;
+  g.dilation = dilation;
+  g.groups = groups;
+  std::ostringstream os;
+  if (g.C_in % groups != 0) {
+    os << "conv1d: C_in (" << g.C_in << ") is not divisible by groups (" << groups << ")";
+    bad_attr(os.str());
+  }
+  if (ws[1] != g.C_in / groups) {
+    os << "conv1d: w.shape[1] (" << ws[1] << ") != C_in/groups (" << g.C_in / groups << "); w is [C_out, C_in/groups, K]";
+    bad_attr(os.str());
+  }
+  if (g.C_out % groups != 0) {
+    os << "conv1d: C_out (" << g.C_out << ") is not divisible by groups (" << groups << ")";
+    bad_attr(os.str());
+  }
+  if (bs != nullptr && (bs->size() != 1 || (*bs)[0] != g.C_out)) {
+    os << "conv1d: b has shape " << shape_str(*bs) << ", expected [" << g.C_out << "]";
+    bad_attr(os.str());
+  }
+  // Integer arithmetic in int64, every step checked (F03: dimensions may come from synthetic descriptors). Python's
+  // floor division and C++'s truncation differ for a negative numerator, so the sign is checked first.
+  const int64_t dk = ck_mul(dilation, g.K - 1, "conv1d: dilation*(K-1)");
+  int64_t num = ck_add(g.T, pb, "conv1d: T + pad_begin");
+  num = ck_add(num, pe, "conv1d: T + pad_begin + pad_end");
+  num = ck_sub(num, dk, "conv1d: output length numerator");
+  num = ck_sub(num, 1, "conv1d: output length numerator");
+  if (num < 0) {
+    os << "conv1d: output length (T + pb + pe - dilation*(K-1) - 1)//stride + 1 = (" << g.T << " + " << pb << " + "
+       << pe << " - " << dilation << "*" << (g.K - 1) << " - 1)//" << stride << " + 1 is <= 0";
+    bad_attr(os.str());
+  }
+  g.T_out = num / stride + 1;
+  g.direct = (g.K == 1 && stride == 1 && pb == 0 && pe == 0);
+  const int64_t Og = g.C_out / groups;
+  const int64_t CgK = (g.C_in / groups) * g.K;
+  check_int_range("T_out", g.T_out);
+  check_int_range("C_out/groups", Og);
+  check_int_range("C_in/groups*K", CgK);
+  p.out_shape = {g.N, g.C_out, g.T_out};
+  ck_shape_numel(p.out_shape, "conv1d: output size N*C_out*T_out");
+  p.scratch_numel =
+      g.direct ? 0 : ck_mul(ck_mul(g.C_in, g.K, "conv1d: im2col rows C_in*K"), g.T_out, "conv1d: im2col scratch size");
+  ck_fp32_bytes(p.scratch_numel, "conv1d: im2col scratch bytes");
+  return p;
+}
+
+// ------------------------------------------------------------------------------------------------ ConvTranspose1d plan
+struct ConvTranspose1dPlan {
+  ConvTranspose1dGeom g;
+  std::vector<int64_t> out_shape;
+};
+
+ConvTranspose1dPlan plan_conv_transpose1d(const std::vector<int64_t>& xs, const std::vector<int64_t>& ws,
+                                          const std::vector<int64_t>* bs, int64_t stride, int64_t pb, int64_t pe,
+                                          int64_t output_padding, int64_t dilation, int64_t groups) {
+  check_attr("stride", stride, 1);
+  check_attr("dilation", dilation, 1);
+  check_attr("groups", groups, 1);
+  check_attr("pad_begin", pb, 0);
+  check_attr("pad_end", pe, 0);
+  check_attr("output_padding", output_padding, 0);
+  std::ostringstream os;
+  if (output_padding >= std::max(stride, dilation)) {
+    os << "conv_transpose1d: output_padding (" << output_padding << ") must be < max(stride, dilation) ("
+       << std::max(stride, dilation) << ")";
+    bad_attr(os.str());
+  }
+  ConvTranspose1dPlan p{};
+  ConvTranspose1dGeom& g = p.g;
+  g.N = xs[0];
+  g.C_in = xs[1];
+  g.T = xs[2];
+  g.K = ws[2];
+  g.stride = stride;
+  g.pad_begin = pb;
+  g.pad_end = pe;
+  g.output_padding = output_padding;
+  g.dilation = dilation;
+  g.groups = groups;
+  if (ws[0] != g.C_in) {
+    os << "conv_transpose1d: w.shape[0] (" << ws[0] << ") != C_in (" << g.C_in
+       << "); w is [C_in, C_out/groups, K] (ONNX layout)";
+    bad_attr(os.str());
+  }
+  if (g.C_in % groups != 0) {
+    os << "conv_transpose1d: C_in (" << g.C_in << ") is not divisible by groups (" << groups << ")";
+    bad_attr(os.str());
+  }
+  g.C_out = ck_mul(ws[1], groups, "conv_transpose1d: C_out = w.shape[1]*groups");
+  if (bs != nullptr && (bs->size() != 1 || (*bs)[0] != g.C_out)) {
+    os << "conv_transpose1d: b has shape " << shape_str(*bs) << ", expected [" << g.C_out << "]";
+    bad_attr(os.str());
+  }
+  // F03: every step checked.
+  int64_t t_out = ck_mul(stride, g.T - 1, "conv_transpose1d: stride*(T-1)");
+  t_out = ck_add(t_out, output_padding, "conv_transpose1d: output length");
+  t_out = ck_add(t_out, ck_mul(dilation, g.K - 1, "conv_transpose1d: dilation*(K-1)"), "conv_transpose1d: output length");
+  t_out = ck_add(t_out, 1, "conv_transpose1d: output length");
+  t_out = ck_sub(t_out, pb, "conv_transpose1d: output length");
+  g.T_out = ck_sub(t_out, pe, "conv_transpose1d: output length");
+  if (g.T_out <= 0) {
+    os << "conv_transpose1d: output length stride*(T-1) + output_padding + dilation*(K-1) + 1 - pb - pe = "
+       << g.T_out << " is <= 0";
+    bad_attr(os.str());
+  }
+  p.out_shape = {g.N, g.C_out, g.T_out};
+  ck_shape_numel(p.out_shape, "conv_transpose1d: output size N*C_out*T_out");
+  return p;
+}
+
+// ------------------------------------------------------------------------------------------------ peek helpers
+struct Peeked {
+  py::object capsule;            // None for an absent optional operand
+  std::vector<int64_t> shape;
+  int device = -1;
+};
+
+Peeked peek_operand(py::handle obj, const char* role, int ndim) {
+  Peeked p;
+  require_operand(obj, role);
+  p.capsule = to_capsule(obj, role, false);
+  const DLTensor* t = peek(p.capsule, role);
+  validate_tensor(t, role, ndim);
+  p.shape = shape_of(t);
+  p.device = t->device.device_id;
+  return p;
+}
+
+void same_device_peeked(const std::vector<const Peeked*>& ps, const std::vector<const char*>& roles) {
+  int dev = -1;
+  const char* first = "";
+  for (size_t i = 0; i < ps.size(); ++i) {
+    if (ps[i] == nullptr) continue;
+    if (dev < 0) {
+      dev = ps[i]->device;
+      first = roles[i];
+    } else if (ps[i]->device != dev) {
+      std::ostringstream os;
+      os << "tc_signal: operand '" << roles[i] << "': on CUDA device " << ps[i]->device << " but operand '" << first
+         << "' is on CUDA device " << dev << "; every operand must be on the same device";
+      throw py::value_error(os.str());
+    }
+  }
+}
+
+std::vector<int64_t> op_shape(const Operand& op) {
+  std::vector<int64_t> s(op.ndim());
+  for (int i = 0; i < op.ndim(); ++i) s[i] = op.dim(i);
+  return s;
+}
+
+py::tuple to_tuple(const std::vector<int64_t>& v) {
+  py::tuple t(v.size());
+  for (size_t i = 0; i < v.size(); ++i) t[i] = py::int_(v[i]);
+  return t;
+}
+
+// ------------------------------------------------------------------------------------------------ Conv1d entry points
+py::tuple conv1d_plan(py::object x, py::object w, py::object b, int64_t stride, int64_t pb, int64_t pe,
+                      int64_t dilation, int64_t groups) {
+  drain_completed();
+  require_operand(x, "x");
+  require_operand(w, "w");
+  Peeked X = peek_operand(x, "x", 3);
+  Peeked W = peek_operand(w, "w", 3);
+  Peeked B;
+  const bool has_b = !b.is_none();
+  if (has_b) B = peek_operand(b, "b", 1);
+  same_device_peeked({&X, &W, has_b ? &B : nullptr}, {"x", "w", "b"});
+  Conv1dPlan p = plan_conv1d(X.shape, W.shape, has_b ? &B.shape : nullptr, stride, pb, pe, dilation, groups);
+  return py::make_tuple(X.capsule, W.capsule, has_b ? B.capsule : py::none(), to_tuple(p.out_shape),
+                        py::int_(p.scratch_numel));
+}
+
+void conv1d_run(py::object xc, py::object wc, py::object bc, py::object out, py::object scratch, int64_t stride,
+                int64_t pb, int64_t pe, int64_t dilation, int64_t groups) {
+  drain_completed();
+  require_operand(xc, "x");
+  require_operand(wc, "w");
+  require_operand(out, "out");
+  Operand X(xc, "x", 3, false);
+  Operand W(wc, "w", 3, false);
+  Operand B;
+  if (!bc.is_none()) B = Operand(bc, "b", 1, false);
+  std::vector<int64_t> bshape;
+  if (B.present()) bshape = op_shape(B);
+  const std::vector<int64_t> xshape = op_shape(X);
+  const std::vector<int64_t> wshape = op_shape(W);
+  Conv1dPlan p = plan_conv1d(xshape, wshape, B.present() ? &bshape : nullptr, stride, pb, pe, dilation, groups);
+  Operand Y(to_capsule(out, "out", true), "out", 3, true);
+  expect_shape(Y, p.out_shape);
+  Operand S;
+  if (p.scratch_numel > 0) {
+    if (scratch.is_none()) bad_attr("conv1d: this call needs an im2col scratch operand and none was passed");
+    S = Operand(to_capsule(scratch, "scratch", true), "scratch", 1, true);
+    expect_shape(S, {p.scratch_numel});
+  } else if (!scratch.is_none()) {
+    bad_attr("conv1d: this call needs no scratch (K == 1, stride 1, no pads) but one was passed");
+  }
+  const int device = common_device({&X, &W, &B, &Y, &S});
+  for (const Operand* in : {&X, &W, &B, &S}) expect_disjoint(Y, *in);
+  for (const Operand* in : {&X, &W, &B}) expect_disjoint(S, *in);
+  // F01: every consumed manager stays alive until the legacy stream has passed these launches (also when a launch
+  // throws part-way); the producer deleters run later, from drain_completed / synchronize / atexit.
+  RetainUntilComplete keep(device, {&X, &W, &B, &Y, &S});
+  conv1d_forward(device, p.g, X.data(), W.data(), B.present() ? B.data() : nullptr, Y.data(),
+                 S.present() ? S.data() : nullptr);
+}
+
+// ------------------------------------------------------------------------------------------------ ConvTranspose1d entry points
+py::tuple conv_transpose1d_plan(py::object x, py::object w, py::object b, int64_t stride, int64_t pb, int64_t pe,
+                                int64_t output_padding, int64_t dilation, int64_t groups) {
+  drain_completed();
+  require_operand(x, "x");
+  require_operand(w, "w");
+  Peeked X = peek_operand(x, "x", 3);
+  Peeked W = peek_operand(w, "w", 3);
+  Peeked B;
+  const bool has_b = !b.is_none();
+  if (has_b) B = peek_operand(b, "b", 1);
+  same_device_peeked({&X, &W, has_b ? &B : nullptr}, {"x", "w", "b"});
+  ConvTranspose1dPlan p = plan_conv_transpose1d(X.shape, W.shape, has_b ? &B.shape : nullptr, stride, pb, pe,
+                                                output_padding, dilation, groups);
+  return py::make_tuple(X.capsule, W.capsule, has_b ? B.capsule : py::none(), to_tuple(p.out_shape));
+}
+
+void conv_transpose1d_run(py::object xc, py::object wc, py::object bc, py::object out, int64_t stride, int64_t pb,
+                          int64_t pe, int64_t output_padding, int64_t dilation, int64_t groups) {
+  drain_completed();
+  require_operand(xc, "x");
+  require_operand(wc, "w");
+  require_operand(out, "out");
+  Operand X(xc, "x", 3, false);
+  Operand W(wc, "w", 3, false);
+  Operand B;
+  if (!bc.is_none()) B = Operand(bc, "b", 1, false);
+  std::vector<int64_t> bshape;
+  if (B.present()) bshape = op_shape(B);
+  const std::vector<int64_t> xshape = op_shape(X);
+  const std::vector<int64_t> wshape = op_shape(W);
+  ConvTranspose1dPlan p = plan_conv_transpose1d(xshape, wshape, B.present() ? &bshape : nullptr, stride, pb, pe,
+                                                output_padding, dilation, groups);
+  Operand Y(to_capsule(out, "out", true), "out", 3, true);
+  expect_shape(Y, p.out_shape);
+  const int device = common_device({&X, &W, &B, &Y});
+  for (const Operand* in : {&X, &W, &B}) expect_disjoint(Y, *in);
+  RetainUntilComplete keep(device, {&X, &W, &B, &Y});  // F01 (see conv1d_run)
+  conv_transpose1d_forward(device, p.g, X.data(), W.data(), B.present() ? B.data() : nullptr, Y.data());
+}
+
+void divide_probe(py::object x, py::object y, py::object out) {
+  drain_completed();
+  require_operand(x, "x");
+  require_operand(y, "y");
+  require_operand(out, "out");
+  Operand X(to_capsule(x, "x", false), "x", 1, false);
+  Operand Y(to_capsule(y, "y", false), "y", 1, false);
+  Operand O(to_capsule(out, "out", true), "out", 1, true);
+  expect_shape(Y, {X.dim(0)});
+  expect_shape(O, {X.dim(0)});
+  const int device = common_device({&X, &Y, &O});
+  expect_disjoint(O, X);
+  expect_disjoint(O, Y);
+  RetainUntilComplete keep(device, {&X, &Y, &O});  // F01
+  fp32_divide_probe(device, X.data(), Y.data(), O.data(), X.dim(0));
+}
+
+}  // namespace
+}  // namespace tcs
+
+namespace tcs { void register_lstm(py::module_& m); }  // P1T-M3: src/lstm_bindings.cpp
+namespace tcs { void register_m4(py::module_& m); }  // P1T-M4 norms and small ops (src/m4_bindings.cpp)
+
+PYBIND11_MODULE(_tc_signal, m) {
+  m.doc() = "tc_signal C++ core: DLPack-consuming fp32 1-D convolutions on the legacy default stream (P1T-M2)";
+  using namespace tcs;
+  m.def("conv1d_plan", &conv1d_plan, py::arg("x"), py::arg("w"), py::arg("b"), py::arg("stride"),
+        py::arg("pad_begin"), py::arg("pad_end"), py::arg("dilation"), py::arg("groups"),
+        "Acquire and peek x/w/b; return (x_capsule, w_capsule, b_capsule|None, out_shape, scratch_numel).");
+  m.def("conv1d_run", &conv1d_run, py::arg("x_capsule"), py::arg("w_capsule"), py::arg("b_capsule"), py::arg("out"),
+        py::arg("scratch"), py::arg("stride"), py::arg("pad_begin"), py::arg("pad_end"), py::arg("dilation"),
+        py::arg("groups"), "Consume every operand, validate, launch on the legacy stream, release.");
+  m.def("conv_transpose1d_plan", &conv_transpose1d_plan, py::arg("x"), py::arg("w"), py::arg("b"), py::arg("stride"),
+        py::arg("pad_begin"), py::arg("pad_end"), py::arg("output_padding"), py::arg("dilation"), py::arg("groups"),
+        "Acquire and peek x/w/b; return (x_capsule, w_capsule, b_capsule|None, out_shape).");
+  m.def("conv_transpose1d_run", &conv_transpose1d_run, py::arg("x_capsule"), py::arg("w_capsule"),
+        py::arg("b_capsule"), py::arg("out"), py::arg("stride"), py::arg("pad_begin"), py::arg("pad_end"),
+        py::arg("output_padding"), py::arg("dilation"), py::arg("groups"),
+        "Consume every operand, validate, launch on the legacy stream, release.");
+  m.def("fp32_divide_probe", &divide_probe, py::arg("x"), py::arg("y"), py::arg("out"),
+        "Fast-math canary: out = x / y in fp32 with the package's build flags (tests compare it to IEEE division).");
+  m.def(
+      "cublas_config",
+      [](int device) {
+        CublasConfig c = cublas_config(device);
+        py::dict d;
+        d["math_mode"] = c.math_mode;
+        d["atomics_mode"] = c.atomics_mode;
+        d["pointer_mode"] = c.pointer_mode;
+        d["legacy_stream"] = c.legacy_stream;
+        d["default_math"] = c.default_math;
+        d["atomics_not_allowed"] = c.atomics_not_allowed;
+        return d;
+      },
+      py::arg("device") = 0, "Settings of tc_signal's cuBLAS handle on `device` (creates it if needed).");
+  m.def("build_info", []() {
+    BuildInfo b = build_info();
+    py::dict d;
+    d["cudart_version"] = b.cudart_version;
+    d["cublas_version"] = py::make_tuple(b.cublas_major, b.cublas_minor, b.cublas_patch);
+    d["current_device"] = b.current_device;
+    d["dlpack_header_version"] = py::make_tuple(DLPACK_MAJOR_VERSION, DLPACK_MINOR_VERSION);
+    d["dlpack_max_version_requested"] = py::make_tuple(tuning::kDlpackMaxMajor, tuning::kDlpackMaxMinor);
+    d["dlpack_consumer_stream"] = tuning::kDlpackLegacyStream;
+    return d;
+  });
+  register_lstm(m);
+  register_m4(m);
+  // P1T-FIX1 F01: the deferred-release list (dlpack_operand.h). tc_signal.synchronize() and the package's atexit hook
+  // call `synchronize`; tests and the G4 high-water receipt read `pending_stats`.
+  m.def("synchronize", &synchronize_and_release_all,
+        "Synchronize the legacy default stream (current device and every device with pending operands), then release "
+        "every consumed DLPack operand tc_signal still holds. RuntimeError if a device cannot synchronize (its "
+        "operands are then deliberately leaked, never released early).");
+  m.def("pending_stats", &pending_stats, py::arg("reset_high_water") = false,
+        "Counters of the deferred-release list: entries/managers/bytes now, high-water marks, releases, bound drains, "
+        "fallback syncs, deliberate leaks, and the bounds; P1T-FIX2: deleter_exceptions, push_alloc_failures, "
+        "event_recycle_failures, release_errors, unreported_release_errors.");
+  // P1T-FIX2 (N3): build the pending-list state now (it allocates), so no noexcept release path is the first to touch
+  // it; a failure here fails the import (MemoryError), never a later release.
+  init_pending_state();
+  // TEST HOOK (P1T-FIX2 N1/N3 regression tests only; not part of the API): arm one-shot failures at named release-path
+  // sites (dlpack_operand.h, test_hooks). `names` is a list of site names; "clear" disarms everything.
+  m.def(
+      "_test_inject",
+      [](const std::vector<std::string>& names) {
+        static const std::pair<const char*, unsigned> kSites[] = {
+            {"alloc:event_pool_reserve", test_hooks::kAllocEventPoolReserve},
+            {"alloc:event_recycle", test_hooks::kAllocEventRecycle},
+            {"alloc:pending_push", test_hooks::kAllocPendingPush},
+            {"alloc:owner_reserve", test_hooks::kAllocOwnerReserve},
+            {"alloc:error_message", test_hooks::kAllocErrorMessage},
+            {"cuda:event_record", test_hooks::kCudaEventRecord},
+            {"cuda:sync", test_hooks::kCudaSync},
+        };
+        unsigned bits = 0;
+        for (const std::string& n : names) {
+          if (n == "clear") {
+            test_hooks::clear();
+            continue;
+          }
+          bool found = false;
+          for (const auto& site : kSites)
+            if (n == site.first) {
+              bits |= site.second;
+              found = true;
+            }
+          if (!found) throw py::value_error("tc_signal._test_inject: unknown site '" + n + "'");
+        }
+        test_hooks::arm(bits);
+        return test_hooks::armed();
+      },
+      py::arg("names"), "TEST HOOK (P1T-FIX2): arm one-shot failures at named release-path sites; returns the armed bits.");
+  m.def("_test_injection_armed", []() { return test_hooks::armed(); },
+        "TEST HOOK (P1T-FIX2): the release-path injection bits still armed (a hit site disarms itself).");
+}
diff --git a/tc_signal/src/checked_math.h b/tc_signal/src/checked_math.h
new file mode 100644
index 0000000..aee0401
--- /dev/null
+++ b/tc_signal/src/checked_math.h
@@ -0,0 +1,91 @@
+// Checked int64 shape / geometry / byte arithmetic for tc_signal (P1T-FIX1, review finding F03).
+//
+// Every plan function and every operand validation computes element counts, output lengths, scratch sizes and byte
+// totals through these helpers BEFORE any narrowing cast, allocation or launch. An overflow raises ValueError naming
+// the quantity; a wrapped value is never used (in particular it never turns into an "empty" or negative extent).
+// The byte ceiling is INT64_MAX (= PTRDIFF_MAX on LP64): every byte total and every pointer offset must stay a valid
+// signed pointer difference.
+//
+// Prior art: GCC/Clang `__builtin_mul_overflow` / `__builtin_add_overflow` / `__builtin_sub_overflow` (GCC 5, 2015),
+// which this file uses; C23 `ckd_mul` / `ckd_add` / `ckd_sub` (<stdckdint.h>, ISO/IEC 9899:2024), the standardized
+// form of the same builtins; the SEI CERT C rules INT30-C / INT32-C ("ensure that operations on (un)signed integers do
+// not wrap / overflow"). Taken: the checked-operation primitive. Ours: where tc_signal applies it (the list of
+// quantities in the plan functions) and the INT64_MAX byte ceiling. Unverified in this sandbox (lead to check):
+// "GCC 5 __builtin_mul_overflow release", "C23 stdckdint ckd_mul", "CERT INT32-C".
+#pragma once
+
+#include <pybind11/pybind11.h>
+
+#include <cstdint>
+#include <limits>
+#include <string>
+#include <vector>
+
+namespace tcs {
+
+[[noreturn]] inline void overflow_refusal(const char* what) {
+  throw pybind11::value_error(std::string("tc_signal: ") + what +
+                              " overflows 64-bit arithmetic; refused (no wrapped size is ever used)");
+}
+
+inline int64_t ck_mul(int64_t a, int64_t b, const char* what) {
+  int64_t r = 0;
+  if (__builtin_mul_overflow(a, b, &r)) overflow_refusal(what);
+  return r;
+}
+
+inline int64_t ck_add(int64_t a, int64_t b, const char* what) {
+  int64_t r = 0;
+  if (__builtin_add_overflow(a, b, &r)) overflow_refusal(what);
+  return r;
+}
+
+inline int64_t ck_sub(int64_t a, int64_t b, const char* what) {
+  int64_t r = 0;
+  if (__builtin_sub_overflow(a, b, &r)) overflow_refusal(what);
+  return r;
+}
+
+// P1T-FIX2, review finding N2 (the zero-extent rule). A zero extent makes the element count 0, but it does NOT make
+// the other extents harmless: strides (suffix products), partial counts (prefix products) and byte strides are formed
+// from them whatever the count is, and the round-2 review reproduced signed overflow in exactly those products (UBSan,
+// core numel_of/contiguous_strides). So every product below multiplies EVERY extent, a zero counted as 1 (the extent
+// bound), and refuses the shape if that bound (or its fp32 byte size) overflows int64, even when the count is 0.
+// Callers have refused negative extents; a negative factor is also counted as 1 here (never multiplied).
+// Prior art: as above (checked builtins; CERT INT32-C). The same rule (itemsize times every NONZERO extent must fit,
+// even when the count is 0) is NumPy's array constructor (PyArray_NewFromDescr skips zero dimensions and multiplies
+// the rest into the byte size with overflow checks): measured here, numpy 2.4.2 np.empty((0, 2**62, 4), float32) and
+// np.empty((0, 2**61), float32) raise "array is too big". PyTorch 2.11 refuses the element-level part ("Stride
+// calculation overflowed" for (0, 2**62, 4), "Storage size calculation overflowed" for (2**62, 4, 0)) but not the byte
+// part (it accepts (0, 2**61) fp32). Taken: NumPy's rule. Ours: applying it to every tc_signal plan and validation.
+// Source-level citation unverified here (lead to check): "numpy ctors.c PyArray_NewFromDescr_int is_zero dimensions
+// overflow", "c10 computeStorageNbytesContiguous safe_multiplies_u64".
+inline int64_t ck_extent_bound(const std::vector<int64_t>& s, size_t a, size_t b, const char* what) {
+  int64_t p = 1;
+  for (size_t i = a; i < b; ++i) p = ck_mul(p, s[i] > 1 ? s[i] : 1, what);
+  return p;
+}
+
+// Product of s[a, b), each factor >= 0. A zero factor makes the product 0, but only after the extent bound of the
+// same range has been checked (N2: a zero never hides an overflowing neighbour).
+inline int64_t ck_prod(const std::vector<int64_t>& s, size_t a, size_t b, const char* what) {
+  const int64_t bound = ck_extent_bound(s, a, b, what);
+  for (size_t i = a; i < b; ++i)
+    if (s[i] == 0) return 0;
+  return bound;
+}
+
+// Bytes of `numel` fp32 elements, refused above INT64_MAX.
+inline int64_t ck_fp32_bytes(int64_t numel, const char* what) {
+  return ck_mul(numel, static_cast<int64_t>(sizeof(float)), what);
+}
+
+// Element count of a planned output/scratch shape, plus the check that the fp32 byte size of its EXTENT BOUND fits
+// (N2: so every byte stride fits too, also for a count of 0); returns the count.
+inline int64_t ck_shape_numel(const std::vector<int64_t>& s, const char* what) {
+  const int64_t bound = ck_extent_bound(s, 0, s.size(), what);
+  ck_fp32_bytes(bound, what);
+  return ck_prod(s, 0, s.size(), what);
+}
+
+}  // namespace tcs
diff --git a/tc_signal/src/conv.cu b/tc_signal/src/conv.cu
new file mode 100644
index 0000000..d4427de
--- /dev/null
+++ b/tc_signal/src/conv.cu
@@ -0,0 +1,288 @@
+// tc_signal 1-D convolutions (P1T-M2: T2 Conv1d, T3 ConvTranspose1d). fp32, deterministic, no atomics, no fast-math.
+//
+// Numerics contract (Project-Voice TENSOR_IMPL_PLAN_P1T.md §4; tc_signal plan §4):
+//  * fp32 math throughout; cuBLAS in CUBLAS_DEFAULT_MATH (never TF32) with atomics not allowed;
+//  * every output element is produced by exactly one thread (or one cuBLAS dot product) in a fixed order, so two calls
+//    on the same inputs are bitwise equal; no atomicAdd anywhere in this package;
+//  * no intrinsics such as __expf/__fdividef and no --use_fast_math (CMakeLists.txt refuses it). FMA contraction is
+//    nvcc's default (--fmad=true, not a fast-math flag); the gather kernel spells its FMA out with fmaf().
+//
+// Prior art:
+//  * im2col + GEMM convolution: Chellapilla, Puri & Simard, "High Performance Convolutional Neural Networks for
+//    Document Processing" (2006). Taken: unfold the receptive fields into a matrix and run one SGEMM. Ours: the 1-D
+//    unfold with dilation and separate (pad_begin, pad_end), the per-batch-element scratch reuse, and the group batch
+//    as a strided-batched SGEMM.
+//  * Row-major GEMM through column-major BLAS by computing C^T = B^T A^T: standard BLAS practice (no single source).
+//  * Gather-form transposed convolution: transposed convolution is the adjoint of the strided convolution
+//    (Dumoulin & Visin, "A guide to convolution arithmetic for deep learning", 2016); evaluating each output as a sum
+//    over the input taps that land on it (instead of scattering inputs) is the usual deterministic formulation.
+//    Taken: the tap condition (t + pb - k*dilation) % stride == 0. Ours: the fixed loop order (k outer ascending,
+//    c inner ascending, bias last) and the thread mapping.
+//  * Semantics: ONNX Conv / ConvTranspose operator specs (1-D case; pads = (begin, end), ConvTranspose weight layout
+//    [C_in, C_out/groups, K], output_padding appended at the end).
+#include "conv_ops.h"
+
+#include <cublas_v2.h>
+#include <cuda_runtime.h>
+
+#include <algorithm>
+#include <sstream>
+#include <stdexcept>
+#include <string>
+#include <unordered_map>
+
+#include "tuning.h"
+
+#ifdef CUDA_API_PER_THREAD_DEFAULT_STREAM
+#error "tc_signal queues on the legacy default stream (stream 0); do not build it with --default-stream per-thread"
+#endif
+// nvcc 12.6 defines no preprocessor macro for --use_fast_math (it only passes -ftz=1 -prec_div=0 -prec_sqrt=0 to
+// cicc), so fast-math cannot be refused here at compile time. CMakeLists.txt refuses the flag at configure time, and
+// fp32_divide_probe_kernel below is a runtime canary compiled with this TU's flags (tests/test_conv.py checks it).
+
+namespace tcs {
+
+namespace {
+
+// Stream 0 is the legacy default stream in this translation unit (per-thread default stream refused above). It is the
+// same stream TensorCUDA queues on, and the stream DLPack producers were asked to order against (stream=1).
+constexpr cudaStream_t kLegacyStream = 0;
+
+void check_cuda(cudaError_t e, const char* what) {
+  if (e != cudaSuccess) {
+    std::ostringstream os;
+    os << "tc_signal: " << what << " failed: " << cudaGetErrorName(e) << ": " << cudaGetErrorString(e);
+    throw std::runtime_error(os.str());
+  }
+}
+
+// Checked after every kernel launch (launch-configuration and sticky errors surface here as RuntimeError).
+void check_launch(const char* kernel) { check_cuda(cudaGetLastError(), kernel); }
+
+void check_cublas(cublasStatus_t s, const char* what) {
+  if (s != CUBLAS_STATUS_SUCCESS) {
+    std::ostringstream os;
+    os << "tc_signal: " << what << " failed: cuBLAS status " << static_cast<int>(s);
+    throw std::runtime_error(os.str());
+  }
+}
+
+unsigned int grid_for(int64_t total, int block) {
+  const int64_t blocks = (total + block - 1) / block;
+  return static_cast<unsigned int>(std::max<int64_t>(1, std::min<int64_t>(blocks, tuning::kGridCap)));
+}
+
+// Makes `device` current for the call and restores the caller's device afterwards.
+class DeviceGuard {
+ public:
+  explicit DeviceGuard(int device) {
+    check_cuda(cudaGetDevice(&prev_), "cudaGetDevice");
+    if (prev_ != device) {
+      check_cuda(cudaSetDevice(device), "cudaSetDevice");
+      changed_ = true;
+    }
+  }
+  ~DeviceGuard() {
+    if (changed_) cudaSetDevice(prev_);
+  }
+  DeviceGuard(const DeviceGuard&) = delete;
+  DeviceGuard& operator=(const DeviceGuard&) = delete;
+
+ private:
+  int prev_ = 0;
+  bool changed_ = false;
+};
+
+// One cuBLAS handle per device, created lazily on first use and kept for the life of the process (destroying it at
+// interpreter exit can race CUDA's own teardown). All entry points run under the GIL, so no extra lock is needed.
+// cuBLAS allocates its own internal workspace for this handle on first use (cudaMalloc inside cuBLAS); that is the
+// only device memory tc_signal causes to be allocated outside the caller's allocator (README "cuBLAS").
+cublasHandle_t handle_for(int device) {
+  static std::unordered_map<int, cublasHandle_t> handles;
+  auto it = handles.find(device);
+  if (it != handles.end()) return it->second;
+  cublasHandle_t h = nullptr;
+  check_cublas(cublasCreate(&h), "cublasCreate");
+  check_cublas(cublasSetStream(h, kLegacyStream), "cublasSetStream(0)");
+  check_cublas(cublasSetMathMode(h, CUBLAS_DEFAULT_MATH), "cublasSetMathMode(CUBLAS_DEFAULT_MATH)");
+  check_cublas(cublasSetAtomicsMode(h, CUBLAS_ATOMICS_NOT_ALLOWED), "cublasSetAtomicsMode(NOT_ALLOWED)");
+  check_cublas(cublasSetPointerMode(h, CUBLAS_POINTER_MODE_HOST), "cublasSetPointerMode(HOST)");
+  handles.emplace(device, h);
+  return h;
+}
+
+// ------------------------------------------------------------------------------------------------ kernels
+// 1-D im2col for one batch element (Chellapilla et al. 2006, 1-D with dilation and asymmetric zero padding):
+//   col[(c*K + k), t] = x[c, t*stride - pad_begin + k*dilation]   (0 outside [0, T))
+// Rows (c, k) are c-major, so group g's rows [g*Cg*K, (g+1)*Cg*K) form one contiguous [Cg*K, T_out] block that
+// matches w[g*Og:(g+1)*Og] viewed as [Og, Cg*K].
+__global__ void im2col1d_kernel(const float* __restrict__ x, float* __restrict__ col, int64_t C, int64_t T, int64_t K,
+                                int64_t T_out, int64_t stride, int64_t pad_begin, int64_t dilation) {
+  const int64_t total = C * K * T_out;
+  for (int64_t i = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; i < total;
+       i += static_cast<int64_t>(gridDim.x) * blockDim.x) {
+    const int64_t t = i % T_out;
+    const int64_t r = i / T_out;
+    const int64_t k = r % K;
+    const int64_t c = r / K;
+    const int64_t src = t * stride - pad_begin + k * dilation;
+    col[i] = (src >= 0 && src < T) ? x[c * T + src] : 0.0f;
+  }
+}
+
+// y[n, o, t] += b[o], one thread per output element (fp32 add, one rounding).
+__global__ void bias_add_kernel(float* __restrict__ y, const float* __restrict__ b, int64_t C_out, int64_t T_out,
+                                int64_t total) {
+  for (int64_t i = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; i < total;
+       i += static_cast<int64_t>(gridDim.x) * blockDim.x) {
+    const int64_t o = (i / T_out) % C_out;
+    y[i] = y[i] + b[o];
+  }
+}
+
+// Gather-form ConvTranspose1d (adjoint of strided conv, Dumoulin & Visin 2016), one thread per output element:
+//   y[n, o, t] = b[o] + sum_{k=0..K-1} sum_{c in group(o)} w[c, o - g*Og, k] * x[n, c, (t + pb - k*dilation)/stride]
+// over the taps with (t + pb - k*dilation) >= 0, divisible by stride, and quotient < T. Fixed order: k ascending
+// (outer), c ascending within the group (inner), fp32 fmaf accumulation from 0, bias added last. No atomics.
+__global__ void conv_transpose1d_gather_kernel(const float* __restrict__ x, const float* __restrict__ w,
+                                               const float* __restrict__ b, float* __restrict__ y, int64_t N,
+                                               int64_t C_in, int64_t T, int64_t C_out, int64_t K, int64_t T_out,
+                                               int64_t stride, int64_t pad_begin, int64_t dilation, int64_t groups) {
+  const int64_t Cg = C_in / groups;
+  const int64_t Og = C_out / groups;
+  const int64_t total = N * C_out * T_out;
+  for (int64_t i = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; i < total;
+       i += static_cast<int64_t>(gridDim.x) * blockDim.x) {
+    const int64_t t = i % T_out;
+    const int64_t r = i / T_out;
+    const int64_t o = r % C_out;
+    const int64_t n = r / C_out;
+    const int64_t g = o / Og;
+    const int64_t ol = o - g * Og;
+    const float* xg = x + (n * C_in + g * Cg) * T;   // x[n, g*Cg + cl, :] = xg[cl*T + :]
+    const float* wg = w + (g * Cg * Og + ol) * K;    // w[g*Cg + cl, ol, k] = wg[cl*Og*K + k]
+    float acc = 0.0f;
+    for (int64_t k = 0; k < K; ++k) {
+      const int64_t s = t + pad_begin - k * dilation;
+      if (s < 0 || s % stride != 0) continue;
+      const int64_t q = s / stride;
+      if (q >= T) continue;
+      const float* xp = xg + q;
+      const float* wp = wg + k;
+      for (int64_t cl = 0; cl < Cg; ++cl) acc = fmaf(wp[cl * Og * K], xp[cl * T], acc);
+    }
+    if (b != nullptr) acc = acc + b[o];
+    y[i] = acc;
+  }
+}
+
+// Fast-math canary: out[i] = x[i] / y[i] in fp32. Built with this TU's flags, so --use_fast_math (-ftz=1,
+// -prec_div=0) shows up as flushed subnormals or non-IEEE quotients, which the tests compare bitwise against the host's
+// IEEE fp32 division. Prior art: no specific source known to me (it is the usual "test the build flags by their
+// observable effect" idea; denormal flushing as a fast-math symptom is documented in the CUDA C Programming Guide).
+__global__ void fp32_divide_probe_kernel(const float* __restrict__ x, const float* __restrict__ y,
+                                         float* __restrict__ out, int64_t n) {
+  for (int64_t i = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; i < n;
+       i += static_cast<int64_t>(gridDim.x) * blockDim.x)
+    out[i] = x[i] / y[i];
+}
+
+}  // namespace
+
+void fp32_divide_probe(int device, const float* x, const float* y, float* out, int64_t n) {
+  DeviceGuard guard(device);
+  fp32_divide_probe_kernel<<<grid_for(n, tuning::kProbeBlock), tuning::kProbeBlock, 0, kLegacyStream>>>(x, y, out, n);
+  check_launch("fp32_divide_probe_kernel");
+}
+
+// ------------------------------------------------------------------------------------------------ Conv1d
+void conv1d_forward(int device, const Conv1dGeom& g, const float* x, const float* w, const float* b, float* y,
+                    float* col) {
+  DeviceGuard guard(device);
+  cublasHandle_t h = handle_for(device);
+  const int64_t Cg = g.C_in / g.groups;
+  const int64_t Og = g.C_out / g.groups;
+  const int64_t CgK = Cg * g.K;
+  const float alpha = 1.0f;
+  const float beta = 0.0f;
+  for (int64_t n = 0; n < g.N; ++n) {
+    const float* xn = x + n * g.C_in * g.T;
+    const float* A = nullptr;   // the [Cg*K, T_out] row-major operand of group 0 for this batch element
+    long long strideA = 0;
+    if (g.direct) {
+      // K == 1, stride 1, no pads: x[n] itself is the col matrix (T_out == T), no scratch.
+      A = xn;
+      strideA = static_cast<long long>(Cg * g.T);
+    } else {
+      // The scratch is reused for every n: the next im2col is queued after this n's GEMM on the same stream.
+      const int64_t total = g.C_in * g.K * g.T_out;
+      im2col1d_kernel<<<grid_for(total, tuning::kIm2colBlock), tuning::kIm2colBlock, 0, kLegacyStream>>>(
+          xn, col, g.C_in, g.T, g.K, g.T_out, g.stride, g.pad_begin, g.dilation);
+      check_launch("im2col1d_kernel");
+      A = col;
+      strideA = static_cast<long long>(CgK * g.T_out);
+    }
+    float* yn = y + n * g.C_out * g.T_out;
+    // Row-major Y_g[Og, T_out] = W_g[Og, CgK] . Col_g[CgK, T_out], computed as the column-major product
+    // Y_g^T[T_out, Og] = Col_g^T[T_out, CgK] . W_g^T[CgK, Og]: m = T_out, n = Og, k = CgK, both ops N,
+    // lda = T_out (col), ldb = CgK (w), ldc = T_out (y); one batch entry per group.
+    check_cublas(cublasSgemmStridedBatched(h, CUBLAS_OP_N, CUBLAS_OP_N, static_cast<int>(g.T_out),
+                                           static_cast<int>(Og), static_cast<int>(CgK), &alpha, A,
+                                           static_cast<int>(g.T_out), strideA, w, static_cast<int>(CgK),
+                                           static_cast<long long>(Og * CgK), &beta, yn, static_cast<int>(g.T_out),
+                                           static_cast<long long>(Og * g.T_out), static_cast<int>(g.groups)),
+                 "cublasSgemmStridedBatched");
+    check_launch("cublasSgemmStridedBatched");
+  }
+  if (b != nullptr) {
+    const int64_t total = g.N * g.C_out * g.T_out;
+    bias_add_kernel<<<grid_for(total, tuning::kBiasBlock), tuning::kBiasBlock, 0, kLegacyStream>>>(y, b, g.C_out,
+                                                                                                   g.T_out, total);
+    check_launch("bias_add_kernel");
+  }
+}
+
+// ------------------------------------------------------------------------------------------------ ConvTranspose1d
+void conv_transpose1d_forward(int device, const ConvTranspose1dGeom& g, const float* x, const float* w,
+                              const float* b, float* y) {
+  DeviceGuard guard(device);
+  const int64_t total = g.N * g.C_out * g.T_out;
+  conv_transpose1d_gather_kernel<<<grid_for(total, tuning::kConvTransposeBlock), tuning::kConvTransposeBlock, 0,
+                                   kLegacyStream>>>(x, w, b, y, g.N, g.C_in, g.T, g.C_out, g.K, g.T_out, g.stride,
+                                                    g.pad_begin, g.dilation, g.groups);
+  check_launch("conv_transpose1d_gather_kernel");
+}
+
+// ------------------------------------------------------------------------------------------------ introspection
+CublasConfig cublas_config(int device) {
+  DeviceGuard guard(device);
+  cublasHandle_t h = handle_for(device);
+  cublasMath_t math;
+  cublasAtomicsMode_t atomics;
+  cublasPointerMode_t pmode;
+  cudaStream_t s;
+  check_cublas(cublasGetMathMode(h, &math), "cublasGetMathMode");
+  check_cublas(cublasGetAtomicsMode(h, &atomics), "cublasGetAtomicsMode");
+  check_cublas(cublasGetPointerMode(h, &pmode), "cublasGetPointerMode");
+  check_cublas(cublasGetStream(h, &s), "cublasGetStream");
+  CublasConfig c;
+  c.math_mode = static_cast<int>(math);
+  c.atomics_mode = static_cast<int>(atomics);
+  c.pointer_mode = static_cast<int>(pmode);
+  c.legacy_stream = (s == kLegacyStream);
+  c.default_math = (math == CUBLAS_DEFAULT_MATH);
+  c.atomics_not_allowed = (atomics == CUBLAS_ATOMICS_NOT_ALLOWED);
+  return c;
+}
+
+BuildInfo build_info() {
+  BuildInfo bi{};
+  check_cuda(cudaRuntimeGetVersion(&bi.cudart_version), "cudaRuntimeGetVersion");
+  check_cublas(cublasGetProperty(MAJOR_VERSION, &bi.cublas_major), "cublasGetProperty(MAJOR)");
+  check_cublas(cublasGetProperty(MINOR_VERSION, &bi.cublas_minor), "cublasGetProperty(MINOR)");
+  check_cublas(cublasGetProperty(PATCH_LEVEL, &bi.cublas_patch), "cublasGetProperty(PATCH)");
+  check_cuda(cudaGetDevice(&bi.current_device), "cudaGetDevice");
+  return bi;
+}
+
+}  // namespace tcs
diff --git a/tc_signal/src/conv_ops.h b/tc_signal/src/conv_ops.h
new file mode 100644
index 0000000..381e541
--- /dev/null
+++ b/tc_signal/src/conv_ops.h
@@ -0,0 +1,54 @@
+// Host launchers for tc_signal's 1-D convolutions. Raw device pointers in, everything queued on the legacy default
+// stream; no device memory is allocated here (the im2col scratch is passed in; cuBLAS's own internal workspace is the
+// one exception, see README "cuBLAS").
+#pragma once
+
+#include <cstdint>
+
+namespace tcs {
+
+struct Conv1dGeom {
+  int64_t N, C_in, T;      // x [N, C_in, T]
+  int64_t C_out, K;        // w [C_out, C_in/groups, K]
+  int64_t stride, pad_begin, pad_end, dilation, groups;
+  int64_t T_out;           // (T + pb + pe - dilation*(K-1) - 1)//stride + 1
+  bool direct;             // K == 1, stride 1, no pads: GEMM on x itself, no im2col, no scratch
+};
+
+struct ConvTranspose1dGeom {
+  int64_t N, C_in, T;      // x [N, C_in, T]
+  int64_t C_out, K;        // w [C_in, C_out/groups, K] (ONNX layout)
+  int64_t stride, pad_begin, pad_end, output_padding, dilation, groups;
+  int64_t T_out;           // stride*(T-1) + output_padding + dilation*(K-1) + 1 - pb - pe
+};
+
+// y = conv1d(x, w) + b. `col` holds C_in*K*T_out floats (one batch element at a time), or is NULL when g.direct.
+void conv1d_forward(int device, const Conv1dGeom& g, const float* x, const float* w, const float* b, float* y,
+                    float* col);
+
+// y = conv_transpose1d(x, w) + b (gather form, one thread per output element).
+void conv_transpose1d_forward(int device, const ConvTranspose1dGeom& g, const float* x, const float* w,
+                              const float* b, float* y);
+
+// Fast-math canary (see conv.cu): out[i] = x[i] / y[i], fp32, on the legacy stream.
+void fp32_divide_probe(int device, const float* x, const float* y, float* out, int64_t n);
+
+struct CublasConfig {
+  int math_mode;           // cublasMath_t
+  int atomics_mode;        // cublasAtomicsMode_t
+  int pointer_mode;        // cublasPointerMode_t
+  bool legacy_stream;      // the handle's stream is 0 (the legacy default stream)
+  bool default_math;       // math_mode == CUBLAS_DEFAULT_MATH
+  bool atomics_not_allowed;
+};
+// The (lazily created) handle's settings on `device`.
+CublasConfig cublas_config(int device);
+
+struct BuildInfo {
+  int cudart_version;      // cudaRuntimeGetVersion
+  int cublas_major, cublas_minor, cublas_patch;
+  int current_device;
+};
+BuildInfo build_info();
+
+}  // namespace tcs
diff --git a/tc_signal/src/dlpack_operand.cpp b/tc_signal/src/dlpack_operand.cpp
new file mode 100644
index 0000000..181db44
--- /dev/null
+++ b/tc_signal/src/dlpack_operand.cpp
@@ -0,0 +1,871 @@
+// DLPack consumer implementation. Prior art and design notes: see dlpack_operand.h.
+#include "dlpack_operand.h"
+
+#include <cuda_runtime.h>
+
+#include <algorithm>
+#include <atomic>
+#include <cstring>
+#include <deque>
+#include <new>
+#include <limits>
+#include <sstream>
+#include <stdexcept>
+#include <unordered_map>
+
+#include "checked_math.h"
+#include "tuning.h"
+
+namespace tcs {
+
+namespace {
+
+constexpr const char* kCapsule = "dltensor";
+constexpr const char* kCapsuleVersioned = "dltensor_versioned";
+constexpr const char* kUsedCapsule = "used_dltensor";
+constexpr const char* kUsedCapsuleVersioned = "used_dltensor_versioned";
+
+std::string type_name(py::handle obj) { return Py_TYPE(obj.ptr())->tp_name; }
+
+std::string capsule_name(py::handle cap) {
+  const char* n = PyCapsule_GetName(cap.ptr());
+  if (n == nullptr && PyErr_Occurred()) throw py::error_already_set();
+  return n ? std::string(n) : std::string();
+}
+
+[[noreturn]] void refuse_value(const char* role, const std::string& msg) {
+  throw py::value_error(std::string("tc_signal: operand '") + role + "': " + msg);
+}
+
+[[noreturn]] void refuse_type(const char* role, const std::string& msg) {
+  throw py::type_error(std::string("tc_signal: operand '") + role + "': " + msg);
+}
+
+// Checks a capsule's name and returns its kind (true = versioned). Consumed and foreign capsules are refused.
+bool capsule_kind(py::handle cap, const char* role) {
+  const std::string n = capsule_name(cap);
+  if (n == kCapsuleVersioned) return true;
+  if (n == kCapsule) return false;
+  if (n == kUsedCapsule || n == kUsedCapsuleVersioned)
+    refuse_value(role, "the DLPack capsule was already consumed (name '" + n + "'); a capsule can be consumed once");
+  refuse_type(role, "a capsule named '" + n + "' is not a DLPack capsule ('dltensor' or 'dltensor_versioned')");
+}
+
+void* capsule_pointer(py::handle cap, const char* name) {
+  void* p = PyCapsule_GetPointer(cap.ptr(), name);
+  if (p == nullptr) throw py::error_already_set();
+  return p;
+}
+
+void check_version(const DLManagedTensorVersioned* m, const char* role) {
+  if (m->version.major != DLPACK_MAJOR_VERSION) {
+    std::ostringstream os;
+    os << "DLPack major version " << m->version.major << " is not supported (this consumer reads major "
+       << DLPACK_MAJOR_VERSION << ")";
+    refuse_value(role, os.str());
+  }
+}
+
+}  // namespace
+
+// ------------------------------------------------------------------------------------------------ capsule acquisition
+py::object to_capsule(py::handle obj, const char* role, bool writable) {
+  if (PyCapsule_CheckExact(obj.ptr())) return py::reinterpret_borrow<py::object>(obj);
+  if (!py::hasattr(obj, "__dlpack__"))
+    refuse_type(role, "expected a DLPack producer (an object with __dlpack__) or a DLPack capsule, got " +
+                          type_name(obj));
+  // Array API order: ask the producer's device first. A non-CUDA producer is refused here, before __dlpack__ is
+  // called with a CUDA stream argument (CPU producers such as NumPy reject any stream other than None).
+  if (py::hasattr(obj, "__dlpack_device__")) {
+    int device_type = -1;
+    try {
+      py::tuple dev = obj.attr("__dlpack_device__")().cast<py::tuple>();
+      device_type = dev[0].cast<int>();
+    } catch (py::cast_error&) {
+      refuse_type(role, "__dlpack_device__() did not return a (device_type, device_id) tuple of ints");
+    }
+    if (device_type != kDLCUDA) {
+      std::ostringstream os;
+      os << "device type " << device_type << " is not kDLCUDA (2); tc_signal takes CUDA device memory only";
+      refuse_value(role, os.str());
+    }
+  }
+  py::object fn = obj.attr("__dlpack__");
+  py::object cap;
+  const py::tuple max_version = py::make_tuple(tuning::kDlpackMaxMajor, tuning::kDlpackMaxMinor);
+  try {
+    // Consumer stream = the legacy default stream (DLPack int 1): the producer orders its pending work before it.
+    if (writable)
+      cap = fn(py::arg("stream") = tuning::kDlpackLegacyStream, py::arg("max_version") = max_version,
+               py::arg("copy") = false);
+    else
+      cap = fn(py::arg("stream") = tuning::kDlpackLegacyStream, py::arg("max_version") = max_version);
+  } catch (py::error_already_set& e) {
+    // A producer that predates the 2023 keywords rejects them with TypeError: retry with the stream argument only
+    // (the array API standard's documented fallback; NumPy and PyTorch consumers do the same).
+    if (!e.matches(PyExc_TypeError)) throw;
+    cap = fn(py::arg("stream") = tuning::kDlpackLegacyStream);
+  }
+  if (!PyCapsule_CheckExact(cap.ptr()))
+    refuse_type(role, "__dlpack__ returned " + type_name(cap) + ", not a PyCapsule");
+  return cap;
+}
+
+const DLTensor* peek(py::handle capsule, const char* role) {
+  if (!PyCapsule_CheckExact(capsule.ptr())) refuse_type(role, "expected a DLPack capsule, got " + type_name(capsule));
+  if (capsule_kind(capsule, role)) {
+    auto* m = static_cast<DLManagedTensorVersioned*>(capsule_pointer(capsule, kCapsuleVersioned));
+    check_version(m, role);
+    return &m->dl_tensor;
+  }
+  auto* m = static_cast<DLManagedTensor*>(capsule_pointer(capsule, kCapsule));
+  return &m->dl_tensor;
+}
+
+// ------------------------------------------------------------------------------------------------ validation
+int64_t validate_tensor(const DLTensor* t, const char* role, int ndim) {
+  if (t->device.device_type != kDLCUDA) {
+    std::ostringstream os;
+    os << "device type " << static_cast<int>(t->device.device_type)
+       << " is not kDLCUDA (2); tc_signal takes CUDA device memory only";
+    refuse_value(role, os.str());
+  }
+  if (t->dtype.code != kDLFloat || t->dtype.bits != 32 || t->dtype.lanes != 1) {
+    std::ostringstream os;
+    os << "dtype (code " << static_cast<int>(t->dtype.code) << ", bits " << static_cast<int>(t->dtype.bits)
+       << ", lanes " << t->dtype.lanes
+       << ") is not float32; tc_signal computes in fp32 only (expand fp16 weights to fp32 first)";
+    refuse_type(role, os.str());
+  }
+  // F03 (P1T-FIX1): a negative rank or a NULL shape array (with rank > 0) is refused before the shape is read.
+  if (t->ndim < 0) {
+    std::ostringstream os;
+    os << "negative number of dimensions " << t->ndim;
+    refuse_value(role, os.str());
+  }
+  if (t->ndim > 0 && t->shape == nullptr) refuse_value(role, "NULL shape array for a tensor with dimensions");
+  if (t->ndim != ndim) {
+    std::ostringstream os;
+    os << "expected " << ndim << " dimensions, got " << t->ndim;
+    refuse_value(role, os.str());
+  }
+  // F03: checked element count and fp32 byte total, before the stride walk below multiplies extents and before any
+  // later byte range is formed.
+  // P1T-FIX2, review finding N2 (zero-extent rule, checked_math.h ck_extent_bound): EVERY extent is multiplied (a zero
+  // or negative one counted as 1) BEFORE the empty-operand refusal, so a shape such as [0, 2^62, 4] is refused as an
+  // overflow, never waved through because its count is 0. Prior art: NumPy's array constructor rule (see
+  // checked_math.h); the checked builtins (GCC 5, 2015).
+  int64_t numel = 1;
+  for (int i = 0; i < t->ndim; ++i) {
+    if (__builtin_mul_overflow(numel, t->shape[i] > 1 ? t->shape[i] : int64_t{1}, &numel))
+      refuse_value(role, "element count of shape " + shape_str(shape_of(t)) +
+                             " overflows int64 (every nonzero extent counts, also next to a zero extent)");
+  }
+  int64_t nbytes = 0;
+  if (__builtin_mul_overflow(numel, static_cast<int64_t>(sizeof(float)), &nbytes))
+    refuse_value(role, "byte size of shape " + shape_str(shape_of(t)) + " (fp32) overflows int64");
+  for (int i = 0; i < t->ndim; ++i)
+    if (t->shape[i] <= 0) refuse_value(role, "empty operand (shape " + shape_str(shape_of(t)) + ")");
+  // Every extent is >= 1 from here: numel is the element count and nbytes its fp32 byte size.
+  if (t->strides != nullptr) {
+    // C-contiguous: every dimension of extent > 1 has the compact stride; size-1 dimensions may carry any stride
+    // (they are never stepped), as the order and the DLPack/array API conventions allow.
+    int64_t want = 1;
+    for (int i = t->ndim - 1; i >= 0; --i) {
+      if (t->shape[i] != 1 && t->strides[i] != want) {
+        std::ostringstream os;
+        os << "not C-contiguous (shape " << shape_str(shape_of(t)) << ", strides [";
+        for (int j = 0; j < t->ndim; ++j) os << (j ? ", " : "") << t->strides[j];
+        os << "]); pass a contiguous tensor";
+        refuse_value(role, os.str());
+      }
+      want *= t->shape[i];
+    }
+  }
+  if (t->data == nullptr) refuse_value(role, "NULL data pointer");
+  // F03: data + byte_offset (element 0) and element 0 + nbytes (one past the end) must not wrap the address space.
+  uintptr_t p = 0;
+  uintptr_t end = 0;
+  if (__builtin_add_overflow(reinterpret_cast<uintptr_t>(t->data), static_cast<uintptr_t>(t->byte_offset), &p) ||
+      __builtin_add_overflow(p, static_cast<uintptr_t>(nbytes), &end))
+    refuse_value(role, "data + byte_offset + byte size overflows the address space");
+  if (p % alignof(float) != 0) refuse_value(role, "data + byte_offset is not 4-byte aligned");
+  return numel;
+}
+
+void require_operand(py::handle obj, const char* role) {
+  // F02 (P1T-FIX1): None is never a tensor. Refused with TypeError before any planning, allocation or consumption.
+  if (obj.is_none())
+    refuse_type(role, "is required: expected a DLPack producer (an object with __dlpack__) or a DLPack capsule, got "
+                      "None (only optional operands such as a bias may be None)");
+}
+
+// ------------------------------------------------------------------------------------------------ ManagedOwner
+ManagedOwner::ManagedOwner(ManagedOwner&& o) noexcept : legacy(o.legacy), versioned(o.versioned) {
+  o.legacy = nullptr;
+  o.versioned = nullptr;
+}
+
+ManagedOwner& ManagedOwner::operator=(ManagedOwner&& o) noexcept {
+  if (this != &o) {
+    reset();
+    legacy = o.legacy;
+    versioned = o.versioned;
+    o.legacy = nullptr;
+    o.versioned = nullptr;
+  }
+  return *this;
+}
+
+// P1T-FIX2, review finding N4: a producer deleter that throws a C++ exception must not terminate the process. Every
+// deleter call in tc_signal goes through reset() (the immediate release of a refused call, the deferred drain, the
+// bound drain, the fallback sync, synchronize() and the atexit hook all end here), and reset() is noexcept, so an
+// escaping exception used to reach std::terminate (round-2 probe cpu_native throw_deleter, rc -6). Now each call is
+// wrapped: the exception is caught (catch-all), counted (pending_stats()['deleter_exceptions']) and dropped; the owner
+// pointer is cleared BEFORE the call, so a deleter is never called twice, and the caller (a loop over an entry's
+// managers) keeps going with the remaining managers. The DLPack ABI declares the deleter as a C function, so a
+// throwing deleter already breaks the producer's contract; containing it is the consumer's choice, not a recovery
+// (the producer's memory may or may not have been freed: tc_signal does not touch it again either way).
+// Prior art: C++11 noexcept semantics ([except.terminate]: an exception escaping a noexcept function calls
+// std::terminate) and the "destructors/cleanup must not throw" guideline (C++ Core Guidelines C.36/E.16, Sutter &
+// Alexandrescu 2004, item 51). Taken: catch at the noexcept boundary. Ours: counting and continuing per manager.
+// Known gap (not closed): a deleter that calls pthread_exit or is cancelled unwinds with abi::__forced_unwind, which
+// may not be swallowed (glibc aborts); no C++ handler can contain that.
+namespace {
+std::atomic<unsigned long long> g_deleter_exceptions{0};  // static storage: counting never allocates
+
+template <typename M>
+void call_deleter_contained(M* m) noexcept {
+  if (m == nullptr || m->deleter == nullptr) return;
+  try {
+    m->deleter(m);
+  } catch (...) {
+    g_deleter_exceptions.fetch_add(1, std::memory_order_relaxed);
+  }
+}
+}  // namespace
+
+void ManagedOwner::reset() noexcept {
+  // DLPack consumer rule: when done, call the producer's deleter (it may be NULL). Called with the GIL held (every
+  // tc_signal entry point runs under the GIL), so a deleter that touches Python objects is safe.
+  if (legacy != nullptr) {
+    DLManagedTensor* m = legacy;
+    legacy = nullptr;  // cleared first: never called twice, even if the deleter throws or re-enters
+    call_deleter_contained(m);
+  }
+  if (versioned != nullptr) {
+    DLManagedTensorVersioned* m = versioned;
+    versioned = nullptr;
+    call_deleter_contained(m);
+  }
+}
+
+unsigned long long deleter_exceptions() noexcept { return g_deleter_exceptions.load(std::memory_order_relaxed); }
+
+// ------------------------------------------------------------------------------------------------ Operand
+Operand::Operand(py::handle capsule, const char* role, int ndim, bool writable) : role_(role) {
+  if (!PyCapsule_CheckExact(capsule.ptr())) refuse_type(role, "expected a DLPack capsule, got " + type_name(capsule));
+  const bool versioned = capsule_kind(capsule, role);
+  // Consume: take the pointer, rename the capsule to "used_*" (so its destructor no longer calls the deleter), and
+  // own the managed tensor from here on (owner_ calls the deleter on every path, including a throw below).
+  if (versioned) {
+    auto* m = static_cast<DLManagedTensorVersioned*>(capsule_pointer(capsule, kCapsuleVersioned));
+    if (PyCapsule_SetName(capsule.ptr(), kUsedCapsuleVersioned) != 0) throw py::error_already_set();
+    owner_.versioned = m;
+    check_version(m, role);
+    if (writable && (m->flags & DLPACK_FLAG_BITMASK_READ_ONLY))
+      refuse_value(role, "the producer marked this tensor read-only; tc_signal writes this operand");
+    if (writable && (m->flags & DLPACK_FLAG_BITMASK_IS_COPIED))
+      refuse_value(role, "the producer exported a copy; writes to it would not reach the caller's tensor");
+    t_ = &m->dl_tensor;
+  } else {
+    auto* m = static_cast<DLManagedTensor*>(capsule_pointer(capsule, kCapsule));
+    if (PyCapsule_SetName(capsule.ptr(), kUsedCapsule) != 0) throw py::error_already_set();
+    owner_.legacy = m;
+    t_ = &m->dl_tensor;
+  }
+  numel_ = validate_tensor(t_, role, ndim);
+  data_ = reinterpret_cast<float*>(static_cast<char*>(t_->data) + t_->byte_offset);  // byte_offset honoured
+}
+
+Operand::~Operand() = default;
+
+Operand::Operand(Operand&& o) noexcept
+    : owner_(std::move(o.owner_)), t_(o.t_), data_(o.data_), numel_(o.numel_), role_(o.role_) {
+  o.t_ = nullptr;
+  o.data_ = nullptr;
+  o.numel_ = 0;
+}
+
+Operand& Operand::operator=(Operand&& o) noexcept {
+  if (this != &o) {
+    owner_ = std::move(o.owner_);
+    t_ = o.t_;
+    data_ = o.data_;
+    numel_ = o.numel_;
+    role_ = o.role_;
+    o.t_ = nullptr;
+    o.data_ = nullptr;
+    o.numel_ = 0;
+  }
+  return *this;
+}
+
+const DLTensor* Operand::meta() const {
+  // F02 second line of defence: an absent (None) operand has no metadata; never dereference NULL.
+  if (t_ == nullptr)
+    refuse_type(role_[0] ? role_ : "?", "is absent (None); its shape/device cannot be read");
+  return t_;
+}
+
+int64_t Operand::numel() const {
+  meta();
+  return numel_;  // checked at construction (validate_tensor)
+}
+
+void Operand::release() {
+  owner_.reset();
+  t_ = nullptr;
+  data_ = nullptr;
+  numel_ = 0;
+}
+
+ManagedOwner Operand::take_owner() {
+  ManagedOwner o(std::move(owner_));
+  t_ = nullptr;
+  data_ = nullptr;
+  numel_ = 0;
+  return o;
+}
+
+// ------------------------------------------------------------------------------------------------ helpers
+std::vector<int64_t> shape_of(const DLTensor* t) { return std::vector<int64_t>(t->shape, t->shape + t->ndim); }
+
+std::string shape_str(const std::vector<int64_t>& s) {
+  std::ostringstream os;
+  os << "[";
+  for (size_t i = 0; i < s.size(); ++i) os << (i ? ", " : "") << s[i];
+  os << "]";
+  return os.str();
+}
+
+void expect_shape(const Operand& op, const std::vector<int64_t>& want) {
+  std::vector<int64_t> got(op.ndim());
+  for (int i = 0; i < op.ndim(); ++i) got[i] = op.dim(i);
+  if (got != want) refuse_value(op.role(), "shape " + shape_str(got) + " != expected " + shape_str(want));
+}
+
+int common_device(const std::vector<const Operand*>& ops) {
+  int dev = -1;
+  const char* first = "";
+  for (const Operand* op : ops) {
+    if (op == nullptr || !op->present()) continue;
+    if (dev < 0) {
+      dev = op->device();
+      first = op->role();
+    } else if (op->device() != dev) {
+      std::ostringstream os;
+      os << "on CUDA device " << op->device() << " but operand '" << first << "' is on CUDA device " << dev
+         << "; every operand must be on the same device";
+      refuse_value(op->role(), os.str());
+    }
+  }
+  return dev;
+}
+
+void expect_disjoint(const Operand& written, const Operand& other) {
+  if (!written.present() || !other.present()) return;
+  if (written.byte_begin() < other.byte_end() && other.byte_begin() < written.byte_end())
+    refuse_value(written.role(), std::string("its memory overlaps operand '") + other.role() +
+                                     "'; the written operand must not alias any other operand");
+}
+
+// ------------------------------------------------------------------------------------------------ deferred release (F01)
+// Design and prior art: dlpack_operand.h, RetainUntilComplete. Every function here runs on the calling host thread with
+// the GIL held (every _tc_signal entry point is a pybind11 function that keeps the GIL), so the pending list needs no
+// lock. Deleters may run Python (a ctypes producer) and may even re-enter tc_signal; therefore an entry is always taken
+// OFF the list before its deleters run, and nothing holds a reference into the list across a deleter call.
+//
+// P1T-FIX2 (round-2 review N1, N3) changed the release paths as follows:
+//  * N3, no allocation failure terminates. The noexcept functions here (drain_completed, the RetainUntilComplete
+//    destructor, sync_and_release_all_impl, recycle_event) no longer allocate, except the pending-list push in the
+//    destructor, which is caught and falls back to a synchronous release (counted). sync_and_release_all_impl works on
+//    the live list in place (phase 1 synchronizes the devices into a fixed-capacity set, phase 2 pops completed
+//    entries), instead of a take-all std::deque swap and a std::set / std::vector of devices, which allocated inside a
+//    noexcept function (libstdc++'s deque allocates even when default-constructed: the round-2 probe oom_sync, rc -6).
+//    The recycle slot of every completion event is reserved when the event is created (constructor path, before any
+//    launch), so recycling never allocates. The owner vector is reserved in the constructor, as before.
+//  * N1, no CUDA error is reported as success: a failed current-device query (cudaGetDevice) is now an error of
+//    synchronize() (it used to be skipped, so an empty list "synchronized" successfully on a machine with no usable
+//    device: probe empty_sync); a stream sync that fails is an error; and a release-path failure that happens where
+//    nothing can raise (the fallback sync and the bound drain inside the destructor) is recorded and raised by the next
+//    synchronize() (once), and logged by the atexit hook.
+// Prior art for the in-place two-phase drain: PyTorch's CUDA caching allocator processes its event list in place from
+// the host (process_events: query each recorded event, stop at the first one not ready). Taken: query-and-pop in FIFO
+// order. Ours: the sync-then-pop split with the per-device failure set, and leak-instead-of-release for entries whose
+// device could not be synchronized. Fixed-capacity, allocation-free bookkeeping on failure paths is ordinary
+// "no allocation on the error path" practice (e.g. the C++ Core Guidelines E.16 discussion); no specific prior art
+// claimed for the set itself.
+namespace test_hooks {
+namespace {
+std::atomic<unsigned> g_armed{0};
+}  // namespace
+void arm(unsigned bits) noexcept { g_armed.fetch_or(bits, std::memory_order_relaxed); }
+void clear() noexcept { g_armed.store(0, std::memory_order_relaxed); }
+unsigned armed() noexcept { return g_armed.load(std::memory_order_relaxed); }
+bool take(unsigned bit) noexcept {
+  if ((g_armed.load(std::memory_order_relaxed) & bit) == 0) return false;  // the production path: one relaxed load
+  return (g_armed.fetch_and(~bit, std::memory_order_relaxed) & bit) != 0;
+}
+}  // namespace test_hooks
+
+namespace {
+
+// TEST HOOK: the CUDA error an armed kCuda* site reports instead of calling CUDA (tests only; never in production).
+constexpr cudaError_t kTestInjectedCudaError = cudaErrorLaunchFailure;
+
+struct PendingEntry {
+  cudaEvent_t event = nullptr;   // recorded on `device`'s legacy stream right after the call's last launch
+  int device = -1;
+  int64_t bytes = 0;             // sum of the fp32 operand sizes this entry keeps alive
+  std::vector<ManagedOwner> owners;
+};
+
+// Completion events of one device: `free` holds completed events for reuse; its capacity is kept >= `created` (the
+// number of live events of this device), so returning an event to it never allocates (N3).
+struct DeviceEvents {
+  std::vector<cudaEvent_t> free;
+  size_t created = 0;
+};
+
+struct PendingState {
+  std::deque<PendingEntry> q;
+  int64_t bytes = 0;
+  long long managers = 0;
+  long long high_water_entries = 0;
+  long long high_water_managers = 0;
+  int64_t high_water_bytes = 0;
+  unsigned long long retained_entries = 0;   // entries ever pushed
+  unsigned long long released_entries = 0;
+  unsigned long long released_managers = 0;
+  unsigned long long bound_drains = 0;       // a push exceeded a bound -> synchronize + release everything
+  unsigned long long fallback_syncs = 0;     // the event could not be recorded/queued -> the legacy stream was synced
+  unsigned long long leaked_managers = 0;    // no completion proof (broken context): deliberately not released
+  unsigned long long push_alloc_failures = 0;     // N3: the pending-list push failed to allocate (-> fallback sync)
+  unsigned long long event_recycle_failures = 0;  // N3: an event could not be pooled (destroyed instead)
+  unsigned long long release_errors = 0;          // N1: CUDA failures on the release paths (fallback sync, bound drain)
+  // N1: release-path failures not yet raised by synchronize() (the first one is named; all are counted).
+  unsigned long long unreported_count = 0;
+  unsigned long long unreported_leaked = 0;
+  int unreported_device = -1;
+  cudaError_t unreported_error = cudaSuccess;
+  std::unordered_map<int, DeviceEvents> event_pool;   // per device
+};
+
+// Never destroyed: no static destructor may call a producer deleter at process exit (Python may be gone by then).
+// Constructed at module import (init_pending_state), so the first call from a noexcept release path never allocates.
+PendingState& pending() {
+  static PendingState* state = new PendingState();
+  return *state;
+}
+
+// Makes `device` current for its scope and restores the caller's device; never throws (ok()/error() report failure,
+// and a failed call clears the runtime's last-error slot so a later, unrelated launch check does not report it).
+class QuietDeviceGuard {
+ public:
+  explicit QuietDeviceGuard(int device) noexcept {
+    cudaError_t e = cudaGetDevice(&prev_);
+    if (e != cudaSuccess) {
+      cudaGetLastError();
+      err_ = e;
+      return;
+    }
+    if (prev_ != device) {
+      e = cudaSetDevice(device);
+      if (e != cudaSuccess) {
+        cudaGetLastError();
+        err_ = e;
+        return;
+      }
+      switched_ = true;
+    }
+  }
+  ~QuietDeviceGuard() {
+    if (switched_) cudaSetDevice(prev_);
+  }
+  QuietDeviceGuard(const QuietDeviceGuard&) = delete;
+  QuietDeviceGuard& operator=(const QuietDeviceGuard&) = delete;
+  bool ok() const { return err_ == cudaSuccess; }
+  cudaError_t error() const { return err_; }
+
+ private:
+  int prev_ = 0;
+  cudaError_t err_ = cudaSuccess;
+  bool switched_ = false;
+};
+
+// Synchronizes the legacy stream of `device` (switching to it and back). Never throws, never allocates.
+cudaError_t sync_device_legacy(int device) noexcept {
+  QuietDeviceGuard g(device);
+  if (!g.ok()) return g.error();
+  const cudaError_t r =
+      test_hooks::take(test_hooks::kCudaSync) ? kTestInjectedCudaError : cudaStreamSynchronize(cudaStreamLegacy);
+  if (r != cudaSuccess) cudaGetLastError();
+  return r;
+}
+
+// N1/N3: the devices one sync_and_release_all_impl call synchronized, with each result. Fixed capacity, no allocation.
+// A device beyond the capacity is still synchronized; its failure is remembered only as `spill_failed`, which makes
+// every unrecorded device count as failed (conservative: its not-yet-complete entries are leaked, never released).
+struct DeviceSyncSet {
+  int dev[tuning::kSyncMaxDevices];
+  cudaError_t err[tuning::kSyncMaxDevices];
+  int n = 0;
+  bool spill_failed = false;
+  cudaError_t spill_error = cudaSuccess;
+
+  void sync(int d) noexcept {
+    for (int i = 0; i < n; ++i)
+      if (dev[i] == d) return;
+    const cudaError_t r = sync_device_legacy(d);
+    if (n < tuning::kSyncMaxDevices) {
+      dev[n] = d;
+      err[n] = r;
+      ++n;
+    } else if (r != cudaSuccess) {
+      spill_failed = true;
+      spill_error = r;
+    }
+  }
+  bool failed(int d) const noexcept {
+    for (int i = 0; i < n; ++i)
+      if (dev[i] == d) return err[i] != cudaSuccess;
+    return spill_failed;
+  }
+};
+
+// What one sync_and_release_all_impl call found (fixed capacity: the first kSyncReportMax failures are named, the
+// rest only counted).
+struct SyncReport {
+  bool query_failed = false;               // cudaGetDevice failed (N1: never a success)
+  cudaError_t query_error = cudaSuccess;
+  int n = 0;
+  int dev[tuning::kSyncReportMax];
+  cudaError_t err[tuning::kSyncReportMax];
+  int unnamed = 0;                         // failures beyond the named ones
+  unsigned long long leaked_managers = 0;  // managers leaked by this call (no completion proof)
+
+  void add(int d, cudaError_t e) noexcept {
+    if (n < tuning::kSyncReportMax) {
+      dev[n] = d;
+      err[n] = e;
+      ++n;
+    } else {
+      ++unnamed;
+    }
+  }
+  bool failed() const noexcept { return query_failed || n > 0 || unnamed > 0 || leaked_managers > 0; }
+  int first_device() const noexcept { return n > 0 ? dev[0] : -1; }
+  cudaError_t first_error() const noexcept { return query_failed ? query_error : (n > 0 ? err[0] : cudaErrorUnknown); }
+};
+
+// N1: a CUDA failure on a release path that cannot raise (inside the noexcept destructor). Raised by the next
+// synchronize(), logged at exit. Never allocates.
+void note_release_failure(PendingState& st, int device, cudaError_t err, unsigned long long leaked) noexcept {
+  ++st.release_errors;
+  if (st.unreported_count == 0) {
+    st.unreported_device = device;
+    st.unreported_error = err;
+  }
+  ++st.unreported_count;
+  st.unreported_leaked += leaked;
+}
+
+void recycle_event(PendingState& st, int device, cudaEvent_t ev) noexcept {
+  if (ev == nullptr) return;
+  DeviceEvents* de = nullptr;
+  try {
+    auto it = st.event_pool.find(device);  // find, never operator[]: no insertion on the release path
+    if (it != st.event_pool.end()) de = &it->second;
+    // N3: the slot was reserved when the event was created; refuse (never allocate) if it somehow is not there.
+    if (test_hooks::take(test_hooks::kAllocEventRecycle) || de == nullptr || de->free.size() >= de->free.capacity())
+      throw std::bad_alloc();
+    de->free.push_back(ev);  // within capacity: no allocation
+  } catch (...) {
+    ++st.event_recycle_failures;
+    if (de != nullptr && de->created > 0) --de->created;
+    cudaEventDestroy(ev);
+  }
+}
+
+void note_push(PendingState& st, const PendingEntry& e) {
+  st.bytes += e.bytes;
+  st.managers += static_cast<long long>(e.owners.size());
+  ++st.retained_entries;
+  st.high_water_entries = std::max<long long>(st.high_water_entries, static_cast<long long>(st.q.size()));
+  st.high_water_managers = std::max(st.high_water_managers, st.managers);
+  st.high_water_bytes = std::max(st.high_water_bytes, st.bytes);
+}
+
+void note_pop(PendingState& st, const PendingEntry& e) {
+  st.bytes -= e.bytes;
+  st.managers -= static_cast<long long>(e.owners.size());
+}
+
+// Runs the entry's deleters (they may run Python and re-enter tc_signal; the entry is already off the list). A throwing
+// deleter is contained in ManagedOwner::reset (N4) and the loop goes on with the remaining managers.
+void release_entry(PendingState& st, PendingEntry& e) noexcept {
+  recycle_event(st, e.device, e.event);
+  e.event = nullptr;
+  ++st.released_entries;
+  st.released_managers += e.owners.size();
+  for (ManagedOwner& o : e.owners) o.reset();
+}
+
+// Returns the number of managers leaked.
+unsigned long long leak_entry(PendingState& st, PendingEntry& e) noexcept {
+  unsigned long long n = 0;
+  for (ManagedOwner& o : e.owners) {
+    if (!o.empty()) ++n;
+    o.leak();
+  }
+  st.leaked_managers += n;
+  // The event is not recycled either: it may belong to a broken context.
+  e.event = nullptr;
+  return n;
+}
+
+// Phase 1: synchronize the legacy stream of the current device and of every device with pending entries (no deleter
+// runs, so iterating the live list is safe). Phase 2: pop entries in FIFO order and release each one whose event has
+// completed; leak (counted) an entry with no completion proof whose device could not be synchronized or whose event
+// query failed; stop at the first entry that is merely not ready on a device that DID synchronize: it was pushed after
+// phase 1 by a re-entrant call (a deleter that calls tc_signal) and is left pending. Every entry is popped before its
+// deleters run, so a re-entrant drain or bound drain pops each entry at most once. No allocation, never throws.
+SyncReport sync_and_release_all_impl() noexcept {
+  PendingState& st = pending();
+  SyncReport rep;
+  DeviceSyncSet set;
+  int cur = -1;
+  const cudaError_t qe = cudaGetDevice(&cur);
+  if (qe != cudaSuccess) {
+    cudaGetLastError();
+    rep.query_failed = true;  // N1: was silently skipped (synchronize() then "succeeded" with no device)
+    rep.query_error = qe;
+  } else {
+    set.sync(cur);
+  }
+  for (const PendingEntry& e : st.q) set.sync(e.device);
+  for (int i = 0; i < set.n; ++i)
+    if (set.err[i] != cudaSuccess) rep.add(set.dev[i], set.err[i]);
+  if (set.spill_failed) rep.add(-1, set.spill_error);
+
+  while (!st.q.empty()) {
+    const cudaError_t r = cudaEventQuery(st.q.front().event);
+    const int dev = st.q.front().device;
+    const bool complete = (r == cudaSuccess);
+    if (!complete) {
+      if (r == cudaErrorNotReady) {
+        if (cudaPeekAtLastError() == cudaErrorNotReady) cudaGetLastError();
+        if (!set.failed(dev)) break;  // pushed after phase 1 (re-entrant call): not ours to force
+      } else {
+        cudaGetLastError();           // the event itself cannot be queried: no completion proof (N1: an error)
+        rep.add(dev, r);
+      }
+    }
+    PendingEntry e = std::move(st.q.front());
+    st.q.pop_front();
+    note_pop(st, e);
+    if (complete)
+      release_entry(st, e);
+    else
+      rep.leaked_managers += leak_entry(st, e);
+  }
+  return rep;
+}
+
+cudaEvent_t acquire_event(int device) {
+  PendingState& st = pending();
+  DeviceEvents& de = st.event_pool[device];  // may allocate: constructor path, nothing has been launched yet
+  if (!de.free.empty()) {
+    cudaEvent_t ev = de.free.back();
+    de.free.pop_back();
+    return ev;
+  }
+  // N3: reserve the recycle slot of the event about to be created HERE, where an allocation failure only refuses the
+  // call (MemoryError, operands released at once), so returning the event to the pool later never allocates.
+  if (test_hooks::take(test_hooks::kAllocEventPoolReserve)) throw std::bad_alloc();
+  if (de.free.capacity() < de.created + 1) de.free.reserve(std::max<size_t>(2 * de.free.capacity(), de.created + 1));
+  QuietDeviceGuard g(device);
+  cudaEvent_t ev = nullptr;
+  cudaError_t r = g.ok() ? cudaEventCreateWithFlags(&ev, cudaEventDisableTiming) : g.error();
+  if (r != cudaSuccess) {
+    cudaGetLastError();
+    std::ostringstream os;
+    os << "tc_signal: cannot create the completion event on CUDA device " << device << ": " << cudaGetErrorName(r)
+       << ": " << cudaGetErrorString(r);
+    throw std::runtime_error(os.str());
+  }
+  ++de.created;
+  return ev;
+}
+
+}  // namespace
+
+void init_pending_state() { (void)pending(); }
+
+RetainUntilComplete::RetainUntilComplete(int device, std::initializer_list<Operand*> ops)
+    : device_(device), ops_(ops) {
+  // N3: every allocation the release needs happens here (may throw: then nothing has been launched and the operands
+  // are released at once by their own destructors); the destructor below allocates only for the pending-list push.
+  if (test_hooks::take(test_hooks::kAllocOwnerReserve)) throw std::bad_alloc();
+  owners_.reserve(ops_.size());
+  event_ = acquire_event(device_);  // last: if it throws, nothing else is held and nothing has been launched
+}
+
+RetainUntilComplete::~RetainUntilComplete() {
+  PendingState& st = pending();
+  PendingEntry e;
+  e.device = device_;
+  for (Operand* op : ops_) {
+    if (op == nullptr || !op->present()) continue;
+    e.bytes += op->numel() * static_cast<int64_t>(sizeof(float));  // checked at construction (F03)
+    owners_.push_back(op->take_owner());                           // reserved: no allocation
+  }
+  e.owners = std::move(owners_);
+  cudaError_t r = cudaSuccess;
+  {
+    QuietDeviceGuard g(device_);
+    r = !g.ok() ? g.error()
+                : (test_hooks::take(test_hooks::kCudaEventRecord) ? kTestInjectedCudaError
+                                                                  : cudaEventRecord(event_, cudaStreamLegacy));
+  }
+  if (r == cudaSuccess) {
+    e.event = event_;
+    // N3: the push may allocate (a new deque node); this destructor is noexcept, so a failure must be caught here
+    // and turned into the synchronous fallback below (round-2 review: bad_alloc on the release path terminated).
+    try {
+      if (test_hooks::take(test_hooks::kAllocPendingPush)) throw std::bad_alloc();
+      st.q.push_back(std::move(e));
+      note_push(st, st.q.back());
+    } catch (...) {
+      ++st.push_alloc_failures;
+      r = cudaErrorMemoryAllocation;  // e was not moved (push_back's strong guarantee): use the fallback below
+      e.event = nullptr;
+    }
+  } else {
+    cudaGetLastError();
+  }
+  if (r != cudaSuccess) {
+    // Fallback: no queued event, so synchronize this device's legacy stream; release on success, leak on failure.
+    ++st.fallback_syncs;
+    const cudaError_t sr = sync_device_legacy(device_);
+    if (sr == cudaSuccess) {
+      recycle_event(st, device_, event_);
+      ++st.released_entries;
+      st.released_managers += e.owners.size();
+      for (ManagedOwner& o : e.owners) o.reset();  // N4: a throwing deleter is contained per manager
+    } else {
+      const unsigned long long leaked = leak_entry(st, e);
+      note_release_failure(st, device_, sr, leaked);  // N1: raised by the next synchronize()
+    }
+    return;
+  }
+  if (static_cast<long long>(st.q.size()) > tuning::kPendingMaxEntries || st.bytes > tuning::kPendingMaxBytes) {
+    ++st.bound_drains;
+    const SyncReport rep = sync_and_release_all_impl();
+    if (rep.failed()) note_release_failure(st, rep.first_device(), rep.first_error(), rep.leaked_managers);  // N1
+  }
+}
+
+void drain_completed() noexcept {
+  PendingState& st = pending();
+  while (!st.q.empty()) {
+    const cudaError_t r = cudaEventQuery(st.q.front().event);
+    if (r != cudaSuccess) {
+      // cudaErrorNotReady: still pending (FIFO: later entries wait too). CUDA 12.6 does not leave NotReady in the
+      // last-error slot (ledger receipt); clear it defensively if a runtime ever does. Any other error (a broken
+      // context) leaves the entry for synchronize_and_release_all, which leaks it if the device cannot synchronize.
+      if (r == cudaErrorNotReady && cudaPeekAtLastError() == cudaErrorNotReady) cudaGetLastError();
+      return;
+    }
+    PendingEntry e = std::move(st.q.front());
+    st.q.pop_front();
+    note_pop(st, e);
+    release_entry(st, e);
+  }
+}
+
+void synchronize_and_release_all() {
+  const SyncReport rep = sync_and_release_all_impl();
+  PendingState& st = pending();
+  if (!rep.failed() && st.unreported_count == 0) return;
+  // N1: any CUDA failure is an error of synchronize(), never a success. N3: building the message may allocate; a
+  // bad_alloc here propagates as MemoryError (an error, not a success, and not a terminate). The earlier release-path
+  // failures are cleared only once their message exists, so they are raised exactly once.
+  if (test_hooks::take(test_hooks::kAllocErrorMessage)) throw std::bad_alloc();
+  std::ostringstream os;
+  os << "tc_signal.synchronize: CUDA error, so the release is not reported as a success:";
+  const char* sep = " ";
+  if (rep.query_failed) {
+    os << sep << "the current-device query cudaGetDevice failed (" << cudaGetErrorName(rep.query_error) << ": "
+       << cudaGetErrorString(rep.query_error) << ")";
+    sep = "; ";
+  }
+  for (int i = 0; i < rep.n; ++i) {
+    os << sep << "the legacy stream of device " << rep.dev[i] << " could not be synchronized ("
+       << cudaGetErrorName(rep.err[i]) << ": " << cudaGetErrorString(rep.err[i]) << ")";
+    sep = "; ";
+  }
+  if (rep.unnamed > 0) os << sep << rep.unnamed << " more device failure(s)";
+  if (rep.leaked_managers > 0)
+    os << "; " << rep.leaked_managers
+       << " consumed operand manager(s) still pending there were deliberately leaked, not released";
+  if (st.unreported_count > 0) {
+    os << sep << st.unreported_count << " earlier release-path failure(s) since the last synchronize, the first on device "
+       << st.unreported_device << " (" << cudaGetErrorName(st.unreported_error) << ": "
+       << cudaGetErrorString(st.unreported_error) << "), deliberately leaked " << st.unreported_leaked
+       << " operand manager(s)";
+  }
+  // std::ostream swallows a bad_alloc from its buffer and only sets badbit (a truncated message would follow): report
+  // the allocation failure itself instead.
+  if (!os) throw std::bad_alloc();
+  std::string msg = os.str();
+  st.unreported_count = 0;
+  st.unreported_leaked = 0;
+  st.unreported_device = -1;
+  st.unreported_error = cudaSuccess;
+  throw std::runtime_error(msg);
+}
+
+py::dict pending_stats(bool reset_high_water) {
+  PendingState& st = pending();
+  py::dict d;
+  d["entries"] = static_cast<long long>(st.q.size());
+  d["managers"] = st.managers;
+  d["bytes"] = st.bytes;
+  d["high_water_entries"] = st.high_water_entries;
+  d["high_water_managers"] = st.high_water_managers;
+  d["high_water_bytes"] = st.high_water_bytes;
+  d["retained_entries"] = st.retained_entries;
+  d["released_entries"] = st.released_entries;
+  d["released_managers"] = st.released_managers;
+  d["bound_drains"] = st.bound_drains;
+  d["fallback_syncs"] = st.fallback_syncs;
+  d["leaked_managers"] = st.leaked_managers;
+  d["max_entries"] = tuning::kPendingMaxEntries;
+  d["max_bytes"] = tuning::kPendingMaxBytes;
+  // P1T-FIX2 counters.
+  d["deleter_exceptions"] = deleter_exceptions();           // N4
+  d["push_alloc_failures"] = st.push_alloc_failures;        // N3
+  d["event_recycle_failures"] = st.event_recycle_failures;  // N3
+  d["release_errors"] = st.release_errors;                  // N1
+  d["unreported_release_errors"] = st.unreported_count;     // N1
+  if (reset_high_water) {
+    st.high_water_entries = static_cast<long long>(st.q.size());
+    st.high_water_managers = st.managers;
+    st.high_water_bytes = st.bytes;
+  }
+  return d;
+}
+
+}  // namespace tcs
diff --git a/tc_signal/src/dlpack_operand.h b/tc_signal/src/dlpack_operand.h
new file mode 100644
index 0000000..dacf52c
--- /dev/null
+++ b/tc_signal/src/dlpack_operand.h
@@ -0,0 +1,204 @@
+// DLPack consumer side of tc_signal: turn any DLPack CUDA producer (or a bare capsule) into a validated fp32 operand.
+//
+// Prior art: DLPack (dmlc/dlpack, 2017-; header v1.3 vendored in include/dlpack/dlpack.h) for the DLManagedTensor /
+// DLManagedTensorVersioned ABI and the capsule rules ("dltensor" / "dltensor_versioned", renamed to "used_*" on
+// consumption, consumer calls the deleter); the Python array API standard's data-interchange protocol
+// (`__dlpack__(stream=, max_version=, copy=)`, Consortium for Python Data API Standards, 2021-2023) for the stream
+// argument and the max_version/TypeError fallback, which NumPy's and PyTorch's `from_dlpack` also implement. Ours: the
+// two-phase use (peek shapes for sizing without consuming, then consume and validate everything right before the launch),
+// and the validation set (device, dtype, compact strides with size-1 dimensions free, byte_offset, alignment, output
+// overlap, read-only/copied refusal for written operands).
+#pragma once
+
+#include <dlpack/dlpack.h>
+#include <pybind11/pybind11.h>
+
+#include <cstdint>
+#include <initializer_list>
+#include <string>
+#include <vector>
+
+struct CUevent_st;  // cudaEvent_t is `CUevent_st*` (CUDA driver_types.h); kept opaque in this header
+
+namespace tcs {
+namespace py = pybind11;
+
+// A DLPack capsule for `obj`: `obj` itself when it is a capsule, else `obj.__dlpack__(stream=1, max_version=(1, 3)
+// [, copy=False])`, falling back to `obj.__dlpack__(stream=1)` when the producer rejects the newer keywords with a
+// TypeError (pre-2023 producers). `writable` adds copy=False: a written operand must alias the producer's memory.
+py::object to_capsule(py::handle obj, const char* role, bool writable);
+
+// The DLTensor inside an unconsumed capsule (the capsule keeps ownership). Raises ValueError for a consumed capsule,
+// TypeError for a capsule of another kind.
+const DLTensor* peek(py::handle capsule, const char* role);
+
+// Device / dtype / layout checks shared by peek-time and consume-time validation (raises TypeError/ValueError). Also
+// the F03 (P1T-FIX1) checked arithmetic: rank >= 0, a non-NULL shape array, the element count, the fp32 byte total and
+// data + byte_offset + bytes must not overflow (ValueError). Returns the element count.
+int64_t validate_tensor(const DLTensor* t, const char* role, int ndim);
+
+// F02 (P1T-FIX1): a REQUIRED operand passed as None raises TypeError, before any planning, allocation or consumption.
+// Optional operands (bias, scale, initial state) are the only ones a caller may pass as None.
+void require_operand(py::handle obj, const char* role);
+
+// Owner of one consumed managed tensor (legacy or versioned). Calls the producer's deleter exactly once, in reset() or
+// in the destructor. It is a separate member so that a throw from Operand's constructor (after the capsule has been
+// consumed) still runs it: C++ destroys fully constructed members when a constructor throws.
+struct ManagedOwner {
+  DLManagedTensor* legacy = nullptr;
+  DLManagedTensorVersioned* versioned = nullptr;
+  ManagedOwner() = default;
+  ~ManagedOwner() { reset(); }
+  ManagedOwner(ManagedOwner&& o) noexcept;
+  ManagedOwner& operator=(ManagedOwner&& o) noexcept;
+  ManagedOwner(const ManagedOwner&) = delete;
+  ManagedOwner& operator=(const ManagedOwner&) = delete;
+  // Calls the producer's deleter at most once. P1T-FIX2 (N4): a deleter that throws is contained (caught, counted in
+  // deleter_exceptions()), never std::terminate; the pointer is cleared before the call.
+  void reset() noexcept;
+  // F01: deliberately drop ownership WITHOUT calling the deleter (used only when tc_signal cannot prove the GPU is done
+  // with the memory, e.g. a broken CUDA context: a leak is safe, a release could be a use-after-free).
+  void leak() noexcept {
+    legacy = nullptr;
+    versioned = nullptr;
+  }
+  bool empty() const { return legacy == nullptr && versioned == nullptr; }
+};
+
+// One consumed DLPack operand. Owns the managed tensor (through ManagedOwner) and calls the producer's deleter exactly
+// once: in release() or in the destructor, so every exception path after consumption still returns the tensor to its
+// producer.
+//
+// Absent operands (default-constructed, for an optional None) report present() == false. Reading an absent operand's
+// metadata (dim, ndim, device, numel) raises TypeError instead of dereferencing NULL (F02's second line of defence).
+class Operand {
+ public:
+  Operand() = default;
+  Operand(py::handle capsule, const char* role, int ndim, bool writable);
+  ~Operand();
+  Operand(Operand&& o) noexcept;
+  Operand& operator=(Operand&& o) noexcept;
+  Operand(const Operand&) = delete;
+  Operand& operator=(const Operand&) = delete;
+
+  bool present() const { return t_ != nullptr; }
+  float* data() const { return data_; }
+  int64_t dim(int i) const { return meta()->shape[i]; }
+  int ndim() const { return meta()->ndim; }
+  int device() const { return meta()->device.device_id; }
+  int64_t numel() const;
+  // Validated at construction: begin + numel * 4 does not overflow (F03).
+  uintptr_t byte_begin() const { return reinterpret_cast<uintptr_t>(data_); }
+  uintptr_t byte_end() const { return byte_begin() + static_cast<uintptr_t>(numel_) * sizeof(float); }
+  const char* role() const { return role_; }
+  void release();
+  // F01: hands the consumed manager to the deferred-release list (RetainUntilComplete); the operand becomes absent.
+  ManagedOwner take_owner();
+
+ private:
+  const DLTensor* meta() const;  // t_, or TypeError when absent
+  ManagedOwner owner_;
+  const DLTensor* t_ = nullptr;
+  float* data_ = nullptr;
+  int64_t numel_ = 0;
+  const char* role_ = "";
+};
+
+// ------------------------------------------------------------------------------------------------ deferred release (F01)
+// P1T-FIX1, review finding F01 (BLOCKING): a consumed DLPack manager may be the LAST owner of its memory (a bare capsule,
+// or a producer's temporary copy). Calling its deleter right after the launches let a producer on another stream reuse
+// the block before the legacy stream had read or written it (use-after-free, reproduced by addon_lifetime.py). Now
+// every consumed manager of a call that reached the launch stays alive until the legacy stream has passed that call:
+//   * RetainUntilComplete (constructed right before the launch, destroyed on scope exit, success OR exception after a
+//     partial launch) records one CUDA event on the operand device's legacy stream and moves every operand's manager
+//     into a module-level FIFO pending list together with that event;
+//   * completed entries (cudaEventQuery == cudaSuccess) are released in FIFO order, on the calling host thread with
+//     the GIL held, at the start of the next tc_signal call (drain_completed), in tc_signal.synchronize(), and from an
+//     atexit hook (both: synchronize_and_release_all);
+//   * the list is bounded (tuning.h: kPendingMaxEntries, kPendingMaxBytes); when a push exceeds a bound, the legacy
+//     stream of every pending device is synchronized and the whole list is released;
+//   * deleters are NEVER called from a CUDA host callback (a deleter may call CUDA, e.g. torch's caching allocator);
+//   * if an event cannot be recorded, the legacy stream is synchronized instead; if that also fails (a broken context),
+//     the managers are deliberately leaked: tc_signal cannot prove the GPU is done with them, and a leak is safe where a
+//     release could be a use-after-free.
+// A call refused BEFORE the launch (validation, shape, overlap) still releases its managers immediately: nothing was
+// queued on them.
+//
+// Prior art: PyTorch's `Tensor.record_stream` and its CUDA caching allocator, which defers a block's reuse until CUDA
+// events recorded on every stream that used it have completed, polling them with cudaEventQuery from the allocating
+// host thread (c10/cuda/CUDACachingAllocator.cpp, "insert_events" / "process_events", 2017-; also its EventPool of
+// reusable events); CuPy's memory pool, which keeps freed blocks stream-ordered so a block is reused only in its own
+// stream's order (cupy/cuda/memory.pyx, 2017-); the DLPack consumer contract (dmlc/dlpack: the consumer calls the
+// deleter when it no longer needs the tensor); the CUDA rule that host callbacks must not call CUDA (CUDA Runtime API,
+// cudaLaunchHostFunc). Taken: event-fenced deferred release polled from the host, event reuse. Ours: applying it to
+// consumed DLPack managers on the consumer side, the GIL-held FIFO drain at every tc_signal entry point, the
+// count/bytes bound with a synchronize-and-drain fallback, and the leak-on-unfenceable rule.
+//
+// Construct it AFTER every validation and right BEFORE the first launch: the constructor may still throw (event
+// acquisition), and then nothing has been queued. Its destructor never throws.
+class RetainUntilComplete {
+ public:
+  RetainUntilComplete(int device, std::initializer_list<Operand*> ops);
+  ~RetainUntilComplete();
+  RetainUntilComplete(const RetainUntilComplete&) = delete;
+  RetainUntilComplete& operator=(const RetainUntilComplete&) = delete;
+
+ private:
+  int device_;
+  std::vector<Operand*> ops_;
+  std::vector<ManagedOwner> owners_;  // reserved in the constructor, so the destructor never allocates for it
+  CUevent_st* event_ = nullptr;       // a cudaEvent_t from the per-device pool, acquired in the constructor
+};
+
+// Releases every completed pending entry (FIFO, stops at the first incomplete one). Called first thing by every
+// _tc_signal entry point that takes operands. GIL held.
+void drain_completed() noexcept;
+// Synchronizes the legacy stream of the current device and of every device with pending entries, then releases all
+// entries. P1T-FIX2 (N1): raises RuntimeError naming the CUDA error if the current-device query (cudaGetDevice) or a
+// synchronization failed (that device's entries are leaked, never released), and also for any release-path failure
+// recorded since the last call (a fallback sync or bound drain that failed inside a destructor, which cannot raise);
+// it never reports a CUDA failure as success. N3: allocation-free up to the error message; a bad_alloc while building
+// the message propagates as MemoryError.
+void synchronize_and_release_all();
+// Counters of the pending list (tests, G4 high-water mark), plus the P1T-FIX2 counters (deleter_exceptions,
+// push_alloc_failures, event_recycle_failures, release_errors, unreported_release_errors).
+py::dict pending_stats(bool reset_high_water);
+// P1T-FIX2 (N3): constructs the pending-list state (it allocates) at module import, so no noexcept release path is the
+// first to touch it.
+void init_pending_state();
+// P1T-FIX2 (N4): producer deleters that threw a C++ exception (contained in ManagedOwner::reset), process-wide.
+unsigned long long deleter_exceptions() noexcept;
+
+// TEST HOOKS (P1T-FIX2, N1/N3 regression tests only; not part of the API). Arming a bit makes the NEXT pass through
+// that release-path site fail once: kAlloc* sites throw std::bad_alloc exactly where the real allocation would
+// (simulating an allocation failure there), kCuda* sites report cudaErrorLaunchFailure instead of calling CUDA. The
+// production cost is one relaxed atomic load per site. Prior art: fault injection at named sites (e.g. the Linux
+// kernel's fault-injection framework, failslab / fail_page_alloc; SQLite's OOM test harness, which fails the Nth
+// malloc). Taken: arm-once named failure points. Ours: the site list.
+namespace test_hooks {
+enum : unsigned {
+  kAllocEventPoolReserve = 1u << 0,  // acquire_event: reserving the event's recycle slot (constructor path)
+  kAllocEventRecycle = 1u << 1,      // recycle_event: returning an event to the pool (release path)
+  kAllocPendingPush = 1u << 2,       // ~RetainUntilComplete: pushing the entry onto the pending list (release path)
+  kAllocOwnerReserve = 1u << 3,      // RetainUntilComplete: reserving the owner vector (constructor path)
+  kAllocErrorMessage = 1u << 4,      // synchronize_and_release_all: building the error message
+  kCudaEventRecord = 1u << 5,        // ~RetainUntilComplete: cudaEventRecord (-> fallback sync)
+  kCudaSync = 1u << 6,               // any legacy-stream sync on a release path (fallback, synchronize, bound drain)
+};
+void arm(unsigned bits) noexcept;
+void clear() noexcept;
+unsigned armed() noexcept;
+bool take(unsigned bit) noexcept;  // true once per arming: the site must fail now
+}  // namespace test_hooks
+
+std::vector<int64_t> shape_of(const DLTensor* t);
+std::string shape_str(const std::vector<int64_t>& s);
+
+// Exact-shape check (ValueError).
+void expect_shape(const Operand& op, const std::vector<int64_t>& want);
+// Same CUDA ordinal for every present operand (ValueError); returns the ordinal.
+int common_device(const std::vector<const Operand*>& ops);
+// Byte ranges of `written` and `other` must not overlap (ValueError).
+void expect_disjoint(const Operand& written, const Operand& other);
+
+}  // namespace tcs
diff --git a/tc_signal/src/lstm.cu b/tc_signal/src/lstm.cu
new file mode 100644
index 0000000..6dfbd1f
--- /dev/null
+++ b/tc_signal/src/lstm.cu
@@ -0,0 +1,290 @@
+// tc_signal LSTM (P1T-M3, T4): ONNX LSTM semantics, fp32, deterministic, no atomics, no fast-math.
+//
+// Semantics (ONNX LSTM operator, layout 0, default activations Sigmoid/Tanh/Tanh, no clip, no peepholes,
+// input_forget 0): x [T, N, I]; W [D, 4H, I]; R [D, 4H, H]; B [D, 8H] = [Wb; Rb]; gate blocks along 4H in the ONNX order
+// i, o, f, c (NOT torch's i, f, g, o). Per direction slot d and step:
+//     z  = (x_t . W[d]^T + Wb[d]) + h_{t-1} . R[d]^T + Rb[d]
+//     i  = sigmoid(z_i), o = sigmoid(z_o), f = sigmoid(z_f), c~ = tanh(z_c)
+//     c  = f * c_{t-1} + i * c~,  h = o * tanh(c)
+// D = 2 (bidirectional): slot 0 runs forward, slot 1 runs in reverse; a reverse slot at loop step s reads time
+// T-1-s and writes Y[T-1-s, d]. Y_h / Y_c are the state after each slot's last step.
+//
+// Structure (Project-Voice TENSOR_IMPL_PLAN_P1T.md §5 T4; LD51 amendment A2; order P1T-M3 "Structure"):
+//  1. initial state -> Y_h / Y_c (D2D copy or zero), on the legacy stream;
+//  2. one cublasSgemm per direction for the input projection of ALL steps: G_x[d] = X[T*N, I] . W[d]^T, accumulated
+//     onto G_x pre-filled with Wb[d] (beta = 1; beta = 0 without B);
+//  3. a host C++ loop over the T steps (inside the one _tc_signal call; no Python per step, no per-step DLPack):
+//     one cublasSgemmStridedBatched over the D slots, G_h[d] = h_{t-1}[d] . R[d]^T (h = Y_h), then one fused cell
+//     kernel (adds Rb, activations, c/h update, writes Y_c, Y_h and Y).
+//
+// Numerics contract (TENSOR_IMPL_PLAN_P1T.md §4):
+//  * fp32 everywhere; cuBLAS in CUBLAS_DEFAULT_MATH (never TF32), atomics not allowed, pointer mode host;
+//  * transcendentals are the CUDA math library's accurate expf() and tanhf() (documented max error 2 ulp each); none of
+//    the double-underscore fast intrinsics (exp, tanh, divide) and no fast-math compiler flag (CMakeLists.txt refuses it
+//    for the whole package);
+//  * every element of every kernel is written by exactly one thread with a fixed operation order, and cuBLAS runs with
+//    atomics not allowed on one stream, so two calls on the same inputs are bitwise equal. No atomic adds anywhere.
+//
+// Prior art:
+//  * LSTM: Hochreiter & Schmidhuber, "Long Short-Term Memory" (1997); the forget gate: Gers, Schmidhuber & Cummins,
+//    "Learning to Forget: Continual Prediction with LSTM" (2000). Taken: the cell equations.
+//  * ONNX LSTM operator specification (onnx/docs/Operators.md, LSTM): gate order i,o,f,c, B = [Wb; Rb], the Y / Y_h /
+//    Y_c layouts, the reverse direction. Taken: the semantics, verbatim.
+//  * Input projection hoisted out of the recurrence as one large GEMM over all time steps, leaving only the h . R^T
+//    product inside the step loop: Appleyard, Kocisky & Blunsom, "Optimizing Performance of Recurrent Neural Networks
+//    on GPUs" (2016), the design cuDNN's RNN API uses. Taken: that split. Ours: the plain correctness-first form (one
+//    strided-batched GEMM + one fused cell kernel per step, host loop), with no persistent kernel and no stream overlap.
+//  * Numerically stable logistic sigmoid by splitting on the sign of z (evaluate exp of a non-positive argument only):
+//    standard practice (e.g. the log-sum-exp / softplus folklore; no single source known to me). Taken: the split.
+//  * Row-major GEMM through column-major BLAS by computing C^T = B^T A^T: standard BLAS practice (no single source).
+// The recurrent state kept in the Y_h / Y_c outputs (no separate state scratch) is ours; no prior art known to me.
+#include "lstm_ops.h"
+
+#include <cublas_v2.h>
+#include <cuda_runtime.h>
+
+#include <algorithm>
+#include <sstream>
+#include <stdexcept>
+#include <string>
+#include <unordered_map>
+
+#include "lstm_tuning.h"
+
+#ifdef CUDA_API_PER_THREAD_DEFAULT_STREAM
+#error "tc_signal queues on the legacy default stream (stream 0); do not build it with --default-stream per-thread"
+#endif
+
+namespace tcs {
+
+namespace {
+
+// Stream 0 is the legacy default stream in this translation unit (per-thread default stream refused above): the stream
+// TensorCUDA queues on and the stream DLPack producers were asked to order against (stream=1).
+constexpr cudaStream_t kLegacyStream = 0;
+
+// ONNX LSTM gate block indices along the 4H axis (Operators.md, LSTM: "iofc").
+constexpr int64_t kGateI = 0;
+constexpr int64_t kGateO = 1;
+constexpr int64_t kGateF = 2;
+constexpr int64_t kGateC = 3;
+
+void check_cuda(cudaError_t e, const char* what) {
+  if (e != cudaSuccess) {
+    std::ostringstream os;
+    os << "tc_signal.lstm: " << what << " failed: " << cudaGetErrorName(e) << ": " << cudaGetErrorString(e);
+    throw std::runtime_error(os.str());
+  }
+}
+
+// Checked after every kernel launch and cuBLAS call (launch-configuration and sticky errors surface as RuntimeError).
+void check_launch(const char* what) { check_cuda(cudaGetLastError(), what); }
+
+void check_cublas(cublasStatus_t s, const char* what) {
+  if (s != CUBLAS_STATUS_SUCCESS) {
+    std::ostringstream os;
+    os << "tc_signal.lstm: " << what << " failed: cuBLAS status " << static_cast<int>(s);
+    throw std::runtime_error(os.str());
+  }
+}
+
+unsigned int grid_for(int64_t total, int block) {
+  const int64_t blocks = (total + block - 1) / block;
+  return static_cast<unsigned int>(std::max<int64_t>(1, std::min<int64_t>(blocks, lstm_tuning::kGridCap)));
+}
+
+// Makes `device` current for the call and restores the caller's device afterwards. (M2's DeviceGuard in conv.cu has
+// internal linkage and the order forbids editing conv.cu, so this is a copy.)
+class DeviceGuard {
+ public:
+  explicit DeviceGuard(int device) {
+    check_cuda(cudaGetDevice(&prev_), "cudaGetDevice");
+    if (prev_ != device) {
+      check_cuda(cudaSetDevice(device), "cudaSetDevice");
+      changed_ = true;
+    }
+  }
+  ~DeviceGuard() {
+    if (changed_) cudaSetDevice(prev_);
+  }
+  DeviceGuard(const DeviceGuard&) = delete;
+  DeviceGuard& operator=(const DeviceGuard&) = delete;
+
+ private:
+  int prev_ = 0;
+  bool changed_ = false;
+};
+
+// cuBLAS handle: one per device, created lazily on first use and kept for the life of the process (destroying it at
+// interpreter exit can race CUDA's own teardown), with M2's exact settings: legacy stream, CUBLAS_DEFAULT_MATH (never
+// TF32), atomics not allowed, pointer mode host. M2's handle_for() in conv.cu has internal linkage and the order
+// forbids editing conv.cu, so the LSTM keeps its own handle (deviation, P1T_M3_REPORT.md). All entry points run under
+// the GIL, so no extra lock is needed. cuBLAS allocates its own internal workspace for this handle (cudaMalloc inside
+// cuBLAS); that is the only device memory the LSTM causes to be allocated outside the caller's allocator.
+cublasHandle_t lstm_handle_for(int device) {
+  static std::unordered_map<int, cublasHandle_t> handles;
+  auto it = handles.find(device);
+  if (it != handles.end()) return it->second;
+  cublasHandle_t h = nullptr;
+  check_cublas(cublasCreate(&h), "cublasCreate");
+  check_cublas(cublasSetStream(h, kLegacyStream), "cublasSetStream(0)");
+  check_cublas(cublasSetMathMode(h, CUBLAS_DEFAULT_MATH), "cublasSetMathMode(CUBLAS_DEFAULT_MATH)");
+  check_cublas(cublasSetAtomicsMode(h, CUBLAS_ATOMICS_NOT_ALLOWED), "cublasSetAtomicsMode(NOT_ALLOWED)");
+  check_cublas(cublasSetPointerMode(h, CUBLAS_POINTER_MODE_HOST), "cublasSetPointerMode(HOST)");
+  handles.emplace(device, h);
+  return h;
+}
+
+// ------------------------------------------------------------------------------------------------ device functions
+// Logistic sigmoid, stable for large |z|: exp is only ever evaluated at a non-positive argument, so it never overflows
+// (z >= 0: 1 / (1 + e^{-z}); z < 0: e^{z} / (1 + e^{z})). expf is the CUDA math library's accurate expf (2 ulp max),
+// never the fast intrinsic. Prior art: the standard sign split (see the file header).
+__device__ __forceinline__ float sigmoid_stable(float z) {
+  if (z >= 0.0f) return 1.0f / (1.0f + expf(-z));
+  const float e = expf(z);
+  return e / (1.0f + e);
+}
+
+// ------------------------------------------------------------------------------------------------ kernels
+// G_x[d, r, q] = Wb[d, q] for every projected row r in [0, T*N) and q in [0, 4H): the bias the input-projection GEMM
+// then accumulates onto (beta = 1). One thread per element, a plain copy.
+__global__ void lstm_bias_fill_kernel(float* __restrict__ gx, const float* __restrict__ B, int64_t D, int64_t rows,
+                                      int64_t H4, int64_t bias_row) {
+  const int64_t total = D * rows * H4;
+  for (int64_t i = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; i < total;
+       i += static_cast<int64_t>(gridDim.x) * blockDim.x) {
+    const int64_t q = i % H4;
+    const int64_t d = i / (rows * H4);
+    gx[i] = B[d * bias_row + q];
+  }
+}
+
+// One LSTM step for every direction slot at once; one thread per state element idx = (d*N + n)*H + j.
+//   gx: G_x [D, T, N, 4H] (x . W^T + Wb); gh: G_h [D, N, 4H] (h_{t-1} . R^T for this step); B: [D, 8H] or NULL;
+//   h / c: the state [D, N, H] (= Y_h / Y_c), read and written in place by the owning thread only; Y [T, D, N, H].
+// Fixed per-element operation order: z = (gx + gh) + Rb; c = fmaf(f, c_prev, i * c~); h = o * tanhf(c).
+__global__ void lstm_cell_kernel(const float* __restrict__ gx, const float* __restrict__ gh,
+                                 const float* __restrict__ B, float* __restrict__ h, float* __restrict__ c,
+                                 float* __restrict__ Y, int64_t T, int64_t s, int64_t D, int64_t N, int64_t H,
+                                 int64_t first_reverse) {
+  const int64_t H4 = kLstmGates * H;
+  const int64_t total = D * N * H;
+  for (int64_t idx = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; idx < total;
+       idx += static_cast<int64_t>(gridDim.x) * blockDim.x) {
+    const int64_t j = idx % H;
+    const int64_t r = idx / H;
+    const int64_t n = r % N;
+    const int64_t d = r / N;
+    const int64_t tt = (d >= first_reverse) ? (T - 1 - s) : s;   // the reverse slot walks time backwards
+    const float* gxp = gx + ((d * T + tt) * N + n) * H4;
+    const float* ghp = gh + (d * N + n) * H4;
+    float zi = gxp[kGateI * H + j] + ghp[kGateI * H + j];
+    float zo = gxp[kGateO * H + j] + ghp[kGateO * H + j];
+    float zf = gxp[kGateF * H + j] + ghp[kGateF * H + j];
+    float zc = gxp[kGateC * H + j] + ghp[kGateC * H + j];
+    if (B != nullptr) {
+      const float* rb = B + d * (kLstmBiasHalves * H4) + H4;     // Rb[d] = B[d, 4H:8H]
+      zi = zi + rb[kGateI * H + j];
+      zo = zo + rb[kGateO * H + j];
+      zf = zf + rb[kGateF * H + j];
+      zc = zc + rb[kGateC * H + j];
+    }
+    const float ig = sigmoid_stable(zi);
+    const float og = sigmoid_stable(zo);
+    const float fg = sigmoid_stable(zf);
+    const float cg = tanhf(zc);
+    const float cn = fmaf(fg, c[idx], ig * cg);
+    const float hn = og * tanhf(cn);
+    c[idx] = cn;
+    h[idx] = hn;
+    Y[((tt * D + d) * N + n) * H + j] = hn;
+  }
+}
+
+}  // namespace
+
+// ------------------------------------------------------------------------------------------------ LSTM forward
+void lstm_forward(int device, const LstmGeom& g, const float* x, const float* W, const float* R, const float* B,
+                  const float* h0, const float* c0, float* Y, float* Y_h, float* Y_c, float* scratch) {
+  DeviceGuard guard(device);
+  cublasHandle_t hdl = lstm_handle_for(device);
+  const int64_t H4 = kLstmGates * g.H;
+  const int64_t rows = g.T * g.N;                 // projected rows, r = t*N + n
+  const int64_t state = g.D * g.N * g.H;          // elements of Y_h / Y_c
+  const size_t state_bytes = static_cast<size_t>(state) * sizeof(float);
+  float* gx = scratch;                            // [D, T, N, 4H]
+  float* gh = scratch + lstm_gx_numel(g);         // [D, N, 4H]
+  const float one = 1.0f;
+  const float zero = 0.0f;
+
+  // 1. Initial state into the outputs that carry the recurrence.
+  if (h0 != nullptr)
+    check_cuda(cudaMemcpyAsync(Y_h, h0, state_bytes, cudaMemcpyDeviceToDevice, kLegacyStream), "initial_h copy");
+  else
+    check_cuda(cudaMemsetAsync(Y_h, 0, state_bytes, kLegacyStream), "initial_h zero");
+  if (c0 != nullptr)
+    check_cuda(cudaMemcpyAsync(Y_c, c0, state_bytes, cudaMemcpyDeviceToDevice, kLegacyStream), "initial_c copy");
+  else
+    check_cuda(cudaMemsetAsync(Y_c, 0, state_bytes, kLegacyStream), "initial_c zero");
+
+  // 2. Input projection of all steps, one SGEMM per direction (+ Wb through beta = 1 on the pre-filled buffer).
+  //    Row-major G_x[d][rows, 4H] = X[rows, I] . W[d][4H, I]^T, as the column-major product
+  //    G_x^T[4H, rows] = op_T(W_d viewed [I, 4H], ld I) . X^T[I, rows] (ld I): m = 4H, n = rows, k = I, ldc = 4H.
+  float beta_x = zero;
+  if (B != nullptr) {
+    const int64_t total = g.D * rows * H4;
+    lstm_bias_fill_kernel<<<grid_for(total, lstm_tuning::kBiasFillBlock), lstm_tuning::kBiasFillBlock, 0,
+                            kLegacyStream>>>(gx, B, g.D, rows, H4, kLstmBiasHalves * H4);
+    check_launch("lstm_bias_fill_kernel");
+    beta_x = one;
+  }
+  for (int64_t d = 0; d < g.D; ++d) {
+    check_cublas(cublasSgemm(hdl, CUBLAS_OP_T, CUBLAS_OP_N, static_cast<int>(H4), static_cast<int>(rows),
+                             static_cast<int>(g.I), &one, W + d * H4 * g.I, static_cast<int>(g.I), x,
+                             static_cast<int>(g.I), &beta_x, gx + d * rows * H4, static_cast<int>(H4)),
+                 "cublasSgemm (input projection)");
+    check_launch("cublasSgemm (input projection)");
+  }
+
+  // 3. The recurrence: a host loop over steps inside this one call. Per step, one strided-batched SGEMM over the D
+  //    slots, G_h[d][N, 4H] = h[d][N, H] . R[d][4H, H]^T (column-major: m = 4H, n = N, k = H, op_T on R viewed
+  //    [H, 4H] ld H, h viewed [H, N] ld H, ldc = 4H), then the fused cell kernel. Stream order makes step s+1's GEMM
+  //    read the h that step s's cell kernel wrote.
+  const unsigned int cell_grid = grid_for(state, lstm_tuning::kCellBlock);
+  for (int64_t s = 0; s < g.T; ++s) {
+    check_cublas(cublasSgemmStridedBatched(hdl, CUBLAS_OP_T, CUBLAS_OP_N, static_cast<int>(H4), static_cast<int>(g.N),
+                                           static_cast<int>(g.H), &one, R, static_cast<int>(g.H),
+                                           static_cast<long long>(H4 * g.H), Y_h, static_cast<int>(g.H),
+                                           static_cast<long long>(g.N * g.H), &zero, gh, static_cast<int>(H4),
+                                           static_cast<long long>(g.N * H4), static_cast<int>(g.D)),
+                 "cublasSgemmStridedBatched (recurrent)");
+    check_launch("cublasSgemmStridedBatched (recurrent)");
+    lstm_cell_kernel<<<cell_grid, lstm_tuning::kCellBlock, 0, kLegacyStream>>>(gx, gh, B, Y_h, Y_c, Y, g.T, s, g.D,
+                                                                                 g.N, g.H, g.first_reverse);
+    check_launch("lstm_cell_kernel");
+  }
+}
+
+// ------------------------------------------------------------------------------------------------ introspection
+LstmCublasConfig lstm_cublas_config(int device) {
+  DeviceGuard guard(device);
+  cublasHandle_t h = lstm_handle_for(device);
+  cublasMath_t math;
+  cublasAtomicsMode_t atomics;
+  cublasPointerMode_t pmode;
+  cudaStream_t s;
+  check_cublas(cublasGetMathMode(h, &math), "cublasGetMathMode");
+  check_cublas(cublasGetAtomicsMode(h, &atomics), "cublasGetAtomicsMode");
+  check_cublas(cublasGetPointerMode(h, &pmode), "cublasGetPointerMode");
+  check_cublas(cublasGetStream(h, &s), "cublasGetStream");
+  LstmCublasConfig c;
+  c.math_mode = static_cast<int>(math);
+  c.atomics_mode = static_cast<int>(atomics);
+  c.pointer_mode = static_cast<int>(pmode);
+  c.legacy_stream = (s == kLegacyStream);
+  c.default_math = (math == CUBLAS_DEFAULT_MATH);
+  c.atomics_not_allowed = (atomics == CUBLAS_ATOMICS_NOT_ALLOWED);
+  return c;
+}
+
+}  // namespace tcs
