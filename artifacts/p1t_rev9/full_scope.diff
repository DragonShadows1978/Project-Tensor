+class DLDevice(C.Structure): _fields_ = [('device_type', C.c_int32), ('device_id', C.c_int32)]
+class DLDataType(C.Structure): _fields_ = [('code', C.c_uint8), ('bits', C.c_uint8), ('lanes', C.c_uint16)]
+class DLTensor(C.Structure):
