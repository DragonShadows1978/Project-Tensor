+def _overlap_convt_out_is_b():
+    st = torch.zeros(1000, device='cuda')
+    b = st[:3]
+    out = st[:3 * 42].view(1, 3, 42)      # convT x [1,8,20] s2 K4 -> T_out 42
+    return ts.conv_transpose1d(_t(1, 8, 20), _t(8, 3, 4), b, stride=2, out=out)
