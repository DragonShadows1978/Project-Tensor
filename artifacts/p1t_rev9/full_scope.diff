+def _ref_conv1d(x, w, b, **kw):
+    return conv1d_f64(x, w, b, stride=kw.get('stride', 1), pads=kw.get('padding', (0, 0)),
+                      dilation=kw.get('dilation', 1), groups=kw.get('groups', 1))
