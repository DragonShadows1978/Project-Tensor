+# ================================================================================================== N2
+_N2_PLANS = r'''
+import ctypes as C, json, sys
+from tc_signal import _tc_signal as n
+newcap = C.pythonapi['PyCapsule_New']
+newcap.argtypes = [C.c_void_p, C.c_char_p, C.c_void_p]
