+void export_deleter_legacy(DLManagedTensor* self) {
+  delete static_cast<DLPackExportCtx*>(self->manager_ctx);
+}
+void export_deleter_versioned(DLManagedTensorVersioned* self) {
+  delete static_cast<DLPackExportCtx*>(self->manager_ctx);
