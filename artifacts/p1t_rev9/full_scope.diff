+    if deleter is not None:
+        m.deleter = deleter
+    t = m.dl_tensor
+    t.data, t.device, t.dtype, t.ndim, t.shape = data, P.DLDevice(2, 0), P.DLDataType(2, 32, 1), 1, SH
