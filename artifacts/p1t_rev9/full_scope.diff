new file mode 100644
index 0000000..ac37f4c
--- /dev/null
+++ b/tc_signal/tests/fix2_native_harness.cpp
@@ -0,0 +1,361 @@
+// P1T-FIX2 native harness for tc_signal's release paths (N3) and checked shape arithmetic (N2). Compiled and run by
+// tests/test_fix2_findings.py (it is not part of the package). It compiles the REAL tc_signal/src/dlpack_operand.cpp
+// into this executable, as the round-2 reviewer's probe artifacts/p1t_rev2/probes/cpu_native.cpp does, with UBSan
+// (-fsanitize=undefined -fno-sanitize-recover=undefined) and a replaced global operator new.
+//
+// Modes:
+//   oom_sweep   N3, real allocation failure, swept. For each release path (the RetainUntilComplete destructor, i.e.
+//               the pending-list push and the bound drain; drain_completed; synchronize_and_release_all) and each
+//               pre-filled list length (0..23 entries, which crosses std::deque node boundaries, and 1024, which makes
+//               the next push a bound drain), it first COUNTS the global operator-new calls the path makes, then
+//               re-runs it once per k = 1..count with the k-th allocation failing (std::bad_alloc), in fresh state.
+//               Invariants per run: the process survives (no std::terminate), no deleter is called twice, and after an
+//               unarmed cleanup every consumed manager was released exactly once or deliberately leaked (counted).
+//               No kernel is launched: the operands are real cudaMalloc memory, the events and syncs are real.
+//   ck_census   N2. tc_signal's checked_math.h (ck_prod, ck_shape_numel) and validate_tensor on zero-extent shapes
+//               next to 2^62 and 2^63-1 extents (zero first / middle / last): each must be REFUSED with ValueError and
+//               raise no UBSan diagnostic; control shapes must be accepted with the right count.
+// Output: one JSON object per line; the last line is {"summary": ...}; exit 0 iff every invariant held.
+//
+// Prior art: SQLite's out-of-memory test harness (its test allocator fails the Nth malloc, swept over N) and the
+// Linux kernel's failslab fault injection; the round-2 reviewer's cpu_native.cpp (operator new replacement that fails
+// the next allocation). Taken: fail-the-Nth-allocation sweeps through a replaced allocator. Ours: the release-path
+// list, the pre-fill lengths and the release-or-leak-exactly-once invariant. UBSan: GCC/Clang (2013-).
+#include <pybind11/embed.h>
+
+#include <cuda_runtime.h>
+
+#include <atomic>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <new>
+#include <string>
+#include <vector>
+
+namespace {
+std::atomic<bool> g_counting{false};
+std::atomic<long> g_countdown{0};  // > 0: the countdown-th allocation from arming fails
+std::atomic<long> g_allocs{0};     // allocations seen while counting
+std::atomic<bool> g_hit{false};    // the armed allocation was reached (and failed)
+}  // namespace
+
+void* operator new(std::size_t n) {
+  if (g_counting.load(std::memory_order_relaxed)) {
+    g_allocs.fetch_add(1, std::memory_order_relaxed);
+    if (g_countdown.load(std::memory_order_relaxed) > 0 && g_countdown.fetch_sub(1) == 1) {
+      g_hit.store(true);
+      throw std::bad_alloc();
+    }
+  }
+  if (void* p = std::malloc(n ? n : 1)) return p;
+  throw std::bad_alloc();
+}
+void* operator new[](std::size_t n) { return operator new(n); }
+void operator delete(void* p) noexcept { std::free(p); }
+void operator delete[](void* p) noexcept { std::free(p); }
+void operator delete(void* p, std::size_t) noexcept { std::free(p); }
+void operator delete[](void* p, std::size_t) noexcept { std::free(p); }
+
+// The unchanged implementation under test (resolved through -I<tree>/tc_signal/src).
+#include "dlpack_operand.cpp"
+
+namespace {
+namespace py = pybind11;
+
+void arm_count() {
+  g_allocs = 0;
+  g_countdown = 0;
+  g_hit = false;
+  g_counting = true;
+}
+void arm_fail(long k) {
+  g_allocs = 0;
+  g_hit = false;
+  g_countdown = k;
+  g_counting = true;
+}
+void disarm() {
+  g_counting = false;
+  g_countdown = 0;
+}
+
+// ------------------------------------------------------------------------------------------------ managers
+constexpr int kMaxManagers = 2 * 1100;
+DLManagedTensorVersioned g_mgr[kMaxManagers];
+int64_t g_shape[kMaxManagers];
+int g_calls[kMaxManagers];
+bool g_consumed[kMaxManagers];
+int g_next = 0;
+float* g_dev = nullptr;
+
+extern "C" void count_deleter(DLManagedTensorVersioned* m) {
+  g_calls[reinterpret_cast<intptr_t>(m->manager_ctx)] += 1;
+}
+
+void reset_managers() {
+  for (int i = 0; i < kMaxManagers; ++i) {
+    g_calls[i] = 0;
+    g_consumed[i] = false;
+  }
+  g_next = 0;
+}
+
+// A legal fp32 CUDA operand of shape [1] over the device buffer; its deleter counts calls.
+py::object make_capsule(int& idx) {
+  idx = g_next++;
+  DLManagedTensorVersioned& m = g_mgr[idx];
+  std::memset(&m, 0, sizeof m);
+  m.version.major = 1;
+  m.version.minor = 3;
+  m.manager_ctx = reinterpret_cast<void*>(static_cast<intptr_t>(idx));
+  m.deleter = count_deleter;
+  g_shape[idx] = 1;
+  m.dl_tensor.data = g_dev + idx;
+  m.dl_tensor.device.device_type = kDLCUDA;
+  m.dl_tensor.device.device_id = 0;
+  m.dl_tensor.ndim = 1;
+  m.dl_tensor.dtype.code = kDLFloat;
+  m.dl_tensor.dtype.bits = 32;
+  m.dl_tensor.dtype.lanes = 1;
+  m.dl_tensor.shape = &g_shape[idx];
+  m.dl_tensor.strides = nullptr;
+  PyObject* c = PyCapsule_New(&m, "dltensor_versioned", nullptr);
+  if (c == nullptr) throw py::error_already_set();
+  return py::reinterpret_steal<py::object>(c);
+}
+
+// One call's worth of consumed operands (x read, out written) handed to the pending list, unarmed.
+void push_entry() {
+  int ia = 0, ib = 0;
+  py::object ca = make_capsule(ia), cb = make_capsule(ib);
+  {
+    tcs::Operand a(ca, "x", 1, false);
+    tcs::Operand b(cb, "out", 1, true);
+    g_consumed[ia] = g_consumed[ib] = true;
+    tcs::RetainUntilComplete keep(0, {&a, &b});
+  }
+}
+
+unsigned long long leaked_now() { return tcs::pending_stats(false)["leaked_managers"].cast<unsigned long long>(); }
+
+struct RunResult {
+  bool ok = true;
+  std::string why;
+  long allocs = 0;
+  bool hit = false;
+  std::string exc;
+};
+
+// Runs `path` once with pre-fill `prefill` and fail-at `k` (0 = count only).
+RunResult run_once(const std::string& path, int prefill, long k) {
+  RunResult r;
+  reset_managers();
+  try {
+    tcs::synchronize_and_release_all();
+  } catch (...) {
+  }
+  reset_managers();
+  const unsigned long long leaked0 = leaked_now();
+  for (int i = 0; i < prefill; ++i) push_entry();
+  // every pre-filled event is complete (no kernel was launched). P1T-FIX4 sweep: the result is checked (it was ignored).
+  if (const cudaError_t se = cudaStreamSynchronize(cudaStreamLegacy); se != cudaSuccess) {
+    cudaGetLastError();
+    r.ok = false;
+    r.why = std::string("harness pre-drain cudaStreamSynchronize failed: ") + cudaGetErrorName(se);
+    return r;
+  }
+  int ia = 0, ib = 0;
+  py::object ca, cb;
+  if (path == "dtor") {
+    ca = make_capsule(ia);
+    cb = make_capsule(ib);
+  }
+  try {
+    if (path == "dtor") {
+      tcs::Operand a(ca, "x", 1, false);
+      tcs::Operand b(cb, "out", 1, true);
+      g_consumed[ia] = g_consumed[ib] = true;
+      tcs::RetainUntilComplete keep(0, {&a, &b});
+      if (k > 0) arm_fail(k); else arm_count();
+    } else if (path == "drain") {
+      if (k > 0) arm_fail(k); else arm_count();
+      tcs::drain_completed();
+    } else {
+      if (k > 0) arm_fail(k); else arm_count();
+      tcs::synchronize_and_release_all();
+    }
+    disarm();
+  } catch (const std::bad_alloc&) {
+    disarm();
+    r.exc = "bad_alloc";
+  } catch (const std::exception& e) {
+    disarm();
+    r.exc = std::string("exception: ") + e.what();
+  }
+  r.allocs = g_allocs.load();
+  r.hit = g_hit.load();
+  for (int i = 0; i < g_next; ++i)
+    if (g_calls[i] > 1) {
+      r.ok = false;
+      r.why = "deleter called twice";
+    }
+  try {
+    tcs::synchronize_and_release_all();  // unarmed cleanup
+  } catch (const std::exception& e) {
+    r.ok = false;
+    r.why = std::string("cleanup synchronize raised: ") + e.what();
+  }
+  const unsigned long long leaked = leaked_now() - leaked0;
+  unsigned long long consumed = 0, called = 0;
+  for (int i = 0; i < g_next; ++i) {
+    if (g_consumed[i]) ++consumed;
+    if (g_calls[i] > 1) {
+      r.ok = false;
+      r.why = "deleter called twice";
+    }
+    if (!g_consumed[i] && g_calls[i] != 0) {
+      r.ok = false;
+      r.why = "deleter of an unconsumed manager called";
+    }
+    called += static_cast<unsigned long long>(g_calls[i]);
+  }
+  if (called + leaked != consumed) {
+    r.ok = false;
+    r.why = "released + leaked (" + std::to_string(called) + " + " + std::to_string(leaked) + ") != consumed (" +
+            std::to_string(consumed) + ")";
+  }
+  return r;
+}
+
+int oom_sweep() {
+  if (cudaMalloc(&g_dev, sizeof(float) * kMaxManagers) != cudaSuccess) {
+    std::printf("{\"error\": \"cudaMalloc failed\"}\n");
+    return 2;
+  }
+  tcs::pending_stats(false);  // construct the pending state before any arming (as the reviewer's probe)
+  int runs = 0, failures = 0;
+  long hits_dtor = 0, hits_other = 0, allocs_drain_sync = 0;
+  std::vector<int> prefills;
+  for (int p = 0; p <= 23; ++p) prefills.push_back(p);  // crosses std::deque node boundaries (10 entries per node)
+  prefills.push_back(static_cast<int>(tcs::tuning::kPendingMaxEntries));  // the next push is a bound drain
+  for (const char* path : {"dtor", "drain", "sync"}) {
+    const bool is_dtor = std::strcmp(path, "dtor") == 0;
+    for (int p : prefills) {
+      const RunResult c = run_once(path, p, 0);
+      ++runs;
+      if (!c.ok) ++failures;
+      if (!is_dtor) allocs_drain_sync += c.allocs;
+      std::printf("{\"path\": \"%s\", \"prefill\": %d, \"k\": 0, \"allocs\": %ld, \"ok\": %s, \"why\": \"%s\"}\n", path,
+                  p, c.allocs, c.ok ? "true" : "false", c.why.c_str());
+      // Where the path allocates depends on the deque's internal node offset, which differs from run to run, so k
+      // sweeps at least 1..2 whatever the count run saw; a run whose k-th allocation did not happen is still checked.
+      const long kmax = c.allocs > 2 ? c.allocs : 2;
+      for (long k = 1; k <= kmax; ++k) {
+        const RunResult r = run_once(path, p, k);
+        ++runs;
+        if (!r.ok) ++failures;
+        if (r.hit) (is_dtor ? hits_dtor : hits_other) += 1;
+        std::printf(
+            "{\"path\": \"%s\", \"prefill\": %d, \"k\": %ld, \"hit\": %s, \"exception\": \"%s\", \"ok\": %s, "
+            "\"why\": \"%s\"}\n",
+            path, p, k, r.hit ? "true" : "false", r.exc.c_str(), r.ok ? "true" : "false", r.why.c_str());
+      }
+      std::fflush(stdout);
+    }
+  }
+  py::dict st = tcs::pending_stats(false);
+  // Pass: no invariant failed, the destructor's allocation (the pending-list push) was actually failed at least once,
+  // and drain_completed / synchronize_and_release_all made no allocation at all on the success path.
+  const bool pass = failures == 0 && hits_dtor > 0 && allocs_drain_sync == 0;
+  std::printf("{\"summary\": {\"mode\": \"oom_sweep\", \"runs\": %d, \"failures\": %d, \"injected_in_dtor\": %ld, "
+              "\"injected_elsewhere\": %ld, \"allocs_in_drain_and_sync\": %ld, \"push_alloc_failures\": %llu, "
+              "\"fallback_syncs\": %llu, \"leaked_managers\": %llu, \"pass\": %s}}\n",
+              runs, failures, hits_dtor, hits_other, allocs_drain_sync,
+              st["push_alloc_failures"].cast<unsigned long long>(), st["fallback_syncs"].cast<unsigned long long>(),
+              st["leaked_managers"].cast<unsigned long long>(), pass ? "true" : "false");
+  return pass ? 0 : 1;
+}
+
+// ------------------------------------------------------------------------------------------------ ck_census (N2)
+int ck_census() {
+  const int64_t P62 = int64_t{1} << 62, P61 = int64_t{1} << 61, MAX = INT64_MAX;
+  const std::vector<std::vector<int64_t>> refuse = {
+      {0, P62, 4}, {P62, 0, 4}, {P62, 4, 0},          // element bound 2^64
+      {0, MAX, 2}, {MAX, 2, 0}, {2, 0, MAX},          // element bound 2^64 - 2
+      {0, MAX}, {MAX, 0}, {0, MAX, 1}, {1, 0, MAX},   // element bound fits, fp32 bytes overflow
+      {0, P62}, {P62, 0}, {0, P61}, {P61, 0, 1},      // bytes 2^64 / 2^63
+  };
+  const std::vector<std::pair<std::vector<int64_t>, int64_t>> accept = {
+      {{0, int64_t{1} << 20, 4}, 0}, {{2, 3, 4}, 24}, {{0, int64_t{1} << 60}, 0}, {{}, 1}};
+  int failures = 0, cases = 0;
+  auto refused = [](auto&& fn, std::string& msg) {
+    try {
+      fn();
+    } catch (const py::value_error& e) {
+      msg = e.what();
+      return true;
+    } catch (const py::error_already_set& e) {
+      msg = e.what();
+      return true;
+    }
+    return false;
+  };
+  for (const auto& s : refuse) {
+    std::string m1, m2, m3;
+    const bool r1 = refused([&] { tcs::ck_shape_numel(s, "census ck_shape_numel"); }, m1);
+    const bool r2 = refused([&] { tcs::ck_prod(s, 0, s.size(), "census ck_prod"); }, m2);
+    // validate_tensor on a descriptor (never dereferenced beyond its shape): must refuse, as an OVERFLOW.
+    DLTensor t{};
+    std::vector<int64_t> shape = s;
+    t.data = reinterpret_cast<void*>(0x1000);
+    t.device.device_type = kDLCUDA;
+    t.device.device_id = 0;
+    t.ndim = static_cast<int>(shape.size());
+    t.dtype.code = kDLFloat;
+    t.dtype.bits = 32;
+    t.dtype.lanes = 1;
+    t.shape = shape.data();
+    const bool r3 = refused([&] { tcs::validate_tensor(&t, "census", t.ndim); }, m3);
+    const bool r3_overflow = r3 && m3.find("overflows") != std::string::npos;
+    // ck_prod checks the element bound only (byte-only cases are refused by ck_shape_numel / validate_tensor).
+    bool elem_overflow = false;
+    {
+      int64_t p = 1;
+      for (int64_t e : s) elem_overflow |= __builtin_mul_overflow(p, e > 1 ? e : 1, &p);
+    }
+    const bool ok = r1 && (r2 == elem_overflow) && r3_overflow;
+    ++cases;
+    if (!ok) ++failures;
+    std::printf("{\"shape\": \"%s\", \"ck_shape_numel_refused\": %s, \"ck_prod_refused\": %s, "
+                "\"ck_prod_expected_refused\": %s, \"validate_refused_as_overflow\": %s, \"validate_msg\": \"%s\", "
+                "\"ok\": %s}\n",
+                tcs::shape_str(s).c_str(), r1 ? "true" : "false", r2 ? "true" : "false",
+                elem_overflow ? "true" : "false", r3_overflow ? "true" : "false", m3.c_str(), ok ? "true" : "false");
+  }
+  for (const auto& a : accept) {
+    std::string m;
+    int64_t n = -1;
+    const bool r = refused([&] { n = tcs::ck_shape_numel(a.first, "census control"); }, m);
+    const bool ok = !r && n == a.second;
+    ++cases;
+    if (!ok) ++failures;
+    std::printf("{\"control\": \"%s\", \"count\": %lld, \"expected\": %lld, \"ok\": %s}\n",
+                tcs::shape_str(a.first).c_str(), static_cast<long long>(n), static_cast<long long>(a.second),
+                ok ? "true" : "false");
+  }
+  std::printf("{\"summary\": {\"mode\": \"ck_census\", \"cases\": %d, \"failures\": %d}}\n", cases, failures);
+  return failures == 0 ? 0 : 1;
+}
+}  // namespace
+
+int main(int argc, char** argv) {
+  py::scoped_interpreter python{};
+  if (argc != 2) return 2;
+  int rc = 2;
+  if (std::strcmp(argv[1], "oom_sweep") == 0) rc = oom_sweep();
+  if (std::strcmp(argv[1], "ck_census") == 0) rc = ck_census();
+  std::fflush(stdout);
+  return rc;
+}
diff --git a/tc_signal/tests/fix3_native_harness.cpp b/tc_signal/tests/fix3_native_harness.cpp
new file mode 100644
index 0000000..f62f23d
--- /dev/null
+++ b/tc_signal/tests/fix3_native_harness.cpp
@@ -0,0 +1,319 @@
+// P1T-FIX3 native harness for round-3 review finding V3-02 (aggregate deferred-release byte accounting). Compiled and
+// run by tests/test_fix3_findings.py (it is not part of the package). It compiles the REAL tc_signal/src/dlpack_operand.cpp
+// into this executable, as the round-3 reviewer's probe artifacts/p1t_rev3/probes/pending_bytes.cpp does, with UBSan
+// (-fsanitize=undefined -fno-sanitize-recover=undefined): any signed overflow aborts the run with a diagnostic.
+//
+// Modes:
+//   accounting  No CUDA call. The saturating pending-list total (note_push / note_pop) and the bound comparison
+//               (pending_over_bound) on a local PendingState whose queue holds real PendingEntry objects:
+//                 * the reviewer's queue case (4 + 9223372036854775804) saturates at INT64_MAX, is over the bound,
+//                   stays pinned while entries remain, and returns to an exact 0 when the list empties;
+//                 * an exact sum of exactly INT64_MAX is not saturated; one more byte saturates;
+//                 * the bound at the boundary: a total of exactly kPendingMaxBytes is within it, 4 more bytes are
+//                   over it (fp32 granularity), and popping back returns within it; kPendingMaxEntries entries are
+//                   within the entry bound, one more is over it;
+//                 * aggregate_operand_bytes on real Operands (synthetic descriptors, never dereferenced): the reviewer's
+//                   two disjoint (2^61-1,) fp32 operands are REFUSED (ValueError, "overflows"), as are three (2^60,)
+//                   ones; two (2^60-1,) ones sum exactly to 2^63-8.
+//   dtor        Real CUDA events and syncs, NO kernel launch (the operands' fake addresses are never dereferenced):
+//               the real RetainUntilComplete constructor and destructor near INT64_MAX:
+//                 * D1: a queued 8-byte entry plus a (2^60-1, 2^60-1) call (2^63-8 bytes, accepted): the push would
+//                   overflow -> saturated -> bound drain -> every manager released exactly once, the total back to an
+//                   exact 0 and unsaturated;
+//                 * D2: the reviewer's (2^61-1, 2^61-1) pair is refused by the CONSTRUCTOR (ValueError) before anything
+//                   is queued; both managers are released at once by the operands' own destructors;
+//                 * D3: entries totalling exactly kPendingMaxBytes stay queued (no drain); the next 4-byte call drains.
+// Output: one JSON object per line; the last line is {"summary": ...}; exit 0 iff every check held.
+//
+// Prior art: the round-3 reviewer's pending_bytes.cpp (actual Operand validation and note_push under UBSan; its two
+// boundary cases are reused here); saturating arithmetic (DSP/SIMD saturated add) and the checked builtins (GCC 5, 2015;
+// C23 ckd_add); UBSan (GCC/Clang, 2013-). Ours: the pop/empty sequence, the boundary cases and the real-destructor runs.
+#include <pybind11/embed.h>
+
+#include <cuda_runtime.h>
+
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <limits>
+#include <string>
+#include <vector>
+
+// The implementation under test (resolved through -I<tree>/tc_signal/src).
+#include "dlpack_operand.cpp"
+
+namespace {
+namespace py = pybind11;
+
+int g_cases = 0;
+int g_failures = 0;
+
+void check(const char* name, bool ok, const std::string& detail = "") {
+  ++g_cases;
+  if (!ok) ++g_failures;
+  std::printf("{\"case\": \"%s\", \"ok\": %s, \"detail\": \"%s\"}\n", name, ok ? "true" : "false", detail.c_str());
+  std::fflush(stdout);
+}
+
+constexpr int64_t kMax = std::numeric_limits<int64_t>::max();
+
+// ------------------------------------------------------------------------------------------------ accounting
+void push(tcs::PendingState& st, int64_t bytes) {
+  tcs::PendingEntry e;
+  e.bytes = bytes;
+  st.q.push_back(std::move(e));
+  tcs::note_push(st, st.q.back());  // as ~RetainUntilComplete does
+}
+
+void pop(tcs::PendingState& st) {
+  tcs::PendingEntry e = std::move(st.q.front());
+  st.q.pop_front();
+  tcs::note_pop(st, e);  // as drain_completed / sync_and_release_all_impl do
+}
+
+std::string state(const tcs::PendingState& st) {
+  return "bytes=" + std::to_string(st.bytes) + " saturated=" + (st.bytes_saturated ? "1" : "0") +
+         " entries=" + std::to_string(st.q.size()) + " over=" + (tcs::pending_over_bound(st) ? "1" : "0");
+}
+
+// Synthetic legacy managers (no deleter: nothing to release) over fake, never-dereferenced addresses.
+struct Desc {
+  DLManagedTensor m{};
+  int64_t shape = 0;
+};
+
+py::object capsule(Desc& d, int64_t n, uintptr_t addr) {
+  d.shape = n;
+  d.m.dl_tensor.data = reinterpret_cast<void*>(addr);
+  d.m.dl_tensor.device = {kDLCUDA, 0};
+  d.m.dl_tensor.ndim = 1;
+  d.m.dl_tensor.dtype = {kDLFloat, 32, 1};
+  d.m.dl_tensor.shape = &d.shape;
+  d.m.dl_tensor.strides = nullptr;
+  d.m.dl_tensor.byte_offset = 0;
+  PyObject* c = PyCapsule_New(&d.m, "dltensor", nullptr);
+  if (c == nullptr) throw py::error_already_set();
+  return py::reinterpret_steal<py::object>(c);
+}
+
+int accounting() {
+  {  // the reviewer's queue case, inside a real queue
+    tcs::PendingState st;
+    push(st, 4);
+    push(st, kMax - 3);  // 4 + 9223372036854775804 overflows int64
+    check("saturates_on_overflowing_push", st.bytes == kMax && st.bytes_saturated && st.bytes_saturations == 1,
+          state(st));
+    check("saturated_total_is_over_the_bound", tcs::pending_over_bound(st), state(st));
+    push(st, kMax);  // further pushes while saturated stay pinned, never overflow
+    check("pushes_while_saturated_stay_pinned", st.bytes == kMax && st.bytes_saturations == 1, state(st));
+    pop(st);
+    check("pop_keeps_saturated_total_pinned_while_entries_remain", st.bytes == kMax && st.bytes_saturated,
+          state(st));
+    pop(st);
+    pop(st);
+    check("empty_list_resets_to_exact_zero", st.bytes == 0 && !st.bytes_saturated && !tcs::pending_over_bound(st),
+          state(st));
+    push(st, 12);
+    check("exact_again_after_reset", st.bytes == 12 && !st.bytes_saturated, state(st));
+  }
+  {  // exact up to INT64_MAX itself; one more byte saturates
+    tcs::PendingState st;
+    push(st, kMax - 10);
+    push(st, 10);
+    check("exact_sum_of_int64_max_is_not_saturated", st.bytes == kMax && !st.bytes_saturated, state(st));
+    pop(st);
+    check("exact_pop_from_int64_max", st.bytes == 10 && !st.bytes_saturated, state(st));
+    push(st, kMax - 10);
+    push(st, 1);
+    check("one_byte_past_int64_max_saturates", st.bytes == kMax && st.bytes_saturated, state(st));
+  }
+  {  // the byte bound at the boundary (fp32 granularity: 4 bytes)
+    tcs::PendingState st;
+    push(st, tcs::tuning::kPendingMaxBytes - 4);
+    push(st, 4);
+    check("total_equal_to_the_byte_bound_is_within_it", st.bytes == tcs::tuning::kPendingMaxBytes &&
+                                                            !tcs::pending_over_bound(st), state(st));
+    push(st, 4);
+    check("four_bytes_over_the_byte_bound_is_over_it", tcs::pending_over_bound(st), state(st));
+    tcs::PendingEntry e = std::move(st.q.back());
+    st.q.pop_back();
+    tcs::note_pop(st, e);
+    check("back_within_the_byte_bound_after_pop", !tcs::pending_over_bound(st), state(st));
+  }
+  {  // the entry bound at the boundary
+    tcs::PendingState st;
+    for (long long i = 0; i < tcs::tuning::kPendingMaxEntries; ++i) push(st, 0);
+    check("entries_equal_to_the_entry_bound_are_within_it", !tcs::pending_over_bound(st), state(st));
+    push(st, 0);
+    check("one_entry_over_the_entry_bound_is_over_it", tcs::pending_over_bound(st), state(st));
+  }
+  {  // the per-call aggregate (pre-launch check) on real Operands
+    const int64_t n61 = (int64_t{1} << 61) - 1, n60 = int64_t{1} << 60;
+    Desc dx, dy, dz;
+    tcs::Operand X(capsule(dx, n61, 4), "x", 1, false), Y(capsule(dy, n61, uintptr_t{1} << 63), "out", 1, true);
+    tcs::expect_disjoint(Y, X);  // individually valid AND disjoint, as the reviewer staged them
+    std::string msg;
+    bool refused = false;
+    try {
+      tcs::aggregate_operand_bytes({&X, &Y});
+    } catch (const py::value_error& e) {
+      refused = true;
+      msg = e.what();
+    }
+    check("aggregate_of_two_2p61m1_operands_refused_as_overflow",
+          refused && msg.find("aggregate") != std::string::npos && msg.find("overflows") != std::string::npos, msg);
+    Desc a, b, c;
+    tcs::Operand A(capsule(a, n60, 0x1000), "x", 1, false), B(capsule(b, n60, 0x1000 + (uintptr_t{1} << 62)), "y", 1,
+                                                                false),
+        C(capsule(c, n60, 0x1000 + (uintptr_t{1} << 63)), "out", 1, true);
+    refused = false;
+    try {
+      tcs::aggregate_operand_bytes({&A, &B, &C});
+    } catch (const py::value_error&) {
+      refused = true;
+    }
+    check("aggregate_of_three_2p60_operands_refused", refused);
+    Desc p, q;
+    tcs::Operand P(capsule(p, n60 - 1, 0x1000), "x", 1, false), Q(capsule(q, n60 - 1, 0x1000 + (uintptr_t{1} << 62)),
+                                                                  "out", 1, true);
+    int64_t sum = -1;
+    try {
+      sum = tcs::aggregate_operand_bytes({&P, &Q, nullptr});
+    } catch (...) {
+    }
+    check("aggregate_that_fits_is_exact", sum == kMax - 7, std::to_string(sum));  // 2^63 - 8
+  }
+  return 0;
+}
+
+// ------------------------------------------------------------------------------------------------ dtor (real CUDA)
+int g_calls[64];
+extern "C" void count_deleter(DLManagedTensor* m) { g_calls[reinterpret_cast<intptr_t>(m->manager_ctx)] += 1; }
+
+struct Managed {
+  DLManagedTensor m{};
+  int64_t shape = 0;
+};
+Managed g_mgr[64];
+int g_next = 0;
+
+py::object counted_capsule(int64_t n, uintptr_t addr, int& idx) {
+  idx = g_next++;
+  Managed& d = g_mgr[idx];
+  d = Managed{};
+  d.shape = n;
+  d.m.manager_ctx = reinterpret_cast<void*>(static_cast<intptr_t>(idx));
+  d.m.deleter = count_deleter;
+  d.m.dl_tensor.data = reinterpret_cast<void*>(addr);
+  d.m.dl_tensor.device = {kDLCUDA, 0};
+  d.m.dl_tensor.ndim = 1;
+  d.m.dl_tensor.dtype = {kDLFloat, 32, 1};
+  d.m.dl_tensor.shape = &d.shape;
+  PyObject* c = PyCapsule_New(&d.m, "dltensor", nullptr);
+  if (c == nullptr) throw py::error_already_set();
+  return py::reinterpret_steal<py::object>(c);
+}
+
+long long stat(const char* k) { return tcs::pending_stats(false)[k].cast<long long>(); }
+bool flag(const char* k) { return tcs::pending_stats(false)[k].cast<bool>(); }
+
+// One "call": consume operands of the given element counts at adjacent, disjoint fake addresses (from 4 up, as the
+// reviewer staged them, so two (2^61-1,) operands end at 2^64-4 without wrapping) and run the real retainer
+// (constructor + destructor), launching nothing. Returns "" or the constructor's ValueError text.
+std::string call(const std::vector<int64_t>& numels, std::vector<int>& idx) {
+  std::vector<py::object> caps;
+  uintptr_t addr = 4;
+  for (int64_t n : numels) {
+    int i = 0;
+    caps.push_back(counted_capsule(n, addr, i));
+    idx.push_back(i);
+    addr += static_cast<uintptr_t>(n) * sizeof(float);
+  }
+  std::vector<tcs::Operand> ops;
+  ops.reserve(caps.size());
+  for (size_t k = 0; k < caps.size(); ++k) ops.emplace_back(caps[k], k + 1 == caps.size() ? "out" : "x", 1, k + 1 == caps.size());
+  try {
+    if (ops.size() == 1) {
+      tcs::RetainUntilComplete keep(0, {&ops[0]});
+    } else {
+      tcs::RetainUntilComplete keep(0, {&ops[0], &ops[1]});
+    }
+  } catch (const py::value_error& e) {
+    return e.what();
+  }
+  return "";
+}
+
+bool all_once(const std::vector<int>& idx) {
+  for (int i : idx)
+    if (g_calls[i] != 1) return false;
+  return true;
+}
+bool all_zero(const std::vector<int>& idx) {
+  for (int i : idx)
+    if (g_calls[i] != 0) return false;
+  return true;
+}
+
+int dtor() {
+  int dev = -1;
+  if (cudaGetDevice(&dev) != cudaSuccess) {
+    std::printf("{\"error\": \"no CUDA device\"}\n");
+    return 2;
+  }
+  tcs::init_pending_state();
+  tcs::synchronize_and_release_all();
+  const int64_t n60m1 = (int64_t{1} << 60) - 1, n61m1 = (int64_t{1} << 61) - 1;
+  {  // D1
+    std::vector<int> small, huge;
+    const long long drains0 = stat("bound_drains"), sat0 = stat("bytes_saturations");
+    const std::string e1 = call({1, 1}, small);
+    const bool queued = stat("entries") == 1 && stat("bytes") == 8 && all_zero(small);
+    const std::string e2 = call({n60m1, n60m1}, huge);  // 8 + (2^63 - 8) would overflow the total
+    check("D1_small_entry_queued", e1.empty() && queued, e1);
+    check("D1_huge_call_accepted_by_the_constructor", e2.empty(), e2);
+    check("D1_saturated_push_drained_the_list", stat("bound_drains") == drains0 + 1 &&
+                                                    stat("bytes_saturations") == sat0 + 1 && stat("entries") == 0,
+          "drains=" + std::to_string(stat("bound_drains") - drains0));
+    check("D1_total_back_to_exact_zero_unsaturated", stat("bytes") == 0 && !flag("bytes_saturated"));
+    check("D1_every_manager_released_exactly_once", all_once(small) && all_once(huge));
+  }
+  {  // D2
+    std::vector<int> pair;
+    const long long retained0 = stat("retained_entries");
+    const std::string e = call({n61m1, n61m1}, pair);
+    check("D2_constructor_refuses_the_reviewer_pair",
+          e.find("aggregate") != std::string::npos && e.find("overflows") != std::string::npos, e);
+    check("D2_nothing_queued", stat("retained_entries") == retained0 && stat("entries") == 0);
+    check("D2_both_managers_released_at_once", all_once(pair));
+  }
+  {  // D3
+    std::vector<int> a, b, c;
+    tcs::synchronize_and_release_all();
+    const long long drains0 = stat("bound_drains");
+    const int64_t first = tcs::tuning::kPendingMaxBytes / 4 - 2;  // + 1 element = kPendingMaxBytes - 4 bytes
+    call({first, 1}, a);
+    call({1}, b);  // total == kPendingMaxBytes exactly
+    check("D3_total_equal_to_the_bound_stays_queued", stat("bytes") == tcs::tuning::kPendingMaxBytes &&
+                                                          stat("bound_drains") == drains0 && stat("entries") == 2,
+          "bytes=" + std::to_string(stat("bytes")));
+    call({1}, c);  // 4 bytes over
+    check("D3_four_bytes_over_the_bound_drains", stat("bound_drains") == drains0 + 1 && stat("entries") == 0 &&
+                                                     stat("bytes") == 0);
+    check("D3_every_manager_released_exactly_once", all_once(a) && all_once(b) && all_once(c));
+  }
+  tcs::synchronize_and_release_all();
+  return 0;
+}
+}  // namespace
+
+int main(int argc, char** argv) {
+  py::scoped_interpreter python{};
+  if (argc != 2) return 2;
+  int rc = 2;
+  if (std::strcmp(argv[1], "accounting") == 0) rc = accounting();
+  if (std::strcmp(argv[1], "dtor") == 0) rc = dtor();
+  std::printf("{\"summary\": {\"mode\": \"%s\", \"cases\": %d, \"failures\": %d}}\n", argv[1], g_cases, g_failures);
+  std::fflush(stdout);
+  return rc != 0 ? rc : (g_failures == 0 && g_cases > 0 ? 0 : 1);
+}
diff --git a/tc_signal/tests/fix4_cudart_shim.c b/tc_signal/tests/fix4_cudart_shim.c
new file mode 100644
index 0000000..00f9cf1
--- /dev/null
+++ b/tc_signal/tests/fix4_cudart_shim.c
@@ -0,0 +1,124 @@
+/* P1T-FIX4 test shim (LD_PRELOAD) over libcudart.so.12 and libcublas.so.12 for tc_signal's device / CUDA-error sweep
+ * tests (test_fix4_findings.py). This host has ONE GPU, so "another device is current" is simulated, as FIX1 did for
+ * core's F05: in fake mode the shim reports a simulated current device, logs each interposed call with the simulated
+ * device it would run on, and keeps the REAL device at 0. It can fail one named call, or the Nth cudaSetDevice(d), with
+ * a GENUINE runtime error (it calls the real cudaSetDevice(-1), so the thread's last-error slot really holds
+ * cudaErrorInvalidDevice), and it can fail cublasSetMathMode with CUBLAS_STATUS_INTERNAL_ERROR (14).
+ *
+ * Use it only in processes that do not import torch: its definitions are global, so torch's own runtime calls
+ * (torch 2.11 + cu130 uses libcudart.so.13) would also be routed here, to libcudart.so.12.
+ *
+ * Prior art: LD_PRELOAD symbol interposition (glibc ld.so; classic malloc/syscall interposers) and the FIX1 F05 shim in
+ * tensor_cuda/tests/test_dlpack.py. Ours: the call log, genuine-slot failure injection and the cuBLAS hooks.
+ */
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <string.h>
+
+typedef struct { unsigned x, y, z; } dim3_;
+
+static int fake = -1;          /* -1: pass-through; else the simulated current device */
+static int fail_set_to = -1, fail_set_nth = 0, set_seen = 0;
+static char fail_name[64];
+static char logbuf[16384];
+
+static void note(const char* s) {
+  size_t n = strlen(logbuf);
+  if (n + strlen(s) + 2 < sizeof logbuf) { strcat(logbuf, s); strcat(logbuf, " "); }
+}
+static void* real_sym(const char* lib, const char* name) {
+  void* h = dlopen(lib, RTLD_LAZY | RTLD_NOLOAD);
+  if (!h) h = dlopen(lib, RTLD_LAZY);
+  return h ? dlsym(h, name) : NULL;
+}
+#define REAL(R, n, A) static R (*real_##n) A; if (!real_##n) real_##n = (R (*) A)real_sym("libcudart.so.12", #n)
+#define REALB(R, n, A) static R (*real_##n) A; if (!real_##n) real_##n = (R (*) A)real_sym("libcublas.so.12", #n)
+
+static int genuine_failure(void) { REAL(int, cudaSetDevice, (int)); return real_cudaSetDevice(-1); }
+static int take_fail(const char* n) {
+  if (fail_name[0] && strcmp(fail_name, n) == 0) { fail_name[0] = 0; return 1; }
+  return 0;
+}
+static void lognote(const char* what, int failed) {
+  if (fake < 0 && !failed) return;
+  char b[48];
+  snprintf(b, sizeof b, "%s@%d%s", what, fake, failed ? "!" : "");
+  note(b);
+}
+
+int cudaGetDevice(int* d) {
+  REAL(int, cudaGetDevice, (int*));
+  if (fake >= 0) { *d = fake; return 0; }
+  return real_cudaGetDevice(d);
+}
+int cudaSetDevice(int d) {
+  REAL(int, cudaSetDevice, (int));
+  if (fake < 0) return real_cudaSetDevice(d);
+  int fail = 0;
+  if (d == fail_set_to && ++set_seen == fail_set_nth) { fail = 1; fail_set_to = -1; }
+  char b[32];
+  snprintf(b, sizeof b, "set%d%s", d, fail ? "!" : "");
+  note(b);
+  if (fail) return genuine_failure();
+  fake = d;
+  return real_cudaSetDevice(0);
+}
+int cudaEventCreateWithFlags(void** e, unsigned f) {
+  REAL(int, cudaEventCreateWithFlags, (void**, unsigned));
+  if (take_fail("cudaEventCreateWithFlags")) { lognote("create", 1); return genuine_failure(); }
+  lognote("create", 0);
+  return real_cudaEventCreateWithFlags(e, f);
+}
+int cudaEventRecord(void* e, void* s) {
+  REAL(int, cudaEventRecord, (void*, void*));
+  if (take_fail("cudaEventRecord")) { lognote("record", 1); return genuine_failure(); }
+  lognote("record", 0);
+  return real_cudaEventRecord(e, s);
+}
+int cudaEventQuery(void* e) {
+  REAL(int, cudaEventQuery, (void*));
+  if (take_fail("cudaEventQuery")) { lognote("query", 1); return genuine_failure(); }
+  return real_cudaEventQuery(e);   /* queries are not logged: their number depends on timing */
+}
+int cudaEventDestroy(void* e) {
+  REAL(int, cudaEventDestroy, (void*));
+  if (take_fail("cudaEventDestroy")) { lognote("destroy", 1); real_cudaEventDestroy(e); return genuine_failure(); }
+  lognote("destroy", 0);
+  return real_cudaEventDestroy(e);
+}
+int cudaStreamSynchronize(void* s) {
+  REAL(int, cudaStreamSynchronize, (void*));
+  lognote("sync", 0);
+  return real_cudaStreamSynchronize(s);
+}
+int cudaLaunchKernel(const void* fn, dim3_ g, dim3_ b, void** a, size_t sh, void* s) {
+  REAL(int, cudaLaunchKernel, (const void*, dim3_, dim3_, void**, size_t, void*));
+  if (take_fail("cudaLaunchKernel")) { lognote("launch", 1); return genuine_failure(); }   /* nothing launched */
+  lognote("launch", 0);
+  return real_cudaLaunchKernel(fn, g, b, a, sh, s);
+}
+int cudaMemsetAsync(void* p, int v, size_t n, void* s) {
+  REAL(int, cudaMemsetAsync, (void*, int, size_t, void*));
+  if (take_fail("cudaMemsetAsync")) { lognote("memset", 1); return genuine_failure(); }
+  return real_cudaMemsetAsync(p, v, n, s);
+}
+int cublasSetMathMode(void* h, int m) {
+  REALB(int, cublasSetMathMode, (void*, int));
+  if (take_fail("cublasSetMathMode")) { note("cublasSetMathMode!"); return 14; /* CUBLAS_STATUS_INTERNAL_ERROR */ }
+  return real_cublasSetMathMode(h, m);
+}
+int cublasDestroy_v2(void* h) {
+  REALB(int, cublasDestroy_v2, (void*));
+  note("cublasDestroy");
+  return real_cublasDestroy_v2(h);
+}
+
+void shim_fake(int d) { fake = d; }
+void shim_fail_set(int d, int nth) { fail_set_to = d; fail_set_nth = nth; set_seen = 0; }
+void shim_fail(const char* n) { strncpy(fail_name, n, sizeof fail_name - 1); }
+int shim_current(void) { return fake; }
+int shim_slot_peek(void) { REAL(int, cudaPeekAtLastError, (void)); return real_cudaPeekAtLastError(); }
+const char* shim_log(void) { return logbuf; }
+void shim_clear(void) { logbuf[0] = 0; }
diff --git a/tc_signal/tests/fix4_stage_kernel.cu b/tc_signal/tests/fix4_stage_kernel.cu
new file mode 100644
index 0000000..f650885
--- /dev/null
+++ b/tc_signal/tests/fix4_stage_kernel.cu
@@ -0,0 +1,15 @@
+// P1T-FIX4 test helper: stages a REAL synchronous launch-configuration error in the calling thread's last-error slot of
+// the shared libcudart.so.12 (built by test_fix4_findings.py with nvcc --cudart shared, so it is the same runtime
+// instance tc_signal and core use). A block of 4096 threads exceeds every device's 1024-thread limit, so the runtime
+// refuses the launch at once with cudaErrorInvalidConfiguration and queues nothing. Test-only; it is not part of the
+// package, and this kernel is never executed. Prior art: none beyond the CUDA launch-configuration limits (CUDA 12.6
+// Programming Guide, "Thread Hierarchy": at most 1024 threads per block).
+#include <cuda_runtime.h>
+
+__global__ void fix4_never_runs() {}
+
+extern "C" int fix4_stage_launch_config_error() {
+  cudaGetLastError();
+  fix4_never_runs<<<1, 4096>>>();
+  return static_cast<int>(cudaPeekAtLastError());
+}
diff --git a/tc_signal/tests/fix5_regen.py b/tc_signal/tests/fix5_regen.py
new file mode 100644
index 0000000..ed2b3d0
--- /dev/null
+++ b/tc_signal/tests/fix5_regen.py
@@ -0,0 +1,73 @@
+"""P1T-FIX5: regenerate the two round-5 reviewer probes that EMBED product code instead of including it, from a given
+tree's sources, so that they test that tree (FIX4 D9 precedent: core_interop_cpu.cpp).
+
+  * artifacts/p1t_rev5/probes/handle_insert_oom_cpu.cpp embeds conv.cu `handle_for` and lstm.cu `lstm_handle_for`
+    verbatim (1475fae). regen_handle_probe() replaces each embedded function with the function extracted from the given
+    conv.cu / lstm.cu (from its signature line to the first following line that is exactly "}"). If the extracted text
+    calls note_cublas_handle_destroy_failure (P1T-FIX5), a counting stub of it is inserted before `namespace conv {`;
+    if it calls check_cublas_on (P1T-FIX7), a throwing stub of it (the probe's own check_cublas, plus the device
+    argument) is inserted there too; nothing else changes. Self-check: regenerating from 1475fae's sources reproduces the probe byte for byte.
+  * artifacts/p1t_rev5/probes/fill_grid_cpu.cpp embeds the baseline `nblk` helper that 1475fae's fill_ launched with.
+    regen_fill_probe() reads the given kernels.cu fill_: if fill_ launches with nblk(n) (1475fae), the probe is returned
+    unchanged; if it uses P1T-FIX5's fill_grid_blocks, that function and its kFillMaxGridX constant are extracted
+    verbatim and inserted after nblk, and main's geometry line `int blocks=nblk(n);` becomes the fill_ path's geometry
+    (fill_grid_blocks, its std::invalid_argument refusal counted as the probe header's "refused" outcome, and the
+    launch's unsigned conversion). This touches main, beyond a slice substitution: reported as such (FIX5 deviation).
+
+Prior art: the FIX4 regen_core_interop_import.py approach (extract the arm's function text, substitute, self-check).
+No other prior art claimed (text plumbing).
+"""
+import re
+
+
+def _extract_function(src, signature):
+    lines = src.splitlines(True)
+    for i, ln in enumerate(lines):
+        if ln.rstrip('\n') == signature:
+            for j in range(i + 1, len(lines)):
+                if lines[j].rstrip('\n') == '}':
+                    return ''.join(lines[i:j + 1])
+    raise ValueError(f'function not found: {signature!r}')
+
+
+def regen_handle_probe(probe, conv_src, lstm_src):
+    conv_sig = 'cublasHandle_t handle_for(int device) {'
+    lstm_sig = 'cublasHandle_t lstm_handle_for(int device) {'
+    old_conv = _extract_function(probe, conv_sig)
+    old_lstm = _extract_function(probe, lstm_sig)
+    new_conv = _extract_function(conv_src, conv_sig)
+    new_lstm = _extract_function(lstm_src, lstm_sig)
+    out = probe.replace(old_conv, new_conv, 1).replace(old_lstm, new_lstm, 1)
+    if 'note_cublas_handle_destroy_failure' in new_conv + new_lstm:
+        stub = ('// P1T-FIX5 regeneration: counting stub for the product\'s note_cublas_handle_destroy_failure\n'
+                'static int note_destroy_failures=0;\n'
+                'void note_cublas_handle_destroy_failure(int) noexcept {++note_destroy_failures;}\n')
+        out = out.replace('namespace conv {\n', stub + 'namespace conv {\n', 1)
+    if 'check_cublas_on(' in new_conv + new_lstm:
+        # P1T-FIX7 (sweep (j)): the product's status check now also names the device (check_cublas_on); stub it the way
+        # the probe stubs check_cublas (any failure throws), so the extracted functions compile unchanged.
+        stub = ('// P1T-FIX7 regeneration: stub for the product\'s device-naming check_cublas_on\n'
+                'static void check_cublas_on(cublasStatus_t s,const char*,int) {if(s!=CUBLAS_STATUS_SUCCESS)'
+                'throw std::runtime_error("cuBLAS error");}\n')
+        out = out.replace('namespace conv {\n', stub + 'namespace conv {\n', 1)
+    return out
+
+
+def regen_fill_probe(probe, kernels_src):
+    fill = _extract_function(kernels_src, 'void fill_(NDArray& a, double value) {')
+    if 'fill_grid_blocks' not in fill:
+        assert 'nblk(n)' in fill, 'fill_ uses neither nblk(n) nor fill_grid_blocks'
+        return probe
+    const = re.search(r'^constexpr int64_t kFillMaxGridX = [^\n]*\n', kernels_src, re.M).group(0)
+    helper = _extract_function(kernels_src, 'int64_t fill_grid_blocks(int64_t n) {')
+    nblk = 'inline int nblk(int64_t n) { return static_cast<int>((n + kT - 1) / kT); }\n'
+    assert probe.count(nblk) == 1
+    out = probe.replace('#include <cstdint>\n', '#include <cstdint>\n#include <stdexcept>\n#include <string>\n', 1)
+    out = out.replace(nblk, nblk + '// P1T-FIX5 regeneration: the fill_ path\'s geometry, extracted verbatim\n' +
+                      const + helper, 1)
+    old = 'int blocks=nblk(n);int64_t coverage=static_cast<int64_t>(static_cast<unsigned int>(blocks))*kT;'
+    new = ('int64_t blocks;try{blocks=fill_grid_blocks(n);}catch(const std::invalid_argument& e){'
+           'std::cout<<"n="<<n<<" refused: "<<e.what()<<"\\n";continue;}'
+           'int64_t coverage=static_cast<int64_t>(static_cast<unsigned int>(blocks))*kT;')
+    assert out.count(old) == 1
+    return out.replace(old, new, 1)
