new file mode 100644
index 0000000..c24dd0a
--- /dev/null
+++ b/tc_signal/src/conv.cu
@@ -0,0 +1,317 @@
+// tc_signal 1-D convolutions (P1T-M2: T2 Conv1d, T3 ConvTranspose1d). fp32, deterministic, no atomics, no fast-math.
+//
+// Numerics contract (Project-Voice TENSOR_IMPL_PLAN_P1T.md §4; tc_signal plan §4):
+//  * fp32 math throughout; cuBLAS in CUBLAS_DEFAULT_MATH (never TF32) with atomics not allowed;
+//  * every output element is produced by exactly one thread (or one cuBLAS dot product) in a fixed order, so two calls
+//    on the same inputs are bitwise equal; no atomicAdd anywhere in this package;
+//  * no intrinsics such as __expf/__fdividef and no --use_fast_math (CMakeLists.txt refuses it). FMA contraction is
+//    nvcc's default (--fmad=true, not a fast-math flag); the gather kernel spells its FMA out with fmaf().
+//
+// Prior art:
+//  * im2col + GEMM convolution: Chellapilla, Puri & Simard, "High Performance Convolutional Neural Networks for
+//    Document Processing" (2006). Taken: unfold the receptive fields into a matrix and run one SGEMM. Ours: the 1-D
+//    unfold with dilation and separate (pad_begin, pad_end), the per-batch-element scratch reuse, and the group batch
+//    as a strided-batched SGEMM.
+//  * Row-major GEMM through column-major BLAS by computing C^T = B^T A^T: standard BLAS practice (no single source).
+//  * Gather-form transposed convolution: transposed convolution is the adjoint of the strided convolution
+//    (Dumoulin & Visin, "A guide to convolution arithmetic for deep learning", 2016); evaluating each output as a sum
+//    over the input taps that land on it (instead of scattering inputs) is the usual deterministic formulation.
+//    Taken: the tap condition (t + pb - k*dilation) % stride == 0. Ours: the fixed loop order (k outer ascending,
+//    c inner ascending, bias last) and the thread mapping.
+//  * Semantics: ONNX Conv / ConvTranspose operator specs (1-D case; pads = (begin, end), ConvTranspose weight layout
+//    [C_in, C_out/groups, K], output_padding appended at the end).
+#include "conv_ops.h"
+
+#include <cublas_v2.h>
+#include <cuda_runtime.h>
+
+#include <algorithm>
+#include <sstream>
+#include <stdexcept>
+#include <string>
+#include <unordered_map>
+
+#include "cuda_guard.h"  // P1T-FIX4: shared checked DeviceGuard
+#include "tuning.h"
+
+#ifdef CUDA_API_PER_THREAD_DEFAULT_STREAM
+#error "tc_signal queues on the legacy default stream (stream 0); do not build it with --default-stream per-thread"
+#endif
+// nvcc 12.6 defines no preprocessor macro for --use_fast_math (it only passes -ftz=1 -prec_div=0 -prec_sqrt=0 to
+// cicc), so fast-math cannot be refused here at compile time. CMakeLists.txt refuses the flag at configure time, and
+// fp32_divide_probe_kernel below is a runtime canary compiled with this TU's flags (tests/test_conv.py checks it).
+
+namespace tcs {
+
+namespace {
+
+// Stream 0 is the legacy default stream in this translation unit (per-thread default stream refused above). It is the
+// same stream TensorCUDA queues on, and the stream DLPack producers were asked to order against (stream=1).
+constexpr cudaStream_t kLegacyStream = 0;
+
+void check_cuda(cudaError_t e, const char* what) {
+  if (e != cudaSuccess) {
+    std::ostringstream os;
+    os << "tc_signal: " << what << " failed: " << cudaGetErrorName(e) << ": " << cudaGetErrorString(e);
+    // P1T-FIX4 (cuda_guard.h rule 1): this raise reports the failed call, so it consumes its entry; P1T-FIX8 (sweep
+    // (k)): only once the report exists (cuda_guard.h throw_after_consuming).
+    throw_after_consuming(os);
+  }
+}
+
+// Checked after every kernel launch and after every cuBLAS call (launch-configuration and sticky errors surface here as
+// RuntimeError). P1T-FIX7 (sweep (j)): through cuda_guard.h check_launch_on / check_after_cublas_on, which name the
+// device and never claim that a kernel or a cuBLAS call failed when cudaGetLastError may be reporting an asynchronous
+// error of earlier work (FIX6: "<kernel> failed", "cublasSgemmStridedBatched failed" after it returned success).
+constexpr const char* kPrefix = "tc_signal: ";
+
+void check_cublas(cublasStatus_t s, const char* what) {  // no device involved (cublasGetProperty)
+  if (s != CUBLAS_STATUS_SUCCESS) {
+    std::ostringstream os;
+    os << "tc_signal: " << what << " failed: cuBLAS status " << static_cast<int>(s);
+    throw std::runtime_error(os.str());
+  }
+}
+void check_cublas_on(cublasStatus_t s, const char* what, int device) {
+  if (s != CUBLAS_STATUS_SUCCESS) raise_cublas_failure_on(kPrefix, what, device, static_cast<int>(s));
+}
+
+unsigned int grid_for(int64_t total, int block) {
+  const int64_t blocks = (total + block - 1) / block;
+  return static_cast<unsigned int>(std::max<int64_t>(1, std::min<int64_t>(blocks, tuning::kGridCap)));
+}
+
+// DeviceGuard (makes `device` current for the call, restores the caller's device) is tc_signal's shared, checked guard
+// in cuda_guard.h since P1T-FIX4 (this copy ignored the restoring cudaSetDevice's result).
+
+// One cuBLAS handle per device, created lazily on first use and kept for the life of the process (destroying it at
+// interpreter exit can race CUDA's own teardown). All entry points run under the GIL, so no extra lock is needed.
+// cuBLAS allocates its own internal workspace for this handle on first use (cudaMalloc inside cuBLAS); that is the
+// only device memory tc_signal causes to be allocated outside the caller's allocator (README "cuBLAS").
+cublasHandle_t handle_for(int device) {
+  static std::unordered_map<int, cublasHandle_t> handles;
+  auto it = handles.find(device);
+  if (it != handles.end()) return it->second;
+  cublasHandle_t h = nullptr;
+  check_cublas_on(cublasCreate(&h), "cublasCreate", device);
+  // P1T-FIX5, round-5 review finding V5-03 (MINOR): FIX4 destroyed the new handle when a SETTING failed, but the handle
+  // had no owner through the cache insertion below: when handles.emplace threw (std::bad_alloc for the map node) the
+  // handle leaked, with its device resources (review probe handle_insert_oom_cpu.cpp: creates 1, destroys 0). Now `owned`
+  // owns it from creation until the insertion commits: on ANY exception before the commit its destructor destroys the
+  // handle, checks the destroy's status and, never throwing while the exception propagates, counts a failure
+  // (note_cublas_handle_destroy_failure). A failed setting still destroys it explicitly first and names that destroy's
+  // status in the raise (FIX4), clearing `h` so the owner does not destroy it twice. Nothing is cached on failure, so
+  // the next call starts again from cublasCreate.
+  // Prior art: RAII (Stroustrup) and the scope guard with dismissal on commit (Alexandrescu & Marginean, "Generic: Change
+  // the Way You Write Exception-Safe Code - Forever", C/C++ Users Journal, 2000; std::unique_ptr with a custom deleter
+  // is the library form). Taken: own until commit, release on unwinding. Ours: checking and counting the cleanup status.
+  struct NewHandleOwner {
+    cublasHandle_t& h;
+    ~NewHandleOwner() {
+      if (h == nullptr) return;  // committed to the cache, or already destroyed by settle
+      const cublasStatus_t ds = cublasDestroy(h);
+      if (ds != CUBLAS_STATUS_SUCCESS) note_cublas_handle_destroy_failure(static_cast<int>(ds));
+    }
+  } owned{h};
+  // P1T-FIX4 (sweep): a setting that fails no longer leaks the new handle: it is destroyed (on this device, which the
+  // caller's DeviceGuard keeps current), the destroy's own status is checked and named, and the call raises. Nothing is
+  // cached, so the next call retries from cublasCreate.
+  auto settle = [&h, device](cublasStatus_t st, const char* what) {
+    if (st == CUBLAS_STATUS_SUCCESS) return;
+    const cublasStatus_t ds = cublasDestroy(h);
+    h = nullptr;  // P1T-FIX5: destroyed here; the owner must not destroy it again
+    std::ostringstream os;
+    os << "tc_signal: " << what << " failed: cuBLAS status " << static_cast<int>(st) << " (the new handle of CUDA device "
+       << device << ")";  // P1T-FIX7 (sweep (j)): the device named
+    if (ds != CUBLAS_STATUS_SUCCESS) os << "; destroying the new handle also failed: cuBLAS status " << static_cast<int>(ds);
+    throw std::runtime_error(os.str());
+  };
+  settle(cublasSetStream(h, kLegacyStream), "cublasSetStream(0)");
+  settle(cublasSetMathMode(h, CUBLAS_DEFAULT_MATH), "cublasSetMathMode(CUBLAS_DEFAULT_MATH)");
+  settle(cublasSetAtomicsMode(h, CUBLAS_ATOMICS_NOT_ALLOWED), "cublasSetAtomicsMode(NOT_ALLOWED)");
+  settle(cublasSetPointerMode(h, CUBLAS_POINTER_MODE_HOST), "cublasSetPointerMode(HOST)");
+  handles.emplace(device, h);  // may throw (host allocation): `owned` destroys h, nothing is cached
+  const cublasHandle_t cached = h;
+  h = nullptr;  // committed: the cache owns the handle now
+  return cached;
+}
+
+// ------------------------------------------------------------------------------------------------ kernels
+// 1-D im2col for one batch element (Chellapilla et al. 2006, 1-D with dilation and asymmetric zero padding):
+//   col[(c*K + k), t] = x[c, t*stride - pad_begin + k*dilation]   (0 outside [0, T))
+// Rows (c, k) are c-major, so group g's rows [g*Cg*K, (g+1)*Cg*K) form one contiguous [Cg*K, T_out] block that
+// matches w[g*Og:(g+1)*Og] viewed as [Og, Cg*K].
+__global__ void im2col1d_kernel(const float* __restrict__ x, float* __restrict__ col, int64_t C, int64_t T, int64_t K,
+                                int64_t T_out, int64_t stride, int64_t pad_begin, int64_t dilation) {
+  const int64_t total = C * K * T_out;
+  for (int64_t i = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; i < total;
+       i += static_cast<int64_t>(gridDim.x) * blockDim.x) {
+    const int64_t t = i % T_out;
+    const int64_t r = i / T_out;
+    const int64_t k = r % K;
+    const int64_t c = r / K;
+    const int64_t src = t * stride - pad_begin + k * dilation;
+    col[i] = (src >= 0 && src < T) ? x[c * T + src] : 0.0f;
+  }
+}
+
+// y[n, o, t] += b[o], one thread per output element (fp32 add, one rounding).
+__global__ void bias_add_kernel(float* __restrict__ y, const float* __restrict__ b, int64_t C_out, int64_t T_out,
+                                int64_t total) {
+  for (int64_t i = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; i < total;
+       i += static_cast<int64_t>(gridDim.x) * blockDim.x) {
+    const int64_t o = (i / T_out) % C_out;
+    y[i] = y[i] + b[o];
+  }
+}
+
+// Gather-form ConvTranspose1d (adjoint of strided conv, Dumoulin & Visin 2016), one thread per output element:
+//   y[n, o, t] = b[o] + sum_{k=0..K-1} sum_{c in group(o)} w[c, o - g*Og, k] * x[n, c, (t + pb - k*dilation)/stride]
+// over the taps with (t + pb - k*dilation) >= 0, divisible by stride, and quotient < T. Fixed order: k ascending
+// (outer), c ascending within the group (inner), fp32 fmaf accumulation from 0, bias added last. No atomics.
+__global__ void conv_transpose1d_gather_kernel(const float* __restrict__ x, const float* __restrict__ w,
+                                               const float* __restrict__ b, float* __restrict__ y, int64_t N,
+                                               int64_t C_in, int64_t T, int64_t C_out, int64_t K, int64_t T_out,
+                                               int64_t stride, int64_t pad_begin, int64_t dilation, int64_t groups) {
+  const int64_t Cg = C_in / groups;
+  const int64_t Og = C_out / groups;
+  const int64_t total = N * C_out * T_out;
+  for (int64_t i = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; i < total;
+       i += static_cast<int64_t>(gridDim.x) * blockDim.x) {
+    const int64_t t = i % T_out;
+    const int64_t r = i / T_out;
+    const int64_t o = r % C_out;
+    const int64_t n = r / C_out;
+    const int64_t g = o / Og;
+    const int64_t ol = o - g * Og;
+    const float* xg = x + (n * C_in + g * Cg) * T;   // x[n, g*Cg + cl, :] = xg[cl*T + :]
+    const float* wg = w + (g * Cg * Og + ol) * K;    // w[g*Cg + cl, ol, k] = wg[cl*Og*K + k]
+    float acc = 0.0f;
+    for (int64_t k = 0; k < K; ++k) {
+      const int64_t s = t + pad_begin - k * dilation;
+      if (s < 0 || s % stride != 0) continue;
+      const int64_t q = s / stride;
+      if (q >= T) continue;
+      const float* xp = xg + q;
+      const float* wp = wg + k;
+      for (int64_t cl = 0; cl < Cg; ++cl) acc = fmaf(wp[cl * Og * K], xp[cl * T], acc);
+    }
+    if (b != nullptr) acc = acc + b[o];
+    y[i] = acc;
+  }
+}
+
+// Fast-math canary: out[i] = x[i] / y[i] in fp32. Built with this TU's flags, so --use_fast_math (-ftz=1,
+// -prec_div=0) shows up as flushed subnormals or non-IEEE quotients, which the tests compare bitwise against the host's
+// IEEE fp32 division. Prior art: no specific source known to me (it is the usual "test the build flags by their
+// observable effect" idea; denormal flushing as a fast-math symptom is documented in the CUDA C Programming Guide).
+__global__ void fp32_divide_probe_kernel(const float* __restrict__ x, const float* __restrict__ y,
+                                         float* __restrict__ out, int64_t n) {
+  for (int64_t i = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; i < n;
+       i += static_cast<int64_t>(gridDim.x) * blockDim.x)
+    out[i] = x[i] / y[i];
+}
+
+}  // namespace
+
+void fp32_divide_probe(int device, const float* x, const float* y, float* out, int64_t n) {
+  DeviceGuard guard(device);
+  fp32_divide_probe_kernel<<<grid_for(n, tuning::kProbeBlock), tuning::kProbeBlock, 0, kLegacyStream>>>(x, y, out, n);
+  check_launch_on(kPrefix, "fp32_divide_probe_kernel", device);
+  guard.restore();  // P1T-FIX4: success-path restore is checked (raises on failure)
+}
+
+// ------------------------------------------------------------------------------------------------ Conv1d
+void conv1d_forward(int device, const Conv1dGeom& g, const float* x, const float* w, const float* b, float* y,
+                    float* col) {
+  DeviceGuard guard(device);
+  cublasHandle_t h = handle_for(device);
+  const int64_t Cg = g.C_in / g.groups;
+  const int64_t Og = g.C_out / g.groups;
+  const int64_t CgK = Cg * g.K;
+  const float alpha = 1.0f;
+  const float beta = 0.0f;
+  for (int64_t n = 0; n < g.N; ++n) {
+    const float* xn = x + n * g.C_in * g.T;
+    const float* A = nullptr;   // the [Cg*K, T_out] row-major operand of group 0 for this batch element
+    long long strideA = 0;
+    if (g.direct) {
+      // K == 1, stride 1, no pads: x[n] itself is the col matrix (T_out == T), no scratch.
+      A = xn;
+      strideA = static_cast<long long>(Cg * g.T);
+    } else {
+      // The scratch is reused for every n: the next im2col is queued after this n's GEMM on the same stream.
+      const int64_t total = g.C_in * g.K * g.T_out;
+      im2col1d_kernel<<<grid_for(total, tuning::kIm2colBlock), tuning::kIm2colBlock, 0, kLegacyStream>>>(
+          xn, col, g.C_in, g.T, g.K, g.T_out, g.stride, g.pad_begin, g.dilation);
+      check_launch_on(kPrefix, "im2col1d_kernel", device);
+      A = col;
+      strideA = static_cast<long long>(CgK * g.T_out);
+    }
+    float* yn = y + n * g.C_out * g.T_out;
+    // Row-major Y_g[Og, T_out] = W_g[Og, CgK] . Col_g[CgK, T_out], computed as the column-major product
+    // Y_g^T[T_out, Og] = Col_g^T[T_out, CgK] . W_g^T[CgK, Og]: m = T_out, n = Og, k = CgK, both ops N,
+    // lda = T_out (col), ldb = CgK (w), ldc = T_out (y); one batch entry per group.
+    check_cublas_on(cublasSgemmStridedBatched(h, CUBLAS_OP_N, CUBLAS_OP_N, static_cast<int>(g.T_out),
+                                           static_cast<int>(Og), static_cast<int>(CgK), &alpha, A,
+                                           static_cast<int>(g.T_out), strideA, w, static_cast<int>(CgK),
+                                           static_cast<long long>(Og * CgK), &beta, yn, static_cast<int>(g.T_out),
+                                           static_cast<long long>(Og * g.T_out), static_cast<int>(g.groups)),
+                 "cublasSgemmStridedBatched", device);
+    check_after_cublas_on(kPrefix, "cublasSgemmStridedBatched", device);
+  }
+  if (b != nullptr) {
+    const int64_t total = g.N * g.C_out * g.T_out;
+    bias_add_kernel<<<grid_for(total, tuning::kBiasBlock), tuning::kBiasBlock, 0, kLegacyStream>>>(y, b, g.C_out,
+                                                                                                   g.T_out, total);
+    check_launch_on(kPrefix, "bias_add_kernel", device);
+  }
+  guard.restore();  // P1T-FIX4
+}
+
+// ------------------------------------------------------------------------------------------------ ConvTranspose1d
+void conv_transpose1d_forward(int device, const ConvTranspose1dGeom& g, const float* x, const float* w,
+                              const float* b, float* y) {
+  DeviceGuard guard(device);
+  const int64_t total = g.N * g.C_out * g.T_out;
+  conv_transpose1d_gather_kernel<<<grid_for(total, tuning::kConvTransposeBlock), tuning::kConvTransposeBlock, 0,
+                                   kLegacyStream>>>(x, w, b, y, g.N, g.C_in, g.T, g.C_out, g.K, g.T_out, g.stride,
+                                                    g.pad_begin, g.dilation, g.groups);
+  check_launch_on(kPrefix, "conv_transpose1d_gather_kernel", device);
+  guard.restore();  // P1T-FIX4
+}
+
+// ------------------------------------------------------------------------------------------------ introspection
+CublasConfig cublas_config(int device) {
+  DeviceGuard guard(device);
+  cublasHandle_t h = handle_for(device);
+  cublasMath_t math;
+  cublasAtomicsMode_t atomics;
+  cublasPointerMode_t pmode;
+  cudaStream_t s;
+  check_cublas_on(cublasGetMathMode(h, &math), "cublasGetMathMode", device);
+  check_cublas_on(cublasGetAtomicsMode(h, &atomics), "cublasGetAtomicsMode", device);
+  check_cublas_on(cublasGetPointerMode(h, &pmode), "cublasGetPointerMode", device);
+  check_cublas_on(cublasGetStream(h, &s), "cublasGetStream", device);
+  CublasConfig c;
+  c.math_mode = static_cast<int>(math);
+  c.atomics_mode = static_cast<int>(atomics);
+  c.pointer_mode = static_cast<int>(pmode);
+  c.legacy_stream = (s == kLegacyStream);
+  c.default_math = (math == CUBLAS_DEFAULT_MATH);
+  c.atomics_not_allowed = (atomics == CUBLAS_ATOMICS_NOT_ALLOWED);
+  guard.restore();  // P1T-FIX4
+  return c;
+}
+
+BuildInfo build_info() {
+  BuildInfo bi{};
+  check_cuda(cudaRuntimeGetVersion(&bi.cudart_version), "cudaRuntimeGetVersion");
+  check_cublas(cublasGetProperty(MAJOR_VERSION, &bi.cublas_major), "cublasGetProperty(MAJOR)");
+  check_cublas(cublasGetProperty(MINOR_VERSION, &bi.cublas_minor), "cublasGetProperty(MINOR)");
+  check_cublas(cublasGetProperty(PATCH_LEVEL, &bi.cublas_patch), "cublasGetProperty(PATCH)");
+  check_cuda(cudaGetDevice(&bi.current_device), "cudaGetDevice");
+  return bi;
+}
+
+}  // namespace tcs
diff --git a/tc_signal/src/conv_ops.h b/tc_signal/src/conv_ops.h
new file mode 100644
index 0000000..381e541
--- /dev/null
+++ b/tc_signal/src/conv_ops.h
@@ -0,0 +1,54 @@
+// Host launchers for tc_signal's 1-D convolutions. Raw device pointers in, everything queued on the legacy default
+// stream; no device memory is allocated here (the im2col scratch is passed in; cuBLAS's own internal workspace is the
+// one exception, see README "cuBLAS").
+#pragma once
+
+#include <cstdint>
+
+namespace tcs {
+
+struct Conv1dGeom {
+  int64_t N, C_in, T;      // x [N, C_in, T]
+  int64_t C_out, K;        // w [C_out, C_in/groups, K]
+  int64_t stride, pad_begin, pad_end, dilation, groups;
+  int64_t T_out;           // (T + pb + pe - dilation*(K-1) - 1)//stride + 1
+  bool direct;             // K == 1, stride 1, no pads: GEMM on x itself, no im2col, no scratch
+};
+
+struct ConvTranspose1dGeom {
+  int64_t N, C_in, T;      // x [N, C_in, T]
+  int64_t C_out, K;        // w [C_in, C_out/groups, K] (ONNX layout)
+  int64_t stride, pad_begin, pad_end, output_padding, dilation, groups;
+  int64_t T_out;           // stride*(T-1) + output_padding + dilation*(K-1) + 1 - pb - pe
+};
+
+// y = conv1d(x, w) + b. `col` holds C_in*K*T_out floats (one batch element at a time), or is NULL when g.direct.
+void conv1d_forward(int device, const Conv1dGeom& g, const float* x, const float* w, const float* b, float* y,
+                    float* col);
+
+// y = conv_transpose1d(x, w) + b (gather form, one thread per output element).
+void conv_transpose1d_forward(int device, const ConvTranspose1dGeom& g, const float* x, const float* w,
+                              const float* b, float* y);
+
+// Fast-math canary (see conv.cu): out[i] = x[i] / y[i], fp32, on the legacy stream.
+void fp32_divide_probe(int device, const float* x, const float* y, float* out, int64_t n);
+
+struct CublasConfig {
+  int math_mode;           // cublasMath_t
+  int atomics_mode;        // cublasAtomicsMode_t
+  int pointer_mode;        // cublasPointerMode_t
+  bool legacy_stream;      // the handle's stream is 0 (the legacy default stream)
+  bool default_math;       // math_mode == CUBLAS_DEFAULT_MATH
+  bool atomics_not_allowed;
+};
+// The (lazily created) handle's settings on `device`.
+CublasConfig cublas_config(int device);
+
+struct BuildInfo {
+  int cudart_version;      // cudaRuntimeGetVersion
+  int cublas_major, cublas_minor, cublas_patch;
+  int current_device;
+};
+BuildInfo build_info();
+
+}  // namespace tcs
diff --git a/tc_signal/src/cuda_guard.h b/tc_signal/src/cuda_guard.h
new file mode 100644
index 0000000..adfe0d1
--- /dev/null
+++ b/tc_signal/src/cuda_guard.h
@@ -0,0 +1,215 @@
+// P1T-FIX4: tc_signal's one device guard and its CUDA error-slot rules (replaces the four identical DeviceGuard copies
+// of conv.cu / lstm.cu / norms.cu / small_ops.cu and dlpack_operand.cpp's QuietDeviceGuard).
+//
+// Why (round-4 review): each round found new members of two classes, implicit current-device assumptions (F05, V4-01)
+// and unchecked or ignored CUDA returns and error state (N1, V4-03, V4-04). The FIX4 sweep found these members here:
+//  * every guard IGNORED the result of the restoring cudaSetDevice (destructor), so a failed restore left the caller on
+//    the operand's device silently;
+//  * a raise after a failed call left that call's entry in the calling thread's last-error slot, so the next, unrelated
+//    launch check (any tc_signal op, or core's, which shares this libcudart.so.12 instance) reported it again as its own.
+// The rules, applied by everything below and by the callers:
+//  1. Whoever reports a CUDA error consumes it: a raise after a failed CUDA call first takes the slot entry
+//     (cudaGetLastError), so the error is reported exactly once. CUDA 12.6 Programming Guide 3.2.12: the runtime keeps
+//     one error variable per host thread, "overwritten by the error code every time an error occurs", and
+//     cudaGetLastError "returns this variable and resets it to cudaSuccess" (artifacts/p1t_fix4/cuda_doc_quotes.txt).
+//  2. A restore of the caller's device is checked. On a success path it raises (DeviceGuard::restore()); where nothing
+//     may raise (a destructor, or unwinding after another error) the failure is consumed, counted, and raised once by
+//     the next tc_signal.synchronize() (note_unraisable_device_restore_failure, dlpack_operand.cpp).
+// cuBLAS 12.6 does not import libcudart (nm -D libcublas.so.12: no undefined cuda* symbol), so a cuBLAS failure never
+// touches this slot; it is reported by its cublasStatus_t only.
+//
+// Prior art: PyTorch c10::cuda::CUDAGuard / OptionalCUDAGuard (InlineDeviceGuard: switch in the constructor, restore in
+// the destructor through CUDAGuardImpl::uncheckedSetDevice -> C10_CUDA_CHECK_WARN, which consumes the slot with
+// cudaGetLastError and warns, never throws; read in the installed torch 2.11 headers, c10/cuda/impl/CUDAGuardImpl.h and
+// c10/cuda/CUDAException.h); CuPy's cupy.cuda.Device context manager (__exit__ restores the previous device). Taken: the
+// scoped switch-and-restore and consume-on-report. Ours: the raising restore() on success paths and routing the
+// unraisable failures to the next synchronize().
+#pragma once
+
+#include <cuda_runtime.h>
+
+#include <new>
+#include <sstream>
+#include <stdexcept>
+#include <string>
+
+namespace tcs {
+
+// Defined in dlpack_operand.cpp: a caller-device restore that failed where nothing can raise. Counted
+// (pending_stats()['device_restore_failures']) and raised once by the next synchronize(). Never allocates, never
+// throws. GIL held (every tc_signal path runs under the GIL).
+void note_unraisable_device_restore_failure(int device, cudaError_t err) noexcept;
+
+// P1T-FIX5 (round-5 review V5-03), defined in dlpack_operand.cpp: a cublasDestroy of a newly created handle that failed
+// while an exception propagated (the cache insertion threw), so it could not raise. Counted, first status kept
+// (pending_stats()['cublas_handle_destroy_failures' / 'cublas_handle_destroy_first_status']). Never throws, never
+// allocates.
+void note_cublas_handle_destroy_failure(int status) noexcept;
+
+// P1T-FIX8 (sweep (k), consumed CUDA errors): the report exists BEFORE the slot entry it reports is consumed. Every
+// raise below builds its message and its std::runtime_error first; a std::bad_alloc while building them propagates
+// (MemoryError) with the entry still in the calling thread's slot, so the next synchronize() (or launch check) still
+// raises it, as a pre-existing error, instead of the failure being consumed and lost. Only then is the entry consumed
+// (rule 1) and the exception thrown (copying a std::runtime_error is noexcept). A launch check reads the slot with
+// cudaPeekAtLastError for the same reason. Prior art: FIX5 V5-02's record-before-consume rule; the CUDA 12.6 error-slot
+// contract of cudaGetLastError ("returns ... and resets") / cudaPeekAtLastError ("does not reset"). Ours: applying it
+// to the raising paths.
+[[noreturn]] inline void throw_after_consuming(std::ostringstream& os) {
+  if (!os) throw std::bad_alloc();  // ostream swallows a bad_alloc into badbit: report the allocation failure itself
+  std::runtime_error report(os.str());
+  cudaGetLastError();  // consumed only now that the report exists
+  throw report;
+}
+
+// Rule 1: raise for a failed CUDA call of ours, consuming its slot entry once the report exists.
+[[noreturn]] inline void raise_cuda_failure(const std::string& what, cudaError_t e) {
+  std::ostringstream os;
+  os << what << " failed: " << cudaGetErrorName(e) << ": " << cudaGetErrorString(e);
+  throw_after_consuming(os);
+}
+
+// P1T-FIX7, sweep (j) "error attribution": the messages of the launch paths name the call that actually returned the
+// error, and the device. Three cases, each with its own wording:
+//  * check_call_on: a CUDA runtime call returned an error (cudaMemcpyAsync, cudaMemsetAsync, ...): that call failed (its
+//    own documented contract is to return the error), so the message names it and the device it ran on.
+//  * check_launch_on: the check right after a kernel launch. A <<<...>>> launch returns nothing; cudaGetLastError then
+//    reports the launch's own error (a refused configuration, a missing kernel image) OR an asynchronous error of
+//    earlier work on the device (CUDA 12.6 Runtime API, cudaGetLastError: "Note that this function may also return
+//    error codes from previous, asynchronous launches"). FIX6 said "<kernel> failed", which is false in the second
+//    case; the message now says what was checked and both possibilities.
+//  * check_after_cublas_on: the same check after a cuBLAS call that returned CUBLAS_STATUS_SUCCESS. cuBLAS 12.6 imports
+//    no symbol of libcudart (nm -D libcublas.so.12 / libcublasLt.so.12: no undefined cuda* symbol, ledger), so it
+//    never sets this runtime's error state: an error here is an asynchronous error of earlier work on the device.
+//    FIX6 said "cublasSgemmStridedBatched failed", naming a call that had just succeeded.
+// Every helper consumes the slot entry it reports (rule 1). Prior art: PyTorch's C10_CUDA_KERNEL_LAUNCH_CHECK message
+// ("CUDA kernel errors might be asynchronously reported at some other API call, so the stacktrace below might be
+// incorrect", c10/cuda/CUDAException.h, torch 2.11 headers; taken: stating the asynchronous possibility instead of
+// blaming the last launch); the CUDA 12.6 cudaGetLastError note quoted above. Ours: the cuBLAS case and naming the
+// device.
+[[noreturn]] inline void raise_call_failure_on(const char* prefix, const char* what, const char* api, int device,
+                                               cudaError_t e) {
+  std::ostringstream os;
+  os << prefix << what << " failed: " << cudaGetErrorName(e) << ": " << cudaGetErrorString(e) << " (" << api
+     << " on CUDA device " << device << " returned it)";
+  throw_after_consuming(os);
+}
+inline void check_call_on(const char* prefix, const char* what, const char* api, int device, cudaError_t e) {
+  if (e != cudaSuccess) raise_call_failure_on(prefix, what, api, device, e);
+}
+inline void check_launch_on(const char* prefix, const char* kernel, int device) {
+  const cudaError_t e = cudaPeekAtLastError();  // P1T-FIX8: read, not consumed until the report exists
+  if (e == cudaSuccess) return;
+  std::ostringstream os;
+  os << prefix << "CUDA error at the launch check of " << kernel << " on CUDA device " << device << ": "
+     << cudaGetErrorName(e) << ": " << cudaGetErrorString(e)
+     << " (cudaGetLastError right after the launch: the launch's own error, or an asynchronous error of earlier work "
+        "on that device, which CUDA reports at a later call)";
+  throw_after_consuming(os);
+}
+inline void check_after_cublas_on(const char* prefix, const char* fn, int device) {
+  const cudaError_t e = cudaPeekAtLastError();  // P1T-FIX8: read, not consumed until the report exists
+  if (e == cudaSuccess) return;
+  std::ostringstream os;
+  os << prefix << "CUDA error found by the check after " << fn << " on CUDA device " << device
+     << ", which returned CUBLAS_STATUS_SUCCESS: " << cudaGetErrorName(e) << ": " << cudaGetErrorString(e)
+     << " (cudaGetLastError; cuBLAS does not set the CUDA runtime's error state, so this is an asynchronous error of "
+        "earlier work on that device)";
+  throw_after_consuming(os);
+}
+[[noreturn]] inline void raise_cublas_failure_on(const char* prefix, const char* fn, int device, int status) {
+  std::ostringstream os;
+  os << prefix << fn << " failed: cuBLAS status " << status << " (on CUDA device " << device << ")";
+  throw std::runtime_error(os.str());
+}
+
+// Makes `device` current for a launch path and restores the caller's device. The constructor raises RuntimeError (slot
+// entry consumed) if the current device cannot be read or the switch fails; nothing is switched then. restore() is the
+// success-path restore and raises if it fails. The destructor restores only if restore() was not reached (an exception
+// is unwinding) and then routes a failure to note_unraisable_device_restore_failure (rule 2): no throw from a
+// destructor.
+class DeviceGuard {
+ public:
+  explicit DeviceGuard(int device) : device_(device) {
+    cudaError_t e = cudaGetDevice(&prev_);
+    if (e != cudaSuccess) raise_cuda_failure("tc_signal: cudaGetDevice", e);
+    if (prev_ != device) {
+      e = cudaSetDevice(device);
+      if (e != cudaSuccess) raise_cuda_failure("tc_signal: cudaSetDevice(" + std::to_string(device) + ")", e);
+      switched_ = true;
+    }
+  }
+  void restore() {
+    if (!switched_) return;
+    switched_ = false;
+    const cudaError_t e = cudaSetDevice(prev_);
+    if (e != cudaSuccess)
+      raise_cuda_failure("tc_signal: restoring the caller's CUDA device " + std::to_string(prev_) +
+                             " after queueing work on device " + std::to_string(device_) +
+                             " (cudaSetDevice; the calling thread's current device is still " +
+                             std::to_string(device_) + ", and the call's operands stay retained until that work is done)",
+                         e);
+  }
+  ~DeviceGuard() {
+    if (!switched_) return;
+    const cudaError_t e = cudaSetDevice(prev_);
+    if (e != cudaSuccess) {
+      note_unraisable_device_restore_failure(prev_, e);  // P1T-FIX8 (sweep (k)): recorded before it is consumed
+      cudaGetLastError();
+    }
+  }
+  DeviceGuard(const DeviceGuard&) = delete;
+  DeviceGuard& operator=(const DeviceGuard&) = delete;
+
+ private:
+  int device_;
+  int prev_ = -1;
+  bool switched_ = false;
+};
+
+// The never-throwing variant for release paths (destructors, noexcept drains). A failed query or switch is reported
+// through ok()/error() with its slot entry consumed; a failed restore follows rule 2.
+// P1T-FIX7 (V7-02 sweep (j)): failed_at_switch() says WHICH of the guard's two calls failed (cudaSetDevice of the
+// target device, or the cudaGetDevice before it), so a release path records the call that failed, not the call the
+// guard prevented (FIX6 reported a failed switch as a failed stream sync / event record / event destroy).
+class QuietDeviceGuard {
+ public:
+  explicit QuietDeviceGuard(int device) noexcept {
+    cudaError_t e = cudaGetDevice(&prev_);
+    if (e != cudaSuccess) {
+      cudaGetLastError();
+      err_ = e;
+      return;
+    }
+    if (prev_ != device) {
+      e = cudaSetDevice(device);
+      if (e != cudaSuccess) {
+        cudaGetLastError();
+        err_ = e;
+        switch_failed_ = true;
+        return;
+      }
+      switched_ = true;
+    }
+  }
+  ~QuietDeviceGuard() {
+    if (!switched_) return;
+    const cudaError_t e = cudaSetDevice(prev_);
+    if (e != cudaSuccess) {
+      note_unraisable_device_restore_failure(prev_, e);  // P1T-FIX8 (sweep (k)): recorded before it is consumed
+      cudaGetLastError();
+    }
+  }
+  QuietDeviceGuard(const QuietDeviceGuard&) = delete;
+  QuietDeviceGuard& operator=(const QuietDeviceGuard&) = delete;
+  bool ok() const { return err_ == cudaSuccess; }
+  cudaError_t error() const { return err_; }
+  bool failed_at_switch() const { return switch_failed_; }  // P1T-FIX7: false = the cudaGetDevice before it failed
+
+ private:
+  int prev_ = 0;
+  cudaError_t err_ = cudaSuccess;
+  bool switched_ = false;
+  bool switch_failed_ = false;
+};
+
+}  // namespace tcs
diff --git a/tc_signal/src/dlpack_operand.cpp b/tc_signal/src/dlpack_operand.cpp
new file mode 100644
index 0000000..10a19f7
--- /dev/null
+++ b/tc_signal/src/dlpack_operand.cpp
@@ -0,0 +1,2271 @@
+// DLPack consumer implementation. Prior art and design notes: see dlpack_operand.h.
+#include "dlpack_operand.h"
+
+#include <cuda_runtime.h>
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdio>  // P1T-FIX5 V5-01: exit-wait diagnostics written without the GIL
+#include <cstring>
+#include <deque>
+#include <mutex>
+#include <new>
+#include <limits>
+#include <sstream>
+#include <stdexcept>
+#include <system_error>
+#include <thread>
+#include <unordered_map>
+
+#include "checked_math.h"
+#include "cuda_guard.h"  // P1T-FIX4: DeviceGuard / QuietDeviceGuard and the error-slot rules
+#include "tuning.h"
+
+namespace tcs {
+
+namespace {
+
+constexpr const char* kCapsule = "dltensor";
+constexpr const char* kCapsuleVersioned = "dltensor_versioned";
+constexpr const char* kUsedCapsule = "used_dltensor";
+constexpr const char* kUsedCapsuleVersioned = "used_dltensor_versioned";
+
+std::string type_name(py::handle obj) { return Py_TYPE(obj.ptr())->tp_name; }
+
+std::string capsule_name(py::handle cap) {
+  const char* n = PyCapsule_GetName(cap.ptr());
+  if (n == nullptr && PyErr_Occurred()) throw py::error_already_set();
+  return n ? std::string(n) : std::string();
+}
+
+[[noreturn]] void refuse_value(const char* role, const std::string& msg) {
+  throw py::value_error(std::string("tc_signal: operand '") + role + "': " + msg);
+}
+
+[[noreturn]] void refuse_type(const char* role, const std::string& msg) {
+  throw py::type_error(std::string("tc_signal: operand '") + role + "': " + msg);
+}
+
+// Checks a capsule's name and returns its kind (true = versioned). Consumed and foreign capsules are refused.
+bool capsule_kind(py::handle cap, const char* role) {
+  const std::string n = capsule_name(cap);
+  if (n == kCapsuleVersioned) return true;
+  if (n == kCapsule) return false;
+  if (n == kUsedCapsule || n == kUsedCapsuleVersioned)
+    refuse_value(role, "the DLPack capsule was already consumed (name '" + n + "'); a capsule can be consumed once");
+  refuse_type(role, "a capsule named '" + n + "' is not a DLPack capsule ('dltensor' or 'dltensor_versioned')");
+}
+
+void* capsule_pointer(py::handle cap, const char* name) {
+  void* p = PyCapsule_GetPointer(cap.ptr(), name);
+  if (p == nullptr) throw py::error_already_set();
+  return p;
+}
+
+void check_version(const DLManagedTensorVersioned* m, const char* role) {
+  if (m->version.major != DLPACK_MAJOR_VERSION) {
+    std::ostringstream os;
+    os << "DLPack major version " << m->version.major << " is not supported (this consumer reads major "
+       << DLPACK_MAJOR_VERSION << ")";
+    refuse_value(role, os.str());
+  }
+}
+
+}  // namespace
+
+// ------------------------------------------------------------------------------------------------ release lifecycle (V5-01)
+// P1T-FIX5, round-5 review finding V5-01 (MAJOR): interpreter exit overtook a producer deleter that was already running
+// on another thread. A daemon thread's call refused a versioned read-only output; the Operand constructor ran the
+// producer deleter while unwinding; the deleter released the GIL (time.sleep); the atexit hook saw an empty pending list
+// and returned; CPython began finalizing; when the deleter re-took the GIL, CPython 3.12 exited the thread
+// (PyEval_RestoreThread -> take_gil -> _PyThreadState_MustExit -> PyThread_exit_thread -> pthread_exit), and that forced
+// unwind (abi::__forced_unwind) reached the catch-all of call_deleter_contained inside the noexcept ManagedOwner::reset:
+// glibc aborts ("FATAL: exception not rethrown", rc -6). The deferred drain had the same gap (an entry is popped before
+// its deleters run, so a running deleter was invisible to the pending list).
+//
+// The fix is an admission / closing / in-flight protocol for every add-on callback that may take the GIL, independent of
+// the pending list. Two kinds of admitted section, each with an in-flight count and a per-thread depth:
+//  * kRelease: one producer deleter call (ManagedOwner::reset, so every release path: the immediate release of a
+//    refused call while unwinding, the next-call drain, synchronize(), the bound drain, the fallback sync of
+//    ~RetainUntilComplete) and one drop of the last reference to an unconsumed DLPack capsule (CapsuleRef::drop: the
+//    producer's capsule destructor calls its deleter);
+//  * kCallback: the producer's Python callbacks in to_capsule (attribute lookups, __dlpack_device__, __dlpack__).
+// Protocol:
+//  * admit(k): if the interpreter is not accepting Python (not initialized, or finalizing: second line of defence, as
+//    core's interpreter_accepts_gil_state), refuse; else increment in_flight[k], THEN read `closing`; if it is set, back
+//    out (decrement, notify) and refuse; else ++t_depth[k] and run the section. leave(k): --t_depth[k], decrement,
+//    notify. `closing` and the counts are sequentially consistent atomics: admit is "increment, then read closing", the
+//    exit hook is "set closing, then read the counts", so at least one side sees the other (the store-buffering
+//    handshake: either the releaser sees closing and backs out, or the hook sees the count and waits).
+//  * A refused release is never run: the deleter is not called (the manager is leaked, counted), the capsule reference
+//    is kept (counted); no producer code and no Python is entered. A refused producer callback raises RuntimeError
+//    before calling it (nothing acquired).
+//  * close_admission_and_wait (tc_signal's atexit hook, GIL held): set `closing` for good, then wait until no admitted
+//    section of ANOTHER thread is in flight (in_flight[k] <= this thread's t_depth[k] for both kinds: self-exclusion, so
+//    a hook running inside its own callback does not wait for itself). CPython 3.12.3 runs atexit callbacks before it
+//    marks the runtime finalizing (Py_FinalizeEx: _PyAtExit_Call, then _PyInterpreterState_SetFinalizing /
+//    _PyRuntimeState_SetFinalizing; verified by P1T-FIX2 in pylifecycle.c lines 1815 and 1832-1833), so once the hook
+//    returns no admitted add-on callback is running, and every later one is refused: nothing in the add-on can take the
+//    GIL after finalization begins.
+//  * The wait has NO time bound (round-3 V3-01: a bounded return lets finalization overtake the callback). After a delay
+//    (tc_signal._RELEASE_EXIT_DIAG_S, default 5 s) it writes one stderr line, then another each time the time waited
+//    has doubled. Consequence: a producer deleter, capsule destructor or __dlpack__ that never returns makes interpreter
+//    exit wait for it (the producer's contract violation; waiting is the honest outcome, an early return aborts).
+//  * GIL: the waiting thread releases the GIL with PyEval_SaveThread (an admitted callback that needs the GIL can then
+//    finish), waits on the condition variable with no Python object touched, drops the mutex, and only then re-takes
+//    the GIL with PyEval_RestoreThread, called explicitly in a NON-noexcept frame (not from a destructor such as
+//    py::gil_scoped_release's): if CPython exits a waiting daemon thread there during finalization, the forced unwind
+//    travels through ordinary frames to pybind11's dispatcher, which rethrows abi::__forced_unwind (pybind11 v2.12
+//    pybind11.h:1037), instead of meeting a noexcept boundary. No thread waits for the GIL while holding the mutex.
+//  * P1T-FIX6, round-6 review finding V6-01 (MAJOR): FIX5 also made synchronize() (any thread) wait, without closing,
+//    for releases already admitted on other threads. That wait deadlocked: thread A holds an application lock (a
+//    producer's allocator lock) and calls synchronize(); thread B is releasing a refused operand whose finite producer
+//    deleter needs that lock; A waits for B and B waits for A (releasing the GIL does not release A's lock; reviewer
+//    probe sync_lock_inversion_cpu.py, rc 1 on acd42fa). The wait is REMOVED: synchronize() never waits for another
+//    thread. A release that another thread popped off the pending list before this call is that thread's release:
+//    it finishes there (it was handed to that thread's call, not to this one), and synchronize() reports and releases
+//    only what is still on the list. The only waiter is the exit hook (close_admission_and_wait), which is where the
+//    wait is needed: there, finalization must not start under a running callback (V5-01). The exit hook's wait is
+//    documented (tc_signal/__init__.py, README): it waits for callbacks admitted before it closed admission, so the
+//    exiting thread must not hold a lock such a callback needs (CPython's own exit has the same rule for the
+//    non-daemon threads it joins, threading._shutdown).
+//    Prior art: Coffman, Elphick & Shoshani (1971) "System Deadlocks" (circular wait is one of the four necessary
+//    conditions; removing the wait from ordinary calls removes the cycle); lock-ordering discipline (never block on
+//    another thread's callback while the caller may hold locks it needs); RCU (McKenney & Slingwine 1998:
+//    synchronize_rcu waits only for readers that began before it) is why a separate "wait for releases" API would need a
+//    pre-call generation boundary and a no-locks-held contract; none is offered (no caller needs it).
+// The pending list itself is unchanged (still GIL-protected; nothing here holds a reference into it across a wait).
+//
+// Prior art: core's own ImportReleaseLifecycle (tensor_cuda/src/bindings.cpp, P1T-FIX2 N5 and P1T-FIX3 V3-01). Reused
+// from it: the closing flag + in-flight count + condition variable, the unbounded wait with the GIL released and a
+// doubling stderr diagnostic schedule, the thread-local depth for self-exclusion, "leak, never enter Python, after
+// closing", and the atexit-before-finalizing argument. Different here: the add-on's releasers already hold the GIL (no
+// PyGILState_Ensure), so admission is two seq_cst atomics instead of a mutex section; two section kinds (releases and
+// producer callbacks); the GIL is re-taken explicitly rather than by a destructor; only the exit hook waits. Further
+// prior art: CPython's threading._shutdown / wait_for_thread_shutdown (finalization waits, unbounded, for non-daemon
+// threads already started); RCU grace periods (synchronize_rcu waits for every reader that entered before it, while new
+// readers do not delay it; McKenney & Slingwine 1998) and the Linux percpu_ref "kill, then wait for zero"; the
+// store-buffering (Dekker, Dijkstra 1965) handshake for flag + counter admission; glibc/libstdc++ forced unwinding
+// (abi::__forced_unwind must be rethrown by a catch-all; a noexcept frame terminates). Ours: applying the protocol to the
+// add-on's deleter, capsule-drop and producer-callback sites. Unverified here (lead to check): "CPython 3.12
+// take_gil _PyThreadState_MustExit PyThread_exit_thread", "synchronize_rcu McKenney Slingwine 1998".
+namespace {
+
+enum LifecycleKind : int { kRelease = 0, kCallback = 1, kKinds = 2 };
+
+struct Lifecycle {
+  std::mutex mu;                           // only for the waiter's condition variable; admission never takes it
+  std::condition_variable cv;
+  std::atomic<bool> closing{false};
+  std::atomic<long long> in_flight[kKinds];
+  Lifecycle() {
+    for (auto& c : in_flight) c.store(0);
+  }
+};
+
+// Never destroyed (a callback may run during static destruction). Constructed at module import (init_pending_state).
+Lifecycle& lifecycle() {
+  static Lifecycle* s = new Lifecycle();
+  return *s;
+}
+
+// Admitted sections on THIS thread's stack, per kind (self-exclusion; also synchronize()'s skip rule).
+thread_local long long t_depth[kKinds] = {0, 0};
+
+// Static storage: counting never allocates.
+std::atomic<unsigned long long> g_admitted[kKinds];
+std::atomic<unsigned long long> g_deleters_leaked_after_close{0};   // V5-01: "a late release leaks, and is counted"
+std::atomic<unsigned long long> g_deleters_leaked_finalizing{0};
+std::atomic<unsigned long long> g_capsules_kept_after_close{0};
+std::atomic<unsigned long long> g_capsules_kept_finalizing{0};
+std::atomic<unsigned long long> g_callbacks_refused{0};
+std::atomic<unsigned long long> g_lifecycle_lock_failures{0};
+std::atomic<unsigned long long> g_exit_hook_calls{0};
+std::atomic<unsigned long long> g_exit_in_flight_at_close{0};
+std::atomic<unsigned long long> g_exit_wait_us{0};
+std::atomic<unsigned long long> g_exit_wait_diagnostics{0};
+std::atomic<unsigned long long> g_exit_wait_overruns{0};
+std::atomic<unsigned long long> g_exit_wait_poll_diagnostics{0};  // P1T-FIX7 L1: lines of the polling fallback
+// P1T-FIX6 (V6-01): FIX5's g_sync_waits / g_sync_wait_us / g_sync_wait_diagnostics counted synchronize()'s wait for
+// other threads; that wait is removed, and so are they (and their pending_stats keys).
+
+bool interpreter_accepts_python() noexcept {
+  if (!Py_IsInitialized()) return false;
+#if PY_VERSION_HEX >= 0x030D0000
+  if (Py_IsFinalizing()) return false;
+#else
+  if (_Py_IsFinalizing()) return false;
+#endif
+  return true;
+}
+
+enum class Admission { kAdmitted, kClosed, kFinalizing };
+
+void leave_count(Lifecycle& lc, LifecycleKind k) noexcept {
+  lc.in_flight[k].fetch_sub(1, std::memory_order_seq_cst);
+  // Take and drop the mutex before notifying: a waiter checks its predicate while holding it, so this leave either
+  // happened before that check (seen) or waits until the waiter blocks (then the notify wakes it). No lost wakeup.
+  try {
+    std::lock_guard<std::mutex> lk(lc.mu);
+  } catch (const std::system_error&) {
+    g_lifecycle_lock_failures.fetch_add(1, std::memory_order_relaxed);  // never observed; the waiter also polls
+  }
+  lc.cv.notify_all();
+}
+
+Admission admit(LifecycleKind k) noexcept {
+  if (!interpreter_accepts_python()) return Admission::kFinalizing;
+  Lifecycle& lc = lifecycle();
+  lc.in_flight[k].fetch_add(1, std::memory_order_seq_cst);
+  if (lc.closing.load(std::memory_order_seq_cst)) {
+    leave_count(lc, k);  // back out: admission closed
+    return Admission::kClosed;
+  }
+  ++t_depth[k];
+  g_admitted[k].fetch_add(1, std::memory_order_relaxed);
+  return Admission::kAdmitted;
+}
+
+void leave(LifecycleKind k) noexcept {
+  --t_depth[k];
+  leave_count(lifecycle(), k);
+}
+
+// RAII for the producer-callback section of to_capsule. Throws RuntimeError (before any callback) when refused.
+class CallbackSection {
+ public:
+  explicit CallbackSection(const char* role) {
+    const Admission a = admit(kCallback);
+    if (a == Admission::kAdmitted) return;
+    g_callbacks_refused.fetch_add(1, std::memory_order_relaxed);
+    throw std::runtime_error(std::string("tc_signal: operand '") + role + "': " +
+                             (a == Admission::kClosed
+                                  ? "interpreter exit has begun (tc_signal's exit hook closed admission)"
+                                  : "the interpreter is finalizing") +
+                             ", so the producer's __dlpack__ is not called; refused before acquiring anything");
+  }
+  ~CallbackSection() { leave(kCallback); }
+  CallbackSection(const CallbackSection&) = delete;
+  CallbackSection& operator=(const CallbackSection&) = delete;
+};
+
+struct WaitOutcome {
+  long long running_at_start = 0;  // admitted sections of OTHER threads when the wait began
+  long long own[kKinds] = {0, 0};  // this thread's own (excluded)
+  long long waited_us = 0;
+  unsigned long long diagnostics = 0;
+  bool overran = false;            // outlasted the first-diagnostic delay
+};
+
+// Admitted sections (releases and producer callbacks) of OTHER threads: the calling thread's own are excluded.
+long long others_running(const Lifecycle& lc, const long long own[kKinds]) noexcept {
+  return lc.in_flight[kRelease].load(std::memory_order_seq_cst) - own[kRelease] +
+         lc.in_flight[kCallback].load(std::memory_order_seq_cst) - own[kCallback];
+}
+
+// The part of the exit wait that runs with the GIL released: the mutex and condition variable only, no Python object.
+// P1T-FIX7, lead send-back L1 (sweep (i) addendum): FIX5's fallback for a failed lifecycle mutex / condition variable
+// (poll every kLifecyclePollMs until quiet) was a SILENT exit wait. It now keeps the same diagnostic schedule as the
+// condition-variable wait (FIX3 V3-01 / FIX5 V5-01: the first line after first_diag_s from the start of the wait, then
+// each time the time waited has doubled; C stdio, no allocation, GIL released), says that it is polling and why, and
+// counts each line (w.diagnostics -> pending_stats() exit_wait_diagnostics for the hook's close, and
+// exit_wait_poll_diagnostics for every polling line). It still never returns early. Prior art: FIX3 / FIX5's own
+// schedule (taken as is); ours: applying it to the fallback.
+void wait_without_gil(Lifecycle& lc, double first_diag_s, std::chrono::steady_clock::time_point t0,
+                      WaitOutcome& w) noexcept {
+  using clock = std::chrono::steady_clock;
+  const auto first = std::chrono::duration_cast<clock::duration>(std::chrono::duration<double>(first_diag_s));
+  const auto tick = clock::duration(1);  // next line at least one clock tick later: no busy loop at a zero delay
+  auto quiet = [&lc, &w] { return others_running(lc, w.own) <= 0; };
+  auto next = t0 + first;
+  try {
+    std::unique_lock<std::mutex> lk(lc.mu);
+    while (!lc.cv.wait_until(lk, next, quiet)) {
+      // Still running at the diagnostic time: report, then keep waiting (never return early: V3-01, V5-01).
+      w.overran = true;
+      const long long running = others_running(lc, w.own);
+      lk.unlock();  // a blocked stderr must not stop a callback from leaving
+      const auto now = clock::now();
+      std::fprintf(stderr,
+                   "tc_signal: %lld DLPack producer callback(s) (deleter, capsule destructor or __dlpack__) admitted "
+                   "on other threads before interpreter exit still running after %.1f s; interpreter exit waits for "
+                   "them (no new one is admitted)\n",
+                   running, std::chrono::duration<double>(now - t0).count());
+      std::fflush(stderr);
+      ++w.diagnostics;
+      const auto waited = now - t0;  // next line when the time waited has doubled
+      next = now + (waited > tick ? waited : tick);
+      lk.lock();
+    }
+    return;
+  } catch (const std::system_error&) {
+    // A mutex / condition-variable failure (never observed): keep waiting by polling, never return early.
+    g_lifecycle_lock_failures.fetch_add(1, std::memory_order_relaxed);
+  }
+  while (!quiet()) {
+    const auto now = clock::now();
+    if (now >= next) {  // the same schedule as above, continued from where it was: never a silent wait
+      w.overran = true;
+      std::fprintf(stderr,
+                   "tc_signal: %lld DLPack producer callback(s) (deleter, capsule destructor or __dlpack__) admitted "
+                   "on other threads before interpreter exit still running after %.1f s; interpreter exit waits for "
+                   "them (no new one is admitted; polling every %d ms because the lifecycle mutex or condition "
+                   "variable failed)\n",
+                   others_running(lc, w.own), std::chrono::duration<double>(now - t0).count(),
+                   tuning::kLifecyclePollMs);
+      std::fflush(stderr);
+      ++w.diagnostics;
+      g_exit_wait_poll_diagnostics.fetch_add(1, std::memory_order_relaxed);
+      const auto waited = now - t0;
+      next = now + (waited > tick ? waited : tick);
+    }
+    std::this_thread::sleep_for(std::chrono::milliseconds(tuning::kLifecyclePollMs));
+  }
+}
+
+// The exit hook's wait (P1T-FIX6: its only caller; ordinary calls never wait for another thread, V6-01): until no
+// admitted section of another thread is running. The GIL is released for the wait and re-taken explicitly here (see
+// the design block above for why not by a destructor).
+WaitOutcome wait_for_other_threads(double first_diag_s) {
+  Lifecycle& lc = lifecycle();
+  WaitOutcome w;
+  w.own[kRelease] = t_depth[kRelease];
+  w.own[kCallback] = t_depth[kCallback];
+  w.running_at_start = others_running(lc, w.own);
+  if (w.running_at_start <= 0) return w;  // nothing to wait for: the GIL is not touched
+  if (!(first_diag_s >= 0.0)) first_diag_s = 0.0;   // NaN or negative: diagnose at once (the wait is the same)
+  if (first_diag_s > tuning::kLifecycleMaxDiagDelayS) first_diag_s = tuning::kLifecycleMaxDiagDelayS;
+  const auto t0 = std::chrono::steady_clock::now();
+  const bool held = PyGILState_Check() != 0;
+  PyThreadState* ts = held ? PyEval_SaveThread() : nullptr;  // GIL released: an admitted callback can finish
+  wait_without_gil(lc, first_diag_s, t0, w);
+  if (held) PyEval_RestoreThread(ts);  // the mutex is not held here; may exit a daemon thread during finalization
+  w.waited_us = std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - t0).count();
+  return w;
+}
+
+}  // namespace
+
+void CapsuleRef::drop() noexcept {
+  PyObject* p = p_;
+  p_ = nullptr;
+  if (p == nullptr) return;
+  if (!interpreter_accepts_python()) {
+    // Finalizing (for example a daemon thread unwinding after CPython exited it): never touch Python. Kept.
+    g_capsules_kept_finalizing.fetch_add(1, std::memory_order_relaxed);
+    return;
+  }
+  // P1T-FIX6 (sweep (g), user Python run from a native frame): FIX5 admitted only the last reference of an UNCONSUMED
+  // capsule. The last reference of a consumed ("used_*") capsule also runs the producer's PyCapsule destructor: per the
+  // DLPack Python spec that destructor only returns for a consumed capsule, but it is still producer code (a ctypes or
+  // Cython destructor runs Python, and may release and re-take the GIL), run from this native frame. Every
+  // last-reference drop of a capsule is therefore admitted (waited for by the exit hook), or kept once admission has
+  // closed (a consumed capsule kept at exit holds no producer memory: nothing is lost). A capsule with no destructor,
+  // or a drop that is not the last reference, runs no producer code either way.
+  if (PyCapsule_CheckExact(p) && Py_REFCNT(p) == 1) {
+    // The last reference to a DLPack capsule: dropping it runs the producer's destructor (which, for an unconsumed
+    // capsule, calls the producer's deleter). A release: admitted, or kept (never run) once admission has closed.
+    const Admission a = admit(kRelease);
+    if (a != Admission::kAdmitted) {
+      (a == Admission::kClosed ? g_capsules_kept_after_close : g_capsules_kept_finalizing)
+          .fetch_add(1, std::memory_order_relaxed);
+      return;
+    }
+    Py_DECREF(p);
+    leave(kRelease);
+    return;
+  }
+  Py_DECREF(p);
+}
+
+// ------------------------------------------------------------------------------------------------ capsule acquisition
+CapsuleRef to_capsule(py::handle obj, const char* role, bool writable) {
+  if (PyCapsule_CheckExact(obj.ptr())) return CapsuleRef(py::reinterpret_borrow<py::object>(obj));
+  // P1T-FIX5 (V5-01 sweep (c)): from here to the return, the producer's Python code may run (and release / re-take the
+  // GIL): an admitted section, waited for by the exit hook; refused (RuntimeError, nothing called) after it closed.
+  CallbackSection section(role);
+  if (!py::hasattr(obj, "__dlpack__"))
+    refuse_type(role, "expected a DLPack producer (an object with __dlpack__) or a DLPack capsule, got " +
+                          type_name(obj));
+  // Array API order: ask the producer's device first. A non-CUDA producer is refused here, before __dlpack__ is
+  // called with a CUDA stream argument (CPU producers such as NumPy reject any stream other than None).
+  if (py::hasattr(obj, "__dlpack_device__")) {
+    int device_type = -1;
+    try {
+      py::tuple dev = obj.attr("__dlpack_device__")().cast<py::tuple>();
+      device_type = dev[0].cast<int>();
+    } catch (py::cast_error&) {
+      refuse_type(role, "__dlpack_device__() did not return a (device_type, device_id) tuple of ints");
+    }
+    if (device_type != kDLCUDA) {
+      std::ostringstream os;
+      os << "device type " << device_type << " is not kDLCUDA (2); tc_signal takes CUDA device memory only";
+      refuse_value(role, os.str());
+    }
+  }
+  py::object fn = obj.attr("__dlpack__");
+  py::object cap;
+  const py::tuple max_version = py::make_tuple(tuning::kDlpackMaxMajor, tuning::kDlpackMaxMinor);
+  try {
+    // Consumer stream = the legacy default stream (DLPack int 1): the producer orders its pending work before it.
+    if (writable)
+      cap = fn(py::arg("stream") = tuning::kDlpackLegacyStream, py::arg("max_version") = max_version,
+               py::arg("copy") = false);
+    else
+      cap = fn(py::arg("stream") = tuning::kDlpackLegacyStream, py::arg("max_version") = max_version);
+  } catch (py::error_already_set& e) {
+    // A producer that predates the 2023 keywords rejects them with TypeError: retry with the stream argument only
+    // (the array API standard's documented fallback; NumPy and PyTorch consumers do the same).
+    if (!e.matches(PyExc_TypeError)) throw;
+    cap = fn(py::arg("stream") = tuning::kDlpackLegacyStream);
+  }
+  if (!PyCapsule_CheckExact(cap.ptr()))
+    refuse_type(role, "__dlpack__ returned " + type_name(cap) + ", not a PyCapsule");
+  return CapsuleRef(std::move(cap));
+}
+
+const DLTensor* peek(py::handle capsule, const char* role) {
+  if (!PyCapsule_CheckExact(capsule.ptr())) refuse_type(role, "expected a DLPack capsule, got " + type_name(capsule));
+  if (capsule_kind(capsule, role)) {
+    auto* m = static_cast<DLManagedTensorVersioned*>(capsule_pointer(capsule, kCapsuleVersioned));
+    check_version(m, role);
+    return &m->dl_tensor;
+  }
+  auto* m = static_cast<DLManagedTensor*>(capsule_pointer(capsule, kCapsule));
+  return &m->dl_tensor;
+}
+
+// ------------------------------------------------------------------------------------------------ validation
+int64_t validate_tensor(const DLTensor* t, const char* role, int ndim) {
+  if (t->device.device_type != kDLCUDA) {
+    std::ostringstream os;
+    os << "device type " << static_cast<int>(t->device.device_type)
+       << " is not kDLCUDA (2); tc_signal takes CUDA device memory only";
+    refuse_value(role, os.str());
+  }
+  if (t->dtype.code != kDLFloat || t->dtype.bits != 32 || t->dtype.lanes != 1) {
+    std::ostringstream os;
+    os << "dtype (code " << static_cast<int>(t->dtype.code) << ", bits " << static_cast<int>(t->dtype.bits)
+       << ", lanes " << t->dtype.lanes
+       << ") is not float32; tc_signal computes in fp32 only (expand fp16 weights to fp32 first)";
+    refuse_type(role, os.str());
+  }
+  // F03 (P1T-FIX1): a negative rank or a NULL shape array (with rank > 0) is refused before the shape is read.
+  if (t->ndim < 0) {
+    std::ostringstream os;
+    os << "negative number of dimensions " << t->ndim;
+    refuse_value(role, os.str());
+  }
+  if (t->ndim > 0 && t->shape == nullptr) refuse_value(role, "NULL shape array for a tensor with dimensions");
+  if (t->ndim != ndim) {
+    std::ostringstream os;
+    os << "expected " << ndim << " dimensions, got " << t->ndim;
+    refuse_value(role, os.str());
+  }
+  // F03: checked element count and fp32 byte total, before the stride walk below multiplies extents and before any
+  // later byte range is formed.
+  // P1T-FIX2, review finding N2 (zero-extent rule, checked_math.h ck_extent_bound): EVERY extent is multiplied (a zero
+  // or negative one counted as 1) BEFORE the empty-operand refusal, so a shape such as [0, 2^62, 4] is refused as an
+  // overflow, never waved through because its count is 0. Prior art: NumPy's array constructor rule (see
+  // checked_math.h); the checked builtins (GCC 5, 2015).
+  int64_t numel = 1;
+  for (int i = 0; i < t->ndim; ++i) {
+    if (__builtin_mul_overflow(numel, t->shape[i] > 1 ? t->shape[i] : int64_t{1}, &numel))
+      refuse_value(role, "element count of shape " + shape_str(shape_of(t)) +
+                             " overflows int64 (every nonzero extent counts, also next to a zero extent)");
+  }
+  int64_t nbytes = 0;
+  if (__builtin_mul_overflow(numel, static_cast<int64_t>(sizeof(float)), &nbytes))
+    refuse_value(role, "byte size of shape " + shape_str(shape_of(t)) + " (fp32) overflows int64");
+  for (int i = 0; i < t->ndim; ++i)
+    if (t->shape[i] <= 0) refuse_value(role, "empty operand (shape " + shape_str(shape_of(t)) + ")");
+  // Every extent is >= 1 from here: numel is the element count and nbytes its fp32 byte size.
+  if (t->strides != nullptr) {
+    // C-contiguous: every dimension of extent > 1 has the compact stride; size-1 dimensions may carry any stride
+    // (they are never stepped), as the order and the DLPack/array API conventions allow.
+    int64_t want = 1;
+    for (int i = t->ndim - 1; i >= 0; --i) {
+      if (t->shape[i] != 1 && t->strides[i] != want) {
+        std::ostringstream os;
+        os << "not C-contiguous (shape " << shape_str(shape_of(t)) << ", strides [";
+        for (int j = 0; j < t->ndim; ++j) os << (j ? ", " : "") << t->strides[j];
+        os << "]); pass a contiguous tensor";
+        refuse_value(role, os.str());
+      }
+      want *= t->shape[i];
+    }
+  }
+  if (t->data == nullptr) refuse_value(role, "NULL data pointer");
+  // F03: data + byte_offset (element 0) and element 0 + nbytes (one past the end) must not wrap the address space.
+  uintptr_t p = 0;
+  uintptr_t end = 0;
+  if (__builtin_add_overflow(reinterpret_cast<uintptr_t>(t->data), static_cast<uintptr_t>(t->byte_offset), &p) ||
+      __builtin_add_overflow(p, static_cast<uintptr_t>(nbytes), &end))
+    refuse_value(role, "data + byte_offset + byte size overflows the address space");
+  if (p % alignof(float) != 0) refuse_value(role, "data + byte_offset is not 4-byte aligned");
+  return numel;
+}
+
+void require_operand(py::handle obj, const char* role) {
+  // F02 (P1T-FIX1): None is never a tensor. Refused with TypeError before any planning, allocation or consumption.
+  if (obj.is_none())
+    refuse_type(role, "is required: expected a DLPack producer (an object with __dlpack__) or a DLPack capsule, got "
+                      "None (only optional operands such as a bias may be None)");
+}
