+    X = _dev(x)
+    a1, a2 = _host(ts.reflection_pad1d(X, (pb, pe))), _host(ts.reflection_pad1d(X, [pb, pe]))
+    _record(receipt, 'reflection_pad1d', kind, name, {'shape': list(shape), 'pads': [pb, pe]}, a1, a2,
+            O.pad_oracle(x, pb, pe), strict=True)
