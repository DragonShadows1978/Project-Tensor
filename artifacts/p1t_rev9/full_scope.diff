+calls, KEEP = [], []
+@P.DELETER
+def deleter(addr):
+    calls.append(addr)
+def cap(n, data):
+    sh = (ctypes.c_int64 * 1)(n)
+    m = P.DLManagedTensor()
+    t = m.dl_tensor
+    t.data, t.device, t.ndim, t.dtype = data, P.DLDevice(2, 0), 1, P.DLDataType(2, 32, 1)
+    t.shape, t.strides, t.byte_offset = sh, ctypes.POINTER(ctypes.c_int64)(), 0
+    m.manager_ctx, m.deleter = None, deleter
+    KEEP.append((sh, m))
