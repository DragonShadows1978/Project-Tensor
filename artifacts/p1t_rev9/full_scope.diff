+    assert r.returncode == 0 and res is not None, f'rc={r.returncode}\nstdout={r.stdout}\nstderr={r.stderr}'
+
+
+def _no_abort(r):
+    for bad in _ABORT_MARKERS:
+        assert bad not in r.stderr, f'{bad!r} in stderr:\n{r.stderr}'
