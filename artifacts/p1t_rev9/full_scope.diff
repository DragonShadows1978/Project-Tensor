+            self.sleep(1.5)
+    _holder = types.ModuleType('_fix5_thrower_holder')
+    _holder.keep = Finalizer()
+    sys.modules['_fix5_thrower_holder'] = _holder
+    del _holder
+print('ARMED', flush=True)
+'''.replace('TESTS_DIR', repr(str(TESTS_DIR)))
