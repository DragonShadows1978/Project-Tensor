+    res = json.loads(lines[-1][len("RESULT "):])
+    assert res["before_hook"]["stats"]["in_flight"] == 1, res
+    assert res["after_hook"]["calls"] == 1 and res["after_hook"]["done"] is True, res   # finished before finalizing
