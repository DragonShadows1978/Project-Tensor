+// P1T-FIX6, sweep (g) "user Python run from inside a native frame": how every _tc_signal binding receives its
+// arguments.
+//
+// Defect class (round-6 review V6-02 found it in core; this sweep found the same class in every typed parameter of the
+// add-on). pybind11's typed argument casters run conversions in the dispatcher, before the function body: an int64_t
+// parameter calls a foreign object's __index__, a double its __float__ / __index__, a bool its __bool__, a
+// std::vector its __len__ / __getitem__ and each item's conversion. That user Python runs on a native stack. If it
+// releases the GIL (time.sleep, I/O) on a daemon thread while the interpreter starts finalizing, CPython 3.12 exits the
+// thread when it re-takes the GIL (pthread_exit, a forced unwind). The unwind runs the dispatcher's C++ cleanup: when a
+// keyword argument filled a named parameter, the dispatcher holds the only reference to its private copy of the kwargs
+// dict (pybind11 v2.12 pybind11.h:880-883, PyDict_Copy), and that dict is deallocated with the exiting thread's state
+// already freed: SIGSEGV (receipt: scratch experiment `_C.empty(shape=SeqLen())` rc 139 2/2 on acd42fa, positional
+// rc 0; ledger 07:32-07:40). pybind11's own failure paths run user Python too: when no overload matches it builds its
+// TypeError with repr() of every argument (pybind11.h:1122-1160), and it looks keyword names up with dict lookups that
+// may call a str subclass's __eq__.
+//
+// The fix (refusal before invocation, the order's option (ii), for every binding of this module): every binding is
+// declared as (*args, **kwargs). For that signature the dispatcher copies no argument, looks up no keyword name, has no
+// overload to mismatch, and never converts (receipt: scratch module /tmp/p1t_fix6_scratch/pbtest; a method's self
+// arrives as args[0]). CallArgs then matches positions and keyword names with C-level comparisons only
+// (PyUnicode_CompareWithASCIIString reads the string's data, also for a str subclass: no __eq__, no __hash__), and the
+// converters below accept exactly the types whose value can be read without calling any Python-level method:
+//   * int parameters: int and its subclasses (bool, IntEnum) -- PyLong_AsLongLongAndOverflow reads a PyLong_Check
+//     object's value directly (CPython 3.12 Objects/longobject.c: _PyNumber_Index only for non-ints), so an
+//     overridden __index__ / __int__ is never called; out of the int64 range -> OverflowError;
+//   * real parameters: float and its subclasses (PyFloat_AsDouble reads PyFloat_Check objects directly), int and its
+//     subclasses (PyLong_AsDouble, likewise); anything else -> TypeError;
+//   * flags: bool, or an int (nonzero = true, read as above); anything else -> TypeError (no __bool__);
+//   * string lists: a list or tuple (PyList_GET_ITEM / PyTuple_GET_ITEM, which ignore a subclass's __len__ /
+//     __getitem__) of str (PyUnicode_AsUTF8AndSize reads the data);
+//   * operands: passed through untouched as py::object; every Python call on them happens inside to_capsule's admitted
+//     producer-callback section, which tc_signal's exit hook waits for (P1T-FIX5).
+// A refusal names the parameter and the argument's type (tp_name, a C string): no repr(), no __str__, no __format__.
+// The public Python wrappers (tc_signal.conv1d, lstm, norms, small ops) already converted their arguments in Python
+// frames (operator.index, float), so they pass exact ints and floats and behave exactly as before.
+//
+// Prior art: CPython's own C argument parser (Python/getargs.c, keyword matching by identity, then a C-level string
+// comparison, no __eq__; unverified here, lead to check "CPython getargs.c find_keyword _PyUnicode_Equal"); PyTorch
+// 2.11's Tensor.__dlpack__, which refuses a non-int stream with `type(stream) is not int` -> TypeError instead of
+// converting it (read in the installed torch/_tensor.py); the Python array API's `__dlpack__` signature (stream: int |
+// None, max_version: tuple[int, int] | None, dl_device: tuple | None, copy: bool | None; Consortium for Python Data API
+// Standards, 2021-2023); pybind11's py::args / py::kwargs (Jakob et al., 2015-). Taken: C-level argument matching and
+// type refusal instead of conversion. Ours: applying it to every binding so that no user Python can run inside the
+// dispatcher or a binding frame of this module.
+#pragma once
+
+#include <pybind11/pybind11.h>
+
+#include <climits>
+#include <cstddef>
+#include <cstdint>
+#include <initializer_list>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace tcs {
+namespace py = pybind11;
+
+struct Param {
+  const char* name;
+  bool required = true;  // false: may be omitted (the binding supplies the default)
+};
+
+class CallArgs {
+ public:
+  static constexpr size_t kMaxParams = 16;
+
+  // `positional_max`: how many leading parameters may be given by position (the rest are keyword-only).
+  CallArgs(const char* fn, const py::args& args, const py::kwargs& kwargs, std::initializer_list<Param> params,
+           size_t positional_max = kMaxParams)
+      : fn_(fn) {
+    if (params.size() > kMaxParams) throw std::logic_error("tc_signal: CallArgs: too many parameters");
+    for (const Param& p : params) params_[n_params_++] = p;
+    PyObject* a = args.ptr();
+    const size_t n_pos = static_cast<size_t>(PyTuple_GET_SIZE(a));
+    const size_t pos_ok = positional_max < n_params_ ? positional_max : n_params_;
+    if (n_pos > pos_ok)
+      throw py::type_error(prefix() + "takes at most " + std::to_string(pos_ok) + " positional argument(s) (" +
+                           std::to_string(n_pos) + " given)");
+    for (size_t i = 0; i < n_pos; ++i) vals_[i] = PyTuple_GET_ITEM(a, static_cast<Py_ssize_t>(i));
+    PyObject* k = kwargs.ptr();
+    if (k != nullptr && PyDict_Check(k)) {
+      Py_ssize_t pos = 0;
+      PyObject* key = nullptr;
+      PyObject* value = nullptr;
+      while (PyDict_Next(k, &pos, &key, &value)) {
+        if (!PyUnicode_Check(key)) throw py::type_error(prefix() + "keywords must be strings");
+        size_t j = 0;
+        while (j < n_params_ && PyUnicode_CompareWithASCIIString(key, params_[j].name) != 0) ++j;
+        if (j == n_params_) throw py::type_error(prefix() + "got an unexpected keyword argument '" + utf8(key) + "'");
+        if (vals_[j] != nullptr)
+          throw py::type_error(prefix() + "got multiple values for argument '" + params_[j].name + "'");
+        vals_[j] = value;
+      }
+    }
+    for (size_t j = 0; j < n_params_; ++j)
+      if (params_[j].required && vals_[j] == nullptr)
+        throw py::type_error(prefix() + "missing required argument '" + params_[j].name + "' (position " +
+                             std::to_string(j) + ")");
+  }
+
+  bool given(size_t i) const { return vals_[i] != nullptr; }
+  PyObject* raw(size_t i) const { return vals_[i]; }
+  // The argument as a new reference, or None when an optional parameter was omitted. No conversion.
+  py::object object(size_t i) const {
+    return vals_[i] ? py::reinterpret_borrow<py::object>(vals_[i]) : py::none();
+  }
+  [[noreturn]] void refuse(size_t i, const char* expected) const {
+    throw py::type_error(prefix() + "argument '" + params_[i].name + "' must be " + expected + ", not " +
+                         Py_TYPE(vals_[i])->tp_name +
+                         " (P1T-FIX6: refused without calling any of its Python methods)");
+  }
+  std::string prefix() const { return std::string("tc_signal._C.") + fn_ + "(): "; }
+  const char* name(size_t i) const { return params_[i].name; }
+
+ private:
+  static std::string utf8(PyObject* s) {
+    Py_ssize_t n = 0;
+    const char* p = PyUnicode_AsUTF8AndSize(s, &n);  // reads the data; a lone surrogate fails (no Python called)
+    if (p == nullptr) {
+      PyErr_Clear();
+      return "?";
+    }
+    return std::string(p, static_cast<size_t>(n));
+  }
+  const char* fn_;
+  Param params_[kMaxParams] = {};
+  PyObject* vals_[kMaxParams] = {};
+  size_t n_params_ = 0;
+};
+
+// int and its subclasses only; value read without calling __index__ / __int__ (see above).
+inline int64_t arg_int64(const CallArgs& c, size_t i) {
+  PyObject* o = c.raw(i);
+  if (!PyLong_Check(o)) c.refuse(i, "an int");
+  int overflow = 0;
+  const long long v = PyLong_AsLongLongAndOverflow(o, &overflow);
+  if (overflow != 0)
+    throw std::overflow_error(c.prefix() + "argument '" + c.name(i) + "' does not fit in a signed 64-bit integer");
+  if (v == -1 && PyErr_Occurred()) throw py::error_already_set();  // not reached for a PyLong (kept for safety)
+  return static_cast<int64_t>(v);
+}
+
+inline int arg_int32(const CallArgs& c, size_t i) {
+  const int64_t v = arg_int64(c, i);
+  if (v < INT_MIN || v > INT_MAX)
+    throw std::overflow_error(c.prefix() + "argument '" + c.name(i) + "' does not fit in a C int");
+  return static_cast<int>(v);
+}
+
+// float (and subclasses) or int (and subclasses); read without calling __float__ / __index__.
+inline double arg_real(const CallArgs& c, size_t i) {
+  PyObject* o = c.raw(i);
+  if (PyFloat_Check(o)) return PyFloat_AsDouble(o);
+  if (PyLong_Check(o)) {
+    const double v = PyLong_AsDouble(o);
+    if (v == -1.0 && PyErr_Occurred()) throw py::error_already_set();  // OverflowError for a huge int
+    return v;
+  }
+  c.refuse(i, "a real number (float or int)");
+}
+
+// bool, or an int read as nonzero (no __bool__ is called).
+inline bool arg_flag(const CallArgs& c, size_t i) {
+  PyObject* o = c.raw(i);
+  if (o == Py_True) return true;
+  if (o == Py_False) return false;
+  if (PyLong_Check(o)) {
+    int overflow = 0;
+    const long long v = PyLong_AsLongLongAndOverflow(o, &overflow);
+    return overflow != 0 || v != 0;
+  }
+  c.refuse(i, "a bool");
+}
+
+// A list or tuple of str; items read with the C macros (a subclass's __len__ / __getitem__ is never called).
+inline std::vector<std::string> arg_str_list(const CallArgs& c, size_t i) {
+  PyObject* o = c.raw(i);
+  const bool is_list = PyList_Check(o);
+  if (!is_list && !PyTuple_Check(o)) c.refuse(i, "a list or tuple of str");
+  const Py_ssize_t n = is_list ? PyList_GET_SIZE(o) : PyTuple_GET_SIZE(o);
+  std::vector<std::string> out;
+  out.reserve(static_cast<size_t>(n));
+  for (Py_ssize_t j = 0; j < n; ++j) {
+    PyObject* s = is_list ? PyList_GET_ITEM(o, j) : PyTuple_GET_ITEM(o, j);
+    if (!PyUnicode_Check(s)) c.refuse(i, "a list or tuple of str");
+    Py_ssize_t len = 0;
+    const char* p = PyUnicode_AsUTF8AndSize(s, &len);
+    if (p == nullptr) throw py::error_already_set();
+    out.emplace_back(p, static_cast<size_t>(len));
+  }
+  return out;
+}
+
+// P1T-FIX6: the argument of a RAW CPython function (METH_VARARGS | METH_KEYWORDS) whose body waits with the GIL released
+// (tc_signal's exit wait, _exit_close_admission). Through pybind11 such a body always has a Python object owned only by
+// the dispatcher on the stack (a (*args, **kwargs) binding called positionally gets a NEW empty kwargs dict, pybind11.h
+// step 4b; a typed binding called with a keyword gets a PyDict_Copy, step 2); if CPython exits the waiting thread (a
+// non-main thread re-taking the GIL after finalization began) the unwind deallocates it with the thread's state freed
+// (core's version of this wait: rc -11 in 3 of 5 runs, ledger 08:40-09:05). A raw function's args / kwargs are owned
+// by the caller's frame. P1T-FIX7: its argument reader is raw_exit_diag_arg below (FIX6's raw_one_real_arg, which
+// refused an unreadable value before the close, is replaced by it).
+// P1T-FIX7, round-7 review finding V7-01 (MAJOR): the argument of the EXIT entry (_exit_close_admission), whose
+// argument is diagnostics only. FIX6 refused an unreadable value (TypeError, or OverflowError for an int beyond the
+// double range) BEFORE closing, so a knob holding 1 << 4096 made the exit hook skip its close (the Python hook's
+// float() raised first; reviewer probe knob_exit_cpu.py rc 134). Now:
+//  * the call's SHAPE is still checked first (at most one positional argument, only the keyword `name`, no duplicate,
+//    present): a malformed call raises TypeError and does nothing, as any Python call would. The hook's call shape is
+//    fixed (one positional argument), so this never gates exit;
+//  * the VALUE never prevents the close: a float or an int (subclasses included) is read at C level, without calling
+//    any of its Python methods; anything else (None, str, objects with __float__, numpy scalars that are not float
+//    subclasses, an int beyond the double range) selects `fallback` and sets *default_used. The caller then closes and
+//    waits as always. The error an unreadable int leaves (OverflowError) is cleared, never propagated.
+// Returns false only for a malformed call (Python TypeError set). Prior art: CPython's C argument parser
+// (Python/getargs.c: shape errors are TypeError before the body runs); "diagnostic configuration never gates the
+// safety path" is ours (no prior art known to me for the exact rule; closest: CPython's atexit, which runs every
+// callback whatever an earlier one raised).
+// The VALUE rule alone (P1T-FIX7): a float or an int (subclasses included) read at C level, never calling a Python
+// method; anything else, or an int beyond the double range, gives `fallback`. Returns true when the fallback was used.
+// Never leaves an error set. Also used by the exit runner to read the knob from the hook's globals (lead send-back L1).
+inline bool raw_exit_diag_value(PyObject* v, double fallback, double* out) {
+  if (PyFloat_Check(v)) {  // float and subclasses: the C value, no __float__
+    *out = PyFloat_AS_DOUBLE(v);
+    return false;
+  }
+  if (PyLong_Check(v)) {  // int and subclasses (bool included): the C value, no __index__ / __float__
+    const double d = PyLong_AsDouble(v);
+    if (!(d == -1.0 && PyErr_Occurred())) {
+      *out = d;
+      return false;
+    }
+    PyErr_Clear();  // beyond the double range: unreadable, the default applies
+  }
+  *out = fallback;
+  return true;
+}
+
+inline bool raw_exit_diag_arg(const char* fn, const char* name, PyObject* args, PyObject* kwargs, double fallback,
+                              double* out, bool* default_used) {
+  PyObject* v = nullptr;
+  const Py_ssize_t n = args ? PyTuple_GET_SIZE(args) : 0;
+  if (n > 1) {
+    PyErr_Format(PyExc_TypeError, "%s(): takes at most 1 positional argument (%zd given)", fn, n);
+    return false;
+  }
+  if (n == 1) v = PyTuple_GET_ITEM(args, 0);
+  if (kwargs != nullptr && PyDict_Check(kwargs)) {
+    Py_ssize_t pos = 0;
+    PyObject* key = nullptr;
+    PyObject* value = nullptr;
+    while (PyDict_Next(kwargs, &pos, &key, &value)) {
+      if (!PyUnicode_Check(key)) {
+        PyErr_Format(PyExc_TypeError, "%s(): keywords must be strings", fn);
+        return false;
+      }
+      if (PyUnicode_CompareWithASCIIString(key, name) != 0) {  // %U copies the str's data: no __str__ is called
+        PyErr_Format(PyExc_TypeError, "%s(): got an unexpected keyword argument '%U'", fn, key);
+        return false;
+      }
+      if (v != nullptr) {
+        PyErr_Format(PyExc_TypeError, "%s(): got multiple values for argument '%s'", fn, name);
+        return false;
+      }
+      v = value;
+    }
+  }
+  if (v == nullptr) {
+    PyErr_Format(PyExc_TypeError, "%s(): missing required argument '%s'", fn, name);
+    return false;
+  }
+  *default_used = raw_exit_diag_value(v, fallback, out);
+  return true;
+}
+
+}  // namespace tcs
diff --git a/tc_signal/src/small_ops.cu b/tc_signal/src/small_ops.cu
new file mode 100644
index 0000000..c687e45
--- /dev/null
+++ b/tc_signal/src/small_ops.cu
@@ -0,0 +1,121 @@
+// tc_signal T6 small ops (P1T-M4): nearest upsample x k (1-D), reflection pad (1-D), rint. Bit-exact by construction:
+// the two gathers move 32-bit words (one load and one store per output element, through unsigned-integer pointers, so
+// NaN payloads, signed zeros and subnormals are copied bit for bit), and rint is the math library's rintf (IEEE 754
+// roundTiesToEven in the default rounding mode, sign of zero kept, NaN and +-Inf pass through). No fast-math flag, no
+// atomic operations: each output element is written by exactly one thread. TensorCUDA core's `round` (half away from
+// zero, used by its quantizers) is untouched; rint is a new op here.
+//
+// Semantics (the shipped Kokoro nodes):
+//  * upsample_nearest1d: ONNX Resize mode=nearest, coordinate_transformation_mode=asymmetric, nearest_mode=floor,
+//    scales [1, ..., 1, s] with s an integer >= 1: y[..., i] = x[..., floor(i / s)], i in [0, T*s). Integer division is
+//    the floor for these non-negative operands, so no float coordinate is ever formed.
+//  * reflection_pad1d: ONNX Pad mode=reflect on the last axis (= torch reflection_pad1d): with s = i - pad_begin,
+//    y[..., i] = x[..., |s|] for s < 0, x[..., 2(T-1) - s] for s >= T, else x[..., s]. pad_begin, pad_end < T.
+//  * rint: ONNX Round (half to even).
+//
+// Prior art: ONNX operator specs (Resize, Pad, Round); IEEE 754-2008 roundTiesToEven / C99 rint; torch's
+// reflection_pad1d and nearest upsample for the same index maps. Ours: nothing beyond the one-thread-per-output CUDA
+// mapping (no prior art known to me for anything else here).
+#include <cuda_runtime.h>
+
+#include <algorithm>
+#include <cstdint>
+#include <sstream>
+#include <stdexcept>
+#include <string>
+
+#include "m4_ops.h"
+#include "cuda_guard.h"  // P1T-FIX4: shared checked DeviceGuard
+#include "tuning.h"
+
+#ifdef CUDA_API_PER_THREAD_DEFAULT_STREAM
+#error "tc_signal queues on the legacy default stream (stream 0); do not build it with --default-stream per-thread"
+#endif
+
+namespace tcs {
+
+namespace {
+
+constexpr cudaStream_t kLegacyStream = 0;  // the legacy default stream (TensorCUDA's only stream)
+
+// P1T-FIX7 (sweep (j), error attribution): the launch check names the device and the kernel, and never claims the
+// kernel failed when cudaGetLastError may be reporting an asynchronous error of earlier work (cuda_guard.h
+// check_launch_on; FIX6 said "<kernel> failed"). It consumes the slot entry it reports (cuda_guard.h rule 1).
+constexpr const char* kPrefix = "tc_signal: ";
+
+unsigned int grid_for(int64_t total, int block) {
+  const int64_t blocks = (total + block - 1) / block;
+  return static_cast<unsigned int>(std::max<int64_t>(1, std::min<int64_t>(blocks, tuning::kGridCap)));
+}
+
+// DeviceGuard (makes `device` current for the call, restores the caller's device) is tc_signal's shared, checked guard
+// in cuda_guard.h since P1T-FIX4 (this copy ignored the restoring cudaSetDevice's result).
+
+// y[r, i] = x[r, i / scale]: one thread per output element, a 32-bit word copy.
+__global__ void upsample_nearest1d_kernel(const uint32_t* __restrict__ x, uint32_t* __restrict__ y, int64_t total,
+                                          int64_t T, int64_t T_out, int64_t scale) {
+  for (int64_t i = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; i < total;
+       i += static_cast<int64_t>(gridDim.x) * blockDim.x) {
+    const int64_t t = i % T_out;
+    const int64_t r = i / T_out;
+    y[i] = x[r * T + t / scale];
+  }
+}
+
+// Reflect pad of the last axis: one thread per output element, a 32-bit word copy.
+__global__ void reflection_pad1d_kernel(const uint32_t* __restrict__ x, uint32_t* __restrict__ y, int64_t total,
+                                        int64_t T, int64_t T_out, int64_t pad_begin) {
+  for (int64_t i = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; i < total;
+       i += static_cast<int64_t>(gridDim.x) * blockDim.x) {
+    const int64_t t = i % T_out;
+    const int64_t r = i / T_out;
+    int64_t s = t - pad_begin;
+    if (s < 0)
+      s = -s;
+    else if (s >= T)
+      s = 2 * (T - 1) - s;
+    y[i] = x[r * T + s];
+  }
+}
+
+// y = rintf(x): round half to even (the default rounding mode), sign of zero kept, NaN/Inf pass through.
+__global__ void rint_kernel(const float* __restrict__ x, float* __restrict__ y, int64_t n) {
+  for (int64_t i = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x; i < n;
+       i += static_cast<int64_t>(gridDim.x) * blockDim.x)
+    y[i] = rintf(x[i]);
+}
+
+}  // namespace
+
+void upsample_nearest1d_forward(int device, int64_t rows, int64_t T, int64_t scale, const float* x, float* y) {
+  DeviceGuard guard(device);
+  const int64_t T_out = T * scale;
+  const int64_t total = rows * T_out;
+  constexpr int B = m4tuning::kCopyBlock;
+  upsample_nearest1d_kernel<<<grid_for(total, B), B, 0, kLegacyStream>>>(
+      reinterpret_cast<const uint32_t*>(x), reinterpret_cast<uint32_t*>(y), total, T, T_out, scale);
+  check_launch_on(kPrefix, "upsample_nearest1d_kernel", device);
+  guard.restore();  // P1T-FIX4: success-path restore is checked (raises on failure)
+}
+
+void reflection_pad1d_forward(int device, int64_t rows, int64_t T, int64_t pad_begin, int64_t pad_end, const float* x,
+                              float* y) {
+  DeviceGuard guard(device);
+  const int64_t T_out = T + pad_begin + pad_end;
+  const int64_t total = rows * T_out;
+  constexpr int B = m4tuning::kCopyBlock;
+  reflection_pad1d_kernel<<<grid_for(total, B), B, 0, kLegacyStream>>>(
+      reinterpret_cast<const uint32_t*>(x), reinterpret_cast<uint32_t*>(y), total, T, T_out, pad_begin);
+  check_launch_on(kPrefix, "reflection_pad1d_kernel", device);
+  guard.restore();  // P1T-FIX4
+}
+
+void rint_forward(int device, int64_t n, const float* x, float* y) {
+  DeviceGuard guard(device);
+  constexpr int B = m4tuning::kCopyBlock;
+  rint_kernel<<<grid_for(n, B), B, 0, kLegacyStream>>>(x, y, n);
+  check_launch_on(kPrefix, "rint_kernel", device);
+  guard.restore();  // P1T-FIX4
+}
+
+}  // namespace tcs
diff --git a/tc_signal/src/tuning.h b/tc_signal/src/tuning.h
new file mode 100644
index 0000000..545dabb
--- /dev/null
+++ b/tc_signal/src/tuning.h
@@ -0,0 +1,62 @@
+// tc_signal kernel tunables. House tunable law: no launch-shape literals at the use sites; every knob lives here.
+// None of these changes numerics: each output element's summation order is fixed by the kernel code, not by the
+// launch shape (grid-stride loops; one thread owns one output element). Changing a knob changes speed only.
+#pragma once
+
+namespace tcs {
+namespace tuning {
+
+// Threads per block for the 1-D im2col kernel (one thread per col element).
+constexpr int kIm2colBlock = 256;
+// Threads per block for the bias-add kernel (one thread per output element).
+constexpr int kBiasBlock = 256;
+// Threads per block for the gather-form ConvTranspose1d kernel (one thread per output element).
+constexpr int kConvTransposeBlock = 256;
+// Threads per block for the fp32 division canary kernel (fast-math probe; tests only).
+constexpr int kProbeBlock = 256;
+// Upper bound on blocks per launch; the kernels are grid-stride loops, so larger problems loop instead.
+constexpr long long kGridCap = 1LL << 20;
+
+// DLPack version this consumer asks producers for (`__dlpack__(max_version=...)`); the vendored header is v1.3.
+constexpr int kDlpackMaxMajor = 1;
+constexpr int kDlpackMaxMinor = 3;
+// DLPack stream argument for the consumer stream: 1 = the legacy default stream (Python array API convention).
+constexpr int kDlpackLegacyStream = 1;
+
+// P1T-FIX1 (F01) deferred release: bounds of the pending list of consumed DLPack managers that wait for the legacy
+// stream to pass their call (dlpack_operand.h, RetainUntilComplete). When a new entry pushes the list past either
+// bound, tc_signal synchronizes the legacy stream of every pending device and releases the whole list. These only
+// trade memory held (by producers' blocks waiting for release) against how often a call blocks; numerics never change.
+// Entries: one per tc_signal call that reached its launch.
+constexpr long long kPendingMaxEntries = 1024;
+// Bytes: the sum of the fp32 operand sizes held by the pending entries (inputs, outputs and scratch).
+constexpr long long kPendingMaxBytes = 256LL << 20;
+// P1T-FIX2 (N3): fixed capacities of the allocation-free bookkeeping in synchronize/the bound drain. Devices whose sync
+// result is remembered per call (a device beyond this is still synchronized; its failure is kept as one conservative
+// flag), and CUDA failures named in one synchronize() error message (the rest are counted). Neither changes numerics.
+constexpr int kSyncMaxDevices = 64;
+constexpr int kSyncReportMax = 8;
+
+// P1T-FIX5 (V5-01) release lifecycle (dlpack_operand.cpp). None of these bounds a wait (no wait ever returns early) and
+// none changes numerics:
+//  * the cap on the exit hook's first-diagnostic delay (keeps the chrono conversion finite; the delay itself is the
+//    Python knob tc_signal._RELEASE_EXIT_DIAG_S);
+//  * the polling interval used only if the lifecycle mutex ever fails (never observed), so the wait still never returns
+//    early.
+// P1T-FIX6 (V6-01): FIX5's kSyncReleaseWaitFirstDiagS is gone with synchronize()'s wait for other threads; only the
+// exit hook waits.
+constexpr double kLifecycleMaxDiagDelayS = 86400.0;
+constexpr int kLifecyclePollMs = 10;
+// P1T-FIX7 (V7-01): the default first-diagnostic delay of the exit wait, in seconds. It is the initial value of the
+// Python knob tc_signal._RELEASE_EXIT_DIAG_S (exported as _tc_signal._RELEASE_EXIT_DIAG_DEFAULT_S, so the two cannot
+// drift apart), and the delay the exit entry uses when the knob holds anything it cannot read as a real number without
+// calling a Python method (another type, an int beyond the double range, the knob deleted). Diagnostics only: it never
+// bounds or gates the wait, and it changes no numerics.
+constexpr double kExitDiagDefaultS = 5.0;
+// P1T-FIX7, lead send-back L1: the polling interval of the diagnosed device wait at interpreter exit (inside the exit
+// runner only; dlpack_operand.cpp wait_device_work_diagnosed). It adds at most one interval of latency to each device
+// sync at exit; it never bounds the wait and changes no numerics.
+constexpr int kExitDevicePollMs = 1;
+
+}  // namespace tuning
+}  // namespace tcs
diff --git a/tc_signal/tc_signal/__init__.py b/tc_signal/tc_signal/__init__.py
new file mode 100644
index 0000000..fffe9c7
--- /dev/null
+++ b/tc_signal/tc_signal/__init__.py
@@ -0,0 +1,291 @@
+"""tc_signal: TensorCUDA add-on for signal ops (P1T-M2: Conv1d T2, ConvTranspose1d T3).
+
+A separate package next to `tensor_cuda/` (David, 2026-10-12: keep core free of these kernels). It consumes any DLPack
+CUDA producer (TensorCUDA tensors once M1 lands, torch tensors for testing), computes in fp32 on the legacy default
+stream, deterministically (no atomics, no fast-math, cuBLAS in default math mode), and allocates outputs and scratch
+through the module allocator (`set_allocator`). Usage: `PYTHONPATH=<Project-Tensor>/tc_signal`, then
+`import tc_signal`.
+
+API (exact, order P1T-M2):
+    conv1d(x, w, b=None, *, stride=1, padding=0, dilation=1, groups=1, out=None)
+    conv_transpose1d(x, w, b=None, *, stride=1, padding=0, output_padding=0, dilation=1, groups=1, out=None)
+    set_allocator(fn)   # fn(shape: tuple) -> fp32 CUDA DLPack tensor; returns the previous allocator
+
+Semantics are ONNX Conv / ConvTranspose (1-D): x [N, C_in, T]; conv1d w [C_out, C_in/groups, K]; conv_transpose1d
+w [C_in, C_out/groups, K]; b [C_out] or None; padding an int or (pad_begin, pad_end).
+
+Prior art: ONNX Conv/ConvTranspose operator specs (semantics); DLPack (dmlc/dlpack v1.3) and the Python array API
+data-interchange protocol (operand exchange); im2col (Chellapilla, Puri & Simard 2006) and gather-form transposed
+convolution (Dumoulin & Visin 2016) for the kernels (see src/conv.cu). The pluggable allocator callback mirrors CuPy's
+`cupy.cuda.set_allocator` (CuPy, 2017-), which also returns control of allocation to the caller; ours differs in that
+the allocator returns a DLPack tensor, not a raw pointer.
+"""
+from __future__ import annotations
+
+import atexit
+import operator
+import sys
+
+from . import _tc_signal as _C
+
+__all__ = ['conv1d', 'conv_transpose1d', 'set_allocator', 'synchronize']
+
+_SET_ALLOCATOR_HINT = ('call tc_signal.set_allocator(fn), where fn(shape: tuple) returns a float32 CUDA tensor that '
+                       'implements __dlpack__ (for example lambda s: torch.empty(s, device="cuda"))')
+
+
+def _default_allocator(shape):
+    """`tensor_cuda.empty(*shape, dtype="float32")` (added by P1T-M1). Raises RuntimeError naming set_allocator when
+    tensor_cuda is not importable, lacks `empty`, or its tensors do not export DLPack yet."""
+    try:
+        import tensor_cuda
+    except ImportError as e:
+        raise RuntimeError(f'tc_signal: the default allocator needs tensor_cuda.empty, but tensor_cuda is not '
+                           f'importable ({e}); {_SET_ALLOCATOR_HINT}') from e
+    empty = getattr(tensor_cuda, 'empty', None)
+    if empty is None:
+        raise RuntimeError('tc_signal: the default allocator needs tensor_cuda.empty (P1T-M1), which this '
+                           f'tensor_cuda does not have; {_SET_ALLOCATOR_HINT}')
+    t = empty(*shape, dtype='float32')
+    if not hasattr(t, '__dlpack__'):
+        raise RuntimeError('tc_signal: tensor_cuda.empty returned a tensor without __dlpack__ (P1T-M1 DLPack export '
+                           f'missing); {_SET_ALLOCATOR_HINT}')
+    return t
+
+
+_allocator = _default_allocator
+
+
+def set_allocator(fn):
+    """Set the allocator used for outputs (out=None) and im2col scratch: fn(shape: tuple) -> fp32 CUDA DLPack tensor of
+    exactly that shape. Returns the previous allocator. `None` restores the default (tensor_cuda.empty)."""
+    global _allocator
+    if fn is not None and not callable(fn):
+        raise TypeError(f'tc_signal.set_allocator: expected a callable or None, got {type(fn).__name__}')
+    prev = _allocator
+    _allocator = _default_allocator if fn is None else fn
+    return prev
+
+
+def _int(name, v):
+    if isinstance(v, bool):
+        raise TypeError(f'tc_signal: {name} must be an int, got bool')
+    try:
+        return operator.index(v)
+    except TypeError:
+        raise TypeError(f'tc_signal: {name} must be an int, got {type(v).__name__}') from None
+
+
+def _pads(padding):
+    if isinstance(padding, (tuple, list)):
+        if len(padding) != 2:
+            raise ValueError(f'tc_signal: padding must be an int or (pad_begin, pad_end), got {padding!r}')
+        return _int('padding[0]', padding[0]), _int('padding[1]', padding[1])
+    p = _int('padding', padding)
+    return p, p
+
+
+def conv1d(x, w, b=None, *, stride=1, padding=0, dilation=1, groups=1, out=None):
+    """ONNX Conv, 1-D: y[n, o, t] = b[o] + sum_{c in group(o), k} w[o, c, k] * x_pad[n, c, t*stride + k*dilation].
+
+    x [N, C_in, T], w [C_out, C_in/groups, K], b [C_out] or None (fp32 CUDA DLPack producers or capsules).
+    Output [N, C_out, (T + pb + pe - dilation*(K-1) - 1)//stride + 1], written into `out` if given, else allocated
+    through the module allocator. Returns `out`."""
+    pb, pe = _pads(padding)
+    s, d, g = _int('stride', stride), _int('dilation', dilation), _int('groups', groups)
+    xc, wc, bc, out_shape, scratch_numel = _C.conv1d_plan(x, w, b, s, pb, pe, d, g)
+    if out is None:
+        out = _allocator(tuple(out_shape))
+    scratch = _allocator((scratch_numel,)) if scratch_numel > 0 else None
+    _C.conv1d_run(xc, wc, bc, out, scratch, s, pb, pe, d, g)
+    return out
+
+
+def conv_transpose1d(x, w, b=None, *, stride=1, padding=0, output_padding=0, dilation=1, groups=1, out=None):
+    """ONNX ConvTranspose, 1-D (gather form, deterministic): x [N, C_in, T], w [C_in, C_out/groups, K] (ONNX layout),
+    b [C_out] or None. Output [N, C_out, stride*(T-1) + output_padding + dilation*(K-1) + 1 - pb - pe], written into
+    `out` if given, else allocated through the module allocator. Returns `out`."""
+    pb, pe = _pads(padding)
+    s, op, d, g = (_int('stride', stride), _int('output_padding', output_padding), _int('dilation', dilation),
+                   _int('groups', groups))
+    xc, wc, bc, out_shape = _C.conv_transpose1d_plan(x, w, b, s, pb, pe, op, d, g)
+    if out is None:
+        out = _allocator(tuple(out_shape))
+    _C.conv_transpose1d_run(xc, wc, bc, out, s, pb, pe, op, d, g)
+    return out
+
+
+def synchronize():
+    """Wait until the legacy default stream has passed every tc_signal launch queued so far, then release every consumed
+    operand tc_signal still holds (P1T-FIX1, F01 deferred release; see README "Streams and lifetimes").
+
+    tc_signal keeps each call's consumed DLPack managers (inputs, outputs, scratch) alive until the legacy stream has
+    passed that call, and releases completed ones at the start of the next tc_signal call. Call synchronize() to release
+    them now (for example before measuring memory, or before handing a producer's memory back by other means). It
+    synchronizes the legacy stream of the current device and of every device with pending operands (stream syncs, not a
+    device-wide sync).
+
+    Errors (P1T-FIX2, N1): a CUDA failure is never reported as success. RuntimeError, naming the CUDA error, when
+    - the current-device query (cudaGetDevice) fails, for example on a machine with no usable CUDA device, even when
+      nothing is pending;
+    - a device's legacy stream cannot be synchronized (its pending operands are then deliberately leaked, never
+      released early);
+    - an earlier release that could not raise failed (the fallback sync or the bound drain inside a tc_signal call); such
+      a failure is raised once, by the next synchronize().
+    MemoryError if the error message itself cannot be allocated. Prior art: torch.cuda.synchronize /
+    cupy.cuda.Stream.synchronize (API shape only).
+
+    P1T-FIX5: (V5-02) A failed completion-event query in an earlier call's drain, and a failed completion-event
+    record, are among the earlier failures raised here, exactly once.
+
+    P1T-FIX6: (V6-01) synchronize() never waits for another thread. FIX5 made it wait for producer releases already
+    running on other threads; a caller holding a lock that such a release needed then deadlocked (round-6 review). A
+    release that another thread's tc_signal call already started is that call's release and finishes on that thread;
+    synchronize() releases what is still pending. Only the interpreter-exit hook waits for other threads (see
+    _release_pending_at_exit). (V6-03) If the RuntimeError's message cannot be allocated, MemoryError is raised and the
+    CUDA failures it would have named are kept: the next synchronize() raises them, once. Arguments: none (any argument
+    raises TypeError without any of its methods being called)."""
+    _C.synchronize()
+
+
+# P1T-FIX5 (round-5 review V5-01) knob: seconds the exit hook waits for producer callbacks still running on other
+# threads before its first stderr diagnostic; another line follows each time the time waited doubles. It never bounds
+# the wait (a bounded return let CPython finalize under a running deleter and abort: round-3 V3-01 in core, round-5
+# V5-01 here). A callback normally takes microseconds. Same knob and schedule as core's _DLPACK_SHUTDOWN_WAIT_S.
+# P1T-FIX7 (round-7 review V7-01): diagnostics only, and NEVER able to stop the exit close-and-wait. The hook passes the
+# knob as is to the native exit entry, which reads a float or an int (subclasses included) without calling any of its
+# Python methods; anything else (None, a str, an object with __float__, an int beyond the double range) or a deleted
+# knob uses the default below and the close and the wait still happen (stderr says the default was used). Initial value:
+# the native default (src/tuning.h kExitDiagDefaultS), so the two cannot drift apart.
+_RELEASE_EXIT_DIAG_S = _C._RELEASE_EXIT_DIAG_DEFAULT_S
+
+
+def _release_pending_at_exit():
+    """atexit hook (runs before CPython marks the runtime finalizing; GIL held). Registered through the native runner
+    `_C._exit_hook_runner` (see below).
+
+    1. synchronize(): release whatever is still pending (P1T-FIX6: it does not wait for other threads; step 2 does).
+       P1T-FIX2 (N1): an error is never swallowed silently; it is LOGGED to stderr (one line) and not raised (an
+       exception from an atexit callback cannot be handled by anyone). Operands without a completion proof stay
+       deliberately leaked; there is nothing else safe to do at exit.
+    2. P1T-FIX5 (round-5 review V5-01): close the add-on's release admission for good, then wait, GIL released and
+       with NO time bound, until no admitted producer callback of another thread is running: a deleter call (immediate
+       release of a refused call, next-call drain, synchronize, bound drain, fallback sync), the drop of a capsule's
+       last reference (its destructor is producer code), or a producer __dlpack__ / __dlpack_device__ call.
+       Interpreter finalization therefore never starts under a running callback. From here on every later deleter call
+       and capsule drop is deliberately leaked (counted in pending_stats() 'deleters_leaked_after_close' /
+       'capsules_kept_after_close') and every later producer __dlpack__ call is refused (RuntimeError,
+       'callbacks_refused_after_close'): no add-on code enters Python for them. Callbacks on this thread's own stack
+       are excluded (the hook may be called from inside one). After _RELEASE_EXIT_DIAG_S seconds a line goes to stderr,
+       then another each time the time waited doubles.
+       P1T-FIX6: this is the ONLY place tc_signal waits for another thread, and the wait's contract is: the exiting
+       thread must not hold a lock that such an admitted callback needs (the rule CPython applies when it joins
+       non-daemon threads at exit; atexit callbacks normally run with no application lock held).
+       Consequence: a producer deleter, capsule destructor or __dlpack__ that never returns makes interpreter exit wait
+       for it. That is the producer's contract violation (a DLPack deleter must return); waiting is the honest outcome,
+       an early return aborts the process (rc -6, "FATAL: exception not rethrown"). Ctrl-C does not interrupt the wait;
+       SIGTERM / SIGKILL still end the process.
+
+    P1T-FIX7 (round-7 review V7-01, sweep (i)): diagnostic configuration never gates exit quiescence. Step 2 is
+    reached on every path that runs any statement of this hook:
+      * step 1 runs inside try / finally and step 2 is the finally: an Exception from synchronize() is logged after
+        the close; a BaseException (KeyboardInterrupt, SystemExit) still closes and waits, then propagates;
+      * the knob is never converted here: it is passed as is (a deleted knob passes None), so no float(), __float__ or
+        OverflowError can run before the close (FIX6 called float(knob): 1 << 4096 raised OverflowError, the close was
+        skipped, and a finite deleter still running on a daemon thread aborted the process, rc 134);
+      * the finally block reads the knob (a deleted knob is caught as NameError and passes None) and makes one call, the
+        native close; nothing touches stderr before the close: every log line is written after it, each guarded.
+    An exception that escapes the hook before its close is handled by the runner that atexit actually calls
+    (_C._exit_hook_runner): when this hook raises before closing, the runner runs step 1 (synchronize(), a failure
+    logged), closes admission and waits itself, logs any recorded CUDA failure nobody reported, and re-raises. That covers the asynchronous case a Python function cannot: CPython 3.12
+    delivers a pending Ctrl-C at a frame's first instruction (RESUME), after a call returns and at a backward jump (the
+    jump out of an except handler is one), so a KeyboardInterrupt can arrive before any statement of this hook runs.
+    After a MemoryError from step 1 (V6-03: its CUDA failures are kept), synchronize() is called once more after the
+    close, so the kept failures are logged too (after the close it releases nothing; late releases are leaked).
+    P1T-FIX7 (lead send-back L1): every wait of exit is diagnosed on stderr, never silent: the wait of step 2 (also
+    its polling fallback when the lifecycle mutex fails), and the device syncs of step 1 (while the native runner runs,
+    each is preceded by a polled wait that writes a line after _RELEASE_EXIT_DIAG_S, then each time the time waited
+    doubles); pending_stats() exit_wait_poll_diagnostics / exit_device_wait_diagnostics count them.
+    P1T-FIX8 (round-8 review V8-02): a CUDA failure on a P1-T path, diagnostic code included, is reported at exit
+    too, even when its report cannot allocate. The native runner is the last reader: after this hook (whether it
+    returned or raised) and after the close and the wait, it writes, with C stdio, the records nobody raised and any
+    report synchronize() raised here that this hook could not write (a MemoryError while building its line, stderr
+    None or raising): the full report, or an allocation-free summary of the count and the first record (call,
+    purpose, device, error name). This hook acknowledges, with _C._exit_report_written(), that it wrote its lines.
+    (V8-01) A failed call of the device wait's own marker event is recorded and raised like any other CUDA failure, and
+    the wait is then diagnosed by a watchdog thread; "finished" is printed only after completion was proved.
+    Never raises, except a BaseException that arrived during it (after the close). Prior art: CPython's atexit, which
+    itself prints (not raises) a callback's exception and runs the rest (taken: log-don't-raise); Python's try / finally
+    guarantee, also for KeyboardInterrupt (language reference, "The try statement"); core's
+    tensor_cuda._dlpack_shutdown_hook (P1T-FIX2 N5 / P1T-FIX3 V3-01), whose close-then-wait design and diagnostic
+    schedule this reuses (see src/dlpack_operand.cpp, release lifecycle)."""
+    C = _C
+    knob = None
+    missing = False
+    sync_error = close_error = result = None
+    try:
+        C.synchronize()
+    except Exception as e:  # noqa: BLE001  (logged after the close, below)
+        sync_error = e
+    finally:
+        # V7-01: plain loads and one call; the close and the wait happen whatever the knob holds.
+        try:
+            knob = _RELEASE_EXIT_DIAG_S
+        except NameError:
+            missing = True
+        try:
+            result = C._exit_close_admission(knob)
+        except Exception as e:  # noqa: BLE001  (only after the close and the wait: building the result failed)
+            close_error = e
+    lines = []
+    if isinstance(sync_error, MemoryError):
+        try:
+            C.synchronize()  # the failures V6-03 kept when the first message could not be allocated
+        except Exception as e:  # noqa: BLE001
+            lines.append(f'tc_signal: synchronize() at exit, called again after the close to report what the '
+                         f'MemoryError hid, raised {type(e).__name__}: {e}')
+    if sync_error is not None:
+        lines.insert(0, f'tc_signal: synchronize() at exit failed ({type(sync_error).__name__}: {sync_error}); operands '
+                        f'without a completion proof were deliberately leaked, not released')
+    if close_error is not None:
+        lines.append(f'tc_signal: exit hook: admission was closed and the wait finished, then building its result failed '
+                     f'({type(close_error).__name__}: {close_error})')
+    if result is not None:
+        if result['first_diag_default_used'] and (missing or knob is not None):
+            kind = type(knob)
+            what = ('was deleted' if missing else 'holds an int beyond the range of a C double'
+                    if issubclass(kind, int) else f'holds a {kind.__name__} (not a float or an int)')
+            lines.append(f'tc_signal: _RELEASE_EXIT_DIAG_S {what}; the exit wait used the default first-diagnostic '
+                         f'delay of {result["first_diag_s"]:g} s (the close and the wait are never affected)')
+        if result['overran']:
+            lines.append(f'tc_signal: the producer callback(s) admitted before exit finished after '
+                         f'{result["waited_us"] / 1e6:.1f} s; interpreter exit continues')
+    written = True
+    for line in lines:
+        try:
+            sys.stderr.write(line + '\n')
+            sys.stderr.flush()
+        except Exception:  # noqa: BLE001  (stderr may already be closed at exit)
+            written = False
+    if written:
+        # P1T-FIX8 (V8-02): every line is out, including any report synchronize() raised here; the native runner, the
+        # last reader at exit, then does not write that report's allocation-free summary again.
+        try:
+            C._exit_report_written()
+        except Exception:  # noqa: BLE001  (a _C without it: the runner writes the summary, a harmless repeat)
+            pass
+
+
+# P1T-FIX7 (V7-01): registered through the native runner, not directly: atexit calls _C._exit_hook_runner(hook), which
+# calls the hook and, only if the hook raised before closing (for example a Ctrl-C delivered at its first bytecode),
+# closes and waits itself. To remove it: atexit.unregister(tc_signal._C._exit_hook_runner).
+atexit.register(_C._exit_hook_runner, _release_pending_at_exit)
+
+
+from ._lstm import lstm  # noqa: E402,F401  (P1T-M3: tc_signal/_lstm.py)
+__all__.append('lstm')
+
+
+from ._norms import group_norm, instance_norm1d, layer_norm  # noqa: E402  (P1T-M4, T5)
+from ._small import reflection_pad1d, rint, upsample_nearest1d  # noqa: E402  (P1T-M4, T6)
+__all__ += ['instance_norm1d', 'layer_norm', 'group_norm', 'upsample_nearest1d', 'reflection_pad1d', 'rint']
