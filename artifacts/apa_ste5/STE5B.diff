+             and isinstance(node.func.value,ast.Name) and node.func.value.id=='c'
+             and node.func.attr=='put']
+    assert len(emitted)==1 and isinstance(emitted[0],ast.Dict)
+    writer_keys={key.value for key in emitted[0].keys}
