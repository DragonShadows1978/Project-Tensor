+           f'-I{cuda}/include', *flags, f'-L{cuda}/lib64', f'-Wl,-rpath,{cuda}/lib64', '-lcudart', '-o', str(exe)]
+    r = subprocess.run(cmd, capture_output=True, text=True, timeout=300)
