+_PRELAUNCH = r'''
+import ctypes, json, sys
+sys.path.insert(0, TESTS_DIR)
+import tcs_producer as P
+import tc_signal as ts
+from tc_signal import _tc_signal as _C
+new = ctypes.pythonapi['PyCapsule_New']
