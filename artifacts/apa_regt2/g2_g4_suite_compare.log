"""APA-REGT2 evidence script (not shipped): per-run summary, junit sums for test_apa_pidv, per-test durations."""
import re, sys, collections
import xml.etree.ElementTree as ET
root = sys.argv[1]
runs = ["with_r1", "without_r2", "with_r3", "without_r4", "with_r2_MISLABELLED_pattern_bug"]
for r in runs:
    log = f"{root}/logs/apa_regt2_suite_{r}.log"
    summ = [l.strip() for l in open(log) if re.search(r"\d+ (passed|failed)", l)][-1]
    wall = [l.strip() for l in open(log) if l.startswith("process wall")][-1]
    t = ET.parse(f"{root}/artifacts/apa_regt2/suite_{r}.xml")
    tcs = list(t.iter("testcase"))
    new = [tc for tc in tcs if "test_apa_pidv" in (tc.get("classname") or "")]
    out = collections.Counter()
    for tc in new:
        kind = "passed"
        for ch in tc:
            if ch.tag in ("failure", "error", "skipped"):
                kind = ch.tag
        out[kind] += 1
    s_new = sum(float(tc.get("time") or 0) for tc in new)
    s_all = sum(float(tc.get("time") or 0) for tc in tcs)
    print(f"{r}: {summ} | {wall} | junit testcases {len(tcs)} (summed {s_all:.2f} s) | test_apa_pidv testcases {len(new)} {dict(out)} summed {s_new:.3f} s")
print()
print("per-test in-suite durations (junit time = setup+call+teardown), with_r1 and with_r3:")
d = collections.defaultdict(list)
for r in ("with_r1", "with_r3"):
    for tc in ET.parse(f"{root}/artifacts/apa_regt2/suite_{r}.xml").iter("testcase"):
        if "test_apa_pidv" in (tc.get("classname") or ""):
            d[tc.get("name")].append(float(tc.get("time") or 0))
for name, ts in d.items():
    print(f"  {ts[0]:7.3f} {ts[1]:7.3f}  {name}")
print(f"  {sum(v[0] for v in d.values()):7.3f} {sum(v[1] for v in d.values()):7.3f}  TOTAL ({len(d)} tests)")
