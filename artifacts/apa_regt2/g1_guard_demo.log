"""APA-REGT2 guard demonstration plugin (evidence only, not shipped). Load with -p regt2_guard_inject.
REGT2_INJECT selects the injected failure:
  probe_runtime  : tensor_cuda.zeros raises a NON-device RuntimeError (illegal address) -> GPU tests must FAIL
  probe_nodevice : tensor_cuda.zeros raises the engine's no-device RuntimeError       -> GPU tests must SKIP
  import_other   : `import tensor_cuda` raises an ImportError naming tensor_cuda.quant -> GPU tests must FAIL
"""
import os
import sys

MODE = os.environ.get("REGT2_INJECT", "")


class _Finder:
    def find_spec(self, fullname, path=None, target=None):
        if fullname == "tensor_cuda":
            raise ImportError("cannot import name '_tables' from 'tensor_cuda.quant' [injected by APA-REGT2 guard demo]",
                              name="tensor_cuda.quant")
        return None


def pytest_configure(config):
    if MODE in ("probe_runtime", "probe_nodevice"):
        import tensor_cuda
        msg = ("cudaErrorIllegalAddress: an illegal memory access was encountered" if MODE == "probe_runtime"
               else "cudaMalloc failed: no CUDA-capable device is detected")

        def zeros(*a, **kw):
            raise RuntimeError(msg + " [injected by APA-REGT2 guard demo]")
        tensor_cuda.zeros = zeros
        print(f"REGT2_INJECT={MODE}: tensor_cuda.zeros patched to raise RuntimeError({msg!r})", file=sys.stderr)
    elif MODE == "import_other":
        sys.modules.pop("tensor_cuda", None)
        sys.meta_path.insert(0, _Finder())
        print("REGT2_INJECT=import_other: import tensor_cuda raises ImportError(name='tensor_cuda.quant')",
              file=sys.stderr)

