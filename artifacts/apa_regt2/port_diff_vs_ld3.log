"""APA-REGT2 evidence script (not shipped): function-level diff of the port against the LD3 / LD1 sources on disk."""
import ast, difflib, sys
ld3, here = sys.argv[1], sys.argv[2]
def funcs(path):
    src = open(path).read()
    lines = src.splitlines()
    out = {}
    for n in ast.parse(src).body:
        if isinstance(n, (ast.FunctionDef, ast.ClassDef)):
            out[n.name] = lines[n.lineno - 1 - len(n.decorator_list):n.end_lineno]
        elif isinstance(n, ast.Assign) and len(n.targets) == 1 and isinstance(n.targets[0], ast.Tuple):
            out["<" + ",".join(t.id for t in n.targets[0].elts) + ">"] = lines[n.lineno - 1:n.end_lineno]
        elif isinstance(n, ast.Assign) and isinstance(n.targets[0], ast.Name) and n.targets[0].id == "GEO":
            out["GEO"] = lines[n.lineno - 1:n.end_lineno]
    return out
mine = funcs(f"{here}/scripts/apa_pidv.py")
pd2 = funcs(f"{ld3}/scripts/apa_ld3_pdwl2.py")
run = funcs(f"{ld3}/scripts/apa_ld3_run.py")
print("== detector functions: apa_pidv.py vs apa_ld3_pdwl2.py / apa_ld3_run.py (exact line equality)")
for name, src in (("<BASE,TWIN,CUT,LABEL,COLOR>", pd2), ("spread", pd2), ("_empty_layout", pd2), ("_cut_nt", pd2),
                  ("pidv_layouts", pd2), ("pidv_operand", pd2), ("pidv_check", pd2), ("pidv_cell", run)):
    a, b = src[name], mine[name]
    d = list(difflib.unified_diff(a, b, "ld3", "regt2", lineterm="", n=0))
    print(f"{name}: {len(a)} lines in LD3, {len(b)} in port, {'IDENTICAL' if not d else 'DIFFERS'}")
    for l in d:
        print("   ", l)
# the constants line carries a trailing comment in both files; show both raw lines
print("== adapter lines: PidvAttn / synthetic_margins / make_cell / GEO vs apa_ld1_entries.py, apa_ld2_run.py, apa_ld1_run.py")
ent = open(f"{ld3}/scripts/apa_ld1_entries.py").read().splitlines()
ld1run = funcs(f"{ld3}/scripts/apa_ld1_run.py")
ld2run = funcs(f"{ld3}/scripts/apa_ld2_run.py")
pool = set(l.strip() for l in ent) | set(l.strip() for v in ld1run.values() for l in v) | set(l.strip() for v in ld2run.values() for l in v)
for name in ("synthetic_margins", "PidvAttn", "make_cell", "GEO"):
    body = mine[name]
    new = [l for l in body if l.strip() and l.strip() not in pool]
    print(f"{name}: {len(body)} lines, {len(body) - len(new)} found verbatim (stripped) in the LD1/LD2 adapter sources, {len(new)} new or changed:")
    for l in new:
        print("    +", l)
