+std::tuple<NDArray,NDArray,NDArray> apa_selective_bwd_bk3_cuda(
+    const NDArray& q,const NDArray& k,const NDArray& kq,const NDArray& v,
+    const NDArray& dO,const NDArray& lse,const NDArray& thr,const NDArray& out,
