+      bk3::halves.resize(2);
+      for(int i=0;i<2;++i) check(cudaEventElapsedTime(&bk3::halves[i],events[i],events[i+1]));
+    }
+  } catch(...) {for(auto e:events) if(e) cudaEventDestroy(e);throw;}
+  for(auto e:events) if(e) cudaEventDestroy(e);
