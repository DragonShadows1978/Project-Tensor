+def check_nan_rows(array, wanted):
+    nonfinite_rows = np.any(~np.isfinite(array), axis=-1)
+    nan_rows = np.isnan(array).all(axis=-1)
+    return dict(
+        nonfinite_rows=int(nonfinite_rows.sum()),
+        all_nan_rows=int(nan_rows.sum()),
+        nan_elements=int(np.isnan(array).sum()),
+        ok=bool(np.array_equal(nonfinite_rows, wanted) and np.array_equal(nan_rows, wanted)),
+    )
