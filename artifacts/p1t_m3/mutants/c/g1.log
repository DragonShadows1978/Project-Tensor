            y = y1.cpu().numpy()
            shape_ok = tuple(y.shape) == tuple(o.shape)
            finite = bool(np.isfinite(y).all())
            n = normwise(y, o) if shape_ok else float('inf')
            det = _bits_equal(y1, y2)
